"notification.spiritual.quran1.title" = "فاذكروني أذكركم";
"notification.spiritual.quran1.body" = "«فَاذْكُرُونِي أَذْكُرْكُمْ» — القرآن 2:152";
"notification.spiritual.sunnah1.title" = "أحب الأعمال";
"notification.spiritual.sunnah1.body" = "«أحب الأعمال إلى الله أدومها وإن قل.» — صحيح البخاري 6465؛ صحيح مسلم 783";
"notification.spiritual.reminder1.title" = "الله يراك";
"notification.spiritual.reminder1.body" = "ما تفعله الآن يعود يوم القيامة. اختر ما تريد أن تُريه إياه.";
"notification.spiritual.quran2.title" = "إن مع العسر يسرا";
"notification.spiritual.quran2.body" = "«إِنَّ مَعَ الْعُسْرِ يُسْرًا» — القرآن 94:6";
"notification.spiritual.sunnah2.title" = "قل خيراً أو اصمت";
"notification.spiritual.sunnah2.body" = "«من كان يؤمن بالله واليوم الآخر فليقل خيراً أو ليصمت.» — صحيح البخاري 6018؛ صحيح مسلم 47";
"notification.spiritual.reminder2.title" = "الآخرة تنتظر";
"notification.spiritual.reminder2.body" = "هذه الدقيقة محسوبة. ذكرٌ أخف حملًا من ساعة تمرير.";
"notification.spiritual.quran3.title" = "فذكّر إن نفعت الذكرى";
"notification.spiritual.quran3.body" = "«فَذَكِّرْ إِن نَّفَعَتِ الذِّكْرَىٰ» — القرآن 87:9";
"notification.spiritual.sunnah3.title" = "الأعمال بالنيات";
"notification.spiritual.sunnah3.body" = "«إنما الأعمال بالنيات، وإنما لكل امرئ ما نوى.» — صحيح البخاري 1؛ صحيح مسلم 1907";
"notification.spiritual.reminder3.title" = "أين ستكون بعد ذلك؟";
"notification.spiritual.reminder3.body" = "كن في الدنيا كعابر سبيل. التمرير ليس دارك.";
"notification.spiritual.quran4.title" = "إن الله مع الصابرين";
"notification.spiritual.quran4.body" = "«يَا أَيُّهَا الَّذِينَ آمَنُوا اسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ ۚ إِنَّ اللَّهَ مَعَ الصَّابِرِينَ» — القرآن 2:153";
"notification.spiritual.sunnah4.title" = "الشديد";
"notification.spiritual.sunnah4.body" = "«ليس الشديد بالصرعة، إنما الشديد الذي يملك نفسه عند الغضب.» — صحيح البخاري 6114؛ صحيح مسلم 2609";
"notification.spiritual.reminder4.title" = "نَفَس واحد فرصة";
"notification.spiritual.reminder4.body" = "أعطاك الله نَفَسًا آخر. اجعله استغفارًا، لا للفيديو التالي.";
"notification.spiritual.quran5.title" = "تطمئن القلوب";
"notification.spiritual.quran5.body" = "«أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ» — القرآن 13:28";
"notification.spiritual.sunnah5.title" = "يسّروا ولا تعسّروا";
"notification.spiritual.sunnah5.body" = "«يسّروا ولا تعسّروا، وبشّروا ولا تنفّروا.» — صحيح البخاري 69؛ صحيح مسلم 1734";
"notification.spiritual.reminder5.title" = "القبر سيسأل";
"notification.spiritual.reminder5.body" = "ماذا تحمل معك: سلسلة مقاطع، أم كلمة يحبها الله؟";
"notification.spiritual.quran6.title" = "وأقيموا الصلاة";
"notification.spiritual.quran6.body" = "«وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَارْكَعُوا مَعَ الرَّاكِعِينَ» — القرآن 2:43";
"notification.spiritual.sunnah6.title" = "تعلّموا القرآن وعلّموه";
"notification.spiritual.sunnah6.body" = "«خيركم من تعلّم القرآن وعلّمه.» — صحيح البخاري 5027";
"notification.spiritual.reminder6.title" = "هو قريب";
"notification.spiritual.reminder6.body" = "إذا سألك عبادي عني فإني قريب. ادعُه الآن.";
"notification.spiritual.quran7.title" = "ما ودّعك ربك";
"notification.spiritual.quran7.body" = "«مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ» — القرآن 93:3";
"notification.spiritual.sunnah7.title" = "الطهور شطر الإيمان";
"notification.spiritual.sunnah7.body" = "«الطهور شطر الإيمان.» — صحيح مسلم 223";
"notification.spiritual.reminder7.title" = "الميزان";
"notification.spiritual.reminder7.body" = "سبحان الله واحدة قد تثقل أكثر من كل ما مررت عليه اليوم.";
"notification.spiritual.quran8.title" = "ووجدك ضالاً فهدى";
"notification.spiritual.quran8.body" = "«وَوَجَدَكَ ضَالًّا فَهَدَىٰ» — القرآن 93:7";
"notification.spiritual.sunnah8.title" = "كن في الدنيا كعابر سبيل";
"notification.spiritual.sunnah8.body" = "«كن في الدنيا كأنك غريب أو عابر سبيل.» — صحيح البخاري 6416";
"notification.spiritual.reminder8.title" = "لا تنسَ الرجوع";
"notification.spiritual.reminder8.body" = "كل نفس ذائقة الموت. عِش هذه الساعة كأنك ستُسأل عنها.";
"notification.spiritual.quran9.title" = "ولا تنس نصيبك";
"notification.spiritual.quran9.body" = "«وَلَا تَنسَ نَصِيبَكَ مِنَ الدُّنْيَا ۖ وَأَحْسِن كَمَا أَحْسَنَ اللَّهُ إِلَيْكَ» — القرآن 28:77";
"notification.spiritual.sunnah9.title" = "أحب لأخيك";
"notification.spiritual.sunnah9.body" = "«لا يؤمن أحدكم حتى يحب لأخيه ما يحب لنفسه.» — صحيح البخاري 13؛ صحيح مسلم 45";
"notification.spiritual.reminder9.title" = "الله يكفي";
"notification.spiritual.reminder9.body" = "ما تبحث عنه في التمرير لا يملأ ما لا يملؤه إلا الله.";
"notification.spiritual.quran10.title" = "يذكرون الله قياماً وقعوداً";
"notification.spiritual.quran10.body" = "«الَّذِينَ يَذْكُرُونَ اللَّهَ قِيَامًا وَقُعُودًا وَعَلَىٰ جُنُوبِهِمْ» — القرآن 3:191";
"notification.spiritual.sunnah10.title" = "سلم المسلمون من لسانه ويده";
"notification.spiritual.sunnah10.body" = "«المسلم من سلم المسلمون من لسانه ويده.» — صحيح البخاري 10؛ صحيح مسلم 40";
"notification.spiritual.reminder10.title" = "كلمة له";
"notification.spiritual.reminder10.body" = "قل أستغفر الله. تمحو. والتمرير يزيد ما لا تريد أن تحمله.";
"notification.spiritual.quran11.title" = "إن الصلاة تنهى عن الفحشاء";
"notification.spiritual.quran11.body" = "«إِنَّ الصَّلَاةَ تَنْهَىٰ عَنِ الْفَحْشَاءِ وَالْمُنكَرِ ۗ وَلَذِكْرُ اللَّهِ أَكْبَرُ» — القرآن 29:45";
"notification.spiritual.sunnah11.title" = "كلمتان ثقيلتان في الميزان";
"notification.spiritual.sunnah11.body" = "«كلمتان خفيفتان على اللسان، ثقيلتان في الميزان، حبيبتان إلى الرحمن: سبحان الله وبحمده، سبحان الله العظيم.» — صحيح البخاري 6406؛ صحيح مسلم 2694";
"notification.spiritual.reminder11.title" = "اليوم آتٍ";
"notification.spiritual.reminder11.body" = "لا يُظلم أحد. ما يبدو صغيرًا الآن سيُكتب في صحيفتك.";
"notification.spiritual.quran12.title" = "ألم يأن للذين آمنوا";
"notification.spiritual.quran12.body" = "«أَلَمْ يَأْنِ لِلَّذِينَ آمَنُوا أَن تَخْشَعَ قُلُوبُهُمْ لِذِكْرِ اللَّهِ» — القرآن 57:16";
"notification.spiritual.sunnah12.title" = "لا تغضب";
"notification.spiritual.sunnah12.body" = "قال رجل: «أوصني.» قال ﷺ: «لا تغضب.» فردّد مراراً، وهو ﷺ يقول: «لا تغضب.» — صحيح البخاري 6116";
"notification.spiritual.reminder12.title" = "وجّه قلبك";
"notification.spiritual.reminder12.body" = "ألا بذكر الله تطمئن القلوب.";
"notification.spiritual.quran13.title" = "استعينوا بالصبر";
"notification.spiritual.quran13.body" = "«وَاسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ ۚ وَإِنَّهَا لَكَبِيرَةٌ إِلَّا عَلَى الْخَاشِعِينَ» — القرآن 2:45";
"notification.spiritual.sunnah13.title" = "لا يرحم الله من لا يرحم الناس";
"notification.spiritual.sunnah13.body" = "«لا يرحم الله من لا يرحم الناس.» — صحيح البخاري 5997؛ صحيح مسلم 2319";
"notification.spiritual.reminder13.title" = "لربك";
"notification.spiritual.reminder13.body" = "صلاة وذكر وآية. هذا يبقى. والخط الزمني يزول.";
"notification.spiritual.quran14.title" = "فإني قريب";
"notification.spiritual.quran14.body" = "«وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ ۖ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ» — القرآن 2:186";
"notification.spiritual.sunnah14.title" = "كل معروف صدقة";
"notification.spiritual.sunnah14.body" = "«كل معروف صدقة.» — صحيح البخاري 6022؛ صحيح مسلم 1005";
"notification.spiritual.reminder14.title" = "دقيقتان مع الله";
"notification.spiritual.reminder14.body" = "ضع الهاتف. قل سبحان الله، والحمد لله، والله أكبر.";
"notification.spiritual.quran15.title" = "لا يكلف الله نفساً إلا وسعها";
"notification.spiritual.quran15.body" = "«لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا» — القرآن 2:286";
"notification.spiritual.sunnah15.title" = "إماطة الأذى عن الطريق";
"notification.spiritual.sunnah15.body" = "«إماطة الأذى عن الطريق صدقة.» — صحيح البخاري 2989؛ صحيح مسلم 1009";
"notification.spiritual.reminder15.title" = "من ترجو أن تلقى؟";
"notification.spiritual.reminder15.body" = "لقاء الله حق. هيّئ اليوم عملًا صالحًا واحدًا.";
"notification.spiritual.quran16.title" = "ولا تهنوا ولا تحزنوا";
"notification.spiritual.quran16.body" = "«وَلَا تَهِنُوا وَلَا تَحْزَنُوا وَأَنتُمُ الْأَعْلَوْنَ إِن كُنتُم مُّؤْمِنِينَ» — القرآن 3:139";
"notification.spiritual.sunnah16.title" = "الحياء شعبة من الإيمان";
"notification.spiritual.sunnah16.body" = "«الحياء شعبة من الإيمان.» — صحيح البخاري 24؛ صحيح مسلم 36";
"notification.spiritual.reminder16.title" = "الدنيا قصيرة";
"notification.spiritual.reminder16.body" = "ما تؤجله الآن لأجل الله سيبدو حينها أطول من كل هذا التمرير.";
"notification.spiritual.quran17.title" = "اصبروا وصابروا";
"notification.spiritual.quran17.body" = "«يَا أَيُّهَا الَّذِينَ آمَنُوا اصْبِرُوا وَصَابِرُوا وَرَابِطُوا وَاتَّقُوا اللَّهَ لَعَلَّكُمْ تُفْلِحُونَ» — القرآن 3:200";
"notification.spiritual.sunnah17.title" = "الدين النصيحة";
"notification.spiritual.sunnah17.body" = "«الدين النصيحة.» قلنا: «لمن؟» قال: «لله ولكتابه ولرسوله ولأئمة المسلمين وعامتهم.» — صحيح مسلم 55";
"notification.spiritual.reminder17.title" = "استغفر";
"notification.spiritual.reminder17.body" = "الله يحب أن تعود. توبة صادقة أثقل من تمريرٍ كامل.";
"notification.spiritual.quran18.title" = "كتاباً موقوتاً";
"notification.spiritual.quran18.body" = "«إِنَّ الصَّلَاةَ كَانَتْ عَلَى الْمُؤْمِنِينَ كِتَابًا مَّوْقُوتًا» — القرآن 4:103";
"notification.spiritual.sunnah18.title" = "أكرم ضيفك";
"notification.spiritual.sunnah18.body" = "«من كان يؤمن بالله واليوم الآخر فليكرم ضيفه.» — صحيح البخاري 6018؛ صحيح مسلم 47";
"notification.spiritual.reminder18.title" = "صحيفتك";
"notification.spiritual.reminder18.body" = "الملائكة تكتب. فليكن هذا الوقت حسنة لا غفلة.";
"notification.spiritual.quran19.title" = "واذكر ربك في نفسك";
"notification.spiritual.quran19.body" = "«وَاذْكُر رَّبَّكَ فِي نَفْسِكَ تَضَرُّعًا وَخِيفَةً وَدُونَ الْجَهْرِ مِنَ الْقَوْلِ بِالْغُدُوِّ وَالْآصَالِ» — القرآن 7:205";
"notification.spiritual.sunnah19.title" = "المؤمن للمؤمن كالبنيان";
"notification.spiritual.sunnah19.body" = "«المؤمن للمؤمن كالبنيان يشد بعضه بعضاً.» — صحيح البخاري 481؛ صحيح مسلم 2585";
"notification.spiritual.reminder19.title" = "الآخرة أقرب";
"notification.spiritual.reminder19.body" = "لا تدري أي نَفَس هو الأخير. اذكر الله قبل أن تتابع التمرير.";
"notification.spiritual.quran20.title" = "إن الله لا يغيّر ما بقوم";
"notification.spiritual.quran20.body" = "«إِنَّ اللَّهَ لَا يُغَيِّرُ مَا بِقَوْمٍ حَتَّىٰ يُغَيِّرُوا مَا بِأَنفُسِهِمْ» — القرآن 13:11";
"notification.spiritual.sunnah20.title" = "حتى أكون أحب إليه";
"notification.spiritual.sunnah20.body" = "«لا يؤمن أحدكم حتى أكون أحب إليه من والده وولده والناس أجمعين.» — صحيح البخاري 15؛ صحيح مسلم 44";
"notification.spiritual.reminder20.title" = "آية تتمسك بها";
"notification.spiritual.reminder20.body" = "ومن يتق الله يجعل له مخرجًا.";
