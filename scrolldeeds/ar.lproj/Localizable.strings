/* Discovery feed expansion */
"discovery.card.shukr.title" = "لئن شكرتم لأزيدنكم";
"discovery.card.shukr.meaning" = "قال الله تعالى: ﴿لَئِن شَكَرْتُمْ لَأَزِيدَنَّكُمْ ۖ وَلَئِن كَفَرْتُمْ إِنَّ عَذَابِي لَشَدِيدٌ﴾.";
"discovery.card.shukr.source" = "القرآن ١٤:٧";

"discovery.card.dua_near.title" = "فإني قريب";
"discovery.card.dua_near.meaning" = "قال الله تعالى: ﴿وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ ۖ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ﴾.";
"discovery.card.dua_near.source" = "القرآن ٢:١٨٦";

"discovery.card.no_despair.title" = "لا تقنطوا من رحمة الله";
"discovery.card.no_despair.meaning" = "قال الله تعالى: ﴿قُلْ يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَىٰ أَنفُسِهِمْ لَا تَقْنَطُوا مِن رَّحْمَةِ اللَّهِ ۚ إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا﴾.";
"discovery.card.no_despair.source" = "القرآن ٣٩:٥٣";

"discovery.card.qadr.title" = "ليلة القدر";
"discovery.card.qadr.meaning" = "قال الله تعالى: ﴿لَيْلَةُ الْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ﴾.";
"discovery.card.qadr.source" = "القرآن ٩٧:٣";

"discovery.card.duha_care.title" = "ما ودعك ربك وما قلى";
"discovery.card.duha_care.meaning" = "قال الله تعالى: ﴿مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ ۝ وَلَلْآخِرَةُ خَيْرٌ لَّكَ مِنَ الْأُولَىٰ ۝ وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ﴾.";
"discovery.card.duha_care.source" = "القرآن ٩٣:٣–٥";

"discovery.card.asr.title" = "إن الإنسان لفي خسر";
"discovery.card.asr.meaning" = "قال الله تعالى: ﴿وَالْعَصْرِ ۝ إِنَّ الْإِنسَانَ لَفِي خُسْرٍ ۝ إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ﴾.";
"discovery.card.asr.source" = "القرآن ١٠٣:١–٣";

"discovery.card.kawthar.title" = "إنا أعطيناك الكوثر";
"discovery.card.kawthar.meaning" = "قال الله تعالى: ﴿إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ ۝ فَصَلِّ لِرَبِّكَ وَانْحَرْ﴾.";
"discovery.card.kawthar.source" = "القرآن ١٠٨:١–٢";

"discovery.card.no_compulsion.title" = "لا إكراه في الدين";
"discovery.card.no_compulsion.meaning" = "قال الله تعالى: ﴿لَا إِكْرَاهَ فِي الدِّينِ ۖ قَد تَّبَيَّنَ الرُّشْدُ مِنَ الْغَيِّ﴾.";
"discovery.card.no_compulsion.source" = "القرآن ٢:٢٥٦";

"discovery.card.with_you.title" = "وهو معكم أين ما كنتم";
"discovery.card.with_you.meaning" = "قال الله تعالى: ﴿وَهُوَ مَعَكُمْ أَيْنَ مَا كُنتُمْ ۚ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ﴾.";
"discovery.card.with_you.source" = "القرآن ٥٧:٤";

"discovery.card.closer.title" = "ونحن أقرب إليه من حبل الوريد";
"discovery.card.closer.meaning" = "قال الله تعالى: ﴿وَلَقَدْ خَلَقْنَا الْإِنسَانَ وَنَعْلَمُ مَا تُوَسْوِسُ بِهِ نَفْسُهُ ۖ وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنْ حَبْلِ الْوَرِيدِ﴾.";
"discovery.card.closer.source" = "القرآن ٥٠:١٦";

"discovery.card.spouses.title" = "وجعل بينكم مودة ورحمة";
"discovery.card.spouses.meaning" = "قال الله تعالى: ﴿وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَاجًا لِّتَسْكُنُوا إِلَيْهَا وَجَعَلَ بَيْنَكُم مَّوَدَّةً وَرَحْمَةً﴾.";
"discovery.card.spouses.source" = "القرآن ٣٠:٢١";

"discovery.card.blessings_count.title" = "وإن تعدوا نعمة الله لا تحصوها";
"discovery.card.blessings_count.meaning" = "قال الله تعالى: ﴿وَإِن تَعُدُّوا نِعْمَةَ اللَّهِ لَا تُحْصُوهَا ۗ إِنَّ اللَّهَ لَغَفُورٌ رَّحِيمٌ﴾.";
"discovery.card.blessings_count.source" = "القرآن ١٦:١٨";

"discovery.card.fasting_prescribed.title" = "كتب عليكم الصيام";
"discovery.card.fasting_prescribed.meaning" = "قال الله تعالى: ﴿يَا أَيُّهَا الَّذِينَ آمَنُوا كُتِبَ عَلَيْكُمُ الصِّيَامُ كَمَا كُتِبَ عَلَى الَّذِينَ مِن قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ﴾.";
"discovery.card.fasting_prescribed.source" = "القرآن ٢:١٨٣";

"discovery.card.yunus_dua.title" = "لا إله إلا أنت سبحانك";
"discovery.card.yunus_dua.meaning" = "قال الله تعالى أن يونس نادى في الظلمات: ﴿لَّا إِلَٰهَ إِلَّا أَنتَ سُبْحَانَكَ إِنِّي كُنتُ مِنَ الظَّالِمِينَ﴾.";
"discovery.card.yunus_dua.source" = "القرآن ٢١:٨٧";

"discovery.card.hasbuna.title" = "حسبنا الله ونعم الوكيل";
"discovery.card.hasbuna.meaning" = "قال الله تعالى أنهم قالوا: ﴿حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ﴾.";
"discovery.card.hasbuna.source" = "القرآن ٣:١٧٣";

"discovery.card.rabbana_atina.title" = "ربنا آتنا في الدنيا حسنة";
"discovery.card.rabbana_atina.meaning" = "قال الله تعالى: ﴿رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ﴾.";
"discovery.card.rabbana_atina.source" = "القرآن ٢:٢٠١";

"discovery.card.be_and_it_is.title" = "كن فيكون";
"discovery.card.be_and_it_is.meaning" = "قال الله تعالى: ﴿إِنَّمَا أَمْرُهُ إِذَا أَرَادَ شَيْئًا أَن يَقُولَ لَهُ كُن فَيَكُونُ﴾.";
"discovery.card.be_and_it_is.source" = "القرآن ٣٦:٨٢";

"discovery.card.which_favors.title" = "فبأي آلاء ربكما تكذبان";
"discovery.card.which_favors.meaning" = "قال الله تعالى: ﴿فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ﴾.";
"discovery.card.which_favors.source" = "القرآن ٥٥:١٣";

"discovery.card.calamity.title" = "ما أصاب من مصيبة إلا بإذن الله";
"discovery.card.calamity.meaning" = "قال الله تعالى: ﴿مَا أَصَابَ مِن مُّصِيبَةٍ إِلَّا بِإِذْنِ اللَّهِ ۗ وَمَن يُؤْمِن بِاللَّهِ يَهْدِ قَلْبَهُ﴾.";
"discovery.card.calamity.source" = "القرآن ٦٤:١١";

"discovery.card.death_life.title" = "الذي خلق الموت والحياة";
"discovery.card.death_life.meaning" = "قال الله تعالى: ﴿الَّذِي خَلَقَ الْمَوْتَ وَالْحَيَاةَ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًا ۚ وَهُوَ الْعَزِيزُ الْغَفُورُ﴾.";
"discovery.card.death_life.source" = "القرآن ٦٧:٢";

"discovery.card.kafirun.title" = "لكم دينكم ولي دين";
"discovery.card.kafirun.meaning" = "قال الله تعالى: ﴿لَكُمْ دِينُكُمْ وَلِيَ دِينِ﴾.";
"discovery.card.kafirun.source" = "القرآن ١٠٩:٦";

"discovery.card.nas.title" = "قل أعوذ برب الناس";
"discovery.card.nas.meaning" = "قال الله تعالى: ﴿قُلْ أَعُوذُ بِرَبِّ النَّاسِ ۝ مَلِكِ النَّاسِ ۝ إِلَٰهِ النَّاسِ﴾.";
"discovery.card.nas.source" = "القرآن ١١٤:١–٣";

"discovery.card.falaq.title" = "قل أعوذ برب الفلق";
"discovery.card.falaq.meaning" = "قال الله تعالى: ﴿قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ ۝ مِن شَرِّ مَا خَلَقَ﴾.";
"discovery.card.falaq.source" = "القرآن ١١٣:١–٢";

"discovery.card.orphans_duha.title" = "فأما اليتيم فلا تقهر";
"discovery.card.orphans_duha.meaning" = "قال الله تعالى: ﴿فَأَمَّا الْيَتِيمَ فَلَا تَقْهَرْ ۝ وَأَمَّا السَّائِلَ فَلَا تَنْهَرْ ۝ وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ﴾.";
"discovery.card.orphans_duha.source" = "القرآن ٩٣:٩–١١";

"discovery.card.justice.title" = "كونوا قوامين بالقسط";
"discovery.card.justice.meaning" = "قال الله تعالى: ﴿يَا أَيُّهَا الَّذِينَ آمَنُوا كُونُوا قَوَّامِينَ بِالْقِسْطِ شُهَدَاءَ لِلَّهِ وَلَوْ عَلَىٰ أَنفُسِكُمْ أَوِ الْوَالِدَيْنِ وَالْأَقْرَبِينَ﴾.";
"discovery.card.justice.source" = "القرآن ٤:١٣٥";

"discovery.card.amanah.title" = "أن تؤدوا الأمانات إلى أهلها";
"discovery.card.amanah.meaning" = "قال الله تعالى: ﴿إِنَّ اللَّهَ يَأْمُرُكُمْ أَن تُؤَدُّوا الْأَمَانَاتِ إِلَىٰ أَهْلِهَا وَإِذَا حَكَمْتُم بَيْنَ النَّاسِ أَن تَحْكُمُوا بِالْعَدْلِ﴾.";
"discovery.card.amanah.source" = "القرآن ٤:٥٨";

"discovery.card.luqman_salah.title" = "يا بني أقم الصلاة";
"discovery.card.luqman_salah.meaning" = "قال لقمان: ﴿يَا بُنَيَّ أَقِمِ الصَّلَاةَ وَأْمُرْ بِالْمَعْرُوفِ وَانْهَ عَنِ الْمُنكَرِ وَاصْبِرْ عَلَىٰ مَا أَصَابَكَ﴾.";
"discovery.card.luqman_salah.source" = "القرآن ٣١:١٧";

"discovery.card.infaq_grain.title" = "مثل الذين ينفقون";
"discovery.card.infaq_grain.meaning" = "قال الله تعالى: ﴿مَّثَلُ الَّذِينَ يُنفِقُونَ أَمْوَالَهُمْ فِي سَبِيلِ اللَّهِ كَمَثَلِ حَبَّةٍ أَنبَتَتْ سَبْعَ سَنَابِلَ فِي كُلِّ سُنبُلَةٍ مِّائَةُ حَبَّةٍ ۗ وَاللَّهُ يُضَاعِفُ لِمَن يَشَاءُ﴾.";
"discovery.card.infaq_grain.source" = "القرآن ٢:٢٦١";

"discovery.card.rabbana_forgive.title" = "ربنا لا تؤاخذنا إن نسينا";
"discovery.card.rabbana_forgive.meaning" = "قال الله تعالى: ﴿رَبَّنَا لَا تُؤَاخِذْنَا إِن نَّسِينَا أَوْ أَخْطَأْنَا ۚ رَبَّنَا وَلَا تَحْمِلْ عَلَيْنَا إِصْرًا كَمَا حَمَلْتَهُ عَلَى الَّذِينَ مِن قَبْلِنَا﴾.";
"discovery.card.rabbana_forgive.source" = "القرآن ٢:٢٨٦";

"discovery.card.establish_salah.title" = "وأقيموا الصلاة وآتوا الزكاة";
"discovery.card.establish_salah.meaning" = "قال الله تعالى: ﴿وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَارْكَعُوا مَعَ الرَّاكِعِينَ﴾.";
"discovery.card.establish_salah.source" = "القرآن ٢:٤٣";

"discovery.card.way_out.title" = "ومن يتق الله يجعل له مخرجًا";
"discovery.card.way_out.meaning" = "قال الله تعالى: ﴿وَمَن يَتَّقِ اللَّهَ يَجْعَل لَّهُ مَخْرَجًا ۝ وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ﴾.";
"discovery.card.way_out.source" = "القرآن ٦٥:٢–٣";

"discovery.card.sincere_deen.title" = "ليعبدوا الله مخلصين له الدين";
"discovery.card.sincere_deen.meaning" = "قال الله تعالى: ﴿وَمَا أُمِرُوا إِلَّا لِيَعْبُدُوا اللَّهَ مُخْلِصِينَ لَهُ الدِّينَ حُنَفَاءَ وَيُقِيمُوا الصَّلَاةَ وَيُؤْتُوا الزَّكَاةَ﴾.";
"discovery.card.sincere_deen.source" = "القرآن ٩٨:٥";

"discovery.card.allah_light.title" = "الله نور السموات والأرض";
"discovery.card.allah_light.meaning" = "قال الله تعالى: ﴿اللَّهُ نُورُ السَّمَاوَاتِ وَالْأَرْضِ﴾.";
"discovery.card.allah_light.source" = "القرآن ٢٤:٣٥";

"discovery.card.expand_chest.title" = "ألم نشرح لك صدرك";
"discovery.card.expand_chest.meaning" = "قال الله تعالى: ﴿أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ ۝ وَوَضَعْنَا عَنكَ وِزْرَكَ ۝ الَّذِي أَنقَضَ ظَهْرَكَ ۝ وَرَفَعْنَا لَكَ ذِكْرَكَ﴾.";
"discovery.card.expand_chest.source" = "القرآن ٩٤:١–٤";

"discovery.card.hikmah.title" = "يؤتي الحكمة من يشاء";
"discovery.card.hikmah.meaning" = "قال الله تعالى: ﴿يُؤْتِي الْحِكْمَةَ مَن يَشَاءُ ۚ وَمَن يُؤْتَ الْحِكْمَةَ فَقَدْ أُوتِيَ خَيْرًا كَثِيرًا﴾.";
"discovery.card.hikmah.source" = "القرآن ٢:٢٦٩";

"discovery.card.five_pillars.title" = "بني الإسلام على خمس";
"discovery.card.five_pillars.meaning" = "قال النبي ﷺ: «بُنِيَ الْإِسْلَامُ عَلَىٰ خَمْسٍ: شَهَادَةِ أَنْ لَا إِلَٰهَ إِلَّا اللَّهُ وَأَنَّ مُحَمَّدًا رَسُولُ اللَّهِ، وَإِقَامِ الصَّلَاةِ، وَإِيتَاءِ الزَّكَاةِ، وَالْحَجِّ، وَصَوْمِ رَمَضَانَ».";
"discovery.card.five_pillars.source" = "صحيح البخاري ٨ · صحيح مسلم ١٦";

"discovery.card.muslim_tongue.title" = "من سلم المسلمون من لسانه ويده";
"discovery.card.muslim_tongue.meaning" = "قال النبي ﷺ: «الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ».";
"discovery.card.muslim_tongue.source" = "صحيح البخاري ١٠ · صحيح مسلم ٤١";

"discovery.card.deen_nasihah.title" = "الدين النصيحة";
"discovery.card.deen_nasihah.meaning" = "قال النبي ﷺ: «الدِّينُ النَّصِيحَةُ». قلنا: لمن؟ قال: «لِلَّهِ وَلِكِتَابِهِ وَلِرَسُولِهِ وَلِأَئِمَّةِ الْمُسْلِمِينَ وَعَامَّتِهِمْ».";
"discovery.card.deen_nasihah.source" = "صحيح مسلم ٥٥";

"discovery.card.best_quran.title" = "خيركم من تعلم القرآن وعلمه";
"discovery.card.best_quran.meaning" = "قال النبي ﷺ: «خَيْرُكُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَهُ».";
"discovery.card.best_quran.source" = "صحيح البخاري ٥٠٢٧";

"discovery.card.mother_first.title" = "أمك ثم أمك";
"discovery.card.mother_first.meaning" = "جاء رجل فقال: يا رسول الله، من أحق الناس بحسن صحابتي؟ قال: «أُمُّكَ». قال: ثم من؟ قال: «أُمُّكَ». قال: ثم من؟ قال: «أُمُّكَ». قال: ثم من؟ قال: «أَبُوكَ».";
"discovery.card.mother_first.source" = "صحيح البخاري ٥٩٧١ · صحيح مسلم ٢٥٤٨";

"discovery.card.plant_tree.title" = "ما من مسلم يغرس غرسًا";
"discovery.card.plant_tree.meaning" = "قال النبي ﷺ: «مَا مِنْ مُسْلِمٍ يَغْرِسُ غَرْسًا أَوْ يَزْرَعُ زَرْعًا فَيَأْكُلُ مِنْهُ طَيْرٌ أَوْ إِنْسَانٌ أَوْ بَهِيمَةٌ إِلَّا كَانَ لَهُ بِهِ صَدَقَةٌ».";
"discovery.card.plant_tree.source" = "صحيح مسلم ١٥٥٣";

"discovery.card.seven_shade.title" = "سبعة يظلهم الله";
"discovery.card.seven_shade.meaning" = "قال النبي ﷺ: «سَبْعَةٌ يُظِلُّهُمُ اللَّهُ فِي ظِلِّهِ يَوْمَ لَا ظِلَّ إِلَّا ظِلُّهُ: إِمَامٌ عَادِلٌ، وَشَابٌّ نَشَأَ فِي عِبَادَةِ اللَّهِ، وَرَجُلٌ قَلْبُهُ مُعَلَّقٌ فِي الْمَسَاجِدِ، وَرَجُلَانِ تَحَابَّا فِي اللَّهِ، وَرَجُلٌ دَعَتْهُ امْرَأَةٌ ذَاتُ مَنْصِبٍ وَجَمَالٍ فَقَالَ إِنِّي أَخَافُ اللَّهَ، وَرَجُلٌ تَصَدَّقَ بِصَدَقَةٍ فَأَخْفَاهَا حَتَّى لَا تَعْلَمَ شِمَالُهُ مَا تُنْفِقُ يَمِينُهُ، وَرَجُلٌ ذَكَرَ اللَّهَ خَالِيًا فَفَاضَتْ عَيْنَاهُ».";
"discovery.card.seven_shade.source" = "صحيح البخاري ١٤٢٣ · صحيح مسلم ١٠٣١";

"discovery.card.tasbih_salah.title" = "بعد الصلاة: ٣٣ و٣٣ و٣٤";
"discovery.card.tasbih_salah.meaning" = "علّم النبي ﷺ بعد الصلاة: سبحان الله ثلاثًا وثلاثين، والحمد لله ثلاثًا وثلاثين، والله أكبر أربعًا وثلاثين.";
"discovery.card.tasbih_salah.source" = "صحيح مسلم ٥٩٦";

"discovery.card.hundred_tasbih.title" = "مائة مرة في اليوم";
"discovery.card.hundred_tasbih.meaning" = "قال النبي ﷺ: «مَنْ قَالَ سُبْحَانَ اللَّهِ وَبِحَمْدِهِ فِي يَوْمٍ مِائَةَ مَرَّةٍ حُطَّتْ خَطَايَاهُ وَإِنْ كَانَتْ مِثْلَ زَبَدِ الْبَحْرِ».";
"discovery.card.hundred_tasbih.source" = "صحيح البخاري ٦٤٠٥ · صحيح مسلم ٢٦٩١";

"discovery.card.enter_masjid.title" = "إذا دخلت المسجد";
"discovery.card.enter_masjid.meaning" = "قال النبي ﷺ: إذا دخل أحدكم المسجد فليقل: «اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ».";
"discovery.card.enter_masjid.source" = "صحيح مسلم ٧١٣";

"discovery.card.do_not_anger.title" = "لا تغضب";
"discovery.card.do_not_anger.meaning" = "قال رجل للنبي ﷺ: أوصني. قال: «لَا تَغْضَبْ». فردد مرارًا، قال: «لَا تَغْضَبْ».";
"discovery.card.do_not_anger.source" = "صحيح البخاري ٦١١٦";

"discovery.card.make_easy.title" = "يسروا ولا تعسروا";
"discovery.card.make_easy.meaning" = "قال النبي ﷺ: «يَسِّرُوا وَلَا تُعَسِّرُوا، وَبَشِّرُوا وَلَا تُنَفِّرُوا».";
"discovery.card.make_easy.source" = "صحيح البخاري ٦٩";

"discovery.card.religion_ease.title" = "إن الدين يسر";
"discovery.card.religion_ease.meaning" = "قال النبي ﷺ: «إِنَّ الدِّينَ يُسْرٌ، وَلَنْ يُشَادَّ الدِّينَ أَحَدٌ إِلَّا غَلَبَهُ، فَسَدِّدُوا وَقَارِبُوا وَأَبْشِرُوا، وَاسْتَعِينُوا بِالْغَدْوَةِ وَالرَّوْحَةِ وَشَيْءٍ مِنَ الدُّلْجَةِ».";
"discovery.card.religion_ease.source" = "صحيح البخاري ٣٩";

"discovery.card.feed_hungry.title" = "أطعموا الجائع";
"discovery.card.feed_hungry.meaning" = "قال النبي ﷺ: «أَطْعِمُوا الْجَائِعَ، وَعُودُوا الْمَرِيضَ، وَفُكُّوا الْعَانِيَ».";
"discovery.card.feed_hungry.source" = "صحيح البخاري ٥٣٧٣";

"discovery.card.good_word.title" = "الكلمة الطيبة صدقة";
"discovery.card.good_word.meaning" = "قال النبي ﷺ: «وَالْكَلِمَةُ الطَّيِّبَةُ صَدَقَةٌ».";
"discovery.card.good_word.source" = "صحيح البخاري ٢٩٨٩ · صحيح مسلم ١٠٠٩";

"discovery.card.no_cheating.title" = "من غش فليس منا";
"discovery.card.no_cheating.meaning" = "قال النبي ﷺ: «مَنْ غَشَّ فَلَيْسَ مِنِّي».";
"discovery.card.no_cheating.source" = "صحيح مسلم ١٠٢";

"discovery.card.sleep_muawwidhat.title" = "اقرأ المعوذات عند النوم";
"discovery.card.sleep_muawwidhat.meaning" = "عن عائشة أن النبي ﷺ كان إذا أوى إلى فراشه جمع كفيه ثم نفث فيهما فقرأ ﴿قُلْ هُوَ اللَّهُ أَحَدٌ﴾ و﴿قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ﴾ و﴿قُلْ أَعُوذُ بِرَبِّ النَّاسِ﴾ ثم يمسح بهما ما استطاع من جسده.";
"discovery.card.sleep_muawwidhat.source" = "صحيح البخاري ٥٠١٧";

"discovery.card.treat_women.title" = "استوصوا بالنساء خيرًا";
"discovery.card.treat_women.meaning" = "قال النبي ﷺ في خطبة الوداع: «اتَّقُوا اللَّهَ فِي النِّسَاءِ، فَإِنَّكُمْ أَخَذْتُمُوهُنَّ بِأَمَانِ اللَّهِ، وَاسْتَحْلَلْتُمْ فُرُوجَهُنَّ بِكَلِمَةِ اللَّهِ».";
"discovery.card.treat_women.source" = "صحيح مسلم ١٢١٨";

"discovery.card.wudu_sins.title" = "الوضوء يحط الخطايا";
"discovery.card.wudu_sins.meaning" = "قال النبي ﷺ: «إِذَا تَوَضَّأَ الْعَبْدُ الْمُسْلِمُ — أَوِ الْمُؤْمِنُ — فَغَسَلَ وَجْهَهُ، خَرَجَ مِنْ وَجْهِهِ كُلُّ خَطِيئَةٍ نَظَرَ إِلَيْهَا بِعَيْنَيْهِ مَعَ الْمَاءِ، أَوْ مَعَ آخِرِ قَطْرِ الْمَاءِ؛ فَإِذَا غَسَلَ يَدَيْهِ، خَرَجَ مِنْ يَدَيْهِ كُلُّ خَطِيئَةٍ كَانَ بَطَشَتْهَا يَدَاهُ؛ فَإِذَا غَسَلَ رِجْلَيْهِ، خَرَجَتْ كُلُّ خَطِيئَةٍ مَشَتْهَا رِجْلَاهُ — حَتَّى يَخْرُجَ نَقِيًّا مِنَ الذُّنُوبِ».";
"discovery.card.wudu_sins.source" = "صحيح مسلم ٢٤٤";

/* BEGIN DISCOVERY EXPANSION */
"discovery.card.ayah_1_1.title" = "سُورَةُ ٱلْفَاتِحَةِ 1";
"discovery.card.ayah_1_1.meaning" = "﻿بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ";
"discovery.card.ayah_1_1.source" = "Qur’an 1:1";

"discovery.card.ayah_1_4.title" = "سُورَةُ ٱلْفَاتِحَةِ 4";
"discovery.card.ayah_1_4.meaning" = "مَٰلِكِ يَوْمِ ٱلدِّينِ";
"discovery.card.ayah_1_4.source" = "Qur’an 1:4";

"discovery.card.ayah_1_5.title" = "سُورَةُ ٱلْفَاتِحَةِ 5";
"discovery.card.ayah_1_5.meaning" = "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ";
"discovery.card.ayah_1_5.source" = "Qur’an 1:5";

"discovery.card.ayah_1_6.title" = "سُورَةُ ٱلْفَاتِحَةِ 6";
"discovery.card.ayah_1_6.meaning" = "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ";
"discovery.card.ayah_1_6.source" = "Qur’an 1:6";

"discovery.card.ayah_1_7.title" = "سُورَةُ ٱلْفَاتِحَةِ 7";
"discovery.card.ayah_1_7.meaning" = "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ";
"discovery.card.ayah_1_7.source" = "Qur’an 1:7";

"discovery.card.ayah_2_2.title" = "سُورَةُ البَقَرَةِ 2";
"discovery.card.ayah_2_2.meaning" = "ذَٰلِكَ ٱلْكِتَٰبُ لَا رَيْبَ ۛ فِيهِ ۛ هُدًۭى لِّلْمُتَّقِينَ";
"discovery.card.ayah_2_2.source" = "Qur’an 2:2";

"discovery.card.ayah_2_21.title" = "سُورَةُ البَقَرَةِ 21";
"discovery.card.ayah_2_21.meaning" = "يَٰٓأَيُّهَا ٱلنَّاسُ ٱعْبُدُوا۟ رَبَّكُمُ ٱلَّذِى خَلَقَكُمْ وَٱلَّذِينَ مِن قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ";
"discovery.card.ayah_2_21.source" = "Qur’an 2:21";

"discovery.card.ayah_2_45.title" = "سُورَةُ البَقَرَةِ 45";
"discovery.card.ayah_2_45.meaning" = "وَٱسْتَعِينُوا۟ بِٱلصَّبْرِ وَٱلصَّلَوٰةِ ۚ وَإِنَّهَا لَكَبِيرَةٌ إِلَّا عَلَى ٱلْخَٰشِعِينَ";
"discovery.card.ayah_2_45.source" = "Qur’an 2:45";

"discovery.card.ayah_2_155.title" = "سُورَةُ البَقَرَةِ 155";
"discovery.card.ayah_2_155.meaning" = "وَلَنَبْلُوَنَّكُم بِشَىْءٍۢ مِّنَ ٱلْخَوْفِ وَٱلْجُوعِ وَنَقْصٍۢ مِّنَ ٱلْأَمْوَٰلِ وَٱلْأَنفُسِ وَٱلثَّمَرَٰتِ ۗ وَبَشِّرِ ٱلصَّٰبِرِينَ";
"discovery.card.ayah_2_155.source" = "Qur’an 2:155";

"discovery.card.ayah_2_165.title" = "سُورَةُ البَقَرَةِ 165";
"discovery.card.ayah_2_165.meaning" = "وَمِنَ ٱلنَّاسِ مَن يَتَّخِذُ مِن دُونِ ٱللَّهِ أَندَادًۭا يُحِبُّونَهُمْ كَحُبِّ ٱللَّهِ ۖ وَٱلَّذِينَ ءَامَنُوٓا۟ أَشَدُّ حُبًّۭا لِّلَّهِ ۗ وَلَوْ يَرَى ٱلَّذِينَ ظَلَمُوٓا۟ إِذْ يَرَوْنَ ٱلْعَذَابَ أَنَّ ٱلْقُوَّةَ لِلَّهِ جَمِيعًۭا وَأَنَّ ٱللَّهَ شَدِيدُ ٱلْعَذَابِ";
"discovery.card.ayah_2_165.source" = "Qur’an 2:165";

"discovery.card.ayah_2_177.title" = "سُورَةُ البَقَرَةِ 177";
"discovery.card.ayah_2_177.meaning" = "۞ لَّيْسَ ٱلْبِرَّ أَن تُوَلُّوا۟ وُجُوهَكُمْ قِبَلَ ٱلْمَشْرِقِ وَٱلْمَغْرِبِ وَلَٰكِنَّ ٱلْبِرَّ مَنْ ءَامَنَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ وَٱلْمَلَٰٓئِكَةِ وَٱلْكِتَٰبِ وَٱلنَّبِيِّۦنَ وَءَاتَى ٱلْمَالَ عَلَىٰ حُبِّهِۦ ذَوِى ٱلْقُرْبَىٰ وَٱلْيَتَٰمَىٰ وَٱلْمَسَٰكِينَ وَٱبْنَ ٱلسَّبِيلِ وَٱلسَّآئِلِينَ وَفِى ٱلرِّقَابِ وَأَقَامَ ٱلصَّلَوٰةَ وَءَاتَى ٱلزَّكَوٰةَ وَٱلْمُوفُونَ بِعَهْدِهِمْ إِذَا عَٰهَدُوا۟ ۖ وَٱلصَّٰبِرِينَ فِى ٱلْبَأْسَآءِ وَٱلضَّرَّآءِ وَحِينَ ٱلْبَأْسِ ۗ أُو۟لَٰٓئِكَ ٱلَّذِينَ صَدَقُوا۟ ۖ وَأُو۟لَٰٓئِكَ هُمُ ٱلْمُتَّقُونَ";
"discovery.card.ayah_2_177.source" = "Qur’an 2:177";

"discovery.card.ayah_2_185.title" = "سُورَةُ البَقَرَةِ 185";
"discovery.card.ayah_2_185.meaning" = "شَهْرُ رَمَضَانَ ٱلَّذِىٓ أُنزِلَ فِيهِ ٱلْقُرْءَانُ هُدًۭى لِّلنَّاسِ وَبَيِّنَٰتٍۢ مِّنَ ٱلْهُدَىٰ وَٱلْفُرْقَانِ ۚ فَمَن شَهِدَ مِنكُمُ ٱلشَّهْرَ فَلْيَصُمْهُ ۖ وَمَن كَانَ مَرِيضًا أَوْ عَلَىٰ سَفَرٍۢ فَعِدَّةٌۭ مِّنْ أَيَّامٍ أُخَرَ ۗ يُرِيدُ ٱللَّهُ بِكُمُ ٱلْيُسْرَ وَلَا يُرِيدُ بِكُمُ ٱلْعُسْرَ وَلِتُكْمِلُوا۟ ٱلْعِدَّةَ وَلِتُكَبِّرُوا۟ ٱللَّهَ عَلَىٰ مَا هَدَىٰكُمْ وَلَعَلَّكُمْ تَشْكُرُونَ";
"discovery.card.ayah_2_185.source" = "Qur’an 2:185";

"discovery.card.ayah_2_197.title" = "سُورَةُ البَقَرَةِ 197";
"discovery.card.ayah_2_197.meaning" = "ٱلْحَجُّ أَشْهُرٌۭ مَّعْلُومَٰتٌۭ ۚ فَمَن فَرَضَ فِيهِنَّ ٱلْحَجَّ فَلَا رَفَثَ وَلَا فُسُوقَ وَلَا جِدَالَ فِى ٱلْحَجِّ ۗ وَمَا تَفْعَلُوا۟ مِنْ خَيْرٍۢ يَعْلَمْهُ ٱللَّهُ ۗ وَتَزَوَّدُوا۟ فَإِنَّ خَيْرَ ٱلزَّادِ ٱلتَّقْوَىٰ ۚ وَٱتَّقُونِ يَٰٓأُو۟لِى ٱلْأَلْبَٰبِ";
"discovery.card.ayah_2_197.source" = "Qur’an 2:197";

"discovery.card.ayah_2_208.title" = "سُورَةُ البَقَرَةِ 208";
"discovery.card.ayah_2_208.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱدْخُلُوا۟ فِى ٱلسِّلْمِ كَآفَّةًۭ وَلَا تَتَّبِعُوا۟ خُطُوَٰتِ ٱلشَّيْطَٰنِ ۚ إِنَّهُۥ لَكُمْ عَدُوٌّۭ مُّبِينٌۭ";
"discovery.card.ayah_2_208.source" = "Qur’an 2:208";

"discovery.card.ayah_2_216.title" = "سُورَةُ البَقَرَةِ 216";
"discovery.card.ayah_2_216.meaning" = "كُتِبَ عَلَيْكُمُ ٱلْقِتَالُ وَهُوَ كُرْهٌۭ لَّكُمْ ۖ وَعَسَىٰٓ أَن تَكْرَهُوا۟ شَيْـًۭٔا وَهُوَ خَيْرٌۭ لَّكُمْ ۖ وَعَسَىٰٓ أَن تُحِبُّوا۟ شَيْـًۭٔا وَهُوَ شَرٌّۭ لَّكُمْ ۗ وَٱللَّهُ يَعْلَمُ وَأَنتُمْ لَا تَعْلَمُونَ";
"discovery.card.ayah_2_216.source" = "Qur’an 2:216";

"discovery.card.ayah_2_245.title" = "سُورَةُ البَقَرَةِ 245";
"discovery.card.ayah_2_245.meaning" = "مَّن ذَا ٱلَّذِى يُقْرِضُ ٱللَّهَ قَرْضًا حَسَنًۭا فَيُضَٰعِفَهُۥ لَهُۥٓ أَضْعَافًۭا كَثِيرَةًۭ ۚ وَٱللَّهُ يَقْبِضُ وَيَبْصُۜطُ وَإِلَيْهِ تُرْجَعُونَ";
"discovery.card.ayah_2_245.source" = "Qur’an 2:245";

"discovery.card.ayah_2_254.title" = "سُورَةُ البَقَرَةِ 254";
"discovery.card.ayah_2_254.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ أَنفِقُوا۟ مِمَّا رَزَقْنَٰكُم مِّن قَبْلِ أَن يَأْتِىَ يَوْمٌۭ لَّا بَيْعٌۭ فِيهِ وَلَا خُلَّةٌۭ وَلَا شَفَٰعَةٌۭ ۗ وَٱلْكَٰفِرُونَ هُمُ ٱلظَّٰلِمُونَ";
"discovery.card.ayah_2_254.source" = "Qur’an 2:254";

"discovery.card.ayah_2_267.title" = "سُورَةُ البَقَرَةِ 267";
"discovery.card.ayah_2_267.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ أَنفِقُوا۟ مِن طَيِّبَٰتِ مَا كَسَبْتُمْ وَمِمَّآ أَخْرَجْنَا لَكُم مِّنَ ٱلْأَرْضِ ۖ وَلَا تَيَمَّمُوا۟ ٱلْخَبِيثَ مِنْهُ تُنفِقُونَ وَلَسْتُم بِـَٔاخِذِيهِ إِلَّآ أَن تُغْمِضُوا۟ فِيهِ ۚ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ غَنِىٌّ حَمِيدٌ";
"discovery.card.ayah_2_267.source" = "Qur’an 2:267";

"discovery.card.ayah_2_285.title" = "سُورَةُ البَقَرَةِ 285";
"discovery.card.ayah_2_285.meaning" = "ءَامَنَ ٱلرَّسُولُ بِمَآ أُنزِلَ إِلَيْهِ مِن رَّبِّهِۦ وَٱلْمُؤْمِنُونَ ۚ كُلٌّ ءَامَنَ بِٱللَّهِ وَمَلَٰٓئِكَتِهِۦ وَكُتُبِهِۦ وَرُسُلِهِۦ لَا نُفَرِّقُ بَيْنَ أَحَدٍۢ مِّن رُّسُلِهِۦ ۚ وَقَالُوا۟ سَمِعْنَا وَأَطَعْنَا ۖ غُفْرَانَكَ رَبَّنَا وَإِلَيْكَ ٱلْمَصِيرُ";
"discovery.card.ayah_2_285.source" = "Qur’an 2:285";

"discovery.card.ayah_3_8.title" = "سُورَةُ آلِ عِمۡرَانَ 8";
"discovery.card.ayah_3_8.meaning" = "رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا وَهَبْ لَنَا مِن لَّدُنكَ رَحْمَةً ۚ إِنَّكَ أَنتَ ٱلْوَهَّابُ";
"discovery.card.ayah_3_8.source" = "Qur’an 3:8";

"discovery.card.ayah_3_26.title" = "سُورَةُ آلِ عِمۡرَانَ 26";
"discovery.card.ayah_3_26.meaning" = "قُلِ ٱللَّهُمَّ مَٰلِكَ ٱلْمُلْكِ تُؤْتِى ٱلْمُلْكَ مَن تَشَآءُ وَتَنزِعُ ٱلْمُلْكَ مِمَّن تَشَآءُ وَتُعِزُّ مَن تَشَآءُ وَتُذِلُّ مَن تَشَآءُ ۖ بِيَدِكَ ٱلْخَيْرُ ۖ إِنَّكَ عَلَىٰ كُلِّ شَىْءٍۢ قَدِيرٌۭ";
"discovery.card.ayah_3_26.source" = "Qur’an 3:26";

"discovery.card.ayah_3_31.title" = "سُورَةُ آلِ عِمۡرَانَ 31";
"discovery.card.ayah_3_31.meaning" = "قُلْ إِن كُنتُمْ تُحِبُّونَ ٱللَّهَ فَٱتَّبِعُونِى يُحْبِبْكُمُ ٱللَّهُ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ ۗ وَٱللَّهُ غَفُورٌۭ رَّحِيمٌۭ";
"discovery.card.ayah_3_31.source" = "Qur’an 3:31";

"discovery.card.ayah_3_92.title" = "سُورَةُ آلِ عِمۡرَانَ 92";
"discovery.card.ayah_3_92.meaning" = "لَن تَنَالُوا۟ ٱلْبِرَّ حَتَّىٰ تُنفِقُوا۟ مِمَّا تُحِبُّونَ ۚ وَمَا تُنفِقُوا۟ مِن شَىْءٍۢ فَإِنَّ ٱللَّهَ بِهِۦ عَلِيمٌۭ";
"discovery.card.ayah_3_92.source" = "Qur’an 3:92";

"discovery.card.ayah_3_102.title" = "سُورَةُ آلِ عِمۡرَانَ 102";
"discovery.card.ayah_3_102.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ حَقَّ تُقَاتِهِۦ وَلَا تَمُوتُنَّ إِلَّا وَأَنتُم مُّسْلِمُونَ";
"discovery.card.ayah_3_102.source" = "Qur’an 3:102";

"discovery.card.ayah_3_103.title" = "سُورَةُ آلِ عِمۡرَانَ 103";
"discovery.card.ayah_3_103.meaning" = "وَٱعْتَصِمُوا۟ بِحَبْلِ ٱللَّهِ جَمِيعًۭا وَلَا تَفَرَّقُوا۟ ۚ وَٱذْكُرُوا۟ نِعْمَتَ ٱللَّهِ عَلَيْكُمْ إِذْ كُنتُمْ أَعْدَآءًۭ فَأَلَّفَ بَيْنَ قُلُوبِكُمْ فَأَصْبَحْتُم بِنِعْمَتِهِۦٓ إِخْوَٰنًۭا وَكُنتُمْ عَلَىٰ شَفَا حُفْرَةٍۢ مِّنَ ٱلنَّارِ فَأَنقَذَكُم مِّنْهَا ۗ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمْ ءَايَٰتِهِۦ لَعَلَّكُمْ تَهْتَدُونَ";
"discovery.card.ayah_3_103.source" = "Qur’an 3:103";

"discovery.card.ayah_3_110.title" = "سُورَةُ آلِ عِمۡرَانَ 110";
"discovery.card.ayah_3_110.meaning" = "كُنتُمْ خَيْرَ أُمَّةٍ أُخْرِجَتْ لِلنَّاسِ تَأْمُرُونَ بِٱلْمَعْرُوفِ وَتَنْهَوْنَ عَنِ ٱلْمُنكَرِ وَتُؤْمِنُونَ بِٱللَّهِ ۗ وَلَوْ ءَامَنَ أَهْلُ ٱلْكِتَٰبِ لَكَانَ خَيْرًۭا لَّهُم ۚ مِّنْهُمُ ٱلْمُؤْمِنُونَ وَأَكْثَرُهُمُ ٱلْفَٰسِقُونَ";
"discovery.card.ayah_3_110.source" = "Qur’an 3:110";

"discovery.card.ayah_3_133.title" = "سُورَةُ آلِ عِمۡرَانَ 133";
"discovery.card.ayah_3_133.meaning" = "۞ وَسَارِعُوٓا۟ إِلَىٰ مَغْفِرَةٍۢ مِّن رَّبِّكُمْ وَجَنَّةٍ عَرْضُهَا ٱلسَّمَٰوَٰتُ وَٱلْأَرْضُ أُعِدَّتْ لِلْمُتَّقِينَ";
"discovery.card.ayah_3_133.source" = "Qur’an 3:133";

"discovery.card.ayah_3_139.title" = "سُورَةُ آلِ عِمۡرَانَ 139";
"discovery.card.ayah_3_139.meaning" = "وَلَا تَهِنُوا۟ وَلَا تَحْزَنُوا۟ وَأَنتُمُ ٱلْأَعْلَوْنَ إِن كُنتُم مُّؤْمِنِينَ";
"discovery.card.ayah_3_139.source" = "Qur’an 3:139";

"discovery.card.ayah_3_159.title" = "سُورَةُ آلِ عِمۡرَانَ 159";
"discovery.card.ayah_3_159.meaning" = "فَبِمَا رَحْمَةٍۢ مِّنَ ٱللَّهِ لِنتَ لَهُمْ ۖ وَلَوْ كُنتَ فَظًّا غَلِيظَ ٱلْقَلْبِ لَٱنفَضُّوا۟ مِنْ حَوْلِكَ ۖ فَٱعْفُ عَنْهُمْ وَٱسْتَغْفِرْ لَهُمْ وَشَاوِرْهُمْ فِى ٱلْأَمْرِ ۖ فَإِذَا عَزَمْتَ فَتَوَكَّلْ عَلَى ٱللَّهِ ۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُتَوَكِّلِينَ";
"discovery.card.ayah_3_159.source" = "Qur’an 3:159";

"discovery.card.ayah_3_185.title" = "سُورَةُ آلِ عِمۡرَانَ 185";
"discovery.card.ayah_3_185.meaning" = "كُلُّ نَفْسٍۢ ذَآئِقَةُ ٱلْمَوْتِ ۗ وَإِنَّمَا تُوَفَّوْنَ أُجُورَكُمْ يَوْمَ ٱلْقِيَٰمَةِ ۖ فَمَن زُحْزِحَ عَنِ ٱلنَّارِ وَأُدْخِلَ ٱلْجَنَّةَ فَقَدْ فَازَ ۗ وَمَا ٱلْحَيَوٰةُ ٱلدُّنْيَآ إِلَّا مَتَٰعُ ٱلْغُرُورِ";
"discovery.card.ayah_3_185.source" = "Qur’an 3:185";

"discovery.card.ayah_3_190.title" = "سُورَةُ آلِ عِمۡرَانَ 190";
"discovery.card.ayah_3_190.meaning" = "إِنَّ فِى خَلْقِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَٱخْتِلَٰفِ ٱلَّيْلِ وَٱلنَّهَارِ لَءَايَٰتٍۢ لِّأُو۟لِى ٱلْأَلْبَٰبِ";
"discovery.card.ayah_3_190.source" = "Qur’an 3:190";

"discovery.card.ayah_3_200.title" = "سُورَةُ آلِ عِمۡرَانَ 200";
"discovery.card.ayah_3_200.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱصْبِرُوا۟ وَصَابِرُوا۟ وَرَابِطُوا۟ وَٱتَّقُوا۟ ٱللَّهَ لَعَلَّكُمْ تُفْلِحُونَ";
"discovery.card.ayah_3_200.source" = "Qur’an 3:200";

"discovery.card.ayah_4_1.title" = "سُورَةُ النِّسَاءِ 1";
"discovery.card.ayah_4_1.meaning" = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ يَٰٓأَيُّهَا ٱلنَّاسُ ٱتَّقُوا۟ رَبَّكُمُ ٱلَّذِى خَلَقَكُم مِّن نَّفْسٍۢ وَٰحِدَةٍۢ وَخَلَقَ مِنْهَا زَوْجَهَا وَبَثَّ مِنْهُمَا رِجَالًۭا كَثِيرًۭا وَنِسَآءًۭ ۚ وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِى تَسَآءَلُونَ بِهِۦ وَٱلْأَرْحَامَ ۚ إِنَّ ٱللَّهَ كَانَ عَلَيْكُمْ رَقِيبًۭا";
"discovery.card.ayah_4_1.source" = "Qur’an 4:1";

"discovery.card.ayah_4_29.title" = "سُورَةُ النِّسَاءِ 29";
"discovery.card.ayah_4_29.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَأْكُلُوٓا۟ أَمْوَٰلَكُم بَيْنَكُم بِٱلْبَٰطِلِ إِلَّآ أَن تَكُونَ تِجَٰرَةً عَن تَرَاضٍۢ مِّنكُمْ ۚ وَلَا تَقْتُلُوٓا۟ أَنفُسَكُمْ ۚ إِنَّ ٱللَّهَ كَانَ بِكُمْ رَحِيمًۭا";
"discovery.card.ayah_4_29.source" = "Qur’an 4:29";

"discovery.card.ayah_4_36.title" = "سُورَةُ النِّسَاءِ 36";
"discovery.card.ayah_4_36.meaning" = "۞ وَٱعْبُدُوا۟ ٱللَّهَ وَلَا تُشْرِكُوا۟ بِهِۦ شَيْـًۭٔا ۖ وَبِٱلْوَٰلِدَيْنِ إِحْسَٰنًۭا وَبِذِى ٱلْقُرْبَىٰ وَٱلْيَتَٰمَىٰ وَٱلْمَسَٰكِينِ وَٱلْجَارِ ذِى ٱلْقُرْبَىٰ وَٱلْجَارِ ٱلْجُنُبِ وَٱلصَّاحِبِ بِٱلْجَنۢبِ وَٱبْنِ ٱلسَّبِيلِ وَمَا مَلَكَتْ أَيْمَٰنُكُمْ ۗ إِنَّ ٱللَّهَ لَا يُحِبُّ مَن كَانَ مُخْتَالًۭا فَخُورًا";
"discovery.card.ayah_4_36.source" = "Qur’an 4:36";

"discovery.card.ayah_4_40.title" = "سُورَةُ النِّسَاءِ 40";
"discovery.card.ayah_4_40.meaning" = "إِنَّ ٱللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍۢ ۖ وَإِن تَكُ حَسَنَةًۭ يُضَٰعِفْهَا وَيُؤْتِ مِن لَّدُنْهُ أَجْرًا عَظِيمًۭا";
"discovery.card.ayah_4_40.source" = "Qur’an 4:40";

"discovery.card.ayah_4_59.title" = "سُورَةُ النِّسَاءِ 59";
"discovery.card.ayah_4_59.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ أَطِيعُوا۟ ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ وَأُو۟لِى ٱلْأَمْرِ مِنكُمْ ۖ فَإِن تَنَٰزَعْتُمْ فِى شَىْءٍۢ فَرُدُّوهُ إِلَى ٱللَّهِ وَٱلرَّسُولِ إِن كُنتُمْ تُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ ۚ ذَٰلِكَ خَيْرٌۭ وَأَحْسَنُ تَأْوِيلًا";
"discovery.card.ayah_4_59.source" = "Qur’an 4:59";

"discovery.card.ayah_4_69.title" = "سُورَةُ النِّسَاءِ 69";
"discovery.card.ayah_4_69.meaning" = "وَمَن يُطِعِ ٱللَّهَ وَٱلرَّسُولَ فَأُو۟لَٰٓئِكَ مَعَ ٱلَّذِينَ أَنْعَمَ ٱللَّهُ عَلَيْهِم مِّنَ ٱلنَّبِيِّۦنَ وَٱلصِّدِّيقِينَ وَٱلشُّهَدَآءِ وَٱلصَّٰلِحِينَ ۚ وَحَسُنَ أُو۟لَٰٓئِكَ رَفِيقًۭا";
"discovery.card.ayah_4_69.source" = "Qur’an 4:69";

"discovery.card.ayah_4_86.title" = "سُورَةُ النِّسَاءِ 86";
"discovery.card.ayah_4_86.meaning" = "وَإِذَا حُيِّيتُم بِتَحِيَّةٍۢ فَحَيُّوا۟ بِأَحْسَنَ مِنْهَآ أَوْ رُدُّوهَآ ۗ إِنَّ ٱللَّهَ كَانَ عَلَىٰ كُلِّ شَىْءٍ حَسِيبًا";
"discovery.card.ayah_4_86.source" = "Qur’an 4:86";

"discovery.card.ayah_4_103.title" = "سُورَةُ النِّسَاءِ 103";
"discovery.card.ayah_4_103.meaning" = "فَإِذَا قَضَيْتُمُ ٱلصَّلَوٰةَ فَٱذْكُرُوا۟ ٱللَّهَ قِيَٰمًۭا وَقُعُودًۭا وَعَلَىٰ جُنُوبِكُمْ ۚ فَإِذَا ٱطْمَأْنَنتُمْ فَأَقِيمُوا۟ ٱلصَّلَوٰةَ ۚ إِنَّ ٱلصَّلَوٰةَ كَانَتْ عَلَى ٱلْمُؤْمِنِينَ كِتَٰبًۭا مَّوْقُوتًۭا";
"discovery.card.ayah_4_103.source" = "Qur’an 4:103";

"discovery.card.ayah_4_174.title" = "سُورَةُ النِّسَاءِ 174";
"discovery.card.ayah_4_174.meaning" = "يَٰٓأَيُّهَا ٱلنَّاسُ قَدْ جَآءَكُم بُرْهَٰنٌۭ مِّن رَّبِّكُمْ وَأَنزَلْنَآ إِلَيْكُمْ نُورًۭا مُّبِينًۭا";
"discovery.card.ayah_4_174.source" = "Qur’an 4:174";

"discovery.card.ayah_5_2.title" = "سُورَةُ المَائـِدَةِ 2";
"discovery.card.ayah_5_2.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تُحِلُّوا۟ شَعَٰٓئِرَ ٱللَّهِ وَلَا ٱلشَّهْرَ ٱلْحَرَامَ وَلَا ٱلْهَدْىَ وَلَا ٱلْقَلَٰٓئِدَ وَلَآ ءَآمِّينَ ٱلْبَيْتَ ٱلْحَرَامَ يَبْتَغُونَ فَضْلًۭا مِّن رَّبِّهِمْ وَرِضْوَٰنًۭا ۚ وَإِذَا حَلَلْتُمْ فَٱصْطَادُوا۟ ۚ وَلَا يَجْرِمَنَّكُمْ شَنَـَٔانُ قَوْمٍ أَن صَدُّوكُمْ عَنِ ٱلْمَسْجِدِ ٱلْحَرَامِ أَن تَعْتَدُوا۟ ۘ وَتَعَاوَنُوا۟ عَلَى ٱلْبِرِّ وَٱلتَّقْوَىٰ ۖ وَلَا تَعَاوَنُوا۟ عَلَى ٱلْإِثْمِ وَٱلْعُدْوَٰنِ ۚ وَٱتَّقُوا۟ ٱللَّهَ ۖ إِنَّ ٱللَّهَ شَدِيدُ ٱلْعِقَابِ";
"discovery.card.ayah_5_2.source" = "Qur’an 5:2";

"discovery.card.ayah_5_3.title" = "سُورَةُ المَائـِدَةِ 3";
"discovery.card.ayah_5_3.meaning" = "حُرِّمَتْ عَلَيْكُمُ ٱلْمَيْتَةُ وَٱلدَّمُ وَلَحْمُ ٱلْخِنزِيرِ وَمَآ أُهِلَّ لِغَيْرِ ٱللَّهِ بِهِۦ وَٱلْمُنْخَنِقَةُ وَٱلْمَوْقُوذَةُ وَٱلْمُتَرَدِّيَةُ وَٱلنَّطِيحَةُ وَمَآ أَكَلَ ٱلسَّبُعُ إِلَّا مَا ذَكَّيْتُمْ وَمَا ذُبِحَ عَلَى ٱلنُّصُبِ وَأَن تَسْتَقْسِمُوا۟ بِٱلْأَزْلَٰمِ ۚ ذَٰلِكُمْ فِسْقٌ ۗ ٱلْيَوْمَ يَئِسَ ٱلَّذِينَ كَفَرُوا۟ مِن دِينِكُمْ فَلَا تَخْشَوْهُمْ وَٱخْشَوْنِ ۚ ٱلْيَوْمَ أَكْمَلْتُ لَكُمْ دِينَكُمْ وَأَتْمَمْتُ عَلَيْكُمْ نِعْمَتِى وَرَضِيتُ لَكُمُ ٱلْإِسْلَٰمَ دِينًۭا ۚ فَمَنِ ٱضْطُرَّ فِى مَخْمَصَةٍ غَيْرَ مُتَجَانِفٍۢ لِّإِثْمٍۢ ۙ فَإِنَّ ٱللَّهَ غَفُورٌۭ رَّحِيمٌۭ";
"discovery.card.ayah_5_3.source" = "Qur’an 5:3";

"discovery.card.ayah_5_6.title" = "سُورَةُ المَائـِدَةِ 6";
"discovery.card.ayah_5_6.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا قُمْتُمْ إِلَى ٱلصَّلَوٰةِ فَٱغْسِلُوا۟ وُجُوهَكُمْ وَأَيْدِيَكُمْ إِلَى ٱلْمَرَافِقِ وَٱمْسَحُوا۟ بِرُءُوسِكُمْ وَأَرْجُلَكُمْ إِلَى ٱلْكَعْبَيْنِ ۚ وَإِن كُنتُمْ جُنُبًۭا فَٱطَّهَّرُوا۟ ۚ وَإِن كُنتُم مَّرْضَىٰٓ أَوْ عَلَىٰ سَفَرٍ أَوْ جَآءَ أَحَدٌۭ مِّنكُم مِّنَ ٱلْغَآئِطِ أَوْ لَٰمَسْتُمُ ٱلنِّسَآءَ فَلَمْ تَجِدُوا۟ مَآءًۭ فَتَيَمَّمُوا۟ صَعِيدًۭا طَيِّبًۭا فَٱمْسَحُوا۟ بِوُجُوهِكُمْ وَأَيْدِيكُم مِّنْهُ ۚ مَا يُرِيدُ ٱللَّهُ لِيَجْعَلَ عَلَيْكُم مِّنْ حَرَجٍۢ وَلَٰكِن يُرِيدُ لِيُطَهِّرَكُمْ وَلِيُتِمَّ نِعْمَتَهُۥ عَلَيْكُمْ لَعَلَّكُمْ تَشْكُرُونَ";
"discovery.card.ayah_5_6.source" = "Qur’an 5:6";

"discovery.card.ayah_5_8.title" = "سُورَةُ المَائـِدَةِ 8";
"discovery.card.ayah_5_8.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ كُونُوا۟ قَوَّٰمِينَ لِلَّهِ شُهَدَآءَ بِٱلْقِسْطِ ۖ وَلَا يَجْرِمَنَّكُمْ شَنَـَٔانُ قَوْمٍ عَلَىٰٓ أَلَّا تَعْدِلُوا۟ ۚ ٱعْدِلُوا۟ هُوَ أَقْرَبُ لِلتَّقْوَىٰ ۖ وَٱتَّقُوا۟ ٱللَّهَ ۚ إِنَّ ٱللَّهَ خَبِيرٌۢ بِمَا تَعْمَلُونَ";
"discovery.card.ayah_5_8.source" = "Qur’an 5:8";

"discovery.card.ayah_5_32.title" = "سُورَةُ المَائـِدَةِ 32";
"discovery.card.ayah_5_32.meaning" = "مِنْ أَجْلِ ذَٰلِكَ كَتَبْنَا عَلَىٰ بَنِىٓ إِسْرَٰٓءِيلَ أَنَّهُۥ مَن قَتَلَ نَفْسًۢا بِغَيْرِ نَفْسٍ أَوْ فَسَادٍۢ فِى ٱلْأَرْضِ فَكَأَنَّمَا قَتَلَ ٱلنَّاسَ جَمِيعًۭا وَمَنْ أَحْيَاهَا فَكَأَنَّمَآ أَحْيَا ٱلنَّاسَ جَمِيعًۭا ۚ وَلَقَدْ جَآءَتْهُمْ رُسُلُنَا بِٱلْبَيِّنَٰتِ ثُمَّ إِنَّ كَثِيرًۭا مِّنْهُم بَعْدَ ذَٰلِكَ فِى ٱلْأَرْضِ لَمُسْرِفُونَ";
"discovery.card.ayah_5_32.source" = "Qur’an 5:32";

"discovery.card.ayah_5_35.title" = "سُورَةُ المَائـِدَةِ 35";
"discovery.card.ayah_5_35.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَٱبْتَغُوٓا۟ إِلَيْهِ ٱلْوَسِيلَةَ وَجَٰهِدُوا۟ فِى سَبِيلِهِۦ لَعَلَّكُمْ تُفْلِحُونَ";
"discovery.card.ayah_5_35.source" = "Qur’an 5:35";

"discovery.card.ayah_5_54.title" = "سُورَةُ المَائـِدَةِ 54";
"discovery.card.ayah_5_54.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ مَن يَرْتَدَّ مِنكُمْ عَن دِينِهِۦ فَسَوْفَ يَأْتِى ٱللَّهُ بِقَوْمٍۢ يُحِبُّهُمْ وَيُحِبُّونَهُۥٓ أَذِلَّةٍ عَلَى ٱلْمُؤْمِنِينَ أَعِزَّةٍ عَلَى ٱلْكَٰفِرِينَ يُجَٰهِدُونَ فِى سَبِيلِ ٱللَّهِ وَلَا يَخَافُونَ لَوْمَةَ لَآئِمٍۢ ۚ ذَٰلِكَ فَضْلُ ٱللَّهِ يُؤْتِيهِ مَن يَشَآءُ ۚ وَٱللَّهُ وَٰسِعٌ عَلِيمٌ";
"discovery.card.ayah_5_54.source" = "Qur’an 5:54";

"discovery.card.ayah_5_119.title" = "سُورَةُ المَائـِدَةِ 119";
"discovery.card.ayah_5_119.meaning" = "قَالَ ٱللَّهُ هَٰذَا يَوْمُ يَنفَعُ ٱلصَّٰدِقِينَ صِدْقُهُمْ ۚ لَهُمْ جَنَّٰتٌۭ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدًۭا ۚ رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُوا۟ عَنْهُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْعَظِيمُ";
"discovery.card.ayah_5_119.source" = "Qur’an 5:119";

"discovery.card.ayah_6_17.title" = "سُورَةُ الأَنۡعَامِ 17";
"discovery.card.ayah_6_17.meaning" = "وَإِن يَمْسَسْكَ ٱللَّهُ بِضُرٍّۢ فَلَا كَاشِفَ لَهُۥٓ إِلَّا هُوَ ۖ وَإِن يَمْسَسْكَ بِخَيْرٍۢ فَهُوَ عَلَىٰ كُلِّ شَىْءٍۢ قَدِيرٌۭ";
"discovery.card.ayah_6_17.source" = "Qur’an 6:17";

"discovery.card.ayah_6_54.title" = "سُورَةُ الأَنۡعَامِ 54";
"discovery.card.ayah_6_54.meaning" = "وَإِذَا جَآءَكَ ٱلَّذِينَ يُؤْمِنُونَ بِـَٔايَٰتِنَا فَقُلْ سَلَٰمٌ عَلَيْكُمْ ۖ كَتَبَ رَبُّكُمْ عَلَىٰ نَفْسِهِ ٱلرَّحْمَةَ ۖ أَنَّهُۥ مَنْ عَمِلَ مِنكُمْ سُوٓءًۢا بِجَهَٰلَةٍۢ ثُمَّ تَابَ مِنۢ بَعْدِهِۦ وَأَصْلَحَ فَأَنَّهُۥ غَفُورٌۭ رَّحِيمٌۭ";
"discovery.card.ayah_6_54.source" = "Qur’an 6:54";

"discovery.card.ayah_6_125.title" = "سُورَةُ الأَنۡعَامِ 125";
"discovery.card.ayah_6_125.meaning" = "فَمَن يُرِدِ ٱللَّهُ أَن يَهْدِيَهُۥ يَشْرَحْ صَدْرَهُۥ لِلْإِسْلَٰمِ ۖ وَمَن يُرِدْ أَن يُضِلَّهُۥ يَجْعَلْ صَدْرَهُۥ ضَيِّقًا حَرَجًۭا كَأَنَّمَا يَصَّعَّدُ فِى ٱلسَّمَآءِ ۚ كَذَٰلِكَ يَجْعَلُ ٱللَّهُ ٱلرِّجْسَ عَلَى ٱلَّذِينَ لَا يُؤْمِنُونَ";
"discovery.card.ayah_6_125.source" = "Qur’an 6:125";

"discovery.card.ayah_6_151.title" = "سُورَةُ الأَنۡعَامِ 151";
"discovery.card.ayah_6_151.meaning" = "۞ قُلْ تَعَالَوْا۟ أَتْلُ مَا حَرَّمَ رَبُّكُمْ عَلَيْكُمْ ۖ أَلَّا تُشْرِكُوا۟ بِهِۦ شَيْـًۭٔا ۖ وَبِٱلْوَٰلِدَيْنِ إِحْسَٰنًۭا ۖ وَلَا تَقْتُلُوٓا۟ أَوْلَٰدَكُم مِّنْ إِمْلَٰقٍۢ ۖ نَّحْنُ نَرْزُقُكُمْ وَإِيَّاهُمْ ۖ وَلَا تَقْرَبُوا۟ ٱلْفَوَٰحِشَ مَا ظَهَرَ مِنْهَا وَمَا بَطَنَ ۖ وَلَا تَقْتُلُوا۟ ٱلنَّفْسَ ٱلَّتِى حَرَّمَ ٱللَّهُ إِلَّا بِٱلْحَقِّ ۚ ذَٰلِكُمْ وَصَّىٰكُم بِهِۦ لَعَلَّكُمْ تَعْقِلُونَ";
"discovery.card.ayah_6_151.source" = "Qur’an 6:151";

"discovery.card.ayah_6_162.title" = "سُورَةُ الأَنۡعَامِ 162";
"discovery.card.ayah_6_162.meaning" = "قُلْ إِنَّ صَلَاتِى وَنُسُكِى وَمَحْيَاىَ وَمَمَاتِى لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ";
"discovery.card.ayah_6_162.source" = "Qur’an 6:162";

"discovery.card.ayah_7_23.title" = "سُورَةُ الأَعۡرَافِ 23";
"discovery.card.ayah_7_23.meaning" = "قَالَا رَبَّنَا ظَلَمْنَآ أَنفُسَنَا وَإِن لَّمْ تَغْفِرْ لَنَا وَتَرْحَمْنَا لَنَكُونَنَّ مِنَ ٱلْخَٰسِرِينَ";
"discovery.card.ayah_7_23.source" = "Qur’an 7:23";

"discovery.card.ayah_7_31.title" = "سُورَةُ الأَعۡرَافِ 31";
"discovery.card.ayah_7_31.meaning" = "۞ يَٰبَنِىٓ ءَادَمَ خُذُوا۟ زِينَتَكُمْ عِندَ كُلِّ مَسْجِدٍۢ وَكُلُوا۟ وَٱشْرَبُوا۟ وَلَا تُسْرِفُوٓا۟ ۚ إِنَّهُۥ لَا يُحِبُّ ٱلْمُسْرِفِينَ";
"discovery.card.ayah_7_31.source" = "Qur’an 7:31";

"discovery.card.ayah_7_56.title" = "سُورَةُ الأَعۡرَافِ 56";
"discovery.card.ayah_7_56.meaning" = "وَلَا تُفْسِدُوا۟ فِى ٱلْأَرْضِ بَعْدَ إِصْلَٰحِهَا وَٱدْعُوهُ خَوْفًۭا وَطَمَعًا ۚ إِنَّ رَحْمَتَ ٱللَّهِ قَرِيبٌۭ مِّنَ ٱلْمُحْسِنِينَ";
"discovery.card.ayah_7_56.source" = "Qur’an 7:56";

"discovery.card.ayah_7_128.title" = "سُورَةُ الأَعۡرَافِ 128";
"discovery.card.ayah_7_128.meaning" = "قَالَ مُوسَىٰ لِقَوْمِهِ ٱسْتَعِينُوا۟ بِٱللَّهِ وَٱصْبِرُوٓا۟ ۖ إِنَّ ٱلْأَرْضَ لِلَّهِ يُورِثُهَا مَن يَشَآءُ مِنْ عِبَادِهِۦ ۖ وَٱلْعَٰقِبَةُ لِلْمُتَّقِينَ";
"discovery.card.ayah_7_128.source" = "Qur’an 7:128";

"discovery.card.ayah_7_199.title" = "سُورَةُ الأَعۡرَافِ 199";
"discovery.card.ayah_7_199.meaning" = "خُذِ ٱلْعَفْوَ وَأْمُرْ بِٱلْعُرْفِ وَأَعْرِضْ عَنِ ٱلْجَٰهِلِينَ";
"discovery.card.ayah_7_199.source" = "Qur’an 7:199";

"discovery.card.ayah_7_204.title" = "سُورَةُ الأَعۡرَافِ 204";
"discovery.card.ayah_7_204.meaning" = "وَإِذَا قُرِئَ ٱلْقُرْءَانُ فَٱسْتَمِعُوا۟ لَهُۥ وَأَنصِتُوا۟ لَعَلَّكُمْ تُرْحَمُونَ";
"discovery.card.ayah_7_204.source" = "Qur’an 7:204";

"discovery.card.ayah_8_2.title" = "سُورَةُ الأَنفَالِ 2";
"discovery.card.ayah_8_2.meaning" = "إِنَّمَا ٱلْمُؤْمِنُونَ ٱلَّذِينَ إِذَا ذُكِرَ ٱللَّهُ وَجِلَتْ قُلُوبُهُمْ وَإِذَا تُلِيَتْ عَلَيْهِمْ ءَايَٰتُهُۥ زَادَتْهُمْ إِيمَٰنًۭا وَعَلَىٰ رَبِّهِمْ يَتَوَكَّلُونَ";
"discovery.card.ayah_8_2.source" = "Qur’an 8:2";

"discovery.card.ayah_8_29.title" = "سُورَةُ الأَنفَالِ 29";
"discovery.card.ayah_8_29.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِن تَتَّقُوا۟ ٱللَّهَ يَجْعَل لَّكُمْ فُرْقَانًۭا وَيُكَفِّرْ عَنكُمْ سَيِّـَٔاتِكُمْ وَيَغْفِرْ لَكُمْ ۗ وَٱللَّهُ ذُو ٱلْفَضْلِ ٱلْعَظِيمِ";
"discovery.card.ayah_8_29.source" = "Qur’an 8:29";

"discovery.card.ayah_8_46.title" = "سُورَةُ الأَنفَالِ 46";
"discovery.card.ayah_8_46.meaning" = "وَأَطِيعُوا۟ ٱللَّهَ وَرَسُولَهُۥ وَلَا تَنَٰزَعُوا۟ فَتَفْشَلُوا۟ وَتَذْهَبَ رِيحُكُمْ ۖ وَٱصْبِرُوٓا۟ ۚ إِنَّ ٱللَّهَ مَعَ ٱلصَّٰبِرِينَ";
"discovery.card.ayah_8_46.source" = "Qur’an 8:46";

"discovery.card.ayah_8_61.title" = "سُورَةُ الأَنفَالِ 61";
"discovery.card.ayah_8_61.meaning" = "۞ وَإِن جَنَحُوا۟ لِلسَّلْمِ فَٱجْنَحْ لَهَا وَتَوَكَّلْ عَلَى ٱللَّهِ ۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ";
"discovery.card.ayah_8_61.source" = "Qur’an 8:61";

"discovery.card.ayah_9_18.title" = "سُورَةُ التَّوۡبَةِ 18";
"discovery.card.ayah_9_18.meaning" = "إِنَّمَا يَعْمُرُ مَسَٰجِدَ ٱللَّهِ مَنْ ءَامَنَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ وَأَقَامَ ٱلصَّلَوٰةَ وَءَاتَى ٱلزَّكَوٰةَ وَلَمْ يَخْشَ إِلَّا ٱللَّهَ ۖ فَعَسَىٰٓ أُو۟لَٰٓئِكَ أَن يَكُونُوا۟ مِنَ ٱلْمُهْتَدِينَ";
"discovery.card.ayah_9_18.source" = "Qur’an 9:18";

"discovery.card.ayah_9_40.title" = "سُورَةُ التَّوۡبَةِ 40";
"discovery.card.ayah_9_40.meaning" = "إِلَّا تَنصُرُوهُ فَقَدْ نَصَرَهُ ٱللَّهُ إِذْ أَخْرَجَهُ ٱلَّذِينَ كَفَرُوا۟ ثَانِىَ ٱثْنَيْنِ إِذْ هُمَا فِى ٱلْغَارِ إِذْ يَقُولُ لِصَٰحِبِهِۦ لَا تَحْزَنْ إِنَّ ٱللَّهَ مَعَنَا ۖ فَأَنزَلَ ٱللَّهُ سَكِينَتَهُۥ عَلَيْهِ وَأَيَّدَهُۥ بِجُنُودٍۢ لَّمْ تَرَوْهَا وَجَعَلَ كَلِمَةَ ٱلَّذِينَ كَفَرُوا۟ ٱلسُّفْلَىٰ ۗ وَكَلِمَةُ ٱللَّهِ هِىَ ٱلْعُلْيَا ۗ وَٱللَّهُ عَزِيزٌ حَكِيمٌ";
"discovery.card.ayah_9_40.source" = "Qur’an 9:40";

"discovery.card.ayah_9_51.title" = "سُورَةُ التَّوۡبَةِ 51";
"discovery.card.ayah_9_51.meaning" = "قُل لَّن يُصِيبَنَآ إِلَّا مَا كَتَبَ ٱللَّهُ لَنَا هُوَ مَوْلَىٰنَا ۚ وَعَلَى ٱللَّهِ فَلْيَتَوَكَّلِ ٱلْمُؤْمِنُونَ";
"discovery.card.ayah_9_51.source" = "Qur’an 9:51";

"discovery.card.ayah_9_71.title" = "سُورَةُ التَّوۡبَةِ 71";
"discovery.card.ayah_9_71.meaning" = "وَٱلْمُؤْمِنُونَ وَٱلْمُؤْمِنَٰتُ بَعْضُهُمْ أَوْلِيَآءُ بَعْضٍۢ ۚ يَأْمُرُونَ بِٱلْمَعْرُوفِ وَيَنْهَوْنَ عَنِ ٱلْمُنكَرِ وَيُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤْتُونَ ٱلزَّكَوٰةَ وَيُطِيعُونَ ٱللَّهَ وَرَسُولَهُۥٓ ۚ أُو۟لَٰٓئِكَ سَيَرْحَمُهُمُ ٱللَّهُ ۗ إِنَّ ٱللَّهَ عَزِيزٌ حَكِيمٌۭ";
"discovery.card.ayah_9_71.source" = "Qur’an 9:71";

"discovery.card.ayah_9_103.title" = "سُورَةُ التَّوۡبَةِ 103";
"discovery.card.ayah_9_103.meaning" = "خُذْ مِنْ أَمْوَٰلِهِمْ صَدَقَةًۭ تُطَهِّرُهُمْ وَتُزَكِّيهِم بِهَا وَصَلِّ عَلَيْهِمْ ۖ إِنَّ صَلَوٰتَكَ سَكَنٌۭ لَّهُمْ ۗ وَٱللَّهُ سَمِيعٌ عَلِيمٌ";
"discovery.card.ayah_9_103.source" = "Qur’an 9:103";

"discovery.card.ayah_9_128.title" = "سُورَةُ التَّوۡبَةِ 128";
"discovery.card.ayah_9_128.meaning" = "لَقَدْ جَآءَكُمْ رَسُولٌۭ مِّنْ أَنفُسِكُمْ عَزِيزٌ عَلَيْهِ مَا عَنِتُّمْ حَرِيصٌ عَلَيْكُم بِٱلْمُؤْمِنِينَ رَءُوفٌۭ رَّحِيمٌۭ";
"discovery.card.ayah_9_128.source" = "Qur’an 9:128";

"discovery.card.ayah_10_25.title" = "سُورَةُ يُونُسَ 25";
"discovery.card.ayah_10_25.meaning" = "وَٱللَّهُ يَدْعُوٓا۟ إِلَىٰ دَارِ ٱلسَّلَٰمِ وَيَهْدِى مَن يَشَآءُ إِلَىٰ صِرَٰطٍۢ مُّسْتَقِيمٍۢ";
"discovery.card.ayah_10_25.source" = "Qur’an 10:25";

"discovery.card.ayah_10_57.title" = "سُورَةُ يُونُسَ 57";
"discovery.card.ayah_10_57.meaning" = "يَٰٓأَيُّهَا ٱلنَّاسُ قَدْ جَآءَتْكُم مَّوْعِظَةٌۭ مِّن رَّبِّكُمْ وَشِفَآءٌۭ لِّمَا فِى ٱلصُّدُورِ وَهُدًۭى وَرَحْمَةٌۭ لِّلْمُؤْمِنِينَ";
"discovery.card.ayah_10_57.source" = "Qur’an 10:57";

"discovery.card.ayah_10_62.title" = "سُورَةُ يُونُسَ 62";
"discovery.card.ayah_10_62.meaning" = "أَلَآ إِنَّ أَوْلِيَآءَ ٱللَّهِ لَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ";
"discovery.card.ayah_10_62.source" = "Qur’an 10:62";

"discovery.card.ayah_10_107.title" = "سُورَةُ يُونُسَ 107";
"discovery.card.ayah_10_107.meaning" = "وَإِن يَمْسَسْكَ ٱللَّهُ بِضُرٍّۢ فَلَا كَاشِفَ لَهُۥٓ إِلَّا هُوَ ۖ وَإِن يُرِدْكَ بِخَيْرٍۢ فَلَا رَآدَّ لِفَضْلِهِۦ ۚ يُصِيبُ بِهِۦ مَن يَشَآءُ مِنْ عِبَادِهِۦ ۚ وَهُوَ ٱلْغَفُورُ ٱلرَّحِيمُ";
"discovery.card.ayah_10_107.source" = "Qur’an 10:107";

"discovery.card.ayah_11_88.title" = "سُورَةُ هُودٍ 88";
"discovery.card.ayah_11_88.meaning" = "قَالَ يَٰقَوْمِ أَرَءَيْتُمْ إِن كُنتُ عَلَىٰ بَيِّنَةٍۢ مِّن رَّبِّى وَرَزَقَنِى مِنْهُ رِزْقًا حَسَنًۭا ۚ وَمَآ أُرِيدُ أَنْ أُخَالِفَكُمْ إِلَىٰ مَآ أَنْهَىٰكُمْ عَنْهُ ۚ إِنْ أُرِيدُ إِلَّا ٱلْإِصْلَٰحَ مَا ٱسْتَطَعْتُ ۚ وَمَا تَوْفِيقِىٓ إِلَّا بِٱللَّهِ ۚ عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ";
"discovery.card.ayah_11_88.source" = "Qur’an 11:88";

"discovery.card.ayah_11_114.title" = "سُورَةُ هُودٍ 114";
"discovery.card.ayah_11_114.meaning" = "وَأَقِمِ ٱلصَّلَوٰةَ طَرَفَىِ ٱلنَّهَارِ وَزُلَفًۭا مِّنَ ٱلَّيْلِ ۚ إِنَّ ٱلْحَسَنَٰتِ يُذْهِبْنَ ٱلسَّيِّـَٔاتِ ۚ ذَٰلِكَ ذِكْرَىٰ لِلذَّٰكِرِينَ";
"discovery.card.ayah_11_114.source" = "Qur’an 11:114";

"discovery.card.ayah_12_21.title" = "سُورَةُ يُوسُفَ 21";
"discovery.card.ayah_12_21.meaning" = "وَقَالَ ٱلَّذِى ٱشْتَرَىٰهُ مِن مِّصْرَ لِٱمْرَأَتِهِۦٓ أَكْرِمِى مَثْوَىٰهُ عَسَىٰٓ أَن يَنفَعَنَآ أَوْ نَتَّخِذَهُۥ وَلَدًۭا ۚ وَكَذَٰلِكَ مَكَّنَّا لِيُوسُفَ فِى ٱلْأَرْضِ وَلِنُعَلِّمَهُۥ مِن تَأْوِيلِ ٱلْأَحَادِيثِ ۚ وَٱللَّهُ غَالِبٌ عَلَىٰٓ أَمْرِهِۦ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ";
"discovery.card.ayah_12_21.source" = "Qur’an 12:21";

"discovery.card.ayah_12_87.title" = "سُورَةُ يُوسُفَ 87";
"discovery.card.ayah_12_87.meaning" = "يَٰبَنِىَّ ٱذْهَبُوا۟ فَتَحَسَّسُوا۟ مِن يُوسُفَ وَأَخِيهِ وَلَا تَا۟يْـَٔسُوا۟ مِن رَّوْحِ ٱللَّهِ ۖ إِنَّهُۥ لَا يَا۟يْـَٔسُ مِن رَّوْحِ ٱللَّهِ إِلَّا ٱلْقَوْمُ ٱلْكَٰفِرُونَ";
"discovery.card.ayah_12_87.source" = "Qur’an 12:87";

"discovery.card.ayah_12_90.title" = "سُورَةُ يُوسُفَ 90";
"discovery.card.ayah_12_90.meaning" = "قَالُوٓا۟ أَءِنَّكَ لَأَنتَ يُوسُفُ ۖ قَالَ أَنَا۠ يُوسُفُ وَهَٰذَآ أَخِى ۖ قَدْ مَنَّ ٱللَّهُ عَلَيْنَآ ۖ إِنَّهُۥ مَن يَتَّقِ وَيَصْبِرْ فَإِنَّ ٱللَّهَ لَا يُضِيعُ أَجْرَ ٱلْمُحْسِنِينَ";
"discovery.card.ayah_12_90.source" = "Qur’an 12:90";

"discovery.card.ayah_13_11.title" = "سُورَةُ الرَّعۡدِ 11";
"discovery.card.ayah_13_11.meaning" = "لَهُۥ مُعَقِّبَٰتٌۭ مِّنۢ بَيْنِ يَدَيْهِ وَمِنْ خَلْفِهِۦ يَحْفَظُونَهُۥ مِنْ أَمْرِ ٱللَّهِ ۗ إِنَّ ٱللَّهَ لَا يُغَيِّرُ مَا بِقَوْمٍ حَتَّىٰ يُغَيِّرُوا۟ مَا بِأَنفُسِهِمْ ۗ وَإِذَآ أَرَادَ ٱللَّهُ بِقَوْمٍۢ سُوٓءًۭا فَلَا مَرَدَّ لَهُۥ ۚ وَمَا لَهُم مِّن دُونِهِۦ مِن وَالٍ";
"discovery.card.ayah_13_11.source" = "Qur’an 13:11";

"discovery.card.ayah_13_28.title" = "سُورَةُ الرَّعۡدِ 28";
"discovery.card.ayah_13_28.meaning" = "ٱلَّذِينَ ءَامَنُوا۟ وَتَطْمَئِنُّ قُلُوبُهُم بِذِكْرِ ٱللَّهِ ۗ أَلَا بِذِكْرِ ٱللَّهِ تَطْمَئِنُّ ٱلْقُلُوبُ";
"discovery.card.ayah_13_28.source" = "Qur’an 13:28";

"discovery.card.ayah_14_24.title" = "سُورَةُ إِبۡرَاهِيمَ 24";
"discovery.card.ayah_14_24.meaning" = "أَلَمْ تَرَ كَيْفَ ضَرَبَ ٱللَّهُ مَثَلًۭا كَلِمَةًۭ طَيِّبَةًۭ كَشَجَرَةٍۢ طَيِّبَةٍ أَصْلُهَا ثَابِتٌۭ وَفَرْعُهَا فِى ٱلسَّمَآءِ";
"discovery.card.ayah_14_24.source" = "Qur’an 14:24";

"discovery.card.ayah_15_9.title" = "سُورَةُ الحِجۡرِ 9";
"discovery.card.ayah_15_9.meaning" = "إِنَّا نَحْنُ نَزَّلْنَا ٱلذِّكْرَ وَإِنَّا لَهُۥ لَحَٰفِظُونَ";
"discovery.card.ayah_15_9.source" = "Qur’an 15:9";

"discovery.card.ayah_15_49.title" = "سُورَةُ الحِجۡرِ 49";
"discovery.card.ayah_15_49.meaning" = "۞ نَبِّئْ عِبَادِىٓ أَنِّىٓ أَنَا ٱلْغَفُورُ ٱلرَّحِيمُ";
"discovery.card.ayah_15_49.source" = "Qur’an 15:49";

"discovery.card.ayah_16_90.title" = "سُورَةُ النَّحۡلِ 90";
"discovery.card.ayah_16_90.meaning" = "۞ إِنَّ ٱللَّهَ يَأْمُرُ بِٱلْعَدْلِ وَٱلْإِحْسَٰنِ وَإِيتَآئِ ذِى ٱلْقُرْبَىٰ وَيَنْهَىٰ عَنِ ٱلْفَحْشَآءِ وَٱلْمُنكَرِ وَٱلْبَغْىِ ۚ يَعِظُكُمْ لَعَلَّكُمْ تَذَكَّرُونَ";
"discovery.card.ayah_16_90.source" = "Qur’an 16:90";

"discovery.card.ayah_16_97.title" = "سُورَةُ النَّحۡلِ 97";
"discovery.card.ayah_16_97.meaning" = "مَنْ عَمِلَ صَٰلِحًۭا مِّن ذَكَرٍ أَوْ أُنثَىٰ وَهُوَ مُؤْمِنٌۭ فَلَنُحْيِيَنَّهُۥ حَيَوٰةًۭ طَيِّبَةًۭ ۖ وَلَنَجْزِيَنَّهُمْ أَجْرَهُم بِأَحْسَنِ مَا كَانُوا۟ يَعْمَلُونَ";
"discovery.card.ayah_16_97.source" = "Qur’an 16:97";

"discovery.card.ayah_16_125.title" = "سُورَةُ النَّحۡلِ 125";
"discovery.card.ayah_16_125.meaning" = "ٱدْعُ إِلَىٰ سَبِيلِ رَبِّكَ بِٱلْحِكْمَةِ وَٱلْمَوْعِظَةِ ٱلْحَسَنَةِ ۖ وَجَٰدِلْهُم بِٱلَّتِى هِىَ أَحْسَنُ ۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ ۖ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ";
"discovery.card.ayah_16_125.source" = "Qur’an 16:125";

"discovery.card.ayah_17_9.title" = "سُورَةُ الإِسۡرَاءِ 9";
"discovery.card.ayah_17_9.meaning" = "إِنَّ هَٰذَا ٱلْقُرْءَانَ يَهْدِى لِلَّتِى هِىَ أَقْوَمُ وَيُبَشِّرُ ٱلْمُؤْمِنِينَ ٱلَّذِينَ يَعْمَلُونَ ٱلصَّٰلِحَٰتِ أَنَّ لَهُمْ أَجْرًۭا كَبِيرًۭا";
"discovery.card.ayah_17_9.source" = "Qur’an 17:9";

"discovery.card.ayah_17_24.title" = "سُورَةُ الإِسۡرَاءِ 24";
"discovery.card.ayah_17_24.meaning" = "وَٱخْفِضْ لَهُمَا جَنَاحَ ٱلذُّلِّ مِنَ ٱلرَّحْمَةِ وَقُل رَّبِّ ٱرْحَمْهُمَا كَمَا رَبَّيَانِى صَغِيرًۭا";
"discovery.card.ayah_17_24.source" = "Qur’an 17:24";

"discovery.card.ayah_17_26.title" = "سُورَةُ الإِسۡرَاءِ 26";
"discovery.card.ayah_17_26.meaning" = "وَءَاتِ ذَا ٱلْقُرْبَىٰ حَقَّهُۥ وَٱلْمِسْكِينَ وَٱبْنَ ٱلسَّبِيلِ وَلَا تُبَذِّرْ تَبْذِيرًا";
"discovery.card.ayah_17_26.source" = "Qur’an 17:26";

"discovery.card.ayah_17_32.title" = "سُورَةُ الإِسۡرَاءِ 32";
"discovery.card.ayah_17_32.meaning" = "وَلَا تَقْرَبُوا۟ ٱلزِّنَىٰٓ ۖ إِنَّهُۥ كَانَ فَٰحِشَةًۭ وَسَآءَ سَبِيلًۭا";
"discovery.card.ayah_17_32.source" = "Qur’an 17:32";

"discovery.card.ayah_17_53.title" = "سُورَةُ الإِسۡرَاءِ 53";
"discovery.card.ayah_17_53.meaning" = "وَقُل لِّعِبَادِى يَقُولُوا۟ ٱلَّتِى هِىَ أَحْسَنُ ۚ إِنَّ ٱلشَّيْطَٰنَ يَنزَغُ بَيْنَهُمْ ۚ إِنَّ ٱلشَّيْطَٰنَ كَانَ لِلْإِنسَٰنِ عَدُوًّۭا مُّبِينًۭا";
"discovery.card.ayah_17_53.source" = "Qur’an 17:53";

"discovery.card.ayah_17_70.title" = "سُورَةُ الإِسۡرَاءِ 70";
"discovery.card.ayah_17_70.meaning" = "۞ وَلَقَدْ كَرَّمْنَا بَنِىٓ ءَادَمَ وَحَمَلْنَٰهُمْ فِى ٱلْبَرِّ وَٱلْبَحْرِ وَرَزَقْنَٰهُم مِّنَ ٱلطَّيِّبَٰتِ وَفَضَّلْنَٰهُمْ عَلَىٰ كَثِيرٍۢ مِّمَّنْ خَلَقْنَا تَفْضِيلًۭا";
"discovery.card.ayah_17_70.source" = "Qur’an 17:70";

"discovery.card.ayah_17_80.title" = "سُورَةُ الإِسۡرَاءِ 80";
"discovery.card.ayah_17_80.meaning" = "وَقُل رَّبِّ أَدْخِلْنِى مُدْخَلَ صِدْقٍۢ وَأَخْرِجْنِى مُخْرَجَ صِدْقٍۢ وَٱجْعَل لِّى مِن لَّدُنكَ سُلْطَٰنًۭا نَّصِيرًۭا";
"discovery.card.ayah_17_80.source" = "Qur’an 17:80";

"discovery.card.ayah_17_110.title" = "سُورَةُ الإِسۡرَاءِ 110";
"discovery.card.ayah_17_110.meaning" = "قُلِ ٱدْعُوا۟ ٱللَّهَ أَوِ ٱدْعُوا۟ ٱلرَّحْمَٰنَ ۖ أَيًّۭا مَّا تَدْعُوا۟ فَلَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ ۚ وَلَا تَجْهَرْ بِصَلَاتِكَ وَلَا تُخَافِتْ بِهَا وَٱبْتَغِ بَيْنَ ذَٰلِكَ سَبِيلًۭا";
"discovery.card.ayah_17_110.source" = "Qur’an 17:110";

"discovery.card.ayah_18_10.title" = "سُورَةُ الكَهۡفِ 10";
"discovery.card.ayah_18_10.meaning" = "إِذْ أَوَى ٱلْفِتْيَةُ إِلَى ٱلْكَهْفِ فَقَالُوا۟ رَبَّنَآ ءَاتِنَا مِن لَّدُنكَ رَحْمَةًۭ وَهَيِّئْ لَنَا مِنْ أَمْرِنَا رَشَدًۭا";
"discovery.card.ayah_18_10.source" = "Qur’an 18:10";

"discovery.card.ayah_18_24.title" = "سُورَةُ الكَهۡفِ 24";
"discovery.card.ayah_18_24.meaning" = "إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ وَٱذْكُر رَّبَّكَ إِذَا نَسِيتَ وَقُلْ عَسَىٰٓ أَن يَهْدِيَنِ رَبِّى لِأَقْرَبَ مِنْ هَٰذَا رَشَدًۭا";
"discovery.card.ayah_18_24.source" = "Qur’an 18:24";

"discovery.card.ayah_18_46.title" = "سُورَةُ الكَهۡفِ 46";
"discovery.card.ayah_18_46.meaning" = "ٱلْمَالُ وَٱلْبَنُونَ زِينَةُ ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ وَٱلْبَٰقِيَٰتُ ٱلصَّٰلِحَٰتُ خَيْرٌ عِندَ رَبِّكَ ثَوَابًۭا وَخَيْرٌ أَمَلًۭا";
"discovery.card.ayah_18_46.source" = "Qur’an 18:46";

"discovery.card.ayah_18_110.title" = "سُورَةُ الكَهۡفِ 110";
"discovery.card.ayah_18_110.meaning" = "قُلْ إِنَّمَآ أَنَا۠ بَشَرٌۭ مِّثْلُكُمْ يُوحَىٰٓ إِلَىَّ أَنَّمَآ إِلَٰهُكُمْ إِلَٰهٌۭ وَٰحِدٌۭ ۖ فَمَن كَانَ يَرْجُوا۟ لِقَآءَ رَبِّهِۦ فَلْيَعْمَلْ عَمَلًۭا صَٰلِحًۭا وَلَا يُشْرِكْ بِعِبَادَةِ رَبِّهِۦٓ أَحَدًۢا";
"discovery.card.ayah_18_110.source" = "Qur’an 18:110";

"discovery.card.ayah_19_4.title" = "سُورَةُ مَرۡيَمَ 4";
"discovery.card.ayah_19_4.meaning" = "قَالَ رَبِّ إِنِّى وَهَنَ ٱلْعَظْمُ مِنِّى وَٱشْتَعَلَ ٱلرَّأْسُ شَيْبًۭا وَلَمْ أَكُنۢ بِدُعَآئِكَ رَبِّ شَقِيًّۭا";
"discovery.card.ayah_19_4.source" = "Qur’an 19:4";

"discovery.card.ayah_19_96.title" = "سُورَةُ مَرۡيَمَ 96";
"discovery.card.ayah_19_96.meaning" = "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ سَيَجْعَلُ لَهُمُ ٱلرَّحْمَٰنُ وُدًّۭا";
"discovery.card.ayah_19_96.source" = "Qur’an 19:96";

"discovery.card.ayah_20_8.title" = "سُورَةُ طه 8";
"discovery.card.ayah_20_8.meaning" = "ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَ ۖ لَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ";
"discovery.card.ayah_20_8.source" = "Qur’an 20:8";

"discovery.card.ayah_20_25.title" = "سُورَةُ طه 25";
"discovery.card.ayah_20_25.meaning" = "قَالَ رَبِّ ٱشْرَحْ لِى صَدْرِى";
"discovery.card.ayah_20_25.source" = "Qur’an 20:25";

"discovery.card.ayah_20_46.title" = "سُورَةُ طه 46";
"discovery.card.ayah_20_46.meaning" = "قَالَ لَا تَخَافَآ ۖ إِنَّنِى مَعَكُمَآ أَسْمَعُ وَأَرَىٰ";
"discovery.card.ayah_20_46.source" = "Qur’an 20:46";

"discovery.card.ayah_20_82.title" = "سُورَةُ طه 82";
"discovery.card.ayah_20_82.meaning" = "وَإِنِّى لَغَفَّارٌۭ لِّمَن تَابَ وَءَامَنَ وَعَمِلَ صَٰلِحًۭا ثُمَّ ٱهْتَدَىٰ";
"discovery.card.ayah_20_82.source" = "Qur’an 20:82";

"discovery.card.ayah_21_47.title" = "سُورَةُ الأَنبِيَاءِ 47";
"discovery.card.ayah_21_47.meaning" = "وَنَضَعُ ٱلْمَوَٰزِينَ ٱلْقِسْطَ لِيَوْمِ ٱلْقِيَٰمَةِ فَلَا تُظْلَمُ نَفْسٌۭ شَيْـًۭٔا ۖ وَإِن كَانَ مِثْقَالَ حَبَّةٍۢ مِّنْ خَرْدَلٍ أَتَيْنَا بِهَا ۗ وَكَفَىٰ بِنَا حَٰسِبِينَ";
"discovery.card.ayah_21_47.source" = "Qur’an 21:47";

"discovery.card.ayah_21_73.title" = "سُورَةُ الأَنبِيَاءِ 73";
"discovery.card.ayah_21_73.meaning" = "وَجَعَلْنَٰهُمْ أَئِمَّةًۭ يَهْدُونَ بِأَمْرِنَا وَأَوْحَيْنَآ إِلَيْهِمْ فِعْلَ ٱلْخَيْرَٰتِ وَإِقَامَ ٱلصَّلَوٰةِ وَإِيتَآءَ ٱلزَّكَوٰةِ ۖ وَكَانُوا۟ لَنَا عَٰبِدِينَ";
"discovery.card.ayah_21_73.source" = "Qur’an 21:73";

"discovery.card.ayah_21_92.title" = "سُورَةُ الأَنبِيَاءِ 92";
"discovery.card.ayah_21_92.meaning" = "إِنَّ هَٰذِهِۦٓ أُمَّتُكُمْ أُمَّةًۭ وَٰحِدَةًۭ وَأَنَا۠ رَبُّكُمْ فَٱعْبُدُونِ";
"discovery.card.ayah_21_92.source" = "Qur’an 21:92";

"discovery.card.ayah_22_77.title" = "سُورَةُ الحَجِّ 77";
"discovery.card.ayah_22_77.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱرْكَعُوا۟ وَٱسْجُدُوا۟ وَٱعْبُدُوا۟ رَبَّكُمْ وَٱفْعَلُوا۟ ٱلْخَيْرَ لَعَلَّكُمْ تُفْلِحُونَ ۩";
"discovery.card.ayah_22_77.source" = "Qur’an 22:77";

"discovery.card.ayah_22_78.title" = "سُورَةُ الحَجِّ 78";
"discovery.card.ayah_22_78.meaning" = "وَجَٰهِدُوا۟ فِى ٱللَّهِ حَقَّ جِهَادِهِۦ ۚ هُوَ ٱجْتَبَىٰكُمْ وَمَا جَعَلَ عَلَيْكُمْ فِى ٱلدِّينِ مِنْ حَرَجٍۢ ۚ مِّلَّةَ أَبِيكُمْ إِبْرَٰهِيمَ ۚ هُوَ سَمَّىٰكُمُ ٱلْمُسْلِمِينَ مِن قَبْلُ وَفِى هَٰذَا لِيَكُونَ ٱلرَّسُولُ شَهِيدًا عَلَيْكُمْ وَتَكُونُوا۟ شُهَدَآءَ عَلَى ٱلنَّاسِ ۚ فَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَٱعْتَصِمُوا۟ بِٱللَّهِ هُوَ مَوْلَىٰكُمْ ۖ فَنِعْمَ ٱلْمَوْلَىٰ وَنِعْمَ ٱلنَّصِيرُ";
"discovery.card.ayah_22_78.source" = "Qur’an 22:78";

"discovery.card.ayah_23_1.title" = "سُورَةُ المُؤۡمِنُونَ 1";
"discovery.card.ayah_23_1.meaning" = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قَدْ أَفْلَحَ ٱلْمُؤْمِنُونَ";
"discovery.card.ayah_23_1.source" = "Qur’an 23:1";

"discovery.card.ayah_23_51.title" = "سُورَةُ المُؤۡمِنُونَ 51";
"discovery.card.ayah_23_51.meaning" = "يَٰٓأَيُّهَا ٱلرُّسُلُ كُلُوا۟ مِنَ ٱلطَّيِّبَٰتِ وَٱعْمَلُوا۟ صَٰلِحًا ۖ إِنِّى بِمَا تَعْمَلُونَ عَلِيمٌۭ";
"discovery.card.ayah_23_51.source" = "Qur’an 23:51";

"discovery.card.ayah_23_97.title" = "سُورَةُ المُؤۡمِنُونَ 97";
"discovery.card.ayah_23_97.meaning" = "وَقُل رَّبِّ أَعُوذُ بِكَ مِنْ هَمَزَٰتِ ٱلشَّيَٰطِينِ";
"discovery.card.ayah_23_97.source" = "Qur’an 23:97";

"discovery.card.ayah_24_22.title" = "سُورَةُ النُّورِ 22";
"discovery.card.ayah_24_22.meaning" = "وَلَا يَأْتَلِ أُو۟لُوا۟ ٱلْفَضْلِ مِنكُمْ وَٱلسَّعَةِ أَن يُؤْتُوٓا۟ أُو۟لِى ٱلْقُرْبَىٰ وَٱلْمَسَٰكِينَ وَٱلْمُهَٰجِرِينَ فِى سَبِيلِ ٱللَّهِ ۖ وَلْيَعْفُوا۟ وَلْيَصْفَحُوٓا۟ ۗ أَلَا تُحِبُّونَ أَن يَغْفِرَ ٱللَّهُ لَكُمْ ۗ وَٱللَّهُ غَفُورٌۭ رَّحِيمٌ";
"discovery.card.ayah_24_22.source" = "Qur’an 24:22";

"discovery.card.ayah_24_31.title" = "سُورَةُ النُّورِ 31";
"discovery.card.ayah_24_31.meaning" = "وَقُل لِّلْمُؤْمِنَٰتِ يَغْضُضْنَ مِنْ أَبْصَٰرِهِنَّ وَيَحْفَظْنَ فُرُوجَهُنَّ وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا مَا ظَهَرَ مِنْهَا ۖ وَلْيَضْرِبْنَ بِخُمُرِهِنَّ عَلَىٰ جُيُوبِهِنَّ ۖ وَلَا يُبْدِينَ زِينَتَهُنَّ إِلَّا لِبُعُولَتِهِنَّ أَوْ ءَابَآئِهِنَّ أَوْ ءَابَآءِ بُعُولَتِهِنَّ أَوْ أَبْنَآئِهِنَّ أَوْ أَبْنَآءِ بُعُولَتِهِنَّ أَوْ إِخْوَٰنِهِنَّ أَوْ بَنِىٓ إِخْوَٰنِهِنَّ أَوْ بَنِىٓ أَخَوَٰتِهِنَّ أَوْ نِسَآئِهِنَّ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُنَّ أَوِ ٱلتَّٰبِعِينَ غَيْرِ أُو۟لِى ٱلْإِرْبَةِ مِنَ ٱلرِّجَالِ أَوِ ٱلطِّفْلِ ٱلَّذِينَ لَمْ يَظْهَرُوا۟ عَلَىٰ عَوْرَٰتِ ٱلنِّسَآءِ ۖ وَلَا يَضْرِبْنَ بِأَرْجُلِهِنَّ لِيُعْلَمَ مَا يُخْفِينَ مِن زِينَتِهِنَّ ۚ وَتُوبُوٓا۟ إِلَى ٱللَّهِ جَمِيعًا أَيُّهَ ٱلْمُؤْمِنُونَ لَعَلَّكُمْ تُفْلِحُونَ";
"discovery.card.ayah_24_31.source" = "Qur’an 24:31";

"discovery.card.ayah_24_37.title" = "سُورَةُ النُّورِ 37";
"discovery.card.ayah_24_37.meaning" = "رِجَالٌۭ لَّا تُلْهِيهِمْ تِجَٰرَةٌۭ وَلَا بَيْعٌ عَن ذِكْرِ ٱللَّهِ وَإِقَامِ ٱلصَّلَوٰةِ وَإِيتَآءِ ٱلزَّكَوٰةِ ۙ يَخَافُونَ يَوْمًۭا تَتَقَلَّبُ فِيهِ ٱلْقُلُوبُ وَٱلْأَبْصَٰرُ";
"discovery.card.ayah_24_37.source" = "Qur’an 24:37";

"discovery.card.ayah_25_63.title" = "سُورَةُ الفُرۡقَانِ 63";
"discovery.card.ayah_25_63.meaning" = "وَعِبَادُ ٱلرَّحْمَٰنِ ٱلَّذِينَ يَمْشُونَ عَلَى ٱلْأَرْضِ هَوْنًۭا وَإِذَا خَاطَبَهُمُ ٱلْجَٰهِلُونَ قَالُوا۟ سَلَٰمًۭا";
"discovery.card.ayah_25_63.source" = "Qur’an 25:63";

"discovery.card.ayah_25_74.title" = "سُورَةُ الفُرۡقَانِ 74";
"discovery.card.ayah_25_74.meaning" = "وَٱلَّذِينَ يَقُولُونَ رَبَّنَا هَبْ لَنَا مِنْ أَزْوَٰجِنَا وَذُرِّيَّٰتِنَا قُرَّةَ أَعْيُنٍۢ وَٱجْعَلْنَا لِلْمُتَّقِينَ إِمَامًا";
"discovery.card.ayah_25_74.source" = "Qur’an 25:74";

"discovery.card.ayah_26_80.title" = "سُورَةُ الشُّعَرَاءِ 80";
"discovery.card.ayah_26_80.meaning" = "وَإِذَا مَرِضْتُ فَهُوَ يَشْفِينِ";
"discovery.card.ayah_26_80.source" = "Qur’an 26:80";

"discovery.card.ayah_26_89.title" = "سُورَةُ الشُّعَرَاءِ 89";
"discovery.card.ayah_26_89.meaning" = "إِلَّا مَنْ أَتَى ٱللَّهَ بِقَلْبٍۢ سَلِيمٍۢ";
"discovery.card.ayah_26_89.source" = "Qur’an 26:89";

"discovery.card.ayah_27_19.title" = "سُورَةُ النَّمۡلِ 19";
"discovery.card.ayah_27_19.meaning" = "فَتَبَسَّمَ ضَاحِكًۭا مِّن قَوْلِهَا وَقَالَ رَبِّ أَوْزِعْنِىٓ أَنْ أَشْكُرَ نِعْمَتَكَ ٱلَّتِىٓ أَنْعَمْتَ عَلَىَّ وَعَلَىٰ وَٰلِدَىَّ وَأَنْ أَعْمَلَ صَٰلِحًۭا تَرْضَىٰهُ وَأَدْخِلْنِى بِرَحْمَتِكَ فِى عِبَادِكَ ٱلصَّٰلِحِينَ";
"discovery.card.ayah_27_19.source" = "Qur’an 27:19";

"discovery.card.ayah_27_62.title" = "سُورَةُ النَّمۡلِ 62";
"discovery.card.ayah_27_62.meaning" = "أَمَّن يُجِيبُ ٱلْمُضْطَرَّ إِذَا دَعَاهُ وَيَكْشِفُ ٱلسُّوٓءَ وَيَجْعَلُكُمْ خُلَفَآءَ ٱلْأَرْضِ ۗ أَءِلَٰهٌۭ مَّعَ ٱللَّهِ ۚ قَلِيلًۭا مَّا تَذَكَّرُونَ";
"discovery.card.ayah_27_62.source" = "Qur’an 27:62";

"discovery.card.ayah_28_56.title" = "سُورَةُ القَصَصِ 56";
"discovery.card.ayah_28_56.meaning" = "إِنَّكَ لَا تَهْدِى مَنْ أَحْبَبْتَ وَلَٰكِنَّ ٱللَّهَ يَهْدِى مَن يَشَآءُ ۚ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ";
"discovery.card.ayah_28_56.source" = "Qur’an 28:56";

"discovery.card.ayah_28_77.title" = "سُورَةُ القَصَصِ 77";
"discovery.card.ayah_28_77.meaning" = "وَٱبْتَغِ فِيمَآ ءَاتَىٰكَ ٱللَّهُ ٱلدَّارَ ٱلْءَاخِرَةَ ۖ وَلَا تَنسَ نَصِيبَكَ مِنَ ٱلدُّنْيَا ۖ وَأَحْسِن كَمَآ أَحْسَنَ ٱللَّهُ إِلَيْكَ ۖ وَلَا تَبْغِ ٱلْفَسَادَ فِى ٱلْأَرْضِ ۖ إِنَّ ٱللَّهَ لَا يُحِبُّ ٱلْمُفْسِدِينَ";
"discovery.card.ayah_28_77.source" = "Qur’an 28:77";

"discovery.card.ayah_29_45.title" = "سُورَةُ العَنكَبُوتِ 45";
"discovery.card.ayah_29_45.meaning" = "ٱتْلُ مَآ أُوحِىَ إِلَيْكَ مِنَ ٱلْكِتَٰبِ وَأَقِمِ ٱلصَّلَوٰةَ ۖ إِنَّ ٱلصَّلَوٰةَ تَنْهَىٰ عَنِ ٱلْفَحْشَآءِ وَٱلْمُنكَرِ ۗ وَلَذِكْرُ ٱللَّهِ أَكْبَرُ ۗ وَٱللَّهُ يَعْلَمُ مَا تَصْنَعُونَ";
"discovery.card.ayah_29_45.source" = "Qur’an 29:45";

"discovery.card.ayah_29_69.title" = "سُورَةُ العَنكَبُوتِ 69";
"discovery.card.ayah_29_69.meaning" = "وَٱلَّذِينَ جَٰهَدُوا۟ فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا ۚ وَإِنَّ ٱللَّهَ لَمَعَ ٱلْمُحْسِنِينَ";
"discovery.card.ayah_29_69.source" = "Qur’an 29:69";

"discovery.card.ayah_31_12.title" = "سُورَةُ لُقۡمَانَ 12";
"discovery.card.ayah_31_12.meaning" = "وَلَقَدْ ءَاتَيْنَا لُقْمَٰنَ ٱلْحِكْمَةَ أَنِ ٱشْكُرْ لِلَّهِ ۚ وَمَن يَشْكُرْ فَإِنَّمَا يَشْكُرُ لِنَفْسِهِۦ ۖ وَمَن كَفَرَ فَإِنَّ ٱللَّهَ غَنِىٌّ حَمِيدٌۭ";
"discovery.card.ayah_31_12.source" = "Qur’an 31:12";

"discovery.card.ayah_31_13.title" = "سُورَةُ لُقۡمَانَ 13";
"discovery.card.ayah_31_13.meaning" = "وَإِذْ قَالَ لُقْمَٰنُ لِٱبْنِهِۦ وَهُوَ يَعِظُهُۥ يَٰبُنَىَّ لَا تُشْرِكْ بِٱللَّهِ ۖ إِنَّ ٱلشِّرْكَ لَظُلْمٌ عَظِيمٌۭ";
"discovery.card.ayah_31_13.source" = "Qur’an 31:13";

"discovery.card.ayah_31_18.title" = "سُورَةُ لُقۡمَانَ 18";
"discovery.card.ayah_31_18.meaning" = "وَلَا تُصَعِّرْ خَدَّكَ لِلنَّاسِ وَلَا تَمْشِ فِى ٱلْأَرْضِ مَرَحًا ۖ إِنَّ ٱللَّهَ لَا يُحِبُّ كُلَّ مُخْتَالٍۢ فَخُورٍۢ";
"discovery.card.ayah_31_18.source" = "Qur’an 31:18";

"discovery.card.ayah_31_19.title" = "سُورَةُ لُقۡمَانَ 19";
"discovery.card.ayah_31_19.meaning" = "وَٱقْصِدْ فِى مَشْيِكَ وَٱغْضُضْ مِن صَوْتِكَ ۚ إِنَّ أَنكَرَ ٱلْأَصْوَٰتِ لَصَوْتُ ٱلْحَمِيرِ";
"discovery.card.ayah_31_19.source" = "Qur’an 31:19";

"discovery.card.ayah_32_16.title" = "سُورَةُ السَّجۡدَةِ 16";
"discovery.card.ayah_32_16.meaning" = "تَتَجَافَىٰ جُنُوبُهُمْ عَنِ ٱلْمَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًۭا وَطَمَعًۭا وَمِمَّا رَزَقْنَٰهُمْ يُنفِقُونَ";
"discovery.card.ayah_32_16.source" = "Qur’an 32:16";

"discovery.card.ayah_32_17.title" = "سُورَةُ السَّجۡدَةِ 17";
"discovery.card.ayah_32_17.meaning" = "فَلَا تَعْلَمُ نَفْسٌۭ مَّآ أُخْفِىَ لَهُم مِّن قُرَّةِ أَعْيُنٍۢ جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ";
"discovery.card.ayah_32_17.source" = "Qur’an 32:17";

"discovery.card.ayah_33_21.title" = "سُورَةُ الأَحۡزَابِ 21";
"discovery.card.ayah_33_21.meaning" = "لَّقَدْ كَانَ لَكُمْ فِى رَسُولِ ٱللَّهِ أُسْوَةٌ حَسَنَةٌۭ لِّمَن كَانَ يَرْجُوا۟ ٱللَّهَ وَٱلْيَوْمَ ٱلْءَاخِرَ وَذَكَرَ ٱللَّهَ كَثِيرًۭا";
"discovery.card.ayah_33_21.source" = "Qur’an 33:21";

"discovery.card.ayah_33_35.title" = "سُورَةُ الأَحۡزَابِ 35";
"discovery.card.ayah_33_35.meaning" = "إِنَّ ٱلْمُسْلِمِينَ وَٱلْمُسْلِمَٰتِ وَٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ وَٱلْقَٰنِتِينَ وَٱلْقَٰنِتَٰتِ وَٱلصَّٰدِقِينَ وَٱلصَّٰدِقَٰتِ وَٱلصَّٰبِرِينَ وَٱلصَّٰبِرَٰتِ وَٱلْخَٰشِعِينَ وَٱلْخَٰشِعَٰتِ وَٱلْمُتَصَدِّقِينَ وَٱلْمُتَصَدِّقَٰتِ وَٱلصَّٰٓئِمِينَ وَٱلصَّٰٓئِمَٰتِ وَٱلْحَٰفِظِينَ فُرُوجَهُمْ وَٱلْحَٰفِظَٰتِ وَٱلذَّٰكِرِينَ ٱللَّهَ كَثِيرًۭا وَٱلذَّٰكِرَٰتِ أَعَدَّ ٱللَّهُ لَهُم مَّغْفِرَةًۭ وَأَجْرًا عَظِيمًۭا";
"discovery.card.ayah_33_35.source" = "Qur’an 33:35";

"discovery.card.ayah_33_41.title" = "سُورَةُ الأَحۡزَابِ 41";
"discovery.card.ayah_33_41.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱذْكُرُوا۟ ٱللَّهَ ذِكْرًۭا كَثِيرًۭا";
"discovery.card.ayah_33_41.source" = "Qur’an 33:41";

"discovery.card.ayah_33_56.title" = "سُورَةُ الأَحۡزَابِ 56";
"discovery.card.ayah_33_56.meaning" = "إِنَّ ٱللَّهَ وَمَلَٰٓئِكَتَهُۥ يُصَلُّونَ عَلَى ٱلنَّبِىِّ ۚ يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ صَلُّوا۟ عَلَيْهِ وَسَلِّمُوا۟ تَسْلِيمًا";
"discovery.card.ayah_33_56.source" = "Qur’an 33:56";

"discovery.card.ayah_33_70.title" = "سُورَةُ الأَحۡزَابِ 70";
"discovery.card.ayah_33_70.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَقُولُوا۟ قَوْلًۭا سَدِيدًۭا";
"discovery.card.ayah_33_70.source" = "Qur’an 33:70";

"discovery.card.ayah_35_10.title" = "سُورَةُ فَاطِرٍ 10";
"discovery.card.ayah_35_10.meaning" = "مَن كَانَ يُرِيدُ ٱلْعِزَّةَ فَلِلَّهِ ٱلْعِزَّةُ جَمِيعًا ۚ إِلَيْهِ يَصْعَدُ ٱلْكَلِمُ ٱلطَّيِّبُ وَٱلْعَمَلُ ٱلصَّٰلِحُ يَرْفَعُهُۥ ۚ وَٱلَّذِينَ يَمْكُرُونَ ٱلسَّيِّـَٔاتِ لَهُمْ عَذَابٌۭ شَدِيدٌۭ ۖ وَمَكْرُ أُو۟لَٰٓئِكَ هُوَ يَبُورُ";
"discovery.card.ayah_35_10.source" = "Qur’an 35:10";

"discovery.card.ayah_35_28.title" = "سُورَةُ فَاطِرٍ 28";
"discovery.card.ayah_35_28.meaning" = "وَمِنَ ٱلنَّاسِ وَٱلدَّوَآبِّ وَٱلْأَنْعَٰمِ مُخْتَلِفٌ أَلْوَٰنُهُۥ كَذَٰلِكَ ۗ إِنَّمَا يَخْشَى ٱللَّهَ مِنْ عِبَادِهِ ٱلْعُلَمَٰٓؤُا۟ ۗ إِنَّ ٱللَّهَ عَزِيزٌ غَفُورٌ";
"discovery.card.ayah_35_28.source" = "Qur’an 35:28";

"discovery.card.ayah_36_1.title" = "سُورَةُ يسٓ 1";
"discovery.card.ayah_36_1.meaning" = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ يسٓ";
"discovery.card.ayah_36_1.source" = "Qur’an 36:1";

"discovery.card.ayah_36_22.title" = "سُورَةُ يسٓ 22";
"discovery.card.ayah_36_22.meaning" = "وَمَا لِىَ لَآ أَعْبُدُ ٱلَّذِى فَطَرَنِى وَإِلَيْهِ تُرْجَعُونَ";
"discovery.card.ayah_36_22.source" = "Qur’an 36:22";

"discovery.card.ayah_36_58.title" = "سُورَةُ يسٓ 58";
"discovery.card.ayah_36_58.meaning" = "سَلَٰمٌۭ قَوْلًۭا مِّن رَّبٍّۢ رَّحِيمٍۢ";
"discovery.card.ayah_36_58.source" = "Qur’an 36:58";

"discovery.card.ayah_37_96.title" = "سُورَةُ الصَّافَّاتِ 96";
"discovery.card.ayah_37_96.meaning" = "وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ";
"discovery.card.ayah_37_96.source" = "Qur’an 37:96";

"discovery.card.ayah_38_29.title" = "سُورَةُ صٓ 29";
"discovery.card.ayah_38_29.meaning" = "كِتَٰبٌ أَنزَلْنَٰهُ إِلَيْكَ مُبَٰرَكٌۭ لِّيَدَّبَّرُوٓا۟ ءَايَٰتِهِۦ وَلِيَتَذَكَّرَ أُو۟لُوا۟ ٱلْأَلْبَٰبِ";
"discovery.card.ayah_38_29.source" = "Qur’an 38:29";

"discovery.card.ayah_39_9.title" = "سُورَةُ الزُّمَرِ 9";
"discovery.card.ayah_39_9.meaning" = "أَمَّنْ هُوَ قَٰنِتٌ ءَانَآءَ ٱلَّيْلِ سَاجِدًۭا وَقَآئِمًۭا يَحْذَرُ ٱلْءَاخِرَةَ وَيَرْجُوا۟ رَحْمَةَ رَبِّهِۦ ۗ قُلْ هَلْ يَسْتَوِى ٱلَّذِينَ يَعْلَمُونَ وَٱلَّذِينَ لَا يَعْلَمُونَ ۗ إِنَّمَا يَتَذَكَّرُ أُو۟لُوا۟ ٱلْأَلْبَٰبِ";
"discovery.card.ayah_39_9.source" = "Qur’an 39:9";

"discovery.card.ayah_39_10.title" = "سُورَةُ الزُّمَرِ 10";
"discovery.card.ayah_39_10.meaning" = "قُلْ يَٰعِبَادِ ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ رَبَّكُمْ ۚ لِلَّذِينَ أَحْسَنُوا۟ فِى هَٰذِهِ ٱلدُّنْيَا حَسَنَةٌۭ ۗ وَأَرْضُ ٱللَّهِ وَٰسِعَةٌ ۗ إِنَّمَا يُوَفَّى ٱلصَّٰبِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍۢ";
"discovery.card.ayah_39_10.source" = "Qur’an 39:10";

"discovery.card.ayah_39_36.title" = "سُورَةُ الزُّمَرِ 36";
"discovery.card.ayah_39_36.meaning" = "أَلَيْسَ ٱللَّهُ بِكَافٍ عَبْدَهُۥ ۖ وَيُخَوِّفُونَكَ بِٱلَّذِينَ مِن دُونِهِۦ ۚ وَمَن يُضْلِلِ ٱللَّهُ فَمَا لَهُۥ مِنْ هَادٍۢ";
"discovery.card.ayah_39_36.source" = "Qur’an 39:36";

"discovery.card.ayah_40_60.title" = "سُورَةُ غَافِرٍ 60";
"discovery.card.ayah_40_60.meaning" = "وَقَالَ رَبُّكُمُ ٱدْعُونِىٓ أَسْتَجِبْ لَكُمْ ۚ إِنَّ ٱلَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِى سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ";
"discovery.card.ayah_40_60.source" = "Qur’an 40:60";

"discovery.card.ayah_40_65.title" = "سُورَةُ غَافِرٍ 65";
"discovery.card.ayah_40_65.meaning" = "هُوَ ٱلْحَىُّ لَآ إِلَٰهَ إِلَّا هُوَ فَٱدْعُوهُ مُخْلِصِينَ لَهُ ٱلدِّينَ ۗ ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ";
"discovery.card.ayah_40_65.source" = "Qur’an 40:65";

"discovery.card.ayah_41_30.title" = "سُورَةُ فُصِّلَتۡ 30";
"discovery.card.ayah_41_30.meaning" = "إِنَّ ٱلَّذِينَ قَالُوا۟ رَبُّنَا ٱللَّهُ ثُمَّ ٱسْتَقَٰمُوا۟ تَتَنَزَّلُ عَلَيْهِمُ ٱلْمَلَٰٓئِكَةُ أَلَّا تَخَافُوا۟ وَلَا تَحْزَنُوا۟ وَأَبْشِرُوا۟ بِٱلْجَنَّةِ ٱلَّتِى كُنتُمْ تُوعَدُونَ";
"discovery.card.ayah_41_30.source" = "Qur’an 41:30";

"discovery.card.ayah_41_33.title" = "سُورَةُ فُصِّلَتۡ 33";
"discovery.card.ayah_41_33.meaning" = "وَمَنْ أَحْسَنُ قَوْلًۭا مِّمَّن دَعَآ إِلَى ٱللَّهِ وَعَمِلَ صَٰلِحًۭا وَقَالَ إِنَّنِى مِنَ ٱلْمُسْلِمِينَ";
"discovery.card.ayah_41_33.source" = "Qur’an 41:33";

"discovery.card.ayah_41_34.title" = "سُورَةُ فُصِّلَتۡ 34";
"discovery.card.ayah_41_34.meaning" = "وَلَا تَسْتَوِى ٱلْحَسَنَةُ وَلَا ٱلسَّيِّئَةُ ۚ ٱدْفَعْ بِٱلَّتِى هِىَ أَحْسَنُ فَإِذَا ٱلَّذِى بَيْنَكَ وَبَيْنَهُۥ عَدَٰوَةٌۭ كَأَنَّهُۥ وَلِىٌّ حَمِيمٌۭ";
"discovery.card.ayah_41_34.source" = "Qur’an 41:34";

"discovery.card.ayah_42_13.title" = "سُورَةُ الشُّورَىٰ 13";
"discovery.card.ayah_42_13.meaning" = "۞ شَرَعَ لَكُم مِّنَ ٱلدِّينِ مَا وَصَّىٰ بِهِۦ نُوحًۭا وَٱلَّذِىٓ أَوْحَيْنَآ إِلَيْكَ وَمَا وَصَّيْنَا بِهِۦٓ إِبْرَٰهِيمَ وَمُوسَىٰ وَعِيسَىٰٓ ۖ أَنْ أَقِيمُوا۟ ٱلدِّينَ وَلَا تَتَفَرَّقُوا۟ فِيهِ ۚ كَبُرَ عَلَى ٱلْمُشْرِكِينَ مَا تَدْعُوهُمْ إِلَيْهِ ۚ ٱللَّهُ يَجْتَبِىٓ إِلَيْهِ مَن يَشَآءُ وَيَهْدِىٓ إِلَيْهِ مَن يُنِيبُ";
"discovery.card.ayah_42_13.source" = "Qur’an 42:13";

"discovery.card.ayah_42_19.title" = "سُورَةُ الشُّورَىٰ 19";
"discovery.card.ayah_42_19.meaning" = "ٱللَّهُ لَطِيفٌۢ بِعِبَادِهِۦ يَرْزُقُ مَن يَشَآءُ ۖ وَهُوَ ٱلْقَوِىُّ ٱلْعَزِيزُ";
"discovery.card.ayah_42_19.source" = "Qur’an 42:19";

"discovery.card.ayah_42_36.title" = "سُورَةُ الشُّورَىٰ 36";
"discovery.card.ayah_42_36.meaning" = "فَمَآ أُوتِيتُم مِّن شَىْءٍۢ فَمَتَٰعُ ٱلْحَيَوٰةِ ٱلدُّنْيَا ۖ وَمَا عِندَ ٱللَّهِ خَيْرٌۭ وَأَبْقَىٰ لِلَّذِينَ ءَامَنُوا۟ وَعَلَىٰ رَبِّهِمْ يَتَوَكَّلُونَ";
"discovery.card.ayah_42_36.source" = "Qur’an 42:36";

"discovery.card.ayah_43_36.title" = "سُورَةُ الزُّخۡرُفِ 36";
"discovery.card.ayah_43_36.meaning" = "وَمَن يَعْشُ عَن ذِكْرِ ٱلرَّحْمَٰنِ نُقَيِّضْ لَهُۥ شَيْطَٰنًۭا فَهُوَ لَهُۥ قَرِينٌۭ";
"discovery.card.ayah_43_36.source" = "Qur’an 43:36";

"discovery.card.ayah_44_3.title" = "سُورَةُ الدُّخَانِ 3";
"discovery.card.ayah_44_3.meaning" = "إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةٍۢ مُّبَٰرَكَةٍ ۚ إِنَّا كُنَّا مُنذِرِينَ";
"discovery.card.ayah_44_3.source" = "Qur’an 44:3";

"discovery.card.ayah_45_15.title" = "سُورَةُ الجَاثِيَةِ 15";
"discovery.card.ayah_45_15.meaning" = "مَنْ عَمِلَ صَٰلِحًۭا فَلِنَفْسِهِۦ ۖ وَمَنْ أَسَآءَ فَعَلَيْهَا ۖ ثُمَّ إِلَىٰ رَبِّكُمْ تُرْجَعُونَ";
"discovery.card.ayah_45_15.source" = "Qur’an 45:15";

"discovery.card.ayah_46_13.title" = "سُورَةُ الأَحۡقَافِ 13";
"discovery.card.ayah_46_13.meaning" = "إِنَّ ٱلَّذِينَ قَالُوا۟ رَبُّنَا ٱللَّهُ ثُمَّ ٱسْتَقَٰمُوا۟ فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ";
"discovery.card.ayah_46_13.source" = "Qur’an 46:13";

"discovery.card.ayah_46_15.title" = "سُورَةُ الأَحۡقَافِ 15";
"discovery.card.ayah_46_15.meaning" = "وَوَصَّيْنَا ٱلْإِنسَٰنَ بِوَٰلِدَيْهِ إِحْسَٰنًا ۖ حَمَلَتْهُ أُمُّهُۥ كُرْهًۭا وَوَضَعَتْهُ كُرْهًۭا ۖ وَحَمْلُهُۥ وَفِصَٰلُهُۥ ثَلَٰثُونَ شَهْرًا ۚ حَتَّىٰٓ إِذَا بَلَغَ أَشُدَّهُۥ وَبَلَغَ أَرْبَعِينَ سَنَةًۭ قَالَ رَبِّ أَوْزِعْنِىٓ أَنْ أَشْكُرَ نِعْمَتَكَ ٱلَّتِىٓ أَنْعَمْتَ عَلَىَّ وَعَلَىٰ وَٰلِدَىَّ وَأَنْ أَعْمَلَ صَٰلِحًۭا تَرْضَىٰهُ وَأَصْلِحْ لِى فِى ذُرِّيَّتِىٓ ۖ إِنِّى تُبْتُ إِلَيْكَ وَإِنِّى مِنَ ٱلْمُسْلِمِينَ";
"discovery.card.ayah_46_15.source" = "Qur’an 46:15";

"discovery.card.ayah_47_7.title" = "سُورَةُ مُحَمَّدٍ 7";
"discovery.card.ayah_47_7.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِن تَنصُرُوا۟ ٱللَّهَ يَنصُرْكُمْ وَيُثَبِّتْ أَقْدَامَكُمْ";
"discovery.card.ayah_47_7.source" = "Qur’an 47:7";

"discovery.card.ayah_47_19.title" = "سُورَةُ مُحَمَّدٍ 19";
"discovery.card.ayah_47_19.meaning" = "فَٱعْلَمْ أَنَّهُۥ لَآ إِلَٰهَ إِلَّا ٱللَّهُ وَٱسْتَغْفِرْ لِذَنۢبِكَ وَلِلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ۗ وَٱللَّهُ يَعْلَمُ مُتَقَلَّبَكُمْ وَمَثْوَىٰكُمْ";
"discovery.card.ayah_47_19.source" = "Qur’an 47:19";

"discovery.card.ayah_48_1.title" = "سُورَةُ الفَتۡحِ 1";
"discovery.card.ayah_48_1.meaning" = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّا فَتَحْنَا لَكَ فَتْحًۭا مُّبِينًۭا";
"discovery.card.ayah_48_1.source" = "Qur’an 48:1";

"discovery.card.ayah_48_29.title" = "سُورَةُ الفَتۡحِ 29";
"discovery.card.ayah_48_29.meaning" = "مُّحَمَّدٌۭ رَّسُولُ ٱللَّهِ ۚ وَٱلَّذِينَ مَعَهُۥٓ أَشِدَّآءُ عَلَى ٱلْكُفَّارِ رُحَمَآءُ بَيْنَهُمْ ۖ تَرَىٰهُمْ رُكَّعًۭا سُجَّدًۭا يَبْتَغُونَ فَضْلًۭا مِّنَ ٱللَّهِ وَرِضْوَٰنًۭا ۖ سِيمَاهُمْ فِى وُجُوهِهِم مِّنْ أَثَرِ ٱلسُّجُودِ ۚ ذَٰلِكَ مَثَلُهُمْ فِى ٱلتَّوْرَىٰةِ ۚ وَمَثَلُهُمْ فِى ٱلْإِنجِيلِ كَزَرْعٍ أَخْرَجَ شَطْـَٔهُۥ فَـَٔازَرَهُۥ فَٱسْتَغْلَظَ فَٱسْتَوَىٰ عَلَىٰ سُوقِهِۦ يُعْجِبُ ٱلزُّرَّاعَ لِيَغِيظَ بِهِمُ ٱلْكُفَّارَ ۗ وَعَدَ ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ مِنْهُم مَّغْفِرَةًۭ وَأَجْرًا عَظِيمًۢا";
"discovery.card.ayah_48_29.source" = "Qur’an 48:29";

"discovery.card.ayah_49_10.title" = "سُورَةُ الحُجُرَاتِ 10";
"discovery.card.ayah_49_10.meaning" = "إِنَّمَا ٱلْمُؤْمِنُونَ إِخْوَةٌۭ فَأَصْلِحُوا۟ بَيْنَ أَخَوَيْكُمْ ۚ وَٱتَّقُوا۟ ٱللَّهَ لَعَلَّكُمْ تُرْحَمُونَ";
"discovery.card.ayah_49_10.source" = "Qur’an 49:10";

"discovery.card.ayah_49_11.title" = "سُورَةُ الحُجُرَاتِ 11";
"discovery.card.ayah_49_11.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا يَسْخَرْ قَوْمٌۭ مِّن قَوْمٍ عَسَىٰٓ أَن يَكُونُوا۟ خَيْرًۭا مِّنْهُمْ وَلَا نِسَآءٌۭ مِّن نِّسَآءٍ عَسَىٰٓ أَن يَكُنَّ خَيْرًۭا مِّنْهُنَّ ۖ وَلَا تَلْمِزُوٓا۟ أَنفُسَكُمْ وَلَا تَنَابَزُوا۟ بِٱلْأَلْقَٰبِ ۖ بِئْسَ ٱلِٱسْمُ ٱلْفُسُوقُ بَعْدَ ٱلْإِيمَٰنِ ۚ وَمَن لَّمْ يَتُبْ فَأُو۟لَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ";
"discovery.card.ayah_49_11.source" = "Qur’an 49:11";

"discovery.card.ayah_51_19.title" = "سُورَةُ الذَّارِيَاتِ 19";
"discovery.card.ayah_51_19.meaning" = "وَفِىٓ أَمْوَٰلِهِمْ حَقٌّۭ لِّلسَّآئِلِ وَٱلْمَحْرُومِ";
"discovery.card.ayah_51_19.source" = "Qur’an 51:19";

"discovery.card.ayah_51_56.title" = "سُورَةُ الذَّارِيَاتِ 56";
"discovery.card.ayah_51_56.meaning" = "وَمَا خَلَقْتُ ٱلْجِنَّ وَٱلْإِنسَ إِلَّا لِيَعْبُدُونِ";
"discovery.card.ayah_51_56.source" = "Qur’an 51:56";

"discovery.card.ayah_52_21.title" = "سُورَةُ الطُّورِ 21";
"discovery.card.ayah_52_21.meaning" = "وَٱلَّذِينَ ءَامَنُوا۟ وَٱتَّبَعَتْهُمْ ذُرِّيَّتُهُم بِإِيمَٰنٍ أَلْحَقْنَا بِهِمْ ذُرِّيَّتَهُمْ وَمَآ أَلَتْنَٰهُم مِّنْ عَمَلِهِم مِّن شَىْءٍۢ ۚ كُلُّ ٱمْرِئٍۭ بِمَا كَسَبَ رَهِينٌۭ";
"discovery.card.ayah_52_21.source" = "Qur’an 52:21";

"discovery.card.ayah_53_32.title" = "سُورَةُ النَّجۡمِ 32";
"discovery.card.ayah_53_32.meaning" = "ٱلَّذِينَ يَجْتَنِبُونَ كَبَٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ ۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٌۭ فِى بُطُونِ أُمَّهَٰتِكُمْ ۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ ۖ هُوَ أَعْلَمُ بِمَنِ ٱتَّقَىٰٓ";
"discovery.card.ayah_53_32.source" = "Qur’an 53:32";

"discovery.card.ayah_53_39.title" = "سُورَةُ النَّجۡمِ 39";
"discovery.card.ayah_53_39.meaning" = "وَأَن لَّيْسَ لِلْإِنسَٰنِ إِلَّا مَا سَعَىٰ";
"discovery.card.ayah_53_39.source" = "Qur’an 53:39";

"discovery.card.ayah_54_17.title" = "سُورَةُ القَمَرِ 17";
"discovery.card.ayah_54_17.meaning" = "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ";
"discovery.card.ayah_54_17.source" = "Qur’an 54:17";

"discovery.card.ayah_55_1.title" = "سُورَةُ الرَّحۡمَٰن 1";
"discovery.card.ayah_55_1.meaning" = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلرَّحْمَٰنُ";
"discovery.card.ayah_55_1.source" = "Qur’an 55:1";

"discovery.card.ayah_55_46.title" = "سُورَةُ الرَّحۡمَٰن 46";
"discovery.card.ayah_55_46.meaning" = "وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ";
"discovery.card.ayah_55_46.source" = "Qur’an 55:46";

"discovery.card.ayah_56_10.title" = "سُورَةُ الوَاقِعَةِ 10";
"discovery.card.ayah_56_10.meaning" = "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ";
"discovery.card.ayah_56_10.source" = "Qur’an 56:10";

"discovery.card.ayah_57_16.title" = "سُورَةُ الحَدِيدِ 16";
"discovery.card.ayah_57_16.meaning" = "۞ أَلَمْ يَأْنِ لِلَّذِينَ ءَامَنُوٓا۟ أَن تَخْشَعَ قُلُوبُهُمْ لِذِكْرِ ٱللَّهِ وَمَا نَزَلَ مِنَ ٱلْحَقِّ وَلَا يَكُونُوا۟ كَٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ مِن قَبْلُ فَطَالَ عَلَيْهِمُ ٱلْأَمَدُ فَقَسَتْ قُلُوبُهُمْ ۖ وَكَثِيرٌۭ مِّنْهُمْ فَٰسِقُونَ";
"discovery.card.ayah_57_16.source" = "Qur’an 57:16";

"discovery.card.ayah_57_20.title" = "سُورَةُ الحَدِيدِ 20";
"discovery.card.ayah_57_20.meaning" = "ٱعْلَمُوٓا۟ أَنَّمَا ٱلْحَيَوٰةُ ٱلدُّنْيَا لَعِبٌۭ وَلَهْوٌۭ وَزِينَةٌۭ وَتَفَاخُرٌۢ بَيْنَكُمْ وَتَكَاثُرٌۭ فِى ٱلْأَمْوَٰلِ وَٱلْأَوْلَٰدِ ۖ كَمَثَلِ غَيْثٍ أَعْجَبَ ٱلْكُفَّارَ نَبَاتُهُۥ ثُمَّ يَهِيجُ فَتَرَىٰهُ مُصْفَرًّۭا ثُمَّ يَكُونُ حُطَٰمًۭا ۖ وَفِى ٱلْءَاخِرَةِ عَذَابٌۭ شَدِيدٌۭ وَمَغْفِرَةٌۭ مِّنَ ٱللَّهِ وَرِضْوَٰنٌۭ ۚ وَمَا ٱلْحَيَوٰةُ ٱلدُّنْيَآ إِلَّا مَتَٰعُ ٱلْغُرُورِ";
"discovery.card.ayah_57_20.source" = "Qur’an 57:20";

"discovery.card.ayah_57_21.title" = "سُورَةُ الحَدِيدِ 21";
"discovery.card.ayah_57_21.meaning" = "سَابِقُوٓا۟ إِلَىٰ مَغْفِرَةٍۢ مِّن رَّبِّكُمْ وَجَنَّةٍ عَرْضُهَا كَعَرْضِ ٱلسَّمَآءِ وَٱلْأَرْضِ أُعِدَّتْ لِلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ وَرُسُلِهِۦ ۚ ذَٰلِكَ فَضْلُ ٱللَّهِ يُؤْتِيهِ مَن يَشَآءُ ۚ وَٱللَّهُ ذُو ٱلْفَضْلِ ٱلْعَظِيمِ";
"discovery.card.ayah_57_21.source" = "Qur’an 57:21";

"discovery.card.ayah_58_11.title" = "سُورَةُ المُجَادلَةِ 11";
"discovery.card.ayah_58_11.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا قِيلَ لَكُمْ تَفَسَّحُوا۟ فِى ٱلْمَجَٰلِسِ فَٱفْسَحُوا۟ يَفْسَحِ ٱللَّهُ لَكُمْ ۖ وَإِذَا قِيلَ ٱنشُزُوا۟ فَٱنشُزُوا۟ يَرْفَعِ ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟ مِنكُمْ وَٱلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ دَرَجَٰتٍۢ ۚ وَٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌۭ";
"discovery.card.ayah_58_11.source" = "Qur’an 58:11";

"discovery.card.ayah_59_9.title" = "سُورَةُ الحَشۡرِ 9";
"discovery.card.ayah_59_9.meaning" = "وَٱلَّذِينَ تَبَوَّءُو ٱلدَّارَ وَٱلْإِيمَٰنَ مِن قَبْلِهِمْ يُحِبُّونَ مَنْ هَاجَرَ إِلَيْهِمْ وَلَا يَجِدُونَ فِى صُدُورِهِمْ حَاجَةًۭ مِّمَّآ أُوتُوا۟ وَيُؤْثِرُونَ عَلَىٰٓ أَنفُسِهِمْ وَلَوْ كَانَ بِهِمْ خَصَاصَةٌۭ ۚ وَمَن يُوقَ شُحَّ نَفْسِهِۦ فَأُو۟لَٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ";
"discovery.card.ayah_59_9.source" = "Qur’an 59:9";

"discovery.card.ayah_59_18.title" = "سُورَةُ الحَشۡرِ 18";
"discovery.card.ayah_59_18.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَلْتَنظُرْ نَفْسٌۭ مَّا قَدَّمَتْ لِغَدٍۢ ۖ وَٱتَّقُوا۟ ٱللَّهَ ۚ إِنَّ ٱللَّهَ خَبِيرٌۢ بِمَا تَعْمَلُونَ";
"discovery.card.ayah_59_18.source" = "Qur’an 59:18";

"discovery.card.ayah_59_22.title" = "سُورَةُ الحَشۡرِ 22";
"discovery.card.ayah_59_22.meaning" = "هُوَ ٱللَّهُ ٱلَّذِى لَآ إِلَٰهَ إِلَّا هُوَ ۖ عَٰلِمُ ٱلْغَيْبِ وَٱلشَّهَٰدَةِ ۖ هُوَ ٱلرَّحْمَٰنُ ٱلرَّحِيمُ";
"discovery.card.ayah_59_22.source" = "Qur’an 59:22";

"discovery.card.ayah_61_2.title" = "سُورَةُ الصَّفِّ 2";
"discovery.card.ayah_61_2.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لِمَ تَقُولُونَ مَا لَا تَفْعَلُونَ";
"discovery.card.ayah_61_2.source" = "Qur’an 61:2";

"discovery.card.ayah_61_10.title" = "سُورَةُ الصَّفِّ 10";
"discovery.card.ayah_61_10.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ هَلْ أَدُلُّكُمْ عَلَىٰ تِجَٰرَةٍۢ تُنجِيكُم مِّنْ عَذَابٍ أَلِيمٍۢ";
"discovery.card.ayah_61_10.source" = "Qur’an 61:10";

"discovery.card.ayah_61_13.title" = "سُورَةُ الصَّفِّ 13";
"discovery.card.ayah_61_13.meaning" = "وَأُخْرَىٰ تُحِبُّونَهَا ۖ نَصْرٌۭ مِّنَ ٱللَّهِ وَفَتْحٌۭ قَرِيبٌۭ ۗ وَبَشِّرِ ٱلْمُؤْمِنِينَ";
"discovery.card.ayah_61_13.source" = "Qur’an 61:13";

"discovery.card.ayah_62_9.title" = "سُورَةُ الجُمُعَةِ 9";
"discovery.card.ayah_62_9.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا نُودِىَ لِلصَّلَوٰةِ مِن يَوْمِ ٱلْجُمُعَةِ فَٱسْعَوْا۟ إِلَىٰ ذِكْرِ ٱللَّهِ وَذَرُوا۟ ٱلْبَيْعَ ۚ ذَٰلِكُمْ خَيْرٌۭ لَّكُمْ إِن كُنتُمْ تَعْلَمُونَ";
"discovery.card.ayah_62_9.source" = "Qur’an 62:9";

"discovery.card.ayah_62_10.title" = "سُورَةُ الجُمُعَةِ 10";
"discovery.card.ayah_62_10.meaning" = "فَإِذَا قُضِيَتِ ٱلصَّلَوٰةُ فَٱنتَشِرُوا۟ فِى ٱلْأَرْضِ وَٱبْتَغُوا۟ مِن فَضْلِ ٱللَّهِ وَٱذْكُرُوا۟ ٱللَّهَ كَثِيرًۭا لَّعَلَّكُمْ تُفْلِحُونَ";
"discovery.card.ayah_62_10.source" = "Qur’an 62:10";

"discovery.card.ayah_63_9.title" = "سُورَةُ المُنَافِقُونَ 9";
"discovery.card.ayah_63_9.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تُلْهِكُمْ أَمْوَٰلُكُمْ وَلَآ أَوْلَٰدُكُمْ عَن ذِكْرِ ٱللَّهِ ۚ وَمَن يَفْعَلْ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْخَٰسِرُونَ";
"discovery.card.ayah_63_9.source" = "Qur’an 63:9";

"discovery.card.ayah_64_16.title" = "سُورَةُ التَّغَابُنِ 16";
"discovery.card.ayah_64_16.meaning" = "فَٱتَّقُوا۟ ٱللَّهَ مَا ٱسْتَطَعْتُمْ وَٱسْمَعُوا۟ وَأَطِيعُوا۟ وَأَنفِقُوا۟ خَيْرًۭا لِّأَنفُسِكُمْ ۗ وَمَن يُوقَ شُحَّ نَفْسِهِۦ فَأُو۟لَٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ";
"discovery.card.ayah_64_16.source" = "Qur’an 64:16";

"discovery.card.ayah_65_4.title" = "سُورَةُ الطَّلَاقِ 4";
"discovery.card.ayah_65_4.meaning" = "وَٱلَّٰٓـِٔى يَئِسْنَ مِنَ ٱلْمَحِيضِ مِن نِّسَآئِكُمْ إِنِ ٱرْتَبْتُمْ فَعِدَّتُهُنَّ ثَلَٰثَةُ أَشْهُرٍۢ وَٱلَّٰٓـِٔى لَمْ يَحِضْنَ ۚ وَأُو۟لَٰتُ ٱلْأَحْمَالِ أَجَلُهُنَّ أَن يَضَعْنَ حَمْلَهُنَّ ۚ وَمَن يَتَّقِ ٱللَّهَ يَجْعَل لَّهُۥ مِنْ أَمْرِهِۦ يُسْرًۭا";
"discovery.card.ayah_65_4.source" = "Qur’an 65:4";

"discovery.card.ayah_66_8.title" = "سُورَةُ التَّحۡرِيمِ 8";
"discovery.card.ayah_66_8.meaning" = "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ تُوبُوٓا۟ إِلَى ٱللَّهِ تَوْبَةًۭ نَّصُوحًا عَسَىٰ رَبُّكُمْ أَن يُكَفِّرَ عَنكُمْ سَيِّـَٔاتِكُمْ وَيُدْخِلَكُمْ جَنَّٰتٍۢ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ يَوْمَ لَا يُخْزِى ٱللَّهُ ٱلنَّبِىَّ وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ ۖ نُورُهُمْ يَسْعَىٰ بَيْنَ أَيْدِيهِمْ وَبِأَيْمَٰنِهِمْ يَقُولُونَ رَبَّنَآ أَتْمِمْ لَنَا نُورَنَا وَٱغْفِرْ لَنَآ ۖ إِنَّكَ عَلَىٰ كُلِّ شَىْءٍۢ قَدِيرٌۭ";
"discovery.card.ayah_66_8.source" = "Qur’an 66:8";

"discovery.card.ayah_67_1.title" = "سُورَةُ المُلۡكِ 1";
"discovery.card.ayah_67_1.meaning" = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ تَبَٰرَكَ ٱلَّذِى بِيَدِهِ ٱلْمُلْكُ وَهُوَ عَلَىٰ كُلِّ شَىْءٍۢ قَدِيرٌ";
"discovery.card.ayah_67_1.source" = "Qur’an 67:1";

"discovery.card.ayah_67_14.title" = "سُورَةُ المُلۡكِ 14";
"discovery.card.ayah_67_14.meaning" = "أَلَا يَعْلَمُ مَنْ خَلَقَ وَهُوَ ٱللَّطِيفُ ٱلْخَبِيرُ";
"discovery.card.ayah_67_14.source" = "Qur’an 67:14";

"discovery.card.ayah_67_15.title" = "سُورَةُ المُلۡكِ 15";
"discovery.card.ayah_67_15.meaning" = "هُوَ ٱلَّذِى جَعَلَ لَكُمُ ٱلْأَرْضَ ذَلُولًۭا فَٱمْشُوا۟ فِى مَنَاكِبِهَا وَكُلُوا۟ مِن رِّزْقِهِۦ ۖ وَإِلَيْهِ ٱلنُّشُورُ";
"discovery.card.ayah_67_15.source" = "Qur’an 67:15";

"discovery.card.ayah_68_4.title" = "سُورَةُ القَلَمِ 4";
"discovery.card.ayah_68_4.meaning" = "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍۢ";
"discovery.card.ayah_68_4.source" = "Qur’an 68:4";

"discovery.card.ayah_70_19.title" = "سُورَةُ المَعَارِجِ 19";
"discovery.card.ayah_70_19.meaning" = "۞ إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا";
"discovery.card.ayah_70_19.source" = "Qur’an 70:19";

"discovery.card.ayah_73_20.title" = "سُورَةُ المُزَّمِّلِ 20";
"discovery.card.ayah_73_20.meaning" = "۞ إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنَىٰ مِن ثُلُثَىِ ٱلَّيْلِ وَنِصْفَهُۥ وَثُلُثَهُۥ وَطَآئِفَةٌۭ مِّنَ ٱلَّذِينَ مَعَكَ ۚ وَٱللَّهُ يُقَدِّرُ ٱلَّيْلَ وَٱلنَّهَارَ ۚ عَلِمَ أَن لَّن تُحْصُوهُ فَتَابَ عَلَيْكُمْ ۖ فَٱقْرَءُوا۟ مَا تَيَسَّرَ مِنَ ٱلْقُرْءَانِ ۚ عَلِمَ أَن سَيَكُونُ مِنكُم مَّرْضَىٰ ۙ وَءَاخَرُونَ يَضْرِبُونَ فِى ٱلْأَرْضِ يَبْتَغُونَ مِن فَضْلِ ٱللَّهِ ۙ وَءَاخَرُونَ يُقَٰتِلُونَ فِى سَبِيلِ ٱللَّهِ ۖ فَٱقْرَءُوا۟ مَا تَيَسَّرَ مِنْهُ ۚ وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَأَقْرِضُوا۟ ٱللَّهَ قَرْضًا حَسَنًۭا ۚ وَمَا تُقَدِّمُوا۟ لِأَنفُسِكُم مِّنْ خَيْرٍۢ تَجِدُوهُ عِندَ ٱللَّهِ هُوَ خَيْرًۭا وَأَعْظَمَ أَجْرًۭا ۚ وَٱسْتَغْفِرُوا۟ ٱللَّهَ ۖ إِنَّ ٱللَّهَ غَفُورٌۭ رَّحِيمٌۢ";
"discovery.card.ayah_73_20.source" = "Qur’an 73:20";

"discovery.card.ayah_74_3.title" = "سُورَةُ المُدَّثِّرِ 3";
"discovery.card.ayah_74_3.meaning" = "وَرَبَّكَ فَكَبِّرْ";
"discovery.card.ayah_74_3.source" = "Qur’an 74:3";

"discovery.card.ayah_76_8.title" = "سُورَةُ الإِنسَانِ 8";
"discovery.card.ayah_76_8.meaning" = "وَيُطْعِمُونَ ٱلطَّعَامَ عَلَىٰ حُبِّهِۦ مِسْكِينًۭا وَيَتِيمًۭا وَأَسِيرًا";
"discovery.card.ayah_76_8.source" = "Qur’an 76:8";

"discovery.card.ayah_76_9.title" = "سُورَةُ الإِنسَانِ 9";
"discovery.card.ayah_76_9.meaning" = "إِنَّمَا نُطْعِمُكُمْ لِوَجْهِ ٱللَّهِ لَا نُرِيدُ مِنكُمْ جَزَآءًۭ وَلَا شُكُورًا";
"discovery.card.ayah_76_9.source" = "Qur’an 76:9";

"discovery.card.ayah_87_1.title" = "سُورَةُ الأَعۡلَىٰ 1";
"discovery.card.ayah_87_1.meaning" = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى";
"discovery.card.ayah_87_1.source" = "Qur’an 87:1";

"discovery.card.ayah_87_14.title" = "سُورَةُ الأَعۡلَىٰ 14";
"discovery.card.ayah_87_14.meaning" = "قَدْ أَفْلَحَ مَن تَزَكَّىٰ";
"discovery.card.ayah_87_14.source" = "Qur’an 87:14";

"discovery.card.ayah_89_27.title" = "سُورَةُ الفَجۡرِ 27";
"discovery.card.ayah_89_27.meaning" = "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ";
"discovery.card.ayah_89_27.source" = "Qur’an 89:27";

"discovery.card.ayah_89_28.title" = "سُورَةُ الفَجۡرِ 28";
"discovery.card.ayah_89_28.meaning" = "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ";
"discovery.card.ayah_89_28.source" = "Qur’an 89:28";

"discovery.card.ayah_90_12.title" = "سُورَةُ البَلَدِ 12";
"discovery.card.ayah_90_12.meaning" = "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ";
"discovery.card.ayah_90_12.source" = "Qur’an 90:12";

"discovery.card.ayah_90_13.title" = "سُورَةُ البَلَدِ 13";
"discovery.card.ayah_90_13.meaning" = "فَكُّ رَقَبَةٍ";
"discovery.card.ayah_90_13.source" = "Qur’an 90:13";

"discovery.card.ayah_91_9.title" = "سُورَةُ الشَّمۡسِ 9";
"discovery.card.ayah_91_9.meaning" = "قَدْ أَفْلَحَ مَن زَكَّىٰهَا";
"discovery.card.ayah_91_9.source" = "Qur’an 91:9";

"discovery.card.ayah_92_5.title" = "سُورَةُ اللَّيۡلِ 5";
"discovery.card.ayah_92_5.meaning" = "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ";
"discovery.card.ayah_92_5.source" = "Qur’an 92:5";

"discovery.card.ayah_92_18.title" = "سُورَةُ اللَّيۡلِ 18";
"discovery.card.ayah_92_18.meaning" = "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ";
"discovery.card.ayah_92_18.source" = "Qur’an 92:18";

"discovery.card.ayah_93_5.title" = "سُورَةُ الضُّحَىٰ 5";
"discovery.card.ayah_93_5.meaning" = "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ";
"discovery.card.ayah_93_5.source" = "Qur’an 93:5";

"discovery.card.ayah_93_6.title" = "سُورَةُ الضُّحَىٰ 6";
"discovery.card.ayah_93_6.meaning" = "أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ";
"discovery.card.ayah_93_6.source" = "Qur’an 93:6";

"discovery.card.ayah_93_7.title" = "سُورَةُ الضُّحَىٰ 7";
"discovery.card.ayah_93_7.meaning" = "وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ";
"discovery.card.ayah_93_7.source" = "Qur’an 93:7";

"discovery.card.ayah_93_8.title" = "سُورَةُ الضُّحَىٰ 8";
"discovery.card.ayah_93_8.meaning" = "وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ";
"discovery.card.ayah_93_8.source" = "Qur’an 93:8";

"discovery.card.ayah_93_10.title" = "سُورَةُ الضُّحَىٰ 10";
"discovery.card.ayah_93_10.meaning" = "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ";
"discovery.card.ayah_93_10.source" = "Qur’an 93:10";

"discovery.card.ayah_93_11.title" = "سُورَةُ الضُّحَىٰ 11";
"discovery.card.ayah_93_11.meaning" = "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ";
"discovery.card.ayah_93_11.source" = "Qur’an 93:11";

"discovery.card.ayah_94_6.title" = "سُورَةُ الشَّرۡحِ 6";
"discovery.card.ayah_94_6.meaning" = "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا";
"discovery.card.ayah_94_6.source" = "Qur’an 94:6";

"discovery.card.ayah_94_7.title" = "سُورَةُ الشَّرۡحِ 7";
"discovery.card.ayah_94_7.meaning" = "فَإِذَا فَرَغْتَ فَٱنصَبْ";
"discovery.card.ayah_94_7.source" = "Qur’an 94:7";

"discovery.card.ayah_94_8.title" = "سُورَةُ الشَّرۡحِ 8";
"discovery.card.ayah_94_8.meaning" = "وَإِلَىٰ رَبِّكَ فَٱرْغَب";
"discovery.card.ayah_94_8.source" = "Qur’an 94:8";

"discovery.card.ayah_95_4.title" = "سُورَةُ التِّينِ 4";
"discovery.card.ayah_95_4.meaning" = "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ";
"discovery.card.ayah_95_4.source" = "Qur’an 95:4";

"discovery.card.ayah_96_1.title" = "سُورَةُ العَلَقِ 1";
"discovery.card.ayah_96_1.meaning" = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ";
"discovery.card.ayah_96_1.source" = "Qur’an 96:1";

"discovery.card.ayah_96_5.title" = "سُورَةُ العَلَقِ 5";
"discovery.card.ayah_96_5.meaning" = "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ";
"discovery.card.ayah_96_5.source" = "Qur’an 96:5";

"discovery.card.ayah_97_1.title" = "سُورَةُ القَدۡرِ 1";
"discovery.card.ayah_97_1.meaning" = "بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةِ ٱلْقَدْرِ";
"discovery.card.ayah_97_1.source" = "Qur’an 97:1";

"discovery.card.ayah_97_5.title" = "سُورَةُ القَدۡرِ 5";
"discovery.card.ayah_97_5.meaning" = "سَلَٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ";
"discovery.card.ayah_97_5.source" = "Qur’an 97:5";

"discovery.card.ayah_99_7.title" = "سُورَةُ الزَّلۡزَلَةِ 7";
"discovery.card.ayah_99_7.meaning" = "فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًۭا يَرَهُۥ";
"discovery.card.ayah_99_7.source" = "Qur’an 99:7";

"discovery.card.ayah_99_8.title" = "سُورَةُ الزَّلۡزَلَةِ 8";
"discovery.card.ayah_99_8.meaning" = "وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍۢ شَرًّۭا يَرَهُۥ";
"discovery.card.ayah_99_8.source" = "Qur’an 99:8";

"discovery.card.ayah_102_1.title" = "سُورَةُ التَّكَاثُرِ 1";
"discovery.card.ayah_102_1.meaning" = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلْهَىٰكُمُ ٱلتَّكَاثُرُ";
"discovery.card.ayah_102_1.source" = "Qur’an 102:1";

"discovery.card.ayah_102_8.title" = "سُورَةُ التَّكَاثُرِ 8";
"discovery.card.ayah_102_8.meaning" = "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ";
"discovery.card.ayah_102_8.source" = "Qur’an 102:8";

"discovery.card.ayah_103_3.title" = "سُورَةُ العَصۡرِ 3";
"discovery.card.ayah_103_3.meaning" = "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ";
"discovery.card.ayah_103_3.source" = "Qur’an 103:3";

"discovery.card.ayah_107_1.title" = "سُورَةُ المَاعُونِ 1";
"discovery.card.ayah_107_1.meaning" = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ";
"discovery.card.ayah_107_1.source" = "Qur’an 107:1";

"discovery.card.ayah_107_4.title" = "سُورَةُ المَاعُونِ 4";
"discovery.card.ayah_107_4.meaning" = "فَوَيْلٌۭ لِّلْمُصَلِّينَ";
"discovery.card.ayah_107_4.source" = "Qur’an 107:4";

"discovery.card.ayah_110_1.title" = "سُورَةُ النَّصۡرِ 1";
"discovery.card.ayah_110_1.meaning" = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ";
"discovery.card.ayah_110_1.source" = "Qur’an 110:1";

"discovery.card.ayah_110_3.title" = "سُورَةُ النَّصۡرِ 3";
"discovery.card.ayah_110_3.meaning" = "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا";
"discovery.card.ayah_110_3.source" = "Qur’an 110:3";

"discovery.card.ayah_112_2.title" = "سُورَةُ الإِخۡلَاصِ 2";
"discovery.card.ayah_112_2.meaning" = "ٱللَّهُ ٱلصَّمَدُ";
"discovery.card.ayah_112_2.source" = "Qur’an 112:2";

"discovery.card.ayah_112_3.title" = "سُورَةُ الإِخۡلَاصِ 3";
"discovery.card.ayah_112_3.meaning" = "لَمْ يَلِدْ وَلَمْ يُولَدْ";
"discovery.card.ayah_112_3.source" = "Qur’an 112:3";

"discovery.card.ayah_112_4.title" = "سُورَةُ الإِخۡلَاصِ 4";
"discovery.card.ayah_112_4.meaning" = "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ";
"discovery.card.ayah_112_4.source" = "Qur’an 112:4";

"discovery.card.sunnah_bukhari_10.title" = "صحيح البخاري 10";
"discovery.card.sunnah_bukhari_10.meaning" = "حَدَّثَنَا آدَمُ بْنُ أَبِي إِيَاسٍ، قَالَ حَدَّثَنَا شُعْبَةُ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي السَّفَرِ، وَإِسْمَاعِيلَ، عَنِ الشَّعْبِيِّ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ـ رضى الله عنهما ـ عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ، وَالْمُهَاجِرُ مَنْ هَجَرَ مَا نَهَى اللَّهُ عَنْهُ ‏\"‏‏.‏ قَالَ أَبُو عَبْدِ اللَّهِ وَقَالَ أَبُو مُعَاوِيَةَ حَدَّثَنَا دَاوُدُ عَنْ عَامِرٍ قَالَ سَمِعْتُ عَبْدَ اللَّهِ عَنِ النَّبِيِّ صلى الله عليه وسلم‏.‏ وَقَالَ عَبْدُ الأَعْلَى عَنْ دَاوُدَ عَنْ عَامِرٍ عَنْ عَبْدِ اللَّهِ عَنِ النَّبِيِّ صلى الله عليه وسلم‏.‏";
"discovery.card.sunnah_bukhari_10.source" = "Sahih al-Bukhari 10";

"discovery.card.sunnah_bukhari_11.title" = "صحيح البخاري 11";
"discovery.card.sunnah_bukhari_11.meaning" = "حَدَّثَنَا سَعِيدُ بْنُ يَحْيَى بْنِ سَعِيدٍ الْقُرَشِيِّ، قَالَ حَدَّثَنَا أَبِي قَالَ، حَدَّثَنَا أَبُو بُرْدَةَ بْنُ عَبْدِ اللَّهِ بْنِ أَبِي بُرْدَةَ، عَنْ أَبِي بُرْدَةَ، عَنْ أَبِي مُوسَى ـ رضى الله عنه ـ قَالَ قَالُوا يَا رَسُولَ اللَّهِ أَىُّ الإِسْلاَمِ أَفْضَلُ قَالَ ‏ \"‏ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_11.source" = "Sahih al-Bukhari 11";

"discovery.card.sunnah_bukhari_12.title" = "صحيح البخاري 12";
"discovery.card.sunnah_bukhari_12.meaning" = "حَدَّثَنَا عَمْرُو بْنُ خَالِدٍ، قَالَ حَدَّثَنَا اللَّيْثُ، عَنْ يَزِيدَ، عَنْ أَبِي الْخَيْرِ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو ـ رضى الله عنهما ـ أَنَّ رَجُلاً، سَأَلَ النَّبِيَّ صلى الله عليه وسلم أَىُّ الإِسْلاَمِ خَيْرٌ قَالَ ‏ \"‏ تُطْعِمُ الطَّعَامَ، وَتَقْرَأُ السَّلاَمَ عَلَى مَنْ عَرَفْتَ وَمَنْ لَمْ تَعْرِفْ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_12.source" = "Sahih al-Bukhari 12";

"discovery.card.sunnah_bukhari_13.title" = "صحيح البخاري 13";
"discovery.card.sunnah_bukhari_13.meaning" = "حَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا يَحْيَى، عَنْ شُعْبَةَ، عَنْ قَتَادَةَ، عَنْ أَنَسٍ ـ رضى الله عنه ـ عَنِ النَّبِيِّ صلى الله عليه وسلم‏.‏ وَعَنْ حُسَيْنٍ الْمُعَلِّمِ، قَالَ حَدَّثَنَا قَتَادَةُ، عَنْ أَنَسٍ، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ لا يُؤْمِنُ أَحَدُكُمْ حَتَّى يُحِبَّ لأَخِيهِ مَا يُحِبُّ لِنَفْسِهِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_13.source" = "Sahih al-Bukhari 13";

"discovery.card.sunnah_bukhari_14.title" = "صحيح البخاري 14";
"discovery.card.sunnah_bukhari_14.meaning" = "حَدَّثَنَا أَبُو الْيَمَانِ، قَالَ أَخْبَرَنَا شُعَيْبٌ، قَالَ حَدَّثَنَا أَبُو الزِّنَادِ، عَنِ الأَعْرَجِ، عَنْ أَبِي هُرَيْرَةَ ـ رضى الله عنه ـ أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ \"‏ فَوَالَّذِي نَفْسِي بِيَدِهِ لاَ يُؤْمِنُ أَحَدُكُمْ حَتَّى أَكُونَ أَحَبَّ إِلَيْهِ مِنْ وَالِدِهِ وَوَلَدِهِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_14.source" = "Sahih al-Bukhari 14";

"discovery.card.sunnah_bukhari_15.title" = "صحيح البخاري 15";
"discovery.card.sunnah_bukhari_15.meaning" = "حَدَّثَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ، قَالَ حَدَّثَنَا ابْنُ عُلَيَّةَ، عَنْ عَبْدِ الْعَزِيزِ بْنِ صُهَيْبٍ، عَنْ أَنَسٍ، عَنِ النَّبِيِّ صلى الله عليه وسلم ح وَحَدَّثَنَا آدَمُ، قَالَ حَدَّثَنَا شُعْبَةُ، عَنْ قَتَادَةَ، عَنْ أَنَسٍ، قَالَ قَالَ النَّبِيُّ صلى الله عليه وسلم ‏ \"‏ لاَ يُؤْمِنُ أَحَدُكُمْ حَتَّى أَكُونَ أَحَبَّ إِلَيْهِ مِنْ وَالِدِهِ وَوَلَدِهِ وَالنَّاسِ أَجْمَعِينَ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_15.source" = "Sahih al-Bukhari 15";

"discovery.card.sunnah_bukhari_17.title" = "صحيح البخاري 17";
"discovery.card.sunnah_bukhari_17.meaning" = "حَدَّثَنَا أَبُو الْوَلِيدِ، قَالَ حَدَّثَنَا شُعْبَةُ، قَالَ أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ عَبْدِ اللَّهِ بْنِ جَبْرٍ، قَالَ سَمِعْتُ أَنَسًا، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ آيَةُ الإِيمَانِ حُبُّ الأَنْصَارِ، وَآيَةُ النِّفَاقِ بُغْضُ الأَنْصَارِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_17.source" = "Sahih al-Bukhari 17";

"discovery.card.sunnah_bukhari_19.title" = "صحيح البخاري 19";
"discovery.card.sunnah_bukhari_19.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ، عَنْ مَالِكٍ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ عَبْدِ اللَّهِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبِي صَعْصَعَةَ، عَنْ أَبِيهِ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ، أَنَّهُ قَالَ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ يُوشِكُ أَنْ يَكُونَ خَيْرَ مَالِ الْمُسْلِمِ غَنَمٌ يَتْبَعُ بِهَا شَعَفَ الْجِبَالِ وَمَوَاقِعَ الْقَطْرِ، يَفِرُّ بِدِينِهِ مِنَ الْفِتَنِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_19.source" = "Sahih al-Bukhari 19";

"discovery.card.sunnah_bukhari_24.title" = "صحيح البخاري 24";
"discovery.card.sunnah_bukhari_24.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكُ بْنُ أَنَسٍ، عَنِ ابْنِ شِهَابٍ، عَنْ سَالِمِ بْنِ عَبْدِ اللَّهِ، عَنْ أَبِيهِ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم مَرَّ عَلَى رَجُلٍ مِنَ الأَنْصَارِ وَهُوَ يَعِظُ أَخَاهُ فِي الْحَيَاءِ، فَقَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ دَعْهُ فَإِنَّ الْحَيَاءَ مِنَ الإِيمَانِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_24.source" = "Sahih al-Bukhari 24";

"discovery.card.sunnah_bukhari_28.title" = "صحيح البخاري 28";
"discovery.card.sunnah_bukhari_28.meaning" = "حَدَّثَنَا قُتَيْبَةُ، قَالَ حَدَّثَنَا اللَّيْثُ، عَنْ يَزِيدَ بْنِ أَبِي حَبِيبٍ، عَنْ أَبِي الْخَيْرِ، عَنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو، أَنَّ رَجُلاً، سَأَلَ رَسُولَ اللَّهِ صلى الله عليه وسلم أَىُّ الإِسْلاَمِ خَيْرٌ قَالَ ‏ \"‏ تُطْعِمُ الطَّعَامَ، وَتَقْرَأُ السَّلاَمَ عَلَى مَنْ عَرَفْتَ وَمَنْ لَمْ تَعْرِفْ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_28.source" = "Sahih al-Bukhari 28";

"discovery.card.sunnah_bukhari_35.title" = "صحيح البخاري 35";
"discovery.card.sunnah_bukhari_35.meaning" = "حَدَّثَنَا أَبُو الْيَمَانِ، قَالَ أَخْبَرَنَا شُعَيْبٌ، قَالَ حَدَّثَنَا أَبُو الزِّنَادِ، عَنِ الأَعْرَجِ، عَنْ أَبِي هُرَيْرَةَ، قَالَ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ مَنْ يَقُمْ لَيْلَةَ الْقَدْرِ إِيمَانًا وَاحْتِسَابًا غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_35.source" = "Sahih al-Bukhari 35";

"discovery.card.sunnah_bukhari_37.title" = "صحيح البخاري 37";
"discovery.card.sunnah_bukhari_37.meaning" = "حَدَّثَنَا إِسْمَاعِيلُ، قَالَ حَدَّثَنِي مَالِكٌ، عَنِ ابْنِ شِهَابٍ، عَنْ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ، عَنْ أَبِي هُرَيْرَةَ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ \"‏ مَنْ قَامَ رَمَضَانَ إِيمَانًا وَاحْتِسَابًا غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_37.source" = "Sahih al-Bukhari 37";

"discovery.card.sunnah_bukhari_38.title" = "صحيح البخاري 38";
"discovery.card.sunnah_bukhari_38.meaning" = "حَدَّثَنَا ابْنُ سَلاَمٍ، قَالَ أَخْبَرَنَا مُحَمَّدُ بْنُ فُضَيْلٍ، قَالَ حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ، عَنْ أَبِي سَلَمَةَ، عَنْ أَبِي هُرَيْرَةَ، قَالَ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ مَنْ صَامَ رَمَضَانَ إِيمَانًا وَاحْتِسَابًا غُفِرَ لَهُ مَا تَقَدَّمَ مِنْ ذَنْبِهِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_38.source" = "Sahih al-Bukhari 38";

"discovery.card.sunnah_bukhari_42.title" = "صحيح البخاري 42";
"discovery.card.sunnah_bukhari_42.meaning" = "حَدَّثَنَا إِسْحَاقُ بْنُ مَنْصُورٍ، قَالَ حَدَّثَنَا عَبْدُ الرَّزَّاقِ، قَالَ أَخْبَرَنَا مَعْمَرٌ، عَنْ هَمَّامٍ، عَنْ أَبِي هُرَيْرَةَ، قَالَ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ إِذَا أَحْسَنَ أَحَدُكُمْ إِسْلاَمَهُ، فَكُلُّ حَسَنَةٍ يَعْمَلُهَا تُكْتَبُ لَهُ بِعَشْرِ أَمْثَالِهَا إِلَى سَبْعِمِائَةِ ضِعْفٍ، وَكُلُّ سَيِّئَةٍ يَعْمَلُهَا تُكْتَبُ لَهُ بِمِثْلِهَا ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_42.source" = "Sahih al-Bukhari 42";

"discovery.card.sunnah_bukhari_48.title" = "صحيح البخاري 48";
"discovery.card.sunnah_bukhari_48.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ عَرْعَرَةَ، قَالَ حَدَّثَنَا شُعْبَةُ، عَنْ زُبَيْدٍ، قَالَ سَأَلْتُ أَبَا وَائِلٍ عَنِ الْمُرْجِئَةِ،، فَقَالَ حَدَّثَنِي عَبْدُ اللَّهِ، أَنَّ النَّبِيَّ صلى الله عليه وسلم قَالَ ‏ \"‏ سِبَابُ الْمُسْلِمِ فُسُوقٌ، وَقِتَالُهُ كُفْرٌ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_48.source" = "Sahih al-Bukhari 48";

"discovery.card.sunnah_bukhari_55.title" = "صحيح البخاري 55";
"discovery.card.sunnah_bukhari_55.meaning" = "حَدَّثَنَا حَجَّاجُ بْنُ مِنْهَالٍ، قَالَ حَدَّثَنَا شُعْبَةُ، قَالَ أَخْبَرَنِي عَدِيُّ بْنُ ثَابِتٍ، قَالَ سَمِعْتُ عَبْدَ اللَّهِ بْنَ يَزِيدَ، عَنْ أَبِي مَسْعُودٍ، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ إِذَا أَنْفَقَ الرَّجُلُ عَلَى أَهْلِهِ يَحْتَسِبُهَا فَهُوَ لَهُ صَدَقَةٌ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_55.source" = "Sahih al-Bukhari 55";

"discovery.card.sunnah_bukhari_56.title" = "صحيح البخاري 56";
"discovery.card.sunnah_bukhari_56.meaning" = "حَدَّثَنَا الْحَكَمُ بْنُ نَافِعٍ قَالَ أَخْبَرَنَا شُعَيْبٌ عَنْ الزُّهْرِيِّ قَالَ حَدَّثَنِي عَامِرُ بْنُ سَعْدٍ عَنْ سَعْدِ بْنِ أَبِي وَقَّاصٍ أَنَّهُ أَخْبَرَهُ أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ \"إِنَّكَ لَنْ تُنْفِقَ نَفَقَةً تَبْتَغِي بِهَا وَجْهَ اللَّهِ إِلَّا أُجِرْتَ عَلَيْهَا حَتَّى مَا تَجْعَلُ فِي فَمِ امْرَأَتِكَ";
"discovery.card.sunnah_bukhari_56.source" = "Sahih al-Bukhari 56";

"discovery.card.sunnah_bukhari_57.title" = "صحيح البخاري 57";
"discovery.card.sunnah_bukhari_57.meaning" = "حَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا يَحْيَى، عَنْ إِسْمَاعِيلَ، قَالَ حَدَّثَنِي قَيْسُ بْنُ أَبِي حَازِمٍ، عَنْ جَرِيرِ بْنِ عَبْدِ اللَّهِ، قَالَ بَايَعْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم عَلَى إِقَامِ الصَّلاَةِ، وَإِيتَاءِ الزَّكَاةِ، وَالنُّصْحِ لِكُلِّ مُسْلِمٍ‏.‏";
"discovery.card.sunnah_bukhari_57.source" = "Sahih al-Bukhari 57";

"discovery.card.sunnah_bukhari_68.title" = "صحيح البخاري 68";
"discovery.card.sunnah_bukhari_68.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا سُفْيَانُ، عَنِ الأَعْمَشِ، عَنْ أَبِي وَائِلٍ، عَنِ ابْنِ مَسْعُودٍ، قَالَ كَانَ النَّبِيُّ صلى الله عليه وسلم يَتَخَوَّلُنَا بِالْمَوْعِظَةِ فِي الأَيَّامِ، كَرَاهَةَ السَّآمَةِ عَلَيْنَا‏.‏";
"discovery.card.sunnah_bukhari_68.source" = "Sahih al-Bukhari 68";

"discovery.card.sunnah_bukhari_69.title" = "صحيح البخاري 69";
"discovery.card.sunnah_bukhari_69.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ بَشَّارٍ، قَالَ حَدَّثَنَا يَحْيَى بْنُ سَعِيدٍ، قَالَ حَدَّثَنَا شُعْبَةُ، قَالَ حَدَّثَنِي أَبُو التَّيَّاحِ، عَنْ أَنَسٍ، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ يَسِّرُوا وَلاَ تُعَسِّرُوا، وَبَشِّرُوا وَلاَ تُنَفِّرُوا ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_69.source" = "Sahih al-Bukhari 69";

"discovery.card.sunnah_bukhari_75.title" = "صحيح البخاري 75";
"discovery.card.sunnah_bukhari_75.meaning" = "حَدَّثَنَا أَبُو مَعْمَرٍ، قَالَ حَدَّثَنَا عَبْدُ الْوَارِثِ، قَالَ حَدَّثَنَا خَالِدٌ، عَنْ عِكْرِمَةَ، عَنِ ابْنِ عَبَّاسٍ، قَالَ ضَمَّنِي رَسُولُ اللَّهِ صلى الله عليه وسلم وَقَالَ ‏ \"‏ اللَّهُمَّ عَلِّمْهُ الْكِتَابَ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_75.source" = "Sahih al-Bukhari 75";

"discovery.card.sunnah_bukhari_77.title" = "صحيح البخاري 77";
"discovery.card.sunnah_bukhari_77.meaning" = "حَدَّثَنِي مُحَمَّدُ بْنُ يُوسُفَ، قَالَ حَدَّثَنَا أَبُو مُسْهِرٍ، قَالَ حَدَّثَنِي مُحَمَّدُ بْنُ حَرْبٍ، حَدَّثَنِي الزُّبَيْدِيُّ، عَنِ الزُّهْرِيِّ، عَنْ مَحْمُودِ بْنِ الرَّبِيعِ، قَالَ عَقَلْتُ مِنَ النَّبِيِّ صلى الله عليه وسلم مَجَّةً مَجَّهَا فِي وَجْهِي وَأَنَا ابْنُ خَمْسِ سِنِينَ مِنْ دَلْوٍ‏.‏";
"discovery.card.sunnah_bukhari_77.source" = "Sahih al-Bukhari 77";

"discovery.card.sunnah_bukhari_94.title" = "صحيح البخاري 94";
"discovery.card.sunnah_bukhari_94.meaning" = "حَدَّثَنَا عَبْدَةُ، قَالَ حَدَّثَنَا عَبْدُ الصَّمَدِ، قَالَ حَدَّثَنَا عَبْدُ اللَّهِ بْنُ الْمُثَنَّى، قَالَ حَدَّثَنَا ثُمَامَةُ بْنُ عَبْدِ اللَّهِ، عَنْ أَنَسٍ، عَنِ النَّبِيِّ صلى الله عليه وسلم أَنَّهُ كَانَ إِذَا سَلَّمَ سَلَّمَ ثَلاَثًا، وَإِذَا تَكَلَّمَ بِكَلِمَةٍ أَعَادَهَا ثَلاَثًا‏.‏";
"discovery.card.sunnah_bukhari_94.source" = "Sahih al-Bukhari 94";

"discovery.card.sunnah_bukhari_95.title" = "صحيح البخاري 95";
"discovery.card.sunnah_bukhari_95.meaning" = "حَدَّثَنَا عَبْدَةُ بْنُ عَبْدِ اللَّهِ، حَدَّثَنَا عَبْدُ الصَّمَدِ، قَالَ حَدَّثَنَا عَبْدُ اللَّهِ بْنُ الْمُثَنَّى، قَالَ حَدَّثَنَا ثُمَامَةُ بْنُ عَبْدِ اللَّهِ، عَنْ أَنَسٍ، عَنِ النَّبِيِّ صلى الله عليه وسلم أَنَّهُ كَانَ إِذَا تَكَلَّمَ بِكَلِمَةٍ أَعَادَهَا ثَلاَثًا حَتَّى تُفْهَمَ عَنْهُ، وَإِذَا أَتَى عَلَى قَوْمٍ فَسَلَّمَ عَلَيْهِمْ سَلَّمَ عَلَيْهِمْ ثَلاَثًا‏.‏";
"discovery.card.sunnah_bukhari_95.source" = "Sahih al-Bukhari 95";

"discovery.card.sunnah_bukhari_102.title" = "صحيح البخاري 102";
"discovery.card.sunnah_bukhari_102.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ بَشَّارٍ، قَالَ حَدَّثَنَا غُنْدَرٌ، قَالَ حَدَّثَنَا شُعْبَةُ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَصْبَهَانِيِّ، عَنْ ذَكْوَانَ، عَنْ أَبِي سَعِيدٍ الْخُدْرِيِّ، عَنِ النَّبِيِّ صلى الله عليه وسلم بِهَذَا‏.‏ وَعَنْ عَبْدِ الرَّحْمَنِ بْنِ الأَصْبَهَانِيِّ، قَالَ سَمِعْتُ أَبَا حَازِمٍ، عَنْ أَبِي هُرَيْرَةَ، قَالَ ‏ \"‏ ثَلاَثَةً لَمْ يَبْلُغُوا الْحِنْثَ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_102.source" = "Sahih al-Bukhari 102";

"discovery.card.sunnah_bukhari_106.title" = "صحيح البخاري 106";
"discovery.card.sunnah_bukhari_106.meaning" = "حَدَّثَنَا عَلِيُّ بْنُ الْجَعْدِ، قَالَ أَخْبَرَنَا شُعْبَةُ، قَالَ أَخْبَرَنِي مَنْصُورٌ، قَالَ سَمِعْتُ رِبْعِيَّ بْنَ حِرَاشٍ، يَقُولُ سَمِعْتُ عَلِيًّا، يَقُولُ قَالَ النَّبِيُّ صلى الله عليه وسلم ‏ \"‏ لاَ تَكْذِبُوا عَلَىَّ، فَإِنَّهُ مَنْ كَذَبَ عَلَىَّ فَلْيَلِجِ النَّارَ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_106.source" = "Sahih al-Bukhari 106";

"discovery.card.sunnah_bukhari_108.title" = "صحيح البخاري 108";
"discovery.card.sunnah_bukhari_108.meaning" = "حَدَّثَنَا أَبُو مَعْمَرٍ، قَالَ حَدَّثَنَا عَبْدُ الْوَارِثِ، عَنْ عَبْدِ الْعَزِيزِ، قَالَ أَنَسٌ إِنَّهُ لَيَمْنَعُنِي أَنْ أُحَدِّثَكُمْ حَدِيثًا كَثِيرًا أَنَّ النَّبِيَّ صلى الله عليه وسلم قَالَ ‏ \"‏ مَنْ تَعَمَّدَ عَلَىَّ كَذِبًا فَلْيَتَبَوَّأْ مَقْعَدَهُ مِنَ النَّارِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_108.source" = "Sahih al-Bukhari 108";

"discovery.card.sunnah_bukhari_109.title" = "صحيح البخاري 109";
"discovery.card.sunnah_bukhari_109.meaning" = "حَدَّثَنَا مَكِّيُّ بْنُ إِبْرَاهِيمَ، قَالَ حَدَّثَنَا يَزِيدُ بْنُ أَبِي عُبَيْدٍ، عَنْ سَلَمَةَ، قَالَ سَمِعْتُ النَّبِيَّ صلى الله عليه وسلم يَقُولُ ‏ \"‏ مَنْ يَقُلْ عَلَىَّ مَا لَمْ أَقُلْ فَلْيَتَبَوَّأْ مَقْعَدَهُ مِنَ النَّارِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_109.source" = "Sahih al-Bukhari 109";

"discovery.card.sunnah_bukhari_113.title" = "صحيح البخاري 113";
"discovery.card.sunnah_bukhari_113.meaning" = "حَدَّثَنَا عَلِيُّ بْنُ عَبْدِ اللَّهِ، قَالَ حَدَّثَنَا سُفْيَانُ، قَالَ حَدَّثَنَا عَمْرٌو، قَالَ أَخْبَرَنِي وَهْبُ بْنُ مُنَبِّهٍ، عَنْ أَخِيهِ، قَالَ سَمِعْتُ أَبَا هُرَيْرَةَ، يَقُولُ مَا مِنْ أَصْحَابِ النَّبِيِّ صلى الله عليه وسلم أَحَدٌ أَكْثَرَ حَدِيثًا عَنْهُ مِنِّي، إِلاَّ مَا كَانَ مِنْ عَبْدِ اللَّهِ بْنِ عَمْرٍو فَإِنَّهُ كَانَ يَكْتُبُ وَلاَ أَكْتُبُ‏.‏ تَابَعَهُ مَعْمَرٌ عَنْ هَمَّامٍ عَنْ أَبِي هُرَيْرَةَ‏.‏";
"discovery.card.sunnah_bukhari_113.source" = "Sahih al-Bukhari 113";

"discovery.card.sunnah_bukhari_120.title" = "صحيح البخاري 120";
"discovery.card.sunnah_bukhari_120.meaning" = "حَدَّثَنَا إِسْمَاعِيلُ، قَالَ حَدَّثَنِي أَخِي، عَنِ ابْنِ أَبِي ذِئْبٍ، عَنْ سَعِيدٍ الْمَقْبُرِيِّ، عَنْ أَبِي هُرَيْرَةَ، قَالَ حَفِظْتُ مِنْ رَسُولِ اللَّهِ صلى الله عليه وسلم وِعَاءَيْنِ، فَأَمَّا أَحَدُهُمَا فَبَثَثْتُهُ، وَأَمَّا الآخَرُ فَلَوْ بَثَثْتُهُ قُطِعَ هَذَا الْبُلْعُومُ‏.‏";
"discovery.card.sunnah_bukhari_120.source" = "Sahih al-Bukhari 120";

"discovery.card.sunnah_bukhari_121.title" = "صحيح البخاري 121";
"discovery.card.sunnah_bukhari_121.meaning" = "حَدَّثَنَا حَجَّاجٌ، قَالَ حَدَّثَنَا شُعْبَةُ، قَالَ أَخْبَرَنِي عَلِيُّ بْنُ مُدْرِكٍ، عَنْ أَبِي زُرْعَةَ، عَنْ جَرِيرٍ، أَنَّ النَّبِيَّ صلى الله عليه وسلم قَالَ لَهُ فِي حَجَّةِ الْوَدَاعِ ‏\"‏ اسْتَنْصِتِ النَّاسَ ‏\"‏ فَقَالَ ‏\"‏ لاَ تَرْجِعُوا بَعْدِي كُفَّارًا يَضْرِبُ بَعْضُكُمْ رِقَابَ بَعْضٍ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_121.source" = "Sahih al-Bukhari 121";

"discovery.card.sunnah_bukhari_127.title" = "صحيح البخاري 127";
"discovery.card.sunnah_bukhari_127.meaning" = "حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُوسَى عَنْ مَعْرُوفِ بْنِ خَرَّبُوذٍ عَنْ أَبِي الطُّفَيْلِ عَنْ عَلِيٍّ بِذَلِكَ‏.‏";
"discovery.card.sunnah_bukhari_127.source" = "Sahih al-Bukhari 127";

"discovery.card.sunnah_bukhari_132.title" = "صحيح البخاري 132";
"discovery.card.sunnah_bukhari_132.meaning" = "حَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا عَبْدُ اللَّهِ بْنُ دَاوُدَ، عَنِ الأَعْمَشِ، عَنْ مُنْذِرٍ الثَّوْرِيِّ، عَنْ مُحَمَّدٍ ابْنِ الْحَنَفِيَّةِ، عَنْ عَلِيٍّ، قَالَ كُنْتُ رَجُلاً مَذَّاءً فَأَمَرْتُ الْمِقْدَادَ أَنْ يَسْأَلَ النَّبِيَّ صلى الله عليه وسلم فَسَأَلَهُ فَقَالَ ‏ \"‏ فِيهِ الْوُضُوءُ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_132.source" = "Sahih al-Bukhari 132";

"discovery.card.sunnah_bukhari_137.title" = "صحيح البخاري 137";
"discovery.card.sunnah_bukhari_137.meaning" = "حَدَّثَنَا عَلِيٌّ، قَالَ حَدَّثَنَا سُفْيَانُ، قَالَ حَدَّثَنَا الزُّهْرِيُّ، عَنْ سَعِيدِ بْنِ الْمُسَيَّبِ، وَعَنْ عَبَّادِ بْنِ تَمِيمٍ، عَنْ عَمِّهِ، أَنَّهُ شَكَا إِلَى رَسُولِ اللَّهِ صلى الله عليه وسلم الرَّجُلُ الَّذِي يُخَيَّلُ إِلَيْهِ أَنَّهُ يَجِدُ الشَّىْءَ فِي الصَّلاَةِ‏.‏ فَقَالَ ‏ \"‏ لاَ يَنْفَتِلْ ـ أَوْ لاَ يَنْصَرِفْ ـ حَتَّى يَسْمَعَ صَوْتًا أَوْ يَجِدَ رِيحًا ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_137.source" = "Sahih al-Bukhari 137";

"discovery.card.sunnah_bukhari_142.title" = "صحيح البخاري 142";
"discovery.card.sunnah_bukhari_142.meaning" = "حَدَّثَنَا آدَمُ، قَالَ حَدَّثَنَا شُعْبَةُ، عَنْ عَبْدِ الْعَزِيزِ بْنِ صُهَيْبٍ، قَالَ سَمِعْتُ أَنَسًا، يَقُولُ كَانَ النَّبِيُّ صلى الله عليه وسلم إِذَا دَخَلَ الْخَلاَءَ قَالَ ‏ \"‏ اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْخُبُثِ وَالْخَبَائِثِ ‏\"‏‏.‏ تَابَعَهُ ابْنُ عَرْعَرَةَ عَنْ شُعْبَةَ‏.‏ وَقَالَ غُنْدَرٌ عَنْ شُعْبَةَ إِذَا أَتَى الْخَلاَءَ‏.‏ وَقَالَ مُوسَى عَنْ حَمَّادٍ إِذَا دَخَلَ‏.‏ وَقَالَ سَعِيدُ بْنُ زَيْدٍ حَدَّثَنَا عَبْدُ الْعَزِيزِ إِذَا أَرَادَ أَنْ يَدْخُلَ‏.‏";
"discovery.card.sunnah_bukhari_142.source" = "Sahih al-Bukhari 142";

"discovery.card.sunnah_bukhari_143.title" = "صحيح البخاري 143";
"discovery.card.sunnah_bukhari_143.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مُحَمَّدٍ، قَالَ حَدَّثَنَا هَاشِمُ بْنُ الْقَاسِمِ، قَالَ حَدَّثَنَا وَرْقَاءُ، عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي يَزِيدَ، عَنِ ابْنِ عَبَّاسٍ، أَنَّ النَّبِيَّ صلى الله عليه وسلم دَخَلَ الْخَلاَءَ، فَوَضَعْتُ لَهُ وَضُوءًا قَالَ ‏\"‏ مَنْ وَضَعَ هَذَا ‏\"‏‏.‏ فَأُخْبِرَ فَقَالَ ‏\"‏ اللَّهُمَّ فَقِّهْهُ فِي الدِّينِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_143.source" = "Sahih al-Bukhari 143";

"discovery.card.sunnah_bukhari_144.title" = "صحيح البخاري 144";
"discovery.card.sunnah_bukhari_144.meaning" = "حَدَّثَنَا آدَمُ، قَالَ حَدَّثَنَا ابْنُ أَبِي ذِئْبٍ، قَالَ حَدَّثَنَا الزُّهْرِيُّ، عَنْ عَطَاءِ بْنِ يَزِيدَ اللَّيْثِيِّ، عَنْ أَبِي أَيُّوبَ الأَنْصَارِيِّ، قَالَ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ إِذَا أَتَى أَحَدُكُمُ الْغَائِطَ فَلاَ يَسْتَقْبِلِ الْقِبْلَةَ وَلاَ يُوَلِّهَا ظَهْرَهُ، شَرِّقُوا أَوْ غَرِّبُوا ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_144.source" = "Sahih al-Bukhari 144";

"discovery.card.sunnah_bukhari_147.title" = "صحيح البخاري 147";
"discovery.card.sunnah_bukhari_147.meaning" = "حَدَّثَنَا زَكَرِيَّاءُ، قَالَ حَدَّثَنَا أَبُو أُسَامَةَ، عَنْ هِشَامِ بْنِ عُرْوَةَ، عَنْ أَبِيهِ، عَنْ عَائِشَةَ، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ قَدْ أُذِنَ أَنْ تَخْرُجْنَ فِي حَاجَتِكُنَّ ‏\"‏‏.‏ قَالَ هِشَامٌ يَعْنِي الْبَرَازَ‏.‏";
"discovery.card.sunnah_bukhari_147.source" = "Sahih al-Bukhari 147";

"discovery.card.sunnah_bukhari_148.title" = "صحيح البخاري 148";
"discovery.card.sunnah_bukhari_148.meaning" = "حَدَّثَنَا إِبْرَاهِيمُ بْنُ الْمُنْذِرِ، قَالَ حَدَّثَنَا أَنَسُ بْنُ عِيَاضٍ، عَنْ عُبَيْدِ اللَّهِ، عَنْ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ، عَنْ وَاسِعِ بْنِ حَبَّانَ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ، قَالَ ارْتَقَيْتُ فَوْقَ ظَهْرِ بَيْتِ حَفْصَةَ لِبَعْضِ حَاجَتِي، فَرَأَيْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم يَقْضِي حَاجَتَهُ مُسْتَدْبِرَ الْقِبْلَةِ مُسْتَقْبِلَ الشَّأْمِ‏.‏";
"discovery.card.sunnah_bukhari_148.source" = "Sahih al-Bukhari 148";

"discovery.card.sunnah_bukhari_149.title" = "صحيح البخاري 149";
"discovery.card.sunnah_bukhari_149.meaning" = "حَدَّثَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ، قَالَ حَدَّثَنَا يَزِيدُ بْنُ هَارُونَ، قَالَ أَخْبَرَنَا يَحْيَى، عَنْ مُحَمَّدِ بْنِ يَحْيَى بْنِ حَبَّانَ، أَنَّ عَمَّهُ، وَاسِعَ بْنَ حَبَّانَ، أَخْبَرَهُ أَنَّ عَبْدَ اللَّهِ بْنَ عُمَرَ أَخْبَرَهُ قَالَ لَقَدْ ظَهَرْتُ ذَاتَ يَوْمٍ عَلَى ظَهْرِ بَيْتِنَا، فَرَأَيْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم قَاعِدًا عَلَى لَبِنَتَيْنِ مُسْتَقْبِلَ بَيْتِ الْمَقْدِسِ‏.‏";
"discovery.card.sunnah_bukhari_149.source" = "Sahih al-Bukhari 149";

"discovery.card.sunnah_bukhari_150.title" = "صحيح البخاري 150";
"discovery.card.sunnah_bukhari_150.meaning" = "حَدَّثَنَا أَبُو الْوَلِيدِ، هِشَامُ بْنُ عَبْدِ الْمَلِكِ قَالَ حَدَّثَنَا شُعْبَةُ، عَنْ أَبِي مُعَاذٍ ـ وَاسْمُهُ عَطَاءُ بْنُ أَبِي مَيْمُونَةَ ـ قَالَ سَمِعْتُ أَنَسَ بْنَ مَالِكٍ، يَقُولُ كَانَ النَّبِيُّ صلى الله عليه وسلم إِذَا خَرَجَ لِحَاجَتِهِ أَجِيءُ أَنَا وَغُلاَمٌ مَعَنَا إِدَاوَةٌ مِنْ مَاءٍ‏.‏ يَعْنِي يَسْتَنْجِي بِهِ‏.‏";
"discovery.card.sunnah_bukhari_150.source" = "Sahih al-Bukhari 150";

"discovery.card.sunnah_bukhari_151.title" = "صحيح البخاري 151";
"discovery.card.sunnah_bukhari_151.meaning" = "حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، قَالَ حَدَّثَنَا شُعْبَةُ، عَنْ أَبِي مُعَاذٍ ـ هُوَ عَطَاءُ بْنُ أَبِي مَيْمُونَةَ ـ قَالَ سَمِعْتُ أَنَسًا، يَقُولُ كَانَ رَسُولُ اللَّهِ صلى الله عليه وسلم إِذَا خَرَجَ لِحَاجَتِهِ تَبِعْتُهُ أَنَا وَغُلاَمٌ مِنَّا مَعَنَا إِدَاوَةٌ مِنْ مَاءٍ‏.‏";
"discovery.card.sunnah_bukhari_151.source" = "Sahih al-Bukhari 151";

"discovery.card.sunnah_bukhari_153.title" = "صحيح البخاري 153";
"discovery.card.sunnah_bukhari_153.meaning" = "حَدَّثَنَا مُعَاذُ بْنُ فَضَالَةَ، قَالَ حَدَّثَنَا هِشَامٌ ـ هُوَ الدَّسْتَوَائِيُّ ـ عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي قَتَادَةَ، عَنْ أَبِيهِ، قَالَ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ إِذَا شَرِبَ أَحَدُكُمْ فَلاَ يَتَنَفَّسْ فِي الإِنَاءِ، وَإِذَا أَتَى الْخَلاَءَ فَلاَ يَمَسَّ ذَكَرَهُ بِيَمِينِهِ، وَلاَ يَتَمَسَّحْ بِيَمِينِهِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_153.source" = "Sahih al-Bukhari 153";

"discovery.card.sunnah_bukhari_154.title" = "صحيح البخاري 154";
"discovery.card.sunnah_bukhari_154.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، قَالَ حَدَّثَنَا الأَوْزَاعِيُّ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي قَتَادَةَ، عَنْ أَبِيهِ، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ إِذَا بَالَ أَحَدُكُمْ فَلاَ يَأْخُذَنَّ ذَكَرَهُ بِيَمِينِهِ، وَلاَ يَسْتَنْجِي بِيَمِينِهِ، وَلاَ يَتَنَفَّسْ فِي الإِنَاءِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_154.source" = "Sahih al-Bukhari 154";

"discovery.card.sunnah_bukhari_157.title" = "صحيح البخاري 157";
"discovery.card.sunnah_bukhari_157.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، قَالَ حَدَّثَنَا سُفْيَانُ، عَنْ زَيْدِ بْنِ أَسْلَمَ، عَنْ عَطَاءِ بْنِ يَسَارٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ تَوَضَّأَ النَّبِيُّ صلى الله عليه وسلم مَرَّةً مَرَّةً‏.‏";
"discovery.card.sunnah_bukhari_157.source" = "Sahih al-Bukhari 157";

"discovery.card.sunnah_bukhari_158.title" = "صحيح البخاري 158";
"discovery.card.sunnah_bukhari_158.meaning" = "حَدَّثَنَا حُسَيْنُ بْنُ عِيسَى، قَالَ حَدَّثَنَا يُونُسُ بْنُ مُحَمَّدٍ، قَالَ حَدَّثَنَا فُلَيْحُ بْنُ سُلَيْمَانَ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرِ بْنِ عَمْرِو بْنِ حَزْمٍ، عَنْ عَبَّادِ بْنِ تَمِيمٍ، عَنْ عَبْدِ اللَّهِ بْنِ زَيْدٍ، أَنَّ النَّبِيَّ صلى الله عليه وسلم تَوَضَّأَ مَرَّتَيْنِ مَرَّتَيْنِ‏.‏";
"discovery.card.sunnah_bukhari_158.source" = "Sahih al-Bukhari 158";

"discovery.card.sunnah_bukhari_161.title" = "صحيح البخاري 161";
"discovery.card.sunnah_bukhari_161.meaning" = "حَدَّثَنَا عَبْدَانُ، قَالَ أَخْبَرَنَا عَبْدُ اللَّهِ، قَالَ أَخْبَرَنَا يُونُسُ، عَنِ الزُّهْرِيِّ، قَالَ أَخْبَرَنِي أَبُو إِدْرِيسَ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ، عَنِ النَّبِيِّ صلى الله عليه وسلم أَنَّهُ قَالَ ‏ \"‏ مَنْ تَوَضَّأَ فَلْيَسْتَنْثِرْ، وَمَنِ اسْتَجْمَرَ فَلْيُوتِرْ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_161.source" = "Sahih al-Bukhari 161";

"discovery.card.sunnah_bukhari_165.title" = "صحيح البخاري 165";
"discovery.card.sunnah_bukhari_165.meaning" = "حَدَّثَنَا آدَمُ بْنُ أَبِي إِيَاسٍ، قَالَ حَدَّثَنَا شُعْبَةُ، قَالَ حَدَّثَنَا مُحَمَّدُ بْنُ زِيَادٍ، قَالَ سَمِعْتُ أَبَا هُرَيْرَةَ ـ وَكَانَ يَمُرُّ بِنَا وَالنَّاسُ يَتَوَضَّئُونَ مِنَ الْمِطْهَرَةِ ـ قَالَ أَسْبِغُوا الْوُضُوءَ فَإِنَّ أَبَا الْقَاسِمِ صلى الله عليه وسلم قَالَ ‏ \"‏ وَيْلٌ لِلأَعْقَابِ مِنَ النَّارِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_165.source" = "Sahih al-Bukhari 165";

"discovery.card.sunnah_bukhari_167.title" = "صحيح البخاري 167";
"discovery.card.sunnah_bukhari_167.meaning" = "حَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا إِسْمَاعِيلُ، قَالَ حَدَّثَنَا خَالِدٌ، عَنْ حَفْصَةَ بِنْتِ سِيرِينَ، عَنْ أُمِّ عَطِيَّةَ، قَالَتْ قَالَ النَّبِيُّ صلى الله عليه وسلم لَهُنَّ فِي غُسْلِ ابْنَتِهِ ‏ \"‏ ابْدَأْنَ بِمَيَامِنِهَا وَمَوَاضِعِ الْوُضُوءِ مِنْهَا ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_167.source" = "Sahih al-Bukhari 167";

"discovery.card.sunnah_bukhari_168.title" = "صحيح البخاري 168";
"discovery.card.sunnah_bukhari_168.meaning" = "حَدَّثَنَا حَفْصُ بْنُ عُمَرَ، قَالَ حَدَّثَنَا شُعْبَةُ، قَالَ أَخْبَرَنِي أَشْعَثُ بْنُ سُلَيْمٍ، قَالَ سَمِعْتُ أَبِي، عَنْ مَسْرُوقٍ، عَنْ عَائِشَةَ، قَالَتْ كَانَ النَّبِيُّ صلى الله عليه وسلم يُعْجِبُهُ التَّيَمُّنُ فِي تَنَعُّلِهِ وَتَرَجُّلِهِ وَطُهُورِهِ وَفِي شَأْنِهِ كُلِّهِ‏.‏";
"discovery.card.sunnah_bukhari_168.source" = "Sahih al-Bukhari 168";

"discovery.card.sunnah_bukhari_170.title" = "صحيح البخاري 170";
"discovery.card.sunnah_bukhari_170.meaning" = "حَدَّثَنَا مَالِكُ بْنُ إِسْمَاعِيلَ، قَالَ حَدَّثَنَا إِسْرَائِيلُ، عَنْ عَاصِمٍ، عَنِ ابْنِ سِيرِينَ، قَالَ قُلْتُ لِعَبِيدَةَ عِنْدَنَا مِنْ شَعَرِ النَّبِيِّ صلى الله عليه وسلم أَصَبْنَاهُ مِنْ قِبَلِ أَنَسٍ، أَوْ مِنْ قِبَلِ أَهْلِ أَنَسٍ فَقَالَ لأَنْ تَكُونَ عِنْدِي شَعَرَةٌ مِنْهُ أَحَبُّ إِلَىَّ مِنَ الدُّنْيَا وَمَا فِيهَا‏.‏";
"discovery.card.sunnah_bukhari_170.source" = "Sahih al-Bukhari 170";

"discovery.card.sunnah_bukhari_171.title" = "صحيح البخاري 171";
"discovery.card.sunnah_bukhari_171.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ عَبْدِ الرَّحِيمِ، قَالَ أَخْبَرَنَا سَعِيدُ بْنُ سُلَيْمَانَ، قَالَ حَدَّثَنَا عَبَّادٌ، عَنِ ابْنِ عَوْنٍ، عَنِ ابْنِ سِيرِينَ، عَنْ أَنَسٍ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم لَمَّا حَلَقَ رَأْسَهُ كَانَ أَبُو طَلْحَةَ أَوَّلَ مَنْ أَخَذَ مِنْ شَعَرِهِ‏.‏";
"discovery.card.sunnah_bukhari_171.source" = "Sahih al-Bukhari 171";

"discovery.card.sunnah_bukhari_172.title" = "صحيح البخاري 172";
"discovery.card.sunnah_bukhari_172.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، عَنْ مَالِكٍ، عَنْ أَبِي الزِّنَادِ، عَنِ الأَعْرَجِ، عَنْ أَبِي هُرَيْرَةَ، قَالَ إِنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ \"‏ إِذَا شَرِبَ الْكَلْبُ فِي إِنَاءِ أَحَدِكُمْ فَلْيَغْسِلْهُ سَبْعًا ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_172.source" = "Sahih al-Bukhari 172";

"discovery.card.sunnah_bukhari_174.title" = "صحيح البخاري 174";
"discovery.card.sunnah_bukhari_174.meaning" = "وَقَالَ أَحْمَدُ بْنُ شَبِيبٍ حَدَّثَنَا أَبِي، عَنْ يُونُسَ، عَنِ ابْنِ شِهَابٍ، قَالَ حَدَّثَنِي حَمْزَةُ بْنُ عَبْدِ اللَّهِ، عَنْ أَبِيهِ، قَالَ كَانَتِ الْكِلاَبُ تَبُولُ وَتُقْبِلُ وَتُدْبِرُ فِي الْمَسْجِدِ فِي زَمَانِ رَسُولِ اللَّهِ صلى الله عليه وسلم فَلَمْ يَكُونُوا يَرُشُّونَ شَيْئًا مِنْ ذَلِكَ‏.‏";
"discovery.card.sunnah_bukhari_174.source" = "Sahih al-Bukhari 174";

"discovery.card.sunnah_bukhari_177.title" = "صحيح البخاري 177";
"discovery.card.sunnah_bukhari_177.meaning" = "حَدَّثَنَا أَبُو الْوَلِيدِ، قَالَ حَدَّثَنَا ابْنُ عُيَيْنَةَ، عَنِ الزُّهْرِيِّ، عَنْ عَبَّادِ بْنِ تَمِيمٍ، عَنْ عَمِّهِ، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ لاَ يَنْصَرِفْ حَتَّى يَسْمَعَ صَوْتًا أَوْ يَجِدَ رِيحًا ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_177.source" = "Sahih al-Bukhari 177";

"discovery.card.sunnah_bukhari_178.title" = "صحيح البخاري 178";
"discovery.card.sunnah_bukhari_178.meaning" = "حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ، قَالَ حَدَّثَنَا جَرِيرٌ، عَنِ الأَعْمَشِ، عَنْ مُنْذِرٍ أَبِي يَعْلَى الثَّوْرِيِّ، عَنْ مُحَمَّدٍ ابْنِ الْحَنَفِيَّةِ، قَالَ قَالَ عَلِيٌّ كُنْتُ رَجُلاً مَذَّاءً، فَاسْتَحْيَيْتُ أَنْ أَسْأَلَ رَسُولَ اللَّهِ صلى الله عليه وسلم فَأَمَرْتُ الْمِقْدَادَ بْنَ الأَسْوَدِ فَسَأَلَهُ فَقَالَ ‏ \"‏ فِيهِ الْوُضُوءُ ‏\"‏‏.‏ وَرَوَاهُ شُعْبَةُ عَنِ الأَعْمَشِ‏.‏";
"discovery.card.sunnah_bukhari_178.source" = "Sahih al-Bukhari 178";

"discovery.card.sunnah_bukhari_188.title" = "صحيح البخاري 188";
"discovery.card.sunnah_bukhari_188.meaning" = "وَقَالَ أَبُو مُوسَى دَعَا النَّبِيُّ صلى الله عليه وسلم بِقَدَحٍ فِيهِ مَاءٌ، فَغَسَلَ يَدَيْهِ وَوَجْهَهُ فِيهِ، وَمَجَّ فِيهِ ثُمَّ قَالَ لَهُمَا اشْرَبَا مِنْهُ، وَأَفْرِغَا عَلَى وُجُوهِكُمَا وَنُحُورِكُمَا‏.‏";
"discovery.card.sunnah_bukhari_188.source" = "Sahih al-Bukhari 188";

"discovery.card.sunnah_bukhari_193.title" = "صحيح البخاري 193";
"discovery.card.sunnah_bukhari_193.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكٌ، عَنْ نَافِعٍ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ، أَنَّهُ قَالَ كَانَ الرِّجَالُ وَالنِّسَاءُ يَتَوَضَّئُونَ فِي زَمَانِ رَسُولِ اللَّهِ صلى الله عليه وسلم جَمِيعًا‏.‏";
"discovery.card.sunnah_bukhari_193.source" = "Sahih al-Bukhari 193";

"discovery.card.sunnah_bukhari_196.title" = "صحيح البخاري 196";
"discovery.card.sunnah_bukhari_196.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ الْعَلاَءِ، قَالَ حَدَّثَنَا أَبُو أُسَامَةَ، عَنْ بُرَيْدٍ، عَنْ أَبِي بُرْدَةَ، عَنْ أَبِي مُوسَى، أَنَّ النَّبِيَّ صلى الله عليه وسلم دَعَا بِقَدَحٍ فِيهِ مَاءٌ، فَغَسَلَ يَدَيْهِ وَوَجْهَهُ فِيهِ وَمَجَّ فِيهِ‏.‏";
"discovery.card.sunnah_bukhari_196.source" = "Sahih al-Bukhari 196";

"discovery.card.sunnah_bukhari_201.title" = "صحيح البخاري 201";
"discovery.card.sunnah_bukhari_201.meaning" = "حَدَّثَنَا أَبُو نُعَيْمٍ، قَالَ حَدَّثَنَا مِسْعَرٌ، قَالَ حَدَّثَنِي ابْنُ جَبْرٍ، قَالَ سَمِعْتُ أَنَسًا، يَقُولُ كَانَ النَّبِيُّ صلى الله عليه وسلم يَغْسِلُ ـ أَوْ كَانَ يَغْتَسِلُ ـ بِالصَّاعِ إِلَى خَمْسَةِ أَمْدَادٍ، وَيَتَوَضَّأُ بِالْمُدِّ‏.‏";
"discovery.card.sunnah_bukhari_201.source" = "Sahih al-Bukhari 201";

"discovery.card.sunnah_bukhari_204.title" = "صحيح البخاري 204";
"discovery.card.sunnah_bukhari_204.meaning" = "حَدَّثَنَا أَبُو نُعَيْمٍ، قَالَ حَدَّثَنَا شَيْبَانُ، عَنْ يَحْيَى، عَنْ أَبِي سَلَمَةَ، عَنْ جَعْفَرِ بْنِ عَمْرِو بْنِ أُمَيَّةَ الضَّمْرِيِّ، أَنَّ أَبَاهُ، أَخْبَرَهُ أَنَّهُ، رَأَى النَّبِيَّ صلى الله عليه وسلم يَمْسَحُ عَلَى الْخُفَّيْنِ‏.‏ وَتَابَعَهُ حَرْبُ بْنُ شَدَّادٍ وَأَبَانُ عَنْ يَحْيَى‏.‏";
"discovery.card.sunnah_bukhari_204.source" = "Sahih al-Bukhari 204";

"discovery.card.sunnah_bukhari_205.title" = "صحيح البخاري 205";
"discovery.card.sunnah_bukhari_205.meaning" = "حَدَّثَنَا عَبْدَانُ، قَالَ أَخْبَرَنَا عَبْدُ اللَّهِ، قَالَ أَخْبَرَنَا الأَوْزَاعِيُّ، عَنْ يَحْيَى، عَنْ أَبِي سَلَمَةَ، عَنْ جَعْفَرِ بْنِ عَمْرٍو، عَنْ أَبِيهِ، قَالَ رَأَيْتُ النَّبِيَّ صلى الله عليه وسلم يَمْسَحُ عَلَى عِمَامَتِهِ وَخُفَّيْهِ‏.‏ وَتَابَعَهُ مَعْمَرٌ عَنْ يَحْيَى عَنْ أَبِي سَلَمَةَ عَنْ عَمْرٍو قَالَ رَأَيْتُ النَّبِيَّ صلى الله عليه وسلم‏.‏";
"discovery.card.sunnah_bukhari_205.source" = "Sahih al-Bukhari 205";

"discovery.card.sunnah_bukhari_207.title" = "صحيح البخاري 207";
"discovery.card.sunnah_bukhari_207.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكٌ، عَنْ زَيْدِ بْنِ أَسْلَمَ، عَنْ عَطَاءِ بْنِ يَسَارٍ، عَنْ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ،‏.‏ أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم أَكَلَ كَتِفَ شَاةٍ، ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ‏.‏";
"discovery.card.sunnah_bukhari_207.source" = "Sahih al-Bukhari 207";

"discovery.card.sunnah_bukhari_208.title" = "صحيح البخاري 208";
"discovery.card.sunnah_bukhari_208.meaning" = "حَدَّثَنَا يَحْيَى بْنُ بُكَيْرٍ، قَالَ حَدَّثَنَا اللَّيْثُ، عَنْ عُقَيْلٍ، عَنِ ابْنِ شِهَابٍ، قَالَ أَخْبَرَنِي جَعْفَرُ بْنُ عَمْرِو بْنِ أُمَيَّةَ، أَنَّ أَبَاهُ، أَخْبَرَهُ أَنَّهُ، رَأَى رَسُولَ اللَّهِ صلى الله عليه وسلم يَحْتَزُّ مِنْ كَتِفِ شَاةٍ، فَدُعِيَ إِلَى الصَّلاَةِ فَأَلْقَى السِّكِّينَ فَصَلَّى وَلَمْ يَتَوَضَّأْ‏.‏";
"discovery.card.sunnah_bukhari_208.source" = "Sahih al-Bukhari 208";

"discovery.card.sunnah_bukhari_210.title" = "صحيح البخاري 210";
"discovery.card.sunnah_bukhari_210.meaning" = "وَحَدَّثَنَا أَصْبَغُ، قَالَ أَخْبَرَنَا ابْنُ وَهْبٍ، قَالَ أَخْبَرَنِي عَمْرٌو، عَنْ بُكَيْرٍ، عَنْ كُرَيْبٍ، عَنْ مَيْمُونَةَ، أَنَّ النَّبِيَّ صلى الله عليه وسلم أَكَلَ عِنْدَهَا كَتِفًا، ثُمَّ صَلَّى وَلَمْ يَتَوَضَّأْ‏.‏";
"discovery.card.sunnah_bukhari_210.source" = "Sahih al-Bukhari 210";

"discovery.card.sunnah_bukhari_211.title" = "صحيح البخاري 211";
"discovery.card.sunnah_bukhari_211.meaning" = "حَدَّثَنَا يَحْيَى بْنُ بُكَيْرٍ، وَقُتَيْبَةُ، قَالاَ حَدَّثَنَا اللَّيْثُ، عَنْ عُقَيْلٍ، عَنِ ابْنِ شِهَابٍ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ، عَنِ ابْنِ عَبَّاسٍ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم شَرِبَ لَبَنًا، فَمَضْمَضَ وَقَالَ ‏ \"‏ إِنَّ لَهُ دَسَمًا ‏\"‏‏.‏ تَابَعَهُ يُونُسُ وَصَالِحُ بْنُ كَيْسَانَ عَنِ الزُّهْرِيِّ‏.‏";
"discovery.card.sunnah_bukhari_211.source" = "Sahih al-Bukhari 211";

"discovery.card.sunnah_bukhari_212.title" = "صحيح البخاري 212";
"discovery.card.sunnah_bukhari_212.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكٌ، عَنْ هِشَامٍ، عَنْ أَبِيهِ، عَنْ عَائِشَةَ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ \"‏ إِذَا نَعَسَ أَحَدُكُمْ وَهُوَ يُصَلِّي فَلْيَرْقُدْ حَتَّى يَذْهَبَ عَنْهُ النَّوْمُ، فَإِنَّ أَحَدَكُمْ إِذَا صَلَّى وَهُوَ نَاعِسٌ لاَ يَدْرِي لَعَلَّهُ يَسْتَغْفِرُ فَيَسُبَّ نَفْسَهُ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_212.source" = "Sahih al-Bukhari 212";

"discovery.card.sunnah_bukhari_213.title" = "صحيح البخاري 213";
"discovery.card.sunnah_bukhari_213.meaning" = "حَدَّثَنَا أَبُو مَعْمَرٍ، قَالَ حَدَّثَنَا عَبْدُ الْوَارِثِ، حَدَّثَنَا أَيُّوبُ، عَنْ أَبِي قِلاَبَةَ، عَنْ أَنَسٍ، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ إِذَا نَعَسَ أَحَدُكُمْ فِي الصَّلاَةِ فَلْيَنَمْ حَتَّى يَعْلَمَ مَا يَقْرَأُ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_213.source" = "Sahih al-Bukhari 213";

"discovery.card.sunnah_bukhari_214.title" = "صحيح البخاري 214";
"discovery.card.sunnah_bukhari_214.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، قَالَ حَدَّثَنَا سُفْيَانُ، عَنْ عَمْرِو بْنِ عَامِرٍ، قَالَ سَمِعْتُ أَنَسًا، ح قَالَ وَحَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا يَحْيَى، عَنْ سُفْيَانَ، قَالَ حَدَّثَنِي عَمْرُو بْنُ عَامِرٍ، عَنْ أَنَسٍ، قَالَ كَانَ النَّبِيُّ صلى الله عليه وسلم يَتَوَضَّأُ عِنْدَ كُلِّ صَلاَةٍ‏.‏ قُلْتُ كَيْفَ كُنْتُمْ تَصْنَعُونَ قَالَ يُجْزِئُ أَحَدَنَا الْوُضُوءُ مَا لَمْ يُحْدِثْ‏.‏";
"discovery.card.sunnah_bukhari_214.source" = "Sahih al-Bukhari 214";

"discovery.card.sunnah_bukhari_217.title" = "صحيح البخاري 217";
"discovery.card.sunnah_bukhari_217.meaning" = "حَدَّثَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ، قَالَ حَدَّثَنَا إِسْمَاعِيلُ بْنُ إِبْرَاهِيمَ، قَالَ حَدَّثَنِي رَوْحُ بْنُ الْقَاسِمِ، قَالَ حَدَّثَنِي عَطَاءُ بْنُ أَبِي مَيْمُونَةَ، عَنْ أَنَسِ بْنِ مَالِكٍ، قَالَ كَانَ النَّبِيُّ صلى الله عليه وسلم إِذَا تَبَرَّزَ لِحَاجَتِهِ أَتَيْتُهُ بِمَاءٍ فَيَغْسِلُ بِهِ‏.‏";
"discovery.card.sunnah_bukhari_217.source" = "Sahih al-Bukhari 217";

"discovery.card.sunnah_bukhari_219.title" = "صحيح البخاري 219";
"discovery.card.sunnah_bukhari_219.meaning" = "حَدَّثَنَا مُوسَى بْنُ إِسْمَاعِيلَ، قَالَ حَدَّثَنَا هَمَّامٌ، أَخْبَرَنَا إِسْحَاقُ، عَنْ أَنَسِ بْنِ مَالِكٍ، أَنَّ النَّبِيَّ صلى الله عليه وسلم رَأَى أَعْرَابِيًّا يَبُولُ فِي الْمَسْجِدِ فَقَالَ ‏ \"‏ دَعُوهُ ‏\"‏‏.‏ حَتَّى إِذَا فَرَغَ دَعَا بِمَاءٍ فَصَبَّهُ عَلَيْهِ‏.‏";
"discovery.card.sunnah_bukhari_219.source" = "Sahih al-Bukhari 219";

"discovery.card.sunnah_bukhari_221.title" = "صحيح البخاري 221";
"discovery.card.sunnah_bukhari_221.meaning" = "حَدَّثَنَا عَبْدَانُ، قَالَ أَخْبَرَنَا عَبْدُ اللَّهِ، قَالَ أَخْبَرَنَا يَحْيَى بْنُ سَعِيدٍ، قَالَ سَمِعْتُ أَنَسَ بْنَ مَالِكٍ، عَنِ النَّبِيِّ صلى الله عليه وسلم‏.‏";
"discovery.card.sunnah_bukhari_221.source" = "Sahih al-Bukhari 221";

"discovery.card.sunnah_bukhari_222.title" = "صحيح البخاري 222";
"discovery.card.sunnah_bukhari_222.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكٌ، عَنْ هِشَامِ بْنِ عُرْوَةَ، عَنْ أَبِيهِ، عَنْ عَائِشَةَ أُمِّ الْمُؤْمِنِينَ، أَنَّهَا قَالَتْ أُتِيَ رَسُولُ اللَّهِ صلى الله عليه وسلم بِصَبِيٍّ، فَبَالَ عَلَى ثَوْبِهِ، فَدَعَا بِمَاءٍ فَأَتْبَعَهُ إِيَّاهُ‏.‏";
"discovery.card.sunnah_bukhari_222.source" = "Sahih al-Bukhari 222";

"discovery.card.sunnah_bukhari_224.title" = "صحيح البخاري 224";
"discovery.card.sunnah_bukhari_224.meaning" = "حَدَّثَنَا آدَمُ، قَالَ حَدَّثَنَا شُعْبَةُ، عَنِ الأَعْمَشِ، عَنْ أَبِي وَائِلٍ، عَنْ حُذَيْفَةَ، قَالَ أَتَى النَّبِيُّ صلى الله عليه وسلم سُبَاطَةَ قَوْمٍ فَبَالَ قَائِمًا، ثُمَّ دَعَا بِمَاءٍ، فَجِئْتُهُ بِمَاءٍ فَتَوَضَّأَ‏.‏";
"discovery.card.sunnah_bukhari_224.source" = "Sahih al-Bukhari 224";

"discovery.card.sunnah_bukhari_225.title" = "صحيح البخاري 225";
"discovery.card.sunnah_bukhari_225.meaning" = "حَدَّثَنَا عُثْمَانُ بْنُ أَبِي شَيْبَةَ، قَالَ حَدَّثَنَا جَرِيرٌ، عَنْ مَنْصُورٍ، عَنْ أَبِي وَائِلٍ، عَنْ حُذَيْفَةَ، قَالَ رَأَيْتُنِي أَنَا وَالنَّبِيُّ، صلى الله عليه وسلم نَتَمَاشَى، فَأَتَى سُبَاطَةَ قَوْمٍ خَلْفَ حَائِطٍ، فَقَامَ كَمَا يَقُومُ أَحَدُكُمْ فَبَالَ، فَانْتَبَذْتُ مِنْهُ، فَأَشَارَ إِلَىَّ فَجِئْتُهُ، فَقُمْتُ عِنْدَ عَقِبِهِ حَتَّى فَرَغَ‏.‏";
"discovery.card.sunnah_bukhari_225.source" = "Sahih al-Bukhari 225";

"discovery.card.sunnah_bukhari_229.title" = "صحيح البخاري 229";
"discovery.card.sunnah_bukhari_229.meaning" = "حَدَّثَنَا عَبْدَانُ، قَالَ أَخْبَرَنَا عَبْدُ اللَّهِ، قَالَ أَخْبَرَنَا عَمْرُو بْنُ مَيْمُونٍ الْجَزَرِيُّ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ، عَنْ عَائِشَةَ، قَالَتْ كُنْتُ أَغْسِلُ الْجَنَابَةَ مِنْ ثَوْبِ النَّبِيِّ صلى الله عليه وسلم، فَيَخْرُجُ إِلَى الصَّلاَةِ، وَإِنَّ بُقَعَ الْمَاءِ فِي ثَوْبِهِ‏.‏";
"discovery.card.sunnah_bukhari_229.source" = "Sahih al-Bukhari 229";

"discovery.card.sunnah_bukhari_230.title" = "صحيح البخاري 230";
"discovery.card.sunnah_bukhari_230.meaning" = "حَدَّثَنَا قُتَيْبَةُ، قَالَ حَدَّثَنَا يَزِيدُ، قَالَ حَدَّثَنَا عَمْرٌو، عَنْ سُلَيْمَانَ، قَالَ سَمِعْتُ عَائِشَةَ، ح وَحَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا عَبْدُ الْوَاحِدِ، قَالَ حَدَّثَنَا عَمْرُو بْنُ مَيْمُونٍ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ، قَالَ سَأَلْتُ عَائِشَةَ عَنِ الْمَنِيِّ، يُصِيبُ الثَّوْبَ فَقَالَتْ كُنْتُ أَغْسِلُهُ مِنْ ثَوْبِ رَسُولِ اللَّهِ صلى الله عليه وسلم، فَيَخْرُجُ إِلَى الصَّلاَةِ وَأَثَرُ الْغَسْلِ فِي ثَوْبِهِ بُقَعُ الْمَاءِ‏.‏";
"discovery.card.sunnah_bukhari_230.source" = "Sahih al-Bukhari 230";

"discovery.card.sunnah_bukhari_231.title" = "صحيح البخاري 231";
"discovery.card.sunnah_bukhari_231.meaning" = "حَدَّثَنَا مُوسَى، قَالَ حَدَّثَنَا عَبْدُ الْوَاحِدِ، قَالَ حَدَّثَنَا عَمْرُو بْنُ مَيْمُونٍ، قَالَ سَأَلْتُ سُلَيْمَانَ بْنَ يَسَارٍ فِي الثَّوْبِ تُصِيبُهُ الْجَنَابَةُ قَالَ قَالَتْ عَائِشَةُ كُنْتُ أَغْسِلُهُ مِنْ ثَوْبِ رَسُولِ اللَّهِ صلى الله عليه وسلم، ثُمَّ يَخْرُجُ إِلَى الصَّلاَةِ وَأَثَرُ الْغَسْلِ فِيهِ بُقَعُ الْمَاءِ‏.‏";
"discovery.card.sunnah_bukhari_231.source" = "Sahih al-Bukhari 231";

"discovery.card.sunnah_bukhari_232.title" = "صحيح البخاري 232";
"discovery.card.sunnah_bukhari_232.meaning" = "حَدَّثَنَا عَمْرُو بْنُ خَالِدٍ، قَالَ حَدَّثَنَا زُهَيْرٌ، قَالَ حَدَّثَنَا عَمْرُو بْنُ مَيْمُونِ بْنِ مِهْرَانَ، عَنْ سُلَيْمَانَ بْنِ يَسَارٍ، عَنْ عَائِشَةَ، أَنَّهَا كَانَتْ تَغْسِلُ الْمَنِيَّ مِنْ ثَوْبِ النَّبِيِّ صلى الله عليه وسلم، ثُمَّ أَرَاهُ فِيهِ بُقْعَةً أَوْ بُقَعًا‏.‏";
"discovery.card.sunnah_bukhari_232.source" = "Sahih al-Bukhari 232";

"discovery.card.sunnah_bukhari_234.title" = "صحيح البخاري 234";
"discovery.card.sunnah_bukhari_234.meaning" = "حَدَّثَنَا آدَمُ، قَالَ حَدَّثَنَا شُعْبَةُ، قَالَ أَخْبَرَنَا أَبُو التَّيَّاحِ، يَزِيدُ بْنُ حُمَيْدٍ عَنْ أَنَسٍ، قَالَ كَانَ النَّبِيُّ صلى الله عليه وسلم يُصَلِّي قَبْلَ أَنْ يُبْنَى الْمَسْجِدُ فِي مَرَابِضِ الْغَنَمِ‏.‏";
"discovery.card.sunnah_bukhari_234.source" = "Sahih al-Bukhari 234";

"discovery.card.sunnah_bukhari_235.title" = "صحيح البخاري 235";
"discovery.card.sunnah_bukhari_235.meaning" = "حَدَّثَنَا إِسْمَاعِيلُ، قَالَ حَدَّثَنِي مَالِكٌ، عَنِ ابْنِ شِهَابٍ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ، عَنِ ابْنِ عَبَّاسٍ، عَنْ مَيْمُونَةَ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم سُئِلَ عَنْ فَأْرَةٍ سَقَطَتْ فِي سَمْنٍ فَقَالَ ‏ \"‏ أَلْقُوهَا وَمَا حَوْلَهَا فَاطْرَحُوهُ‏.‏ وَكُلُوا سَمْنَكُمْ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_235.source" = "Sahih al-Bukhari 235";

"discovery.card.sunnah_bukhari_236.title" = "صحيح البخاري 236";
"discovery.card.sunnah_bukhari_236.meaning" = "حَدَّثَنَا عَلِيُّ بْنُ عَبْدِ اللَّهِ، قَالَ حَدَّثَنَا مَعْنٌ، قَالَ حَدَّثَنَا مَالِكٌ، عَنِ ابْنِ شِهَابٍ، عَنْ عُبَيْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ عُتْبَةَ بْنِ مَسْعُودٍ، عَنِ ابْنِ عَبَّاسٍ، عَنْ مَيْمُونَةَ، أَنَّ النَّبِيَّ صلى الله عليه وسلم سُئِلَ عَنْ فَأْرَةٍ سَقَطَتْ فِي سَمْنٍ فَقَالَ ‏ \"‏ خُذُوهَا وَمَا حَوْلَهَا فَاطْرَحُوهُ ‏\"‏‏.‏ قَالَ مَعْنٌ حَدَّثَنَا مَالِكٌ مَا لاَ أُحْصِيهِ يَقُولُ عَنِ ابْنِ عَبَّاسٍ عَنْ مَيْمُونَةَ‏.‏";
"discovery.card.sunnah_bukhari_236.source" = "Sahih al-Bukhari 236";

"discovery.card.sunnah_bukhari_237.title" = "صحيح البخاري 237";
"discovery.card.sunnah_bukhari_237.meaning" = "حَدَّثَنَا أَحْمَدُ بْنُ مُحَمَّدٍ، قَالَ أَخْبَرَنَا عَبْدُ اللَّهِ، قَالَ أَخْبَرَنَا مَعْمَرٌ، عَنْ هَمَّامِ بْنِ مُنَبِّهٍ، عَنْ أَبِي هُرَيْرَةَ، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ كُلُّ كَلْمٍ يُكْلَمُهُ الْمُسْلِمُ فِي سَبِيلِ اللَّهِ يَكُونُ يَوْمَ الْقِيَامَةِ كَهَيْئَتِهَا إِذْ طُعِنَتْ، تَفَجَّرُ دَمًا، اللَّوْنُ لَوْنُ الدَّمِ، وَالْعَرْفُ عَرْفُ الْمِسْكِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_237.source" = "Sahih al-Bukhari 237";

"discovery.card.sunnah_bukhari_238.title" = "صحيح البخاري 238";
"discovery.card.sunnah_bukhari_238.meaning" = "حَدَّثَنَا أَبُو الْيَمَانِ، قَالَ أَخْبَرَنَا شُعَيْبٌ، قَالَ أَخْبَرَنَا أَبُو الزِّنَادِ، أَنَّ عَبْدَ الرَّحْمَنِ بْنَ هُرْمُزَ الأَعْرَجَ، حَدَّثَهُ أَنَّهُ، سَمِعَ أَبَا هُرَيْرَةَ، أَنَّهُ سَمِعَ رَسُولَ اللَّهِ صلى الله عليه وسلم يَقُولُ ‏ \"‏ نَحْنُ الآخِرُونَ السَّابِقُونَ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_238.source" = "Sahih al-Bukhari 238";

"discovery.card.sunnah_bukhari_239.title" = "صحيح البخاري 239";
"discovery.card.sunnah_bukhari_239.meaning" = "وَبِإِسْنَادِهِ قَالَ ‏ \"‏ لاَ يَبُولَنَّ أَحَدُكُمْ فِي الْمَاءِ الدَّائِمِ الَّذِي لاَ يَجْرِي، ثُمَّ يَغْتَسِلُ فِيهِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_239.source" = "Sahih al-Bukhari 239";

"discovery.card.sunnah_bukhari_241.title" = "صحيح البخاري 241";
"discovery.card.sunnah_bukhari_241.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ يُوسُفَ، قَالَ حَدَّثَنَا سُفْيَانُ، عَنْ حُمَيْدٍ، عَنْ أَنَسٍ، قَالَ بَزَقَ النَّبِيُّ صلى الله عليه وسلم فِي ثَوْبِهِ‏.‏ طَوَّلَهُ ابْنُ أَبِي مَرْيَمَ قَالَ أَخْبَرَنَا يَحْيَى بْنُ أَيُّوبَ حَدَّثَنِي حُمَيْدٌ قَالَ سَمِعْتُ أَنَسًا عَنِ النَّبِيِّ صلى الله عليه وسلم‏.‏";
"discovery.card.sunnah_bukhari_241.source" = "Sahih al-Bukhari 241";

"discovery.card.sunnah_bukhari_242.title" = "صحيح البخاري 242";
"discovery.card.sunnah_bukhari_242.meaning" = "حَدَّثَنَا عَلِيُّ بْنُ عَبْدِ اللَّهِ، قَالَ حَدَّثَنَا سُفْيَانُ، قَالَ حَدَّثَنَا الزُّهْرِيُّ، عَنْ أَبِي سَلَمَةَ، عَنْ عَائِشَةَ، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ كُلُّ شَرَابٍ أَسْكَرَ فَهُوَ حَرَامٌ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_242.source" = "Sahih al-Bukhari 242";

"discovery.card.sunnah_bukhari_250.title" = "صحيح البخاري 250";
"discovery.card.sunnah_bukhari_250.meaning" = "حَدَّثَنَا آدَمُ بْنُ أَبِي إِيَاسٍ، قَالَ حَدَّثَنَا ابْنُ أَبِي ذِئْبٍ، عَنِ الزُّهْرِيِّ، عَنْ عُرْوَةَ، عَنْ عَائِشَةَ، قَالَتْ كُنْتُ أَغْتَسِلُ أَنَا وَالنَّبِيُّ، صلى الله عليه وسلم مِنْ إِنَاءٍ وَاحِدٍ مِنْ قَدَحٍ يُقَالُ لَهُ الْفَرَقُ‏.‏";
"discovery.card.sunnah_bukhari_250.source" = "Sahih al-Bukhari 250";

"discovery.card.sunnah_bukhari_251.title" = "صحيح البخاري 251";
"discovery.card.sunnah_bukhari_251.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مُحَمَّدٍ، قَالَ حَدَّثَنِي عَبْدُ الصَّمَدِ، قَالَ حَدَّثَنِي شُعْبَةُ، قَالَ حَدَّثَنِي أَبُو بَكْرِ بْنُ حَفْصٍ، قَالَ سَمِعْتُ أَبَا سَلَمَةَ، يَقُولُ دَخَلْتُ أَنَا وَأَخُو، عَائِشَةَ عَلَى عَائِشَةَ فَسَأَلَهَا أَخُوهَا عَنْ غُسْلِ النَّبِيِّ، صلى الله عليه وسلم فَدَعَتْ بِإِنَاءٍ نَحْوًا مِنْ صَاعٍ، فَاغْتَسَلَتْ وَأَفَاضَتْ عَلَى رَأْسِهَا، وَبَيْنَنَا وَبَيْنَهَا حِجَابٌ‏.‏ قَالَ أَبُو عَبْدِ اللَّهِ قَالَ يَزِيدُ بْنُ هَارُونَ وَبَهْزٌ وَالْجُدِّيُّ عَنْ شُعْبَةَ قَدْرِ صَاعٍ‏.‏";
"discovery.card.sunnah_bukhari_251.source" = "Sahih al-Bukhari 251";

"discovery.card.sunnah_bukhari_253.title" = "صحيح البخاري 253";
"discovery.card.sunnah_bukhari_253.meaning" = "حَدَّثَنَا أَبُو نُعَيْمٍ، قَالَ حَدَّثَنَا ابْنُ عُيَيْنَةَ، عَنْ عَمْرٍو، عَنْ جَابِرِ بْنِ زَيْدٍ، عَنِ ابْنِ عَبَّاسٍ، أَنَّ النَّبِيَّ صلى الله عليه وسلم وَمَيْمُونَةَ كَانَا يَغْتَسِلاَنِ مِنْ إِنَاءٍ وَاحِدٍ‏.‏ قَالَ أَبُو عَبْدِ اللَّهِ كَانَ ابْنُ عُيَيْنَةَ يَقُولُ أَخِيرًا عَنِ ابْنِ عَبَّاسٍ عَنْ مَيْمُونَةَ، وَالصَّحِيحُ مَا رَوَى أَبُو نُعَيْمٍ‏.‏";
"discovery.card.sunnah_bukhari_253.source" = "Sahih al-Bukhari 253";

"discovery.card.sunnah_bukhari_254.title" = "صحيح البخاري 254";
"discovery.card.sunnah_bukhari_254.meaning" = "حَدَّثَنَا أَبُو نُعَيْمٍ، قَالَ حَدَّثَنَا زُهَيْرٌ، عَنْ أَبِي إِسْحَاقَ، قَالَ حَدَّثَنِي سُلَيْمَانُ بْنُ صُرَدٍ، قَالَ حَدَّثَنِي جُبَيْرُ بْنُ مُطْعِمٍ، قَالَ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ أَمَّا أَنَا فَأُفِيضُ عَلَى رَأْسِي ثَلاَثًا ‏\"‏‏.‏ وَأَشَارَ بِيَدَيْهِ كِلْتَيْهِمَا‏.‏";
"discovery.card.sunnah_bukhari_254.source" = "Sahih al-Bukhari 254";

"discovery.card.sunnah_bukhari_255.title" = "صحيح البخاري 255";
"discovery.card.sunnah_bukhari_255.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ بَشَّارٍ، قَالَ حَدَّثَنَا غُنْدَرٌ، قَالَ حَدَّثَنَا شُعْبَةُ، عَنْ مِخْوَلِ بْنِ رَاشِدٍ، عَنْ مُحَمَّدِ بْنِ عَلِيٍّ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ، قَالَ كَانَ النَّبِيُّ صلى الله عليه وسلم يُفْرِغُ عَلَى رَأْسِهِ ثَلاَثًا‏.‏";
"discovery.card.sunnah_bukhari_255.source" = "Sahih al-Bukhari 255";

"discovery.card.sunnah_bukhari_261.title" = "صحيح البخاري 261";
"discovery.card.sunnah_bukhari_261.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ، أَخْبَرَنَا أَفْلَحُ، عَنِ الْقَاسِمِ، عَنْ عَائِشَةَ، قَالَتْ كُنْتُ أَغْتَسِلُ أَنَا وَالنَّبِيُّ، صلى الله عليه وسلم مِنْ إِنَاءٍ وَاحِدٍ تَخْتَلِفُ أَيْدِينَا فِيهِ‏.‏";
"discovery.card.sunnah_bukhari_261.source" = "Sahih al-Bukhari 261";

"discovery.card.sunnah_bukhari_262.title" = "صحيح البخاري 262";
"discovery.card.sunnah_bukhari_262.meaning" = "حَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا حَمَّادٌ، عَنْ هِشَامٍ، عَنْ أَبِيهِ، عَنْ عَائِشَةَ، قَالَتْ كَانَ رَسُولُ اللَّهِ صلى الله عليه وسلم إِذَا اغْتَسَلَ مِنَ الْجَنَابَةِ غَسَلَ يَدَهُ‏.‏";
"discovery.card.sunnah_bukhari_262.source" = "Sahih al-Bukhari 262";

"discovery.card.sunnah_bukhari_263.title" = "صحيح البخاري 263";
"discovery.card.sunnah_bukhari_263.meaning" = "حَدَّثَنَا أَبُو الْوَلِيدِ، قَالَ حَدَّثَنَا شُعْبَةُ، عَنْ أَبِي بَكْرِ بْنِ حَفْصٍ، عَنْ عُرْوَةَ، عَنْ عَائِشَةَ، قَالَتْ كُنْتُ أَغْتَسِلُ أَنَا وَالنَّبِيُّ، صلى الله عليه وسلم مِنْ إِنَاءٍ وَاحِدٍ مِنْ جَنَابَةٍ‏.‏ وَعَنْ عَبْدِ الرَّحْمَنِ بْنِ الْقَاسِمِ عَنْ أَبِيهِ عَنْ عَائِشَةَ مِثْلَهُ‏.‏";
"discovery.card.sunnah_bukhari_263.source" = "Sahih al-Bukhari 263";

"discovery.card.sunnah_bukhari_264.title" = "صحيح البخاري 264";
"discovery.card.sunnah_bukhari_264.meaning" = "حَدَّثَنَا أَبُو الْوَلِيدِ، قَالَ حَدَّثَنَا شُعْبَةُ، عَنْ عَبْدِ اللَّهِ بْنِ عَبْدِ اللَّهِ بْنِ جَبْرٍ، قَالَ سَمِعْتُ أَنَسَ بْنَ مَالِكٍ، يَقُولُ كَانَ النَّبِيُّ صلى الله عليه وسلم وَالْمَرْأَةُ مِنْ نِسَائِهِ يَغْتَسِلاَنِ مِنْ إِنَاءٍ وَاحِدٍ‏.‏ زَادَ مُسْلِمٌ وَوَهْبٌ عَنْ شُعْبَةَ مِنَ الْجَنَابَةِ‏.‏";
"discovery.card.sunnah_bukhari_264.source" = "Sahih al-Bukhari 264";

"discovery.card.sunnah_bukhari_269.title" = "صحيح البخاري 269";
"discovery.card.sunnah_bukhari_269.meaning" = "حَدَّثَنَا أَبُو الْوَلِيدِ، قَالَ حَدَّثَنَا زَائِدَةُ، عَنْ أَبِي حَصِينٍ، عَنْ أَبِي عَبْدِ الرَّحْمَنِ، عَنْ عَلِيٍّ، قَالَ كُنْتُ رَجُلاً مَذَّاءً فَأَمَرْتُ رَجُلاً أَنْ يَسْأَلَ النَّبِيَّ صلى الله عليه وسلم لِمَكَانِ ابْنَتِهِ فَسَأَلَ فَقَالَ ‏ \"‏ تَوَضَّأْ وَاغْسِلْ ذَكَرَكَ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_269.source" = "Sahih al-Bukhari 269";

"discovery.card.sunnah_bukhari_271.title" = "صحيح البخاري 271";
"discovery.card.sunnah_bukhari_271.meaning" = "حَدَّثَنَا آدَمُ، قَالَ حَدَّثَنَا شُعْبَةُ، قَالَ حَدَّثَنَا الْحَكَمُ، عَنْ إِبْرَاهِيمَ، عَنِ الأَسْوَدِ، عَنْ عَائِشَةَ، قَالَتْ كَأَنِّي أَنْظُرُ إِلَى وَبِيصِ الطِّيبِ فِي مَفْرِقِ النَّبِيِّ صلى الله عليه وسلم وَهْوَ مُحْرِمٌ‏.‏";
"discovery.card.sunnah_bukhari_271.source" = "Sahih al-Bukhari 271";

"discovery.card.sunnah_bukhari_277.title" = "صحيح البخاري 277";
"discovery.card.sunnah_bukhari_277.meaning" = "حَدَّثَنَا خَلاَّدُ بْنُ يَحْيَى، قَالَ حَدَّثَنَا إِبْرَاهِيمُ بْنُ نَافِعٍ، عَنِ الْحَسَنِ بْنِ مُسْلِمٍ، عَنْ صَفِيَّةَ بِنْتِ شَيْبَةَ، عَنْ عَائِشَةَ، قَالَتْ كُنَّا إِذَا أَصَابَتْ إِحْدَانَا جَنَابَةٌ، أَخَذَتْ بِيَدَيْهَا ثَلاَثًا فَوْقَ رَأْسِهَا، ثُمَّ تَأْخُذُ بِيَدِهَا عَلَى شِقِّهَا الأَيْمَنِ، وَبِيَدِهَا الأُخْرَى عَلَى شِقِّهَا الأَيْسَرِ‏.‏";
"discovery.card.sunnah_bukhari_277.source" = "Sahih al-Bukhari 277";

"discovery.card.sunnah_bukhari_280.title" = "صحيح البخاري 280";
"discovery.card.sunnah_bukhari_280.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ، عَنْ مَالِكٍ، عَنْ أَبِي النَّضْرِ، مَوْلَى عُمَرَ بْنِ عُبَيْدِ اللَّهِ أَنَّ أَبَا مُرَّةَ، مَوْلَى أُمِّ هَانِئٍ بِنْتِ أَبِي طَالِبٍ أَخْبَرَهُ أَنَّهُ، سَمِعَ أُمَّ هَانِئٍ بِنْتَ أَبِي طَالِبٍ، تَقُولُ ذَهَبْتُ إِلَى رَسُولِ اللَّهِ صلى الله عليه وسلم عَامَ الْفَتْحِ، فَوَجَدْتُهُ يَغْتَسِلُ وَفَاطِمَةُ تَسْتُرُهُ فَقَالَ ‏ \"‏ مَنْ هَذِهِ ‏\"‏‏.‏ فَقُلْتُ أَنَا أُمُّ هَانِئٍ‏.‏";
"discovery.card.sunnah_bukhari_280.source" = "Sahih al-Bukhari 280";

"discovery.card.sunnah_bukhari_284.title" = "صحيح البخاري 284";
"discovery.card.sunnah_bukhari_284.meaning" = "حَدَّثَنَا عَبْدُ الأَعْلَى بْنُ حَمَّادٍ، قَالَ حَدَّثَنَا يَزِيدُ بْنُ زُرَيْعٍ، قَالَ حَدَّثَنَا سَعِيدٌ، عَنْ قَتَادَةَ، أَنَّ أَنَسَ بْنَ مَالِكٍ، حَدَّثَهُمْ أَنَّ نَبِيَّ اللَّهِ صلى الله عليه وسلم كَانَ يَطُوفُ عَلَى نِسَائِهِ فِي اللَّيْلَةِ الْوَاحِدَةِ، وَلَهُ يَوْمَئِذٍ تِسْعُ نِسْوَةٍ‏.‏";
"discovery.card.sunnah_bukhari_284.source" = "Sahih al-Bukhari 284";

"discovery.card.sunnah_bukhari_286.title" = "صحيح البخاري 286";
"discovery.card.sunnah_bukhari_286.meaning" = "حَدَّثَنَا أَبُو نُعَيْمٍ، قَالَ حَدَّثَنَا هِشَامٌ، وَشَيْبَانُ، عَنْ يَحْيَى، عَنْ أَبِي سَلَمَةَ، قَالَ سَأَلْتُ عَائِشَةَ أَكَانَ النَّبِيُّ صلى الله عليه وسلم يَرْقُدُ وَهْوَ جُنُبٌ قَالَتْ نَعَمْ وَيَتَوَضَّأُ‏.‏";
"discovery.card.sunnah_bukhari_286.source" = "Sahih al-Bukhari 286";

"discovery.card.sunnah_bukhari_287.title" = "صحيح البخاري 287";
"discovery.card.sunnah_bukhari_287.meaning" = "حَدَّثَنَا قُتَيْبَةُ، قَالَ حَدَّثَنَا اللَّيْثُ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، أَنَّ عُمَرَ بْنَ الْخَطَّابِ، سَأَلَ رَسُولَ اللَّهِ صلى الله عليه وسلم أَيَرْقُدُ أَحَدُنَا وَهْوَ جُنُبٌ قَالَ ‏ \"‏ نَعَمْ إِذَا تَوَضَّأَ أَحَدُكُمْ فَلْيَرْقُدْ وَهُوَ جُنُبٌ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_287.source" = "Sahih al-Bukhari 287";

"discovery.card.sunnah_bukhari_288.title" = "صحيح البخاري 288";
"discovery.card.sunnah_bukhari_288.meaning" = "حَدَّثَنَا يَحْيَى بْنُ بُكَيْرٍ، قَالَ حَدَّثَنَا اللَّيْثُ، عَنْ عُبَيْدِ اللَّهِ بْنِ أَبِي جَعْفَرٍ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ، عَنْ عُرْوَةَ، عَنْ عَائِشَةَ، قَالَتْ كَانَ النَّبِيُّ صلى الله عليه وسلم إِذَا أَرَادَ أَنْ يَنَامَ وَهْوَ جُنُبٌ، غَسَلَ فَرْجَهُ، وَتَوَضَّأَ لِلصَّلاَةِ‏.‏";
"discovery.card.sunnah_bukhari_288.source" = "Sahih al-Bukhari 288";

"discovery.card.sunnah_bukhari_289.title" = "صحيح البخاري 289";
"discovery.card.sunnah_bukhari_289.meaning" = "حَدَّثَنَا مُوسَى بْنُ إِسْمَاعِيلَ، قَالَ حَدَّثَنَا جُوَيْرِيَةُ، عَنْ نَافِعٍ، عَنْ عَبْدِ اللَّهِ، قَالَ اسْتَفْتَى عُمَرُ النَّبِيَّ صلى الله عليه وسلم أَيَنَامُ أَحَدُنَا وَهْوَ جُنُبٌ قَالَ ‏ \"‏ نَعَمْ، إِذَا تَوَضَّأَ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_289.source" = "Sahih al-Bukhari 289";

"discovery.card.sunnah_bukhari_290.title" = "صحيح البخاري 290";
"discovery.card.sunnah_bukhari_290.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكٌ، عَنْ عَبْدِ اللَّهِ بْنِ دِينَارٍ، عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ، أَنَّهُ قَالَ ذَكَرَ عُمَرُ بْنُ الْخَطَّابِ لِرَسُولِ اللَّهِ صلى الله عليه وسلم أَنَّهُ تُصِيبُهُ الْجَنَابَةُ مِنَ اللَّيْلِ، فَقَالَ لَهُ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ تَوَضَّأْ وَاغْسِلْ ذَكَرَكَ ثُمَّ نَمْ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_290.source" = "Sahih al-Bukhari 290";

"discovery.card.sunnah_bukhari_291.title" = "صحيح البخاري 291";
"discovery.card.sunnah_bukhari_291.meaning" = "حَدَّثَنَا مُعَاذُ بْنُ فَضَالَةَ، قَالَ حَدَّثَنَا هِشَامٌ، ح وَحَدَّثَنَا أَبُو نُعَيْمٍ، عَنْ هِشَامٍ، عَنْ قَتَادَةَ، عَنِ الْحَسَنِ، عَنْ أَبِي رَافِعٍ، عَنْ أَبِي هُرَيْرَةَ، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ إِذَا جَلَسَ بَيْنَ شُعَبِهَا الأَرْبَعِ ثُمَّ جَهَدَهَا، فَقَدْ وَجَبَ الْغَسْلُ ‏\"‏‏.‏ تَابَعَهُ عَمْرُو بْنُ مَرْزُوقٍ عَنْ شُعْبَةَ مِثْلَهُ‏.‏ وَقَالَ مُوسَى حَدَّثَنَا أَبَانُ قَالَ حَدَّثَنَا قَتَادَةُ أَخْبَرَنَا الْحَسَنُ مِثْلَهُ‏.‏";
"discovery.card.sunnah_bukhari_291.source" = "Sahih al-Bukhari 291";

"discovery.card.sunnah_bukhari_295.title" = "صحيح البخاري 295";
"discovery.card.sunnah_bukhari_295.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ حَدَّثَنَا مَالِكٌ، عَنْ هِشَامِ بْنِ عُرْوَةَ، عَنْ أَبِيهِ، عَنْ عَائِشَةَ، قَالَتْ كُنْتُ أُرَجِّلُ رَأْسَ رَسُولِ اللَّهِ صلى الله عليه وسلم وَأَنَا حَائِضٌ‏.‏";
"discovery.card.sunnah_bukhari_295.source" = "Sahih al-Bukhari 295";

"discovery.card.sunnah_bukhari_297.title" = "صحيح البخاري 297";
"discovery.card.sunnah_bukhari_297.meaning" = "حَدَّثَنَا أَبُو نُعَيْمٍ الْفَضْلُ بْنُ دُكَيْنٍ، سَمِعَ زُهَيْرًا، عَنْ مَنْصُورٍ ابْنِ صَفِيَّةَ، أَنَّ أُمَّهُ، حَدَّثَتْهُ أَنَّ عَائِشَةَ حَدَّثَتْهَا أَنَّ النَّبِيَّ صلى الله عليه وسلم كَانَ يَتَّكِئُ فِي حَجْرِي وَأَنَا حَائِضٌ، ثُمَّ يَقْرَأُ الْقُرْآنَ‏.‏";
"discovery.card.sunnah_bukhari_297.source" = "Sahih al-Bukhari 297";

"discovery.card.sunnah_bukhari_298.title" = "صحيح البخاري 298";
"discovery.card.sunnah_bukhari_298.meaning" = "حَدَّثَنَا الْمَكِّيُّ بْنُ إِبْرَاهِيمَ، قَالَ حَدَّثَنَا هِشَامٌ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ، عَنْ أَبِي سَلَمَةَ، أَنَّ زَيْنَبَ ابْنَةَ أُمِّ سَلَمَةَ، حَدَّثَتْهُ أَنَّ أُمَّ سَلَمَةَ حَدَّثَتْهَا قَالَتْ، بَيْنَا أَنَا مَعَ النَّبِيِّ، صلى الله عليه وسلم مُضْطَجِعَةً فِي خَمِيصَةٍ إِذْ حِضْتُ، فَانْسَلَلْتُ فَأَخَذْتُ ثِيَابَ حِيضَتِي قَالَ ‏ \"‏ أَنُفِسْتِ ‏\"‏‏.‏ قُلْتُ نَعَمْ‏.‏ فَدَعَانِي فَاضْطَجَعْتُ مَعَهُ فِي الْخَمِيلَةِ‏.‏";
"discovery.card.sunnah_bukhari_298.source" = "Sahih al-Bukhari 298";

"discovery.card.sunnah_bukhari_303.title" = "صحيح البخاري 303";
"discovery.card.sunnah_bukhari_303.meaning" = "حَدَّثَنَا أَبُو النُّعْمَانِ، قَالَ حَدَّثَنَا عَبْدُ الْوَاحِدِ، قَالَ حَدَّثَنَا الشَّيْبَانِيُّ، قَالَ حَدَّثَنَا عَبْدُ اللَّهِ بْنُ شَدَّادٍ، قَالَ سَمِعْتُ مَيْمُونَةَ، كَانَ رَسُولُ اللَّهِ صلى الله عليه وسلم إِذَا أَرَادَ أَنْ يُبَاشِرَ امْرَأَةً مِنْ نِسَائِهِ أَمَرَهَا فَاتَّزَرَتْ وَهْىَ حَائِضٌ‏.‏ وَرَوَاهُ سُفْيَانُ عَنِ الشَّيْبَانِيِّ‏.‏";
"discovery.card.sunnah_bukhari_303.source" = "Sahih al-Bukhari 303";

"discovery.card.sunnah_bukhari_310.title" = "صحيح البخاري 310";
"discovery.card.sunnah_bukhari_310.meaning" = "حَدَّثَنَا قُتَيْبَةُ، قَالَ حَدَّثَنَا يَزِيدُ بْنُ زُرَيْعٍ، عَنْ خَالِدٍ، عَنْ عِكْرِمَةَ، عَنْ عَائِشَةَ، قَالَتِ اعْتَكَفَتْ مَعَ رَسُولِ اللَّهِ صلى الله عليه وسلم امْرَأَةٌ مِنْ أَزْوَاجِهِ، فَكَانَتْ تَرَى الدَّمَ وَالصُّفْرَةَ، وَالطَّسْتُ تَحْتَهَا وَهْىَ تُصَلِّي‏.‏";
"discovery.card.sunnah_bukhari_310.source" = "Sahih al-Bukhari 310";

"discovery.card.sunnah_bukhari_311.title" = "صحيح البخاري 311";
"discovery.card.sunnah_bukhari_311.meaning" = "حَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا مُعْتَمِرٌ، عَنْ خَالِدٍ، عَنْ عِكْرِمَةَ، عَنْ عَائِشَةَ، أَنَّ بَعْضَ، أُمَّهَاتِ الْمُؤْمِنِينَ اعْتَكَفَتْ وَهْىَ مُسْتَحَاضَةٌ‏.‏";
"discovery.card.sunnah_bukhari_311.source" = "Sahih al-Bukhari 311";

"discovery.card.sunnah_bukhari_312.title" = "صحيح البخاري 312";
"discovery.card.sunnah_bukhari_312.meaning" = "حَدَّثَنَا أَبُو نُعَيْمٍ، قَالَ حَدَّثَنَا إِبْرَاهِيمُ بْنُ نَافِعٍ، عَنِ ابْنِ أَبِي نَجِيحٍ، عَنْ مُجَاهِدٍ، قَالَ قَالَتْ عَائِشَةُ مَا كَانَ لإِحْدَانَا إِلاَّ ثَوْبٌ وَاحِدٌ تَحِيضُ فِيهِ، فَإِذَا أَصَابَهُ شَىْءٌ مِنْ دَمٍ، قَالَتْ بِرِيقِهَا فَقَصَعَتْهُ بِظُفْرِهَا‏.‏";
"discovery.card.sunnah_bukhari_312.source" = "Sahih al-Bukhari 312";

"discovery.card.sunnah_bukhari_323.title" = "صحيح البخاري 323";
"discovery.card.sunnah_bukhari_323.meaning" = "حَدَّثَنَا مُعَاذُ بْنُ فَضَالَةَ، قَالَ حَدَّثَنَا هِشَامٌ، عَنْ يَحْيَى، عَنْ أَبِي سَلَمَةَ، عَنْ زَيْنَبَ ابْنَةِ أَبِي سَلَمَةَ، عَنْ أُمِّ سَلَمَةَ، قَالَتْ بَيْنَا أَنَا مَعَ النَّبِيِّ، صلى الله عليه وسلم مُضْطَجِعَةً فِي خَمِيلَةٍ حِضْتُ، فَانْسَلَلْتُ فَأَخَذْتُ ثِيَابَ حِيضَتِي فَقَالَ ‏ \"‏ أَنُفِسْتِ ‏\"‏‏.‏ فَقُلْتُ نَعَمْ‏.‏ فَدَعَانِي فَاضْطَجَعْتُ مَعَهُ فِي الْخَمِيلَةِ‏.‏";
"discovery.card.sunnah_bukhari_323.source" = "Sahih al-Bukhari 323";

"discovery.card.sunnah_bukhari_326.title" = "صحيح البخاري 326";
"discovery.card.sunnah_bukhari_326.meaning" = "حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ، قَالَ حَدَّثَنَا إِسْمَاعِيلُ، عَنْ أَيُّوبَ، عَنْ مُحَمَّدٍ، عَنْ أُمِّ عَطِيَّةَ، قَالَتْ كُنَّا لاَ نَعُدُّ الْكُدْرَةَ وَالصُّفْرَةَ شَيْئًا‏.‏";
"discovery.card.sunnah_bukhari_326.source" = "Sahih al-Bukhari 326";

"discovery.card.sunnah_bukhari_328.title" = "صحيح البخاري 328";
"discovery.card.sunnah_bukhari_328.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، أَخْبَرَنَا مَالِكٌ، عَنْ عَبْدِ اللَّهِ بْنِ أَبِي بَكْرِ بْنِ مُحَمَّدِ بْنِ عَمْرِو بْنِ حَزْمٍ، عَنْ أَبِيهِ، عَنْ عَمْرَةَ بِنْتِ عَبْدِ الرَّحْمَنِ، عَنْ عَائِشَةَ، زَوْجِ النَّبِيِّ صلى الله عليه وسلم أَنَّهَا قَالَتْ لِرَسُولِ اللَّهِ صلى الله عليه وسلم يَا رَسُولَ اللَّهِ، إِنَّ صَفِيَّةَ بِنْتَ حُيَىٍّ قَدْ حَاضَتْ‏.‏ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏\"‏ لَعَلَّهَا تَحْبِسُنَا، أَلَمْ تَكُنْ طَافَتْ مَعَكُنَّ ‏\"‏‏.‏ فَقَالُوا بَلَى‏.‏ قَالَ ‏\"‏ فَاخْرُجِي ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_328.source" = "Sahih al-Bukhari 328";

"discovery.card.sunnah_bukhari_331.title" = "صحيح البخاري 331";
"discovery.card.sunnah_bukhari_331.meaning" = "حَدَّثَنَا أَحْمَدُ بْنُ يُونُسَ، عَنْ زُهَيْرٍ، قَالَ حَدَّثَنَا هِشَامٌ، عَنْ عُرْوَةَ، عَنْ عَائِشَةَ، قَالَتْ قَالَ النَّبِيُّ صلى الله عليه وسلم ‏ \"‏ إِذَا أَقْبَلَتِ الْحَيْضَةُ فَدَعِي الصَّلاَةَ، وَإِذَا أَدْبَرَتْ فَاغْسِلِي عَنْكِ الدَّمَ وَصَلِّي ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_331.source" = "Sahih al-Bukhari 331";

"discovery.card.sunnah_bukhari_332.title" = "صحيح البخاري 332";
"discovery.card.sunnah_bukhari_332.meaning" = "حَدَّثَنَا أَحْمَدُ بْنُ أَبِي سُرَيْجٍ، قَالَ أَخْبَرَنَا شَبَابَةُ، قَالَ أَخْبَرَنَا شُعْبَةُ، عَنْ حُسَيْنٍ الْمُعَلِّمِ، عَنِ ابْنِ بُرَيْدَةَ، عَنْ سَمُرَةَ بْنِ جُنْدُبٍ، أَنَّ امْرَأَةً، مَاتَتْ فِي بَطْنٍ، فَصَلَّى عَلَيْهَا النَّبِيُّ صلى الله عليه وسلم فَقَامَ وَسَطَهَا‏.‏";
"discovery.card.sunnah_bukhari_332.source" = "Sahih al-Bukhari 332";

"discovery.card.sunnah_bukhari_333.title" = "صحيح البخاري 333";
"discovery.card.sunnah_bukhari_333.meaning" = "حَدَّثَنَا الْحَسَنُ بْنُ مُدْرِكٍ، قَالَ حَدَّثَنَا يَحْيَى بْنُ حَمَّادٍ، قَالَ أَخْبَرَنَا أَبُو عَوَانَةَ ـ اسْمُهُ الْوَضَّاحُ ـ مِنْ كِتَابِهِ قَالَ أَخْبَرَنَا سُلَيْمَانُ الشَّيْبَانِيُّ، عَنْ عَبْدِ اللَّهِ بْنِ شَدَّادٍ، قَالَ سَمِعْتُ خَالَتِي، مَيْمُونَةَ ـ زَوْجَ النَّبِيِّ صلى الله عليه وسلم أَنَّهَا كَانَتْ تَكُونُ حَائِضًا لاَ تُصَلِّي، وَهْىَ مُفْتَرِشَةٌ بِحِذَاءِ مَسْجِدِ رَسُولِ اللَّهِ صلى الله عليه وسلم وَهْوَ يُصَلِّي عَلَى خُمْرَتِهِ، إِذَا سَجَدَ أَصَابَنِي بَعْضُ ثَوْبِهِ‏.‏";
"discovery.card.sunnah_bukhari_333.source" = "Sahih al-Bukhari 333";

"discovery.card.sunnah_bukhari_340.title" = "صحيح البخاري 340";
"discovery.card.sunnah_bukhari_340.meaning" = "حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، قَالَ حَدَّثَنَا شُعْبَةُ، عَنِ الْحَكَمِ، عَنْ ذَرٍّ، عَنِ ابْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَى، عَنْ أَبِيهِ، أَنَّهُ شَهِدَ عُمَرَ وَقَالَ لَهُ عَمَّارٌ كُنَّا فِي سَرِيَّةٍ فَأَجْنَبْنَا، وَقَالَ تَفَلَ فِيهِمَا‏.‏";
"discovery.card.sunnah_bukhari_340.source" = "Sahih al-Bukhari 340";

"discovery.card.sunnah_bukhari_341.title" = "صحيح البخاري 341";
"discovery.card.sunnah_bukhari_341.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ كَثِيرٍ، أَخْبَرَنَا شُعْبَةُ، عَنِ الْحَكَمِ، عَنْ ذَرٍّ، عَنِ ابْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَى، عَنْ عَبْدِ الرَّحْمَنِ، قَالَ قَالَ عَمَّارٌ لِعُمَرَ تَمَعَّكْتُ فَأَتَيْتُ النَّبِيَّ صلى الله عليه وسلم فَقَالَ ‏ \"‏ يَكْفِيكَ الْوَجْهُ وَالْكَفَّانِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_341.source" = "Sahih al-Bukhari 341";

"discovery.card.sunnah_bukhari_343.title" = "صحيح البخاري 343";
"discovery.card.sunnah_bukhari_343.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ بَشَّارٍ، قَالَ حَدَّثَنَا غُنْدَرٌ، حَدَّثَنَا شُعْبَةُ، عَنِ الْحَكَمِ، عَنْ ذَرٍّ، عَنِ ابْنِ عَبْدِ الرَّحْمَنِ بْنِ أَبْزَى، عَنْ أَبِيهِ، قَالَ قَالَ عَمَّارٌ فَضَرَبَ النَّبِيُّ صلى الله عليه وسلم بِيَدِهِ الأَرْضَ، فَمَسَحَ وَجْهَهُ وَكَفَّيْهِ‏.‏";
"discovery.card.sunnah_bukhari_343.source" = "Sahih al-Bukhari 343";

"discovery.card.sunnah_bukhari_353.title" = "صحيح البخاري 353";
"discovery.card.sunnah_bukhari_353.meaning" = "حَدَّثَنَا مُطَرِّفٌ أَبُو مُصْعَبٍ، قَالَ حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ أَبِي الْمَوَالِي، عَنْ مُحَمَّدِ بْنِ الْمُنْكَدِرِ، قَالَ رَأَيْتُ جَابِرَ بْنَ عَبْدِ اللَّهِ يُصَلِّي فِي ثَوْبٍ وَاحِدٍ وَقَالَ رَأَيْتُ النَّبِيَّ صلى الله عليه وسلم يُصَلِّي فِي ثَوْبٍ‏.‏";
"discovery.card.sunnah_bukhari_353.source" = "Sahih al-Bukhari 353";

"discovery.card.sunnah_bukhari_354.title" = "صحيح البخاري 354";
"discovery.card.sunnah_bukhari_354.meaning" = "حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُوسَى، قَالَ حَدَّثَنَا هِشَامُ بْنُ عُرْوَةَ، عَنْ أَبِيهِ، عَنْ عُمَرَ بْنِ أَبِي سَلَمَةَ، أَنَّ النَّبِيَّ صلى الله عليه وسلم صَلَّى فِي ثَوْبٍ وَاحِدٍ قَدْ خَالَفَ بَيْنَ طَرَفَيْهِ‏.‏";
"discovery.card.sunnah_bukhari_354.source" = "Sahih al-Bukhari 354";

"discovery.card.sunnah_bukhari_355.title" = "صحيح البخاري 355";
"discovery.card.sunnah_bukhari_355.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى، قَالَ حَدَّثَنَا يَحْيَى، قَالَ حَدَّثَنَا هِشَامٌ، قَالَ حَدَّثَنِي أَبِي، عَنْ عُمَرَ بْنِ أَبِي سَلَمَةَ، أَنَّهُ رَأَى النَّبِيَّ صلى الله عليه وسلم يُصَلِّي فِي ثَوْبٍ وَاحِدٍ فِي بَيْتِ أُمِّ سَلَمَةَ، قَدْ أَلْقَى طَرَفَيْهِ عَلَى عَاتِقَيْهِ‏.‏";
"discovery.card.sunnah_bukhari_355.source" = "Sahih al-Bukhari 355";

"discovery.card.sunnah_bukhari_356.title" = "صحيح البخاري 356";
"discovery.card.sunnah_bukhari_356.meaning" = "حَدَّثَنَا عُبَيْدُ بْنُ إِسْمَاعِيلَ، قَالَ حَدَّثَنَا أَبُو أُسَامَةَ، عَنْ هِشَامٍ، عَنْ أَبِيهِ، أَنَّ عُمَرَ بْنَ أَبِي سَلَمَةَ، أَخْبَرَهُ قَالَ رَأَيْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم يُصَلِّي فِي ثَوْبٍ وَاحِدٍ مُشْتَمِلاً بِهِ فِي بَيْتِ أُمِّ سَلَمَةَ، وَاضِعًا طَرَفَيْهِ عَلَى عَاتِقَيْهِ‏.‏";
"discovery.card.sunnah_bukhari_356.source" = "Sahih al-Bukhari 356";

"discovery.card.sunnah_bukhari_358.title" = "صحيح البخاري 358";
"discovery.card.sunnah_bukhari_358.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكٌ، عَنِ ابْنِ شِهَابٍ، عَنْ سَعِيدِ بْنِ الْمُسَيَّبِ، عَنْ أَبِي هُرَيْرَةَ، أَنَّ سَائِلاً، سَأَلَ رَسُولَ اللَّهِ صلى الله عليه وسلم عَنِ الصَّلاَةِ فِي ثَوْبٍ وَاحِدٍ فَقَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ أَوَلِكُلِّكُمْ ثَوْبَانِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_358.source" = "Sahih al-Bukhari 358";

"discovery.card.sunnah_bukhari_359.title" = "صحيح البخاري 359";
"discovery.card.sunnah_bukhari_359.meaning" = "حَدَّثَنَا أَبُو عَاصِمٍ، عَنْ مَالِكٍ، عَنْ أَبِي الزِّنَادِ، عَنْ عَبْدِ الرَّحْمَنِ الأَعْرَجِ، عَنْ أَبِي هُرَيْرَةَ، قَالَ قَالَ النَّبِيُّ صلى الله عليه وسلم ‏ \"‏ لاَ يُصَلِّي أَحَدُكُمْ فِي الثَّوْبِ الْوَاحِدِ، لَيْسَ عَلَى عَاتِقَيْهِ شَىْءٌ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_359.source" = "Sahih al-Bukhari 359";

"discovery.card.sunnah_bukhari_360.title" = "صحيح البخاري 360";
"discovery.card.sunnah_bukhari_360.meaning" = "حَدَّثَنَا أَبُو نُعَيْمٍ، قَالَ حَدَّثَنَا شَيْبَانُ، عَنْ يَحْيَى بْنِ أَبِي كَثِيرٍ، عَنْ عِكْرِمَةَ، قَالَ سَمِعْتُهُ ـ أَوْ، كُنْتُ سَأَلْتُهُ ـ قَالَ سَمِعْتُ أَبَا هُرَيْرَةَ، يَقُولُ أَشْهَدُ أَنِّي سَمِعْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم يَقُولُ ‏ \"‏ مَنْ صَلَّى فِي ثَوْبٍ وَاحِدٍ، فَلْيُخَالِفْ بَيْنَ طَرَفَيْهِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_360.source" = "Sahih al-Bukhari 360";

"discovery.card.sunnah_bukhari_362.title" = "صحيح البخاري 362";
"discovery.card.sunnah_bukhari_362.meaning" = "حَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا يَحْيَى، عَنْ سُفْيَانَ، قَالَ حَدَّثَنِي أَبُو حَازِمٍ، عَنْ سَهْلٍ، قَالَ كَانَ رِجَالٌ يُصَلُّونَ مَعَ النَّبِيِّ صلى الله عليه وسلم عَاقِدِي أُزْرِهِمْ عَلَى أَعْنَاقِهِمْ كَهَيْئَةِ الصِّبْيَانِ، وَقَالَ لِلنِّسَاءِ لاَ تَرْفَعْنَ رُءُوسَكُنَّ حَتَّى يَسْتَوِيَ الرِّجَالُ جُلُوسًا‏.‏";
"discovery.card.sunnah_bukhari_362.source" = "Sahih al-Bukhari 362";

"discovery.card.sunnah_bukhari_372.title" = "صحيح البخاري 372";
"discovery.card.sunnah_bukhari_372.meaning" = "حَدَّثَنَا أَبُو الْيَمَانِ، قَالَ أَخْبَرَنَا شُعَيْبٌ، عَنِ الزُّهْرِيِّ، قَالَ أَخْبَرَنِي عُرْوَةُ، أَنَّ عَائِشَةَ، قَالَتْ لَقَدْ كَانَ رَسُولُ اللَّهِ صلى الله عليه وسلم يُصَلِّي الْفَجْرَ، فَيَشْهَدُ مَعَهُ نِسَاءٌ مِنَ الْمُؤْمِنَاتِ مُتَلَفِّعَاتٍ فِي مُرُوطِهِنَّ ثُمَّ يَرْجِعْنَ إِلَى بُيُوتِهِنَّ مَا يَعْرِفُهُنَّ أَحَدٌ‏.‏";
"discovery.card.sunnah_bukhari_372.source" = "Sahih al-Bukhari 372";

"discovery.card.sunnah_bukhari_375.title" = "صحيح البخاري 375";
"discovery.card.sunnah_bukhari_375.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ حَدَّثَنَا اللَّيْثُ، عَنْ يَزِيدَ، عَنْ أَبِي الْخَيْرِ، عَنْ عُقْبَةَ بْنِ عَامِرٍ، قَالَ أُهْدِيَ إِلَى النَّبِيِّ صلى الله عليه وسلم فَرُّوجُ حَرِيرٍ، فَلَبِسَهُ فَصَلَّى فِيهِ، ثُمَّ انْصَرَفَ فَنَزَعَهُ نَزْعًا شَدِيدًا كَالْكَارِهِ لَهُ وَقَالَ ‏ \"‏ لاَ يَنْبَغِي هَذَا لِلْمُتَّقِينَ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_375.source" = "Sahih al-Bukhari 375";

"discovery.card.sunnah_bukhari_381.title" = "صحيح البخاري 381";
"discovery.card.sunnah_bukhari_381.meaning" = "حَدَّثَنَا أَبُو الْوَلِيدِ، قَالَ حَدَّثَنَا شُعْبَةُ، قَالَ حَدَّثَنَا سُلَيْمَانُ الشَّيْبَانِيُّ، عَنْ عَبْدِ اللَّهِ بْنِ شَدَّادٍ، عَنْ مَيْمُونَةَ، قَالَتْ كَانَ النَّبِيُّ صلى الله عليه وسلم يُصَلِّي عَلَى الْخُمْرَةِ‏.‏";
"discovery.card.sunnah_bukhari_381.source" = "Sahih al-Bukhari 381";

"discovery.card.sunnah_bukhari_383.title" = "صحيح البخاري 383";
"discovery.card.sunnah_bukhari_383.meaning" = "حَدَّثَنَا يَحْيَى بْنُ بُكَيْرٍ، قَالَ حَدَّثَنَا اللَّيْثُ، عَنْ عُقَيْلٍ، عَنِ ابْنِ شِهَابٍ، قَالَ أَخْبَرَنِي عُرْوَةُ، أَنَّ عَائِشَةَ، أَخْبَرَتْهُ أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم كَانَ يُصَلِّي وَهْىَ بَيْنَهُ وَبَيْنَ الْقِبْلَةِ عَلَى فِرَاشِ أَهْلِهِ، اعْتِرَاضَ الْجَنَازَةِ‏.‏";
"discovery.card.sunnah_bukhari_383.source" = "Sahih al-Bukhari 383";

"discovery.card.sunnah_bukhari_384.title" = "صحيح البخاري 384";
"discovery.card.sunnah_bukhari_384.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ حَدَّثَنَا اللَّيْثُ، عَنْ يَزِيدَ، عَنْ عِرَاكٍ، عَنْ عُرْوَةَ، أَنَّ النَّبِيَّ صلى الله عليه وسلم كَانَ يُصَلِّي وَعَائِشَةُ مُعْتَرِضَةٌ بَيْنَهُ وَبَيْنَ الْقِبْلَةِ عَلَى الْفِرَاشِ الَّذِي يَنَامَانِ عَلَيْهِ‏.‏";
"discovery.card.sunnah_bukhari_384.source" = "Sahih al-Bukhari 384";

"discovery.card.sunnah_bukhari_385.title" = "صحيح البخاري 385";
"discovery.card.sunnah_bukhari_385.meaning" = "حَدَّثَنَا أَبُو الْوَلِيدِ، هِشَامُ بْنُ عَبْدِ الْمَلِكِ قَالَ حَدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ، قَالَ حَدَّثَنِي غَالِبٌ الْقَطَّانُ، عَنْ بَكْرِ بْنِ عَبْدِ اللَّهِ، عَنْ أَنَسِ بْنِ مَالِكٍ، قَالَ كُنَّا نُصَلِّي مَعَ النَّبِيِّ صلى الله عليه وسلم فَيَضَعُ أَحَدُنَا طَرَفَ الثَّوْبِ مِنْ شِدَّةِ الْحَرِّ فِي مَكَانِ السُّجُودِ‏.‏";
"discovery.card.sunnah_bukhari_385.source" = "Sahih al-Bukhari 385";

"discovery.card.sunnah_bukhari_386.title" = "صحيح البخاري 386";
"discovery.card.sunnah_bukhari_386.meaning" = "حَدَّثَنَا آدَمُ بْنُ أَبِي إِيَاسٍ، قَالَ حَدَّثَنَا شُعْبَةُ، قَالَ أَخْبَرَنَا أَبُو مَسْلَمَةَ، سَعِيدُ بْنُ يَزِيدَ الأَزْدِيُّ قَالَ سَأَلْتُ أَنَسَ بْنَ مَالِكٍ أَكَانَ النَّبِيُّ صلى الله عليه وسلم يُصَلِّي فِي نَعْلَيْهِ قَالَ نَعَمْ‏.‏";
"discovery.card.sunnah_bukhari_386.source" = "Sahih al-Bukhari 386";

"discovery.card.sunnah_bukhari_388.title" = "صحيح البخاري 388";
"discovery.card.sunnah_bukhari_388.meaning" = "حَدَّثَنَا إِسْحَاقُ بْنُ نَصْرٍ، قَالَ حَدَّثَنَا أَبُو أُسَامَةَ، عَنِ الأَعْمَشِ، عَنْ مُسْلِمٍ، عَنْ مَسْرُوقٍ، عَنِ الْمُغِيرَةِ بْنِ شُعْبَةَ، قَالَ وَضَّأْتُ النَّبِيَّ صلى الله عليه وسلم فَمَسَحَ عَلَى خُفَّيْهِ وَصَلَّى‏.‏";
"discovery.card.sunnah_bukhari_388.source" = "Sahih al-Bukhari 388";

"discovery.card.sunnah_bukhari_390.title" = "صحيح البخاري 390";
"discovery.card.sunnah_bukhari_390.meaning" = "أَخْبَرَنَا يَحْيَى بْنُ بُكَيْرٍ، حَدَّثَنَا بَكْرُ بْنُ مُضَرَ، عَنْ جَعْفَرٍ، عَنِ ابْنِ هُرْمُزَ، عَنْ عَبْدِ اللَّهِ بْنِ مَالِكٍ ابْنِ بُحَيْنَةَ، أَنَّ النَّبِيَّ صلى الله عليه وسلم كَانَ إِذَا صَلَّى فَرَّجَ بَيْنَ يَدَيْهِ حَتَّى يَبْدُوَ بَيَاضُ إِبْطَيْهِ‏.‏ وَقَالَ اللَّيْثُ حَدَّثَنِي جَعْفَرُ بْنُ رَبِيعَةَ نَحْوَهُ‏.‏";
"discovery.card.sunnah_bukhari_390.source" = "Sahih al-Bukhari 390";

"discovery.card.sunnah_bukhari_391.title" = "صحيح البخاري 391";
"discovery.card.sunnah_bukhari_391.meaning" = "حَدَّثَنَا عَمْرُو بْنُ عَبَّاسٍ، قَالَ حَدَّثَنَا ابْنُ الْمَهْدِيِّ، قَالَ حَدَّثَنَا مَنْصُورُ بْنُ سَعْدٍ، عَنْ مَيْمُونِ بْنِ سِيَاهٍ، عَنْ أَنَسِ بْنِ مَالِكٍ، قَالَ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ مَنْ صَلَّى صَلاَتَنَا، وَاسْتَقْبَلَ قِبْلَتَنَا، وَأَكَلَ ذَبِيحَتَنَا، فَذَلِكَ الْمُسْلِمُ الَّذِي لَهُ ذِمَّةُ اللَّهِ وَذِمَّةُ رَسُولِهِ، فَلاَ تُخْفِرُوا اللَّهَ فِي ذِمَّتِهِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_391.source" = "Sahih al-Bukhari 391";

"discovery.card.sunnah_bukhari_398.title" = "صحيح البخاري 398";
"discovery.card.sunnah_bukhari_398.meaning" = "حَدَّثَنَا إِسْحَاقُ بْنُ نَصْرٍ، قَالَ حَدَّثَنَا عَبْدُ الرَّزَّاقِ، أَخْبَرَنَا ابْنُ جُرَيْجٍ، عَنْ عَطَاءٍ، قَالَ سَمِعْتُ ابْنَ عَبَّاسٍ، قَالَ لَمَّا دَخَلَ النَّبِيُّ صلى الله عليه وسلم الْبَيْتَ دَعَا فِي نَوَاحِيهِ كُلِّهَا، وَلَمْ يُصَلِّ حَتَّى خَرَجَ مِنْهُ، فَلَمَّا خَرَجَ رَكَعَ رَكْعَتَيْنِ فِي قُبُلِ الْكَعْبَةِ وَقَالَ ‏ \"‏ هَذِهِ الْقِبْلَةُ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_398.source" = "Sahih al-Bukhari 398";

"discovery.card.sunnah_bukhari_400.title" = "صحيح البخاري 400";
"discovery.card.sunnah_bukhari_400.meaning" = "حَدَّثَنَا مُسْلِمٌ، قَالَ حَدَّثَنَا هِشَامٌ، قَالَ حَدَّثَنَا يَحْيَى بْنُ أَبِي كَثِيرٍ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ، عَنْ جَابِرٍ، قَالَ كَانَ رَسُولُ اللَّهِ صلى الله عليه وسلم يُصَلِّي عَلَى رَاحِلَتِهِ حَيْثُ تَوَجَّهَتْ، فَإِذَا أَرَادَ الْفَرِيضَةَ نَزَلَ فَاسْتَقْبَلَ الْقِبْلَةَ‏.‏";
"discovery.card.sunnah_bukhari_400.source" = "Sahih al-Bukhari 400";

"discovery.card.sunnah_bukhari_404.title" = "صحيح البخاري 404";
"discovery.card.sunnah_bukhari_404.meaning" = "حَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا يَحْيَى، عَنْ شُعْبَةَ، عَنِ الْحَكَمِ، عَنْ إِبْرَاهِيمَ، عَنْ عَلْقَمَةَ، عَنْ عَبْدِ اللَّهِ، قَالَ صَلَّى النَّبِيُّ صلى الله عليه وسلم الظُّهْرَ خَمْسًا فَقَالُوا أَزِيدَ فِي الصَّلاَةِ قَالَ ‏ \"‏ وَمَا ذَاكَ ‏\"‏‏.‏ قَالُوا صَلَّيْتَ خَمْسًا‏.‏ فَثَنَى رِجْلَيْهِ وَسَجَدَ سَجْدَتَيْنِ‏.‏";
"discovery.card.sunnah_bukhari_404.source" = "Sahih al-Bukhari 404";

"discovery.card.sunnah_bukhari_407.title" = "صحيح البخاري 407";
"discovery.card.sunnah_bukhari_407.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكٌ، عَنْ هِشَامِ بْنِ عُرْوَةَ، عَنْ أَبِيهِ، عَنْ عَائِشَةَ أُمِّ الْمُؤْمِنِينَ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم رَأَى فِي جِدَارِ الْقِبْلَةِ مُخَاطًا أَوْ بُصَاقًا أَوْ نُخَامَةً فَحَكَّهُ‏.‏";
"discovery.card.sunnah_bukhari_407.source" = "Sahih al-Bukhari 407";

"discovery.card.sunnah_bukhari_412.title" = "صحيح البخاري 412";
"discovery.card.sunnah_bukhari_412.meaning" = "حَدَّثَنَا حَفْصُ بْنُ عُمَرَ، قَالَ حَدَّثَنَا شُعْبَةُ، قَالَ أَخْبَرَنِي قَتَادَةُ، قَالَ سَمِعْتُ أَنَسًا، قَالَ قَالَ النَّبِيُّ صلى الله عليه وسلم ‏ \"‏ لاَ يَتْفِلَنَّ أَحَدُكُمْ بَيْنَ يَدَيْهِ وَلاَ عَنْ يَمِينِهِ، وَلَكِنْ عَنْ يَسَارِهِ أَوْ تَحْتَ رِجْلِهِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_412.source" = "Sahih al-Bukhari 412";

"discovery.card.sunnah_bukhari_413.title" = "صحيح البخاري 413";
"discovery.card.sunnah_bukhari_413.meaning" = "حَدَّثَنَا آدَمُ، قَالَ حَدَّثَنَا شُعْبَةُ، قَالَ حَدَّثَنَا قَتَادَةُ، قَالَ سَمِعْتُ أَنَسَ بْنَ مَالِكٍ، قَالَ قَالَ النَّبِيُّ صلى الله عليه وسلم ‏ \"‏ إِنَّ الْمُؤْمِنَ إِذَا كَانَ فِي الصَّلاَةِ فَإِنَّمَا يُنَاجِي رَبَّهُ، فَلاَ يَبْزُقَنَّ بَيْنَ يَدَيْهِ وَلاَ عَنْ يَمِينِهِ، وَلَكِنْ عَنْ يَسَارِهِ أَوْ تَحْتَ قَدَمِهِ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_413.source" = "Sahih al-Bukhari 413";

"discovery.card.sunnah_bukhari_414.title" = "صحيح البخاري 414";
"discovery.card.sunnah_bukhari_414.meaning" = "حَدَّثَنَا عَلِيٌّ، قَالَ حَدَّثَنَا سُفْيَانُ، حَدَّثَنَا الزُّهْرِيُّ، عَنْ حُمَيْدِ بْنِ عَبْدِ الرَّحْمَنِ، عَنْ أَبِي سَعِيدٍ،‏.‏ أَنَّ النَّبِيَّ صلى الله عليه وسلم أَبْصَرَ نُخَامَةً فِي قِبْلَةِ الْمَسْجِدِ فَحَكَّهَا بِحَصَاةٍ، ثُمَّ نَهَى أَنْ يَبْزُقَ الرَّجُلُ بَيْنَ يَدَيْهِ أَوْ عَنْ يَمِينِهِ، وَلَكِنْ عَنْ يَسَارِهِ أَوْ تَحْتَ قَدَمِهِ الْيُسْرَى‏.‏ وَعَنِ الزُّهْرِيِّ سَمِعَ حُمَيْدًا عَنْ أَبِي سَعِيدٍ نَحْوَهُ‏.‏";
"discovery.card.sunnah_bukhari_414.source" = "Sahih al-Bukhari 414";

"discovery.card.sunnah_bukhari_415.title" = "صحيح البخاري 415";
"discovery.card.sunnah_bukhari_415.meaning" = "حَدَّثَنَا آدَمُ، قَالَ حَدَّثَنَا شُعْبَةُ، قَالَ حَدَّثَنَا قَتَادَةُ، قَالَ سَمِعْتُ أَنَسَ بْنَ مَالِكٍ، قَالَ قَالَ النَّبِيُّ صلى الله عليه وسلم ‏ \"‏ الْبُزَاقُ فِي الْمَسْجِدِ خَطِيئَةٌ، وَكَفَّارَتُهَا دَفْنُهَا ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_415.source" = "Sahih al-Bukhari 415";

"discovery.card.sunnah_bukhari_418.title" = "صحيح البخاري 418";
"discovery.card.sunnah_bukhari_418.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكٌ، عَنْ أَبِي الزِّنَادِ، عَنِ الأَعْرَجِ، عَنْ أَبِي هُرَيْرَةَ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ \"‏ هَلْ تَرَوْنَ قِبْلَتِي هَا هُنَا فَوَاللَّهِ مَا يَخْفَى عَلَىَّ خُشُوعُكُمْ وَلاَ رُكُوعُكُمْ، إِنِّي لأَرَاكُمْ مِنْ وَرَاءِ ظَهْرِي ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_418.source" = "Sahih al-Bukhari 418";

"discovery.card.sunnah_bukhari_419.title" = "صحيح البخاري 419";
"discovery.card.sunnah_bukhari_419.meaning" = "حَدَّثَنَا يَحْيَى بْنُ صَالِحٍ، قَالَ حَدَّثَنَا فُلَيْحُ بْنُ سُلَيْمَانَ، عَنْ هِلاَلِ بْنِ عَلِيٍّ، عَنْ أَنَسِ بْنِ مَالِكٍ، قَالَ صَلَّى بِنَا النَّبِيُّ صلى الله عليه وسلم صَلاَةً ثُمَّ رَقِيَ الْمِنْبَرَ، فَقَالَ فِي الصَّلاَةِ وَفِي الرُّكُوعِ ‏ \"‏ إِنِّي لأَرَاكُمْ مِنْ وَرَائِي كَمَا أَرَاكُمْ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_419.source" = "Sahih al-Bukhari 419";

"discovery.card.sunnah_bukhari_422.title" = "صحيح البخاري 422";
"discovery.card.sunnah_bukhari_422.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، أَخْبَرَنَا مَالِكٌ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ، سَمِعَ أَنَسًا، قَالَ وَجَدْتُ النَّبِيَّ صلى الله عليه وسلم فِي الْمَسْجِدِ مَعَهُ نَاسٌ فَقُمْتُ، فَقَالَ لِي ‏\"‏ آرْسَلَكَ أَبُو طَلْحَةَ ‏\"‏ قُلْتُ نَعَمْ‏.‏ فَقَالَ ‏\"‏ لِطَعَامٍ ‏\"‏‏.‏ قُلْتُ نَعَمْ‏.‏ فَقَالَ لِمَنْ حَوْلَهُ ‏\"‏ قُومُوا ‏\"‏‏.‏ فَانْطَلَقَ وَانْطَلَقْتُ بَيْنَ أَيْدِيهِمْ‏.‏";
"discovery.card.sunnah_bukhari_422.source" = "Sahih al-Bukhari 422";

"discovery.card.sunnah_bukhari_424.title" = "صحيح البخاري 424";
"discovery.card.sunnah_bukhari_424.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ، قَالَ حَدَّثَنَا إِبْرَاهِيمُ بْنُ سَعْدٍ، عَنِ ابْنِ شِهَابٍ، عَنْ مَحْمُودِ بْنِ الرَّبِيعِ، عَنْ عِتْبَانَ بْنِ مَالِكٍ، أَنَّ النَّبِيَّ صلى الله عليه وسلم أَتَاهُ فِي مَنْزِلِهِ فَقَالَ ‏ \"‏ أَيْنَ تُحِبُّ أَنْ أُصَلِّيَ لَكَ مِنْ بَيْتِكَ ‏\"‏‏.‏ قَالَ فَأَشَرْتُ لَهُ إِلَى مَكَانٍ، فَكَبَّرَ النَّبِيُّ صلى الله عليه وسلم وَصَفَفْنَا خَلْفَهُ، فَصَلَّى رَكْعَتَيْنِ‏.‏";
"discovery.card.sunnah_bukhari_424.source" = "Sahih al-Bukhari 424";

"discovery.card.sunnah_bukhari_426.title" = "صحيح البخاري 426";
"discovery.card.sunnah_bukhari_426.meaning" = "حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، قَالَ حَدَّثَنَا شُعْبَةُ، عَنِ الأَشْعَثِ بْنِ سُلَيْمٍ، عَنْ أَبِيهِ، عَنْ مَسْرُوقٍ، عَنْ عَائِشَةَ، قَالَتْ كَانَ النَّبِيُّ صلى الله عليه وسلم يُحِبُّ التَّيَمُّنَ مَا اسْتَطَاعَ فِي شَأْنِهِ كُلِّهِ فِي طُهُورِهِ وَتَرَجُّلِهِ وَتَنَعُّلِهِ‏.‏";
"discovery.card.sunnah_bukhari_426.source" = "Sahih al-Bukhari 426";

"discovery.card.sunnah_bukhari_429.title" = "صحيح البخاري 429";
"discovery.card.sunnah_bukhari_429.meaning" = "حَدَّثَنَا سُلَيْمَانُ بْنُ حَرْبٍ، قَالَ حَدَّثَنَا شُعْبَةُ، عَنْ أَبِي التَّيَّاحِ، عَنْ أَنَسٍ، قَالَ كَانَ النَّبِيُّ صلى الله عليه وسلم يُصَلِّي فِي مَرَابِضِ الْغَنَمِ، ثُمَّ سَمِعْتُهُ بَعْدُ يَقُولُ كَانَ يُصَلِّي فِي مَرَابِضِ الْغَنَمِ قَبْلَ أَنْ يُبْنَى الْمَسْجِدُ‏.‏";
"discovery.card.sunnah_bukhari_429.source" = "Sahih al-Bukhari 429";

"discovery.card.sunnah_bukhari_430.title" = "صحيح البخاري 430";
"discovery.card.sunnah_bukhari_430.meaning" = "حَدَّثَنَا صَدَقَةُ بْنُ الْفَضْلِ، قَالَ أَخْبَرَنَا سُلَيْمَانُ بْنُ حَيَّانَ، قَالَ حَدَّثَنَا عُبَيْدُ اللَّهِ، عَنْ نَافِعٍ، قَالَ رَأَيْتُ ابْنَ عُمَرَ يُصَلِّي إِلَى بَعِيرِهِ وَقَالَ رَأَيْتُ النَّبِيَّ صلى الله عليه وسلم يَفْعَلُهُ‏.‏";
"discovery.card.sunnah_bukhari_430.source" = "Sahih al-Bukhari 430";

"discovery.card.sunnah_bukhari_431.title" = "صحيح البخاري 431";
"discovery.card.sunnah_bukhari_431.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ، عَنْ مَالِكٍ، عَنْ زَيْدِ بْنِ أَسْلَمَ، عَنْ عَطَاءِ بْنِ يَسَارٍ، عَنْ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ، قَالَ انْخَسَفَتِ الشَّمْسُ، فَصَلَّى رَسُولُ اللَّهِ صلى الله عليه وسلم ثُمَّ قَالَ ‏ \"‏ أُرِيتُ النَّارَ، فَلَمْ أَرَ مَنْظَرًا كَالْيَوْمِ قَطُّ أَفْظَعَ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_431.source" = "Sahih al-Bukhari 431";

"discovery.card.sunnah_bukhari_432.title" = "صحيح البخاري 432";
"discovery.card.sunnah_bukhari_432.meaning" = "حَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا يَحْيَى، عَنْ عُبَيْدِ اللَّهِ، قَالَ أَخْبَرَنِي نَافِعٌ، عَنِ ابْنِ عُمَرَ، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ اجْعَلُوا فِي بُيُوتِكُمْ مِنْ صَلاَتِكُمْ، وَلاَ تَتَّخِذُوهَا قُبُورًا ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_432.source" = "Sahih al-Bukhari 432";

"discovery.card.sunnah_bukhari_437.title" = "صحيح البخاري 437";
"discovery.card.sunnah_bukhari_437.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ، عَنْ مَالِكٍ، عَنِ ابْنِ شِهَابٍ، عَنْ سَعِيدِ بْنِ الْمُسَيَّبِ، عَنْ أَبِي هُرَيْرَةَ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ \"‏ قَاتَلَ اللَّهُ الْيَهُودَ اتَّخَذُوا قُبُورَ أَنْبِيَائِهِمْ مَسَاجِدَ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_437.source" = "Sahih al-Bukhari 437";

"discovery.card.sunnah_bukhari_440.title" = "صحيح البخاري 440";
"discovery.card.sunnah_bukhari_440.meaning" = "حَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا يَحْيَى، عَنْ عُبَيْدِ اللَّهِ، قَالَ حَدَّثَنِي نَافِعٌ، قَالَ أَخْبَرَنِي عَبْدُ اللَّهِ، أَنَّهُ كَانَ يَنَامُ وَهْوَ شَابٌّ أَعْزَبُ لاَ أَهْلَ لَهُ فِي مَسْجِدِ النَّبِيِّ صلى الله عليه وسلم‏.‏";
"discovery.card.sunnah_bukhari_440.source" = "Sahih al-Bukhari 440";

"discovery.card.sunnah_bukhari_443.title" = "صحيح البخاري 443";
"discovery.card.sunnah_bukhari_443.meaning" = "حَدَّثَنَا خَلاَّدُ بْنُ يَحْيَى، قَالَ حَدَّثَنَا مِسْعَرٌ، قَالَ حَدَّثَنَا مُحَارِبُ بْنُ دِثَارٍ، عَنْ جَابِرِ بْنِ عَبْدِ اللَّهِ، قَالَ أَتَيْتُ النَّبِيَّ صلى الله عليه وسلم وَهُوَ فِي الْمَسْجِدِ ـ قَالَ مِسْعَرٌ أُرَاهُ قَالَ ضُحًى ـ فَقَالَ ‏ \"‏ صَلِّ رَكْعَتَيْنِ ‏\"‏‏.‏ وَكَانَ لِي عَلَيْهِ دَيْنٌ فَقَضَانِي وَزَادَنِي‏.‏";
"discovery.card.sunnah_bukhari_443.source" = "Sahih al-Bukhari 443";

"discovery.card.sunnah_bukhari_444.title" = "صحيح البخاري 444";
"discovery.card.sunnah_bukhari_444.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكٌ، عَنْ عَامِرِ بْنِ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ، عَنْ عَمْرِو بْنِ سُلَيْمٍ الزُّرَقِيِّ، عَنْ أَبِي قَتَادَةَ السَّلَمِيِّ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ \"‏ إِذَا دَخَلَ أَحَدُكُمُ الْمَسْجِدَ فَلْيَرْكَعْ رَكْعَتَيْنِ قَبْلَ أَنْ يَجْلِسَ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_444.source" = "Sahih al-Bukhari 444";

"discovery.card.sunnah_bukhari_445.title" = "صحيح البخاري 445";
"discovery.card.sunnah_bukhari_445.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكٌ، عَنْ أَبِي الزِّنَادِ، عَنِ الأَعْرَجِ، عَنْ أَبِي هُرَيْرَةَ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ \"‏ الْمَلاَئِكَةُ تُصَلِّي عَلَى أَحَدِكُمْ مَا دَامَ فِي مُصَلاَّهُ الَّذِي صَلَّى فِيهِ، مَا لَمْ يُحْدِثْ، تَقُولُ اللَّهُمَّ اغْفِرْ لَهُ اللَّهُمَّ ارْحَمْهُ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_445.source" = "Sahih al-Bukhari 445";

"discovery.card.sunnah_bukhari_448.title" = "صحيح البخاري 448";
"discovery.card.sunnah_bukhari_448.meaning" = "حَدَّثَنَا قُتَيْبَةُ، قَالَ حَدَّثَنَا عَبْدُ الْعَزِيزِ، عَنْ أَبِي حَازِمٍ، عَنْ سَهْلٍ، قَالَ بَعَثَ رَسُولُ اللَّهِ صلى الله عليه وسلم إِلَى امْرَأَةٍ أَنْ مُرِي غُلاَمَكِ النَّجَّارَ يَعْمَلْ لِي أَعْوَادًا أَجْلِسُ عَلَيْهِنَّ‏.‏";
"discovery.card.sunnah_bukhari_448.source" = "Sahih al-Bukhari 448";

"discovery.card.sunnah_bukhari_449.title" = "صحيح البخاري 449";
"discovery.card.sunnah_bukhari_449.meaning" = "حَدَّثَنَا خَلاَّدٌ، قَالَ حَدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ أَيْمَنَ، عَنْ أَبِيهِ، عَنْ جَابِرٍ، أَنَّ امْرَأَةً، قَالَتْ يَا رَسُولَ اللَّهِ، أَلاَ أَجْعَلُ لَكَ شَيْئًا تَقْعُدُ عَلَيْهِ، فَإِنَّ لِي غُلاَمًا نَجَّارًا قَالَ ‏ \"‏ إِنْ شِئْتِ ‏\"‏‏.‏ فَعَمِلَتِ الْمِنْبَرَ‏.‏";
"discovery.card.sunnah_bukhari_449.source" = "Sahih al-Bukhari 449";

"discovery.card.sunnah_bukhari_451.title" = "صحيح البخاري 451";
"discovery.card.sunnah_bukhari_451.meaning" = "حَدَّثَنَا قُتَيْبَةُ بْنُ سَعِيدٍ، قَالَ حَدَّثَنَا سُفْيَانُ، قَالَ قُلْتُ لِعَمْرٍو أَسَمِعْتَ جَابِرَ بْنَ عَبْدِ اللَّهِ يَقُولُ مَرَّ رَجُلٌ فِي الْمَسْجِدِ وَمَعَهُ سِهَامٌ، فَقَالَ لَهُ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ أَمْسِكْ بِنِصَالِهَا ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_451.source" = "Sahih al-Bukhari 451";

"discovery.card.sunnah_bukhari_452.title" = "صحيح البخاري 452";
"discovery.card.sunnah_bukhari_452.meaning" = "حَدَّثَنَا مُوسَى بْنُ إِسْمَاعِيلَ، قَالَ حَدَّثَنَا عَبْدُ الْوَاحِدِ، قَالَ حَدَّثَنَا أَبُو بُرْدَةَ بْنُ عَبْدِ اللَّهِ، قَالَ سَمِعْتُ أَبَا بُرْدَةَ، عَنْ أَبِيهِ، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ مَنْ مَرَّ فِي شَىْءٍ مِنْ مَسَاجِدِنَا أَوْ أَسْوَاقِنَا بِنَبْلٍ، فَلْيَأْخُذْ عَلَى نِصَالِهَا، لاَ يَعْقِرْ بِكَفِّهِ مُسْلِمًا ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_452.source" = "Sahih al-Bukhari 452";

"discovery.card.sunnah_bukhari_453.title" = "صحيح البخاري 453";
"discovery.card.sunnah_bukhari_453.meaning" = "حَدَّثَنَا أَبُو الْيَمَانِ الْحَكَمُ بْنُ نَافِعٍ، قَالَ أَخْبَرَنَا شُعَيْبٌ، عَنِ الزُّهْرِيِّ، قَالَ أَخْبَرَنِي أَبُو سَلَمَةَ بْنُ عَبْدِ الرَّحْمَنِ بْنِ عَوْفٍ، أَنَّهُ سَمِعَ حَسَّانَ بْنَ ثَابِتٍ الأَنْصَارِيَّ، يَسْتَشْهِدُ أَبَا هُرَيْرَةَ أَنْشُدُكَ اللَّهَ هَلْ سَمِعْتَ النَّبِيَّ صلى الله عليه وسلم يَقُولُ ‏ \"‏ يَا حَسَّانُ، أَجِبْ عَنْ رَسُولِ اللَّهِ صلى الله عليه وسلم، اللَّهُمَّ أَيِّدْهُ بِرُوحِ الْقُدُسِ ‏\"‏‏.‏ قَالَ أَبُو هُرَيْرَةَ نَعَمْ‏.‏";
"discovery.card.sunnah_bukhari_453.source" = "Sahih al-Bukhari 453";

"discovery.card.sunnah_bukhari_459.title" = "صحيح البخاري 459";
"discovery.card.sunnah_bukhari_459.meaning" = "حَدَّثَنَا عَبْدَانُ، عَنْ أَبِي حَمْزَةَ، عَنِ الأَعْمَشِ، عَنْ مُسْلِمٍ، عَنْ مَسْرُوقٍ، عَنْ عَائِشَةَ، قَالَتْ لَمَّا أُنْزِلَ الآيَاتُ مِنْ سُورَةِ الْبَقَرَةِ فِي الرِّبَا، خَرَجَ النَّبِيُّ صلى الله عليه وسلم إِلَى الْمَسْجِدِ، فَقَرَأَهُنَّ عَلَى النَّاسِ، ثُمَّ حَرَّمَ تِجَارَةَ الْخَمْرِ‏.‏";
"discovery.card.sunnah_bukhari_459.source" = "Sahih al-Bukhari 459";

"discovery.card.sunnah_bukhari_460.title" = "صحيح البخاري 460";
"discovery.card.sunnah_bukhari_460.meaning" = "حَدَّثَنَا أَحْمَدُ بْنُ وَاقِدٍ، قَالَ حَدَّثَنَا حَمَّادٌ، عَنْ ثَابِتٍ، عَنْ أَبِي رَافِعٍ، عَنْ أَبِي هُرَيْرَةَ، أَنَّ امْرَأَةً ـ أَوْ رَجُلاً ـ كَانَتْ تَقُمُّ الْمَسْجِدَ ـ وَلاَ أُرَاهُ إِلاَّ امْرَأَةً ـ فَذَكَرَ حَدِيثَ النَّبِيِّ صلى الله عليه وسلم أَنَّهُ صَلَّى عَلَى قَبْرِهِ‏.‏";
"discovery.card.sunnah_bukhari_460.source" = "Sahih al-Bukhari 460";

"discovery.card.sunnah_bukhari_464.title" = "صحيح البخاري 464";
"discovery.card.sunnah_bukhari_464.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكٌ، عَنْ مُحَمَّدِ بْنِ عَبْدِ الرَّحْمَنِ بْنِ نَوْفَلٍ، عَنْ عُرْوَةَ، عَنْ زَيْنَبَ بِنْتِ أَبِي سَلَمَةَ، عَنْ أُمِّ سَلَمَةَ، قَالَتْ شَكَوْتُ إِلَى رَسُولِ اللَّهِ صلى الله عليه وسلم أَنِّي أَشْتَكِي‏.‏ قَالَ ‏ \"‏ طُوفِي مِنْ وَرَاءِ النَّاسِ وَأَنْتِ رَاكِبَةٌ ‏\"‏‏.‏ فَطُفْتُ وَرَسُولُ اللَّهِ صلى الله عليه وسلم يُصَلِّي إِلَى جَنْبِ الْبَيْتِ، يَقْرَأُ بِالطُّورِ وَكِتَابٍ مَسْطُورٍ‏.‏";
"discovery.card.sunnah_bukhari_464.source" = "Sahih al-Bukhari 464";

"discovery.card.sunnah_bukhari_469.title" = "صحيح البخاري 469";
"discovery.card.sunnah_bukhari_469.meaning" = "حَدَّثَنَا قُتَيْبَةُ، قَالَ حَدَّثَنَا اللَّيْثُ، عَنْ سَعِيدِ بْنِ أَبِي سَعِيدٍ، أَنَّهُ سَمِعَ أَبَا هُرَيْرَةَ، يَقُولُ بَعَثَ رَسُولُ اللَّهِ صلى الله عليه وسلم خَيْلاً قِبَلَ نَجْدٍ، فَجَاءَتْ بِرَجُلٍ مِنْ بَنِي حَنِيفَةَ يُقَالُ لَهُ ثُمَامَةُ بْنُ أُثَالٍ، فَرَبَطُوهُ بِسَارِيَةٍ مِنْ سَوَارِي الْمَسْجِدِ‏.‏";
"discovery.card.sunnah_bukhari_469.source" = "Sahih al-Bukhari 469";

"discovery.card.sunnah_bukhari_475.title" = "صحيح البخاري 475";
"discovery.card.sunnah_bukhari_475.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ، عَنْ مَالِكٍ، عَنِ ابْنِ شِهَابٍ، عَنْ عَبَّادِ بْنِ تَمِيمٍ، عَنْ عَمِّهِ، أَنَّهُ رَأَى رَسُولَ اللَّهِ صلى الله عليه وسلم مُسْتَلْقِيًا فِي الْمَسْجِدِ، وَاضِعًا إِحْدَى رِجْلَيْهِ عَلَى الأُخْرَى‏.‏ وَعَنِ ابْنِ شِهَابٍ عَنْ سَعِيدِ بْنِ الْمُسَيَّبِ قَالَ كَانَ عُمَرُ وَعُثْمَانُ يَفْعَلاَنِ ذَلِكَ‏.‏";
"discovery.card.sunnah_bukhari_475.source" = "Sahih al-Bukhari 475";

"discovery.card.sunnah_bukhari_478.title" = "صحيح البخاري 478";
"discovery.card.sunnah_bukhari_478.meaning" = "حَدَّثَنَا حَامِدُ بْنُ عُمَرَ، عَنْ بِشْرٍ، حَدَّثَنَا عَاصِمٌ، حَدَّثَنَا وَاقِدٌ، عَنْ أَبِيهِ، عَنِ ابْنِ عُمَرَ، أَوِ ابْنِ عَمْرٍو شَبَّكَ النَّبِيُّ صلى الله عليه وسلم أَصَابِعَهُ‏.‏";
"discovery.card.sunnah_bukhari_478.source" = "Sahih al-Bukhari 478";

"discovery.card.sunnah_bukhari_480.title" = "صحيح البخاري 480";
"discovery.card.sunnah_bukhari_480.meaning" = "وَقَالَ عَاصِمُ بْنُ عَلِيٍّ حَدَّثَنَا عَاصِمُ بْنُ مُحَمَّدٍ، سَمِعْتُ هَذَا الْحَدِيثَ، مِنْ أَبِي فَلَمْ أَحْفَظْهُ، فَقَوَّمَهُ لِي وَاقِدٌ عَنْ أَبِيهِ، قَالَ سَمِعْتُ أَبِي وَهُوَ، يَقُولُ قَالَ عَبْدُ اللَّهِ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ يَا عَبْدَ اللَّهِ بْنَ عَمْرٍو، كَيْفَ بِكَ إِذَا بَقِيتَ فِي حُثَالَةٍ مِنَ النَّاسِ بِهَذَا ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_480.source" = "Sahih al-Bukhari 480";

"discovery.card.sunnah_bukhari_481.title" = "صحيح البخاري 481";
"discovery.card.sunnah_bukhari_481.meaning" = "حَدَّثَنَا خَلاَّدُ بْنُ يَحْيَى، قَالَ حَدَّثَنَا سُفْيَانُ، عَنْ أَبِي بُرْدَةَ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي بُرْدَةَ، عَنْ جَدِّهِ، عَنْ أَبِي مُوسَى، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ إِنَّ الْمُؤْمِنَ لِلْمُؤْمِنِ كَالْبُنْيَانِ، يَشُدُّ بَعْضُهُ بَعْضًا ‏\"‏‏.‏ وَشَبَّكَ أَصَابِعَهُ‏.‏";
"discovery.card.sunnah_bukhari_481.source" = "Sahih al-Bukhari 481";

"discovery.card.sunnah_bukhari_484.title" = "صحيح البخاري 484";
"discovery.card.sunnah_bukhari_484.meaning" = "حَدَّثَنَا إِبْرَاهِيمُ بْنُ الْمُنْذِرِ، قَالَ حَدَّثَنَا أَنَسُ بْنُ عِيَاضٍ، قَالَ حَدَّثَنَا مُوسَى بْنُ عُقْبَةَ، عَنْ نَافِعٍ، أَنَّ عَبْدَ اللَّهِ، أَخْبَرَهُ أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم كَانَ يَنْزِلُ بِذِي الْحُلَيْفَةِ حِينَ يَعْتَمِرُ، وَفِي حَجَّتِهِ حِينَ حَجَّ، تَحْتَ سَمُرَةٍ فِي مَوْضِعِ الْمَسْجِدِ الَّذِي بِذِي الْحُلَيْفَةِ، وَكَانَ إِذَا رَجَعَ مِنْ غَزْوٍ كَانَ فِي تِلْكَ الطَّرِيقِ أَوْ حَجٍّ أَوْ عُمْرَةٍ هَبَطَ مِنْ بَطْنِ وَادٍ، فَإِذَا ظَهَرَ مِنْ بَطْنِ وَادٍ أَنَاخَ بِالْبَطْحَاءِ الَّتِي عَلَى شَفِيرِ الْوَادِي الشَّرْقِيَّةِ، فَعَرَّسَ ثَمَّ حَتَّى يُصْبِحَ، لَيْسَ عِنْدَ الْمَسْجِدِ الَّذِي بِحِجَارَةٍ، وَلاَ عَلَى الأَكَمَةِ الَّتِي عَلَيْهَا الْمَسْجِدُ، كَانَ ثَمَّ خَلِيجٌ يُصَلِّي عَبْدُ اللَّهِ عِنْدَهُ، فِي بَطْنِهِ كُثُبٌ كَانَ رَسُولُ اللَّهِ صلى الله عليه وسلم ثَمَّ يُصَلِّي، فَدَحَا السَّيْلُ فِيهِ بِالْبَطْحَاءِ حَتَّى دَفَنَ ذَلِكَ الْمَكَانَ الَّذِي كَانَ عَبْدُ اللَّهِ يُصَلِّي فِيهِ‏.‏";
"discovery.card.sunnah_bukhari_484.source" = "Sahih al-Bukhari 484";

"discovery.card.sunnah_bukhari_496.title" = "صحيح البخاري 496";
"discovery.card.sunnah_bukhari_496.meaning" = "حَدَّثَنَا عَمْرُو بْنُ زُرَارَةَ، قَالَ أَخْبَرَنَا عَبْدُ الْعَزِيزِ بْنُ أَبِي حَازِمٍ، عَنْ أَبِيهِ، عَنْ سَهْلٍ، قَالَ كَانَ بَيْنَ مُصَلَّى رَسُولِ اللَّهِ صلى الله عليه وسلم وَبَيْنَ الْجِدَارِ مَمَرُّ الشَّاةِ‏.‏";
"discovery.card.sunnah_bukhari_496.source" = "Sahih al-Bukhari 496";

"discovery.card.sunnah_bukhari_497.title" = "صحيح البخاري 497";
"discovery.card.sunnah_bukhari_497.meaning" = "حَدَّثَنَا الْمَكِّيُّ، قَالَ حَدَّثَنَا يَزِيدُ بْنُ أَبِي عُبَيْدٍ، عَنْ سَلَمَةَ، قَالَ كَانَ جِدَارُ الْمَسْجِدِ عِنْدَ الْمِنْبَرِ مَا كَادَتِ الشَّاةُ تَجُوزُهَا‏.‏";
"discovery.card.sunnah_bukhari_497.source" = "Sahih al-Bukhari 497";

"discovery.card.sunnah_bukhari_498.title" = "صحيح البخاري 498";
"discovery.card.sunnah_bukhari_498.meaning" = "حَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا يَحْيَى، عَنْ عُبَيْدِ اللَّهِ، أَخْبَرَنِي نَافِعٌ، عَنْ عَبْدِ اللَّهِ، أَنَّ النَّبِيَّ صلى الله عليه وسلم كَانَ يُرْكَزُ لَهُ الْحَرْبَةُ فَيُصَلِّي إِلَيْهَا‏.‏";
"discovery.card.sunnah_bukhari_498.source" = "Sahih al-Bukhari 498";

"discovery.card.sunnah_bukhari_503.title" = "صحيح البخاري 503";
"discovery.card.sunnah_bukhari_503.meaning" = "حَدَّثَنَا قَبِيصَةُ، قَالَ حَدَّثَنَا سُفْيَانُ، عَنْ عَمْرِو بْنِ عَامِرٍ، عَنْ أَنَسٍ، قَالَ لَقَدْ رَأَيْتُ كِبَارَ أَصْحَابِ النَّبِيِّ صلى الله عليه وسلم يَبْتَدِرُونَ السَّوَارِيَ عِنْدَ الْمَغْرِبِ‏.‏ وَزَادَ شُعْبَةُ عَنْ عَمْرٍو عَنْ أَنَسٍ حَتَّى يَخْرُجَ النَّبِيُّ صلى الله عليه وسلم‏.‏";
"discovery.card.sunnah_bukhari_503.source" = "Sahih al-Bukhari 503";

"discovery.card.sunnah_bukhari_512.title" = "صحيح البخاري 512";
"discovery.card.sunnah_bukhari_512.meaning" = "حَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا يَحْيَى، قَالَ حَدَّثَنَا هِشَامٌ، قَالَ حَدَّثَنِي أَبِي، عَنْ عَائِشَةَ، قَالَتْ كَانَ النَّبِيُّ صلى الله عليه وسلم يُصَلِّي وَأَنَا رَاقِدَةٌ مُعْتَرِضَةٌ عَلَى فِرَاشِهِ، فَإِذَا أَرَادَ أَنْ يُوتِرَ أَيْقَظَنِي فَأَوْتَرْتُ‏.‏";
"discovery.card.sunnah_bukhari_512.source" = "Sahih al-Bukhari 512";

"discovery.card.sunnah_bukhari_515.title" = "صحيح البخاري 515";
"discovery.card.sunnah_bukhari_515.meaning" = "حَدَّثَنَا إِسْحَاقُ، قَالَ أَخْبَرَنَا يَعْقُوبُ بْنُ إِبْرَاهِيمَ، قَالَ حَدَّثَنِي ابْنُ أَخِي ابْنِ شِهَابٍ، أَنَّهُ سَأَلَ عَمَّهُ عَنِ الصَّلاَةِ، يَقْطَعُهَا شَىْءٌ فَقَالَ لاَ يَقْطَعُهَا شَىْءٌ، أَخْبَرَنِي عُرْوَةُ بْنُ الزُّبَيْرِ أَنَّ عَائِشَةَ زَوْجَ النَّبِيِّ صلى الله عليه وسلم قَالَتْ لَقَدْ كَانَ رَسُولُ اللَّهِ صلى الله عليه وسلم يَقُومُ فَيُصَلِّي مِنَ اللَّيْلِ، وَإِنِّي لَمُعْتَرِضَةٌ بَيْنَهُ وَبَيْنَ الْقِبْلَةِ عَلَى فِرَاشِ أَهْلِهِ‏.‏";
"discovery.card.sunnah_bukhari_515.source" = "Sahih al-Bukhari 515";

"discovery.card.sunnah_bukhari_517.title" = "صحيح البخاري 517";
"discovery.card.sunnah_bukhari_517.meaning" = "حَدَّثَنَا عَمْرُو بْنُ زُرَارَةَ، قَالَ أَخْبَرَنَا هُشَيْمٌ، عَنِ الشَّيْبَانِيِّ، عَنْ عَبْدِ اللَّهِ بْنِ شَدَّادِ بْنِ الْهَادِ، قَالَ أَخْبَرَتْنِي خَالَتِي، مَيْمُونَةُ بِنْتُ الْحَارِثِ قَالَتْ كَانَ فِرَاشِي حِيَالَ مُصَلَّى النَّبِيِّ صلى الله عليه وسلم فَرُبَّمَا وَقَعَ ثَوْبُهُ عَلَىَّ وَأَنَا عَلَى فِرَاشِي‏.‏";
"discovery.card.sunnah_bukhari_517.source" = "Sahih al-Bukhari 517";

"discovery.card.sunnah_bukhari_518.title" = "صحيح البخاري 518";
"discovery.card.sunnah_bukhari_518.meaning" = "حَدَّثَنَا أَبُو النُّعْمَانِ، قَالَ حَدَّثَنَا عَبْدُ الْوَاحِدِ بْنُ زِيَادٍ، قَالَ حَدَّثَنَا الشَّيْبَانِيُّ، سُلَيْمَانُ حَدَّثَنَا عَبْدُ اللَّهِ بْنُ شَدَّادٍ، قَالَ سَمِعْتُ مَيْمُونَةَ، تَقُولُ كَانَ النَّبِيُّ صلى الله عليه وسلم يُصَلِّي وَأَنَا إِلَى جَنْبِهِ نَائِمَةٌ، فَإِذَا سَجَدَ أَصَابَنِي ثَوْبُهُ، وَأَنَا حَائِضٌ‏.‏ وَزَادَ مُسَدَّدٌ عَنْ خَالِدٍ قَالَ حَدَّثَنَا سُلَيْمَانُ الشَّيْبَانِيُّ، وَأَنَا حَائِضٌ‏.‏";
"discovery.card.sunnah_bukhari_518.source" = "Sahih al-Bukhari 518";

"discovery.card.sunnah_bukhari_519.title" = "صحيح البخاري 519";
"discovery.card.sunnah_bukhari_519.meaning" = "حَدَّثَنَا عَمْرُو بْنُ عَلِيٍّ، قَالَ حَدَّثَنَا يَحْيَى، قَالَ حَدَّثَنَا عُبَيْدُ اللَّهِ، قَالَ حَدَّثَنَا الْقَاسِمُ، عَنْ عَائِشَةَ ـ رضى الله عنها ـ قَالَتْ بِئْسَمَا عَدَلْتُمُونَا بِالْكَلْبِ وَالْحِمَارِ، لَقَدْ رَأَيْتُنِي وَرَسُولُ اللَّهِ صلى الله عليه وسلم يُصَلِّي، وَأَنَا مُضْطَجِعَةٌ بَيْنَهُ وَبَيْنَ الْقِبْلَةِ، فَإِذَا أَرَادَ أَنْ يَسْجُدَ غَمَزَ رِجْلَىَّ فَقَبَضْتُهُمَا‏.‏";
"discovery.card.sunnah_bukhari_519.source" = "Sahih al-Bukhari 519";

"discovery.card.sunnah_bukhari_524.title" = "صحيح البخاري 524";
"discovery.card.sunnah_bukhari_524.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى، قَالَ حَدَّثَنَا يَحْيَى، قَالَ حَدَّثَنَا إِسْمَاعِيلُ، قَالَ حَدَّثَنَا قَيْسٌ، عَنْ جَرِيرِ بْنِ عَبْدِ اللَّهِ، قَالَ بَايَعْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم عَلَى إِقَامِ الصَّلاَةِ، وَإِيتَاءِ الزَّكَاةِ، وَالنُّصْحِ لِكُلِّ مُسْلِمٍ‏.‏";
"discovery.card.sunnah_bukhari_524.source" = "Sahih al-Bukhari 524";

"discovery.card.sunnah_bukhari_529.title" = "صحيح البخاري 529";
"discovery.card.sunnah_bukhari_529.meaning" = "حَدَّثَنَا مُوسَى بْنُ إِسْمَاعِيلَ، قَالَ حَدَّثَنَا مَهْدِيٌّ، عَنْ غَيْلاَنَ، عَنْ أَنَسٍ، قَالَ مَا أَعْرِفُ شَيْئًا مِمَّا كَانَ عَلَى عَهْدِ النَّبِيِّ صلى الله عليه وسلم‏.‏ قِيلَ الصَّلاَةُ‏.‏ قَالَ أَلَيْسَ ضَيَّعْتُمْ مَا ضَيَّعْتُمْ فِيهَا‏.‏";
"discovery.card.sunnah_bukhari_529.source" = "Sahih al-Bukhari 529";

"discovery.card.sunnah_bukhari_532.title" = "صحيح البخاري 532";
"discovery.card.sunnah_bukhari_532.meaning" = "حَدَّثَنَا حَفْصُ بْنُ عُمَرَ، قَالَ حَدَّثَنَا يَزِيدُ بْنُ إِبْرَاهِيمَ، قَالَ حَدَّثَنَا قَتَادَةُ، عَنْ أَنَسٍ، عَنِ النَّبِيِّ صلى الله عليه وسلم قَالَ ‏ \"‏ اعْتَدِلُوا فِي السُّجُودِ، وَلاَ يَبْسُطْ ذِرَاعَيْهِ كَالْكَلْبِ، وَإِذَا بَزَقَ فَلاَ يَبْزُقَنَّ بَيْنَ يَدَيْهِ وَلاَ عَنْ يَمِينِهِ، فَإِنَّهُ يُنَاجِي رَبَّهُ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_532.source" = "Sahih al-Bukhari 532";

"discovery.card.sunnah_bukhari_533.title" = "صحيح البخاري 533";
"discovery.card.sunnah_bukhari_533.meaning" = "حَدَّثَنَا أَيُّوبُ بْنُ سُلَيْمَانَ، قَالَ حَدَّثَنَا أَبُو بَكْرٍ، عَنْ سُلَيْمَانَ، قَالَ صَالِحُ بْنُ كَيْسَانَ حَدَّثَنَا الأَعْرَجُ عَبْدُ الرَّحْمَنِ، وَغَيْرُهُ، عَنْ أَبِي هُرَيْرَةَ‏.‏وَنَافِعٌ مَوْلَى عَبْدِ اللَّهِ بْنِ عُمَرَ عَنْ عَبْدِ اللَّهِ بْنِ عُمَرَ، أَنَّهُمَا حَدَّثَاهُ عَنْ رَسُولِ اللَّهِ صلى الله عليه وسلم أَنَّهُ قَالَ ‏ \"‏ إِذَا اشْتَدَّ الْحَرُّ فَأَبْرِدُوا عَنِ الصَّلاَةِ، فَإِنَّ شِدَّةَ الْحَرِّ مِنْ فَيْحِ جَهَنَّمَ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_533.source" = "Sahih al-Bukhari 533";

"discovery.card.sunnah_bukhari_538.title" = "صحيح البخاري 538";
"discovery.card.sunnah_bukhari_538.meaning" = "حَدَّثَنَا عُمَرُ بْنُ حَفْصٍ، قَالَ حَدَّثَنَا أَبِي قَالَ، حَدَّثَنَا الأَعْمَشُ، حَدَّثَنَا أَبُو صَالِحٍ، عَنْ أَبِي سَعِيدٍ، قَالَ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ أَبْرِدُوا بِالظُّهْرِ، فَإِنَّ شِدَّةَ الْحَرِّ مِنْ فَيْحِ جَهَنَّمَ ‏\"‏‏.‏ تَابَعَهُ سُفْيَانُ وَيَحْيَى وَأَبُو عَوَانَةَ عَنِ الأَعْمَشِ‏.‏";
"discovery.card.sunnah_bukhari_538.source" = "Sahih al-Bukhari 538";

"discovery.card.sunnah_bukhari_542.title" = "صحيح البخاري 542";
"discovery.card.sunnah_bukhari_542.meaning" = "حَدَّثَنَا مُحَمَّدٌ ـ يَعْنِي ابْنَ مُقَاتِلٍ ـ قَالَ أَخْبَرَنَا عَبْدُ اللَّهِ، قَالَ أَخْبَرَنَا خَالِدُ بْنُ عَبْدِ الرَّحْمَنِ، حَدَّثَنِي غَالِبٌ الْقَطَّانُ، عَنْ بَكْرِ بْنِ عَبْدِ اللَّهِ الْمُزَنِيِّ، عَنْ أَنَسِ بْنِ مَالِكٍ، قَالَ كُنَّا إِذَا صَلَّيْنَا خَلْفَ رَسُولِ اللَّهِ صلى الله عليه وسلم بِالظَّهَائِرِ فَسَجَدْنَا عَلَى ثِيَابِنَا اتِّقَاءَ الْحَرِّ‏.‏";
"discovery.card.sunnah_bukhari_542.source" = "Sahih al-Bukhari 542";

"discovery.card.sunnah_bukhari_543.title" = "صحيح البخاري 543";
"discovery.card.sunnah_bukhari_543.meaning" = "حَدَّثَنَا أَبُو النُّعْمَانِ، قَالَ حَدَّثَنَا حَمَّادٌ ـ هُوَ ابْنُ زَيْدٍ ـ عَنْ عَمْرِو بْنِ دِينَارٍ، عَنْ جَابِرِ بْنِ زَيْدٍ، عَنِ ابْنِ عَبَّاسٍ، أَنَّ النَّبِيَّ صلى الله عليه وسلم صَلَّى بِالْمَدِينَةِ سَبْعًا وَثَمَانِيًا الظُّهْرَ وَالْعَصْرَ، وَالْمَغْرِبَ وَالْعِشَاءَ‏.‏ فَقَالَ أَيُّوبُ لَعَلَّهُ فِي لَيْلَةٍ مَطِيرَةٍ‏.‏ قَالَ عَسَى‏.‏";
"discovery.card.sunnah_bukhari_543.source" = "Sahih al-Bukhari 543";

"discovery.card.sunnah_bukhari_544.title" = "صحيح البخاري 544";
"discovery.card.sunnah_bukhari_544.meaning" = "حَدَّثَنَا إِبْرَاهِيمُ بْنُ الْمُنْذِرِ، قَالَ حَدَّثَنَا أَنَسُ بْنُ عِيَاضٍ، عَنْ هِشَامٍ، عَنْ أَبِيهِ، أَنَّ عَائِشَةَ، قَالَتْ كَانَ رَسُولُ اللَّهِ صلى الله عليه وسلم يُصَلِّي الْعَصْرَ وَالشَّمْسُ لَمْ تَخْرُجْ مِنْ حُجْرَتِهَا‏.‏ وَقَالَ أَبُو أُسَامَةَ عَنْ هِشَامٍ مِنْ قَعْرِ حُجْرَتِهَا‏.‏";
"discovery.card.sunnah_bukhari_544.source" = "Sahih al-Bukhari 544";

"discovery.card.sunnah_bukhari_545.title" = "صحيح البخاري 545";
"discovery.card.sunnah_bukhari_545.meaning" = "حَدَّثَنَا قُتَيْبَةُ، قَالَ حَدَّثَنَا اللَّيْثُ، عَنِ ابْنِ شِهَابٍ، عَنْ عُرْوَةَ، عَنْ عَائِشَةَ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم صَلَّى الْعَصْرَ وَالشَّمْسُ فِي حُجْرَتِهَا، لَمْ يَظْهَرِ الْفَىْءُ مِنْ حُجْرَتِهَا‏.‏";
"discovery.card.sunnah_bukhari_545.source" = "Sahih al-Bukhari 545";

"discovery.card.sunnah_bukhari_546.title" = "صحيح البخاري 546";
"discovery.card.sunnah_bukhari_546.meaning" = "حَدَّثَنَا أَبُو نُعَيْمٍ، قَالَ أَخْبَرَنَا ابْنُ عُيَيْنَةَ، عَنِ الزُّهْرِيِّ، عَنْ عُرْوَةَ، عَنْ عَائِشَةَ، قَالَتْ كَانَ النَّبِيُّ صلى الله عليه وسلم يُصَلِّي صَلاَةَ الْعَصْرِ وَالشَّمْسُ طَالِعَةٌ فِي حُجْرَتِي لَمْ يَظْهَرِ الْفَىْءُ بَعْدُ‏.‏ وَقَالَ مَالِكٌ وَيَحْيَى بْنُ سَعِيدٍ وَشُعَيْبٌ وَابْنُ أَبِي حَفْصَةَ وَالشَّمْسُ قَبْلَ أَنْ تَظْهَرَ‏.‏";
"discovery.card.sunnah_bukhari_546.source" = "Sahih al-Bukhari 546";

"discovery.card.sunnah_bukhari_548.title" = "صحيح البخاري 548";
"discovery.card.sunnah_bukhari_548.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ، عَنْ مَالِكٍ، عَنْ إِسْحَاقَ بْنِ عَبْدِ اللَّهِ بْنِ أَبِي طَلْحَةَ، عَنْ أَنَسِ بْنِ مَالِكٍ، قَالَ كُنَّا نُصَلِّي الْعَصْرَ ثُمَّ يَخْرُجُ الإِنْسَانُ إِلَى بَنِي عَمْرِو بْنِ عَوْفٍ فَنَجِدُهُمْ يُصَلُّونَ الْعَصْرَ‏.‏";
"discovery.card.sunnah_bukhari_548.source" = "Sahih al-Bukhari 548";

"discovery.card.sunnah_bukhari_551.title" = "صحيح البخاري 551";
"discovery.card.sunnah_bukhari_551.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكٌ، عَنِ ابْنِ شِهَابٍ، عَنْ أَنَسِ بْنِ مَالِكٍ، قَالَ كُنَّا نُصَلِّي الْعَصْرَ ثُمَّ يَذْهَبُ الذَّاهِبُ مِنَّا إِلَى قُبَاءٍ، فَيَأْتِيهِمْ وَالشَّمْسُ مُرْتَفِعَةٌ‏.‏";
"discovery.card.sunnah_bukhari_551.source" = "Sahih al-Bukhari 551";

"discovery.card.sunnah_bukhari_552.title" = "صحيح البخاري 552";
"discovery.card.sunnah_bukhari_552.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكٌ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ \"‏ الَّذِي تَفُوتُهُ صَلاَةُ الْعَصْرِ كَأَنَّمَا وُتِرَ أَهْلَهُ وَمَالَهُ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_552.source" = "Sahih al-Bukhari 552";

"discovery.card.sunnah_bukhari_553.title" = "صحيح البخاري 553";
"discovery.card.sunnah_bukhari_553.meaning" = "حَدَّثَنَا مُسْلِمُ بْنُ إِبْرَاهِيمَ، قَالَ حَدَّثَنَا هِشَامٌ، قَالَ حَدَّثَنَا يَحْيَى بْنُ أَبِي كَثِيرٍ، عَنْ أَبِي قِلاَبَةَ، عَنْ أَبِي الْمَلِيحِ، قَالَ كُنَّا مَعَ بُرَيْدَةَ فِي غَزْوَةٍ فِي يَوْمٍ ذِي غَيْمٍ فَقَالَ بَكِّرُوا بِصَلاَةِ الْعَصْرِ فَإِنَّ النَّبِيَّ صلى الله عليه وسلم قَالَ ‏ \"‏ مَنْ تَرَكَ صَلاَةَ الْعَصْرِ فَقَدْ حَبِطَ عَمَلُهُ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_553.source" = "Sahih al-Bukhari 553";

"discovery.card.sunnah_bukhari_556.title" = "صحيح البخاري 556";
"discovery.card.sunnah_bukhari_556.meaning" = "حَدَّثَنَا أَبُو نُعَيْمٍ، قَالَ حَدَّثَنَا شَيْبَانُ، عَنْ يَحْيَى، عَنْ أَبِي سَلَمَةَ، عَنْ أَبِي هُرَيْرَةَ، قَالَ قَالَ رَسُولُ اللَّهِ صلى الله عليه وسلم ‏ \"‏ إِذَا أَدْرَكَ أَحَدُكُمْ سَجْدَةً مِنْ صَلاَةِ الْعَصْرِ قَبْلَ أَنْ تَغْرُبَ الشَّمْسُ فَلْيُتِمَّ صَلاَتَهُ، وَإِذَا أَدْرَكَ سَجْدَةً مِنْ صَلاَةِ الصُّبْحِ قَبْلَ أَنْ تَطْلُعَ الشَّمْسُ فَلْيُتِمَّ صَلاَتَهُ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_556.source" = "Sahih al-Bukhari 556";

"discovery.card.sunnah_bukhari_559.title" = "صحيح البخاري 559";
"discovery.card.sunnah_bukhari_559.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ مِهْرَانَ، قَالَ حَدَّثَنَا الْوَلِيدُ، قَالَ حَدَّثَنَا الأَوْزَاعِيُّ، قَالَ حَدَّثَنَا أَبُو النَّجَاشِيِّ، صُهَيْبٌ مَوْلَى رَافِعِ بْنِ خَدِيجٍ قَالَ سَمِعْتُ رَافِعَ بْنَ خَدِيجٍ، يَقُولُ كُنَّا نُصَلِّي الْمَغْرِبَ مَعَ النَّبِيِّ صلى الله عليه وسلم فَيَنْصَرِفُ أَحَدُنَا وَإِنَّهُ لَيُبْصِرُ مَوَاقِعَ نَبْلِهِ‏.‏";
"discovery.card.sunnah_bukhari_559.source" = "Sahih al-Bukhari 559";

"discovery.card.sunnah_bukhari_561.title" = "صحيح البخاري 561";
"discovery.card.sunnah_bukhari_561.meaning" = "حَدَّثَنَا الْمَكِّيُّ بْنُ إِبْرَاهِيمَ، قَالَ حَدَّثَنَا يَزِيدُ بْنُ أَبِي عُبَيْدٍ، عَنْ سَلَمَةَ، قَالَ كُنَّا نُصَلِّي مَعَ النَّبِيِّ صلى الله عليه وسلم الْمَغْرِبَ إِذَا تَوَارَتْ بِالْحِجَابِ‏.‏";
"discovery.card.sunnah_bukhari_561.source" = "Sahih al-Bukhari 561";

"discovery.card.sunnah_bukhari_562.title" = "صحيح البخاري 562";
"discovery.card.sunnah_bukhari_562.meaning" = "حَدَّثَنَا آدَمُ، قَالَ حَدَّثَنَا شُعْبَةُ، قَالَ حَدَّثَنَا عَمْرُو بْنُ دِينَارٍ، قَالَ سَمِعْتُ جَابِرَ بْنَ زَيْدٍ، عَنِ ابْنِ عَبَّاسٍ، قَالَ صَلَّى النَّبِيُّ صلى الله عليه وسلم سَبْعًا جَمِيعًا وَثَمَانِيًا جَمِيعًا‏.‏";
"discovery.card.sunnah_bukhari_562.source" = "Sahih al-Bukhari 562";

"discovery.card.sunnah_bukhari_563.title" = "صحيح البخاري 563";
"discovery.card.sunnah_bukhari_563.meaning" = "حَدَّثَنَا أَبُو مَعْمَرٍ ـ هُوَ عَبْدُ اللَّهِ بْنُ عَمْرٍو ـ قَالَ حَدَّثَنَا عَبْدُ الْوَارِثِ، عَنِ الْحُسَيْنِ، قَالَ حَدَّثَنَا عَبْدُ اللَّهِ بْنُ بُرَيْدَةَ، قَالَ حَدَّثَنِي عَبْدُ اللَّهِ الْمُزَنِيُّ، أَنَّ النَّبِيَّ صلى الله عليه وسلم قَالَ ‏ \"‏ لاَ تَغْلِبَنَّكُمُ الأَعْرَابُ عَلَى اسْمِ صَلاَتِكُمُ الْمَغْرِبِ ‏\"‏‏.‏ قَالَ الأَعْرَابُ وَتَقُولُ هِيَ الْعِشَاءُ‏.‏";
"discovery.card.sunnah_bukhari_563.source" = "Sahih al-Bukhari 563";

"discovery.card.sunnah_bukhari_568.title" = "صحيح البخاري 568";
"discovery.card.sunnah_bukhari_568.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ سَلاَمٍ، قَالَ أَخْبَرَنَا عَبْدُ الْوَهَّابِ الثَّقَفِيُّ، قَالَ حَدَّثَنَا خَالِدٌ الْحَذَّاءُ، عَنْ أَبِي الْمِنْهَالِ، عَنْ أَبِي بَرْزَةَ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم كَانَ يَكْرَهُ النَّوْمَ قَبْلَ الْعِشَاءِ وَالْحَدِيثَ بَعْدَهَا‏.‏";
"discovery.card.sunnah_bukhari_568.source" = "Sahih al-Bukhari 568";

"discovery.card.sunnah_bukhari_574.title" = "صحيح البخاري 574";
"discovery.card.sunnah_bukhari_574.meaning" = "حَدَّثَنَا هُدْبَةُ بْنُ خَالِدٍ، قَالَ حَدَّثَنَا هَمَّامٌ، حَدَّثَنِي أَبُو جَمْرَةَ، عَنْ أَبِي بَكْرِ بْنِ أَبِي مُوسَى، عَنْ أَبِيهِ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ \"‏ مَنْ صَلَّى الْبَرْدَيْنِ دَخَلَ الْجَنَّةَ ‏\"‏‏.‏ وَقَالَ ابْنُ رَجَاءٍ حَدَّثَنَا هَمَّامٌ عَنْ أَبِي جَمْرَةَ أَنَّ أَبَا بَكْرِ بْنَ عَبْدِ اللَّهِ بْنِ قَيْسٍ أَخْبَرَهُ بِهَذَا‏.‏ حَدَّثَنَا إِسْحَاقُ، عَنْ حَبَّانَ، حَدَّثَنَا هَمَّامٌ، حَدَّثَنَا أَبُو جَمْرَةَ، عَنْ أَبِي بَكْرِ بْنِ عَبْدِ اللَّهِ، عَنْ أَبِيهِ، عَنِ النَّبِيِّ صلى الله عليه وسلم مِثْلَهُ‏.‏";
"discovery.card.sunnah_bukhari_574.source" = "Sahih al-Bukhari 574";

"discovery.card.sunnah_bukhari_577.title" = "صحيح البخاري 577";
"discovery.card.sunnah_bukhari_577.meaning" = "حَدَّثَنَا إِسْمَاعِيلُ بْنُ أَبِي أُوَيْسٍ، عَنْ أَخِيهِ، عَنْ سُلَيْمَانَ، عَنْ أَبِي حَازِمٍ، أَنَّهُ سَمِعَ سَهْلَ بْنَ سَعْدٍ، يَقُولُ كُنْتُ أَتَسَحَّرُ فِي أَهْلِي ثُمَّ يَكُونُ سُرْعَةٌ بِي أَنْ أُدْرِكَ صَلاَةَ الْفَجْرِ مَعَ رَسُولِ اللَّهِ صلى الله عليه وسلم‏.‏";
"discovery.card.sunnah_bukhari_577.source" = "Sahih al-Bukhari 577";

"discovery.card.sunnah_bukhari_578.title" = "صحيح البخاري 578";
"discovery.card.sunnah_bukhari_578.meaning" = "حَدَّثَنَا يَحْيَى بْنُ بُكَيْرٍ، قَالَ أَخْبَرَنَا اللَّيْثُ، عَنْ عُقَيْلٍ، عَنِ ابْنِ شِهَابٍ، قَالَ أَخْبَرَنِي عُرْوَةُ بْنُ الزُّبَيْرِ، أَنَّ عَائِشَةَ، أَخْبَرَتْهُ قَالَتْ، كُنَّ نِسَاءُ الْمُؤْمِنَاتِ يَشْهَدْنَ مَعَ رَسُولِ اللَّهِ صلى الله عليه وسلم صَلاَةَ الْفَجْرِ مُتَلَفِّعَاتٍ بِمُرُوطِهِنَّ، ثُمَّ يَنْقَلِبْنَ إِلَى بُيُوتِهِنَّ حِينَ يَقْضِينَ الصَّلاَةَ، لاَ يَعْرِفُهُنَّ أَحَدٌ مِنَ الْغَلَسِ‏.‏";
"discovery.card.sunnah_bukhari_578.source" = "Sahih al-Bukhari 578";

"discovery.card.sunnah_bukhari_579.title" = "صحيح البخاري 579";
"discovery.card.sunnah_bukhari_579.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ مَسْلَمَةَ، عَنْ مَالِكٍ، عَنْ زَيْدِ بْنِ أَسْلَمَ، عَنْ عَطَاءِ بْنِ يَسَارٍ، وَعَنْ بُسْرِ بْنِ سَعِيدٍ، وَعَنِ الأَعْرَجِ، يُحَدِّثُونَهُ عَنْ أَبِي هُرَيْرَةَ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ \"‏ مَنْ أَدْرَكَ مِنَ الصُّبْحِ رَكْعَةً قَبْلَ أَنْ تَطْلُعَ الشَّمْسُ فَقَدْ أَدْرَكَ الصُّبْحَ، وَمَنْ أَدْرَكَ رَكْعَةً مِنَ الْعَصْرِ قَبْلَ أَنْ تَغْرُبَ الشَّمْسُ فَقَدْ أَدْرَكَ الْعَصْرَ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_579.source" = "Sahih al-Bukhari 579";

"discovery.card.sunnah_bukhari_580.title" = "صحيح البخاري 580";
"discovery.card.sunnah_bukhari_580.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكٌ، عَنِ ابْنِ شِهَابٍ، عَنْ أَبِي سَلَمَةَ بْنِ عَبْدِ الرَّحْمَنِ، عَنْ أَبِي هُرَيْرَةَ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ \"‏ مَنْ أَدْرَكَ رَكْعَةً مِنَ الصَّلاَةِ فَقَدْ أَدْرَكَ الصَّلاَةَ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_580.source" = "Sahih al-Bukhari 580";

"discovery.card.sunnah_bukhari_581.title" = "صحيح البخاري 581";
"discovery.card.sunnah_bukhari_581.meaning" = "حَدَّثَنَا حَفْصُ بْنُ عُمَرَ، قَالَ حَدَّثَنَا هِشَامٌ، عَنْ قَتَادَةَ، عَنْ أَبِي الْعَالِيَةِ، عَنِ ابْنِ عَبَّاسٍ، قَالَ شَهِدَ عِنْدِي رِجَالٌ مَرْضِيُّونَ وَأَرْضَاهُمْ عِنْدِي عُمَرُ أَنَّ النَّبِيَّ صلى الله عليه وسلم نَهَى عَنِ الصَّلاَةِ بَعْدَ الصُّبْحِ حَتَّى تَشْرُقَ الشَّمْسُ، وَبَعْدَ الْعَصْرِ حَتَّى تَغْرُبَ‏.‏ حَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا يَحْيَى، عَنْ شُعْبَةَ، عَنْ قَتَادَةَ، سَمِعْتُ أَبَا الْعَالِيَةِ، عَنِ ابْنِ عَبَّاسٍ، قَالَ حَدَّثَنِي نَاسٌ، بِهَذَا‏.‏";
"discovery.card.sunnah_bukhari_581.source" = "Sahih al-Bukhari 581";

"discovery.card.sunnah_bukhari_585.title" = "صحيح البخاري 585";
"discovery.card.sunnah_bukhari_585.meaning" = "حَدَّثَنَا عَبْدُ اللَّهِ بْنُ يُوسُفَ، قَالَ أَخْبَرَنَا مَالِكٌ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، أَنَّ رَسُولَ اللَّهِ صلى الله عليه وسلم قَالَ ‏ \"‏ لاَ يَتَحَرَّى أَحَدُكُمْ فَيُصَلِّي عِنْدَ طُلُوعِ الشَّمْسِ وَلاَ عِنْدَ غُرُوبِهَا ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_585.source" = "Sahih al-Bukhari 585";

"discovery.card.sunnah_bukhari_586.title" = "صحيح البخاري 586";
"discovery.card.sunnah_bukhari_586.meaning" = "حَدَّثَنَا عَبْدُ الْعَزِيزِ بْنُ عَبْدِ اللَّهِ، قَالَ حَدَّثَنَا إِبْرَاهِيمُ بْنُ سَعْدٍ، عَنْ صَالِحٍ، عَنِ ابْنِ شِهَابٍ، قَالَ أَخْبَرَنِي عَطَاءُ بْنُ يَزِيدَ الْجُنْدَعِيُّ، أَنَّهُ سَمِعَ أَبَا سَعِيدٍ الْخُدْرِيَّ، يَقُولُ سَمِعْتُ رَسُولَ اللَّهِ صلى الله عليه وسلم يَقُولُ ‏ \"‏ لاَ صَلاَةَ بَعْدَ الصُّبْحِ حَتَّى تَرْتَفِعَ الشَّمْسُ، وَلاَ صَلاَةَ بَعْدَ الْعَصْرِ حَتَّى تَغِيبَ الشَّمْسُ ‏\"‏‏.‏";
"discovery.card.sunnah_bukhari_586.source" = "Sahih al-Bukhari 586";

"discovery.card.sunnah_bukhari_587.title" = "صحيح البخاري 587";
"discovery.card.sunnah_bukhari_587.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ أَبَانَ، قَالَ حَدَّثَنَا غُنْدَرٌ، قَالَ حَدَّثَنَا شُعْبَةُ، عَنْ أَبِي التَّيَّاحِ، قَالَ سَمِعْتُ حُمْرَانَ بْنَ أَبَانَ، يُحَدِّثُ عَنْ مُعَاوِيَةَ، قَالَ إِنَّكُمْ لَتُصَلُّونَ صَلاَةً، لَقَدْ صَحِبْنَا رَسُولَ اللَّهِ صلى الله عليه وسلم فَمَا رَأَيْنَاهُ يُصَلِّيهَا، وَلَقَدْ نَهَى عَنْهُمَا، يَعْنِي الرَّكْعَتَيْنِ بَعْدَ الْعَصْرِ‏.‏";
"discovery.card.sunnah_bukhari_587.source" = "Sahih al-Bukhari 587";

"discovery.card.sunnah_bukhari_588.title" = "صحيح البخاري 588";
"discovery.card.sunnah_bukhari_588.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ سَلاَمٍ، قَالَ حَدَّثَنَا عَبْدَةُ، عَنْ عُبَيْدِ اللَّهِ، عَنْ خُبَيْبٍ، عَنْ حَفْصِ بْنِ عَاصِمٍ، عَنْ أَبِي هُرَيْرَةَ، قَالَ نَهَى رَسُولُ اللَّهِ صلى الله عليه وسلم عَنْ صَلاَتَيْنِ بَعْدَ الْفَجْرِ حَتَّى تَطْلُعَ الشَّمْسُ، وَبَعْدَ الْعَصْرِ حَتَّى تَغْرُبَ الشَّمْسُ‏.‏";
"discovery.card.sunnah_bukhari_588.source" = "Sahih al-Bukhari 588";

"discovery.card.sunnah_bukhari_589.title" = "صحيح البخاري 589";
"discovery.card.sunnah_bukhari_589.meaning" = "حَدَّثَنَا أَبُو النُّعْمَانِ، حَدَّثَنَا حَمَّادُ بْنُ زَيْدٍ، عَنْ أَيُّوبَ، عَنْ نَافِعٍ، عَنِ ابْنِ عُمَرَ، قَالَ أُصَلِّي كَمَا رَأَيْتُ أَصْحَابِي يُصَلُّونَ، لاَ أَنْهَى أَحَدًا يُصَلِّي بِلَيْلٍ وَلاَ نَهَارٍ مَا شَاءَ، غَيْرَ أَنْ لاَ تَحَرَّوْا طُلُوعَ الشَّمْسِ وَلاَ غُرُوبَهَا‏.‏";
"discovery.card.sunnah_bukhari_589.source" = "Sahih al-Bukhari 589";

"discovery.card.sunnah_bukhari_591.title" = "صحيح البخاري 591";
"discovery.card.sunnah_bukhari_591.meaning" = "حَدَّثَنَا مُسَدَّدٌ، قَالَ حَدَّثَنَا يَحْيَى، قَالَ حَدَّثَنَا هِشَامٌ، قَالَ أَخْبَرَنِي أَبِي قَالَتْ، عَائِشَةُ ابْنَ أُخْتِي مَا تَرَكَ النَّبِيُّ صلى الله عليه وسلم السَّجْدَتَيْنِ بَعْدَ الْعَصْرِ عِنْدِي قَطُّ‏.‏";
"discovery.card.sunnah_bukhari_591.source" = "Sahih al-Bukhari 591";

"discovery.card.sunnah_bukhari_592.title" = "صحيح البخاري 592";
"discovery.card.sunnah_bukhari_592.meaning" = "حَدَّثَنَا مُوسَى بْنُ إِسْمَاعِيلَ، قَالَ حَدَّثَنَا عَبْدُ الْوَاحِدِ، قَالَ حَدَّثَنَا الشَّيْبَانِيُّ، قَالَ حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ الأَسْوَدِ، عَنْ أَبِيهِ، عَنْ عَائِشَةَ، قَالَتْ رَكْعَتَانِ لَمْ يَكُنْ رَسُولُ اللَّهِ صلى الله عليه وسلم يَدَعُهُمَا سِرًّا وَلاَ عَلاَنِيَةً رَكْعَتَانِ قَبْلَ صَلاَةِ الصُّبْحِ، وَرَكْعَتَانِ بَعْدَ الْعَصْرِ‏.‏";
"discovery.card.sunnah_bukhari_592.source" = "Sahih al-Bukhari 592";

"discovery.card.sunnah_bukhari_593.title" = "صحيح البخاري 593";
"discovery.card.sunnah_bukhari_593.meaning" = "حَدَّثَنَا مُحَمَّدُ بْنُ عَرْعَرَةَ، قَالَ حَدَّثَنَا شُعْبَةُ، عَنْ أَبِي إِسْحَاقَ، قَالَ رَأَيْتُ الأَسْوَدَ وَمَسْرُوقًا شَهِدَا عَلَى عَائِشَةَ قَالَتْ مَا كَانَ النَّبِيُّ صلى الله عليه وسلم يَأْتِينِي فِي يَوْمٍ بَعْدَ الْعَصْرِ إِلاَّ صَلَّى رَكْعَتَيْنِ‏.‏";
"discovery.card.sunnah_bukhari_593.source" = "Sahih al-Bukhari 593";

