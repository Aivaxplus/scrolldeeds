"discovery.card.fact_kursi_greatest.title" = "أعظم آية";
"discovery.card.fact_kursi_greatest.meaning" = "سأل النبي ﷺ أُبيّ بن كعب: أي آية في كتاب الله أعظم؟ فقال آية الكرسي، فأقرّه النبي ﷺ.";
"discovery.card.fact_kursi_greatest.source" = "Sahih Muslim 810";

"discovery.card.fact_muawwidhatayn.title" = "المعوذتان";
"discovery.card.fact_muawwidhatayn.meaning" = "الفلق والناس هما المعوذتان. كان النبي ﷺ يتعوذ بهما ويعلمهما.";
"discovery.card.fact_muawwidhatayn.source" = "Sahih al-Bukhari 5016";

"discovery.card.fact_iman_six.title" = "أركان الإيمان الستة";
"discovery.card.fact_iman_six.meaning" = "الإيمان أن تؤمن بالله وملائكته وكتبه ورسله واليوم الآخر والقدر خيره وشره.";
