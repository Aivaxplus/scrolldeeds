// MARK: - معاني الأدعية الكاملة
"dua.ayat_al_kursi.translation" = "اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ — الله الذي لا إله غيره، هو الحي الدائم القائم على كل شيء، لا تأخذه سنة ولا نوم، له ملك السماوات والأرض كلها، لا يشفع عنده أحد إلا بإذنه، يعلم كل شيء ولا يحيط أحد بشيء من علمه إلا بما شاء، وسع كرسيه السماوات والأرض ولا يثقله حفظهما، وهو العلي العظيم. (القرآن 2:255)";
"dua.istighfar.translation" = "اللهم أنت ربي لا إله إلا أنت — تعترف بأنك عبد لله، خلقه وأنت على عهده ووعده، تستعيذ بالله من شر ما صنعت، وتعترف بنعمته عليك وبذنوبك، وتطلب منه المغفرة لأنه وحده يغفر الذنوب. (سيد الاستغفار)";
"dua.dua_parents.translation" = "رب ارحمهما كما ربياني صغيرا — اطلب من الله أن يرحم والديك كما ربياك في صغرك. (القرآن 17:24)";
"dua.dua_ummah.translation" = "اللهم أصلح أمة محمد، اللهم فرج عن أمة محمد، اللهم ارحم أمة محمد — دعاء لجميع المسلمين في العالم.";
"dua.dua_loved_one.translation" = "اللهم بارك له فيما رزقته، واغفر له وارحمه وعافه واعف عنه — دعاء لمن تحب.";
"dua.verse_reflection.translation" = "إن في خلق السماوات والأرض واختلاف الليل والنهار لآيات لأولي الألباب — تأمل في عظمة خلق الله. (القرآن 3:190)";
"dua.dua_knowledge.translation" = "ربِّ زدني علمًا — (القرآن 20:114)";
"dua.dua_relief.translation" = "اللهم إني أعوذ بك من الهم والحزن.";
"dua.dua_morning.translation" = "أصبحنا وأصبح الملك لله والحمد لله.";
"dua.dua_evening.translation" = "أمسينا وأمسى الملك لله، والحمد لله.";
"dua.dua_dunya.translation" = "ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار. (البقرة 2:201)";
"dua.dua_heart.translation" = "ربنا لا تزغ قلوبنا بعد إذ هديتنا وهب لنا من لدنك رحمة إنك أنت الوهاب. (آل عمران 3:8)";
"dua.dua_hasbi.translation" = "حسبي الله لا إله إلا هو عليه توكلت وهو رب العرش العظيم. (التوبة 9:129)";
"dua.dua_jannah.translation" = "اللهم إني أسألك الجنة وأعوذ بك من النار.";

// MARK: - Surah full translations (for recitation tasks — meaning in Arabic)
"surah.ikhlas.translation" = "بسم الله الرحمن الرحيم. قل هو الله أحد، الله الصمد، لم يلد ولم يولد، ولم يكن له كفواً أحد.";
"surah.falaq.translation" = "بسم الله الرحمن الرحيم. قل أعوذ برب الفلق من شر ما خلق، ومن شر غاسق إذا وقب، ومن شر النفاثات في العقد، ومن شر حاسد إذا حسد.";
"surah.nas.translation" = "بسم الله الرحمن الرحيم. قل أعوذ برب الناس ملك الناس إله الناس، من شر الوسواس الخناس الذي يوسوس في صدور الناس، من الجنة والناس.";
"surah.fatiha.translation" = "بسم الله الرحمن الرحيم. الحمد لله رب العالمين، الرحمن الرحيم، مالك يوم الدين. إياك نعبد وإياك نستعين. اهدنا الصراط المستقيم، صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين.";
"surah.kafirun.translation" = "بسم الله الرحمن الرحيم. قل يا أيها الكافرون، لا أعبد ما تعبدون، ولا أنتم عابدون ما أعبد، ولا أنا عابد ما عبدتم، ولا أنتم عابدون ما أعبد. لكم دينكم ولي دين.";
"surah.kawthar.translation" = "بسم الله الرحمن الرحيم. إنا أعطيناك الكوثر. فصلّ لربك وانحر. إن شانئك هو الأبتر.";
"surah.asr.translation" = "بسم الله الرحمن الرحيم. والعصر. إن الإنسان لفي خسر. إلا الذين آمنوا وعملوا الصالحات وتواصوا بالحق وتواصوا بالصبر.";

