"task.med_7.title" = "دعاء للأمة";
"task.med_7.instruction" = "ادعُ دعاءً من القلب للأمة الإسلامية. ادعُ باليسر والوحدة والرحمة لكل من يعاني.";
"task.med_8.title" = "اشكر الله على 3 نعم";
"task.med_8.instruction" = "سمّ 3 نعم محددة في حياتك الآن. اشكر الله بصدق على كل واحدة.";
"task.hard_1.title" = "آية الكرسي";
"task.hard_1.instruction" = "اقرأ آية الكرسي ببطء وبحضور كامل. تأمل في عظمة الله الموصوفة فيها.";
"task.hard_2.title" = "اطلب المغفرة";
"task.hard_2.instruction" = "اسأل الله بصدق المغفرة. كن محدداً عما تأسف عليه وجدّد نيتك للتحسن.";
"task.hard_3.title" = "دعاء لمن تحب";
"task.hard_3.instruction" = "فكّر في شخص عزيز عليك وادعُ له دعاءً صادقاً. اسأل الله أن يباركه في الدنيا والآخرة.";
"task.hard_4.title" = "تأمل في آية";
"task.hard_4.instruction" = "استحضر آية من القرآن تعرفها. تأمل في معناها وكيف تنطبق على حياتك اليوم.";
"task.hard_5.title" = "سمّ ذنباً واحداً تتجنبه";
"task.hard_5.instruction" = "تأمل بصدق. اختر ذنباً واحداً تريد تركه اليوم. اعقد نية صادقة على تجنبه بمعونة الله.";
"task.hard_6.title" = "سمّ حسنة واحدة لليوم";
"task.hard_6.instruction" = "فكّر في حسنة واحدة ستفعلها قبل انتهاء اليوم. اعقد نية راسخة واسأل الله أن يعينك على إنجازها.";
"task.med_9.title" = "سورة الفاتحة";
"task.med_9.instruction" = "اقرأ سورة الفاتحة بحضور. تأمل في طلب الهداية من الله.";
"task.med_10.title" = "سورة الكافرون";
"task.med_10.instruction" = "اقرأ سورة الكافرون. تأمل صفاء التوحيد في قلبك.";
"task.med_11.title" = "دعاء للعلم";
"task.med_11.instruction" = "اسأل الله أن يزيدك علماً نافعاً. قل رب زدني علما بصدق.";
"task.med_12.title" = "دعاء للفرج";
"task.med_12.instruction" = "استعذ بالله من الهم والحزن. قل الدعاء بقلب مطمئن.";
"task.med_13.title" = "أذكار الصباح";
"task.med_13.instruction" = "اقرأ ذكر الصباح: أصبحنا وأصبح الملك لله.";
"task.med_14.title" = "الحسنة في الدارين";
"task.med_14.instruction" = "اسأل الله الحسنة في الدنيا والآخرة، والوقاية من النار.";
"task.med_15.title" = "قلب ثابت";
"task.med_15.instruction" = "اسأل الله ألا يزيغ قلبك بعد إذ هداك.";
"task.med_16.title" = "الله حسبي";
"task.med_16.instruction" = "قل مرة واحدة: حسبي الله لا إله إلا هو، متوكلاً عليه.";
"task.med_17.title" = "أذكار المساء";
"task.med_17.instruction" = "قل ذكر المساء: أمسينا وأمسى الملك لله.";
"task.med_18.title" = "سؤال الجنة";
"task.med_18.instruction" = "اسأل الله الجنة وتعوّذ به من النار.";
"task.med_19.title" = "سورة الكوثر";
"task.med_19.instruction" = "اقرأ سورة الكوثر بتمهّل. هي عطاء من الله.";
"task.med_20.title" = "سورة العصر";
"task.med_20.instruction" = "اقرأ سورة العصر وتذكّر أن الوقت يمضي.";
