"discovery.card.fact_five_prayers.title" = "خمس صلوات في اليوم";
"discovery.card.fact_five_prayers.meaning" = "بُني الإسلام على خمس: الشهادتين، والصلاة، والزكاة، والحج، وصوم رمضان. والصلاة خمس مرات كل يوم.";
"discovery.card.fact_five_prayers.source" = "Sahih al-Bukhari 8 · Sahih Muslim 16";

"discovery.card.fact_night_qadr.title" = "خير من ألف شهر";
"discovery.card.fact_night_qadr.meaning" = "ليلة القدر خير من ألف شهر. هي في رمضان، ولم يُحدد القرآن ليلتها بعينها.";
"discovery.card.fact_night_qadr.source" = "Qur’an 97:3";

"discovery.card.fact_hijrah.title" = "الهجرة";
"discovery.card.fact_hijrah.meaning" = "هاجر النبي ﷺ من مكة إلى المدينة. وذكر القرآن نصر الله له في الغار في ذلك المسير.";
"discovery.card.fact_hijrah.source" = "Qur’an 9:40 · seerah of the Hijrah";

"discovery.card.fact_seal_prophets.title" = "خاتم النبيين";
"discovery.card.fact_seal_prophets.meaning" = "سمّى القرآن محمدًا ﷺ رسول الله وخاتم النبيين.";
"discovery.card.fact_seal_prophets.source" = "Qur’an 33:40";

"discovery.card.fact_two_testimonies.title" = "لا إله إلا الله";
"discovery.card.fact_two_testimonies.meaning" = "الركن الأول شهادة أن لا إله إلا الله وأن محمدًا ﷺ رسول الله.";
"discovery.card.fact_two_testimonies.source" = "Qur’an 47:19 · Sahih al-Bukhari 8";

"discovery.card.fact_zakat_pillar.title" = "الزكاة ركن";
"discovery.card.fact_zakat_pillar.meaning" = "قرن القرآن الصلاة بالزكاة. وإيتاء الزكاة ركن من أركان الإسلام الخمسة.";
"discovery.card.fact_zakat_pillar.source" = "Qur’an 2:43 · Sahih al-Bukhari 8";

"discovery.card.fact_hajj_pillar.title" = "الحج إلى البيت";
"discovery.card.fact_hajj_pillar.meaning" = "ولله على الناس حج البيت من استطاع إليه سبيلًا. وهو ركن من أركان الإسلام.";
"discovery.card.fact_hajj_pillar.source" = "Qur’an 3:97 · Sahih al-Bukhari 8";

"discovery.card.fact_fast_ramadan.title" = "كُتب عليكم الصيام";
"discovery.card.fact_fast_ramadan.meaning" = "كُتب عليكم الصيام كما كُتب على الذين من قبلكم لعلكم تتقون.";
"discovery.card.fact_fast_ramadan.source" = "Qur’an 2:183 · Sahih al-Bukhari 8";

"discovery.card.fact_fatiha_every_salah.title" = "لا صلاة إلا بفاتحة الكتاب";
"discovery.card.fact_fatiha_every_salah.meaning" = "قال النبي ﷺ: لا صلاة لمن لم يقرأ بفاتحة الكتاب.";
"discovery.card.fact_fatiha_every_salah.source" = "Sahih al-Bukhari 756 · Sahih Muslim 394";

"discovery.card.fact_quran_preserved.title" = "إنا له لحافظون";
"discovery.card.fact_quran_preserved.meaning" = "قال تعالى: «إنا نحن نزلنا الذكر وإنا له لحافظون».";
"discovery.card.fact_quran_preserved.source" = "Qur’an 15:9";

"discovery.card.fact_ramadan_reveal.title" = "أُنزل في رمضان";
"discovery.card.fact_ramadan_reveal.meaning" = "أُنزل القرآن في شهر رمضان هدى للناس وبينات من الهدى والفرقان.";
"discovery.card.fact_ramadan_reveal.source" = "Qur’an 2:185";

"discovery.card.fact_surah_count.title" = "١١٤ سورة";
"discovery.card.fact_surah_count.meaning" = "المصحف العثماني مرتب في ١١٤ سورة، من الفاتحة إلى الناس.";
"discovery.card.fact_surah_count.source" = "Uthmani mushaf";

"discovery.card.fact_juz_count.title" = "٣٠ جزءًا";
"discovery.card.fact_juz_count.meaning" = "يُقسَّم القرآن إلى ٣٠ جزءًا للتلاوة، جزء في كل ليلة من ختمة رمضان المعتادة.";
"discovery.card.fact_juz_count.source" = "Uthmani mushaf";

"discovery.card.fact_iqra_first.title" = "أول كلمة: اقرأ";
"discovery.card.fact_iqra_first.meaning" = "أول ما نزل على النبي ﷺ في غار حراء: «اقرأ باسم ربك الذي خلق».";
"discovery.card.fact_iqra_first.source" = "Qur’an 96:1 · Sahih al-Bukhari 3";

"discovery.card.fact_longest_surah.title" = "أطول سورة";
"discovery.card.fact_longest_surah.meaning" = "البقرة أطول سورة في القرآن، ٢٨٦ آية. نزلت في المدينة.";
"discovery.card.fact_longest_surah.source" = "Uthmani mushaf · Qur’an 2";

"discovery.card.fact_shortest_surah.title" = "أقصر سورة";
"discovery.card.fact_shortest_surah.meaning" = "الكوثر أقصر سورة، ثلاث آيات.";
"discovery.card.fact_shortest_surah.source" = "Uthmani mushaf · Qur’an 108";

"discovery.card.fact_first_house.title" = "أول بيت";
"discovery.card.fact_first_house.meaning" = "إن أول بيت وُضع للناس للذي ببكة مباركًا وهدى للعالمين.";
"discovery.card.fact_first_house.source" = "Qur’an 3:96";

"discovery.card.fact_qiblah_change.title" = "تحويل القبلة";
"discovery.card.fact_qiblah_change.meaning" = "أمر الله النبي ﷺ أن يولي وجهه شطر المسجد الحرام، فصارت قبلة المسلمين.";
"discovery.card.fact_qiblah_change.source" = "Qur’an 2:144";

"discovery.card.fact_arabic_quran.title" = "قرآنًا عربيًا";
"discovery.card.fact_arabic_quran.meaning" = "أُنزل القرآن قرآنًا عربيًا لعل أول من سمعه يعقلونه.";
"discovery.card.fact_arabic_quran.source" = "Qur’an 12:2";

"discovery.card.fact_in_stages.title" = "نزّلناه تنزيلًا";
"discovery.card.fact_in_stages.meaning" = "لم ينزل القرآن جملة واحدة، بل فُرّق على سنين بعثة النبي ﷺ.";
"discovery.card.fact_in_stages.source" = "Qur’an 17:106";

"discovery.card.fact_isra.title" = "الإسراء";
"discovery.card.fact_isra.meaning" = "سبحان الذي أسرى بعبده ليلًا من المسجد الحرام إلى المسجد الأقصى الذي باركنا حوله.";
"discovery.card.fact_isra.source" = "Qur’an 17:1";

"discovery.card.fact_mercy_to_worlds.title" = "رحمة للعالمين";
"discovery.card.fact_mercy_to_worlds.meaning" = "وما أرسلناك إلا رحمة للعالمين.";
"discovery.card.fact_mercy_to_worlds.source" = "Qur’an 21:107";

"discovery.card.fact_uswa_hasana.title" = "أسوة حسنة";
"discovery.card.fact_uswa_hasana.meaning" = "لقد كان لكم في رسول الله أسوة حسنة لمن كان يرجو الله واليوم الآخر.";
"discovery.card.fact_uswa_hasana.source" = "Qur’an 33:21";

"discovery.card.fact_great_character.title" = "خلق عظيم";
"discovery.card.fact_great_character.meaning" = "قال تعالى عن النبي ﷺ: «وإنك لعلى خلق عظيم».";
"discovery.card.fact_great_character.source" = "Qur’an 68:4";

"discovery.card.fact_salawat.title" = "إن الله وملائكته يصلون";
"discovery.card.fact_salawat.meaning" = "إن الله وملائكته يصلون على النبي، يا أيها الذين آمنوا صلوا عليه وسلموا تسليمًا.";
"discovery.card.fact_salawat.source" = "Qur’an 33:56";

"discovery.card.fact_jumuah.title" = "إذا نودي للصلاة من يوم الجمعة";
"discovery.card.fact_jumuah.meaning" = "إذا نودي للصلاة من يوم الجمعة فاسعوا إلى ذكر الله وذروا البيع.";
"discovery.card.fact_jumuah.source" = "Qur’an 62:9";

"discovery.card.fact_wudu_ayah.title" = "الوضوء في القرآن";
"discovery.card.fact_wudu_ayah.meaning" = "ذكر القرآن الوضوء: فاغسلوا وجوهكم وأيديكم إلى المرافق وامسحوا برؤوسكم وأرجلكم إلى الكعبين.";
"discovery.card.fact_wudu_ayah.source" = "Qur’an 5:6";

"discovery.card.fact_no_compulsion.title" = "لا إكراه في الدين";
"discovery.card.fact_no_compulsion.meaning" = "لا إكراه في الدين، قد تبين الرشد من الغي.";
"discovery.card.fact_no_compulsion.source" = "Qur’an 2:256";

"discovery.card.fact_quran_easy_remember.title" = "يسرناه للذكر";
"discovery.card.fact_quran_easy_remember.meaning" = "قال تعالى: «ولقد يسرنا القرآن للذكر فهل من مدكر». وتتكرر هذه الآية في سورة القمر.";
"discovery.card.fact_quran_easy_remember.source" = "Qur’an 54:17";

"discovery.card.fact_bismillah_tawbah.title" = "التوبة بلا بسملة";
"discovery.card.fact_bismillah_tawbah.meaning" = "في المصحف العثماني تبدأ كل سورة بالبسملة إلا سورة التوبة.";
"discovery.card.fact_bismillah_tawbah.source" = "Uthmani mushaf · Qur’an 9";

"discovery.card.fact_fatiha_seven.title" = "سبعًا من المثاني";
"discovery.card.fact_fatiha_seven.meaning" = "الفاتحة سبع آيات. وكثير من أهل العلم يجعلون «سبعًا من المثاني» في الحجر هي الفاتحة، تُقرأ في كل صلاة.";
"discovery.card.fact_fatiha_seven.source" = "Qur’an 15:87 · Qur’an 1";

"discovery.card.fact_ikhlas_third.title" = "الإخلاص ثلث القرآن";
"discovery.card.fact_ikhlas_third.meaning" = "قال النبي ﷺ إن «قل هو الله أحد» تعدل ثلث القرآن.";
