"discovery.explain.allah_name.title" = "%@، اسم من أسماء الله";
"discovery.explain.allah_name.body" = "%@ من أسماء الله الحسنى. وهذا الاسم لله وحده.";
"discovery.explain.muqattaat.body" = "%@ حروف افتتح الله بها هذه السورة. ومعناها على الحقيقة عند الله.";

"discovery.card.smile.title" = "تبسمك صدقة";
"discovery.card.smile.meaning" = "قال النبي ﷺ: «تَبَسُّمُكَ فِي وَجْهِ أَخِيكَ صَدَقَةٌ».";
"discovery.card.smile.source" = "جامع الترمذي ١٩٥٦ (حسن)";

"discovery.card.salam.title" = "أفشوا السلام";
"discovery.card.salam.meaning" = "سُئل النبي ﷺ: أي الإسلام خير؟ قال: «تُطْعِمُ الطَّعَامَ، وَتَقْرَأُ السَّلَامَ عَلَى مَنْ عَرَفْتَ وَمَنْ لَمْ تَعْرِفْ». وقال أيضًا: «أَفْشُوا السَّلَامَ بَيْنَكُمْ».";
"discovery.card.salam.source" = "صحيح البخاري ٢٨ · صحيح مسلم ٥٤";

"discovery.card.right_hand.title" = "كُلْ بيمينك";
"discovery.card.right_hand.meaning" = "قال النبي ﷺ: «إِذَا أَكَلَ أَحَدُكُمْ فَلْيَأْكُلْ بِيَمِينِهِ، وَإِذَا شَرِبَ فَلْيَشْرَبْ بِيَمِينِهِ، فَإِنَّ الشَّيْطَانَ يَأْكُلُ بِشِمَالِهِ وَيَشْرَبُ بِشِمَالِهِ».";
"discovery.card.right_hand.source" = "صحيح مسلم ٢٠٢٠";

"discovery.card.bismillah_eat.title" = "سمِّ الله إذا أكلت";
"discovery.card.bismillah_eat.meaning" = "قال النبي ﷺ: «إِذَا أَكَلَ أَحَدُكُمْ فَلْيَذْكُرِ اسْمَ اللَّهِ تَعَالَى، فَإِنْ نَسِيَ أَنْ يَذْكُرَ اسْمَ اللَّهِ تَعَالَى فِي أَوَّلِهِ، فَلْيَقُلْ: بِسْمِ اللَّهِ أَوَّلَهُ وَآخِرَهُ».";
"discovery.card.bismillah_eat.source" = "سنن أبي داود ٣٧٦٧ · جامع الترمذي ١٨٥٨";

"discovery.card.right_shoe.title" = "ابدأ باليمنى إذا انتعلت";
"discovery.card.right_shoe.meaning" = "قال النبي ﷺ: «إِذَا انْتَعَلَ أَحَدُكُمْ فَلْيَبْدَأْ بِالْيَمِينِ، وَإِذَا نَزَعَ فَلْيَبْدَأْ بِالشِّمَالِ».";
"discovery.card.right_shoe.source" = "صحيح البخاري ٥٨٥٥";

"discovery.card.siwak.title" = "السواك";
"discovery.card.siwak.meaning" = "قال النبي ﷺ: «لَوْلَا أَنْ أَشُقَّ عَلَى أُمَّتِي لَأَمَرْتُهُمْ بِالسِّوَاكِ عِنْدَ كُلِّ صَلَاةٍ».";
"discovery.card.siwak.source" = "صحيح البخاري ٨٨٧ · صحيح مسلم ٢٥٢";

"discovery.card.anger.title" = "ليس الشديد بالصرعة";
"discovery.card.anger.meaning" = "قال النبي ﷺ: «لَيْسَ الشَّدِيدُ بِالصُّرَعَةِ، إِنَّمَا الشَّدِيدُ الَّذِي يَمْلِكُ نَفْسَهُ عِنْدَ الْغَضَبِ».";
"discovery.card.anger.source" = "صحيح البخاري ٦١١٤ · صحيح مسلم ٢٦٠٩";

"discovery.card.visit_sick.title" = "عُد المريض";
"discovery.card.visit_sick.meaning" = "قال النبي ﷺ: «حَقُّ الْمُسْلِمِ عَلَى الْمُسْلِمِ خَمْسٌ: رَدُّ السَّلَامِ، وَعِيَادَةُ الْمَرِيضِ، وَاتِّبَاعُ الْجَنَائِزِ، وَإِجَابَةُ الدَّعْوَةِ، وَتَشْمِيتُ الْعَاطِسِ».";
"discovery.card.visit_sick.source" = "صحيح البخاري ١٢٤٠ · صحيح مسلم ٢١٦٢";

"discovery.card.two_words.title" = "كلمتان ثقيلتان في الميزان";
"discovery.card.two_words.meaning" = "قال النبي ﷺ: «كَلِمَتَانِ خَفِيفَتَانِ عَلَى اللِّسَانِ، ثَقِيلَتَانِ فِي الْمِيزَانِ، حَبِيبَتَانِ إِلَى الرَّحْمَٰنِ: سُبْحَانَ اللَّهِ وَبِحَمْدِهِ، سُبْحَانَ اللَّهِ الْعَظِيمِ».";
"discovery.card.two_words.source" = "صحيح البخاري ٦٤٠٦ · صحيح مسلم ٢٦٩٤";

"discovery.card.ease.title" = "فإن مع العسر يسرًا";
"discovery.card.ease.meaning" = "قال الله تعالى: ﴿فَإِنَّ مَعَ الْعُسْرِ يُسْرًا ۝ إِنَّ مَعَ الْعُسْرِ يُسْرًا﴾. اليسر مع العسر، لا بعده فقط.";
"discovery.card.ease.source" = "القرآن ٩٤:٥–٦";

"discovery.card.neighbor.title" = "أكرم جارك";
"discovery.card.neighbor.meaning" = "قال النبي ﷺ: «مَا زَالَ جِبْرِيلُ يُوصِينِي بِالْجَارِ حَتَّى ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ».";
"discovery.card.neighbor.source" = "صحيح البخاري ٦٠١٤ · صحيح مسلم ٢٦٢٤";

"discovery.card.knowledge.title" = "رب زدني علمًا";
"discovery.card.knowledge.meaning" = "علّم الله رسوله ﷺ هذا الدعاء: ﴿وَقُل رَّبِّ زِدْنِي عِلْمًا﴾.";
"discovery.card.knowledge.source" = "القرآن ٢٠:١١٤";

"discovery.card.intention.title" = "إنما الأعمال بالنيات";
"discovery.card.intention.meaning" = "قال النبي ﷺ: «إِنَّمَا الْأَعْمَالُ بِالنِّيَّاتِ، وَإِنَّمَا لِكُلِّ امْرِئٍ مَا نَوَى».";
"discovery.card.intention.source" = "صحيح البخاري ١ · صحيح مسلم ١٩٠٧";

"discovery.card.half_date.title" = "ولو بشق تمرة";
"discovery.card.half_date.meaning" = "قال النبي ﷺ: «اتَّقُوا النَّارَ وَلَوْ بِشِقِّ تَمْرَةٍ».";
"discovery.card.half_date.source" = "صحيح البخاري ١٤١٧ · صحيح مسلم ١٠١٦";

"discovery.card.remove_harm.title" = "إماطة الأذى عن الطريق";
"discovery.card.remove_harm.meaning" = "قال النبي ﷺ: «الْإِيمَانُ بِضْعٌ وَسَبْعُونَ شُعْبَةً، فَأَفْضَلُهَا قَوْلُ لَا إِلَٰهَ إِلَّا اللَّهُ، وَأَدْنَاهَا إِمَاطَةُ الْأَذَى عَنِ الطَّرِيقِ».";
"discovery.card.remove_harm.source" = "صحيح مسلم ٣٥";

"discovery.card.ikhlas.title" = "سورة الإخلاص";
"discovery.card.ikhlas.meaning" = "قال النبي ﷺ إن ﴿قُلْ هُوَ اللَّهُ أَحَدٌ﴾ تعدل ثلث القرآن.";
"discovery.card.ikhlas.source" = "القرآن ١١٢ · صحيح البخاري ٥٠١٣";

"discovery.card.kursi.title" = "آية الكرسي";
"discovery.card.kursi.meaning" = "﴿اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ﴾. في حديث صحيح أُخبر من قرأها عند النوم أنه يُحفظ ولا يقربه شيطان حتى يصبح، وصدّق النبي ﷺ ذلك.";
"discovery.card.kursi.source" = "القرآن ٢:٢٥٥ · صحيح البخاري ٢٣١١";

"discovery.card.mercy.title" = "ارحموا الناس";
"discovery.card.mercy.meaning" = "قال النبي ﷺ: «لَا يَرْحَمُ اللَّهُ مَنْ لَا يَرْحَمُ النَّاسَ».";
"discovery.card.mercy.source" = "صحيح البخاري ٧٣٧٦ · صحيح مسلم ٢٣١٩";

"discovery.card.parents.title" = "فلا تقل لهما أفٍّ";
"discovery.card.parents.meaning" = "قال الله تعالى: ﴿وَقَضَىٰ رَبُّكَ أَلَّا تَعْبُدُوا إِلَّا إِيَّاهُ وَبِالْوَالِدَيْنِ إِحْسَانًا ۚ إِن يَبْلُغَنَّ عِندَكَ الْكِبَرَ أَحَدُهُمَا أَوْ كِلَاهُمَا فَلَا تَقُل لَّهُمَا أُفٍّ وَلَا تَنْهَرْهُمَا وَقُل لَّهُمَا قَوْلًا كَرِيمًا﴾.";
"discovery.card.parents.source" = "القرآن ١٧:٢٣";

"discovery.card.backbite.title" = "لا يغتب بعضكم بعضًا";
"discovery.card.backbite.meaning" = "قال الله تعالى: ﴿وَلَا تَجَسَّسُوا وَلَا يَغْتَب بَّعْضُكُم بَعْضًا ۚ أَيُحِبُّ أَحَدُكُمْ أَن يَأْكُلَ لَحْمَ أَخِيهِ مَيْتًا فَكَرِهْتُمُوهُ﴾.";
"discovery.card.backbite.source" = "القرآن ٤٩:١٢";

"discovery.card.inshaallah.title" = "قل إن شاء الله";
"discovery.card.inshaallah.meaning" = "قال الله تعالى: ﴿وَلَا تَقُولَنَّ لِشَيْءٍ إِنِّي فَاعِلٌ ذَٰلِكَ غَدًا ۝ إِلَّا أَن يَشَاءَ اللَّهُ﴾.";
"discovery.card.inshaallah.source" = "القرآن ١٨:٢٣–٢٤";

"discovery.card.purification.title" = "الطهور شطر الإيمان";
"discovery.card.purification.meaning" = "قال النبي ﷺ: «الطُّهُورُ شَطْرُ الْإِيمَانِ».";
"discovery.card.purification.source" = "صحيح مسلم ٢٢٣";

"discovery.card.conceal.title" = "من ستر مسلمًا ستره الله";
"discovery.card.conceal.meaning" = "قال النبي ﷺ: «وَمَنْ سَتَرَ مُسْلِمًا سَتَرَهُ اللَّهُ يَوْمَ الْقِيَامَةِ».";
"discovery.card.conceal.source" = "صحيح البخاري ٢٤٤٢ · صحيح مسلم ٢٥٨٠";

"discovery.card.night_prayer.title" = "صلاة الليل";
"discovery.card.night_prayer.meaning" = "قال النبي ﷺ: «أَفْضَلُ الصَّلَاةِ بَعْدَ الصَّلَاةِ الْمَكْتُوبَةِ الصَّلَاةُ فِي جَوْفِ اللَّيْلِ».";
"discovery.card.night_prayer.source" = "صحيح مسلم ١١٦٣";

"discovery.card.return_salam.title" = "حيوا بأحسن منها";
"discovery.card.return_salam.meaning" = "قال الله تعالى: ﴿وَإِذَا حُيِّيتُم بِتَحِيَّةٍ فَحَيُّوا بِأَحْسَنَ مِنْهَا أَوْ رُدُّوهَا ۗ إِنَّ اللَّهَ كَانَ عَلَىٰ كُلِّ شَيْءٍ حَسِيبًا﴾.";
"discovery.card.return_salam.source" = "القرآن ٤:٨٦";

"discovery.card.patience.title" = "استعينوا بالصبر والصلاة";
"discovery.card.patience.meaning" = "قال الله تعالى: ﴿يَا أَيُّهَا الَّذِينَ آمَنُوا اسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ ۚ إِنَّ اللَّهَ مَعَ الصَّابِرِينَ﴾.";
"discovery.card.patience.source" = "القرآن ٢:١٥٣";

"discovery.card.tawakkul.title" = "ومن يتوكل على الله فهو حسبه";
"discovery.card.tawakkul.meaning" = "قال الله تعالى: ﴿وَمَن يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ ۚ إِنَّ اللَّهَ بَالِغُ أَمْرِهِ﴾.";
"discovery.card.tawakkul.source" = "القرآن ٦٥:٣";

"discovery.card.istighfar.title" = "استغفر كثيرًا";
"discovery.card.istighfar.meaning" = "قال النبي ﷺ: «وَاللَّهِ إِنِّي لَأَسْتَغْفِرُ اللَّهَ وَأَتُوبُ إِلَيْهِ فِي الْيَوْمِ أَكْثَرَ مِنْ سَبْعِينَ مَرَّةً».";
"discovery.card.istighfar.source" = "صحيح البخاري ٦٣٠٧";

"discovery.card.wudu_sleep.title" = "نم على وضوء";
"discovery.card.wudu_sleep.meaning" = "قال النبي ﷺ: «إِذَا أَتَيْتَ مَضْجَعَكَ فَتَوَضَّأْ وُضُوءَكَ لِلصَّلَاةِ، ثُمَّ اضْطَجِعْ عَلَى شِقِّكَ الْأَيْمَنِ».";
"discovery.card.wudu_sleep.source" = "صحيح البخاري ٢٤٧ · صحيح مسلم ٢٧١٠";

"discovery.card.enter_home.title" = "اذكر الله إذا دخلت بيتك";
"discovery.card.enter_home.meaning" = "قال النبي ﷺ: «إِذَا دَخَلَ الرَّجُلُ بَيْتَهُ فَذَكَرَ اللَّهَ عِنْدَ دُخُولِهِ وَعِنْدَ طَعَامِهِ، قَالَ الشَّيْطَانُ: لَا مَبِيتَ لَكُمْ وَلَا عَشَاءَ».";
"discovery.card.enter_home.source" = "صحيح مسلم ٢٠١٨";

"discovery.card.lower_gaze.title" = "غض البصر";
"discovery.card.lower_gaze.meaning" = "قال الله تعالى: ﴿قُل لِّلْمُؤْمِنِينَ يَغُضُّوا مِنْ أَبْصَارِهِمْ وَيَحْفَظُوا فُرُوجَهُمْ ۚ ذَٰلِكَ أَزْكَىٰ لَهُمْ ۗ إِنَّ اللَّهَ خَبِيرٌ بِمَا يَصْنَعُونَ﴾.";
"discovery.card.lower_gaze.source" = "القرآن ٢٤:٣٠";

"discovery.card.upper_hand.title" = "اليد العليا خير من اليد السفلى";
"discovery.card.upper_hand.meaning" = "قال النبي ﷺ: «الْيَدُ الْعُلْيَا خَيْرٌ مِنَ الْيَدِ السُّفْلَى، وَالْيَدُ الْعُلْيَا هِيَ الْمُنْفِقَةُ، وَالسُّفْلَى هِيَ السَّائِلَةُ».";
"discovery.card.upper_hand.source" = "صحيح البخاري ١٤٢٧ · صحيح مسلم ١٠٣٣";

"discovery.card.fatiha.title" = "الفاتحة";
"discovery.card.fatiha.meaning" = "قال النبي ﷺ إن الله تعالى قال: «قَسَمْتُ الصَّلَاةَ بَيْنِي وَبَيْنَ عَبْدِي نِصْفَيْنِ». فإذا قال العبد: ﴿الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ﴾ قال الله: «حَمِدَنِي عَبْدِي».";
"discovery.card.fatiha.source" = "القرآن ١ · صحيح مسلم ٣٩٥";

"discovery.card.honor_guest.title" = "أكرم الضيف";
"discovery.card.honor_guest.meaning" = "قال النبي ﷺ: «مَنْ كَانَ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ فَلْيُكْرِمْ ضَيْفَهُ».";
"discovery.card.honor_guest.source" = "صحيح البخاري ٦٠١٨ · صحيح مسلم ٤٧";

"discovery.card.love_brother.title" = "أحب لأخيك ما تحب لنفسك";
"discovery.card.love_brother.meaning" = "قال النبي ﷺ: «لَا يُؤْمِنُ أَحَدُكُمْ حَتَّى يُحِبَّ لِأَخِيهِ مَا يُحِبُّ لِنَفْسِهِ».";
"discovery.card.love_brother.source" = "صحيح البخاري ١٣ · صحيح مسلم ٤٥";

"discovery.card.remember_me.title" = "فاذكروني أذكركم";
"discovery.card.remember_me.meaning" = "قال الله تعالى: ﴿فَاذْكُرُونِي أَذْكُرْكُمْ وَاشْكُرُوا لِي وَلَا تَكْفُرُونِ﴾.";
"discovery.card.remember_me.source" = "القرآن ٢:١٥٢";

"discovery.card.no_envy.title" = "لا تحاسدوا";
"discovery.card.no_envy.meaning" = "قال النبي ﷺ: «لَا تَحَاسَدُوا، وَلَا تَبَاغَضُوا، وَلَا تَدَابَرُوا، وَكُونُوا عِبَادَ اللَّهِ إِخْوَانًا».";
"discovery.card.no_envy.source" = "صحيح البخاري ٦٠٦٥ · صحيح مسلم ٢٥٦٣";

"discovery.card.truthfulness.title" = "الصدق يهدي إلى الجنة";
"discovery.card.truthfulness.meaning" = "قال النبي ﷺ: «إِنَّ الصِّدْقَ يَهْدِي إِلَى الْبِرِّ، وَإِنَّ الْبِرَّ يَهْدِي إِلَى الْجَنَّةِ، وَإِنَّ الرَّجُلَ لَيَصْدُقُ حَتَّى يُكْتَبَ عِنْدَ اللَّهِ صِدِّيقًا».";
"discovery.card.truthfulness.source" = "صحيح البخاري ٦٠٩٤ · صحيح مسلم ٢٦٠٧";

"discovery.card.ghusl_friday.title" = "غسل الجمعة";
"discovery.card.ghusl_friday.meaning" = "قال النبي ﷺ: «غُسْلُ يَوْمِ الْجُمُعَةِ وَاجِبٌ عَلَى كُلِّ مُحْتَلِمٍ».";
"discovery.card.ghusl_friday.source" = "صحيح البخاري ٨٧٩ · صحيح مسلم ٨٤٦";

"discovery.card.speak_good.title" = "فليقل خيرًا أو ليصمت";
"discovery.card.speak_good.meaning" = "قال النبي ﷺ: «مَنْ كَانَ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ فَلْيَقُلْ خَيْرًا أَوْ لِيَصْمُتْ».";
"discovery.card.speak_good.source" = "صحيح البخاري ٦٠١٨ · صحيح مسلم ٤٧";

"discovery.card.fajr_sunnah.title" = "ركعتا الفجر";
"discovery.card.fajr_sunnah.meaning" = "قال النبي ﷺ: «رَكْعَتَا الْفَجْرِ خَيْرٌ مِنَ الدُّنْيَا وَمَا فِيهَا».";
"discovery.card.fajr_sunnah.source" = "صحيح مسلم ٧٢٥";

"discovery.card.haya.title" = "الحياء شعبة من الإيمان";
"discovery.card.haya.meaning" = "قال النبي ﷺ: «الْحَيَاءُ شُعْبَةٌ مِنَ الْإِيمَانِ».";
"discovery.card.haya.source" = "صحيح البخاري ٩ · صحيح مسلم ٣٥";

"discovery.card.no_burden.title" = "لا يكلف الله نفسًا إلا وسعها";
"discovery.card.no_burden.meaning" = "قال الله تعالى: ﴿لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا﴾.";
"discovery.card.no_burden.source" = "القرآن ٢:٢٨٦";

"discovery.card.mankind.title" = "أكرمكم عند الله أتقاكم";
"discovery.card.mankind.meaning" = "قال الله تعالى: ﴿يَا أَيُّهَا النَّاسُ إِنَّا خَلَقْنَاكُم مِّن ذَكَرٍ وَأُنثَىٰ وَجَعَلْنَاكُمْ شُعُوبًا وَقَبَائِلَ لِتَعَارَفُوا ۚ إِنَّ أَكْرَمَكُمْ عِندَ اللَّهِ أَتْقَاكُمْ﴾.";
"discovery.card.mankind.source" = "القرآن ٤٩:١٣";

