"knowledge.card.smile_sadaqah.title" = "Ein Lächeln ist Sadaqa";
"knowledge.card.smile_sadaqah.arabic" = "تَبَسُّمُكَ فِي وَجْهِ أَخِيكَ صَدَقَةٌ";
"knowledge.card.smile_sadaqah.body" = "Der Prophet ﷺ sagte, dein Lächeln zu deinem Bruder sei Sadaqa. Ein kleines Gesicht, eine echte Tat.";
"knowledge.card.smile_sadaqah.source" = "Jami' at-Tirmidhi 1956";

"knowledge.card.bismillah_food.title" = "Beginne mit Bismillah";
"knowledge.card.bismillah_food.arabic" = "بِسْمِ اللَّهِ";
"knowledge.card.bismillah_food.body" = "Beginne Essen und Trinken mit Allahs Namen. Vergisst du es am Anfang, sag Bismillah am Anfang und am Ende.";
"knowledge.card.bismillah_food.source" = "Sunan Abi Dawud 3767";

"knowledge.card.right_hand.title" = "Iss mit der rechten Hand";
"knowledge.card.right_hand.arabic" = "";
"knowledge.card.right_hand.body" = "Der Prophet ﷺ lehrte uns, mit der rechten Hand zu essen und zu trinken. Eine stille Sunna bei jeder Mahlzeit.";
"knowledge.card.right_hand.source" = "Sahih Muslim 2020";

"knowledge.card.remove_harm.title" = "Entferne Schaden vom Weg";
"knowledge.card.remove_harm.arabic" = "";
"knowledge.card.remove_harm.body" = "Etwas Schädliches vom Weg zu nehmen ist ein Zweig des Glaubens. Iman hat Taten, die du im Gehen tun kannst.";
"knowledge.card.remove_harm.source" = "Sahih Muslim 35";

"knowledge.card.greet_salam.title" = "Verbreite den Salam";
"knowledge.card.greet_salam.arabic" = "السَّلَامُ عَلَيْكُمْ";
"knowledge.card.greet_salam.body" = "Grüße, wen du kennst und wen du nicht kennst. Den Salam zu verbreiten gehört zum Islam.";
"knowledge.card.greet_salam.source" = "Sahih al-Bukhari 28 · Sahih Muslim 39";

"knowledge.card.miswak.title" = "Der Siwak";
"knowledge.card.miswak.arabic" = "";
"knowledge.card.miswak.body" = "Der Siwak reinigt den Mund und erfreut den Herrn. Ein kleiner Stock, eine geliebte Sunna.";
"knowledge.card.miswak.source" = "Sahih al-Bukhari 1934";

"knowledge.card.anger_sit.title" = "Wenn Zorn steigt, setz dich";
"knowledge.card.anger_sit.arabic" = "";
"knowledge.card.anger_sit.body" = "Stehst du, setz dich. Sitzst du, leg dich hin. Zorn kommt vom Shaytan — ändere deine Haltung, bevor er dich ändert.";
"knowledge.card.anger_sit.source" = "Sunan Abi Dawud 4782";

"knowledge.card.even_date.title" = "Sogar eine halbe Dattel";
"knowledge.card.even_date.arabic" = "";
"knowledge.card.even_date.body" = "Schütze dich vor dem Feuer, selbst mit einer halben Dattel als Sadaqa. Keine Gabe ist zu klein, wenn sie aufrichtig ist.";
"knowledge.card.even_date.source" = "Sahih al-Bukhari 1417";

"knowledge.card.ayatul_kursi.title" = "Ayat al-Kursi";
"knowledge.card.ayatul_kursi.arabic" = "اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ";
"knowledge.card.ayatul_kursi.body" = "Sprich sie nach jedem Gebet und vor dem Schlafen. Ein Vers des Schutzes, eine Nacht unter Allahs Obhut.";
"knowledge.card.ayatul_kursi.source" = "Koran 2:255 · Sahih al-Bukhari 2311";

"knowledge.card.ikhlas.title" = "Sure al-Ichlas";
"knowledge.card.ikhlas.arabic" = "قُلْ هُوَ اللَّهُ أَحَدٌ";
"knowledge.card.ikhlas.body" = "Gleich einem Drittel des Korans an Lohn. Wenige Zeilen auf der Zunge, ein großes Gewicht bei Allah.";
"knowledge.card.ikhlas.source" = "Sahih al-Bukhari 5013";

"knowledge.card.wudu_sleep.title" = "Schlaf mit Wudu";
"knowledge.card.wudu_sleep.arabic" = "";
"knowledge.card.wudu_sleep.body" = "Der Prophet ﷺ riet, mit Wudu schlafen zu gehen. Beende den Tag, wie du ihn begannst: rein für Allah.";
"knowledge.card.wudu_sleep.source" = "Sahih al-Bukhari 247";

"knowledge.card.visit_sick.title" = "Besuche den Kranken";
"knowledge.card.visit_sick.arabic" = "";
"knowledge.card.visit_sick.body" = "Kranke zu besuchen ist ein Recht des Muslims gegenüber dem Muslim. Dasein ist eine Tat, nicht nur Worte.";
"knowledge.card.visit_sick.source" = "Sahih Muslim 2162";

