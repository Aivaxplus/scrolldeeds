"conv_paywall.social.based_on" = "Basierend auf App-Store-Bewertungen";
"conv_paywall.review1.title" = "Perfekt";
"conv_paywall.review1.body" = "Ich bin kürzlich auf Premium gewechselt und es ist ein Gamechanger. Ich hatte ständig mit Doomscrolling zu kämpfen, aber diese App hat mir wirklich geholfen, die Gewohnheit zu durchbrechen und die Kontrolle über meine Zeit zurückzugewinnen. Wirklich dankbar.. Danke!";
"conv_paywall.review2.title" = "Ich liebe diese Idee";
"conv_paywall.review2.body" = "Als ich die Werbung gehört habe, war ich sofort hooked. Ich wollte immer mein Deen verbessern und nutze mein Handy viel. Ich liebe die App. Vielen Dank und möge Allah die Entwickler für diese Idee segnen. Thank you 🤍";
"conv_paywall.review3.title" = "Gut";
"conv_paywall.review3.body" = "Eine gute Erinnerung";
"conv_paywall.close.title" = "Es ist endlich Zeit, Scrollen in Taten zu verwandeln.";
"conv_paywall.close.title_named" = "%@, es ist endlich Zeit, Scrollen in Taten zu verwandeln.";
"conv_paywall.close.subtitle" = "Insha’Allah, wenn du bei deinem Vorsatz bleibst, fühlt sich dein Leben verwandelt an bis";
"conv_paywall.faq.header" = "Häufigste Fragen";
"conv_paywall.faq.q1" = "Funktioniert das wirklich?";
"conv_paywall.faq.a1" = "Ja. Echtes iOS-Sperren erzwingt die Pause. Eine gute Tat bringt Münzen, und ein Herz öffnet deine Apps. Diese Schleife ändert die Gewohnheit, insha’Allah.";
"conv_paywall.faq.q2" = "Warum wurde Nafsi geschaffen?";
"conv_paywall.faq.a2" = "Weil Doomscrolling Ibadah, Fokus und Frieden stiehlt. Wir bauten ein klares System: Apps sperren, bis du eine gute Tat tust.";
"conv_paywall.faq.q3" = "Wird die App weiter verbessert?";
"conv_paywall.faq.a3" = "Ja. Wir liefern regelmäßig Updates und bleiben dabei, Muslimen dauerhafte Gewohnheiten zu ermöglichen.";
"conv_paywall.faq.q4" = "Wer hat Nafsi gemacht?";
"conv_paywall.faq.a4" = "Assalamu alaikum — ich bin Sabri, der Gründer. Ich baute Nafsi zuerst für mich, dann für jeden Muslim im selben Kampf.";
"conv_paywall.faq.q5" = "Wie ist Nafsi anders?";
"conv_paywall.faq.a5" = "Wir messen nicht nur Bildschirmzeit. Wir machen Ablenkung zu Taten — mit echter iOS-App-Sperre und spirituellen Freischaltungen.";
"conv_paywall.sticky_cta" = "Bismillah, mach den Schritt";
"conv_paywall.team.header" = "Sperre das Handy. Steh auf zum Fajr. Beherrsche deine Nafs.";
"conv_paywall.team.body" = "Nafsi sperrt deine Apps bis zu einer guten Tat und weckt dich zum Fajr, bis du den Gegenstand fotografierst, den du gewählt hast. So übernimmst du Kontrolle über deine Nafs — nicht später, jetzt.\n\nSperre. Tat. Fajr. Updates, die das System ehrlich halten.";
"conv_paywall.team.body_named" = "%@, Nafsi sperrt deine Apps bis zu einer guten Tat und weckt dich zum Fajr, bis du den Gegenstand fotografierst, den du gewählt hast. So übernimmst du Kontrolle über deine Nafs — nicht später, jetzt.\n\nSperre. Tat. Fajr. Updates, die das System ehrlich halten.";
