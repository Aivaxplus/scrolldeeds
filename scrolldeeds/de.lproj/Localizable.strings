"discovery.card.fact_word_muhammad.title" = "Muhammad wird 4-mal genannt";
"discovery.card.fact_word_muhammad.meaning" = "Der Name Muhammad ﷺ steht 4-mal im Koran. In 61:6 wird er auch Ahmad genannt.";
