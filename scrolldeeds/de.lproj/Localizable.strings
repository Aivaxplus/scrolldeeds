/* Discovery feed expansion */
"discovery.card.shukr.title" = "Wenn ihr dankbar seid, mehre Ich euch";
"discovery.card.shukr.meaning" = "Allah sagt: „Wenn ihr dankbar seid, werde Ich euch ganz gewiss mehren; wenn ihr aber verleugnet, ist Meine Strafe streng.“";
"discovery.card.shukr.source" = "Qur’an 14:7";

"discovery.card.dua_near.title" = "Ich bin nahe";
"discovery.card.dua_near.meaning" = "Allah sagt: „Wenn Meine Diener dich nach Mir fragen: Ich bin nahe. Ich erhöre den Ruf des Rufenden, wenn er Mich anruft.“";
"discovery.card.dua_near.source" = "Qur’an 2:186";

"discovery.card.no_despair.title" = "Verzweifelt nicht an Allahs Barmherzigkeit";
"discovery.card.no_despair.meaning" = "Allah sagt: „Sprich: O Meine Diener, die ihr gegen euch selbst maßlos wart, verzweifelt nicht an der Barmherzigkeit Allahs. Wahrlich, Allah vergibt alle Sünden.“";
"discovery.card.no_despair.source" = "Qur’an 39:53";

"discovery.card.qadr.title" = "Die Nacht der Bestimmung";
"discovery.card.qadr.meaning" = "Allah sagt: „Die Nacht der Bestimmung ist besser als tausend Monate.“";
"discovery.card.qadr.source" = "Qur’an 97:3";

"discovery.card.duha_care.title" = "Dein Herr hat dich nicht verlassen";
"discovery.card.duha_care.meaning" = "Allah sagt: „Dein Herr hat dich nicht verlassen und ist nicht unzufrieden. Das Letzte ist besser für dich als das Erste. Dein Herr wird dir geben, und du wirst zufrieden sein.“";
"discovery.card.duha_care.source" = "Qur’an 93:3–5";

"discovery.card.asr.title" = "Bei der Zeit: der Mensch ist im Verlust";
"discovery.card.asr.meaning" = "Allah sagt: „Bei der Zeit! Wahrlich, der Mensch ist im Verlust — außer denen, die glauben, rechtschaffen handeln und einander zur Wahrheit und zur Geduld ermahnen.“";
"discovery.card.asr.source" = "Qur’an 103:1–3";

"discovery.card.kawthar.title" = "Wir haben dir al-Kawthar gegeben";
"discovery.card.kawthar.meaning" = "Allah sagt: „Wir haben dir al-Kawthar gegeben. So bete zu deinem Herrn und opfere.“";
"discovery.card.kawthar.source" = "Qur’an 108:1–2";

"discovery.card.no_compulsion.title" = "Kein Zwang im Glauben";
"discovery.card.no_compulsion.meaning" = "Allah sagt: „Kein Zwang im Glauben. Der rechte Weg ist klar vom Irrtum unterschieden.“";
"discovery.card.no_compulsion.source" = "Qur’an 2:256";

"discovery.card.with_you.title" = "Er ist mit euch, wo ihr auch seid";
"discovery.card.with_you.meaning" = "Allah sagt: „Er ist mit euch, wo immer ihr seid. Und Allah sieht, was ihr tut.“";
"discovery.card.with_you.source" = "Qur’an 57:4";

"discovery.card.closer.title" = "Näher als die Halsschlagader";
"discovery.card.closer.meaning" = "Allah sagt: „Wir haben den Menschen erschaffen und Wir wissen, was seine Seele ihm zuflüstert, und Wir sind ihm näher als seine Halsschlagader.“";
"discovery.card.closer.source" = "Qur’an 50:16";

"discovery.card.spouses.title" = "Zuneigung und Barmherzigkeit zwischen euch";
"discovery.card.spouses.meaning" = "Allah sagt: „Er schuf euch aus euch selbst Gattinnen, damit ihr bei ihnen Ruhe findet, und Er legte Zuneigung und Barmherzigkeit zwischen euch.“";
"discovery.card.spouses.source" = "Qur’an 30:21";

"discovery.card.blessings_count.title" = "Ihr könnt Allahs Gaben nicht zählen";
"discovery.card.blessings_count.meaning" = "Allah sagt: „Wenn ihr die Gnade Allahs zählen wolltet, könntet ihr sie nicht aufzählen. Wahrlich, Allah ist Vergebend, Barmherzig.“";
"discovery.card.blessings_count.source" = "Qur’an 16:18";

"discovery.card.fasting_prescribed.title" = "Das Fasten ist euch vorgeschrieben";
"discovery.card.fasting_prescribed.meaning" = "Allah sagt: „O die ihr glaubt, das Fasten ist euch vorgeschrieben, wie es denen vor euch vorgeschrieben war, auf dass ihr gottesfürchtig werdet.“";
"discovery.card.fasting_prescribed.source" = "Qur’an 2:183";

"discovery.card.yunus_dua.title" = "Es gibt keinen Gott außer Dir";
"discovery.card.yunus_dua.meaning" = "Allah sagt, dass Yunus in der Finsternis rief: „Es gibt keinen Gott außer Dir. Gepriesen seist Du. Ich gehörte zu den Ungerechten.“";
"discovery.card.yunus_dua.source" = "Qur’an 21:87";

"discovery.card.hasbuna.title" = "Allah genügt uns";
"discovery.card.hasbuna.meaning" = "Allah sagt, dass jene, deren Glaube zunahm, sprachen: „Allah genügt uns, und Er ist der beste Sachwalter.“";
"discovery.card.hasbuna.source" = "Qur’an 3:173";

"discovery.card.rabbana_atina.title" = "Gutes im Diesseits und im Jenseits";
"discovery.card.rabbana_atina.meaning" = "Allah sagt: „Unser Herr, gib uns Gutes in dieser Welt und Gutes im Jenseits, und bewahre uns vor der Strafe des Feuers.“";
"discovery.card.rabbana_atina.source" = "Qur’an 2:201";

"discovery.card.be_and_it_is.title" = "Sei — und es ist";
"discovery.card.be_and_it_is.meaning" = "Allah sagt: „Sein Befehl, wenn Er eine Sache will, ist nur, dass Er zu ihr sagt: ‚Sei,‘ und sie ist.“";
"discovery.card.be_and_it_is.source" = "Qur’an 36:82";

"discovery.card.which_favors.title" = "Welche Gaben eures Herrn?";
"discovery.card.which_favors.meaning" = "Allah sagt: „Welche der Gaben eures Herrn wollt ihr beide da leugnen?“";
"discovery.card.which_favors.source" = "Qur’an 55:13";

"discovery.card.calamity.title" = "Kein Unglück außer mit Allahs Erlaubnis";
"discovery.card.calamity.meaning" = "Allah sagt: „Kein Unglück trifft ein, außer mit Allahs Erlaubnis. Und wer an Allah glaubt — dem leitet Er das Herz.“";
"discovery.card.calamity.source" = "Qur’an 64:11";

"discovery.card.death_life.title" = "Er schuf den Tod und das Leben";
"discovery.card.death_life.meaning" = "Allah sagt: „Der den Tod und das Leben erschuf, um euch zu prüfen, wer von euch am besten handelt — und Er ist der Mächtige, der Vergebende.“";
"discovery.card.death_life.source" = "Qur’an 67:2";

"discovery.card.kafirun.title" = "Euch eure Religion, mir die meine";
"discovery.card.kafirun.meaning" = "Allah sagt: „Euch eure Religion, und mir meine Religion.“";
"discovery.card.kafirun.source" = "Qur’an 109:6";

"discovery.card.nas.title" = "Ich suche Zuflucht beim Herrn der Menschen";
"discovery.card.nas.meaning" = "Allah sagt: „Sprich: Ich suche Zuflucht beim Herrn der Menschen, dem König der Menschen, dem Gott der Menschen.“";
"discovery.card.nas.source" = "Qur’an 114:1–3";

"discovery.card.falaq.title" = "Ich suche Zuflucht beim Herrn des Tagesanbruchs";
"discovery.card.falaq.meaning" = "Allah sagt: „Sprich: Ich suche Zuflucht beim Herrn des Tagesanbruchs, vor dem Übel dessen, was Er erschaffen hat.“";
"discovery.card.falaq.source" = "Qur’an 113:1–2";

"discovery.card.orphans_duha.title" = "Unterdrücke die Waise nicht";
"discovery.card.orphans_duha.meaning" = "Allah sagt: „Was die Waise betrifft, so unterdrücke sie nicht. Und was den Bittenden betrifft, so weise ihn nicht ab. Und was die Gnade deines Herrn betrifft, so verkünde sie.“";
"discovery.card.orphans_duha.source" = "Qur’an 93:9–11";

"discovery.card.justice.title" = "Steht fest für Gerechtigkeit";
"discovery.card.justice.meaning" = "Allah sagt: „O die ihr glaubt, seid unbeirrt gerecht, Zeugen für Allah, und sei es gegen euch selbst oder gegen Eltern und Verwandte.“";
"discovery.card.justice.source" = "Qur’an 4:135";

"discovery.card.amanah.title" = "Gebt das Anvertraute zurück";
"discovery.card.amanah.meaning" = "Allah sagt: „Allah befiehlt euch, anvertraute Güter den Berechtigten zurückzugeben, und wenn ihr zwischen Menschen richtet, in Gerechtigkeit zu richten.“";
"discovery.card.amanah.source" = "Qur’an 4:58";

"discovery.card.luqman_salah.title" = "Verrichte das Gebet, mein Sohn";
"discovery.card.luqman_salah.meaning" = "Luqman sagte: „O mein lieber Sohn, verrichte das Gebet, gebiete das Rechte, verbiete das Verwerfliche und sei geduldig gegenüber dem, was dich trifft.“";
"discovery.card.luqman_salah.source" = "Qur’an 31:17";

"discovery.card.infaq_grain.title" = "Das Gleichnis des Spendens";
"discovery.card.infaq_grain.meaning" = "Allah sagt: „Das Gleichnis derer, die ihr Vermögen auf dem Weg Allahs ausgeben, ist wie ein Korn, das sieben Ähren treibt, in jeder Ähre hundert Körner. Allah vervielfacht, wem Er will.“";
"discovery.card.infaq_grain.source" = "Qur’an 2:261";

"discovery.card.rabbana_forgive.title" = "Nimm uns nicht zur Rechenschaft, wenn wir vergessen";
"discovery.card.rabbana_forgive.meaning" = "Allah sagt: „Unser Herr, nimm uns nicht zur Rechenschaft, wenn wir vergessen oder uns irren. Unser Herr, lege uns keine Last auf wie die, die Du denen vor uns auferlegt hast.“";
"discovery.card.rabbana_forgive.source" = "Qur’an 2:286";

"discovery.card.establish_salah.title" = "Verrichtet das Gebet und gebt die Zakah";
"discovery.card.establish_salah.meaning" = "Allah sagt: „Verrichtet das Gebet und entrichtet die Zakah und verneigt euch mit den sich Verneigenden.“";
"discovery.card.establish_salah.source" = "Qur’an 2:43";

"discovery.card.way_out.title" = "Wer Taqwa hat, dem macht Allah einen Ausweg";
"discovery.card.way_out.meaning" = "Allah sagt: „Wer Allah fürchtet — dem macht Er einen Ausweg und versorgt ihn von wo er nicht damit rechnet.“";
"discovery.card.way_out.source" = "Qur’an 65:2–3";

"discovery.card.sincere_deen.title" = "Dient Allah, aufrichtig in der Religion";
"discovery.card.sincere_deen.meaning" = "Allah sagt: „Ihnen wurde nur befohlen, Allah zu dienen, Ihm die Religion aufrichtig weihend, sich zur Wahrheit neigend, das Gebet zu verrichten und die Zakah zu geben.“";
"discovery.card.sincere_deen.source" = "Qur’an 98:5";

"discovery.card.allah_light.title" = "Allah ist das Licht der Himmel und der Erde";
"discovery.card.allah_light.meaning" = "Allah sagt: „Allah ist das Licht der Himmel und der Erde.“";
"discovery.card.allah_light.source" = "Qur’an 24:35";

"discovery.card.expand_chest.title" = "Haben Wir dir nicht die Brust geweitet?";
"discovery.card.expand_chest.meaning" = "Allah sagt: „Haben Wir dir nicht die Brust geweitet und von dir deine Last genommen, die deinen Rücken drückte, und dein Gedenken erhöht?“";
"discovery.card.expand_chest.source" = "Qur’an 94:1–4";

"discovery.card.hikmah.title" = "Er gibt Weisheit, wem Er will";
"discovery.card.hikmah.meaning" = "Allah sagt: „Er gibt Weisheit, wem Er will; und wem Weisheit gegeben wird, dem ist wahrlich viel Gutes gegeben.“";
"discovery.card.hikmah.source" = "Qur’an 2:269";

"discovery.card.five_pillars.title" = "Der Islam ist auf fünf gebaut";
"discovery.card.five_pillars.meaning" = "Der Prophet ﷺ sagte: „Der Islam ist auf fünf gebaut: dem Zeugnis, dass es keinen Gott gibt außer Allah und dass Muhammad der Gesandte Allahs ist, dem Verrichten des Gebets, dem Geben der Zakah, der Hadsch und dem Fasten im Ramadan.“";
"discovery.card.five_pillars.source" = "Sahih al-Bukhari 8 · Sahih Muslim 16";

"discovery.card.muslim_tongue.title" = "Sicher vor seiner Zunge und Hand";
"discovery.card.muslim_tongue.meaning" = "Der Prophet ﷺ sagte: „Der Muslim ist der, vor dessen Zunge und Hand die Muslime sicher sind.“";
"discovery.card.muslim_tongue.source" = "Sahih al-Bukhari 10 · Sahih Muslim 41";

"discovery.card.deen_nasihah.title" = "Die Religion ist aufrichtiger Rat";
"discovery.card.deen_nasihah.meaning" = "Der Prophet ﷺ sagte: „Die Religion ist Nasiha (aufrichtiger Rat).“ Sie sagten: Wem gegenüber? Er sagte: „Allah, Seinem Buch, Seinem Gesandten, den Führern der Muslime und ihrer Allgemeinheit.“";
"discovery.card.deen_nasihah.source" = "Sahih Muslim 55";

"discovery.card.best_quran.title" = "Die Besten von euch lernen den Qur’an und lehren ihn";
"discovery.card.best_quran.meaning" = "Der Prophet ﷺ sagte: „Die Besten von euch sind jene, die den Qur’an lernen und ihn lehren.“";
"discovery.card.best_quran.source" = "Sahih al-Bukhari 5027";

"discovery.card.mother_first.title" = "Deine Mutter, dann deine Mutter";
"discovery.card.mother_first.meaning" = "Ein Mann fragte: Wer hat am meisten Anspruch auf meine gute Gesellschaft? Der Prophet ﷺ sagte: „Deine Mutter.“ Er sagte: Dann wer? Er sagte: „Deine Mutter.“ Er sagte: Dann wer? Er sagte: „Deine Mutter.“ Er sagte: Dann wer? Er sagte: „Dein Vater.“";
"discovery.card.mother_first.source" = "Sahih al-Bukhari 5971 · Sahih Muslim 2548";

"discovery.card.plant_tree.title" = "Ein gepflanzter Baum ist Sadaqa";
"discovery.card.plant_tree.meaning" = "Der Prophet ﷺ sagte: „Niemals pflanzt ein Muslim einen Baum oder sät eine Saat, und ein Vogel, ein Mensch oder ein Tier isst davon, ohne dass es Sadaqa für ihn ist.“";
"discovery.card.plant_tree.source" = "Sahih Muslim 1553";

"discovery.card.seven_shade.title" = "Sieben im Schatten Allahs";
"discovery.card.seven_shade.meaning" = "Der Prophet ﷺ sagte: „Sieben wird Allah am Tag beschatten, an dem es keinen Schatten gibt außer Seinem: ein gerechter Herrscher; ein Jugendlicher, der in der Anbetung Allahs aufwuchs; ein Mann, dessen Herz an der Moschee hängt; zwei, die einander um Allahs willen lieben; ein Mann, den eine Frau von Rang und Schönheit einlädt und der sagt: ‚Ich fürchte Allah‘; wer so verborgen spendet, dass seine Linke nicht weiß, was seine Rechte ausgibt; und wer Allah im Verborgenen gedenkt und dessen Augen überlaufen.“";
"discovery.card.seven_shade.source" = "Sahih al-Bukhari 1423 · Sahih Muslim 1031";

"discovery.card.tasbih_salah.title" = "Nach dem Gebet: 33, 33, 34";
"discovery.card.tasbih_salah.meaning" = "Der Prophet ﷺ lehrte nach dem Salah: Subhan Allah dreiunddreißigmal, al-hamdu lillah dreiunddreißigmal und Allahu akbar vierunddreißigmal.";
"discovery.card.tasbih_salah.source" = "Sahih Muslim 596";

"discovery.card.hundred_tasbih.title" = "Hundertmal am Tag";
"discovery.card.hundred_tasbih.meaning" = "Der Prophet ﷺ sagte: „Wer ‚Gepriesen sei Allah und Ihm gebührt das Lob‘ hundertmal am Tag sagt, dem werden seine Sünden vergeben, selbst wenn sie wie der Schaum des Meeres sind.“";
"discovery.card.hundred_tasbih.source" = "Sahih al-Bukhari 6405 · Sahih Muslim 2691";

"discovery.card.enter_masjid.title" = "Wenn du die Moschee betrittst";
"discovery.card.enter_masjid.meaning" = "Der Prophet ﷺ sagte: wenn einer von euch die Moschee betritt, soll er sagen: „O Allah, öffne mir die Tore Deiner Barmherzigkeit.“";
"discovery.card.enter_masjid.source" = "Sahih Muslim 713";

"discovery.card.do_not_anger.title" = "Werde nicht zornig";
"discovery.card.do_not_anger.meaning" = "Ein Mann sagte zum Propheten ﷺ: Rate mir. Er sagte: „Werde nicht zornig.“ Der Mann wiederholte seine Bitte mehrmals, und er sagte: „Werde nicht zornig.“";
"discovery.card.do_not_anger.source" = "Sahih al-Bukhari 6116";

"discovery.card.make_easy.title" = "Macht es leicht";
"discovery.card.make_easy.meaning" = "Der Prophet ﷺ sagte: „Macht es leicht und macht es nicht schwer. Verkündet frohe Botschaft und stoßt die Menschen nicht ab.“";
"discovery.card.make_easy.source" = "Sahih al-Bukhari 69";

"discovery.card.religion_ease.title" = "Die Religion ist Leichtigkeit";
"discovery.card.religion_ease.meaning" = "Der Prophet ﷺ sagte: „Die Religion ist Leichtigkeit. Niemand macht sie sich schwer, ohne dass sie ihn überwindet. Seid daher maßvoll, gebt euer Bestes, freut euch, und sucht Hilfe am Morgen, am Nachmittag und ein wenig in der Nacht.“";
"discovery.card.religion_ease.source" = "Sahih al-Bukhari 39";

"discovery.card.feed_hungry.title" = "Speist den Hungernden";
"discovery.card.feed_hungry.meaning" = "Der Prophet ﷺ sagte: „Speist den Hungernden, besucht den Kranken und befreit den Gefangenen.“";
"discovery.card.feed_hungry.source" = "Sahih al-Bukhari 5373";

"discovery.card.good_word.title" = "Ein gutes Wort ist Sadaqa";
"discovery.card.good_word.meaning" = "Der Prophet ﷺ sagte: „Ein gutes Wort ist Sadaqa.“";
"discovery.card.good_word.source" = "Sahih al-Bukhari 2989 · Sahih Muslim 1009";

"discovery.card.no_cheating.title" = "Wer betrügt, gehört nicht zu uns";
"discovery.card.no_cheating.meaning" = "Der Prophet ﷺ sagte: „Wer uns betrügt, gehört nicht zu uns.“";
"discovery.card.no_cheating.source" = "Sahih Muslim 102";

"discovery.card.sleep_muawwidhat.title" = "Die letzten drei Suren vor dem Schlaf";
"discovery.card.sleep_muawwidhat.meaning" = "Aischa berichtete: Wenn der Prophet ﷺ zu Bett ging, nahm er seine Hände zusammen, blies hinein, rezitierte al-Ichlas, al-Falaq und an-Nas und strich dann über seinen Körper.";
"discovery.card.sleep_muawwidhat.source" = "Sahih al-Bukhari 5017";

"discovery.card.treat_women.title" = "Fürchtet Allah hinsichtlich der Frauen";
"discovery.card.treat_women.meaning" = "Der Prophet ﷺ sagte in der Abschiedspredigt: „Fürchtet Allah hinsichtlich der Frauen, denn ihr habt sie als anvertrautes Gut von Allah genommen, und der Umgang mit ihnen wurde euch durch das Wort Allahs erlaubt.“";
"discovery.card.treat_women.source" = "Sahih Muslim 1218";

"discovery.card.wudu_sins.title" = "Wudu wäscht Sünden ab";
"discovery.card.wudu_sins.meaning" = "Der Prophet ﷺ sagte: wenn ein Muslim — oder ein Gläubiger — Wudu verrichtet und sein Gesicht wäscht, geht mit dem Wasser jede Sünde fort, die er mit seinen Augen anblickte, oder mit dem letzten Tropfen; wenn er seine Hände wäscht, gehen die Sünden seiner Hände fort; wenn er seine Füße wäscht, gehen die Sünden fort, zu denen seine Füße gingen — bis er gereinigt von Sünde hinausgeht.";
"discovery.card.wudu_sins.source" = "Sahih Muslim 244";

/* BEGIN DISCOVERY EXPANSION */
"discovery.card.ayah_1_1.title" = "Al-Faatiha 1";
"discovery.card.ayah_1_1.meaning" = "Im Namen Allahs, des Allerbarmers, des Barmherzigen.";
"discovery.card.ayah_1_1.source" = "Qur’an 1:1";

"discovery.card.ayah_1_4.title" = "Al-Faatiha 4";
"discovery.card.ayah_1_4.meaning" = "dem Herrscher am Tag des Gerichts.";
"discovery.card.ayah_1_4.source" = "Qur’an 1:4";

"discovery.card.ayah_1_5.title" = "Al-Faatiha 5";
"discovery.card.ayah_1_5.meaning" = "Dir allein dienen wir, und zu Dir allein flehen wir um Hilfe.";
"discovery.card.ayah_1_5.source" = "Qur’an 1:5";

"discovery.card.ayah_1_6.title" = "Al-Faatiha 6";
"discovery.card.ayah_1_6.meaning" = "Leite uns den geraden Weg,";
"discovery.card.ayah_1_6.source" = "Qur’an 1:6";

"discovery.card.ayah_1_7.title" = "Al-Faatiha 7";
"discovery.card.ayah_1_7.meaning" = "den Weg derjenigen, denen Du Gunst erwiesen hast, nicht derjenigen, die (Deinen) Zorn erregt haben, und nicht der Irregehenden!";
"discovery.card.ayah_1_7.source" = "Qur’an 1:7";

"discovery.card.ayah_2_2.title" = "Al-Baqara 2";
"discovery.card.ayah_2_2.meaning" = "Dieses Buch, an dem es keinen Zweifel gibt, ist eine Rechtleitung für die Gottesfürchtigen,";
"discovery.card.ayah_2_2.source" = "Qur’an 2:2";

"discovery.card.ayah_2_21.title" = "Al-Baqara 21";
"discovery.card.ayah_2_21.meaning" = "O ihr Menschen! Dient eurem Herrn, Der euch und diejenigen vor euch erschaffen hat, auf daß ihr gottesfürchtig werden möget!";
"discovery.card.ayah_2_21.source" = "Qur’an 2:21";

"discovery.card.ayah_2_45.title" = "Al-Baqara 45";
"discovery.card.ayah_2_45.meaning" = "Und sucht Hilfe in der Standhaftigkeit und im Gebet! Es ist freilich schwer, nur nicht für die Demütigen,";
"discovery.card.ayah_2_45.source" = "Qur’an 2:45";

"discovery.card.ayah_2_155.title" = "Al-Baqara 155";
"discovery.card.ayah_2_155.meaning" = "Und Wir werden euch ganz gewiß mit ein wenig Furcht und Hunger und Mangel an Besitz, Seelen und Früchten prüfen. Doch verkünde frohe Botschaft den Standhaften,";
"discovery.card.ayah_2_155.source" = "Qur’an 2:155";

"discovery.card.ayah_2_165.title" = "Al-Baqara 165";
"discovery.card.ayah_2_165.meaning" = "Und doch gibt es unter den Menschen manche, die außer Allah andere als Seinesgleichen annehmen und ihnen dieselbe Liebe schenken wie Allah. Aber die Gläubigen sind stärker in ihrer Liebe zu Allah. Und wenn doch diejenigen, die Unrecht tun, wenn sie der Strafe angesichtig werden, erkennen würden, daß alle Stärke Allah gehört und daß Allah streng im Strafen ist.";
"discovery.card.ayah_2_165.source" = "Qur’an 2:165";

"discovery.card.ayah_2_177.title" = "Al-Baqara 177";
"discovery.card.ayah_2_177.meaning" = "Nicht darin besteht die Güte, daß ihr eure Gesichter gegen Osten oder Westen wendet. Güte ist vielmehr, daß man an Allah, den Jüngsten Tag, die Engel, die Bücher und die Propheten glaubt und vom Besitz - obwohl man ihn liebt - der Verwandtschaft, den Waisen, den Armen, dem Sohn des Weges, den Bettlern und für (den Loskauf von) Sklaven hergibt, das Gebet verrichtet und die Abgabe entrichtet; und diejenigen, die ihre Verpflichtung einhalten, wenn sie eine eingegangen sind, und diejenigen, die standhaft bleiben in Not, Leid und in Kriegszeiten, das sind diejenigen, die wahrhaftig sind, und das sind die Gottesfürchtigen.";
"discovery.card.ayah_2_177.source" = "Qur’an 2:177";

"discovery.card.ayah_2_185.title" = "Al-Baqara 185";
"discovery.card.ayah_2_185.meaning" = "Der Monat Ramadan (ist es), in dem der Qur'an als Rechtleitung für die Menschen herabgesandt worden ist und als klare Beweise der Rechtleitung und der Unterscheidung. Wer also von euch während dieses Monats anwesend ist, der soll ihn fasten, wer jedoch krank ist oder sich auf einer Reise befindet, eine (gleiche) Anzahl von anderen Tagen (fasten). Allah will für euch Erleichterung; Er will für euch nicht Erschwernis, - damit ihr die Anzahl vollendet und Allah als den Größten preist, dafür, daß Er euch rechtgeleitet hat, auf daß ihr dankbar sein möget.";
"discovery.card.ayah_2_185.source" = "Qur’an 2:185";

"discovery.card.ayah_2_197.title" = "Al-Baqara 197";
"discovery.card.ayah_2_197.meaning" = "Die (Zeit der) Pilgerfahrt (sind) bekannte Monate. Wer in ihnen die (Durchführung der) Pilgerfahrt beschlossen hat, der darf keinen Beischlaf ausüben, keinen Frevel begehen und nicht Streit führen während der Pilgerfahrt. Und was ihr an Gutem tut, Allah weiß es. Und versorgt euch mit Reisevorrat, doch der beste Vorrat ist die Gottesfurcht. Und fürchtet Mich, o die ihr Verstand besitzt!";
"discovery.card.ayah_2_197.source" = "Qur’an 2:197";

"discovery.card.ayah_2_208.title" = "Al-Baqara 208";
"discovery.card.ayah_2_208.meaning" = "O die ihr glaubt, tretet allesamt in den Islam ein und folgt nicht den Fußstapfen des Satans! Er ist euch ja ein deutlicher Feind.";
"discovery.card.ayah_2_208.source" = "Qur’an 2:208";

"discovery.card.ayah_2_216.title" = "Al-Baqara 216";
"discovery.card.ayah_2_216.meaning" = "Vorgeschrieben ist euch zu kämpfen, obwohl es euch zuwider ist. Aber vielleicht ist euch etwas zuwider, während es gut für euch ist, und vielleicht ist euch etwas lieb, während es schlecht für euch ist. Allah weiß, ihr aber wißt nicht.";
"discovery.card.ayah_2_216.source" = "Qur’an 2:216";

"discovery.card.ayah_2_245.title" = "Al-Baqara 245";
"discovery.card.ayah_2_245.meaning" = "Wer ist es denn, der Allah ein schönes Darlehen gibt? So vermehrt Er es ihm um ein Vielfaches. Allah hält zurück und gewährt, und zu Ihm werdet ihr zurückgebracht.";
"discovery.card.ayah_2_245.source" = "Qur’an 2:245";

"discovery.card.ayah_2_254.title" = "Al-Baqara 254";
"discovery.card.ayah_2_254.meaning" = "O die ihr glaubt, gebt aus von dem, womit Wir euch versorgt haben, bevor ein Tag kommt, an dem es keinen Verkauf, keine Freundschaft und keine Fürsprache gibt! Die Ungläubigen sind die Ungerechten.";
"discovery.card.ayah_2_254.source" = "Qur’an 2:254";

"discovery.card.ayah_2_267.title" = "Al-Baqara 267";
"discovery.card.ayah_2_267.meaning" = "O die ihr glaubt, gebt aus von den guten Dingen aus eurem Erworbenen und von dem, was Wir für euch aus der Erde hervorgebracht haben. Und sucht nicht zum Ausgeben das Schlechte davon aus, während ihr (selbst) es nicht nehmen würdet, ohne dabei ein Auge zuzudrücken. Und wißt, daß Allah Unbedürftig und Lobenswürdig ist.";
"discovery.card.ayah_2_267.source" = "Qur’an 2:267";

"discovery.card.ayah_2_285.title" = "Al-Baqara 285";
"discovery.card.ayah_2_285.meaning" = "Der Gesandte (Allahs) glaubt an das, was zu ihm von seinem Herrn (als Offenbarung) herabgesandt worden ist, und ebenso die Gläubigen; alle glauben an Allah, Seine Engel, Seine Bücher und Seine Gesandten - Wir machen keinen Unterschied bei jemandem von Seinen Gesandten. Und sie sagen: \"Wir hören und gehorchen. (Gewähre uns) Deine Vergebung, unser Herr! Und zu Dir ist der Ausgang.\"";
"discovery.card.ayah_2_285.source" = "Qur’an 2:285";

"discovery.card.ayah_3_8.title" = "Aal-i-Imraan 8";
"discovery.card.ayah_3_8.meaning" = "Unser Herr, lasse unsere Herzen nicht abschweifen, nachdem Du uns rechtgeleitet hast, und schenke uns Erbarmen von Dir aus. Du bist ja der unablässig Schenkende.";
"discovery.card.ayah_3_8.source" = "Qur’an 3:8";

"discovery.card.ayah_3_26.title" = "Aal-i-Imraan 26";
"discovery.card.ayah_3_26.meaning" = "Sag: O Allah, Herr der Herrschaft, Du gibst die Herrschaft, wem Du willst, und Du entziehst die Herrschaft, wem Du willst. Du machst mächtig, wen Du willst, und Du erniedrigst, wen Du willst. In Deiner Hand ist (all) das Gute. Gewiß, Du hast zu allem die Macht.";
"discovery.card.ayah_3_26.source" = "Qur’an 3:26";

"discovery.card.ayah_3_31.title" = "Aal-i-Imraan 31";
"discovery.card.ayah_3_31.meaning" = "Sag: Wenn ihr Allah liebt, dann folgt mir. So liebt euch Allah und vergibt euch eure Sünden. Allah ist Allvergebend und Barmherzig.";
"discovery.card.ayah_3_31.source" = "Qur’an 3:31";

"discovery.card.ayah_3_92.title" = "Aal-i-Imraan 92";
"discovery.card.ayah_3_92.meaning" = "Ihr werdet die Güte nicht erreichen, bevor ihr nicht von dem ausgebt, was euch lieb ist. Und was immer ihr ausgebt, so weiß Allah darüber Bescheid.";
"discovery.card.ayah_3_92.source" = "Qur’an 3:92";

"discovery.card.ayah_3_102.title" = "Aal-i-Imraan 102";
"discovery.card.ayah_3_102.meaning" = "O die ihr glaubt, fürchtet Allah in gebührender Furcht und sterbt ja nicht anders denn als (Allah) Ergebene!";
"discovery.card.ayah_3_102.source" = "Qur’an 3:102";

"discovery.card.ayah_3_103.title" = "Aal-i-Imraan 103";
"discovery.card.ayah_3_103.meaning" = "Und haltet alle fest am Seil Allahs und geht nicht auseinander! Und gedenkt Allahs Gunst an euch, als ihr Feinde wart und Er dann eure Herzen zusammenführte, worauf ihr durch Seine Gunst Brüder wurdet. Und (als) ihr am Rand einer Feuergrube wart und Er euch dann davor errettete. So macht Allah euch Seine Zeichen klar, auf daß ihr rechtgeleitet werden möget!";
"discovery.card.ayah_3_103.source" = "Qur’an 3:103";

"discovery.card.ayah_3_110.title" = "Aal-i-Imraan 110";
"discovery.card.ayah_3_110.meaning" = "Ihr seid die beste Gemeinschaft, die für die Menschen hervorgebracht worden ist. Ihr gebietet das Rechte und verbietet das Verwerfliche und glaubt an Allah. Und wenn die Leute der Schrift glauben würden, wäre es wahrlich besser für sie. Unter ihnen gibt es Gläubige, aber die meisten von ihnen sind Frevler.";
"discovery.card.ayah_3_110.source" = "Qur’an 3:110";

"discovery.card.ayah_3_133.title" = "Aal-i-Imraan 133";
"discovery.card.ayah_3_133.meaning" = "Und beeilt euch um Vergebung von eurem Herrn und (um) einen (Paradies)garten, dessen Breite (wie) die Himmel und die Erde ist. Er ist für die Gottesfürchtigen bereitet,";
"discovery.card.ayah_3_133.source" = "Qur’an 3:133";

"discovery.card.ayah_3_139.title" = "Aal-i-Imraan 139";
"discovery.card.ayah_3_139.meaning" = "Und werdet nicht schwach noch seid traurig, wo ihr doch die Oberhand haben werdet, wenn ihr gläubig seid.";
"discovery.card.ayah_3_139.source" = "Qur’an 3:139";

"discovery.card.ayah_3_159.title" = "Aal-i-Imraan 159";
"discovery.card.ayah_3_159.meaning" = "Durch Erbarmen von Allah bist du mild zu ihnen gewesen; wärst du aber schroff und hartherzig, so würden sie wahrlich rings um dich auseinandergelaufen. So verzeihe ihnen, bitte für sie um Vergebung und ziehe sie in den Angelegenheiten zu Rate. Und wenn du dich entschlossen hast, dann verlasse dich auf Allah! Gewiß, Allah liebt die sich (auf Ihn) Verlassenden.";
"discovery.card.ayah_3_159.source" = "Qur’an 3:159";

"discovery.card.ayah_3_185.title" = "Aal-i-Imraan 185";
"discovery.card.ayah_3_185.meaning" = "Jede Seele wird den Tod kosten. Und erst am Tag der Auferstehung wird euch euer Lohn in vollem Maß zukommen. Wer dann dem (Höllen)feuer entrückt und in den (Paradies)garten eingelassen wird, der hat fürwahr einen Erfolg erzielt. Und das diesseitige Leben ist nur trügerischer Genuß.";
"discovery.card.ayah_3_185.source" = "Qur’an 3:185";

"discovery.card.ayah_3_190.title" = "Aal-i-Imraan 190";
"discovery.card.ayah_3_190.meaning" = "In der Schöpfung der Himmel und der Erde und in dem Unterschied von Nacht und Tag liegen wahrlich Zeichen für diejenigen, die Verstand besitzen,";
"discovery.card.ayah_3_190.source" = "Qur’an 3:190";

"discovery.card.ayah_3_200.title" = "Aal-i-Imraan 200";
"discovery.card.ayah_3_200.meaning" = "O die ihr glaubt, geduldet euch, haltet standhaft aus, seid kampfbereit und fürchtet Allah, auf daß es euch wohl ergehen möge!";
"discovery.card.ayah_3_200.source" = "Qur’an 3:200";

"discovery.card.ayah_4_1.title" = "An-Nisaa 1";
"discovery.card.ayah_4_1.meaning" = "O ihr Menschen, fürchtet euren Herrn, Der euch aus einem einzigen Wesen schuf, und aus ihm schuf Er seine Gattin und ließ aus beiden viele Männer und Frauen sich ausbreiten. Und fürchtet Allah, in Dessen (Namen) ihr einander bittet, und die Verwandtschaftsbande. Gewiß, Allah ist Wächter über euch.";
"discovery.card.ayah_4_1.source" = "Qur’an 4:1";

"discovery.card.ayah_4_29.title" = "An-Nisaa 29";
"discovery.card.ayah_4_29.meaning" = "O die ihr glaubt, zehrt nicht euren Besitz untereinander auf nichtige Weise auf, es sei denn, daß es sich um einen Handel in gegenseitigem Einvernehmen handelt. Und tötet euch nicht selbst (gegenseitig). Allah ist gewiß Barmherzig gegen euch.";
"discovery.card.ayah_4_29.source" = "Qur’an 4:29";

"discovery.card.ayah_4_36.title" = "An-Nisaa 36";
"discovery.card.ayah_4_36.meaning" = "Und dient Allah und gesellt Ihm nichts bei. Und zu den Eltern sollt ihr gütig sein und zu den Verwandten, den Waisen, den Armen, dem verwandten Nachbarn, dem fremden Nachbarn, dem Gefährten zur Seite, dem Sohn des Weges und denen, die eure rechte Hand besitzt. Allah liebt nicht, wer eingebildet und prahlerisch ist,";
"discovery.card.ayah_4_36.source" = "Qur’an 4:36";

"discovery.card.ayah_4_40.title" = "An-Nisaa 40";
"discovery.card.ayah_4_40.meaning" = "Allah tut gewiß nicht im Gewicht eines Stäubchens Unrecht. Und wenn es eine gute Tat ist, vervielfacht Er sie und gibt von Sich aus großartigen Lohn.";
"discovery.card.ayah_4_40.source" = "Qur’an 4:40";

"discovery.card.ayah_4_59.title" = "An-Nisaa 59";
"discovery.card.ayah_4_59.meaning" = "O die ihr glaubt, gehorcht Allah und gehorcht dem Gesandten und den Befehlshabern unter euch! Wenn ihr miteinander über etwas streitet, dann bringt es vor Allah und den Gesandten, wenn ihr wirklich an Allah und den Jüngsten Tag glaubt. Das ist am besten und am ehesten ein guter Ausgang.";
"discovery.card.ayah_4_59.source" = "Qur’an 4:59";

"discovery.card.ayah_4_69.title" = "An-Nisaa 69";
"discovery.card.ayah_4_69.meaning" = "Wer Allah und dem Gesandten gehorcht, die werden mit denjenigen von den Propheten, den Wahrheitsliebenden, den Märtyrern und den Rechtschaffenen Zusammensein, denen Allah Gunst erwiesen hat. Welch gute Gefährten jene sind!";
"discovery.card.ayah_4_69.source" = "Qur’an 4:69";

"discovery.card.ayah_4_86.title" = "An-Nisaa 86";
"discovery.card.ayah_4_86.meaning" = "Und wenn euch ein Gruß entboten wird, dann grüßt mit einem schöneren (zurück) oder erwidert ihn. Gewiß, Allah ist über alles ein Abrechner.";
"discovery.card.ayah_4_86.source" = "Qur’an 4:86";

"discovery.card.ayah_4_103.title" = "An-Nisaa 103";
"discovery.card.ayah_4_103.meaning" = "Wenn ihr das Gebet vollzogen habt, dann gedenkt Allahs stehend, sitzend und auf der Seite (liegend). Wenn ihr in Ruhe seid, dann verrichtet das Gebet (wie üblich). Das Gebet ist den Gläubigen zu bestimmten Zeiten vorgeschrieben.";
"discovery.card.ayah_4_103.source" = "Qur’an 4:103";

"discovery.card.ayah_4_174.title" = "An-Nisaa 174";
"discovery.card.ayah_4_174.meaning" = "O ihr Menschen, zu euch ist nunmehr ein Beweis von eurem Herrn gekommen, und Wir haben zu euch ein deutliches Licht hinabgesandt.";
"discovery.card.ayah_4_174.source" = "Qur’an 4:174";

"discovery.card.ayah_5_2.title" = "Al-Maaida 2";
"discovery.card.ayah_5_2.meaning" = "O die ihr glaubt, entweiht nicht die Kultzeichen Allahs, noch den Schutzmonat, noch die Opfertiere, noch die Halsgehänge, noch die, die das geschützte Haus aufsuchen, indem sie nach Huld von ihrem Herrn trachten und nach Wohlgefallen. - Wenn ihr den Weihezustand abgelegt habt, dann dürft ihr jagen. - Und der Haß, den ihr gegen (bestimmte) Leute hegt, weil sie euch von der geschützten Gebetsstätte abgehalten haben, soll euch ja nicht dazu bringen zu übertreten. Helft einander zur Güte und Gottesfurcht, aber helft einander nicht zur Sünde und feindseligem Vorgehen, und fürchtet Allah! Allah ist streng im Bestrafen.";
"discovery.card.ayah_5_2.source" = "Qur’an 5:2";

"discovery.card.ayah_5_3.title" = "Al-Maaida 3";
"discovery.card.ayah_5_3.meaning" = "Verboten ist euch (der Genuß von) Verendetem, Blut, Schweinefleisch und dem, worüber ein anderer (Name) als Allah(s) angerufen worden ist, und (der Genuß von) Ersticktem, Erschlagenem, zu Tode Gestürztem oder Gestoßenem, und was von einem wilden Tier gerissen worden ist - außer dem, was ihr schlachtet - und (verboten ist euch,) was auf einem Opferstein geschlachtet worden ist, und mit Pfeilen zu losen. Das ist Frevel. - Heute haben diejenigen, die ungläubig sind, hinsichtlich eurer Religion die Hoffnung aufgegeben. So fürchtet nicht sie, sondern fürchtet Mich! Heute habe Ich euch eure Religion vervollkommnet und Meine Gunst an euch vollendet, und Ich bin mit dem Islam als Religion für euch zufrieden. - Und wer sich aus Hunger in einer Zwangslage befindet, ohne zu einer Sünde hinzuneigen, so ist Allah Allvergebend und Barmherzig.";
"discovery.card.ayah_5_3.source" = "Qur’an 5:3";

"discovery.card.ayah_5_6.title" = "Al-Maaida 6";
"discovery.card.ayah_5_6.meaning" = "O die ihr glaubt, wenn ihr euch zum Gebet aufstellt, dann wascht euch das Gesicht und die Hände bis zu den Ellbogen und streicht euch über den Kopf und (wascht euch) die Füße bis zu den Knöcheln. Und wenn ihr im Zustand der Unreinheit seid, dann reinigt euch. Und wenn ihr krank seid oder auf einer Reise oder jemand von euch vom Abort kommt oder ihr Frauen berührt habt und dann kein Wasser findet, so wendet euch dem guten Erdboden zu und streicht euch damit über das Gesicht und die Hände. Allah will euch keine Bedrängnis auferlegen, sondern Er will euch reinigen und Seine Gunst an euch vollenden, auf daß ihr dankbar sein möget.";
"discovery.card.ayah_5_6.source" = "Qur’an 5:6";

"discovery.card.ayah_5_8.title" = "Al-Maaida 8";
"discovery.card.ayah_5_8.meaning" = "O die ihr glaubt, seid Wahrer (der Sache) Allahs als Zeugen für die Gerechtigkeit. Und der Haß, den ihr gegen (bestimmte) Leute hegt, soll euch ja nicht dazu bringen, daß ihr nicht gerecht handelt. Handelt gerecht. Das kommt der Gottesfurcht näher. Und fürchtet Allah. Gewiß, Allah ist Kundig dessen, was ihr tut.";
"discovery.card.ayah_5_8.source" = "Qur’an 5:8";

"discovery.card.ayah_5_32.title" = "Al-Maaida 32";
"discovery.card.ayah_5_32.meaning" = "Aus diesem Grunde haben Wir den Kindern Isra'ils vorgeschrieben: Wer ein menschliches Wesen tötet, ohne (daß es) einen Mord (begangen) oder auf der Erde Unheil gestiftet (hat), so ist es, als ob er alle Menschen getötet hätte. Und wer es am Leben erhält, so ist es', als ob er alle Menschen am Leben erhält. Unsere Gesandten sind bereits mit klaren Beweisen zu ihnen gekommen. Danach aber sind viele von ihnen wahrlich maßlos auf der Erde geblieben.";
"discovery.card.ayah_5_32.source" = "Qur’an 5:32";

"discovery.card.ayah_5_35.title" = "Al-Maaida 35";
"discovery.card.ayah_5_35.meaning" = "O die ihr glaubt, fürchtet Allah und trachtet nach einem Mittel zu Ihm und müht euch auf Seinem Weg ab, auf daß es euch wohl ergehen möge!";
"discovery.card.ayah_5_35.source" = "Qur’an 5:35";

"discovery.card.ayah_5_54.title" = "Al-Maaida 54";
"discovery.card.ayah_5_54.meaning" = "O die ihr glaubt, wer von euch sich von seiner Religion abkehrt -, so wird Allah Leute bringen, die Er liebt und die Ihn lieben, bescheiden gegenüber den Gläubigen, mächtig (auftretend) gegenüber den Ungläubigen, und die sich auf Allahs Weg abmühen und nicht den Tadel des Tadlers fürchten. Das ist Allahs Huld, die Er gewährt, wem Er will. Allah ist Allumfassend und Allwissend.";
"discovery.card.ayah_5_54.source" = "Qur’an 5:54";

"discovery.card.ayah_5_119.title" = "Al-Maaida 119";
"discovery.card.ayah_5_119.meaning" = "Allah wird sagen: \"Dies ist der Tag, an dem den Wahrhaftigen ihre Wahrhaftigkeit nützt.\" Für sie sind Gärten, durcheilt von Bächen, ewig und auf immer darin zu bleiben. Allah hat Wohlgefallen an ihnen, und sie haben Wohlgefallen an Ihm. Das ist der großartige Erfolg.";
"discovery.card.ayah_5_119.source" = "Qur’an 5:119";

"discovery.card.ayah_6_17.title" = "Al-An'aam 17";
"discovery.card.ayah_6_17.meaning" = "Wenn Allah dir Unheil widerfahren läßt, so kann es keiner hinwegnehmen außer Ihm. Und wenn Er dir (etwas) Gutes widerfahren läßt, - so hat Er zu allem die Macht.";
"discovery.card.ayah_6_17.source" = "Qur’an 6:17";

"discovery.card.ayah_6_54.title" = "Al-An'aam 54";
"discovery.card.ayah_6_54.meaning" = "Und wenn diejenigen, die an Unsere Zeichen glauben, zu dir kommen, dann sag: Friede sei auf euch! Euer Herr hat Sich Selbst Barmherzigkeit vorgeschrieben: Wer von euch in Unwissenheit Böses tut, aber danach dann bereut und (es) wieder gutmacht, so ist Er Allvergebend und Barmherzig.";
"discovery.card.ayah_6_54.source" = "Qur’an 6:54";

"discovery.card.ayah_6_125.title" = "Al-An'aam 125";
"discovery.card.ayah_6_125.meaning" = "Wen Allah rechtleiten will, dem tut Er die Brust auf für den Islam. Und wen Er in die Irre gehen lassen will, dem macht Er die Brust eng und bedrängt, so als ob er in den Himmel hochsteigen sollte. So legt Allah den Greuel auf diejenigen, die nicht glauben.";
"discovery.card.ayah_6_125.source" = "Qur’an 6:125";

"discovery.card.ayah_6_151.title" = "Al-An'aam 151";
"discovery.card.ayah_6_151.meaning" = "Sag: Kommt her! Ich will euch verlesen, was euer Herr euch verboten hat: Ihr sollt Ihm nichts beigesellen, und zu den Eltern gütig sein; und tötet nicht eure Kinder aus Armut - Wir versorgen euch und auch sie; und nähert euch nicht den Abscheulichkeiten, was von ihnen offen und was verborgen ist; und tötet nicht die Seele, die Allah verboten hat (zu töten), außer aus einem rechtmäßigen Grund! Dies hat Er euch anbefohlen, auf daß ihr begreifen möget.";
"discovery.card.ayah_6_151.source" = "Qur’an 6:151";

"discovery.card.ayah_6_162.title" = "Al-An'aam 162";
"discovery.card.ayah_6_162.meaning" = "Sag: Gewiß, mein Gebet und mein (Schlacht)opfer, mein Leben und mein Sterben gehören Allah, dem Herrn der Weltenbewohner.";
"discovery.card.ayah_6_162.source" = "Qur’an 6:162";

"discovery.card.ayah_7_23.title" = "Al-A'raaf 23";
"discovery.card.ayah_7_23.meaning" = "Sie sagten: \"Unser Herr, wir haben uns selbst Unrecht zugefügt. Wenn Du uns nicht vergibst und Dich unser erbarmst, werden wir ganz gewiß zu den Verlorenen gehören.\"";
"discovery.card.ayah_7_23.source" = "Qur’an 7:23";

"discovery.card.ayah_7_31.title" = "Al-A'raaf 31";
"discovery.card.ayah_7_31.meaning" = "O Kinder Adams, legt euren Schmuck bei jeder Gebetsstätte an und eßt und trinkt, aber seid nicht maßlos! - Er (Allah) liebt nicht die Maßlosen.";
"discovery.card.ayah_7_31.source" = "Qur’an 7:31";

"discovery.card.ayah_7_56.title" = "Al-A'raaf 56";
"discovery.card.ayah_7_56.meaning" = "Und stiftet auf der Erde nicht Unheil, nachdem sie in Ordnung gebracht worden ist! Und ruft Ihn in Furcht und Begehren an. Gewiß, die Barmherzigkeit Allahs ist den Gutes Tuenden nahe.";
"discovery.card.ayah_7_56.source" = "Qur’an 7:56";

"discovery.card.ayah_7_128.title" = "Al-A'raaf 128";
"discovery.card.ayah_7_128.meaning" = "Musa sagte zu seinem Volk: \"Sucht Hilfe bei Allah, und seid standhaft! Gewiß, die Erde gehört Allah; Er gibt sie zum Erbe, wem von Seinen Dienern Er will. Und das (gute) Ende gehört den Gottesfürchtigen.\"";
"discovery.card.ayah_7_128.source" = "Qur’an 7:128";

"discovery.card.ayah_7_199.title" = "Al-A'raaf 199";
"discovery.card.ayah_7_199.meaning" = "Nimm den Überschuß, gebiete das allgemein Gute und wende dich von den Toren ab!";
"discovery.card.ayah_7_199.source" = "Qur’an 7:199";

"discovery.card.ayah_7_204.title" = "Al-A'raaf 204";
"discovery.card.ayah_7_204.meaning" = "Und wenn der Qur'an vorgetragen wird, dann hört ihm zu und horcht hin, auf daß ihr Erbarmen finden möget!";
"discovery.card.ayah_7_204.source" = "Qur’an 7:204";

"discovery.card.ayah_8_2.title" = "Al-Anfaal 2";
"discovery.card.ayah_8_2.meaning" = "Die (wahren) Gläubigen sind ja diejenigen, deren Herzen sich vor Ehrfurcht regen, wenn Allahs gedacht wird, und die, wenn ihnen Seine Zeichen verlesen werden, es ihren Glauben mehrt, und die sich auf ihren Herrn verlassen,";
"discovery.card.ayah_8_2.source" = "Qur’an 8:2";

"discovery.card.ayah_8_29.title" = "Al-Anfaal 29";
"discovery.card.ayah_8_29.meaning" = "O die ihr glaubt, wenn ihr Allah fürchtet, bestimmt Er euch eine";
"discovery.card.ayah_8_29.source" = "Qur’an 8:29";

"discovery.card.ayah_8_46.title" = "Al-Anfaal 46";
"discovery.card.ayah_8_46.meaning" = "Und gehorcht Allah und Seinem Gesandten, und streitet nicht miteinander, sonst würdet ihr den Mut verlieren, und eure Kraft würde vergehen! Und seid standhaft! Gewiß, Allah ist mit den Standhaften.";
"discovery.card.ayah_8_46.source" = "Qur’an 8:46";

"discovery.card.ayah_8_61.title" = "Al-Anfaal 61";
"discovery.card.ayah_8_61.meaning" = "Und wenn sie sich dem Frieden zuneigen, dann neige auch du dich ihm zu und verlasse dich auf Allah! Gewiß, Er ist ja der Allhörende und Allwissende.";
"discovery.card.ayah_8_61.source" = "Qur’an 8:61";

"discovery.card.ayah_9_18.title" = "At-Tawba 18";
"discovery.card.ayah_9_18.meaning" = "Gewiß, Allahs Gebetsstätten bevölkert nur, wer an Allah und den Jüngsten Tag glaubt, das Gebet verrichtet, die Abgabe entrichtet und niemanden außer Allah fürchtet. Diese aber werden vielleicht zu den Rechtgeleiteten gehören.";
"discovery.card.ayah_9_18.source" = "Qur’an 9:18";

"discovery.card.ayah_9_40.title" = "At-Tawba 40";
"discovery.card.ayah_9_40.meaning" = "Wenn ihr ihm nicht helft, so hat Allah ihm (schon damals) geholfen, als diejenigen, die ungläubig waren, ihn als einen von Zweien vertrieben; als sie beide in der Höhle waren und als er zu seinem Gefährten sagte: \"Sei nicht traurig! Gewiß, Allah ist mit uns!\" Da sandte Allah Seine innere Ruhe auf ihn herab und stärkte ihn mit Heerscharen, die ihr nicht saht, und erniedrigte das Wort derjenigen, die ungläubig waren, während Allahs Wort (doch) das hohe ist. Allah ist Allmächtig und Allweise.";
"discovery.card.ayah_9_40.source" = "Qur’an 9:40";

"discovery.card.ayah_9_51.title" = "At-Tawba 51";
"discovery.card.ayah_9_51.meaning" = "Sag: Uns wird nur das treffen, was Allah für uns bestimmt hat. Er ist unser Schutzherr. Auf Allah sollen sich die Gläubigen verlassen.";
"discovery.card.ayah_9_51.source" = "Qur’an 9:51";

"discovery.card.ayah_9_71.title" = "At-Tawba 71";
"discovery.card.ayah_9_71.meaning" = "Die gläubigen Männer und Frauen sind einer des anderen Beschützer. Sie gebieten das Rechte und verbieten das Verwerfliche, verrichten das Gebet und entrichten die Abgabe und gehorchen Allah und Seinem Gesandten. Sie sind es, derer Allah Sich erbarmen wird. Gewiß, Allah ist Allmächtig und Allweise.";
"discovery.card.ayah_9_71.source" = "Qur’an 9:71";

"discovery.card.ayah_9_103.title" = "At-Tawba 103";
"discovery.card.ayah_9_103.meaning" = "Nimm von ihrem Besitz ein Almosen, mit dem du sie rein machst und läuterst, und bete für sie, denn dein Gebet ist für sie eine Beruhigung! Allah ist Allhörend und Allwissend.";
"discovery.card.ayah_9_103.source" = "Qur’an 9:103";

"discovery.card.ayah_9_128.title" = "At-Tawba 128";
"discovery.card.ayah_9_128.meaning" = "Zu euch ist nunmehr ein Gesandter aus euren eigenen Reihen gekommen. Bedrückend ist es für ihn, wenn ihr in Bedrängnis seid, (er ist) eifrig um euch bestrebt, zu den Gläubigen gnadenvoll und barmherzig.";
"discovery.card.ayah_9_128.source" = "Qur’an 9:128";

"discovery.card.ayah_10_25.title" = "Yunus 25";
"discovery.card.ayah_10_25.meaning" = "Allah lädt zur Wohnstätte des Friedens ein und leitet, wen Er will, zu einem geraden Weg.";
"discovery.card.ayah_10_25.source" = "Qur’an 10:25";

"discovery.card.ayah_10_57.title" = "Yunus 57";
"discovery.card.ayah_10_57.meaning" = "O ihr Menschen, zu euch ist nunmehr eine Ermahnung von eurem Herrn gekommen und eine Heilung für das, was in den Brüsten ist, eine Rechtleitung und Barmherzigkeit für die Gläubigen.";
"discovery.card.ayah_10_57.source" = "Qur’an 10:57";

"discovery.card.ayah_10_62.title" = "Yunus 62";
"discovery.card.ayah_10_62.meaning" = "Sicherlich, über Allahs Gefolgsleute soll keine Furcht kommen, noch sollen sie traurig sein,";
"discovery.card.ayah_10_62.source" = "Qur’an 10:62";

"discovery.card.ayah_10_107.title" = "Yunus 107";
"discovery.card.ayah_10_107.meaning" = "Wenn Allah dir Unheil widerfahren läßt, so kann es keiner hinwegnehmen außer Ihm. Und wenn Er für dich etwas Gutes will, so kann keiner Seine Huld zurückweisen. Er trifft damit, wen Er will von Seinen Dienern. Er ist der Allvergebende und Barmherzige.";
"discovery.card.ayah_10_107.source" = "Qur’an 10:107";

"discovery.card.ayah_11_88.title" = "Hud 88";
"discovery.card.ayah_11_88.meaning" = "Er sagte: \"O mein Volk, was meint ihr, wenn ich mich auf einen klaren Beweis von meinem Herrn stütze und Er mir eine schöne Versorgung gewährt hat? Und ich will mich (dann in meinem Vorhaben) von euch nicht unterscheiden, indem ich das tue, was ich euch verbiete. Ich will nur Besserung, soweit ich (sie erreichen) kann. Das Gelingen wird mir nur durch Allah (allein) beschieden. Auf Ihn verlasse ich mich, und Ihm wende ich mich reuig zu.";
"discovery.card.ayah_11_88.source" = "Qur’an 11:88";

"discovery.card.ayah_11_114.title" = "Hud 114";
"discovery.card.ayah_11_114.meaning" = "Und verrichte das Gebet an beiden Enden des Tages und in Stunden der Nacht. Die guten Taten lassen die bösen Taten vergehen. Das ist eine Ermahnung für diejenigen, die (Allahs) gedenken.";
"discovery.card.ayah_11_114.source" = "Qur’an 11:114";

"discovery.card.ayah_12_21.title" = "Yusuf 21";
"discovery.card.ayah_12_21.meaning" = "Und derjenige aus Ägypten, der ihn gekauft hatte, sagte zu seiner Frau: \"Bereite ihm einen gastfreundlichen Aufenthalt. Vielleicht wird er uns nützlich sein, oder nehmen wir ihn als Kind an.\" So verliehen Wir Yusuf eine feste Stellung im Land. Und Wir wollten ihn etwas von der Deutung der Geschichten lehren. Und Allah ist in Seiner Angelegenheit überlegen. Aber die meisten Menschen wissen nicht.";
"discovery.card.ayah_12_21.source" = "Qur’an 12:21";

"discovery.card.ayah_12_87.title" = "Yusuf 87";
"discovery.card.ayah_12_87.meaning" = "O meine Kinder, geht und erkundigt euch über Yusuf und seinen Bruder. Und gebt nicht die Hoffnung auf das Erbarmen Allahs auf. Es gibt die Hoffnung auf das Erbarmen Allahs nur das ungläubige Volk auf.\"";
"discovery.card.ayah_12_87.source" = "Qur’an 12:87";

"discovery.card.ayah_12_90.title" = "Yusuf 90";
"discovery.card.ayah_12_90.meaning" = "Sie sagten: \"Bist du denn wirklich Yusuf?\" Er sagte: \"Ich bin Yusuf, und das ist mein Bruder. Allah hat uns eine Wohltat erwiesen. Gewiß, wer gottesfürchtig und standhaft ist -- gewiß, Allah läßt den Lohn der Gutes Tuenden nicht verlorenge hen.\"";
"discovery.card.ayah_12_90.source" = "Qur’an 12:90";

"discovery.card.ayah_13_11.title" = "Ar-Ra'd 11";
"discovery.card.ayah_13_11.meaning" = "Er hat vor sich und hinter sich Begleiter, die ihn auf Allahs Befehl beschützen. Allah ändert nicht den Zustand eines Volkes, bis sie das ändern, was in ihnen selbst ist. Und wenn Allah einem Volk Böses will, so kann es nicht zurückgewiesen werden. Und sie haben außer Ihm keinen Schutzherrn.";
"discovery.card.ayah_13_11.source" = "Qur’an 13:11";

"discovery.card.ayah_13_28.title" = "Ar-Ra'd 28";
"discovery.card.ayah_13_28.meaning" = "(Es sind) diejenigen, die glauben und deren Herzen im Gedenken Allahs Ruhe finden. Sicherlich, im Gedenken Allahs finden die Herzen Ruhe!";
"discovery.card.ayah_13_28.source" = "Qur’an 13:28";

"discovery.card.ayah_14_24.title" = "Ibrahim 24";
"discovery.card.ayah_14_24.meaning" = "Siehst du nicht, wie Allah ein Gleichnis von einem guten Wort geprägt hat? (Es ist) wie ein guter Baum, dessen Wurzeln fest sitzen und dessen Zweige in den Himmel (reichen).";
"discovery.card.ayah_14_24.source" = "Qur’an 14:24";

"discovery.card.ayah_15_9.title" = "Al-Hijr 9";
"discovery.card.ayah_15_9.meaning" = "Gewiß, Wir sind es, die Wir die Ermahnung offenbart haben, und Wir werden wahrlich ihr Hüter sein.";
"discovery.card.ayah_15_9.source" = "Qur’an 15:9";

"discovery.card.ayah_15_49.title" = "Al-Hijr 49";
"discovery.card.ayah_15_49.meaning" = "Tue Meinen Dienern kund, daß Ich es bin, der Allvergebend und Barmherzig ist,";
"discovery.card.ayah_15_49.source" = "Qur’an 15:49";

"discovery.card.ayah_16_90.title" = "An-Nahl 90";
"discovery.card.ayah_16_90.meaning" = "Allah gebietet Gerechtigkeit, gütig zu sein und den Verwandten zu geben; Er verbietet das Schändliche, das Verwerfliche und die Gewalttätigkeit. Er ermahnt euch, auf daß ihr bedenken möget.";
"discovery.card.ayah_16_90.source" = "Qur’an 16:90";

"discovery.card.ayah_16_97.title" = "An-Nahl 97";
"discovery.card.ayah_16_97.meaning" = "Wer rechtschaffen handelt, sei es Mann oder Frau, und dabei gläubig ist, den werden Wir ganz gewiß ein gutes Leben leben lassen. Und Wir werden ihnen ganz gewiß mit ihrem Lohn das Beste von dem vergelten, was sie taten.";
"discovery.card.ayah_16_97.source" = "Qur’an 16:97";

"discovery.card.ayah_16_125.title" = "An-Nahl 125";
"discovery.card.ayah_16_125.meaning" = "Rufe zum Weg deines Herrn mit Weisheit und schöner Ermahnung, und streite mit ihnen in bester Weise. Gewiß, dein Herr kennt sehr wohl, wer von Seinem Weg abirrt, und Er kennt sehr wohl die Rechtgeleiteten.";
"discovery.card.ayah_16_125.source" = "Qur’an 16:125";

"discovery.card.ayah_17_9.title" = "Al-Israa 9";
"discovery.card.ayah_17_9.meaning" = "Gewiß, dieser Qur'an leitet zu dem, was richtiger ist, und verkündet den Gläubigen, die rechtschaffene Werke tun, daß es für sie großen Lohn geben wird";
"discovery.card.ayah_17_9.source" = "Qur’an 17:9";

"discovery.card.ayah_17_24.title" = "Al-Israa 24";
"discovery.card.ayah_17_24.meaning" = "Und senke für sie aus Barmherzigkeit den Flügel der Demut und sag: \"Mein Herr, erbarme Dich ihrer, wie sie mich aufgezogen haben, als ich klein war.\"";
"discovery.card.ayah_17_24.source" = "Qur’an 17:24";

"discovery.card.ayah_17_26.title" = "Al-Israa 26";
"discovery.card.ayah_17_26.meaning" = "Und gib dem Verwandten sein Recht, ebenso dem Armen und dem Sohn des Weges. Und handle nicht ganz verschwenderisch.";
"discovery.card.ayah_17_26.source" = "Qur’an 17:26";

"discovery.card.ayah_17_32.title" = "Al-Israa 32";
"discovery.card.ayah_17_32.meaning" = "Und nähert euch nicht der Unzucht. Gewiß, sie ist etwas Abscheuliches - und wie böse ist der Weg.";
"discovery.card.ayah_17_32.source" = "Qur’an 17:32";

"discovery.card.ayah_17_53.title" = "Al-Israa 53";
"discovery.card.ayah_17_53.meaning" = "Und sag Meinen Dienern, sie sollen das, was am besten ist, sagen. Gewiß, der Satan stachelt zwischen ihnen (zu Zwietracht) auf. Der Satan ist ja dem Menschen ein deutlicher Feind.";
"discovery.card.ayah_17_53.source" = "Qur’an 17:53";

"discovery.card.ayah_17_70.title" = "Al-Israa 70";
"discovery.card.ayah_17_70.meaning" = "Und Wir haben ja die Kinder Adams geehrt; Wir haben sie auf dem Festland und auf dem Meer getragen und sie von den guten Dingen versorgt, und Wir haben sie vor vielen von denen, die Wir erschaffen haben, eindeutig bevorzugt.";
"discovery.card.ayah_17_70.source" = "Qur’an 17:70";

"discovery.card.ayah_17_80.title" = "Al-Israa 80";
"discovery.card.ayah_17_80.meaning" = "Und sag: Mein Herr, gewähre mir einen wahrhaftigen Eingang, und gewähre mir einen wahrhaftigen Ausgang, und schaffe mir von Dir aus eine hilfreiche Macht.";
"discovery.card.ayah_17_80.source" = "Qur’an 17:80";

"discovery.card.ayah_17_110.title" = "Al-Israa 110";
"discovery.card.ayah_17_110.meaning" = "Sag: Ruft Allah oder ruft den Allerbarmer an; welchen ihr auch ruft, Sein sind die schönsten Namen. Und sei nicht zu laut beim Gebet, und sie auch nicht zu leise da bei, sondern suche einen Weg dazwischen.";
"discovery.card.ayah_17_110.source" = "Qur’an 17:110";

"discovery.card.ayah_18_10.title" = "Al-Kahf 10";
"discovery.card.ayah_18_10.meaning" = "Als die Jünglinge in der Höhle Zuflucht suchten und sagten: \"Unser Herr, gib uns Barmherzigkeit von Dir aus, und bereite uns in unserer Angelegenheit einen rechten (Aus)weg.\"";
"discovery.card.ayah_18_10.source" = "Qur’an 18:10";

"discovery.card.ayah_18_24.title" = "Al-Kahf 24";
"discovery.card.ayah_18_24.meaning" = "außer (du fügst hinzu): \"Wenn Allah will.\" Und gedenke deines Herrn, wenn du (etwas) vergessen hast, und sag: \"Vielleicht leitet mich mein Herr zu etwas, was dem rechten Ausweg näher kommt als dies.\"";
"discovery.card.ayah_18_24.source" = "Qur’an 18:24";

"discovery.card.ayah_18_46.title" = "Al-Kahf 46";
"discovery.card.ayah_18_46.meaning" = "Der Besitz und die Söhne sind der Schmuck des diesseitigen Lebens. Das Bleibende aber, die rechtschaffenen Werke -, sie sind bei deinem Herrn besser hinsichtlich der Belohnung und besser hinsichtlich der Hoffnung.";
"discovery.card.ayah_18_46.source" = "Qur’an 18:46";

"discovery.card.ayah_18_110.title" = "Al-Kahf 110";
"discovery.card.ayah_18_110.meaning" = "Sag: Gewiß, ich bin ja nur ein menschliches Wesen gleich euch; mir wird (als Offenbarung) eingegeben, daß euer Gott ein Einziger Gott ist. Wer nun auf die Begegnung mit seinem Herrn hofft, der soll rechtschaffen handeln und beim Dienst an seinem Herrn (Ihm) niemanden beigesellen.";
"discovery.card.ayah_18_110.source" = "Qur’an 18:110";

"discovery.card.ayah_19_4.title" = "Maryam 4";
"discovery.card.ayah_19_4.meaning" = "(und) sagte: \"Mein Herr, schwach sind mir die Knochen geworden, und in Altersgrauheit entfacht ist der Kopf. Und ich war im Bittgebet zu Dir, mein Herr, (noch) nie unglücklich.";
"discovery.card.ayah_19_4.source" = "Qur’an 19:4";

"discovery.card.ayah_19_96.title" = "Maryam 96";
"discovery.card.ayah_19_96.meaning" = "Gewiß, denjenigen, die glauben und rechtschaffene Werke tun, wird der Allerbarmer Liebe bereiten.";
"discovery.card.ayah_19_96.source" = "Qur’an 19:96";

"discovery.card.ayah_20_8.title" = "Taa-Haa 8";
"discovery.card.ayah_20_8.meaning" = "Allah - es gibt keinen Gott außer Ihm. Sein sind die schönsten Namen.";
"discovery.card.ayah_20_8.source" = "Qur’an 20:8";

"discovery.card.ayah_20_25.title" = "Taa-Haa 25";
"discovery.card.ayah_20_25.meaning" = "Er sagte: \"Mein Herr, weite mir meine Brust,";
"discovery.card.ayah_20_25.source" = "Qur’an 20:25";

"discovery.card.ayah_20_46.title" = "Taa-Haa 46";
"discovery.card.ayah_20_46.meaning" = "Er sagte: \"Fürchtet euch nicht. Ich bin gewiß mit euch, Ich höre und Ich sehe (, was geschieht).";
"discovery.card.ayah_20_46.source" = "Qur’an 20:46";

"discovery.card.ayah_20_82.title" = "Taa-Haa 82";
"discovery.card.ayah_20_82.meaning" = "Und Ich bin wahrlich Allvergebend für denjenigen, der bereut und glaubt und rechtschaffen handelt und sich hierauf rechtleiten läßt.\"";
"discovery.card.ayah_20_82.source" = "Qur’an 20:82";

"discovery.card.ayah_21_47.title" = "Al-Anbiyaa 47";
"discovery.card.ayah_21_47.meaning" = "Und Wir stellen die gerechten Waagen für den Tag der Auferstehung auf. So wird keiner Seele um irgend etwas Unrecht zugefügt; und wäre es auch das Gewicht eines Senfkorns, Wir bringen es bei. Und Wir genügen als Berechner.";
"discovery.card.ayah_21_47.source" = "Qur’an 21:47";

"discovery.card.ayah_21_73.title" = "Al-Anbiyaa 73";
"discovery.card.ayah_21_73.meaning" = "Und Wir machten sie zu Vorbildern, die nach Unserem Befehl leiteten. Und Wir gaben ihnen ein, gute Werke zu tun, das Gebet zu verrichten und die Abgabe zu entrichten. Und sie pflegten Uns zu dienen.";
"discovery.card.ayah_21_73.source" = "Qur’an 21:73";

"discovery.card.ayah_21_92.title" = "Al-Anbiyaa 92";
"discovery.card.ayah_21_92.meaning" = "\"Gewiß, diese ist eure Gemeinschaft, eine einzige Gemeinschaft, und Ich bin euer Herr; so dient Mir!\"";
"discovery.card.ayah_21_92.source" = "Qur’an 21:92";

"discovery.card.ayah_22_77.title" = "Al-Hajj 77";
"discovery.card.ayah_22_77.meaning" = "O die ihr glaubt, verbeugt euch, werft euch nieder und dient eurem Herrn und tut das Gute, auf daß es euch wohl ergehen möge!";
"discovery.card.ayah_22_77.source" = "Qur’an 22:77";

"discovery.card.ayah_22_78.title" = "Al-Hajj 78";
"discovery.card.ayah_22_78.meaning" = "Und müht euch für Allah ab, wie der wahre Einsatz für Ihn sein soll. Er hat euch erwählt und euch in der Religion keine Bedrängnis auferlegt, dem Glau bensbekenntnis eures Vaters Ibrahim: Er hat euch Muslime genannt, zuvor und (nunmehr) in diesem (Qur'an), damit der Gesandte Zeuge über euch sei und ihr Zeugen über die Menschen seid. So verrichtet das Gebet, entrichtet die Abgabe und haltet an Allah fest. Er ist euer Schutzherr. Wie trefflich ist doch der Schutzherr, und wie trefflich ist der Helfer!";
"discovery.card.ayah_22_78.source" = "Qur’an 22:78";

"discovery.card.ayah_23_1.title" = "Al-Muminoon 1";
"discovery.card.ayah_23_1.meaning" = "Den Gläubigen wird es ja wohl ergehen,";
"discovery.card.ayah_23_1.source" = "Qur’an 23:1";

"discovery.card.ayah_23_51.title" = "Al-Muminoon 51";
"discovery.card.ayah_23_51.meaning" = "\"O ihr Gesandten, eßt von den guten Dingen und handelt rechtschaffen; gewiß, Ich weiß über das, was ihr tut, Bescheid.";
"discovery.card.ayah_23_51.source" = "Qur’an 23:51";

"discovery.card.ayah_23_97.title" = "Al-Muminoon 97";
"discovery.card.ayah_23_97.meaning" = "Und sag: Mein Herr, ich nehme Zuflucht bei Dir vor den Aufstachelungen der Satane.";
"discovery.card.ayah_23_97.source" = "Qur’an 23:97";

"discovery.card.ayah_24_22.title" = "An-Noor 22";
"discovery.card.ayah_24_22.meaning" = "Und es sollen diejenigen von euch, die Überfluß und Wohlstand besitzen, nicht schwören, sie würden den Verwandten, den Armen und denjenigen, die auf Allahs Weg ausgewandert sind, nichts mehr geben, sondern sie sollen verzeihen und nachsichtig sein. Liebt ihr es (selbst) nicht, daß Allah euch vergibt? Allah ist Allvergebend und Barmherzig.";
"discovery.card.ayah_24_22.source" = "Qur’an 24:22";

"discovery.card.ayah_24_31.title" = "An-Noor 31";
"discovery.card.ayah_24_31.meaning" = "Und sag zu den gläubigen Frauen, sie sollen ihre Blicke senken und ihre Scham hüten, ihren Schmuck nicht offen zeigen, außer dem, was (sonst) sichtbar ist. Und sie sollen ihre Kopftücher auf den Brustschlitz ihres Gewandes schlagen und ihren Schmuck nicht offen zeigen, außer ihren Ehegatten, ihren Vätern, den Vätern ihrer Ehegatten, ihren Söhnen, den Söhnen ihrer Ehegatten, ihren Brüdern, den Söhnen ihrer Brüder und den Söhnen ihrer Schwestern, ihren Frauen, denen, die ihre rechte Hand besitzt, den männlichen Gefolgsleuten, die keinen (Geschlechts)trieb (mehr) haben, den Kindern, die auf die Blöße der Frauen (noch) nicht aufmerksam geworden sind. Und sie sollen ihre Füße nicht aneinanderschlagen, damit (nicht) bekannt wird, was sie von ihrem Schmuck verborgen tragen. Wendet euch alle reumütig Allah zu, ihr Gläubigen, auf daß es euch wohl ergehen möge!";
"discovery.card.ayah_24_31.source" = "Qur’an 24:31";

"discovery.card.ayah_24_37.title" = "An-Noor 37";
"discovery.card.ayah_24_37.meaning" = "Männer, die weder Handel noch Kaufgeschäft ablenken vom Gedenken Allahs, von der Verrichtung des Gebets und der Entrichtung der Abgabe', die einen Tag fürch ten, an dem Herzen und Augenlicht umgekehrt werden,";
"discovery.card.ayah_24_37.source" = "Qur’an 24:37";

"discovery.card.ayah_25_63.title" = "Al-Furqaan 63";
"discovery.card.ayah_25_63.meaning" = "Die Diener des Allerbarmers sind diejenigen, die maßvoll auf der Erde umhergehen und die, wenn die Toren sie ansprechen, sagen: \"Frieden!\"";
"discovery.card.ayah_25_63.source" = "Qur’an 25:63";

"discovery.card.ayah_25_74.title" = "Al-Furqaan 74";
"discovery.card.ayah_25_74.meaning" = "Und diejenigen, die sagen: \"Unser Herr, schenke uns an unseren Gattinnen und unseren Nachkommenschaften Grund zur Freude, und mache uns für die Rechtschaffenen zu einem Vorbild.\"";
"discovery.card.ayah_25_74.source" = "Qur’an 25:74";

"discovery.card.ayah_26_80.title" = "Ash-Shu'araa 80";
"discovery.card.ayah_26_80.meaning" = "und Der, wenn ich krank bin, mich heilt,";
"discovery.card.ayah_26_80.source" = "Qur’an 26:80";

"discovery.card.ayah_26_89.title" = "Ash-Shu'araa 89";
"discovery.card.ayah_26_89.meaning" = "außer, wer zu Allah mit heilem Herzen kommt.\"";
"discovery.card.ayah_26_89.source" = "Qur’an 26:89";

"discovery.card.ayah_27_19.title" = "An-Naml 19";
"discovery.card.ayah_27_19.meaning" = "Da lächelte er erheitert über ihre Worte und sagte: \"Mein Herr, veranlasse mich, für Deine Gunst zu danken, die Du mir und meinen Eltern erwiesen hast, und rechtschaffen zu handeln, womit Du zufrieden bist. Und lasse mich durch Deine Barmherzigkeit eingehen in die Reihen Deiner rechtschaffenen Diener.\"";
"discovery.card.ayah_27_19.source" = "Qur’an 27:19";

"discovery.card.ayah_27_62.title" = "An-Naml 62";
"discovery.card.ayah_27_62.meaning" = "Oder (ist besser) Wer den in einer Notlage Befindlichen erhört, wenn er Ihn anruft, und das Böse hinwegnimmt und euch zu Nachfolgern (auf) der Erde macht? Gibt es denn einen (anderen) Gott neben Allah? Wie wenig ihr bedenkt!";
"discovery.card.ayah_27_62.source" = "Qur’an 27:62";

"discovery.card.ayah_28_56.title" = "Al-Qasas 56";
"discovery.card.ayah_28_56.meaning" = "Gewiß, du kannst nicht rechtleiten, wen du gern (rechtgeleitet sehen) möchtest. Allah aber leitet recht, wen Er will. Er kennt sehr wohl die Rechtgeleiteten.";
"discovery.card.ayah_28_56.source" = "Qur’an 28:56";

"discovery.card.ayah_28_77.title" = "Al-Qasas 77";
"discovery.card.ayah_28_77.meaning" = "sondern trachte mit dem, was Allah dir gegeben hat, nach der jenseitigen Wohnstätte, vergiß aber auch nicht deinen Anteil am Diesseits. Und tu Gutes, so wie Allah dir Gutes getan hat. Und trachte nicht nach Unheil auf der Erde, denn Allah liebt nicht die Unheilstifter.\"";
"discovery.card.ayah_28_77.source" = "Qur’an 28:77";

"discovery.card.ayah_29_45.title" = "Al-Ankaboot 45";
"discovery.card.ayah_29_45.meaning" = "Verlies, was dir vom Buch (als Offenbarung) eingegeben wird, und verrichte das Gebet. Gewiß, das Gebet hält davon ab, das Schändliche und das Verwerfliche (zu tun). Und das Gedenken Allahs ist wahrlich größer. Und Allah weiß, was ihr macht.";
"discovery.card.ayah_29_45.source" = "Qur’an 29:45";

"discovery.card.ayah_29_69.title" = "Al-Ankaboot 69";
"discovery.card.ayah_29_69.meaning" = "Diejenigen aber, die sich um Unsertwillen abmühen, werden Wir ganz gewiß Unsere Wege leiten. Und Allah ist wahrlich mit den Gutes Tuenden.";
"discovery.card.ayah_29_69.source" = "Qur’an 29:69";

"discovery.card.ayah_31_12.title" = "Luqman 12";
"discovery.card.ayah_31_12.meaning" = "Und Wir gaben ja Luqman Weisheit: \"Sei Allah dankbar.\" Und wer dankbar ist, der ist nur zu seinem eigenen Vorteil dankbar. Und wer undankbar ist, - so ist Allah Unbedürftig und Lobenswürdig.";
"discovery.card.ayah_31_12.source" = "Qur’an 31:12";

"discovery.card.ayah_31_13.title" = "Luqman 13";
"discovery.card.ayah_31_13.meaning" = "Und (gedenke,) als Luqman zu seinem Sohn sagte, indem er ihn ermahnte: \"O mein lieber Sohn, geselle Allah nicht(s) bei, denn Götzendienst ist fürwahr ein gewal tiges Unrecht.\"";
"discovery.card.ayah_31_13.source" = "Qur’an 31:13";

"discovery.card.ayah_31_18.title" = "Luqman 18";
"discovery.card.ayah_31_18.meaning" = "Und zeige den Menschen nicht geringschätzig die Wange und gehe nicht übermütig auf der Erde einher, denn Allah liebt niemanden, der eingebildet und prahlerisch ist.";
"discovery.card.ayah_31_18.source" = "Qur’an 31:18";

"discovery.card.ayah_31_19.title" = "Luqman 19";
"discovery.card.ayah_31_19.meaning" = "Halte das rechte Maß in deinem Gang und dämpfe deine Stimme, denn die widerwärtigste der Stimmen ist wahrlich die Stimme der Esel.\"";
"discovery.card.ayah_31_19.source" = "Qur’an 31:19";

"discovery.card.ayah_32_16.title" = "As-Sajda 16";
"discovery.card.ayah_32_16.meaning" = "Ihre Seiten weichen vor den Schlafstätten zurück; sie rufen ihren Herrn in Furcht und Begehren an und geben von dem, womit Wir sie versorgt haben, aus.";
"discovery.card.ayah_32_16.source" = "Qur’an 32:16";

"discovery.card.ayah_32_17.title" = "As-Sajda 17";
"discovery.card.ayah_32_17.meaning" = "Keine Seele weiß, welche Freuden im Verborgenen für sie bereitgehalten werden als Lohn für das, was sie zu tun pflegten.";
"discovery.card.ayah_32_17.source" = "Qur’an 32:17";

"discovery.card.ayah_33_21.title" = "Al-Ahzaab 21";
"discovery.card.ayah_33_21.meaning" = "Ihr habt ja im Gesandten Allahs ein schönes Vorbild, (und zwar) für einen jeden, der auf Allah und den Jüngsten Tag hofft und Allahs viel gedenkt.";
"discovery.card.ayah_33_21.source" = "Qur’an 33:21";

"discovery.card.ayah_33_35.title" = "Al-Ahzaab 35";
"discovery.card.ayah_33_35.meaning" = "Gewiß, muslimische Männer und muslimische Frauen, gläubige Männer und gläubige Frauen, ergebene Männer und ergebene Frauen, wahrhaftige Männer und wahrhaftige Frauen, standhafte Männer und standhafte Frauen, demütige Männer und demütige Frauen, Almosen gebende Männer und Almosen gebende Frauen, fa stende Männer und fastende Frauen, Männer, die ihre Scham hüten und Frauen, die (ihre Scham) hüten, und Allahs viel gedenkende Männer und gedenkende Frauen für (all) sie hat Allah Vergebung und großartigen Lohn bereitet.";
"discovery.card.ayah_33_35.source" = "Qur’an 33:35";

"discovery.card.ayah_33_41.title" = "Al-Ahzaab 41";
"discovery.card.ayah_33_41.meaning" = "O die ihr glaubt, gedenkt Allahs in häufigem Gedenken";
"discovery.card.ayah_33_41.source" = "Qur’an 33:41";

"discovery.card.ayah_33_56.title" = "Al-Ahzaab 56";
"discovery.card.ayah_33_56.meaning" = "Gewiß, Allah und Seine Engel sprechen den Segen über den Propheten. O die ihr glaubt, sprecht den Segen über ihn und grüßt ihn mit gehörigem Gruß.";
"discovery.card.ayah_33_56.source" = "Qur’an 33:56";

"discovery.card.ayah_33_70.title" = "Al-Ahzaab 70";
"discovery.card.ayah_33_70.meaning" = "O die ihr glaubt, fürchtet Allah und sagt treffende Worte,";
"discovery.card.ayah_33_70.source" = "Qur’an 33:70";

"discovery.card.ayah_35_10.title" = "Faatir 10";
"discovery.card.ayah_35_10.meaning" = "Wenn immer einer die Macht anstrebt, so gehört alle Macht Allah. Zu Ihm steigt das gute Wort hinauf, und die rechtschaffene Tat hebt Er (zu sich) empor. Und für diejenigen, die Ränke böser Taten schmieden, wird es strenge Strafe geben, und die Ränke jener werden zu Fall kommen.";
"discovery.card.ayah_35_10.source" = "Qur’an 35:10";

"discovery.card.ayah_35_28.title" = "Faatir 28";
"discovery.card.ayah_35_28.meaning" = "Und unter den Menschen und den Tieren und dem Vieh gibt es (auf ähnliche Weise) unterschiedliche Farben. So ist es. Allah fürchten von Seinen Dienern eben nur die Gelehrten. Gewiß, Allah ist Allmächtig und Allvergebend.";
"discovery.card.ayah_35_28.source" = "Qur’an 35:28";

"discovery.card.ayah_36_1.title" = "Yaseen 1";
"discovery.card.ayah_36_1.meaning" = "Ya-Sin.";
"discovery.card.ayah_36_1.source" = "Qur’an 36:1";

"discovery.card.ayah_36_22.title" = "Yaseen 22";
"discovery.card.ayah_36_22.meaning" = "Und warum sollte ich nicht Demjenigen dienen, Der mich erschaffen hat und zu Dem ihr zurückgebracht werdet?";
"discovery.card.ayah_36_22.source" = "Qur’an 36:22";

"discovery.card.ayah_36_58.title" = "Yaseen 58";
"discovery.card.ayah_36_58.meaning" = "\"Friede!\", als (Gruß)wort von einem barmherzigen Herrn.";
"discovery.card.ayah_36_58.source" = "Qur’an 36:58";

"discovery.card.ayah_37_96.title" = "As-Saaffaat 96";
"discovery.card.ayah_37_96.meaning" = "wo doch Allah euch und das, was ihr tut, erschaffen hat?\"";
"discovery.card.ayah_37_96.source" = "Qur’an 37:96";

"discovery.card.ayah_38_29.title" = "Saad 29";
"discovery.card.ayah_38_29.meaning" = "(Dies ist) ein gesegnetes Buch, das Wir zu dir hinabgesandt haben, damit sie über seine Zeichen nachsinnen und damit diejenigen bedenken, die Verstand besitzen.";
"discovery.card.ayah_38_29.source" = "Qur’an 38:29";

"discovery.card.ayah_39_9.title" = "Az-Zumar 9";
"discovery.card.ayah_39_9.meaning" = "Ist etwa einer, der sich zu (verschiedenen) Stunden der Nacht in demütiger Andacht befindet, (ob er) sich niederwirft oder aufrecht steht, der sich vor dem Jenseits vorsieht und auf seines Herrn Barmherzigkeit hofft ...? - Sag: Sind etwa dieje nigen, die wissen, und diejenigen, die nicht wissen, gleich? Doch bedenken nur diejenigen, die Verstand besitzen.";
"discovery.card.ayah_39_9.source" = "Qur’an 39:9";

"discovery.card.ayah_39_10.title" = "Az-Zumar 10";
"discovery.card.ayah_39_10.meaning" = "Sag: O meine Diener, die ihr gläubig seid, fürchtet euren Herrn. Für diejenigen, die Gutes tun, gibt es hier im Diesseits Gutes. Und Allahs Erde ist weit. Gewiß, den Standhaften wird ihr Lohn ohne Berechnung in vollem Maß zukommen.";
"discovery.card.ayah_39_10.source" = "Qur’an 39:10";

"discovery.card.ayah_39_36.title" = "Az-Zumar 36";
"discovery.card.ayah_39_36.meaning" = "Wird Allah nicht Seinem Diener genügen? Dennoch wollen sie dir mit denjenigen, die es außer Ihm geben soll, Furcht einflößen. Und wen Allah in die Irre gehen läßt, der hat niemanden, der ihn rechtleitet.";
"discovery.card.ayah_39_36.source" = "Qur’an 39:36";

"discovery.card.ayah_40_60.title" = "Ghafir 60";
"discovery.card.ayah_40_60.meaning" = "Euer Herr sagt: \"Ruft Mich an, so erhöre Ich euch. Gewiß, diejenigen, die sich aus Hochmut weigern, Mir zu dienen, werden in die Hölle gedemütigt eingehen.\"";
"discovery.card.ayah_40_60.source" = "Qur’an 40:60";

"discovery.card.ayah_40_65.title" = "Ghafir 65";
"discovery.card.ayah_40_65.meaning" = "Er ist der Lebendige. Es gibt keinen Gott außer Ihm. So ruft Ihn an, (wobei ihr) Ihm gegenüber aufrichtig in der Religion (seid). (Alles) Lob gehört Allah, dem Herrn der Weltenbewohner!";
"discovery.card.ayah_40_65.source" = "Qur’an 40:65";

"discovery.card.ayah_41_30.title" = "Fussilat 30";
"discovery.card.ayah_41_30.meaning" = "Gewiß, diejenigen, die sagen: \"Unser Herr ist Allah\", und sich hierauf recht verhalten, auf sie kommen die Engel herab: \"Fürchtet euch nicht, seid nicht traurig, und vernehmt die frohe Botschaft vom (Paradies)garten', der euch stets versprochen wurde.";
"discovery.card.ayah_41_30.source" = "Qur’an 41:30";

"discovery.card.ayah_41_33.title" = "Fussilat 33";
"discovery.card.ayah_41_33.meaning" = "Und wer spricht bessere Worte als wer zu Allah ruft, rechtschaffen handelt und sagt: \"Gewiß doch, ich gehöre zu den (Allah) Ergebenen \" ?";
"discovery.card.ayah_41_33.source" = "Qur’an 41:33";

"discovery.card.ayah_41_34.title" = "Fussilat 34";
"discovery.card.ayah_41_34.meaning" = "Nicht gleich sind die gute Tat und die schlechte Tat. Wehre mit einer Tat, die besser ist, (die schlechte) ab, dann wird derjenige, zwischen dem und dir Feindschaft besteht, so, als wäre er ein warmherziger Freund.";
"discovery.card.ayah_41_34.source" = "Qur’an 41:34";

"discovery.card.ayah_42_13.title" = "Ash-Shura 13";
"discovery.card.ayah_42_13.meaning" = "Er hat euch von der Religion festgelegt, was Er Nuh anbefahl und was Wir dir (als Offenbarung) eingegeben haben und was Wir Ibrahim, Musa und 'Isa anbefahlen: Haltet die (Vorschriften der) Religion ein und spaltet euch nicht darin (in Gruppen). Den Götzendienern setzt das schwer zu, wozu du sie aufrufst. Allah erwählt dazu, wen Er will, und leitet dazu, wer sich (Ihm) reuig zuwendet.";
"discovery.card.ayah_42_13.source" = "Qur’an 42:13";

"discovery.card.ayah_42_19.title" = "Ash-Shura 19";
"discovery.card.ayah_42_19.meaning" = "Allah ist Feinfühlig zu Seinen Dienern. Er versorgt, wen Er will. Und Er ist der Starke und Allmächtige.";
"discovery.card.ayah_42_19.source" = "Qur’an 42:19";

"discovery.card.ayah_42_36.title" = "Ash-Shura 36";
"discovery.card.ayah_42_36.meaning" = "Was immer euch gegeben worden ist, ist Nießbrauch des diesseitigen Lebens. Was aber bei Allah ist, ist besser und beständiger für diejenigen, die glauben und sich auf ihren Herrn verlassen,";
"discovery.card.ayah_42_36.source" = "Qur’an 42:36";

"discovery.card.ayah_43_36.title" = "Az-Zukhruf 36";
"discovery.card.ayah_43_36.meaning" = "Wer für die Ermahnung des Allerbarmers blind ist, dem verschaffen Wir einen Satan, der ihm dann zum Gesellen wird.";
"discovery.card.ayah_43_36.source" = "Qur’an 43:36";

"discovery.card.ayah_44_3.title" = "Ad-Dukhaan 3";
"discovery.card.ayah_44_3.meaning" = "Wir haben es wahrlich in einer gesegneten Nacht herabgesandt - Wir haben ja (die Menschen) immer wieder gewarnt -,";
"discovery.card.ayah_44_3.source" = "Qur’an 44:3";

"discovery.card.ayah_45_15.title" = "Al-Jaathiya 15";
"discovery.card.ayah_45_15.meaning" = "Wer rechtschaffen handelt, der (tut es) zu seinem eigenen Vorteil, und wer Böses tut, der (tut es) zu seinem eigenen Nachteil. Hierauf werdet ihr zu eurem Herrn zurückgebracht.";
"discovery.card.ayah_45_15.source" = "Qur’an 45:15";

"discovery.card.ayah_46_13.title" = "Al-Ahqaf 13";
"discovery.card.ayah_46_13.meaning" = "Gewiß, diejenigen, die sagen: \"Unser Herr ist Allah\" und sich hierauf recht verhalten, über sie soll keine Furcht kommen, noch sollen sie traurig sein.";
"discovery.card.ayah_46_13.source" = "Qur’an 46:13";

"discovery.card.ayah_46_15.title" = "Al-Ahqaf 15";
"discovery.card.ayah_46_15.meaning" = "Und Wir haben dem Menschen anempfohlen, zu seinen Eltern gütig zu sein. Seine Mutter hat ihn unter Widerwillen getragen und unter Widerwillen zur Welt gebracht. Die (Zeit der) Schwangerschaft mit ihm bis zu seiner Entwöhnung (beträgt) dreißig Monate. Wenn er dann seine Vollreife erlangt hat und das Alter von vierzig Jahren erreicht hat, sagt er: \"Mein Herr, veranlasse mich, für Deine Gunst zu danken, die Du mir und meinen Eltern erwiesen hast, und rechtschaffen zu handeln, womit Du zufrieden bist. Und gib mir Rechtschaffenheit in meiner Nachkommenschaft. Ich wende mich Dir ja in Reue zu, und ich gehöre ja zu den (Dir) Ergebenen.\"";
"discovery.card.ayah_46_15.source" = "Qur’an 46:15";

"discovery.card.ayah_47_7.title" = "Muhammad 7";
"discovery.card.ayah_47_7.meaning" = "O die ihr glaubt, wenn ihr Allah(s Sache) helft, hilft Er euch und festigt eure Füße.";
"discovery.card.ayah_47_7.source" = "Qur’an 47:7";

"discovery.card.ayah_47_19.title" = "Muhammad 19";
"discovery.card.ayah_47_19.meaning" = "Wisse also, daß es keinen Gott außer Allah gibt. Und bitte um Vergebung für deine Sünde und für die gläubigen Männer und die gläubigen Frauen. Allah kennt euren Wandel und euren Aufenthalt.";
"discovery.card.ayah_47_19.source" = "Qur’an 47:19";

"discovery.card.ayah_48_1.title" = "Al-Fath 1";
"discovery.card.ayah_48_1.meaning" = "Gewiß, Wir haben dir einen deutlichen Sieg verliehen,";
"discovery.card.ayah_48_1.source" = "Qur’an 48:1";

"discovery.card.ayah_48_29.title" = "Al-Fath 29";
"discovery.card.ayah_48_29.meaning" = "Muhammad ist Allahs Gesandter. Und diejenigen, die mit ihm sind, sind den Ungläubigen gegenüber hart, zueinander aber barmherzig. Du siehst sie sich verbeugen und niederwerfen, indem sie nach Huld von Allah und Wohlgefallen trachten. Ihr Merkmal steht auf ihren Gesichtern durch die Niederwerfung. Das ist ihr Gleichnis in der Tora. Und ihr Gleichnis im Evangelium ist das eines Getreidefeldes, das seine Triebe hervorbringt und dann stärker werden läßt, so daß sie verdicken und ebenmäßig auf ihren Halmen stehen, so daß es den Anbauern gefällt. (Dies,) damit Er die Ungläubigen durch sie ergrimmen lasse. Allah hat denjenigen von ihnen, die glauben und rechtschaffene Werke tun, Vergebung und großartigen Lohn versprochen.";
"discovery.card.ayah_48_29.source" = "Qur’an 48:29";

"discovery.card.ayah_49_10.title" = "Al-Hujuraat 10";
"discovery.card.ayah_49_10.meaning" = "Die Gläubigen sind doch Brüder. So stiftet Frieden zwischen euren beiden Brüdern und fürchtet Allah, auf daß ihr Erbarmen finden möget.";
"discovery.card.ayah_49_10.source" = "Qur’an 49:10";

"discovery.card.ayah_49_11.title" = "Al-Hujuraat 11";
"discovery.card.ayah_49_11.meaning" = "O die ihr glaubt, die einen sollen nicht über die anderen spotten, vielleicht sind eben diese besser als sie. Auch sollen nicht Frauen über andere Frauen (spotten), vielleicht sind eben diese besser als sie. Und beleidigt euch nicht gegenseitig durch Gesten und bewerft euch nicht gegenseitig mit (häßlichen) Beinamen. Wie schlimm ist die Bezeichnung \"Frevel\" nach (der Bezeichnung) \"Glaube\"! Und wer nicht bereut, das sind die Ungerechten.";
"discovery.card.ayah_49_11.source" = "Qur’an 49:11";

"discovery.card.ayah_51_19.title" = "Adh-Dhaariyat 19";
"discovery.card.ayah_51_19.meaning" = "und (sie gestanden) an ihrem Besitz dem Bettler und dem Unbemittelten ein Anrecht (zu).";
"discovery.card.ayah_51_19.source" = "Qur’an 51:19";

"discovery.card.ayah_51_56.title" = "Adh-Dhaariyat 56";
"discovery.card.ayah_51_56.meaning" = "Und Ich habe die Ginn und die Menschen nur (dazu) erschaffen, damit sie Mir dienen.";
"discovery.card.ayah_51_56.source" = "Qur’an 51:56";

"discovery.card.ayah_52_21.title" = "At-Tur 21";
"discovery.card.ayah_52_21.meaning" = "Und denjenigen, die glauben und denen ihre Nachkommenschaft im Glauben nachfolgt, lassen Wir ihre Nachkommenschaft sich (ihnen) anschließen. Und Wir verringern ihnen gar nichts von ihren Werken. Jedermann ist an das, was er erworben hat, gebunden.";
"discovery.card.ayah_52_21.source" = "Qur’an 52:21";

"discovery.card.ayah_53_32.title" = "An-Najm 32";
"discovery.card.ayah_53_32.meaning" = "Diejenigen, die schwerwiegende Sünden und Abscheulichkeiten meiden, außer leichten Verfehlungen... Gewiß, dein Herr ist Allumfassend in (Seiner) Vergebung. Er weiß sehr wohl über euch Bescheid, als Er euch aus der Erde hervorgebracht hat und als ihr Keimlinge in den Leibern eurer Mütter gewesen seid. So erklärt nicht euch selbst für lauter. Er weiß sehr wohl, wer gottesfürchtig ist.";
"discovery.card.ayah_53_32.source" = "Qur’an 53:32";

"discovery.card.ayah_53_39.title" = "An-Najm 39";
"discovery.card.ayah_53_39.meaning" = "und daß es für den Menschen nichts anderes geben wird als das, worum er sich (selbst) bemüht,";
"discovery.card.ayah_53_39.source" = "Qur’an 53:39";

"discovery.card.ayah_54_17.title" = "Al-Qamar 17";
"discovery.card.ayah_54_17.meaning" = "Und Wir haben den Qur'an ja leicht zum Bedenken gemacht. Aber gibt es jemanden, der bedenkt?";
"discovery.card.ayah_54_17.source" = "Qur’an 54:17";

"discovery.card.ayah_55_1.title" = "Ar-Rahmaan 1";
"discovery.card.ayah_55_1.meaning" = "Der Allerbarmer";
"discovery.card.ayah_55_1.source" = "Qur’an 55:1";

"discovery.card.ayah_55_46.title" = "Ar-Rahmaan 46";
"discovery.card.ayah_55_46.meaning" = "Für jemanden aber, der den Stand seines Herrn fürchtet, wird es zwei Gärten geben";
"discovery.card.ayah_55_46.source" = "Qur’an 55:46";

"discovery.card.ayah_56_10.title" = "Al-Waaqia 10";
"discovery.card.ayah_56_10.meaning" = "Und die Vorausgeeilten, ja die Vorausgeeilten,";
"discovery.card.ayah_56_10.source" = "Qur’an 56:10";

"discovery.card.ayah_57_16.title" = "Al-Hadid 16";
"discovery.card.ayah_57_16.meaning" = "Ist es denn nicht Zeit für diejenigen, die glauben, daß ihre Herzen demütig werden vor Allahs Ermahnung und vor dem, was von der Wahrheit herabgekommen ist, und daß sie nicht wie diejenigen sind, denen zuvor die Schrift gegeben wurde, es ihnen aber zu lang gedauert hat, und so ihre Herzen sich verhärtet haben? Und viele von ihnen sind Frevler.";
"discovery.card.ayah_57_16.source" = "Qur’an 57:16";

"discovery.card.ayah_57_20.title" = "Al-Hadid 20";
"discovery.card.ayah_57_20.meaning" = "Wißt, daß das diesseitige Leben nur Spiel und Zerstreuung ist, Schmuck und gegenseitige Prahlerei und Wettstreit nach noch mehr Besitz und Kindern. Es ist wie das Gleichnis von Regen, dessen Pflanzenwuchs den Ungläubigen gefällt. Hierauf aber trocknet er aus, und da siehst du ihn gelb werden. Hierauf wird es zu zermalmtem Zeug. Im Jenseits aber gibt es strenge Strafe und (auch) Vergebung von Allah und Wohlgefallen. Und das diesseitige Leben ist nur trügerischer Genuß.";
"discovery.card.ayah_57_20.source" = "Qur’an 57:20";

"discovery.card.ayah_57_21.title" = "Al-Hadid 21";
"discovery.card.ayah_57_21.meaning" = "Wetteilt zu Vergebung von eurem Herrn und (zu) einem (Paradies)garten, dessen Breite wie die Breite der Himmel und der Erde ist, bereitet für diejenigen, die an Allah und Seine Gesandten glauben. Das ist Allahs Huld, die Er gewährt, wem Er will. Und Allah besitzt große Huld.";
"discovery.card.ayah_57_21.source" = "Qur’an 57:21";

"discovery.card.ayah_58_11.title" = "Al-Mujaadila 11";
"discovery.card.ayah_58_11.meaning" = "O die ihr glaubt, wenn zu euch gesagt wird: \"Macht Platz!\" in den Versammlungen!, dann schafft Platz, so schafft auch Allah euch Platz. Und wenn gesagt wird: \"Erhebt euch!\", dann erhebt euch eben, so erhöht auch Allah diejenigen von euch, die glauben, und diejenigen, denen das Wissen gegeben worden ist, um Rangstufen. Und Allah ist dessen, was ihr tut, Kundig.";
"discovery.card.ayah_58_11.source" = "Qur’an 58:11";

"discovery.card.ayah_59_9.title" = "Al-Hashr 9";
"discovery.card.ayah_59_9.meaning" = "Und diejenigen, die in der Wohnstätte und im Glauben vor ihnen zu Hause waren, lieben (all die,) wer zu ihnen ausgewandert ist, und empfinden in ihren Brüsten kein Bedürfnis nach dem, was (diesen) gegeben worden ist, und sie ziehen (sie) sich selbst vor, auch wenn sie selbst Mangel erlitten. Und diejenigen, die vor ihrer eigenen Habsucht bewahrt bleiben, das sind diejenigen, denen es wohl ergeht.";
"discovery.card.ayah_59_9.source" = "Qur’an 59:9";

"discovery.card.ayah_59_18.title" = "Al-Hashr 18";
"discovery.card.ayah_59_18.meaning" = "O die ihr glaubt, fürchtet Allah. Und eine jede Seele schaue, was sie für morgen vorausschickt. Und fürchtet Allah; gewiß, Allah ist Kundig dessen, was ihr tut.";
"discovery.card.ayah_59_18.source" = "Qur’an 59:18";

"discovery.card.ayah_59_22.title" = "Al-Hashr 22";
"discovery.card.ayah_59_22.meaning" = "Er ist Allah, außer dem es keinen Gott gibt, der Kenner des Verborgenen und des Offenbaren. Er ist der Allerbarmer und Barmherzige.";
"discovery.card.ayah_59_22.source" = "Qur’an 59:22";

"discovery.card.ayah_61_2.title" = "As-Saff 2";
"discovery.card.ayah_61_2.meaning" = "O die ihr glaubt, warum sagt ihr, was ihr nicht tut?";
"discovery.card.ayah_61_2.source" = "Qur’an 61:2";

"discovery.card.ayah_61_10.title" = "As-Saff 10";
"discovery.card.ayah_61_10.meaning" = "O die ihr glaubt, soll ich euch auf einen Handel hinweisen, der euch vor schmerzhafter Strafe rettet?";
"discovery.card.ayah_61_10.source" = "Qur’an 61:10";

"discovery.card.ayah_61_13.title" = "As-Saff 13";
"discovery.card.ayah_61_13.meaning" = "Und (noch) eine andere (Huld), die ihr liebt (, wird euch gewährt): Hilfe von Allah und ein naher Sieg. Und (so) verkünde (diese) frohe Botschaft den Gläubigen.";
"discovery.card.ayah_61_13.source" = "Qur’an 61:13";

"discovery.card.ayah_62_9.title" = "Al-Jumu'a 9";
"discovery.card.ayah_62_9.meaning" = "O die ihr glaubt, wenn zum Gebet gerufen wird am Freitag, dann eilt zu Allahs Gedenken und laßt das Kaufgeschäft. Das ist besser für euch, wenn ihr wißt.";
"discovery.card.ayah_62_9.source" = "Qur’an 62:9";

"discovery.card.ayah_62_10.title" = "Al-Jumu'a 10";
"discovery.card.ayah_62_10.meaning" = "Wenn das Gebet beendet ist, dann breitet euch im Land aus und trachtet nach etwas von Allahs Huld. Und gedenkt Allahs viel, auf daß es euch wohl ergehen möge!";
"discovery.card.ayah_62_10.source" = "Qur’an 62:10";

"discovery.card.ayah_63_9.title" = "Al-Munaafiqoon 9";
"discovery.card.ayah_63_9.meaning" = "O die ihr glaubt, nicht ablenken sollen euch euer Besitz und eure Kinder von Allahs Gedenken. Diejenigen, die dies tun, das sind die Verlierer.";
"discovery.card.ayah_63_9.source" = "Qur’an 63:9";

"discovery.card.ayah_64_16.title" = "At-Taghaabun 16";
"discovery.card.ayah_64_16.meaning" = "Daher fürchtet Allah, soweit ihr könnt. Und hört zu und gehorcht und gebt Gutes für euch selbst aus'. Und diejenigen, die vor ihrer eigenen Habsucht bewahrt bleiben, das sind diejenigen, denen es wohl ergeht.";
"discovery.card.ayah_64_16.source" = "Qur’an 64:16";

"discovery.card.ayah_65_4.title" = "At-Talaaq 4";
"discovery.card.ayah_65_4.meaning" = "Und diejenigen von euren Frauen, die keine Monatsblutung mehr erwarten, wenn ihr im Zweifel seid, so ist ihre Wartezeit drei Monate; und ebenso derjenigen, die (noch) keine Monatsblutung haben. Diejenigen, die schwanger sind - ihre Frist ist (erreicht), wenn sie mit dem niederkommen, was sie (in ihren Leibern) tragen. Und wer Allah fürchtet, dem schafft Er in seiner Angelegenheit Erleichterung.";
"discovery.card.ayah_65_4.source" = "Qur’an 65:4";

"discovery.card.ayah_66_8.title" = "At-Tahrim 8";
"discovery.card.ayah_66_8.meaning" = "O die ihr glaubt, kehrt zu Allah um in aufrichtiger Reue; vielleicht wird euer Herr euch eure bösen Taten tilgen und euch in Gärten eingehen lassen, durcheilt von Bächen, am Tag, da Allah den Propheten und diejenigen, die mit ihm geglaubt haben, nicht in Schande stürzen wird. Ihr Licht eilt ihnen voraus und (ebenso) zu ihrer Rechten. Sie werden sagen: \"Unser Herr, vollende für uns unser Licht und vergib uns. Gewiß, Du hast zu allem die Macht.\"";
"discovery.card.ayah_66_8.source" = "Qur’an 66:8";

"discovery.card.ayah_67_1.title" = "Al-Mulk 1";
"discovery.card.ayah_67_1.meaning" = "Segensreich ist Derjenige, in Dessen Hand die Herrschaft ist, und Er hat zu allem die Macht.";
"discovery.card.ayah_67_1.source" = "Qur’an 67:1";

"discovery.card.ayah_67_14.title" = "Al-Mulk 14";
"discovery.card.ayah_67_14.meaning" = "Sollte denn Derjenige, Der erschaffen hat, nicht Bescheid wissen'? Und Er ist der Feinfühlige und Allkundige.";
"discovery.card.ayah_67_14.source" = "Qur’an 67:14";

"discovery.card.ayah_67_15.title" = "Al-Mulk 15";
"discovery.card.ayah_67_15.meaning" = "Er ist es, Der euch die Erde fügsam gemacht hat. So geht auf ihrem Rücken einher und eßt von dem, womit Er (euch) versorgt. Und zu Ihm wird die Auferstehung sein.";
"discovery.card.ayah_67_15.source" = "Qur’an 67:15";

"discovery.card.ayah_68_4.title" = "Al-Qalam 4";
"discovery.card.ayah_68_4.meaning" = "Und du bist wahrlich von großartiger Wesensart.";
"discovery.card.ayah_68_4.source" = "Qur’an 68:4";

"discovery.card.ayah_70_19.title" = "Al-Ma'aarij 19";
"discovery.card.ayah_70_19.meaning" = "Gewiß, der Mensch ist als kleinmütig erschaffen.";
"discovery.card.ayah_70_19.source" = "Qur’an 70:19";

"discovery.card.ayah_73_20.title" = "Al-Muzzammil 20";
"discovery.card.ayah_73_20.meaning" = "Gewiß, dein Herr weiß, daß du etwas weniger als zwei Drittel der Nacht (zum Gebet) aufstehst, oder die Hälfte oder ein Drittel davon, und (ebenso) ein Teil von denjenigen, die mit dir sind. Und Allah setzt das Maß der Nacht und des Tages fest. Er weiß, daß ihr es nicht erfassen würdet'. Da wandte Er Sich euch zu und erließ es euch. So lest (bei Nacht), was euch vom Qur'an leichtfällt. Er weiß, daß es unter euch Kranke geben wird und andere, die im Land umherreisen, wo sie nach (etwas) von Allahs Huld trachten, und (wieder) andere, die auf Allahs Weg kämpfen. So lest davon, was euch leichtfällt, und verrichtet das Gebet und entrichtet die Abgabe und gebt Allah ein gutes Darlehen. Und was ihr für euch selbst an Gutem vorausschickt, das werdet ihr noch besser und großartiger belohnt bei Allah finden. Und bittet Allah um Vergebung. Gewiß, Allah ist Allvergebend und Barmherzig.";
"discovery.card.ayah_73_20.source" = "Qur’an 73:20";

"discovery.card.ayah_74_3.title" = "Al-Muddaththir 3";
"discovery.card.ayah_74_3.meaning" = "und deinen Herrn, Den preise als den Größten,";
"discovery.card.ayah_74_3.source" = "Qur’an 74:3";

"discovery.card.ayah_76_8.title" = "Al-Insaan 8";
"discovery.card.ayah_76_8.meaning" = "und sie geben - obwohl man sie liebt - Speise zu essen einem Armen, einer Waisen und einem Gefangenen:";
"discovery.card.ayah_76_8.source" = "Qur’an 76:8";

"discovery.card.ayah_76_9.title" = "Al-Insaan 9";
"discovery.card.ayah_76_9.meaning" = "\"Wir speisen euch nur um Allahs Angesicht willen. Wir wollen von euch weder Belohnung noch Dank.";
"discovery.card.ayah_76_9.source" = "Qur’an 76:9";

"discovery.card.ayah_87_1.title" = "Al-A'laa 1";
"discovery.card.ayah_87_1.meaning" = "Preise den Namen deines höchsten Herrn,";
"discovery.card.ayah_87_1.source" = "Qur’an 87:1";

"discovery.card.ayah_87_14.title" = "Al-A'laa 14";
"discovery.card.ayah_87_14.meaning" = "Wohl ergehen wird es ja jemandem, der sich läutert,";
"discovery.card.ayah_87_14.source" = "Qur’an 87:14";

"discovery.card.ayah_89_27.title" = "Al-Fajr 27";
"discovery.card.ayah_89_27.meaning" = "O du Seele, die du Ruhe gefunden hast,";
"discovery.card.ayah_89_27.source" = "Qur’an 89:27";

"discovery.card.ayah_89_28.title" = "Al-Fajr 28";
"discovery.card.ayah_89_28.meaning" = "kehre zu deinem Herrn zufrieden und mit Wohlgefallen zurück.";
"discovery.card.ayah_89_28.source" = "Qur’an 89:28";

"discovery.card.ayah_90_12.title" = "Al-Balad 12";
"discovery.card.ayah_90_12.meaning" = "Und was läßt dich wissen, was der steile Paßweg ist?";
"discovery.card.ayah_90_12.source" = "Qur’an 90:12";

"discovery.card.ayah_90_13.title" = "Al-Balad 13";
"discovery.card.ayah_90_13.meaning" = "(Es ist) die Freilassung eines Sklaven10";
"discovery.card.ayah_90_13.source" = "Qur’an 90:13";

"discovery.card.ayah_91_9.title" = "Ash-Shams 9";
"discovery.card.ayah_91_9.meaning" = "Wohl ergehen wird es ja jemandem, der sie läutert,";
"discovery.card.ayah_91_9.source" = "Qur’an 91:9";

"discovery.card.ayah_92_5.title" = "Al-Lail 5";
"discovery.card.ayah_92_5.meaning" = "Was nun jemanden angeht, der gibt und gottesfürchtig ist";
"discovery.card.ayah_92_5.source" = "Qur’an 92:5";

"discovery.card.ayah_92_18.title" = "Al-Lail 18";
"discovery.card.ayah_92_18.meaning" = "der seinen Besitz hingibt, um sich zu läutern,";
"discovery.card.ayah_92_18.source" = "Qur’an 92:18";

"discovery.card.ayah_93_5.title" = "Ad-Dhuhaa 5";
"discovery.card.ayah_93_5.meaning" = "Und dein Herr wird dir wahrlich geben, und dann wirst du zufrieden sein.";
"discovery.card.ayah_93_5.source" = "Qur’an 93:5";

"discovery.card.ayah_93_6.title" = "Ad-Dhuhaa 6";
"discovery.card.ayah_93_6.meaning" = "Hat Er dich nicht als Waise gefunden und (dir) dann Zuflucht verschafft";
"discovery.card.ayah_93_6.source" = "Qur’an 93:6";

"discovery.card.ayah_93_7.title" = "Ad-Dhuhaa 7";
"discovery.card.ayah_93_7.meaning" = "und dich irregehend gefunden und dann rechtgeleitet";
"discovery.card.ayah_93_7.source" = "Qur’an 93:7";

"discovery.card.ayah_93_8.title" = "Ad-Dhuhaa 8";
"discovery.card.ayah_93_8.meaning" = "und dich arm gefunden und dann reich gemacht?";
"discovery.card.ayah_93_8.source" = "Qur’an 93:8";

"discovery.card.ayah_93_10.title" = "Ad-Dhuhaa 10";
"discovery.card.ayah_93_10.meaning" = "und was den Bettler angeht, so fahre (ihn) nicht an,";
"discovery.card.ayah_93_10.source" = "Qur’an 93:10";

"discovery.card.ayah_93_11.title" = "Ad-Dhuhaa 11";
"discovery.card.ayah_93_11.meaning" = "und was die Gunst deines Herrn angeht, so erzähle (davon).";
"discovery.card.ayah_93_11.source" = "Qur’an 93:11";

"discovery.card.ayah_94_6.title" = "Ash-Sharh 6";
"discovery.card.ayah_94_6.meaning" = "gewiß, mit der Erschwernis ist Erleichterung.";
"discovery.card.ayah_94_6.source" = "Qur’an 94:6";

"discovery.card.ayah_94_7.title" = "Ash-Sharh 7";
"discovery.card.ayah_94_7.meaning" = "Wenn du nun fertig bist, dann strenge dich an";
"discovery.card.ayah_94_7.source" = "Qur’an 94:7";

"discovery.card.ayah_94_8.title" = "Ash-Sharh 8";
"discovery.card.ayah_94_8.meaning" = "und nach deinem Herrn richte dein Begehren aus.";
"discovery.card.ayah_94_8.source" = "Qur’an 94:8";

"discovery.card.ayah_95_4.title" = "At-Tin 4";
"discovery.card.ayah_95_4.meaning" = "Wir haben den Menschen ja in schönster Gestaltung erschaffen,";
"discovery.card.ayah_95_4.source" = "Qur’an 95:4";

"discovery.card.ayah_96_1.title" = "Al-Alaq 1";
"discovery.card.ayah_96_1.meaning" = "Lies im Namen deines Herrn, Der erschaffen hat,";
"discovery.card.ayah_96_1.source" = "Qur’an 96:1";

"discovery.card.ayah_96_5.title" = "Al-Alaq 5";
"discovery.card.ayah_96_5.meaning" = "den Menschen gelehrt hat, was er nicht wußte.";
"discovery.card.ayah_96_5.source" = "Qur’an 96:5";

"discovery.card.ayah_97_1.title" = "Al-Qadr 1";
"discovery.card.ayah_97_1.meaning" = "Wir haben ihn ja in der Nacht der Bestimmung hinabgesandt.";
"discovery.card.ayah_97_1.source" = "Qur’an 97:1";

"discovery.card.ayah_97_5.title" = "Al-Qadr 5";
"discovery.card.ayah_97_5.meaning" = "Frieden ist sie bis zum Anbruch der Morgendämmerung.";
"discovery.card.ayah_97_5.source" = "Qur’an 97:5";

"discovery.card.ayah_99_7.title" = "Az-Zalzala 7";
"discovery.card.ayah_99_7.meaning" = "Wer nun im Gewicht eines Stäubchens Gutes tut, wird es sehen.";
"discovery.card.ayah_99_7.source" = "Qur’an 99:7";

"discovery.card.ayah_99_8.title" = "Az-Zalzala 8";
"discovery.card.ayah_99_8.meaning" = "Und wer im Gewicht eines Stäubchens Böses tut, wird es sehen.";
"discovery.card.ayah_99_8.source" = "Qur’an 99:8";

"discovery.card.ayah_102_1.title" = "At-Takaathur 1";
"discovery.card.ayah_102_1.meaning" = "Die Vermehrung lenkt euch ab,";
"discovery.card.ayah_102_1.source" = "Qur’an 102:1";

"discovery.card.ayah_102_8.title" = "At-Takaathur 8";
"discovery.card.ayah_102_8.meaning" = "Hierauf werdet ihr an jenem Tag ganz gewiß nach der Wonne gefragt werden.";
"discovery.card.ayah_102_8.source" = "Qur’an 102:8";

"discovery.card.ayah_103_3.title" = "Al-Asr 3";
"discovery.card.ayah_103_3.meaning" = "außer denjenigen, die glauben und rechtschaffene Werke tun und einander die Wahrheit eindringlich empfehlen und einander die Standhaftigkeit eindringlich empfehlen.";
"discovery.card.ayah_103_3.source" = "Qur’an 103:3";

"discovery.card.ayah_107_1.title" = "Al-Maa'un 1";
"discovery.card.ayah_107_1.meaning" = "Siehst du (nicht) denjenigen, der das Gericht für Lüge erklärt?";
"discovery.card.ayah_107_1.source" = "Qur’an 107:1";

"discovery.card.ayah_107_4.title" = "Al-Maa'un 4";
"discovery.card.ayah_107_4.meaning" = "Wehe nun den Betenden,";
"discovery.card.ayah_107_4.source" = "Qur’an 107:4";

"discovery.card.ayah_110_1.title" = "An-Nasr 1";
"discovery.card.ayah_110_1.meaning" = "Wenn Allahs Hilfe kommt und der Sieg";
"discovery.card.ayah_110_1.source" = "Qur’an 110:1";

"discovery.card.ayah_110_3.title" = "An-Nasr 3";
"discovery.card.ayah_110_3.meaning" = "dann lobpreise deinen Herrn und bitte Ihn um Vergebung; gewiß, Er ist Reueannehmend.";
"discovery.card.ayah_110_3.source" = "Qur’an 110:3";

"discovery.card.ayah_112_2.title" = "Al-Ikhlaas 2";
"discovery.card.ayah_112_2.meaning" = "Allah, der Überlegene.";
"discovery.card.ayah_112_2.source" = "Qur’an 112:2";

"discovery.card.ayah_112_3.title" = "Al-Ikhlaas 3";
"discovery.card.ayah_112_3.meaning" = "Er hat nicht gezeugt und ist nicht gezeugt worden,";
"discovery.card.ayah_112_3.source" = "Qur’an 112:3";

"discovery.card.ayah_112_4.title" = "Al-Ikhlaas 4";
"discovery.card.ayah_112_4.meaning" = "und niemand ist Ihm jemals gleich.";
"discovery.card.ayah_112_4.source" = "Qur’an 112:4";

"discovery.card.sunnah_bukhari_10.title" = "Sahih al-Buchari 10";
"discovery.card.sunnah_bukhari_10.meaning" = "Überliefert von 'Abdullah bin 'Amr: Der Prophet (ﷺ) sagte: \"Ein Muslim ist derjenige, der es vermeidet, den Muslimen mit seiner Zunge und seinen Händen Schaden zuzufügen. Und ein Muhajir (Auswanderer) ist derjenige, der alles aufgibt (verlässt), was Allah verboten hat.\"";
"discovery.card.sunnah_bukhari_10.source" = "Sahih al-Bukhari 10";

"discovery.card.sunnah_bukhari_11.title" = "Sahih al-Buchari 11";
"discovery.card.sunnah_bukhari_11.meaning" = "Überliefert von Abu Musa: Einige Leute fragten den Gesandten Allahs (ﷺ): \"Wessen Islam ist der beste? Das heißt: (Wer ist ein sehr guter Muslim)?\" Er antwortete: \"Derjenige, der es vermeidet, den Muslimen mit seiner Zunge und seinen Händen Schaden zuzufügen.\"";
"discovery.card.sunnah_bukhari_11.source" = "Sahih al-Bukhari 11";

"discovery.card.sunnah_bukhari_12.title" = "Sahih al-Buchari 12";
"discovery.card.sunnah_bukhari_12.meaning" = "Überliefert von 'Abdullah bin 'Amr: Ein Mann fragte den Propheten (ﷺ): \"Welche Art von Taten oder (welche Eigenschaften des) Islam sind gut?\" Der Prophet (ﷺ) antwortete: \"Den (Armen) zu essen geben und diejenigen zu grüßen, die man kennt und die man nicht kennt.\"";
"discovery.card.sunnah_bukhari_12.source" = "Sahih al-Bukhari 12";

"discovery.card.sunnah_bukhari_13.title" = "Sahih al-Buchari 13";
"discovery.card.sunnah_bukhari_13.meaning" = "Überliefert von Anas: Der Prophet (ﷺ) sagte: \"Keiner von euch wird den Glauben haben, bis er für seinen (muslimischen) Bruder wünscht, was er für sich selbst mag.\"";
"discovery.card.sunnah_bukhari_13.source" = "Sahih al-Bukhari 13";

"discovery.card.sunnah_bukhari_14.title" = "Sahih al-Buchari 14";
"discovery.card.sunnah_bukhari_14.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) sagte: \"Bei Dem, in Dessen Händen mein Leben ist, keiner von euch wird den Glauben haben, bis er mich mehr liebt als seinen Vater und seine Kinder.\"";
"discovery.card.sunnah_bukhari_14.source" = "Sahih al-Bukhari 14";

"discovery.card.sunnah_bukhari_15.title" = "Sahih al-Buchari 15";
"discovery.card.sunnah_bukhari_15.meaning" = "Überliefert von Anas: Der Prophet (ﷺ) sagte: \"Keiner von euch wird den Glauben haben, bis er mich mehr liebt als seinen Vater, seine Kinder und die ganze Menschheit.\"";
"discovery.card.sunnah_bukhari_15.source" = "Sahih al-Bukhari 15";

"discovery.card.sunnah_bukhari_17.title" = "Sahih al-Buchari 17";
"discovery.card.sunnah_bukhari_17.meaning" = "Überliefert von Anas: Der Prophet (ﷺ) sagte: \"Liebe zu den Ansar ist ein Zeichen des Glaubens und Hass auf die Ansar ist ein Zeichen der Heuchelei.\"";
"discovery.card.sunnah_bukhari_17.source" = "Sahih al-Bukhari 17";

"discovery.card.sunnah_bukhari_19.title" = "Sahih al-Buchari 19";
"discovery.card.sunnah_bukhari_19.meaning" = "Überliefert von Abu Said Al-Khudri: Der Gesandte Allahs (ﷺ) sagte: \"Bald wird eine Zeit kommen, in der das beste Eigentum eines Muslims Schafe sein werden, die er auf die Gipfel der Berge und an die Regenorte (Täler) mitnimmt, um mit seiner Religion vor Heimsuchungen zu fliehen.\"";
"discovery.card.sunnah_bukhari_19.source" = "Sahih al-Bukhari 19";

"discovery.card.sunnah_bukhari_24.title" = "Sahih al-Buchari 24";
"discovery.card.sunnah_bukhari_24.meaning" = "Überliefert von 'Abdullah (bin 'Umar): Einmal ging der Gesandte Allahs (ﷺ) an einem Ansari (Mann) vorüber, der seinen Bruder wegen Haya' zurechtwies. Darauf sagte der Gesandte Allahs (ﷺ): \"Lass ihn, denn Haya' ist ein Teil des Glaubens.\"";
"discovery.card.sunnah_bukhari_24.source" = "Sahih al-Bukhari 24";

"discovery.card.sunnah_bukhari_28.title" = "Sahih al-Buchari 28";
"discovery.card.sunnah_bukhari_28.meaning" = "Überliefert von 'Abdullah bin 'Amr: Eine Person fragte den Gesandten Allahs (ﷺ): \"Welche (Art von) Taten in oder (welche Eigenschaften des) Islam sind gut?\" Er antwortete: \"Den (Armen) zu essen geben und diejenigen zu grüßen, die man kennt und die man nicht kennt.\"";
"discovery.card.sunnah_bukhari_28.source" = "Sahih al-Bukhari 28";

"discovery.card.sunnah_bukhari_35.title" = "Sahih al-Buchari 35";
"discovery.card.sunnah_bukhari_35.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) sagte: \"Wer die Gebete in der Nacht von Qadr aus aufrichtigem Glauben verrichtet und in der Hoffnung, Allahs Belohnungen zu erlangen (nicht um sich zu zeigen), dem werden alle seine vergangenen Sünden vergeben.\"";
"discovery.card.sunnah_bukhari_35.source" = "Sahih al-Bukhari 35";

"discovery.card.sunnah_bukhari_37.title" = "Sahih al-Buchari 37";
"discovery.card.sunnah_bukhari_37.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) sagte: \"Wer in den Nächten des Ramadan die Gebete treu aus aufrichtigem Glauben verrichtet und in der Hoffnung, Allahs Belohnungen zu erlangen (nicht um sich zu zeigen), dem werden alle seine vergangenen Sünden vergeben.\"";
"discovery.card.sunnah_bukhari_37.source" = "Sahih al-Bukhari 37";

"discovery.card.sunnah_bukhari_38.title" = "Sahih al-Buchari 38";
"discovery.card.sunnah_bukhari_38.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) sagte: \"Wer im Monat Ramadan aus aufrichtigem Glauben fastet und in der Hoffnung, Allahs Belohnungen zu erlangen, dem werden alle seine vergangenen Sünden vergeben.\"";
"discovery.card.sunnah_bukhari_38.source" = "Sahih al-Bukhari 38";

"discovery.card.sunnah_bukhari_42.title" = "Sahih al-Buchari 42";
"discovery.card.sunnah_bukhari_42.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) sagte: \"Wenn einer von euch seine islamische Religion verbessert (streng befolgt), dann werden seine guten Taten zehn- bis siebenhundertfach für jede gute Tat belohnt, und eine schlechte Tat wird so aufgezeichnet, wie sie ist.\"";
"discovery.card.sunnah_bukhari_42.source" = "Sahih al-Bukhari 42";

"discovery.card.sunnah_bukhari_48.title" = "Sahih al-Buchari 48";
"discovery.card.sunnah_bukhari_48.meaning" = "Überliefert von 'Abdullah: Der Prophet (ﷺ) sagte: \"Einen Muslim zu beschimpfen ist Fusuq (eine Übeltat) und ihn zu töten ist Kufr (Unglaube).\"";
"discovery.card.sunnah_bukhari_48.source" = "Sahih al-Bukhari 48";

"discovery.card.sunnah_bukhari_55.title" = "Sahih al-Buchari 55";
"discovery.card.sunnah_bukhari_55.meaning" = "Überliefert von Abu Mas'ud: Der Prophet (ﷺ) sagte: \"Wenn ein Mann für seine Familie ausgibt (in der Absicht, eine Belohnung von Allah zu erhalten) aufrichtig um Allahs willen, dann ist das (eine Art) Almosen als Belohnung für ihn.\"";
"discovery.card.sunnah_bukhari_55.source" = "Sahih al-Bukhari 55";

"discovery.card.sunnah_bukhari_56.title" = "Sahih al-Buchari 56";
"discovery.card.sunnah_bukhari_56.meaning" = "Überliefert von Sa'd bin Abi Waqqas: Der Gesandte Allahs (ﷺ) sagte: \"Du wirst für alles belohnt, was du um Allahs willen ausgibst, selbst wenn es ein Bissen wäre, den du deiner Frau in den Mund legst.\"";
"discovery.card.sunnah_bukhari_56.source" = "Sahih al-Bukhari 56";

"discovery.card.sunnah_bukhari_57.title" = "Sahih al-Buchari 57";
"discovery.card.sunnah_bukhari_57.meaning" = "Überliefert von Jarir bin Abdullah: Ich leistete dem Gesandten Allahs (ﷺ) den Treueeid für Folgendes: 1. die Gebete vollkommen zu verrichten 2. den Zakat (die Pflichtabgabe) zu entrichten 3. und jedem Muslim gegenüber aufrichtig und wahrhaftig zu sein.";
"discovery.card.sunnah_bukhari_57.source" = "Sahih al-Bukhari 57";

"discovery.card.sunnah_bukhari_68.title" = "Sahih al-Buchari 68";
"discovery.card.sunnah_bukhari_68.meaning" = "Überliefert von Ibn Mas`ud: Der Prophet (ﷺ) achtete bei der Unterweisung darauf, einen geeigneten Zeitpunkt zu wählen, damit wir nicht überdrüssig würden. (Er hielt sich davon zurück, uns die ganze Zeit mit Predigten und Wissen zu belästigen.)";
"discovery.card.sunnah_bukhari_68.source" = "Sahih al-Bukhari 68";

"discovery.card.sunnah_bukhari_69.title" = "Sahih al-Buchari 69";
"discovery.card.sunnah_bukhari_69.meaning" = "Überliefert von Anas bin Malik: Der Prophet (ﷺ) sagte: \"Erleichtert den Menschen die Dinge (in religiösen Angelegenheiten), und macht es ihnen nicht schwer, und verkündet ihnen frohe Botschaft und treibt sie nicht in die Flucht (vor dem Islam).\"";
"discovery.card.sunnah_bukhari_69.source" = "Sahih al-Bukhari 69";

"discovery.card.sunnah_bukhari_75.title" = "Sahih al-Buchari 75";
"discovery.card.sunnah_bukhari_75.meaning" = "Überliefert von Ibn `Abbas: Einmal umarmte mich der Prophet (ﷺ) und sagte: \"O Allah! Verleihe ihm das Wissen des Buches (des Korans).\"";
"discovery.card.sunnah_bukhari_75.source" = "Sahih al-Bukhari 75";

"discovery.card.sunnah_bukhari_77.title" = "Sahih al-Buchari 77";
"discovery.card.sunnah_bukhari_77.meaning" = "Überliefert von Mahmud bin Rabi`a: Als ich ein fünfjähriger Junge war, erinnere ich mich, dass der Prophet (ﷺ) Wasser aus einem Eimer (der zum Schöpfen von Wasser aus einem Brunnen diente) mit dem Mund nahm und es mir ins Gesicht spritzte.";
"discovery.card.sunnah_bukhari_77.source" = "Sahih al-Bukhari 77";

"discovery.card.sunnah_bukhari_94.title" = "Sahih al-Buchari 94";
"discovery.card.sunnah_bukhari_94.meaning" = "Überliefert von Anas: Wann immer der Prophet (ﷺ) um Erlaubnis zum Eintreten bat, klopfte er dreimal mit dem Gruß an die Tür, und wann immer er einen Satz sprach (etwas sagte), pflegte er ihn dreimal zu wiederholen.";
"discovery.card.sunnah_bukhari_94.source" = "Sahih al-Bukhari 94";

"discovery.card.sunnah_bukhari_95.title" = "Sahih al-Buchari 95";
"discovery.card.sunnah_bukhari_95.meaning" = "Überliefert von Anas: Wann immer der Prophet (ﷺ) einen Satz sprach (etwas sagte), pflegte er ihn dreimal zu wiederholen, damit die Leute ihn richtig von ihm verstehen konnten, und wann immer er um Erlaubnis zum Eintreten bat, (klopfte er) dreimal mit dem Gruß (an die Tür).";
"discovery.card.sunnah_bukhari_95.source" = "Sahih al-Bukhari 95";

"discovery.card.sunnah_bukhari_102.title" = "Sahih al-Buchari 102";
"discovery.card.sunnah_bukhari_102.meaning" = "Überliefert von Abu Sa`id Al-Khudri: wie oben (die weiteren Überlieferer sind verschieden). Abu Huraira präzisierte, dass die drei Kinder, auf die in dem oben erwähnten Hadith Bezug genommen wird, das Alter, in dem man Sünden begeht (d. h. das Pubertätsalter), noch nicht erreicht hatten.";
"discovery.card.sunnah_bukhari_102.source" = "Sahih al-Bukhari 102";

"discovery.card.sunnah_bukhari_106.title" = "Sahih al-Buchari 106";
"discovery.card.sunnah_bukhari_106.meaning" = "Überliefert von `Ali: Der Prophet (ﷺ) sagte: \"Lügt nicht über mich, denn wer (absichtlich) über mich lügt, der wird ganz gewiss ins Höllenfeuer eingehen.\"";
"discovery.card.sunnah_bukhari_106.source" = "Sahih al-Bukhari 106";

"discovery.card.sunnah_bukhari_108.title" = "Sahih al-Buchari 108";
"discovery.card.sunnah_bukhari_108.meaning" = "Überliefert von Anas: Was mich davon abhält, euch eine große Zahl von Hadithen zu überliefern, ist, dass der Prophet (ﷺ) sagte: \"Wer absichtlich über mich lügt, der soll (ganz gewiss) seinen Platz im Höllenfeuer einnehmen.\"";
"discovery.card.sunnah_bukhari_108.source" = "Sahih al-Bukhari 108";

"discovery.card.sunnah_bukhari_109.title" = "Sahih al-Buchari 109";
"discovery.card.sunnah_bukhari_109.meaning" = "Überliefert von Salama: Ich hörte den Propheten (ﷺ) sagen: \"Wer mir (absichtlich) zuschreibt, was ich nicht gesagt habe, der soll (ganz gewiss) seinen Platz im Höllenfeuer einnehmen.\"";
"discovery.card.sunnah_bukhari_109.source" = "Sahih al-Bukhari 109";

"discovery.card.sunnah_bukhari_113.title" = "Sahih al-Buchari 113";
"discovery.card.sunnah_bukhari_113.meaning" = "Überliefert von Abu Huraira: Unter den Gefährten des Propheten (ﷺ) gibt es niemanden, der mehr Hadithe überliefert hat als ich, außer `Abdullah bin `Amr (bin Al-`As), der sie aufzuschreiben pflegte, und ich tat dasselbe nie.";
"discovery.card.sunnah_bukhari_113.source" = "Sahih al-Bukhari 113";

"discovery.card.sunnah_bukhari_120.title" = "Sahih al-Buchari 120";
"discovery.card.sunnah_bukhari_120.meaning" = "Überliefert von Abu Huraira: Ich habe zwei Arten von Wissen vom Gesandten Allahs (ﷺ) auswendig gelernt. Die eine habe ich unter euch verbreitet, und wenn ich die zweite verbreitete, würde mir der Rachen (die Kehle) durchgeschnitten (d. h. ich würde getötet).";
"discovery.card.sunnah_bukhari_120.source" = "Sahih al-Bukhari 120";

"discovery.card.sunnah_bukhari_121.title" = "Sahih al-Buchari 121";
"discovery.card.sunnah_bukhari_121.meaning" = "Überliefert von Jarir: Der Prophet (ﷺ) sagte zu mir während Hajjat-al-Wida`: Die Leute sollen still sein und zuhören. Dann sagte er (an die Leute gewandt): \"Werdet nach mir nicht (zu Ungläubigen) zum Unglauben zurückkehren, indem ihr einander die Hälse abschlagt (die Kehlen durchschneidet) (einander tötet).\"";
"discovery.card.sunnah_bukhari_121.source" = "Sahih al-Bukhari 121";

"discovery.card.sunnah_bukhari_127.title" = "Sahih al-Buchari 127";
"discovery.card.sunnah_bukhari_127.meaning" = "Überliefert von Abu at-Tufail: Die oben erwähnte Aussage von `Ali.";
"discovery.card.sunnah_bukhari_127.source" = "Sahih al-Bukhari 127";

"discovery.card.sunnah_bukhari_132.title" = "Sahih al-Buchari 132";
"discovery.card.sunnah_bukhari_132.meaning" = "Überliefert von `Ali: Ich hatte häufig unwillkürlichen urethralen Ausfluss, daher bat ich Al-Miqdad, den Propheten (ﷺ) danach zu fragen. Al-Miqdad fragte ihn, und er antwortete: \"Man muss (danach) die Waschung verrichten.\"";
"discovery.card.sunnah_bukhari_132.source" = "Sahih al-Bukhari 132";

"discovery.card.sunnah_bukhari_137.title" = "Sahih al-Buchari 137";
"discovery.card.sunnah_bukhari_137.meaning" = "Überliefert von `Abbad bin Tamim: Mein Onkel fragte den Gesandten Allahs (ﷺ) nach einer Person, die sich einbildete, während des Gebets Wind gelassen zu haben. Der Gesandte Allahs antwortete: \"Er soll sein Gebet nicht verlassen, es sei denn, er hört ein Geräusch oder riecht etwas.\"";
"discovery.card.sunnah_bukhari_137.source" = "Sahih al-Bukhari 137";

"discovery.card.sunnah_bukhari_142.title" = "Sahih al-Buchari 142";
"discovery.card.sunnah_bukhari_142.meaning" = "Überliefert von Anas: Wann immer der Prophet (ﷺ) seine Notdurft verrichten ging, pflegte er zu sagen: \"Allah-umma inni a`udhu bika minal khubuthi wal khaba'ith\", das heißt: \"O Allah, ich suche Zuflucht bei Dir vor allem Anstößigen und Schlechten (bösen Taten und bösen Geistern).\"";
"discovery.card.sunnah_bukhari_142.source" = "Sahih al-Bukhari 142";

"discovery.card.sunnah_bukhari_143.title" = "Sahih al-Buchari 143";
"discovery.card.sunnah_bukhari_143.meaning" = "Überliefert von Ibn `Abbas: Einmal betrat der Prophet (ﷺ) einen Abort, und ich stellte Wasser für seine Waschung bereit. Er fragte: \"Wer hat es hingestellt?\" Man unterrichtete ihn entsprechend, und so sagte er: \"O Allah! Mache ihn (Ibn `Abbas) zu einem gelehrten Kenner der Religion (des Islam).\"";
"discovery.card.sunnah_bukhari_143.source" = "Sahih al-Bukhari 143";

"discovery.card.sunnah_bukhari_144.title" = "Sahih al-Buchari 144";
"discovery.card.sunnah_bukhari_144.meaning" = "Überliefert von Abu Aiyub Al-Ansari: Der Gesandte Allahs (ﷺ) sagte: \"Wenn einer von euch an einen offenen Ort geht, um seine Notdurft zu verrichten, soll er sich weder zur Qibla wenden noch ihr den Rücken zukehren; er soll sich entweder nach Osten oder nach Westen wenden.\"";
"discovery.card.sunnah_bukhari_144.source" = "Sahih al-Bukhari 144";

"discovery.card.sunnah_bukhari_147.title" = "Sahih al-Buchari 147";
"discovery.card.sunnah_bukhari_147.meaning" = "Überliefert von `Aisha: Der Prophet (ﷺ) sagte zu seinen Frauen: \"Es ist euch erlaubt hinauszugehen, um eure Notdurft zu verrichten.\"";
"discovery.card.sunnah_bukhari_147.source" = "Sahih al-Bukhari 147";

"discovery.card.sunnah_bukhari_148.title" = "Sahih al-Buchari 148";
"discovery.card.sunnah_bukhari_148.meaning" = "Überliefert von `Abdullah bin `Umar: Ich stieg wegen einer Aufgabe auf das Dach von Hafsas Haus und sah den Gesandten Allahs (ﷺ) seine Notdurft verrichten, Sham zugewandt (Syrien, Jordanien, Palästina und Libanon als ein Land betrachtet), mit dem Rücken zur Qibla.";
"discovery.card.sunnah_bukhari_148.source" = "Sahih al-Bukhari 148";

"discovery.card.sunnah_bukhari_149.title" = "Sahih al-Buchari 149";
"discovery.card.sunnah_bukhari_149.meaning" = "Überliefert von `Abdullah bin `Umar: Einmal stieg ich auf das Dach unseres Hauses und sah den Gesandten Allahs (ﷺ) seine Notdurft verrichten, während er auf zwei Ziegelsteinen saß, Baitul-Maqdis (Jerusalem) zugewandt.";
"discovery.card.sunnah_bukhari_149.source" = "Sahih al-Bukhari 149";

"discovery.card.sunnah_bukhari_150.title" = "Sahih al-Buchari 150";
"discovery.card.sunnah_bukhari_150.meaning" = "Überliefert von Anas bin Malik: Wann immer der Gesandte Allahs (ﷺ) seine Notdurft verrichten ging, begleiteten ein anderer Junge und ich ihn mit einem Becher voll Wasser. (Hisham bemerkte: \"Damit er sich damit die Schamteile waschen konnte.\")";
"discovery.card.sunnah_bukhari_150.source" = "Sahih al-Bukhari 150";

"discovery.card.sunnah_bukhari_151.title" = "Sahih al-Buchari 151";
"discovery.card.sunnah_bukhari_151.meaning" = "Überliefert von Anas: Wann immer der Gesandte Allahs (ﷺ) seine Notdurft verrichten ging, gingen ein anderer Junge von uns und ich hinter ihm her mit einem Becher voll Wasser.";
"discovery.card.sunnah_bukhari_151.source" = "Sahih al-Bukhari 151";

"discovery.card.sunnah_bukhari_153.title" = "Sahih al-Buchari 153";
"discovery.card.sunnah_bukhari_153.meaning" = "Überliefert von Abu Qatada: Der Gesandte Allahs (ﷺ) sagte: \"Wann immer einer von euch Wasser trinkt, soll er nicht in das Trinkgefäß atmen, und wann immer einer von euch auf einen Abort geht, soll er weder seinen Penis berühren noch seine Schamteile mit der rechten Hand reinigen.\"";
"discovery.card.sunnah_bukhari_153.source" = "Sahih al-Bukhari 153";

"discovery.card.sunnah_bukhari_154.title" = "Sahih al-Buchari 154";
"discovery.card.sunnah_bukhari_154.meaning" = "Überliefert von Abu Qatada: Der Prophet (ﷺ) sagte: \"Wann immer einer von euch uriniert, soll er seinen Penis nicht halten noch seine Schamteile mit der rechten Hand reinigen. (Und beim Trinken) soll man nicht in das Trinkgefäß atmen.\"";
"discovery.card.sunnah_bukhari_154.source" = "Sahih al-Bukhari 154";

"discovery.card.sunnah_bukhari_157.title" = "Sahih al-Buchari 157";
"discovery.card.sunnah_bukhari_157.meaning" = "Überliefert von Ibn `Abbas: Der Prophet (ﷺ) verrichtete die Waschung, indem er die Körperteile nur einmal wusch.";
"discovery.card.sunnah_bukhari_157.source" = "Sahih al-Bukhari 157";

"discovery.card.sunnah_bukhari_158.title" = "Sahih al-Buchari 158";
"discovery.card.sunnah_bukhari_158.meaning" = "Überliefert von `Abdullah bin Zaid: Der Prophet (ﷺ) verrichtete die Waschung, indem er die Körperteile zweimal wusch.";
"discovery.card.sunnah_bukhari_158.source" = "Sahih al-Bukhari 158";

"discovery.card.sunnah_bukhari_161.title" = "Sahih al-Buchari 161";
"discovery.card.sunnah_bukhari_161.meaning" = "Überliefert von Abu Huraira: Der Prophet (ﷺ) sagte: \"Wer die Waschung verrichtet, soll seine Nase mit Wasser reinigen, indem er Wasser hineinbringt und es dann herausbläst, und wer seine Schamteile mit Steinen reinigt, soll es mit einer ungeraden Zahl von Steinen tun.\"";
"discovery.card.sunnah_bukhari_161.source" = "Sahih al-Bukhari 161";

"discovery.card.sunnah_bukhari_165.title" = "Sahih al-Buchari 165";
"discovery.card.sunnah_bukhari_165.meaning" = "Überliefert von Muhammad Ibn Ziyad: Ich hörte Abu Huraira sagen, als er an uns vorbeiging, während die Leute die Waschung aus einem Gefäß mit Wasser verrichteten: \"Verrichtet die Waschung vollkommen und gründlich, denn Abul-Qasim (der Prophet) sagte: 'Bewahrt eure Fersen vor dem Höllenfeuer.'\"";
"discovery.card.sunnah_bukhari_165.source" = "Sahih al-Bukhari 165";

"discovery.card.sunnah_bukhari_167.title" = "Sahih al-Buchari 167";
"discovery.card.sunnah_bukhari_167.meaning" = "Überliefert von Um-`Atiya: Dass der Prophet (ﷺ) ihnen zur Zeit der Waschung seiner verstorbenen Tochter gesagt hatte: \"Beginnt von der rechten Seite, angefangen mit den Teilen, die bei der Waschung gewaschen werden.\"";
"discovery.card.sunnah_bukhari_167.source" = "Sahih al-Bukhari 167";

"discovery.card.sunnah_bukhari_168.title" = "Sahih al-Buchari 168";
"discovery.card.sunnah_bukhari_168.meaning" = "Überliefert von `Aisha: Der Prophet (ﷺ) pflegte gerne von der rechten Seite anzufangen beim Anziehen der Schuhe, beim Kämmen seines Haares, beim Reinigen oder Waschen und bei allem anderen.";
"discovery.card.sunnah_bukhari_168.source" = "Sahih al-Bukhari 168";

"discovery.card.sunnah_bukhari_170.title" = "Sahih al-Buchari 170";
"discovery.card.sunnah_bukhari_170.meaning" = "Überliefert von Ibn Seereen: Ich sagte zu `Abida: \"Ich habe etwas Haar des Propheten (ﷺ), das ich von Anas oder von seiner Familie erhalten habe.\" `Abida antwortete: \"Zweifellos, wenn ich ein einziges Haar davon hätte, wäre es mir teurer gewesen als die ganze Welt und was darin ist.\"";
"discovery.card.sunnah_bukhari_170.source" = "Sahih al-Bukhari 170";

"discovery.card.sunnah_bukhari_171.title" = "Sahih al-Buchari 171";
"discovery.card.sunnah_bukhari_171.meaning" = "Überliefert von Anas: Als dem Gesandten Allahs (ﷺ) der Kopf rasiert wurde, war Abu Talha der Erste, der etwas von seinem Haar nahm.";
"discovery.card.sunnah_bukhari_171.source" = "Sahih al-Bukhari 171";

"discovery.card.sunnah_bukhari_172.title" = "Sahih al-Buchari 172";
"discovery.card.sunnah_bukhari_172.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) sagte: \"Wenn ein Hund aus dem Gefäß eines von euch trinkt, ist es unerlässlich, es siebenmal zu waschen.\"";
"discovery.card.sunnah_bukhari_172.source" = "Sahih al-Bukhari 172";

"discovery.card.sunnah_bukhari_174.title" = "Sahih al-Buchari 174";
"discovery.card.sunnah_bukhari_174.meaning" = "Und überliefert von Hamza bin 'Abdullah: Mein Vater sagte: \"Zu Lebzeiten des Gesandten Allahs pflegten die Hunde zu urinieren und durch die Moscheen zu laufen (zu kommen und zu gehen); dennoch pflegte man kein Wasser darauf zu sprengen (auf den Urin des Hundes).\"";
"discovery.card.sunnah_bukhari_174.source" = "Sahih al-Bukhari 174";

"discovery.card.sunnah_bukhari_177.title" = "Sahih al-Buchari 177";
"discovery.card.sunnah_bukhari_177.meaning" = "Überliefert von `Abbad bin Tamim: Mein Onkel sagte: Der Prophet (ﷺ) sagte: \"Man soll sein Gebet nicht verlassen, es sei denn, man hört ein Geräusch oder riecht etwas.\"";
"discovery.card.sunnah_bukhari_177.source" = "Sahih al-Bukhari 177";

"discovery.card.sunnah_bukhari_178.title" = "Sahih al-Buchari 178";
"discovery.card.sunnah_bukhari_178.meaning" = "Überliefert von `Ali: Ich hatte häufig unwillkürliche urethrale Absonderungen und scheute mich, den Gesandten Allahs (ﷺ) danach zu fragen. Deshalb bat ich Al-Miqdad bin Al-Aswad, (den Propheten (ﷺ) ) danach zu fragen. Al-Miqdad fragte ihn, und er antwortete: \"Man muss (danach) die Waschung verrichten.\"";
"discovery.card.sunnah_bukhari_178.source" = "Sahih al-Bukhari 178";

"discovery.card.sunnah_bukhari_188.title" = "Sahih al-Buchari 188";
"discovery.card.sunnah_bukhari_188.meaning" = "Abu Musa sagte: Der Prophet bat um einen Becher mit Wasser, wusch darin beide Hände und das Gesicht, spuckte dann einen Mundvoll Wasser in den Becher und sagte zu uns beiden (Abu Musa und Bilal): \"Trinkt aus dem Becher und gießt etwas von seinem Wasser auf eure Gesichter und Brust.\"";
"discovery.card.sunnah_bukhari_188.source" = "Sahih al-Bukhari 188";

"discovery.card.sunnah_bukhari_193.title" = "Sahih al-Buchari 193";
"discovery.card.sunnah_bukhari_193.meaning" = "Überliefert von 'Abdullah bin 'Umar: \"Zu Lebzeiten des Gesandten Allahs (ﷺ) verrichteten Männer und Frauen die Waschung gemeinsam.\"";
"discovery.card.sunnah_bukhari_193.source" = "Sahih al-Bukhari 193";

"discovery.card.sunnah_bukhari_196.title" = "Sahih al-Buchari 196";
"discovery.card.sunnah_bukhari_196.meaning" = "Überliefert von Abu Musa: Einmal bat der Prophet (ﷺ) um einen Becher mit Wasser. Er wusch darin seine Hände und sein Gesicht und spuckte auch einen Mundvoll Wasser hinein.";
"discovery.card.sunnah_bukhari_196.source" = "Sahih al-Bukhari 196";

"discovery.card.sunnah_bukhari_201.title" = "Sahih al-Buchari 201";
"discovery.card.sunnah_bukhari_201.meaning" = "Überliefert von Anas: Der Prophet (ﷺ) nahm ein rituelles Bad mit einem Sa` bis zu fünf Mudds (1 Sa` = [??] Mudds) Wasser und verrichtete die Waschung mit einem Mudd Wasser.";
"discovery.card.sunnah_bukhari_201.source" = "Sahih al-Bukhari 201";

"discovery.card.sunnah_bukhari_204.title" = "Sahih al-Buchari 204";
"discovery.card.sunnah_bukhari_204.meaning" = "Überliefert von Ja`far bin `Amr bin Umaiya Ad-Damri: Mein Vater sagte: \"Ich sah den Propheten (ﷺ) mit nassen Händen über seine Khuffs (Socken aus dickem Stoff oder Leder) streichen.\"";
"discovery.card.sunnah_bukhari_204.source" = "Sahih al-Bukhari 204";

"discovery.card.sunnah_bukhari_205.title" = "Sahih al-Buchari 205";
"discovery.card.sunnah_bukhari_205.meaning" = "Überliefert von Ja`far bin `Amr: Mein Vater sagte: \"Ich sah den Propheten (ﷺ) mit nassen Händen über seinen Turban und seine Khuffs (Socken aus dickem Stoff oder Leder) streichen.\"";
"discovery.card.sunnah_bukhari_205.source" = "Sahih al-Bukhari 205";

"discovery.card.sunnah_bukhari_207.title" = "Sahih al-Buchari 207";
"discovery.card.sunnah_bukhari_207.meaning" = "Überliefert von `Abdullah bin `Abbas: Der Gesandte Allahs (ﷺ) aß ein Stück gekochtes Schaffleisch aus der Schultergegend und betete, ohne die Waschung zu wiederholen.";
"discovery.card.sunnah_bukhari_207.source" = "Sahih al-Bukhari 207";

"discovery.card.sunnah_bukhari_208.title" = "Sahih al-Buchari 208";
"discovery.card.sunnah_bukhari_208.meaning" = "Überliefert von Ja`far bin `Amr bin Umaiya: Mein Vater sagte: \"Ich sah den Gesandten Allahs (ﷺ) ein Stück (gekochtes) Schaffleisch aus der Schultergegend nehmen, dann wurde er zum Gebet gerufen. Er legte sein Messer hin und betete, ohne die Waschung zu wiederholen.\"";
"discovery.card.sunnah_bukhari_208.source" = "Sahih al-Bukhari 208";

"discovery.card.sunnah_bukhari_210.title" = "Sahih al-Buchari 210";
"discovery.card.sunnah_bukhari_210.meaning" = "Überliefert von Maimuna: Der Prophet (ﷺ) aß (ein Stück) Schaffleisch aus der Schultergegend und betete dann, ohne die Waschung zu wiederholen.";
"discovery.card.sunnah_bukhari_210.source" = "Sahih al-Bukhari 210";

"discovery.card.sunnah_bukhari_211.title" = "Sahih al-Buchari 211";
"discovery.card.sunnah_bukhari_211.meaning" = "Überliefert von Ibn `Abbas: Der Gesandte Allahs (ﷺ) trank Milch, spülte seinen Mund und sagte: \"Es enthält Fett.\"";
"discovery.card.sunnah_bukhari_211.source" = "Sahih al-Bukhari 211";

"discovery.card.sunnah_bukhari_212.title" = "Sahih al-Buchari 212";
"discovery.card.sunnah_bukhari_212.meaning" = "Überliefert von `Aisha: Der Gesandte Allahs (ﷺ) sagte: \"Wenn einer von euch beim Gebet schläfrig wird, soll er sich schlafen legen, bis die Schläfrigkeit vorüber ist, denn wer schläfrig betet, weiß nicht, ob er um Vergebung bittet oder um etwas Schlechtes für sich selbst.\"";
"discovery.card.sunnah_bukhari_212.source" = "Sahih al-Bukhari 212";

"discovery.card.sunnah_bukhari_213.title" = "Sahih al-Buchari 213";
"discovery.card.sunnah_bukhari_213.meaning" = "Überliefert von Anas: Der Prophet (ﷺ) sagte: \"Wenn einer von euch beim Gebet schläfrig wird, soll er schlafen, bis er versteht, was er sagt (rezitiert).\"";
"discovery.card.sunnah_bukhari_213.source" = "Sahih al-Bukhari 213";

"discovery.card.sunnah_bukhari_214.title" = "Sahih al-Buchari 214";
"discovery.card.sunnah_bukhari_214.meaning" = "Überliefert von `Amr bin `Amir: Anas sagte: \"Der Prophet (ﷺ) verrichtete für jedes Gebet die Waschung.\" Ich fragte Anas: \"Was habt ihr gemacht?\" Anas antwortete: \"Wir beteten mit derselben Waschung, bis wir sie durch ein Hadath aufhoben.\"";
"discovery.card.sunnah_bukhari_214.source" = "Sahih al-Bukhari 214";

"discovery.card.sunnah_bukhari_217.title" = "Sahih al-Buchari 217";
"discovery.card.sunnah_bukhari_217.meaning" = "Überliefert von Anas bin Malik: Immer wenn der Prophet (ﷺ) seine Notdurft verrichten ging, brachte ich Wasser mit, mit dem er seine Schamteile reinigte.";
"discovery.card.sunnah_bukhari_217.source" = "Sahih al-Bukhari 217";

"discovery.card.sunnah_bukhari_219.title" = "Sahih al-Buchari 219";
"discovery.card.sunnah_bukhari_219.meaning" = "Überliefert von Anas bin Malik: Der Prophet (ﷺ) sah einen Beduinen in der Moschee urinieren und sagte den Leuten, sie sollten ihn nicht stören. Als er fertig war, bat der Prophet (ﷺ) um etwas Wasser und goss es darüber (über den Urin).";
"discovery.card.sunnah_bukhari_219.source" = "Sahih al-Bukhari 219";

"discovery.card.sunnah_bukhari_221.title" = "Sahih al-Buchari 221";
"discovery.card.sunnah_bukhari_221.meaning" = "Überliefert von Anas bin Malik: Der Prophet (ﷺ) sagte wie oben.";
"discovery.card.sunnah_bukhari_221.source" = "Sahih al-Bukhari 221";

"discovery.card.sunnah_bukhari_222.title" = "Sahih al-Buchari 222";
"discovery.card.sunnah_bukhari_222.meaning" = "Überliefert von `Aisha: (die Mutter der Gläubigen) Ein Kind wurde zum Gesandten Allahs (ﷺ) gebracht und urinierte auf das Gewand des Propheten. Der Prophet (ﷺ) bat um Wasser und goss es über die beschmutzte Stelle.";
"discovery.card.sunnah_bukhari_222.source" = "Sahih al-Bukhari 222";

"discovery.card.sunnah_bukhari_224.title" = "Sahih al-Buchari 224";
"discovery.card.sunnah_bukhari_224.meaning" = "Überliefert von Hudhaifa: Einmal ging der Prophet (ﷺ) zu den Abfallhaufen einiger Leute und urinierte im Stehen. Dann bat er um Wasser, ich brachte es ihm, und er verrichtete die Waschung.";
"discovery.card.sunnah_bukhari_224.source" = "Sahih al-Bukhari 224";

"discovery.card.sunnah_bukhari_225.title" = "Sahih al-Buchari 225";
"discovery.card.sunnah_bukhari_225.meaning" = "Überliefert von Hudhaifa': Der Prophet (ﷺ) und ich gingen, bis wir zu den Abfallhaufen einiger Leute kamen. Er blieb stehen, wie einer von euch steht, hinter einer Mauer und urinierte. Ich ging weg, aber er winkte mir, näher zu kommen. Also näherte ich mich ihm und blieb hinter seinem Rücken stehen, bis er fertig war.";
"discovery.card.sunnah_bukhari_225.source" = "Sahih al-Bukhari 225";

"discovery.card.sunnah_bukhari_229.title" = "Sahih al-Buchari 229";
"discovery.card.sunnah_bukhari_229.meaning" = "Überliefert von `Aisha: Ich wusch die Spuren von Janaba (Samen) von den Kleidern des Propheten (ﷺ), und er ging zum Gebet, während noch Wasserspuren darauf waren (Wasserflecken noch sichtbar waren).";
"discovery.card.sunnah_bukhari_229.source" = "Sahih al-Bukhari 229";

"discovery.card.sunnah_bukhari_230.title" = "Sahih al-Buchari 230";
"discovery.card.sunnah_bukhari_230.meaning" = "Überliefert von Sulaiman bin Yasar: Ich fragte `Aisha über Kleider, die mit Samen befleckt waren. Sie antwortete: \"Ich wusch es von den Kleidern des Gesandten Allahs (ﷺ), und er ging zum Gebet, während Wasserflecken noch sichtbar waren.\"";
"discovery.card.sunnah_bukhari_230.source" = "Sahih al-Bukhari 230";

"discovery.card.sunnah_bukhari_231.title" = "Sahih al-Buchari 231";
"discovery.card.sunnah_bukhari_231.meaning" = "Überliefert von `Amr bin Maimun: Ich hörte Sulaiman bin Yasar über Kleider sprechen, die mit Samen befleckt waren. Er sagte, `Aisha habe gesagt: \"Ich wusch es von den Kleidern des Gesandten Allahs (ﷺ), und er ging zu den Gebeten, während Wasserflecken noch darauf sichtbar waren.\"";
"discovery.card.sunnah_bukhari_231.source" = "Sahih al-Bukhari 231";

"discovery.card.sunnah_bukhari_232.title" = "Sahih al-Buchari 232";
"discovery.card.sunnah_bukhari_232.meaning" = "Überliefert von `Aishah: Ich wusch den Samen von den Kleidern des Propheten (ﷺ) und bemerkte trotzdem noch einen oder mehrere Flecken darauf.";
"discovery.card.sunnah_bukhari_232.source" = "Sahih al-Bukhari 232";

"discovery.card.sunnah_bukhari_234.title" = "Sahih al-Buchari 234";
"discovery.card.sunnah_bukhari_234.meaning" = "Überliefert von Anas: Vor dem Bau der Moschee betete der Prophet (ﷺ) in Schafpferchen.";
"discovery.card.sunnah_bukhari_234.source" = "Sahih al-Bukhari 234";

"discovery.card.sunnah_bukhari_235.title" = "Sahih al-Buchari 235";
"discovery.card.sunnah_bukhari_235.meaning" = "Überliefert von Maimuna: Der Gesandte Allahs (ﷺ) wurde nach Ghee (Kochbutter) gefragt, in das eine Maus gefallen war. Er sagte: \"Nehmt die Maus heraus, werft das Ghee ringsum weg und verwendet den Rest.\"";
"discovery.card.sunnah_bukhari_235.source" = "Sahih al-Bukhari 235";

"discovery.card.sunnah_bukhari_236.title" = "Sahih al-Buchari 236";
"discovery.card.sunnah_bukhari_236.meaning" = "Überliefert von Maimuna: Der Prophet (ﷺ) wurde nach Ghee gefragt, in das eine Maus gefallen war. Er sagte: \"Nehmt die Maus heraus und werft das Ghee ringsum weg (und verwendet den Rest).\"";
"discovery.card.sunnah_bukhari_236.source" = "Sahih al-Bukhari 236";

"discovery.card.sunnah_bukhari_237.title" = "Sahih al-Buchari 237";
"discovery.card.sunnah_bukhari_237.meaning" = "Überliefert von Abu Huraira: Der Prophet (ﷺ) sagte: \"Eine Wunde, die ein Muslim auf dem Weg Allahs empfängt, wird am Tag der Auferstehung so erscheinen, wie sie zum Zeitpunkt der Verletzung war; Blut wird aus der Wunde fließen, die Farbe wird die des Blutes sein, aber sie wird nach Moschus duften.\"";
"discovery.card.sunnah_bukhari_237.source" = "Sahih al-Bukhari 237";

"discovery.card.sunnah_bukhari_238.title" = "Sahih al-Buchari 238";
"discovery.card.sunnah_bukhari_238.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) sagte: \"Wir (Muslime) sind die Letzten (die in die Welt kommen), aber (werden) die Vordersten (sein am Tag der Auferstehung).\"";
"discovery.card.sunnah_bukhari_238.source" = "Sahih al-Bukhari 238";

"discovery.card.sunnah_bukhari_239.title" = "Sahih al-Buchari 239";
"discovery.card.sunnah_bukhari_239.meaning" = "Derselbe Überlieferer sagte, dass der Prophet (ﷺ) gesagt hatte: \"Ihr sollt nicht in stehendes Wasser urinieren, das nicht fließt, um euch dann (möglicherweise) darin zu waschen.\"";
"discovery.card.sunnah_bukhari_239.source" = "Sahih al-Bukhari 239";

"discovery.card.sunnah_bukhari_241.title" = "Sahih al-Buchari 241";
"discovery.card.sunnah_bukhari_241.meaning" = "Überliefert von Anas: Der Prophet (ﷺ) spuckte einmal in seine Kleider.";
"discovery.card.sunnah_bukhari_241.source" = "Sahih al-Bukhari 241";

"discovery.card.sunnah_bukhari_242.title" = "Sahih al-Buchari 242";
"discovery.card.sunnah_bukhari_242.meaning" = "Überliefert von Aisha: Der Prophet (ﷺ) sagte: \"Alle Getränke, die berauschen, sind haram (zu trinken verboten).\"";
"discovery.card.sunnah_bukhari_242.source" = "Sahih al-Bukhari 242";

"discovery.card.sunnah_bukhari_250.title" = "Sahih al-Buchari 250";
"discovery.card.sunnah_bukhari_250.meaning" = "Überliefert von `Aisha: Der Prophet (ﷺ) und ich nahmen ein rituelles Bad aus einem einzigen Gefäß namens Faraq.";
"discovery.card.sunnah_bukhari_250.source" = "Sahih al-Bukhari 250";

"discovery.card.sunnah_bukhari_251.title" = "Sahih al-Buchari 251";
"discovery.card.sunnah_bukhari_251.meaning" = "Überliefert von Abu Salama: Der Bruder von `Aisha und ich gingen zu `Aisha, und er fragte sie nach dem Bad des Propheten. Sie brachte ein Gefäß mit etwa einem Sa` Wasser, nahm ein Bad und goss es über ihren Kopf, und zu jener Zeit war ein Vorhang zwischen ihr und uns.";
"discovery.card.sunnah_bukhari_251.source" = "Sahih al-Bukhari 251";

"discovery.card.sunnah_bukhari_253.title" = "Sahih al-Buchari 253";
"discovery.card.sunnah_bukhari_253.meaning" = "Überliefert von Ibn `Abbas: Der Prophet (ﷺ) und Maimuna nahmen ein rituelles Bad aus einem einzigen Gefäß.";
"discovery.card.sunnah_bukhari_253.source" = "Sahih al-Bukhari 253";

"discovery.card.sunnah_bukhari_254.title" = "Sahih al-Buchari 254";
"discovery.card.sunnah_bukhari_254.meaning" = "Überliefert von Jubair bin Mut`im: Der Gesandte Allahs (ﷺ) sagte: \"Was mich betrifft, so gieße ich dreimal Wasser über meinen Kopf.\" Und er deutete mit beiden Händen.";
"discovery.card.sunnah_bukhari_254.source" = "Sahih al-Bukhari 254";

"discovery.card.sunnah_bukhari_255.title" = "Sahih al-Buchari 255";
"discovery.card.sunnah_bukhari_255.meaning" = "Überliefert von Jabir bin `Abdullah: Der Prophet (ﷺ) goss dreimal Wasser über seinen Kopf.";
"discovery.card.sunnah_bukhari_255.source" = "Sahih al-Bukhari 255";

"discovery.card.sunnah_bukhari_261.title" = "Sahih al-Buchari 261";
"discovery.card.sunnah_bukhari_261.meaning" = "Überliefert von Aisha: Der Prophet (ﷺ) und ich nahmen ein rituelles Bad aus einem einzigen Gefäß Wasser, und unsere Hände gingen abwechselnd nacheinander in das Gefäß.";
"discovery.card.sunnah_bukhari_261.source" = "Sahih al-Bukhari 261";

"discovery.card.sunnah_bukhari_262.title" = "Sahih al-Buchari 262";
"discovery.card.sunnah_bukhari_262.meaning" = "Überliefert von `Aisha: Immer wenn der Gesandte Allahs (ﷺ) ein Bad der Janaba nahm, wusch er zuerst seine Hände.";
"discovery.card.sunnah_bukhari_262.source" = "Sahih al-Bukhari 262";

"discovery.card.sunnah_bukhari_263.title" = "Sahih al-Buchari 263";
"discovery.card.sunnah_bukhari_263.meaning" = "Überliefert von `Aisha: Der Prophet (ﷺ) und ich nahmen ein rituelles Bad aus einem einzigen Gefäß Wasser nach der Janaba.";
"discovery.card.sunnah_bukhari_263.source" = "Sahih al-Bukhari 263";

"discovery.card.sunnah_bukhari_264.title" = "Sahih al-Buchari 264";
"discovery.card.sunnah_bukhari_264.meaning" = "Überliefert von Anas bin Malik: Der Prophet (ﷺ) und eine seiner Frauen nahmen ein rituelles Bad aus einem einzigen Gefäß Wasser. (Shu`ba fügte der Aussage von Anas hinzu: \"Nach der Janaba.\")";
"discovery.card.sunnah_bukhari_264.source" = "Sahih al-Bukhari 264";

"discovery.card.sunnah_bukhari_269.title" = "Sahih al-Buchari 269";
"discovery.card.sunnah_bukhari_269.meaning" = "Überliefert von `Ali: Ich hatte häufig unwillkürliche urethrale Absonderung. Als Schwiegersohn des Propheten (ﷺ) bat ich einen Mann, ihn danach zu fragen. Der Mann fragte den Propheten (ﷺ) danach. Der Prophet (ﷺ) antwortete: \"Verrichte die Waschung, nachdem du dein Organ (den Penis) gewaschen hast.\"";
"discovery.card.sunnah_bukhari_269.source" = "Sahih al-Bukhari 269";

"discovery.card.sunnah_bukhari_271.title" = "Sahih al-Buchari 271";
"discovery.card.sunnah_bukhari_271.meaning" = "Überliefert von `Aisha: Es ist, als sähe ich noch den Glanz des Dufts im Scheitel des Prophetenhaares, während er Muhrim war.";
"discovery.card.sunnah_bukhari_271.source" = "Sahih al-Bukhari 271";

"discovery.card.sunnah_bukhari_277.title" = "Sahih al-Buchari 277";
"discovery.card.sunnah_bukhari_277.meaning" = "Überliefert von Aisha: Immer wenn eine von uns Junub war, goss sie dreimal Wasser mit beiden Händen über ihren Kopf und rieb dann die rechte Seite ihres Kopfes mit einer Hand und die linke Seite des Kopfes mit der anderen Hand.";
"discovery.card.sunnah_bukhari_277.source" = "Sahih al-Bukhari 277";

"discovery.card.sunnah_bukhari_280.title" = "Sahih al-Buchari 280";
"discovery.card.sunnah_bukhari_280.meaning" = "Überliefert von Um Hani bint Abi Talib: Ich ging im Jahr der Eroberung Mekkas zum Gesandten Allahs (ﷺ) und fand ihn beim Baden, während Fatima ihn abschirmte. Der Prophet (ﷺ) fragte: \"Wer ist da?\" Ich antwortete: \"Ich bin Um-Hani.\"";
"discovery.card.sunnah_bukhari_280.source" = "Sahih al-Bukhari 280";

"discovery.card.sunnah_bukhari_284.title" = "Sahih al-Buchari 284";
"discovery.card.sunnah_bukhari_284.meaning" = "Überliefert von Anas bin Malik: Der Prophet (ﷺ) besuchte all seine Frauen in einer Nacht, und er hatte damals neun Frauen.";
"discovery.card.sunnah_bukhari_284.source" = "Sahih al-Bukhari 284";

"discovery.card.sunnah_bukhari_286.title" = "Sahih al-Buchari 286";
"discovery.card.sunnah_bukhari_286.meaning" = "Überliefert von Abu Salama: Ich fragte `Aisha: \"Pflegte der Prophet (ﷺ) zu schlafen, während er Junub war?\" Sie antwortete: \"Ja, aber er verrichtete die Waschung (bevor er zu Bett ging).\"";
"discovery.card.sunnah_bukhari_286.source" = "Sahih al-Bukhari 286";

"discovery.card.sunnah_bukhari_287.title" = "Sahih al-Buchari 287";
"discovery.card.sunnah_bukhari_287.meaning" = "Überliefert von `Umar bin Al-Khattab: Ich fragte den Gesandten Allahs (ﷺ): \"Kann einer von uns schlafen, während er Junub ist?\" Er antwortete: \"Ja, wenn er die Waschung verrichtet, kann er schlafen, während er Junub ist.\"";
"discovery.card.sunnah_bukhari_287.source" = "Sahih al-Bukhari 287";

"discovery.card.sunnah_bukhari_288.title" = "Sahih al-Buchari 288";
"discovery.card.sunnah_bukhari_288.meaning" = "Überliefert von `Aisha: Immer wenn der Prophet (ﷺ) schlafen wollte, während er Junub war, wusch er seine Schamteile und verrichtete die Waschung wie für das Gebet.";
"discovery.card.sunnah_bukhari_288.source" = "Sahih al-Bukhari 288";

"discovery.card.sunnah_bukhari_289.title" = "Sahih al-Buchari 289";
"discovery.card.sunnah_bukhari_289.meaning" = "Überliefert von `Abdullah: `Umar fragte den Propheten (ﷺ): \"Kann einer von uns schlafen, während er Junub ist?\" Er antwortete: \"Ja, wenn er die Waschung verrichtet.\"";
"discovery.card.sunnah_bukhari_289.source" = "Sahih al-Bukhari 289";

"discovery.card.sunnah_bukhari_290.title" = "Sahih al-Buchari 290";
"discovery.card.sunnah_bukhari_290.meaning" = "Überliefert von `Abdullah bin `Umar: `Umar bin Al-Khattab sagte dem Gesandten Allahs (ﷺ): \"Ich wurde nachts Junub.\" Der Gesandte Allahs (ﷺ) antwortete: \"Verrichte die Waschung, nachdem du deine Schamteile gewaschen hast, und schlafe dann.\"";
"discovery.card.sunnah_bukhari_290.source" = "Sahih al-Bukhari 290";

"discovery.card.sunnah_bukhari_291.title" = "Sahih al-Buchari 291";
"discovery.card.sunnah_bukhari_291.meaning" = "Überliefert von Hisham: wie der folgende Hadith 290. Überliefert von Abu Huraira: Der Prophet (ﷺ) sagte: \"Wenn ein Mann zwischen den vier Gliedern einer Frau sitzt und den Beischlaf mit ihr vollzieht, wird das Bad verpflichtend.\"";
"discovery.card.sunnah_bukhari_291.source" = "Sahih al-Bukhari 291";

"discovery.card.sunnah_bukhari_295.title" = "Sahih al-Buchari 295";
"discovery.card.sunnah_bukhari_295.meaning" = "Überliefert von `Aisha: Während der Menstruation kämmte ich das Haar des Gesandten Allahs (ﷺ).";
"discovery.card.sunnah_bukhari_295.source" = "Sahih al-Bukhari 295";

"discovery.card.sunnah_bukhari_297.title" = "Sahih al-Buchari 297";
"discovery.card.sunnah_bukhari_297.meaning" = "Überliefert von `Aisha: Der Prophet (ﷺ) lehnte sich an meinen Schoß und rezitierte den Koran, während ich die Menstruation hatte.";
"discovery.card.sunnah_bukhari_297.source" = "Sahih al-Bukhari 297";

"discovery.card.sunnah_bukhari_298.title" = "Sahih al-Buchari 298";
"discovery.card.sunnah_bukhari_298.meaning" = "Überliefert von Um Salama: Während ich mit dem Propheten (ﷺ) unter einer einzigen wollenen Decke lag, bekam ich die Menstruation. Ich schlüpfte weg und zog die Kleider für die Menstruation an. Er sagte: \"Hast du 'Nifas' (Menstruation) bekommen?\" Ich antwortete: \"Ja.\" Dann rief er mich und ließ mich mit ihm unter derselben Decke liegen.";
"discovery.card.sunnah_bukhari_298.source" = "Sahih al-Bukhari 298";

"discovery.card.sunnah_bukhari_303.title" = "Sahih al-Buchari 303";
"discovery.card.sunnah_bukhari_303.meaning" = "Überliefert von Maimuna: Wann immer der Gesandte Allahs (ﷺ) eine seiner Frauen während der Menstruation streicheln wollte, bat er sie, einen Izar zu tragen.";
"discovery.card.sunnah_bukhari_303.source" = "Sahih al-Bukhari 303";

"discovery.card.sunnah_bukhari_310.title" = "Sahih al-Buchari 310";
"discovery.card.sunnah_bukhari_310.meaning" = "Überliefert von `Aisha: Eine der Frauen des Gesandten Allahs (ﷺ) schloss sich ihm im I`tikaf an und bemerkte Blut und gelblichen Ausfluss (aus ihrem Schambereich) und stellte eine Schale unter sich, wenn sie betete.";
"discovery.card.sunnah_bukhari_310.source" = "Sahih al-Bukhari 310";

"discovery.card.sunnah_bukhari_311.title" = "Sahih al-Buchari 311";
"discovery.card.sunnah_bukhari_311.meaning" = "Überliefert von `Aisha: Eine der Mütter der Gläubigen (das heißt der Frauen des Propheten (ﷺ)) verrichtete I`tikaf, während sie zwischen zwei Menstruationen Blutungen hatte.";
"discovery.card.sunnah_bukhari_311.source" = "Sahih al-Bukhari 311";

"discovery.card.sunnah_bukhari_312.title" = "Sahih al-Buchari 312";
"discovery.card.sunnah_bukhari_312.meaning" = "Überliefert von `Aisha: Keine von uns hatte mehr als ein einziges Gewand, und wir trugen es während der Menstruation. Wenn es mit Menstruationsblut befleckt war, trugen wir Speichel auf die Blutstelle auf und rieben das Blut mit den Nägeln ab.";
"discovery.card.sunnah_bukhari_312.source" = "Sahih al-Bukhari 312";

"discovery.card.sunnah_bukhari_323.title" = "Sahih al-Buchari 323";
"discovery.card.sunnah_bukhari_323.meaning" = "Überliefert von Um Salama: Während ich mit dem Propheten (ﷺ) unter einer wollenen Decke lag, bekam ich meine Menstruation. Ich schlüpfte weg und zog die Kleidung für die Menstruation an. Der Prophet (ﷺ) sagte: \"Hast du deine Menstruation bekommen?\" Ich antwortete: \"Ja.\" Er rief mich, und ich schlief bei ihm unter der wollenen Decke.";
"discovery.card.sunnah_bukhari_323.source" = "Sahih al-Bukhari 323";

"discovery.card.sunnah_bukhari_326.title" = "Sahih al-Buchari 326";
"discovery.card.sunnah_bukhari_326.meaning" = "Überliefert von Um `Atiya: Wir betrachteten gelblichen Ausfluss nie als etwas Wichtiges (als Menstruation).";
"discovery.card.sunnah_bukhari_326.source" = "Sahih al-Bukhari 326";

"discovery.card.sunnah_bukhari_328.title" = "Sahih al-Buchari 328";
"discovery.card.sunnah_bukhari_328.meaning" = "Überliefert von `Aisha: (der Frau des Propheten) Ich sagte dem Gesandten Allahs (ﷺ), dass Safiya bint Huyai ihre Menstruation bekommen hatte. Er sagte: \"Sie wird uns wahrscheinlich aufhalten. Hat sie den Tawaf (Al-Ifada) mit euch verrichtet?\" Wir antworteten: \"Ja.\" Daraufhin sagte der Prophet (ﷺ) ihr, sie solle aufbrechen.";
"discovery.card.sunnah_bukhari_328.source" = "Sahih al-Bukhari 328";

"discovery.card.sunnah_bukhari_331.title" = "Sahih al-Buchari 331";
"discovery.card.sunnah_bukhari_331.meaning" = "Überliefert von `Aisha: Der Prophet (ﷺ) sagte zu mir: \"Lass das Gebet, wenn deine Menstruation beginnt, und wenn sie vorüber ist, wasche das Blut von deinem Körper (nimm ein Bad) und beginne wieder zu beten.\"";
"discovery.card.sunnah_bukhari_331.source" = "Sahih al-Bukhari 331";

"discovery.card.sunnah_bukhari_332.title" = "Sahih al-Buchari 332";
"discovery.card.sunnah_bukhari_332.meaning" = "Überliefert von Samura bin Jundub: Der Prophet (ﷺ) verrichtete das Totengebet für den Leichnam einer Frau, die während der Entbindung starb, und er stand in der Mitte ihres Körpers.";
"discovery.card.sunnah_bukhari_332.source" = "Sahih al-Bukhari 332";

"discovery.card.sunnah_bukhari_333.title" = "Sahih al-Buchari 333";
"discovery.card.sunnah_bukhari_333.meaning" = "Überliefert von Maimuna: (der Frau des Propheten) Während meiner Menstruation betete ich nie, saß aber auf der Matte neben der Moschee des Gesandten Allahs (ﷺ). Er verrichtete das Gebet auf seinem Tuch, und beim Niederwerfen berührten mich einige seiner Kleider.";
"discovery.card.sunnah_bukhari_333.source" = "Sahih al-Bukhari 333";

"discovery.card.sunnah_bukhari_340.title" = "Sahih al-Buchari 340";
"discovery.card.sunnah_bukhari_340.meaning" = "Überliefert von `Abdur Rahman bin Abza: dass, während er in Gesellschaft von `Umar war, `Ammar zu `Umar sagte: \"Wir waren in einer Abteilung und wurden Junub, und ich blies den Staub von meinen Händen (ich wälzte mich auf der Erde und betete).\"";
"discovery.card.sunnah_bukhari_340.source" = "Sahih al-Bukhari 340";

"discovery.card.sunnah_bukhari_341.title" = "Sahih al-Buchari 341";
"discovery.card.sunnah_bukhari_341.meaning" = "Überliefert von `Abdur Rahman bin Abza: `Ammar sagte zu `Umar: \"Ich wälzte mich im Staub und kam zum Propheten (ﷺ), der sagte: 'Das Überstreichen von Gesicht und Handrücken mit den bestaubten Händen genügt dir.'\"";
"discovery.card.sunnah_bukhari_341.source" = "Sahih al-Bukhari 341";

"discovery.card.sunnah_bukhari_343.title" = "Sahih al-Buchari 343";
"discovery.card.sunnah_bukhari_343.meaning" = "Überliefert von `Ammar: Der Prophet (ﷺ) klopfte mit den Händen auf die Erde und führte sie dann über sein Gesicht und den Rücken seiner Hände (während er den Tayammum vormachte).";
"discovery.card.sunnah_bukhari_343.source" = "Sahih al-Bukhari 343";

"discovery.card.sunnah_bukhari_353.title" = "Sahih al-Buchari 353";
"discovery.card.sunnah_bukhari_353.meaning" = "Überliefert von Muhammad bin Al Munkadir: Ich sah Jabir bin `Abdullah in einem einzigen Gewand beten, und er sagte, er habe den Propheten (ﷺ) in einem einzigen Gewand beten gesehen.";
"discovery.card.sunnah_bukhari_353.source" = "Sahih al-Bukhari 353";

"discovery.card.sunnah_bukhari_354.title" = "Sahih al-Buchari 354";
"discovery.card.sunnah_bukhari_354.meaning" = "Überliefert von `Umar bin Abi Salama: Der Prophet (ﷺ) betete in einem Gewand und kreuzte dessen Enden.";
"discovery.card.sunnah_bukhari_354.source" = "Sahih al-Bukhari 354";

"discovery.card.sunnah_bukhari_355.title" = "Sahih al-Buchari 355";
"discovery.card.sunnah_bukhari_355.meaning" = "Überliefert von `Umar bin Abi Salama: Ich sah den Propheten (ﷺ) im Haus von Um-Salama in einem einzigen Gewand beten, und er hatte dessen Enden über die Schultern gekreuzt.";
"discovery.card.sunnah_bukhari_355.source" = "Sahih al-Bukhari 355";

"discovery.card.sunnah_bukhari_356.title" = "Sahih al-Buchari 356";
"discovery.card.sunnah_bukhari_356.meaning" = "Überliefert von `Umar bin Abi Salama: Im Haus von Um-Salama sah ich den Gesandten Allahs (ﷺ) beten, in ein einziges Gewand um den Körper gehüllt, dessen Enden über die Schultern gekreuzt waren.";
"discovery.card.sunnah_bukhari_356.source" = "Sahih al-Bukhari 356";

"discovery.card.sunnah_bukhari_358.title" = "Sahih al-Buchari 358";
"discovery.card.sunnah_bukhari_358.meaning" = "Überliefert von Abu Huraira: Jemand fragte den Gesandten Allahs (ﷺ) nach dem Verrichten des Gebets in einem einzigen Gewand. Der Gesandte Allahs (ﷺ) antwortete: \"Hat denn jeder von euch zwei Gewänder?\"";
"discovery.card.sunnah_bukhari_358.source" = "Sahih al-Bukhari 358";

"discovery.card.sunnah_bukhari_359.title" = "Sahih al-Buchari 359";
"discovery.card.sunnah_bukhari_359.meaning" = "Überliefert von Abu Huraira: Der Prophet (ﷺ) sagte: \"Keiner von euch soll in einem einzigen Gewand beten, das die Schultern nicht bedeckt.\"";
"discovery.card.sunnah_bukhari_359.source" = "Sahih al-Bukhari 359";

"discovery.card.sunnah_bukhari_360.title" = "Sahih al-Buchari 360";
"discovery.card.sunnah_bukhari_360.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) sagte: \"Wer in einem einzigen Gewand betet, muss dessen Enden kreuzen (über die Schultern).\"";
"discovery.card.sunnah_bukhari_360.source" = "Sahih al-Bukhari 360";

"discovery.card.sunnah_bukhari_362.title" = "Sahih al-Buchari 362";
"discovery.card.sunnah_bukhari_362.meaning" = "Überliefert von Sahl: Die Männer beteten mit dem Propheten (ﷺ) mit um den Hals gebundenen Izars, wie es die Knaben taten; deshalb sagte der Prophet (ﷺ) den Frauen, sie sollten die Köpfe nicht heben, bis die Männer sich aufrecht gesetzt hatten (während des Gebets).";
"discovery.card.sunnah_bukhari_362.source" = "Sahih al-Bukhari 362";

"discovery.card.sunnah_bukhari_372.title" = "Sahih al-Buchari 372";
"discovery.card.sunnah_bukhari_372.meaning" = "Überliefert von `Aisha: Der Gesandte Allahs (ﷺ) verrichtete das Fajr-Gebet, und einige gläubige Frauen, bedeckt mit ihren Schleiertüchern, nahmen mit ihm am Fajr-Gebet teil und kehrten danach unerkannt in ihre Häuser zurück.";
"discovery.card.sunnah_bukhari_372.source" = "Sahih al-Bukhari 372";

"discovery.card.sunnah_bukhari_375.title" = "Sahih al-Buchari 375";
"discovery.card.sunnah_bukhari_375.meaning" = "Überliefert von `Uqba bin 'Amir: Dem Propheten (ﷺ) wurde ein seidener Farruj als Geschenk gegeben. Er trug ihn beim Gebet. Als er sein Gebet beendet hatte, zog er ihn heftig aus, als habe er eine starke Abneigung dagegen, und sagte: \"Das ist nicht die Kleidung frommer, gottesfürchtiger Menschen.\"";
"discovery.card.sunnah_bukhari_375.source" = "Sahih al-Bukhari 375";

"discovery.card.sunnah_bukhari_381.title" = "Sahih al-Buchari 381";
"discovery.card.sunnah_bukhari_381.meaning" = "Überliefert von Maimuna: Der Gesandte Allahs (ﷺ) pflegte auf einer Khumra zu beten.";
"discovery.card.sunnah_bukhari_381.source" = "Sahih al-Bukhari 381";

"discovery.card.sunnah_bukhari_383.title" = "Sahih al-Buchari 383";
"discovery.card.sunnah_bukhari_383.meaning" = "Überliefert von `Aisha: Der Gesandte Allahs betete, während ich wie ein toter Körper auf dem Familienbett zwischen ihm und seiner Qibla lag.";
"discovery.card.sunnah_bukhari_383.source" = "Sahih al-Bukhari 383";

"discovery.card.sunnah_bukhari_384.title" = "Sahih al-Buchari 384";
"discovery.card.sunnah_bukhari_384.meaning" = "Überliefert von `Urwa: Der Prophet (ﷺ) betete, während `Aisha zwischen ihm und seiner Qibla auf dem Bett lag, auf dem sie zu schlafen pflegten.";
"discovery.card.sunnah_bukhari_384.source" = "Sahih al-Bukhari 384";

"discovery.card.sunnah_bukhari_385.title" = "Sahih al-Buchari 385";
"discovery.card.sunnah_bukhari_385.meaning" = "Überliefert von Anas bin Malik: Wir pflegten mit dem Propheten (ﷺ) zu beten, und einige von uns legten die Enden ihrer Kleider an den Ort der Niederwerfung wegen der sengenden Hitze.";
"discovery.card.sunnah_bukhari_385.source" = "Sahih al-Bukhari 385";

"discovery.card.sunnah_bukhari_386.title" = "Sahih al-Buchari 386";
"discovery.card.sunnah_bukhari_386.meaning" = "Überliefert von Abu Maslama: Sa`id bin Yazid Al-Azdi: Ich fragte Anas bin Malik, ob der Prophet (ﷺ) jemals mit seinen Schuhen gebetet habe. Er antwortete: \"Ja.\"";
"discovery.card.sunnah_bukhari_386.source" = "Sahih al-Bukhari 386";

"discovery.card.sunnah_bukhari_388.title" = "Sahih al-Buchari 388";
"discovery.card.sunnah_bukhari_388.meaning" = "Überliefert von Al-Mughira bin Shu'ba: Ich half dem Propheten (ﷺ) bei der Verrichtung der Waschung, und er strich mit den nassen Händen über seine Khuffs und betete.";
"discovery.card.sunnah_bukhari_388.source" = "Sahih al-Bukhari 388";

"discovery.card.sunnah_bukhari_390.title" = "Sahih al-Buchari 390";
"discovery.card.sunnah_bukhari_390.meaning" = "Überliefert von 'Abdullah bin Malik: Ibn Buhaina, \"Wenn der Prophet (ﷺ) betete, spreizte er die Arme so weit vom Körper, dass das Weiß seiner Achselhöhlen sichtbar war.\"";
"discovery.card.sunnah_bukhari_390.source" = "Sahih al-Bukhari 390";

"discovery.card.sunnah_bukhari_391.title" = "Sahih al-Buchari 391";
"discovery.card.sunnah_bukhari_391.meaning" = "Überliefert von Anas bin Malik: Der Gesandte Allahs (ﷺ) sagte: \"Wer betet wie wir, sich unserer Qibla zuwendet und von unseren geschlachteten Tieren isst, ist ein Muslim und steht unter dem Schutz Allahs und Seines Gesandten. Verratet also Allah nicht, indem ihr diejenigen verratet, die unter Seinem Schutz stehen.\"";
"discovery.card.sunnah_bukhari_391.source" = "Sahih al-Bukhari 391";

"discovery.card.sunnah_bukhari_398.title" = "Sahih al-Buchari 398";
"discovery.card.sunnah_bukhari_398.meaning" = "Überliefert von Ibn `Abbas: Als der Prophet (ﷺ) die Ka`ba betrat, rief er Allah an jeder ihrer Seiten an und betete nicht, bis er hinausgegangen war; dann verrichtete er ein Gebet von zwei Rak`at in Richtung der Ka`ba und sagte: \"Dies ist die Qibla.\"";
"discovery.card.sunnah_bukhari_398.source" = "Sahih al-Bukhari 398";

"discovery.card.sunnah_bukhari_400.title" = "Sahih al-Buchari 400";
"discovery.card.sunnah_bukhari_400.meaning" = "Überliefert von Jabir: Der Gesandte Allahs (ﷺ) pflegte (freiwillige, nicht verpflichtende Gebete) zu beten, während er auf seinem Reittier (Rahila) saß, wohin es sich auch wandte, und wenn er das Pflichtgebet verrichten wollte, stieg er ab und betete in Richtung der Qibla.";
"discovery.card.sunnah_bukhari_400.source" = "Sahih al-Bukhari 400";

"discovery.card.sunnah_bukhari_404.title" = "Sahih al-Buchari 404";
"discovery.card.sunnah_bukhari_404.meaning" = "Überliefert von `Abdullah: Einmal verrichtete der Prophet (ﷺ) fünf Rak`at im Zuhr-Gebet. Er wurde gefragt: \"Gibt es eine Vermehrung im Gebet?\" Der Prophet (ﷺ) sagte: \"Und was ist das?\" Sie sagten: \"Du hast fünf Rak`at gebetet.\" Da beugte er die Beine und verrichtete zwei Niederwerfungen (des Sahu).";
"discovery.card.sunnah_bukhari_404.source" = "Sahih al-Bukhari 404";

"discovery.card.sunnah_bukhari_407.title" = "Sahih al-Buchari 407";
"discovery.card.sunnah_bukhari_407.meaning" = "Überliefert von `Aisha: (der Mutter der Gläubigen) Der Gesandte Allahs (ﷺ) sah Nasenabsonderungen, Auswurf oder Schleim an der Moscheewand in Richtung der Qibla und schabte ihn ab.";
"discovery.card.sunnah_bukhari_407.source" = "Sahih al-Bukhari 407";

"discovery.card.sunnah_bukhari_412.title" = "Sahih al-Buchari 412";
"discovery.card.sunnah_bukhari_412.meaning" = "Überliefert von Anas: Der Prophet (ﷺ) sagte: \"Keiner von euch soll nach vorn oder nach rechts spucken, aber er darf nach links oder unter seinen Fuß spucken.\"";
"discovery.card.sunnah_bukhari_412.source" = "Sahih al-Bukhari 412";

"discovery.card.sunnah_bukhari_413.title" = "Sahih al-Buchari 413";
"discovery.card.sunnah_bukhari_413.meaning" = "Überliefert von Anas bin Malik: Der Prophet (ﷺ) sagte: \"Ein Gläubiger spricht im Gebet im Geheimen mit seinem Herrn, daher soll er weder vor sich noch nach rechts spucken, aber er darf nach links oder unter seinen Fuß spucken.\"";
"discovery.card.sunnah_bukhari_413.source" = "Sahih al-Bukhari 413";

"discovery.card.sunnah_bukhari_414.title" = "Sahih al-Buchari 414";
"discovery.card.sunnah_bukhari_414.meaning" = "Überliefert von Abu Sa`id: Der Prophet (ﷺ) sah Schleim an (der Wand) der Moschee in Richtung der Qibla und schabte ihn mit Kies ab. Dann verbot er das Spucken nach vorn oder nach rechts, erlaubte es aber nach links oder unter den linken Fuß.";
"discovery.card.sunnah_bukhari_414.source" = "Sahih al-Bukhari 414";

"discovery.card.sunnah_bukhari_415.title" = "Sahih al-Buchari 415";
"discovery.card.sunnah_bukhari_415.meaning" = "Überliefert von Anas bin Malik: Der Prophet (ﷺ) sagte: \"Spucken in der Moschee ist eine Sünde, und die Sühne dafür ist, es zu vergraben.\"";
"discovery.card.sunnah_bukhari_415.source" = "Sahih al-Bukhari 415";

"discovery.card.sunnah_bukhari_418.title" = "Sahih al-Buchari 418";
"discovery.card.sunnah_bukhari_418.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) sagte: \"Meint ihr oder seht ihr, dass mein Gesicht zur Qibla gewandt ist? Bei Allah, weder eure Demut noch euer Verbeugen ist mir verborgen; wahrlich, ich sehe euch von meinem Rücken aus.\"";
"discovery.card.sunnah_bukhari_418.source" = "Sahih al-Bukhari 418";

"discovery.card.sunnah_bukhari_419.title" = "Sahih al-Buchari 419";
"discovery.card.sunnah_bukhari_419.meaning" = "Überliefert von Anas bin Malik: Der Prophet (ﷺ) führte uns im Gebet an, stieg dann auf die Kanzel und sagte: \"In eurem Gebet und eurem Verbeugen sehe ich euch gewiss von meinem Rücken aus, wie ich euch sehe (wenn ich euch anblicke).\"";
"discovery.card.sunnah_bukhari_419.source" = "Sahih al-Bukhari 419";

"discovery.card.sunnah_bukhari_422.title" = "Sahih al-Buchari 422";
"discovery.card.sunnah_bukhari_422.meaning" = "Überliefert von Anas: Ich fand den Propheten (ﷺ) in der Moschee zusammen mit einigen Leuten. Er sagte zu mir: \"Hat Abu Talha dich geschickt?\" Ich sagte: \"Ja.\" Er sagte: \"Zu einer Mahlzeit?\" Ich sagte: \"Ja.\" Dann sagte er zu seinen Gefährten: \"Steht auf.\" Sie brachen auf, und ich war ihnen voraus.";
"discovery.card.sunnah_bukhari_422.source" = "Sahih al-Bukhari 422";

"discovery.card.sunnah_bukhari_424.title" = "Sahih al-Buchari 424";
"discovery.card.sunnah_bukhari_424.meaning" = "Überliefert von `Itban bin Malik: Der Prophet (ﷺ) kam in mein Haus und sagte: \"Wo möchtest du, dass ich bete?\" Ich zeigte auf einen Platz. Der Prophet sagte dann: \"Allahu Akbar\", und wir stellten uns hinter ihm auf, und er verrichtete ein Gebet von zwei Rak`at.";
"discovery.card.sunnah_bukhari_424.source" = "Sahih al-Bukhari 424";

"discovery.card.sunnah_bukhari_426.title" = "Sahih al-Buchari 426";
"discovery.card.sunnah_bukhari_426.meaning" = "Überliefert von `Aisha: Der Prophet (ﷺ) pflegte alles von rechts zu beginnen (bei guten Dingen), wann immer es in all seinen Angelegenheiten möglich war; zum Beispiel: beim Waschen, Kämmen oder Anziehen der Schuhe.";
"discovery.card.sunnah_bukhari_426.source" = "Sahih al-Bukhari 426";

"discovery.card.sunnah_bukhari_429.title" = "Sahih al-Buchari 429";
"discovery.card.sunnah_bukhari_429.meaning" = "Überliefert von Abu Al-Taiyah: Anas sagte: \"Der Prophet (ﷺ) betete im Schafpferch.\" Später hörte ich ihn sagen: \"Er betete in den Schafpferchen vor dem Bau der Moschee.\"";
"discovery.card.sunnah_bukhari_429.source" = "Sahih al-Bukhari 429";

"discovery.card.sunnah_bukhari_430.title" = "Sahih al-Buchari 430";
"discovery.card.sunnah_bukhari_430.meaning" = "Überliefert von Nafi`: Ich sah Ibn `Umar beten, wobei er sein Kamel als Sutra vor sich nahm, und er sagte: \"Ich sah den Propheten dasselbe tun.\"";
"discovery.card.sunnah_bukhari_430.source" = "Sahih al-Bukhari 430";

"discovery.card.sunnah_bukhari_431.title" = "Sahih al-Buchari 431";
"discovery.card.sunnah_bukhari_431.meaning" = "Überliefert von `Abdullah bin `Abbas: Die Sonne verdunkelte sich, und der Gesandte Allahs (ﷺ) verrichtete das Finsternisgebet und sagte: \"Mir ist das Höllenfeuer (jetzt) gezeigt worden, und ich habe nie einen schlimmeren und entsetzlicheren Anblick gesehen als den, den ich heute gesehen habe.\"";
"discovery.card.sunnah_bukhari_431.source" = "Sahih al-Bukhari 431";

"discovery.card.sunnah_bukhari_432.title" = "Sahih al-Buchari 432";
"discovery.card.sunnah_bukhari_432.meaning" = "Überliefert von Ibn `Umar: Der Prophet (ﷺ) hatte gesagt: \"Verrichtet einen Teil eurer Gebete (Nawafil) zu Hause, und macht eure Häuser nicht zu Gräbern.\"";
"discovery.card.sunnah_bukhari_432.source" = "Sahih al-Bukhari 432";

"discovery.card.sunnah_bukhari_437.title" = "Sahih al-Buchari 437";
"discovery.card.sunnah_bukhari_437.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) sagte: \"Möge Allahs Fluch auf den Juden liegen, denn sie errichteten die Gebetsstätten an den Gräbern ihrer Propheten.\"";
"discovery.card.sunnah_bukhari_437.source" = "Sahih al-Bukhari 437";

"discovery.card.sunnah_bukhari_440.title" = "Sahih al-Buchari 440";
"discovery.card.sunnah_bukhari_440.meaning" = "Überliefert von Nafi`: `Abdullah bin `Umar sagte: Ich pflegte in der Moschee des Propheten (ﷺ) zu schlafen, als ich jung und unverheiratet war.";
"discovery.card.sunnah_bukhari_440.source" = "Sahih al-Bukhari 440";

"discovery.card.sunnah_bukhari_443.title" = "Sahih al-Buchari 443";
"discovery.card.sunnah_bukhari_443.meaning" = "Überliefert von Jabir bin `Abdullah: Ich ging zum Propheten (ﷺ) in die Moschee (der weitere Überlieferer Mis`ar meinte, Jabir habe gesagt: \"Am Vormittag.\") Er befahl mir, zwei Rak`at zu beten. Er schuldete mir etwas Geld, zahlte es mir zurück und gab mehr, als mir zustand.";
"discovery.card.sunnah_bukhari_443.source" = "Sahih al-Bukhari 443";

"discovery.card.sunnah_bukhari_444.title" = "Sahih al-Buchari 444";
"discovery.card.sunnah_bukhari_444.meaning" = "Überliefert von Abu Qatada Al-Aslami: Der Gesandte Allahs (ﷺ) sagte: \"Wenn einer von euch eine Moschee betritt, soll er zwei Rak`at beten, bevor er sich setzt.\"";
"discovery.card.sunnah_bukhari_444.source" = "Sahih al-Bukhari 444";

"discovery.card.sunnah_bukhari_445.title" = "Sahih al-Buchari 445";
"discovery.card.sunnah_bukhari_445.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) sagte: \"Die Engel bitten weiterhin für jeden von euch Allah um Vergebung, solange er an seinem Musalla (Gebetsplatz) ist und keinen Wind abgehen lässt (Hadath). Sie sagen: 'O Allah! Vergib ihm, o Allah! Sei ihm barmherzig.'\"";
"discovery.card.sunnah_bukhari_445.source" = "Sahih al-Bukhari 445";

"discovery.card.sunnah_bukhari_448.title" = "Sahih al-Buchari 448";
"discovery.card.sunnah_bukhari_448.meaning" = "Überliefert von Sahl: Der Gesandte Allahs (ﷺ) schickte jemanden zu einer Frau und ließ ihr sagen: \"Befiehl ihrem Sklaven, einem Zimmermann, eine hölzerne Kanzel für ihn anzufertigen, damit er sich darauf setzen kann.\"";
"discovery.card.sunnah_bukhari_448.source" = "Sahih al-Bukhari 448";

"discovery.card.sunnah_bukhari_449.title" = "Sahih al-Buchari 449";
"discovery.card.sunnah_bukhari_449.meaning" = "Überliefert von Jabir: Eine Frau sagte: \"O Gesandter Allahs (ﷺ)! Soll ich etwas für dich anfertigen lassen, worauf du sitzen kannst, da ich einen Sklaven habe, der Zimmermann ist?\" Er antwortete: \"Ja, wenn du möchtest.\" So ließ sie jene Kanzel anfertigen.";
"discovery.card.sunnah_bukhari_449.source" = "Sahih al-Bukhari 449";

"discovery.card.sunnah_bukhari_451.title" = "Sahih al-Buchari 451";
"discovery.card.sunnah_bukhari_451.meaning" = "Überliefert von `Amr: Ich hörte Jabir bin `Abdullah sagen: \"Ein Mann ging mit Pfeilen durch die Moschee. Der Gesandte Allahs ﷺ sagte zu ihm: 'Halte sie an den Spitzen fest.'\"";
"discovery.card.sunnah_bukhari_451.source" = "Sahih al-Bukhari 451";

"discovery.card.sunnah_bukhari_452.title" = "Sahih al-Buchari 452";
"discovery.card.sunnah_bukhari_452.meaning" = "Überliefert von Abu Burda bin `Abdullah: (auf Autorität seines Vaters) Der Prophet (ﷺ) sagte: \"Wer mit Pfeilen durch unsere Moscheen oder Märkte geht, soll sie an den Spitzen halten, damit er keinen Muslim verletzt.\"";
"discovery.card.sunnah_bukhari_452.source" = "Sahih al-Bukhari 452";

"discovery.card.sunnah_bukhari_453.title" = "Sahih al-Buchari 453";
"discovery.card.sunnah_bukhari_453.meaning" = "Überliefert von Hassan bin Thabit Al-Ansari: Ich fragte Abu Huraira: \"Bei Allah! Sag mir die Wahrheit, ob du den Propheten (ﷺ) sagen hörtest: 'O Hassan! Antworte im Namen des Gesandten Allahs (ﷺ). O Allah! Hilf ihm mit dem Heiligen Geist.'\" Abu Huraira sagte: \"Ja.\"";
"discovery.card.sunnah_bukhari_453.source" = "Sahih al-Bukhari 453";

"discovery.card.sunnah_bukhari_459.title" = "Sahih al-Buchari 459";
"discovery.card.sunnah_bukhari_459.meaning" = "Überliefert von `Aisha: Als die Verse der Sure \"Al-Baqara\" über den Wucher (Riba) offenbart wurden, ging der Prophet (ﷺ) in die Moschee, trug sie vor den Leuten vor und verbot dann den Handel mit Alkohol.";
"discovery.card.sunnah_bukhari_459.source" = "Sahih al-Bukhari 459";

"discovery.card.sunnah_bukhari_460.title" = "Sahih al-Buchari 460";
"discovery.card.sunnah_bukhari_460.meaning" = "Überliefert von Abu Rafi: Abu Huraira sagte: \"Ein Mann oder eine Frau pflegte die Moschee zu reinigen.\" (Ein Unternarrator sagte: 'Höchstwahrscheinlich eine Frau.') Dann überlieferte er den Hadith des Propheten.";
"discovery.card.sunnah_bukhari_460.source" = "Sahih al-Bukhari 460";

"discovery.card.sunnah_bukhari_464.title" = "Sahih al-Buchari 464";
"discovery.card.sunnah_bukhari_464.meaning" = "Überliefert von Um Salama: Ich klagte dem Gesandten Allahs (ﷺ), dass ich krank sei. Er sagte mir, ich solle den Tawaf hinter den Leuten reitend vollziehen. Das tat ich, und der Gesandte Allahs (ﷺ) betete neben der Ka`ba und trug die Sure vor, die mit \"Wat-tur wa kitabin mastur\" beginnt.";
"discovery.card.sunnah_bukhari_464.source" = "Sahih al-Bukhari 464";

"discovery.card.sunnah_bukhari_469.title" = "Sahih al-Buchari 469";
"discovery.card.sunnah_bukhari_469.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) schickte Reiter nach Najd, und sie brachten einen Mann namens Thumama bin Uthal von Bani Hanifa. Sie banden ihn an einem der Pfeiler der Moschee fest.";
"discovery.card.sunnah_bukhari_469.source" = "Sahih al-Bukhari 469";

"discovery.card.sunnah_bukhari_475.title" = "Sahih al-Buchari 475";
"discovery.card.sunnah_bukhari_475.meaning" = "Überliefert von `Abbad bin Tamim: dass sein Onkel sagte: \"Ich sah den Gesandten Allahs (ﷺ) flach auf dem Rücken in der Moschee liegen, ein Bein über das andere gelegt.\" Überliefert von Sa`id bin Al-Musaiyab, dass `Umar und `Uthman dasselbe zu tun pflegten.";
"discovery.card.sunnah_bukhari_475.source" = "Sahih al-Bukhari 475";

"discovery.card.sunnah_bukhari_478.title" = "Sahih al-Buchari 478";
"discovery.card.sunnah_bukhari_478.meaning" = "Überliefert von Ibn `Umar oder Ibn `Amr: Der Prophet (ﷺ) faltete seine Hände, indem er die Finger ineinander verschränkte.";
"discovery.card.sunnah_bukhari_478.source" = "Sahih al-Bukhari 478";

"discovery.card.sunnah_bukhari_480.title" = "Sahih al-Buchari 480";
"discovery.card.sunnah_bukhari_480.meaning" = "Überliefert von `Abdullah: Dass der Gesandte Allahs (ﷺ) sagte: \"O `Abdullah bin `Amr! Wie wird dein Zustand sein, wenn du mit dem Bodensatz (den schlechtesten) der Menschen zurückgelassen wirst?\" (Sie werden miteinander im Streit liegen.)";
"discovery.card.sunnah_bukhari_480.source" = "Sahih al-Bukhari 480";

"discovery.card.sunnah_bukhari_481.title" = "Sahih al-Buchari 481";
"discovery.card.sunnah_bukhari_481.meaning" = "Überliefert von Abu Musa: Der Prophet (ﷺ) sagte: \"Ein Gläubiger ist für einen Gläubigen wie die Ziegel einer Mauer, die einander verstärken.\" Während er das sagte, faltete der Prophet (ﷺ) seine Hände, indem er die Finger ineinander verschränkte.";
"discovery.card.sunnah_bukhari_481.source" = "Sahih al-Bukhari 481";

"discovery.card.sunnah_bukhari_484.title" = "Sahih al-Buchari 484";
"discovery.card.sunnah_bukhari_484.meaning" = "Der überlieferte Hadith handelt von den verschiedenen Orten auf dem Weg von Medina nach Mekka, an denen der Prophet (ﷺ) betete, und ist nicht übersetzt.";
"discovery.card.sunnah_bukhari_484.source" = "Sahih al-Bukhari 484";

"discovery.card.sunnah_bukhari_496.title" = "Sahih al-Buchari 496";
"discovery.card.sunnah_bukhari_496.meaning" = "Überliefert von Sahl (bin Sa`d): Der Abstand zwischen dem Musalla des Gesandten Allahs (ﷺ) und der Mauer reichte gerade aus, damit ein Schaf hindurchgehen konnte.";
"discovery.card.sunnah_bukhari_496.source" = "Sahih al-Bukhari 496";

"discovery.card.sunnah_bukhari_497.title" = "Sahih al-Buchari 497";
"discovery.card.sunnah_bukhari_497.meaning" = "Überliefert von Salama: Der Abstand zwischen der Mauer der Moschee und der Kanzel reichte kaum aus, damit ein Schaf hindurchgehen konnte.";
"discovery.card.sunnah_bukhari_497.source" = "Sahih al-Bukhari 497";

"discovery.card.sunnah_bukhari_498.title" = "Sahih al-Buchari 498";
"discovery.card.sunnah_bukhari_498.meaning" = "Überliefert von `Abdullah: Der Prophet (ﷺ) ließ eine Harba vor sich aufstellen (als Sutra) und betete dahinter.";
"discovery.card.sunnah_bukhari_498.source" = "Sahih al-Bukhari 498";

"discovery.card.sunnah_bukhari_503.title" = "Sahih al-Buchari 503";
"discovery.card.sunnah_bukhari_503.meaning" = "Überliefert von Anas: Ich sah die bekanntesten unter den Gefährten des Propheten (ﷺ) beim Maghrib-Gebet zu den Pfeilern eilen, bevor der Prophet (ﷺ) zum Gebet kam.";
"discovery.card.sunnah_bukhari_503.source" = "Sahih al-Bukhari 503";

"discovery.card.sunnah_bukhari_512.title" = "Sahih al-Buchari 512";
"discovery.card.sunnah_bukhari_512.meaning" = "Überliefert von `Aisha: Der Prophet (ﷺ) pflegte zu beten, während ich quer in seinem Bett vor ihm schlief. Wenn er das Witr beten wollte, weckte er mich, und ich betete das Witr.";
"discovery.card.sunnah_bukhari_512.source" = "Sahih al-Bukhari 512";

"discovery.card.sunnah_bukhari_515.title" = "Sahih al-Buchari 515";
"discovery.card.sunnah_bukhari_515.meaning" = "Überliefert von `Aisha: (der Frau des Propheten) Der Gesandte Allahs (ﷺ) pflegte nachts aufzustehen und zu beten, während ich quer zwischen ihm und der Qibla auf dem Bett seiner Familie lag.";
"discovery.card.sunnah_bukhari_515.source" = "Sahih al-Bukhari 515";

"discovery.card.sunnah_bukhari_517.title" = "Sahih al-Buchari 517";
"discovery.card.sunnah_bukhari_517.meaning" = "Überliefert von Maimuna bint Al-Harith: Mein Bett stand neben dem Gebetsplatz (Musalla) des Propheten (ﷺ), und manchmal fiel sein Gewand auf mich, während ich in meinem Bett lag.";
"discovery.card.sunnah_bukhari_517.source" = "Sahih al-Bukhari 517";

"discovery.card.sunnah_bukhari_518.title" = "Sahih al-Buchari 518";
"discovery.card.sunnah_bukhari_518.meaning" = "Überliefert von Maimuna: Der Prophet (ﷺ) pflegte zu beten, während ich während meiner Menstruation neben ihm schlief, und in der Niederwerfung berührte mich sein Gewand.";
"discovery.card.sunnah_bukhari_518.source" = "Sahih al-Bukhari 518";

"discovery.card.sunnah_bukhari_519.title" = "Sahih al-Buchari 519";
"discovery.card.sunnah_bukhari_519.meaning" = "Überliefert von `Aisha: Es ist nicht gut, dass ihr uns (Frauen) Hunden und Eseln gleichgestellt habt. Zweifellos sah ich den Gesandten Allahs (ﷺ) beten, während ich zwischen ihm und der Qibla lag, und wenn er sich niederwerfen wollte, stieß er meine Beine, und ich zog sie zurück.";
"discovery.card.sunnah_bukhari_519.source" = "Sahih al-Bukhari 519";

"discovery.card.sunnah_bukhari_524.title" = "Sahih al-Buchari 524";
"discovery.card.sunnah_bukhari_524.meaning" = "Überliefert von Jarir bin `Abdullah: Ich leistete dem Gesandten Allahs (ﷺ) den Treueeid, die Gebete vollkommen zu verrichten, die Zakat regelmäßig zu entrichten und jedem Muslim guten Rat zu geben.";
"discovery.card.sunnah_bukhari_524.source" = "Sahih al-Bukhari 524";

"discovery.card.sunnah_bukhari_529.title" = "Sahih al-Buchari 529";
"discovery.card.sunnah_bukhari_529.meaning" = "Überliefert von Ghailan: Anas sagte: \"Ich finde (heutzutage) die Dinge nicht mehr so, wie sie zur Zeit des Propheten waren.\" Jemand sagte: \"Das Gebet (ist wie früher).\" Anas sagte: \"Habt ihr im Gebet nicht getan, was ihr getan habt?\"";
"discovery.card.sunnah_bukhari_529.source" = "Sahih al-Bukhari 529";

"discovery.card.sunnah_bukhari_532.title" = "Sahih al-Buchari 532";
"discovery.card.sunnah_bukhari_532.meaning" = "Überliefert von Anas: Der Prophet (ﷺ) sagte: \"Verrichtet die Niederwerfung richtig und legt eure Unterarme nicht flach hin, sodass die Ellbogen den Boden berühren wie ein Hund. Und wenn ihr spucken wollt, spuckt weder nach vorn noch nach rechts, denn wer im Gebet ist, spricht im Geheimen mit seinem Herrn.\"";
"discovery.card.sunnah_bukhari_532.source" = "Sahih al-Bukhari 532";

"discovery.card.sunnah_bukhari_533.title" = "Sahih al-Buchari 533";
"discovery.card.sunnah_bukhari_533.meaning" = "Überliefert von Abu Huraira und `Abdullah bin `Umar: Der Gesandte Allahs (ﷺ) sagte: \"Wenn es sehr heiß ist, dann verrichtet das Zuhr-Gebet, wenn es (etwas) kühler wird, denn die Heftigkeit der Hitze kommt vom Lodern des Höllenfeuers.\"";
"discovery.card.sunnah_bukhari_533.source" = "Sahih al-Bukhari 533";

"discovery.card.sunnah_bukhari_538.title" = "Sahih al-Buchari 538";
"discovery.card.sunnah_bukhari_538.meaning" = "Überliefert von Abu Sa`id: dass der Gesandte Allahs (ﷺ) sagte: \"Verrichtet das Zuhr-Gebet, wenn es (etwas) kühler wird, denn die Heftigkeit der Hitze kommt vom Lodern des Höllenfeuers.\"";
"discovery.card.sunnah_bukhari_538.source" = "Sahih al-Bukhari 538";

"discovery.card.sunnah_bukhari_542.title" = "Sahih al-Buchari 542";
"discovery.card.sunnah_bukhari_542.meaning" = "Überliefert von Anas bin Malik: Wenn wir das Zuhr-Gebet hinter dem Gesandten Allahs (ﷺ) verrichteten, pflegten wir uns auf unsere Kleider niederzuwerfen, um uns vor der Hitze zu schützen.";
"discovery.card.sunnah_bukhari_542.source" = "Sahih al-Bukhari 542";

"discovery.card.sunnah_bukhari_543.title" = "Sahih al-Buchari 543";
"discovery.card.sunnah_bukhari_543.meaning" = "Überliefert von Ibn `Abbas: \"Der Prophet (ﷺ) betete acht Rak`at für Zuhr und `Asr und sieben für Maghrib und `Isha in Medina.\" Aiyub sagte: \"Vielleicht waren das regnerische Nächte.\" Anas sagte: \"Vielleicht.\"";
"discovery.card.sunnah_bukhari_543.source" = "Sahih al-Bukhari 543";

"discovery.card.sunnah_bukhari_544.title" = "Sahih al-Buchari 544";
"discovery.card.sunnah_bukhari_544.meaning" = "Überliefert von Aisha: Der Gesandte Allahs (ﷺ) pflegte das `Asr-Gebet zu verrichten, wenn der Sonnenschein noch nicht aus meiner Kammer verschwunden war.";
"discovery.card.sunnah_bukhari_544.source" = "Sahih al-Bukhari 544";

"discovery.card.sunnah_bukhari_545.title" = "Sahih al-Buchari 545";
"discovery.card.sunnah_bukhari_545.meaning" = "Überliefert von `Aisha: Der Gesandte Allahs (ﷺ) pflegte das `Asr-Gebet zu einer Zeit zu verrichten, als der Sonnenschein noch in meiner Kammer war und noch kein Schatten darin erschienen war.";
"discovery.card.sunnah_bukhari_545.source" = "Sahih al-Bukhari 545";

"discovery.card.sunnah_bukhari_546.title" = "Sahih al-Buchari 546";
"discovery.card.sunnah_bukhari_546.meaning" = "Überliefert von Aisha: Der Prophet (ﷺ) pflegte das `Asr-Gebet zu einer Zeit zu verrichten, als der Sonnenschein noch in meiner Kammer war und noch kein Schatten darin erschienen war.";
"discovery.card.sunnah_bukhari_546.source" = "Sahih al-Bukhari 546";

"discovery.card.sunnah_bukhari_548.title" = "Sahih al-Buchari 548";
"discovery.card.sunnah_bukhari_548.meaning" = "Überliefert von Anas bin Malik: Wir pflegten das `Asr-Gebet zu verrichten, und danach, wenn jemand zum Stamm der Bani `Amr bin `Auf ging, fand er sie noch beim `Asr-Gebet.";
"discovery.card.sunnah_bukhari_548.source" = "Sahih al-Bukhari 548";

"discovery.card.sunnah_bukhari_551.title" = "Sahih al-Buchari 551";
"discovery.card.sunnah_bukhari_551.meaning" = "Überliefert von Anas bin Malik: Wir pflegten das `Asr zu beten, und danach, wenn einer von uns nach Quba' ging, kam er dort an, während die Sonne noch hoch stand.";
"discovery.card.sunnah_bukhari_551.source" = "Sahih al-Bukhari 551";

"discovery.card.sunnah_bukhari_552.title" = "Sahih al-Buchari 552";
"discovery.card.sunnah_bukhari_552.meaning" = "Überliefert von Ibn `Umar: Der Gesandte Allahs (ﷺ) sagte: \"Wer das `Asr-Gebet (absichtlich) versäumt, dem ist, als hätte er seine Familie und seinen Besitz verloren.\"";
"discovery.card.sunnah_bukhari_552.source" = "Sahih al-Bukhari 552";

"discovery.card.sunnah_bukhari_553.title" = "Sahih al-Buchari 553";
"discovery.card.sunnah_bukhari_553.meaning" = "Überliefert von Abu Al-Malih: Wir waren mit Buraida in einer Schlacht an einem bewölkten Tag, und er sagte: \"Verrichtet das `Asr-Gebet früh, denn der Prophet sagte: 'Wer das `Asr-Gebet unterlässt, dessen (gute) Taten werden alle zunichtegemacht.'\"";
"discovery.card.sunnah_bukhari_553.source" = "Sahih al-Bukhari 553";

"discovery.card.sunnah_bukhari_556.title" = "Sahih al-Buchari 556";
"discovery.card.sunnah_bukhari_556.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) sagte: \"Wenn einer von euch vor Sonnenuntergang eine Rak`a des `Asr-Gebets erreichen kann, soll er sein Gebet vollenden. Wenn einer von euch vor Sonnenaufgang eine Rak`a des Fajr-Gebets erreichen kann, soll er sein Gebet vollenden.\"";
"discovery.card.sunnah_bukhari_556.source" = "Sahih al-Bukhari 556";

"discovery.card.sunnah_bukhari_559.title" = "Sahih al-Buchari 559";
"discovery.card.sunnah_bukhari_559.meaning" = "Überliefert von Rafi` bin Khadij: Wir pflegten das Maghrib-Gebet mit dem Propheten (ﷺ) zu verrichten, und nach dem Gebet konnte einer von uns weggehen und noch so weit sehen wie die Stellen, die ein mit dem Bogen abgeschossener Pfeil erreichen kann.";
"discovery.card.sunnah_bukhari_559.source" = "Sahih al-Bukhari 559";

"discovery.card.sunnah_bukhari_561.title" = "Sahih al-Buchari 561";
"discovery.card.sunnah_bukhari_561.meaning" = "Überliefert von Salama: Wir pflegten das Maghrib-Gebet mit dem Propheten (ﷺ) zu verrichten, wenn die Sonne vom Horizont verschwunden war.";
"discovery.card.sunnah_bukhari_561.source" = "Sahih al-Bukhari 561";

"discovery.card.sunnah_bukhari_562.title" = "Sahih al-Buchari 562";
"discovery.card.sunnah_bukhari_562.meaning" = "Überliefert von Ibn `Abbas: Der Prophet (ﷺ) betete sieben Rak`at zusammen und acht Rak`at zusammen.";
"discovery.card.sunnah_bukhari_562.source" = "Sahih al-Bukhari 562";

"discovery.card.sunnah_bukhari_563.title" = "Sahih al-Buchari 563";
"discovery.card.sunnah_bukhari_563.meaning" = "Überliefert von `Abdullah Al-Muzani: Der Prophet (ﷺ) sagte: \"Lasst euch von den Beduinen nicht beeinflussen, was den Namen eures Maghrib-Gebets angeht, das sie `Isha' nennen.\"";
"discovery.card.sunnah_bukhari_563.source" = "Sahih al-Bukhari 563";

"discovery.card.sunnah_bukhari_568.title" = "Sahih al-Buchari 568";
"discovery.card.sunnah_bukhari_568.meaning" = "Überliefert von Abu Barza: Der Gesandte Allahs (ﷺ) mochte es nicht, vor dem `Isha'-Gebet zu schlafen und danach zu sprechen.";
"discovery.card.sunnah_bukhari_568.source" = "Sahih al-Bukhari 568";

"discovery.card.sunnah_bukhari_574.title" = "Sahih al-Buchari 574";
"discovery.card.sunnah_bukhari_574.meaning" = "Überliefert von Abu Bakr bin Abi Musa: Mein Vater sagte: \"Der Gesandte Allahs (ﷺ) sagte: 'Wer die beiden kühlen Gebete (`Asr und Fajr) verrichtet, wird ins Paradies eingehen.'\"";
"discovery.card.sunnah_bukhari_574.source" = "Sahih al-Bukhari 574";

"discovery.card.sunnah_bukhari_577.title" = "Sahih al-Buchari 577";
"discovery.card.sunnah_bukhari_577.meaning" = "Überliefert von Sahl bin Sa`d: Ich pflegte die \"Suhur\"-Mahlzeit mit meiner Familie einzunehmen und mich zu beeilen, um das Fajr-Gebet (Morgengebet) mit dem Gesandten Allahs (ﷺ) zu erreichen.";
"discovery.card.sunnah_bukhari_577.source" = "Sahih al-Bukhari 577";

"discovery.card.sunnah_bukhari_578.title" = "Sahih al-Buchari 578";
"discovery.card.sunnah_bukhari_578.meaning" = "Überliefert von `Aisha: Die gläubigen Frauen, bedeckt mit ihren Schleiertüchern, pflegten das Fajr-Gebet mit dem Gesandten Allahs ﷺ zu besuchen, und nach dem Gebet kehrten sie nach Hause zurück, und niemand konnte sie wegen der Dunkelheit erkennen.";
"discovery.card.sunnah_bukhari_578.source" = "Sahih al-Bukhari 578";

"discovery.card.sunnah_bukhari_579.title" = "Sahih al-Buchari 579";
"discovery.card.sunnah_bukhari_579.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) sagte: \"Wer vor Sonnenaufgang eine Rak`a (des Fajr-Gebets) erreichen kann, der hat das (Morgen-)Gebet erreicht, und wer vor Sonnenuntergang eine Rak`a des `Asr-Gebets erreichen kann, der hat das (`Asr-)Gebet erreicht.\"";
"discovery.card.sunnah_bukhari_579.source" = "Sahih al-Bukhari 579";

"discovery.card.sunnah_bukhari_580.title" = "Sahih al-Buchari 580";
"discovery.card.sunnah_bukhari_580.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) sagte: \"Wer eine Rak`a eines Gebets erreichen kann (zu ihrer richtigen Zeit), der hat das Gebet erreicht.\"";
"discovery.card.sunnah_bukhari_580.source" = "Sahih al-Bukhari 580";

"discovery.card.sunnah_bukhari_581.title" = "Sahih al-Buchari 581";
"discovery.card.sunnah_bukhari_581.meaning" = "Überliefert von `Umar: \"Der Prophet (ﷺ) verbot, nach dem Fajr-Gebet zu beten, bis die Sonne aufgeht, und nach dem `Asr-Gebet, bis die Sonne untergeht.\" Überliefert von Ibn `Abbas: Einige Leute berichteten mir dieselbe Überlieferung (wie oben).";
"discovery.card.sunnah_bukhari_581.source" = "Sahih al-Bukhari 581";

"discovery.card.sunnah_bukhari_585.title" = "Sahih al-Buchari 585";
"discovery.card.sunnah_bukhari_585.meaning" = "Überliefert von Ibn `Umar: Der Gesandte Allahs (ﷺ) sagte: \"Keiner von euch soll versuchen, bei Sonnenaufgang oder Sonnenuntergang zu beten.\"";
"discovery.card.sunnah_bukhari_585.source" = "Sahih al-Bukhari 585";

"discovery.card.sunnah_bukhari_586.title" = "Sahih al-Buchari 586";
"discovery.card.sunnah_bukhari_586.meaning" = "Überliefert von Abu Sa`id Al-Khudri: Ich hörte den Gesandten Allahs (ﷺ) sagen: \"Es gibt kein Gebet nach dem Morgengebet, bis die Sonne aufgeht, und es gibt kein Gebet nach dem `Asr-Gebet, bis die Sonne untergeht.\"";
"discovery.card.sunnah_bukhari_586.source" = "Sahih al-Bukhari 586";

"discovery.card.sunnah_bukhari_587.title" = "Sahih al-Buchari 587";
"discovery.card.sunnah_bukhari_587.meaning" = "Überliefert von Muawiya: Ihr verrichtet ein Gebet, das ich den Gesandten Allahs (ﷺ) nicht verrichten sah, als wir in seiner Gesellschaft waren, und er hatte es gewiss verboten (nämlich zwei Rak`at nach dem `Asr-Gebet).";
"discovery.card.sunnah_bukhari_587.source" = "Sahih al-Bukhari 587";

"discovery.card.sunnah_bukhari_588.title" = "Sahih al-Buchari 588";
"discovery.card.sunnah_bukhari_588.meaning" = "Überliefert von Abu Huraira: Der Gesandte Allahs (ﷺ) verbot das Verrichten zweier Gebete: -1. nach dem Morgengebet, bis die Sonne aufgeht. -2. nach dem `Asr-Gebet, bis die Sonne untergeht.";
"discovery.card.sunnah_bukhari_588.source" = "Sahih al-Bukhari 588";

"discovery.card.sunnah_bukhari_589.title" = "Sahih al-Buchari 589";
"discovery.card.sunnah_bukhari_589.meaning" = "Überliefert von Ibn `Umar: Ich bete, wie ich meine Gefährten beten sah. Ich verbiete das Beten zu keiner Zeit des Tages oder der Nacht, außer bei Sonnenuntergang und Sonnenaufgang.";
"discovery.card.sunnah_bukhari_589.source" = "Sahih al-Bukhari 589";

"discovery.card.sunnah_bukhari_591.title" = "Sahih al-Buchari 591";
"discovery.card.sunnah_bukhari_591.meaning" = "Überliefert vom Vater von Hisham: `Aisha (sich an mich wendend) sagte: \"O Sohn meiner Schwester! Der Prophet (ﷺ) ließ niemals zwei Niederwerfungen (d. h. Rak`at) nach dem `Asr-Gebet in meinem Haus aus.\"";
"discovery.card.sunnah_bukhari_591.source" = "Sahih al-Bukhari 591";

"discovery.card.sunnah_bukhari_592.title" = "Sahih al-Buchari 592";
"discovery.card.sunnah_bukhari_592.meaning" = "Überliefert von `Aisha: Der Gesandte Allahs (ﷺ) ließ niemals zwei Rak`at vor dem Fajr-Gebet und nach dem `Asr-Gebet aus, offen und im Verborgenen.";
"discovery.card.sunnah_bukhari_592.source" = "Sahih al-Bukhari 592";

"discovery.card.sunnah_bukhari_593.title" = "Sahih al-Buchari 593";
"discovery.card.sunnah_bukhari_593.meaning" = "Überliefert von `Aisha: Wann immer der Prophet (ﷺ) nach dem `Asr-Gebet zu mir kam, betete er stets zwei Rak`at.";
"discovery.card.sunnah_bukhari_593.source" = "Sahih al-Bukhari 593";

