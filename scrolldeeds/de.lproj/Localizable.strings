"discovery.card.fact_prophet_isa.title" = "Prophet Isa";
"discovery.card.fact_prophet_isa.meaning" = "Der Koran nennt den Propheten Isa. Seine Geschichte gehört zur Rechtleitung des Buches.";
"discovery.card.fact_prophet_isa.source" = "Qur’an 3:45";

"discovery.card.fact_prophet_muhammad.title" = "Prophet Muhammad ﷺ";
"discovery.card.fact_prophet_muhammad.meaning" = "Der Koran nennt den Propheten Muhammad ﷺ. Seine Geschichte gehört zur Rechtleitung des Buches.";
"discovery.card.fact_prophet_muhammad.source" = "Qur’an 33:40";

"discovery.card.fact_five_prayers.title" = "Fünf tägliche Gebete";
"discovery.card.fact_five_prayers.meaning" = "Der Islam steht auf fünf: Glaubensbekenntnis, Salah, Zakat, Haddsch und Fasten im Ramadan. Salah ist fünfmal täglich.";
"discovery.card.fact_five_prayers.source" = "Sahih al-Bukhari 8 · Sahih Muslim 16";

"discovery.card.fact_night_qadr.title" = "Besser als tausend Monate";
"discovery.card.fact_night_qadr.meaning" = "Laylat al-Qadr ist besser als tausend Monate. Sie liegt im Ramadan; die genaue Nacht steht im Koran nicht fest.";
"discovery.card.fact_night_qadr.source" = "Qur’an 97:3";

"discovery.card.fact_hijrah.title" = "Die Hidschra";
"discovery.card.fact_hijrah.meaning" = "Der Prophet ﷺ wanderte von Mekka nach Madina. Der Koran erwähnt Allahs Hilfe für ihn in der Höhle auf jener Reise.";
"discovery.card.fact_hijrah.source" = "Qur’an 9:40 · seerah of the Hijrah";

"discovery.card.fact_seal_prophets.title" = "Das Siegel der Propheten";
"discovery.card.fact_seal_prophets.meaning" = "Der Koran nennt Muhammad ﷺ den Gesandten Allahs und das Siegel der Propheten.";
"discovery.card.fact_seal_prophets.source" = "Qur’an 33:40";

"discovery.card.fact_two_testimonies.title" = "Kein Gott außer Allah";
"discovery.card.fact_two_testimonies.meaning" = "Die erste Säule ist zu bezeugen, dass es keinen Gott außer Allah gibt und Muhammad ﷺ Sein Gesandter ist.";
"discovery.card.fact_two_testimonies.source" = "Qur’an 47:19 · Sahih al-Bukhari 8";

"discovery.card.fact_zakat_pillar.title" = "Zakat ist eine Säule";
"discovery.card.fact_zakat_pillar.meaning" = "Der Koran verbindet Salah mit Zakat. Die fällige Abgabe ist eine der fünf Säulen des Islam.";
"discovery.card.fact_zakat_pillar.source" = "Qur’an 2:43 · Sahih al-Bukhari 8";

"discovery.card.fact_hajj_pillar.title" = "Haddsch zum Haus";
"discovery.card.fact_hajj_pillar.meaning" = "Der Haddsch zur Kaaba ist Pflicht für den, der einen Weg dorthin findet. Er ist eine der fünf Säulen.";
"discovery.card.fact_hajj_pillar.source" = "Qur’an 3:97 · Sahih al-Bukhari 8";

"discovery.card.fact_fast_ramadan.title" = "Das Fasten wurde vorgeschrieben";
"discovery.card.fact_fast_ramadan.meaning" = "Das Fasten wurde euch vorgeschrieben, wie denen vor euch, damit ihr Gottesbewusstsein erlangt.";
"discovery.card.fact_fast_ramadan.source" = "Qur’an 2:183 · Sahih al-Bukhari 8";

"discovery.card.fact_fatiha_every_salah.title" = "Kein Salah ohne Al-Fatiha";
"discovery.card.fact_fatiha_every_salah.meaning" = "Der Prophet ﷺ sagte, es gebe kein Salah für den, der die Eröffnung des Buches nicht rezitiert.";
"discovery.card.fact_fatiha_every_salah.source" = "Sahih al-Bukhari 756 · Sahih Muslim 394";

"discovery.card.fact_quran_preserved.title" = "Wir werden ihn bewahren";
"discovery.card.fact_quran_preserved.meaning" = "Allah sagte über die Erinnerung: „Wahrlich, Wir haben die Erinnerung herabgesandt, und wahrlich, Wir werden sie bewahren.“";
"discovery.card.fact_quran_preserved.source" = "Qur’an 15:9";

"discovery.card.fact_ramadan_reveal.title" = "Im Ramadan herabgesandt";
"discovery.card.fact_ramadan_reveal.meaning" = "Der Koran wurde im Monat Ramadan herabgesandt, als Rechtleitung für die Menschen und klare Beweise des Unterscheidens.";
"discovery.card.fact_ramadan_reveal.source" = "Qur’an 2:185";

"discovery.card.fact_surah_count.title" = "114 Suren";
"discovery.card.fact_surah_count.meaning" = "Der Koran im uthmanischen Mushaf umfasst 114 Suren, von Al-Fatiha bis An-Nas.";
"discovery.card.fact_surah_count.source" = "Uthmani mushaf";

"discovery.card.fact_juz_count.title" = "30 Dschuz";
"discovery.card.fact_juz_count.meaning" = "Zum Rezitieren ist der Koran in 30 Dschuz geteilt — oft eines pro Nacht im Ramadan-Khatm.";
"discovery.card.fact_juz_count.source" = "Uthmani mushaf";

"discovery.card.fact_iqra_first.title" = "Das erste Wort: Iqra";
"discovery.card.fact_iqra_first.meaning" = "Die erste Offenbarung an den Propheten ﷺ in der Höhle Hira begann: „Lies im Namen deines Herrn, der erschaffen hat.“";
"discovery.card.fact_iqra_first.source" = "Qur’an 96:1 · Sahih al-Bukhari 3";

"discovery.card.fact_longest_surah.title" = "Die längste Sure";
"discovery.card.fact_longest_surah.meaning" = "Al-Baqara ist die längste Sure im Koran, mit 286 Versen. Sie wurde in Madina offenbart.";
"discovery.card.fact_longest_surah.source" = "Uthmani mushaf · Qur’an 2";

"discovery.card.fact_shortest_surah.title" = "Die kürzeste Sure";
"discovery.card.fact_shortest_surah.meaning" = "Al-Kawthar ist die kürzeste Sure, mit drei Versen.";
"discovery.card.fact_shortest_surah.source" = "Uthmani mushaf · Qur’an 108";

"discovery.card.fact_first_house.title" = "Das erste Haus";
"discovery.card.fact_first_house.meaning" = "Der Koran sagt, das erste Haus, das für die Menschen errichtet wurde, sei das in Bakka (Mekka) — gesegnet und Rechtleitung für die Welten.";
"discovery.card.fact_first_house.source" = "Qur’an 3:96";

"discovery.card.fact_qiblah_change.title" = "Die Qibla wurde gewendet";
"discovery.card.fact_qiblah_change.meaning" = "Allah gebot dem Propheten ﷺ, sein Gesicht zur Heiligen Moschee zu wenden. Das wurde die Qibla der Muslime.";
"discovery.card.fact_qiblah_change.source" = "Qur’an 2:144";

"discovery.card.fact_arabic_quran.title" = "Ein arabischer Koran";
"discovery.card.fact_arabic_quran.meaning" = "Der Koran wurde als arabische Rezitation herabgesandt, damit die ersten Hörer ihn verstehen.";
"discovery.card.fact_arabic_quran.source" = "Qur’an 12:2";

"discovery.card.fact_in_stages.title" = "Stückweise herabgesandt";
"discovery.card.fact_in_stages.meaning" = "Der Koran wurde nicht auf einmal herabgesandt. Er wurde über die Jahre der Sendung des Propheten ﷺ stufenweise vorgetragen.";
"discovery.card.fact_in_stages.source" = "Qur’an 17:106";

"discovery.card.fact_isra.title" = "Die Nachtreise";
"discovery.card.fact_isra.meaning" = "Gepriesen sei Der, der Seinen Diener bei Nacht von der Heiligen Moschee zur Fernsten Moschee führte, deren Umgebung Wir gesegnet haben.";
"discovery.card.fact_isra.source" = "Qur’an 17:1";

"discovery.card.fact_mercy_to_worlds.title" = "Eine Barmherzigkeit für die Welten";
"discovery.card.fact_mercy_to_worlds.meaning" = "Der Koran sagt, der Prophet ﷺ sei nur als Barmherzigkeit für die Welten gesandt.";
"discovery.card.fact_mercy_to_worlds.source" = "Qur’an 21:107";

"discovery.card.fact_uswa_hasana.title" = "Ein schönes Vorbild";
"discovery.card.fact_uswa_hasana.meaning" = "Im Gesandten Allahs ﷺ habt ihr ein schönes Vorbild für den, der auf Allah und den Jüngsten Tag hofft.";
"discovery.card.fact_uswa_hasana.source" = "Qur’an 33:21";

"discovery.card.fact_great_character.title" = "Ein gewaltiger Charakter";
"discovery.card.fact_great_character.meaning" = "Allah sagte über den Propheten ﷺ: „Und du bist wahrlich von großartigem Charakter.“";
"discovery.card.fact_great_character.source" = "Qur’an 68:4";

"discovery.card.fact_salawat.title" = "Allah sendet Salah auf ihn";
"discovery.card.fact_salawat.meaning" = "Allah und Seine Engel senden Salah auf den Propheten ﷺ. Den Gläubigen ist geboten, ebenfalls Salah und Gruß auf ihn zu senden.";
"discovery.card.fact_salawat.source" = "Qur’an 33:56";

"discovery.card.fact_jumuah.title" = "Wenn der Freitag ausgerufen wird";
"discovery.card.fact_jumuah.meaning" = "Wenn zum Freitagsgebet gerufen wird, lasst den Handel und eilt zum Gedenken Allahs.";
"discovery.card.fact_jumuah.source" = "Qur’an 62:9";

"discovery.card.fact_wudu_ayah.title" = "Wudu im Koran";
"discovery.card.fact_wudu_ayah.meaning" = "Der Koran nennt das Wudu: wascht die Gesichter und die Arme bis zu den Ellbogen, streicht über die Köpfe und wascht die Füße bis zu den Knöcheln.";
"discovery.card.fact_wudu_ayah.source" = "Qur’an 5:6";

"discovery.card.fact_no_compulsion.title" = "Kein Zwang im Glauben";
"discovery.card.fact_no_compulsion.meaning" = "Es gibt keinen Zwang im Glauben. Der rechte Weg ist klar vom Irrtum unterschieden.";
"discovery.card.fact_no_compulsion.source" = "Qur’an 2:256";

"discovery.card.fact_quran_easy_remember.title" = "Leicht gemacht zum Merken";
"discovery.card.fact_quran_easy_remember.meaning" = "Allah sagte: „Wahrlich, Wir haben den Koran leicht zum Gedenken gemacht. Gibt es denn jemanden, der bedenkt?“ Dieser Wortlaut wiederholt sich in Sure Al-Qamar.";
"discovery.card.fact_quran_easy_remember.source" = "Qur’an 54:17";

"discovery.card.fact_bismillah_tawbah.title" = "Kein Bismillah vor At-Tauba";
"discovery.card.fact_bismillah_tawbah.meaning" = "Im uthmanischen Mushaf beginnt jede Sure mit der Bismillah — außer At-Tauba (Sure 9).";
"discovery.card.fact_bismillah_tawbah.source" = "Uthmani mushaf · Qur’an 9";

"discovery.card.fact_fatiha_seven.title" = "Sieben oft Wiederholte";
"discovery.card.fact_fatiha_seven.meaning" = "Al-Fatiha hat sieben Verse. Viele Gelehrte deuten „die sieben oft Wiederholten“ (15:87) auf sie — in jedem Salah rezitiert.";
"discovery.card.fact_fatiha_seven.source" = "Qur’an 15:87 · Qur’an 1";

"discovery.card.fact_ikhlas_third.title" = "Ikhlas ist ein Drittel des Korans";
"discovery.card.fact_ikhlas_third.meaning" = "Der Prophet ﷺ sagte, „Qul Huwa Allahu Ahad“ (Al-Ikhlas) gleiche einem Drittel des Korans.";
"discovery.card.fact_ikhlas_third.source" = "Sahih al-Bukhari 5015";

"discovery.card.fact_kursi_greatest.title" = "Der größte Vers";
"discovery.card.fact_kursi_greatest.meaning" = "Der Prophet ﷺ fragte Ubayy ibn Ka‘b nach dem größten Vers im Buch Allahs. Er nannte Ayat al-Kursi, und der Prophet ﷺ bestätigte es.";
"discovery.card.fact_kursi_greatest.source" = "Sahih Muslim 810";

"discovery.card.fact_muawwidhatayn.title" = "Die zwei Schutzsuren";
"discovery.card.fact_muawwidhatayn.meaning" = "Al-Falaq und An-Nas heißen die Mu‘awwidhatayn. Der Prophet ﷺ nutzte sie zum Schutz und lehrte sie.";
"discovery.card.fact_muawwidhatayn.source" = "Sahih al-Bukhari 5016";

"discovery.card.fact_iman_six.title" = "Sechs Pfeiler des Iman";
"discovery.card.fact_iman_six.meaning" = "Iman ist Glaube an Allah, Seine Engel, Seine Bücher, Seine Gesandten, den Jüngsten Tag und die Vorherbestimmung — das Gute und das Schwere.";
"discovery.card.fact_iman_six.source" = "Sahih Muslim 8 · Qur’an 4:136";

"discovery.card.fact_revealed_books.title" = "Im Koran genannte Bücher";
"discovery.card.fact_revealed_books.meaning" = "Neben dem Koran nennt das Buch Tawrah, Indschil und Zabur — Schriften, die früheren Gesandten gegeben wurden.";
"discovery.card.fact_revealed_books.source" = "Qur’an 3:3 · Qur’an 4:163 · Qur’an 5:46";

"discovery.card.fact_twelve_months.title" = "Zwölf Monate bei Allah";
"discovery.card.fact_twelve_months.meaning" = "Die Anzahl der Monate bei Allah ist zwölf, im Buch Allahs, seit Er Himmel und Erde erschuf — vier davon sind heilig.";
"discovery.card.fact_twelve_months.source" = "Qur’an 9:36";

"discovery.card.fact_maqam_ibrahim.title" = "Der Standort Ibrahims";
"discovery.card.fact_maqam_ibrahim.meaning" = "Nehmt den Standort Ibrahims zum Gebetsort. Der Koran verbindet ihn mit dem Haus, das Ibrahim und Ismail reinigen sollten.";
"discovery.card.fact_maqam_ibrahim.source" = "Qur’an 2:125";

"discovery.card.fact_named_prophets.title" = "25 namentlich genannte Propheten";
"discovery.card.fact_named_prophets.meaning" = "Der Koran nennt fünfundzwanzig Propheten, von Adam bis Muhammad ﷺ. Andere Gesandte werden ohne Namen erwähnt.";
"discovery.card.fact_named_prophets.source" = "Qur’an · 25 named prophets";

"discovery.card.fact_ninety_nine_names.title" = "Neunundneunzig Namen";
"discovery.card.fact_ninety_nine_names.meaning" = "Der Prophet ﷺ sagte, Allah habe neunundneunzig Namen, hundert minus eins; wer sie aufzählt, kommt ins Paradies.";
"discovery.card.fact_ninety_nine_names.source" = "Sahih al-Bukhari 2736 · Sahih Muslim 2677";

"discovery.card.fact_seven_mathani.title" = "Sieben oft Wiederholte";
"discovery.card.fact_seven_mathani.meaning" = "Allah sagt, Er habe dem Propheten ﷺ sieben der oft Wiederholten und den großen Koran gegeben. Viele Gelehrte deuten das als Al-Fatiha.";
"discovery.card.fact_seven_mathani.source" = "Qur’an 15:87";

"discovery.card.fact_safa_marwa.title" = "Safa und Marwa";
"discovery.card.fact_safa_marwa.meaning" = "Safa und Marwa gehören zu den Riten Allahs. Wer Haddsch oder Umra zum Haus verrichtet, dem ist kein Vorwurf, dazwischen zu gehen.";
"discovery.card.fact_safa_marwa.source" = "Qur’an 2:158";

"discovery.card.fact_four_sacred_named.title" = "Vier heilige Monate";
"discovery.card.fact_four_sacred_named.meaning" = "Von den zwölf Monaten sind vier heilig: Dhu l-Qaʿda, Dhu l-Hiddscha, Muharram und Radschab — der zwischen Dschumada und Schaʿban steht.";
"discovery.card.fact_four_sacred_named.source" = "Qur’an 9:36 · Sahih al-Bukhari 3197";

"discovery.card.fact_three_mosques.title" = "Drei Moscheen für eine Reise";
"discovery.card.fact_three_mosques.meaning" = "Der Prophet ﷺ sagte: Reist zu keiner Moschee außer dreien: der Heiligen Moschee, dieser meiner Moskee und Al-Aqsa.";
"discovery.card.fact_three_mosques.source" = "Sahih al-Bukhari 1189 · Sahih Muslim 1397";

"discovery.card.fact_last_two_baqarah.title" = "Die letzten zwei Verse von Al-Baqara";
"discovery.card.fact_last_two_baqarah.meaning" = "Der Prophet ﷺ sagte, wer die letzten zwei Verse von Al-Baqara nachts rezitiert, dem genügen sie.";
"discovery.card.fact_last_two_baqarah.source" = "Sahih al-Bukhari 5009 · Sahih Muslim 808";

"discovery.card.fact_best_days_dhulhijjah.title" = "Die besten Tage des Jahres";
"discovery.card.fact_best_days_dhulhijjah.meaning" = "Der Prophet ﷺ sagte, es gebe keine Tage, an denen rechtschaffene Taten Allah lieber seien als diese zehn — die ersten zehn des Dhu l-Hiddscha.";
"discovery.card.fact_best_days_dhulhijjah.source" = "Sahih al-Bukhari 969";

"discovery.card.fact_ayah_total.title" = "6236 Verse";
"discovery.card.fact_ayah_total.meaning" = "Der übliche uthmanische Hafs-Mushaf enthält 6236 Verse in 114 Suren.";
"discovery.card.fact_ayah_total.source" = "Uthmani Hafs mushaf count";

"discovery.card.fact_bismillah_openings.title" = "113 Suren beginnen mit Bismillah";
"discovery.card.fact_bismillah_openings.meaning" = "113 Suren beginnen mit Bismillah. At-Tawba nicht. Eine weitere Bismillah steht im Brief Sulaymans (27:30).";
"discovery.card.fact_bismillah_openings.source" = "Uthmani mushaf · Qur’an 27:30";

"discovery.card.fact_word_allah.title" = "Allah steht 2265-mal geschrieben";
"discovery.card.fact_word_allah.meaning" = "Im uthmanischen Hafs-Text kommt der Name Allah (الله) 2265-mal als geschriebenes Wort vor — ohne Allahumma.";
"discovery.card.fact_word_allah.source" = "Uthmani Hafs mushaf count";

