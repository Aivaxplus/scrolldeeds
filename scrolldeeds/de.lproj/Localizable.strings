"discovery.explain.allah_name.title" = "%@, ein Name Allahs";
"discovery.explain.allah_name.body" = "%@ ist einer der Namen Allahs. Dieser Titel der Barmherzigkeit gehört Ihm allein.";
"discovery.explain.muqattaat.body" = "%@ sind Buchstaben, mit denen Allah diese Sure eröffnet. Ihre genaue Bedeutung ist bei Allah.";

"discovery.card.smile.title" = "Ein Lächeln ist Sadaqa";
"discovery.card.smile.meaning" = "Der Prophet ﷺ sagte: „Dein Lächeln im Gesicht deines Bruders ist Sadaqa.“";
"discovery.card.smile.source" = "Jami‘ at-Tirmidhi 1956 (hasan)";

"discovery.card.salam.title" = "Verbreite den Salam";
"discovery.card.salam.meaning" = "Jemand fragte, welcher Islam am besten sei. Der Prophet ﷺ sagte: die Menschen zu speisen und den Salam denen zu geben, die man kennt und die man nicht kennt. Er sagte auch: verbreitet den Friedensgruß unter euch.";
"discovery.card.salam.source" = "Sahih al-Bukhari 28 · Sahih Muslim 54";

"discovery.card.right_hand.title" = "Iss mit der rechten Hand";
"discovery.card.right_hand.meaning" = "Der Prophet ﷺ sagte: „Wenn einer von euch isst, soll er mit der rechten Hand essen, und wenn er trinkt, mit der rechten Hand trinken. Denn der Schaytan isst und trinkt mit der linken Hand.“";
"discovery.card.right_hand.source" = "Sahih Muslim 2020";

"discovery.card.bismillah_eat.title" = "Beginne mit Bismillah";
"discovery.card.bismillah_eat.meaning" = "Der Prophet ﷺ sagte: wenn einer von euch isst, soll er den Namen Allahs nennen. Vergisst er es am Anfang, soll er sagen: „Im Namen Allahs, an seinem Anfang und an seinem Ende.“";
"discovery.card.bismillah_eat.source" = "Sunan Abi Dawud 3767 · Jami‘ at-Tirmidhi 1858";

"discovery.card.right_shoe.title" = "Beginne mit der rechten Sandale";
"discovery.card.right_shoe.meaning" = "Der Prophet ﷺ sagte: „Wenn einer von euch Sandalen anzieht, soll er mit rechts beginnen; und wenn er sie auszieht, mit links.“";
"discovery.card.right_shoe.source" = "Sahih al-Bukhari 5855";

"discovery.card.siwak.title" = "Der Siwak";
"discovery.card.siwak.meaning" = "Der Prophet ﷺ sagte: „Wenn ich keine Härte für meine Umma fürchtete, hätte ich ihnen befohlen, den Siwak bei jedem Gebet zu verwenden.“";
"discovery.card.siwak.source" = "Sahih al-Bukhari 887 · Sahih Muslim 252";

"discovery.card.anger.title" = "Stärke ist Selbstbeherrschung";
"discovery.card.anger.meaning" = "Der Prophet ﷺ sagte: „Der Starke ist nicht, wer Menschen mit Kraft besiegt; der Starke ist, wer sich beherrscht, wenn er zornig ist.“";
"discovery.card.anger.source" = "Sahih al-Bukhari 6114 · Sahih Muslim 2609";

"discovery.card.visit_sick.title" = "Besuche den Kranken";
"discovery.card.visit_sick.meaning" = "Der Prophet ﷺ sagte: „Die Rechte eines Muslims gegenüber einem Muslim sind fünf: den Gruß erwidern, den Kranken besuchen, dem Begräbnis folgen, eine Einladung annehmen und zu dem, der niest, ‚yarhamuk Allah‘ sagen.“";
"discovery.card.visit_sick.source" = "Sahih al-Bukhari 1240 · Sahih Muslim 2162";

"discovery.card.two_words.title" = "Zwei Worte, schwer auf der Waage";
"discovery.card.two_words.meaning" = "Der Prophet ﷺ sagte: „Es gibt zwei Worte, die leicht auf der Zunge, schwer auf der Waage und dem Allerbarmer lieb sind: Gepriesen sei Allah und Ihm gebührt das Lob; gepriesen sei Allah, der Großartige.“";
"discovery.card.two_words.source" = "Sahih al-Bukhari 6406 · Sahih Muslim 2694";

"discovery.card.ease.title" = "Mit der Härte kommt Erleichterung";
"discovery.card.ease.meaning" = "Allah sagt: „Wahrlich, mit der Härte kommt Erleichterung.“ Die Erleichterung wird mit der Last verheißen — nicht erst danach.";
"discovery.card.ease.source" = "Qur’an 94:5–6";

"discovery.card.neighbor.title" = "Ehre deinen Nachbarn";
"discovery.card.neighbor.meaning" = "Der Prophet ﷺ sagte: „Jibril riet mir immer wieder bezüglich des Nachbarn, bis ich dachte, er würde ihm einen Anteil am Erbe geben.“";
"discovery.card.neighbor.source" = "Sahih al-Bukhari 6014 · Sahih Muslim 2624";

"discovery.card.knowledge.title" = "Mein Herr, mehre mir Wissen";
"discovery.card.knowledge.meaning" = "Allah lehrte Seinen Gesandten ﷺ dieses Bittgebet: „Mein Herr, mehre mir Wissen.“";
"discovery.card.knowledge.source" = "Qur’an 20:114";

"discovery.card.intention.title" = "Taten sind nach der Absicht";
"discovery.card.intention.meaning" = "Der Prophet ﷺ sagte: „Die Taten sind nur nach den Absichten, und jedem Menschen wird das, was er beabsichtigt hat.“";
"discovery.card.intention.source" = "Sahih al-Bukhari 1 · Sahih Muslim 1907";

"discovery.card.half_date.title" = "Selbst eine halbe Dattel";
"discovery.card.half_date.meaning" = "Der Prophet ﷺ sagte: „Schützt euch vor dem Feuer, und sei es mit einer halben Dattel als Sadaqa.“";
"discovery.card.half_date.source" = "Sahih al-Bukhari 1417 · Sahih Muslim 1016";

"discovery.card.remove_harm.title" = "Entferne Schaden vom Weg";
"discovery.card.remove_harm.meaning" = "Der Prophet ﷺ sagte: „Der Glaube hat über siebzig Zweige. Der vorzüglichste ist zu sagen, dass es keinen Gott gibt außer Allah, und der geringste ist, etwas Schädliches vom Weg zu entfernen.“";
"discovery.card.remove_harm.source" = "Sahih Muslim 35";

"discovery.card.ikhlas.title" = "Sure al-Ichlas";
"discovery.card.ikhlas.meaning" = "Der Prophet ﷺ sagte, dass „Sprich: Er ist Allah, Einzig“ einem Drittel des Qur’an gleichkommt.";
"discovery.card.ikhlas.source" = "Qur’an 112 · Sahih al-Bukhari 5013";

"discovery.card.kursi.title" = "Ayat al-Kursi";
"discovery.card.kursi.meaning" = "„Allah — es gibt keinen Gott außer Ihm, dem Lebendigen, dem Erhalter.“ In einem authentischen Bericht wurde dem, der diesen Vers nachts rezitierte, gesagt, er werde bis zum Morgen behütet; der Prophet ﷺ bestätigte es.";
"discovery.card.kursi.source" = "Qur’an 2:255 · Sahih al-Bukhari 2311";

"discovery.card.mercy.title" = "Sei barmherzig";
"discovery.card.mercy.meaning" = "Der Prophet ﷺ sagte: „Allah erbarmt Sich nicht derer, die den Menschen nicht barmherzig sind.“";
"discovery.card.mercy.source" = "Sahih al-Bukhari 7376 · Sahih Muslim 2319";

"discovery.card.parents.title" = "Sag nicht einmal ‚uff‘";
"discovery.card.parents.meaning" = "Allah sagt: „Dein Herr hat bestimmt, dass ihr nur Ihn anbetet und zu den Eltern gütig seid. Wenn einer von ihnen oder beide bei dir das Alter erreichen, so sag nicht ‚uff‘ zu ihnen und stoße sie nicht zurück, sondern sprich ein edles Wort zu ihnen.“";
"discovery.card.parents.source" = "Qur’an 17:23";

"discovery.card.backbite.title" = "Betreibe kein Ghiba";
"discovery.card.backbite.meaning" = "Allah sagt: „Spioniert nicht und redet nicht hintereinander her. Möchte einer von euch das Fleisch seines toten Bruders essen? Ihr würdet es verabscheuen.“";
"discovery.card.backbite.source" = "Qur’an 49:12";

"discovery.card.inshaallah.title" = "Sag in sha Allah";
"discovery.card.inshaallah.meaning" = "Allah sagt: „Und sag niemals von einer Sache: ‚Ich werde das morgen tun,‘ außer [indem du hinzufügst]: ‚So Allah will.‘“";
"discovery.card.inshaallah.source" = "Qur’an 18:23–24";

"discovery.card.purification.title" = "Reinheit ist die Hälfte des Glaubens";
"discovery.card.purification.meaning" = "Der Prophet ﷺ sagte: „Die Reinheit ist die Hälfte des Glaubens.“";
"discovery.card.purification.source" = "Sahih Muslim 223";

"discovery.card.conceal.title" = "Bedecke einen Fehler";
"discovery.card.conceal.meaning" = "Der Prophet ﷺ sagte: „Wer [den Fehler] eines Muslims bedeckt, den wird Allah am Tag der Auferstehung bedecken.“";
"discovery.card.conceal.source" = "Sahih al-Bukhari 2442 · Sahih Muslim 2580";

"discovery.card.night_prayer.title" = "Das Nachtgebet";
"discovery.card.night_prayer.meaning" = "Der Prophet ﷺ sagte: „Das beste Gebet nach den Pflichtgebeten ist das Nachtgebet.“";
"discovery.card.night_prayer.source" = "Sahih Muslim 1163";

"discovery.card.return_salam.title" = "Erwidere den Gruß";
"discovery.card.return_salam.meaning" = "Allah sagt: „Wenn ihr mit einem Gruß begrüßt werdet, dann grüßt mit einem besseren, oder erwidert ihn. Wahrlich, Allah rechnet über alles ab.“";
"discovery.card.return_salam.source" = "Qur’an 4:86";

"discovery.card.patience.title" = "Sucht Hilfe in Geduld und Gebet";
"discovery.card.patience.meaning" = "Allah sagt: „O die ihr glaubt, sucht Hilfe durch Geduld und Gebet. Wahrlich, Allah ist mit den Geduldigen.“";
"discovery.card.patience.source" = "Qur’an 2:153";

"discovery.card.tawakkul.title" = "Allah genügt";
"discovery.card.tawakkul.meaning" = "Allah sagt: „Und wer auf Allah vertraut — dem ist Er genug. Wahrlich, Allah vollbringt Seine Sache.“";
"discovery.card.tawakkul.source" = "Qur’an 65:3";

"discovery.card.istighfar.title" = "Bitte oft um Vergebung";
"discovery.card.istighfar.meaning" = "Der Prophet ﷺ sagte: „Bei Allah, ich bitte Allah um Vergebung und kehre zu Ihm in Reue mehr als siebzigmal am Tag.“";
"discovery.card.istighfar.source" = "Sahih al-Bukhari 6307";

"discovery.card.wudu_sleep.title" = "Schlafe mit Wudu";
"discovery.card.wudu_sleep.meaning" = "Der Prophet ﷺ sagte: „Wenn du zu deinem Bett gehst, verrichte Wudu wie zum Gebet, und lege dich dann auf die rechte Seite.“";
"discovery.card.wudu_sleep.source" = "Sahih al-Bukhari 247 · Sahih Muslim 2710";

"discovery.card.enter_home.title" = "Nenne Allah, wenn du eintrittst";
"discovery.card.enter_home.meaning" = "Der Prophet ﷺ sagte: wenn ein Mann sein Haus betritt und Allah beim Eintreten und beim Essen erwähnt, sagt der Schaytan: „Ihr habt keine Unterkunft und kein Abendessen.“";
"discovery.card.enter_home.source" = "Sahih Muslim 2018";

"discovery.card.lower_gaze.title" = "Senke den Blick";
"discovery.card.lower_gaze.meaning" = "Allah sagt: „Sag den gläubigen Männern, sie sollen ihren Blick senken und ihre Keuschheit bewahren. Das ist reiner für sie. Wahrlich, Allah weiß, was sie tun.“";
"discovery.card.lower_gaze.source" = "Qur’an 24:30";

"discovery.card.upper_hand.title" = "Die obere Hand";
"discovery.card.upper_hand.meaning" = "Der Prophet ﷺ sagte: „Die obere Hand ist besser als die untere. Die obere ist die gebende, die untere die bittende.“";
"discovery.card.upper_hand.source" = "Sahih al-Bukhari 1427 · Sahih Muslim 1033";

"discovery.card.fatiha.title" = "Die Eröffnung";
"discovery.card.fatiha.meaning" = "Der Prophet ﷺ sagte, dass Allah spricht: Ich habe das Gebet zwischen Mir und Meinem Diener in zwei Hälften geteilt. Wenn er sagt: „Alles Lob gebührt Allah, dem Herrn der Welten,“ sagt Allah: Mein Diener hat Mich gelobt.";
"discovery.card.fatiha.source" = "Qur’an 1 · Sahih Muslim 395";

"discovery.card.honor_guest.title" = "Ehre den Gast";
"discovery.card.honor_guest.meaning" = "Der Prophet ﷺ sagte: „Wer an Allah und den Jüngsten Tag glaubt, der soll seinen Gast ehren.“";
"discovery.card.honor_guest.source" = "Sahih al-Bukhari 6018 · Sahih Muslim 47";

"discovery.card.love_brother.title" = "Liebe für deinen Bruder";
"discovery.card.love_brother.meaning" = "Der Prophet ﷺ sagte: „Keiner von euch glaubt [wahrhaft], bis er für seinen Bruder liebt, was er für sich selbst liebt.“";
"discovery.card.love_brother.source" = "Sahih al-Bukhari 13 · Sahih Muslim 45";

"discovery.card.remember_me.title" = "Gedenkt Meiner, Ich gedenke eurer";
"discovery.card.remember_me.meaning" = "Allah sagt: „So gedenkt Meiner; Ich werde eurer gedenken. Und seid Mir dankbar und verleugnet Mich nicht.“";
"discovery.card.remember_me.source" = "Qur’an 2:152";

"discovery.card.no_envy.title" = "Beneidet einander nicht";
"discovery.card.no_envy.meaning" = "Der Prophet ﷺ sagte: „Beneidet einander nicht, hasst einander nicht, wendet euch nicht voneinander ab, und seid, o Diener Allahs, Brüder.“";
"discovery.card.no_envy.source" = "Sahih al-Bukhari 6065 · Sahih Muslim 2563";

"discovery.card.truthfulness.title" = "Wahrhaftigkeit führt ins Paradies";
"discovery.card.truthfulness.meaning" = "Der Prophet ﷺ sagte: „Wahrhaftigkeit führt zur Rechtschaffenheit, und Rechtschaffenheit führt ins Paradies. Ein Mann bleibt wahrhaftig, bis er bei Allah als Siddiq geschrieben wird.“";
"discovery.card.truthfulness.source" = "Sahih al-Bukhari 6094 · Sahih Muslim 2607";

"discovery.card.ghusl_friday.title" = "Ghusl am Freitag";
"discovery.card.ghusl_friday.meaning" = "Der Prophet ﷺ sagte: „Ghusl am Freitag ist für jeden Erwachsenen verpflichtend.“";
"discovery.card.ghusl_friday.source" = "Sahih al-Bukhari 879 · Sahih Muslim 846";

"discovery.card.speak_good.title" = "Sprich Gutes oder schweige";
"discovery.card.speak_good.meaning" = "Der Prophet ﷺ sagte: „Wer an Allah und den Jüngsten Tag glaubt, der soll Gutes sprechen oder schweigen.“";
"discovery.card.speak_good.source" = "Sahih al-Bukhari 6018 · Sahih Muslim 47";

"discovery.card.fajr_sunnah.title" = "Die zwei Rak‘as des Fajr";
"discovery.card.fajr_sunnah.meaning" = "Der Prophet ﷺ sagte: „Die zwei Rak‘as des Fajr sind besser als diese Welt und alles, was in ihr ist.“";
"discovery.card.fajr_sunnah.source" = "Sahih Muslim 725";

"discovery.card.haya.title" = "Schamhaftigkeit gehört zum Glauben";
"discovery.card.haya.meaning" = "Der Prophet ﷺ sagte: „Die Schamhaftigkeit ist ein Zweig des Glaubens.“";
"discovery.card.haya.source" = "Sahih al-Bukhari 9 · Sahih Muslim 35";

"discovery.card.no_burden.title" = "Allah belastet keine Seele";
"discovery.card.no_burden.meaning" = "Allah sagt: „Allah belastet keine Seele über ihr Vermögen hinaus.“";
"discovery.card.no_burden.source" = "Qur’an 2:286";

"discovery.card.mankind.title" = "Der Edelste ist der Gottesfürchtigste";
"discovery.card.mankind.meaning" = "Allah sagt: „O ihr Menschen, Wir haben euch aus einem Mann und einer Frau erschaffen und euch zu Völkern und Stämmen gemacht, damit ihr einander kennt. Der Edelste von euch bei Allah ist der Gottesfürchtigste.“";
"discovery.card.mankind.source" = "Qur’an 49:13";

