"notification.spiritual.quran1.title" = "Gedenkt Meiner";
"notification.spiritual.quran1.body" = "„Gedenkt Meiner, so gedenke Ich euer.“ — Koran 2:152";
"notification.spiritual.sunnah1.title" = "Die beliebtesten Taten";
"notification.spiritual.sunnah1.body" = "„Die beliebtesten Taten bei Allah sind die beständigsten, auch wenn sie klein sind.“ — Sahih al-Bukhari 6465; Sahih Muslim 783";
"notification.spiritual.reminder1.title" = "Allah sieht dich";
"notification.spiritual.reminder1.body" = "Was du jetzt tust, kommt am Tag des Gerichts zurück. Wähle, was du Ihm zeigen willst.";
"notification.spiritual.quran2.title" = "Mit der Schwierigkeit kommt Erleichterung";
"notification.spiritual.quran2.body" = "„Wahrlich, mit der Schwierigkeit kommt Erleichterung.“ — Koran 94:6";
"notification.spiritual.sunnah2.title" = "Sprich Gutes oder schweige";
"notification.spiritual.sunnah2.body" = "„Wer an Allah und den Jüngsten Tag glaubt, der soll Gutes sagen oder schweigen.“ — Sahih al-Bukhari 6018; Sahih Muslim 47";
"notification.spiritual.reminder2.title" = "Die Akhirah wartet";
"notification.spiritual.reminder2.body" = "Diese Minute zählt. Ein Dhikr ist leichter zu tragen als eine Stunde Scrollen.";
"notification.spiritual.quran3.title" = "Erinnere, wenn es nützt";
"notification.spiritual.quran3.body" = "„So ermahne, wenn die Ermahnung nützt.“ — Koran 87:9";
"notification.spiritual.sunnah3.title" = "Taten nach der Absicht";
"notification.spiritual.sunnah3.body" = "„Die Taten sind nach den Absichten, und jedem wird zuteil, was er beabsichtigt hat.“ — Sahih al-Bukhari 1; Sahih Muslim 1907";
"notification.spiritual.reminder3.title" = "Wo stehst du danach?";
"notification.spiritual.reminder3.body" = "Sei in dieser Welt wie ein Reisender. Der Feed ist nicht dein Zuhause.";
"notification.spiritual.quran4.title" = "Allah ist mit den Geduldigen";
"notification.spiritual.quran4.body" = "„O die ihr glaubt, sucht Hilfe durch Geduld und Gebet. Allah ist mit den Geduldigen.“ — Koran 2:153";
"notification.spiritual.sunnah4.title" = "Der Starke";
"notification.spiritual.sunnah4.body" = "„Der Starke ist nicht, wer andere niederwirft, sondern wer sich im Zorn beherrscht.“ — Sahih al-Bukhari 6114; Sahih Muslim 2609";
"notification.spiritual.reminder4.title" = "Ein Atemzug ist eine Chance";
"notification.spiritual.reminder4.body" = "Allah hat dir noch einen Atemzug gegeben. Nutze ihn für Istighfar, nicht für das nächste Video.";
"notification.spiritual.quran5.title" = "Herzen finden Ruhe";
"notification.spiritual.quran5.body" = "„Wahrlich, durch das Gedenken Allahs finden die Herzen Ruhe.“ — Koran 13:28";
"notification.spiritual.sunnah5.title" = "Erleichtert und erschwert nicht";
"notification.spiritual.sunnah5.body" = "„Erleichtert und erschwert nicht; verkündet frohe Botschaft und stoßt nicht ab.“ — Sahih al-Bukhari 69; Sahih Muslim 1734";
"notification.spiritual.reminder5.title" = "Das Grab wird fragen";
"notification.spiritual.reminder5.body" = "Was nimmst du mit: eine Reihe Clips, oder ein Wort, das Allah liebt?";
"notification.spiritual.quran6.title" = "Verrichtet das Gebet";
"notification.spiritual.quran6.body" = "„Und verrichtet das Gebet, entrichtet die Zakah und verneigt euch mit denen, die sich verneigen.“ — Koran 2:43";
"notification.spiritual.sunnah6.title" = "Lernt den Koran und lehrt ihn";
"notification.spiritual.sunnah6.body" = "„Die Besten von euch sind jene, die den Koran lernen und lehren.“ — Sahih al-Bukhari 5027";
"notification.spiritual.reminder6.title" = "Er ist nah";
"notification.spiritual.reminder6.body" = "Wenn Meine Diener dich nach Mir fragen: Ich bin nah. Ruf Ihn jetzt an.";
"notification.spiritual.quran7.title" = "Dein Herr hat dich nicht verlassen";
"notification.spiritual.quran7.body" = "„Dein Herr hat dich weder verlassen noch verabscheut Er dich.“ — Koran 93:3";
"notification.spiritual.sunnah7.title" = "Reinheit ist die Hälfte des Glaubens";
"notification.spiritual.sunnah7.body" = "„Reinheit ist die Hälfte des Glaubens.“ — Sahih Muslim 223";
"notification.spiritual.reminder7.title" = "Die Waage";
"notification.spiritual.reminder7.body" = "Ein Subhanallah kann schwerer wiegen als alles, was du heute gescrollt hast.";
"notification.spiritual.quran8.title" = "Er fand dich irrend und leitete dich";
"notification.spiritual.quran8.body" = "„Und Er fand dich irrend und leitete dich.“ — Koran 93:7";
"notification.spiritual.sunnah8.title" = "Sei auf der Welt wie ein Reisender";
"notification.spiritual.sunnah8.body" = "„Sei auf dieser Welt, als wärst du ein Fremder oder ein Reisender.“ — Sahih al-Bukhari 6416";
"notification.spiritual.reminder8.title" = "Vergiss die Rückkehr nicht";
"notification.spiritual.reminder8.body" = "Jede Seele wird den Tod schmecken. Lebe diese Stunde so, als müsstest du dafür Rechenschaft geben.";
"notification.spiritual.quran9.title" = "Vergiss deinen Anteil nicht";
"notification.spiritual.quran9.body" = "„Und vergiss nicht deinen Anteil an der Welt. Und tue Gutes, wie Allah dir Gutes getan hat.“ — Koran 28:77";
"notification.spiritual.sunnah9.title" = "Liebe für deinen Bruder";
"notification.spiritual.sunnah9.body" = "„Keiner von euch glaubt wahrhaft, bis er für seinen Bruder liebt, was er für sich selbst liebt.“ — Sahih al-Bukhari 13; Sahih Muslim 45";
"notification.spiritual.reminder9.title" = "Allah genügt";
"notification.spiritual.reminder9.body" = "Was du im Feed suchst, füllt nicht, was nur Allah füllt.";
"notification.spiritual.quran10.title" = "Gedenke Seiner stehend und sitzend";
"notification.spiritual.quran10.body" = "„Die Allah gedenken, stehend, sitzend oder auf der Seite liegend.“ — Koran 3:191";
"notification.spiritual.sunnah10.title" = "Sicher vor Zunge und Hand";
"notification.spiritual.sunnah10.body" = "„Ein Muslim ist der, vor dessen Zunge und Hand die Muslime sicher sind.“ — Sahih al-Bukhari 10; Sahih Muslim 40";
"notification.spiritual.reminder10.title" = "Ein Wort für Ihn";
"notification.spiritual.reminder10.body" = "Sag Astaghfirullah. Es löscht. Scrollen fügt nur hinzu, was du nicht tragen willst.";
"notification.spiritual.quran11.title" = "Das Gebet hält vom Schändlichen ab";
"notification.spiritual.quran11.body" = "„Wahrlich, das Gebet hält vom Schändlichen und Verwerflichen ab, und das Gedenken Allahs ist größer.“ — Koran 29:45";
"notification.spiritual.sunnah11.title" = "Zwei Worte, schwer auf der Waage";
"notification.spiritual.sunnah11.body" = "„Zwei Worte sind leicht auf der Zunge, schwer auf der Waage und dem Allerbarmer lieb: Subhanallahi wa bihamdihi, Subhanallahil-Azeem.“ — Sahih al-Bukhari 6406; Sahih Muslim 2694";
"notification.spiritual.reminder11.title" = "Der Tag kommt";
"notification.spiritual.reminder11.body" = "Niemandem wird Unrecht getan. Was jetzt klein wirkt, steht dann auf deinem Blatt.";
"notification.spiritual.quran12.title" = "Ist die Zeit nicht gekommen?";
"notification.spiritual.quran12.body" = "„Ist die Zeit nicht gekommen für die Gläubigen, dass ihre Herzen demütig werden beim Gedenken Allahs?“ — Koran 57:16";
"notification.spiritual.sunnah12.title" = "Werde nicht zornig";
"notification.spiritual.sunnah12.body" = "Jemand sagte: „Rate mir.“ Er ﷺ sagte: „Werde nicht zornig.“ Er wiederholte es, und er ﷺ blieb dabei: „Werde nicht zornig.“ — Sahih al-Bukhari 6116";
"notification.spiritual.reminder12.title" = "Richte dein Herz";
"notification.spiritual.reminder12.body" = "Im Gedenken Allahs finden die Herzen Ruhe.";
"notification.spiritual.quran13.title" = "Sucht Hilfe durch Geduld";
"notification.spiritual.quran13.body" = "„Und sucht Hilfe durch Geduld und Gebet. Es ist wahrlich schwer, außer für die Demütigen.“ — Koran 2:45";
"notification.spiritual.sunnah13.title" = "Keine Barmherzigkeit ohne Barmherzigkeit";
"notification.spiritual.sunnah13.body" = "„Allah ist nicht barmherzig zu dem, der nicht barmherzig zu den Menschen ist.“ — Sahih al-Bukhari 5997; Sahih Muslim 2319";
"notification.spiritual.reminder13.title" = "Für deinen Herrn";
"notification.spiritual.reminder13.body" = "Salah, Dhikr, eine Ayah. Das bleibt. Die Timeline verschwindet.";
"notification.spiritual.quran14.title" = "Ich bin nahe";
"notification.spiritual.quran14.body" = "„Und wenn dich Meine Diener nach Mir fragen: Ich bin nahe. Ich erhöre den Ruf des Rufenden, wenn er Mich anruft.“ — Koran 2:186";
"notification.spiritual.sunnah14.title" = "Jede gute Tat ist Sadaqa";
"notification.spiritual.sunnah14.body" = "„Jede gute Tat ist Sadaqa.“ — Sahih al-Bukhari 6022; Sahih Muslim 1005";
"notification.spiritual.reminder14.title" = "Zwei Minuten mit Allah";
"notification.spiritual.reminder14.body" = "Leg das Handy weg. Sag Subhanallah, Alhamdulillah, Allahu akbar.";
"notification.spiritual.quran15.title" = "Keine Seele wird überlastet";
"notification.spiritual.quran15.body" = "„Allah erlegt keiner Seele mehr auf, als sie zu tragen vermag.“ — Koran 2:286";
"notification.spiritual.sunnah15.title" = "Schaden vom Weg nehmen";
"notification.spiritual.sunnah15.body" = "„Etwas Schädliches vom Weg zu nehmen ist Sadaqa.“ — Sahih al-Bukhari 2989; Sahih Muslim 1009";
"notification.spiritual.reminder15.title" = "Wen hoffst du zu treffen?";
"notification.spiritual.reminder15.body" = "Die Begegnung mit Allah ist wirklich. Bereite heute eine gute Tat vor.";
"notification.spiritual.quran16.title" = "Werdet nicht schwach und seid nicht traurig";
"notification.spiritual.quran16.body" = "„Werdet also nicht schwach und seid nicht traurig; ihr werdet die Oberhand haben, wenn ihr Gläubige seid.“ — Koran 3:139";
"notification.spiritual.sunnah16.title" = "Haya gehört zum Glauben";
"notification.spiritual.sunnah16.body" = "„Haya (Schamhaftigkeit) ist ein Zweig des Glaubens.“ — Sahih al-Bukhari 24; Sahih Muslim 36";
"notification.spiritual.reminder16.title" = "Diese Welt ist kurz";
"notification.spiritual.reminder16.body" = "Was du jetzt für Allah aufschiebst, fühlt sich dann länger an als dieser ganze Feed.";
"notification.spiritual.quran17.title" = "Seid geduldig und bleibt standhaft";
"notification.spiritual.quran17.body" = "„O die ihr glaubt, seid geduldig, haltet standhaft aus, bleibt wachsam und fürchtet Allah, auf dass ihr erfolgreich seid.“ — Koran 3:200";
"notification.spiritual.sunnah17.title" = "Die Religion ist aufrichtiger Rat";
"notification.spiritual.sunnah17.body" = "„Die Religion ist Naseehah.“ Wir sagten: „Wem gegenüber?“ Er sagte: „Allah, Seinem Buch, Seinem Gesandten, den Führern der Muslime und ihren einfachen Leuten.“ — Sahih Muslim 55";
"notification.spiritual.reminder17.title" = "Bitte um Vergebung";
"notification.spiritual.reminder17.body" = "Allah liebt es, wenn du zurückkehrst. Eine aufrichtige Tawbah wiegt mehr als perfektes Scrollen.";
"notification.spiritual.quran18.title" = "Gebet zu festgelegten Zeiten";
"notification.spiritual.quran18.body" = "„Wahrlich, das Gebet ist den Gläubigen zu festgesetzten Zeiten vorgeschrieben.“ — Koran 4:103";
"notification.spiritual.sunnah18.title" = "Ehre deinen Gast";
