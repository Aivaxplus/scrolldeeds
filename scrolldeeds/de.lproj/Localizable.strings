// MARK: - Dua vollständige Übersetzungen
"dua.ayat_al_kursi.translation" = "Allah — es gibt keine Gottheit außer Ihm, dem Ewig Lebenden, dem Beständigen. Weder Schlummer noch Schlaf überkommt Ihn. Ihm gehört alles, was in den Himmeln und auf der Erde ist. Wer kann bei Ihm Fürsprache einlegen außer mit Seiner Erlaubnis? Er weiß, was vor ihnen liegt und was hinter ihnen ist, und sie umfassen nichts von Seinem Wissen außer dem, was Er will. Sein Kursi erstreckt sich über die Himmel und die Erde, und ihre Bewahrung ermüdet Ihn nicht. Und Er ist der Erhabene, der Gewaltige. (Quran 2:255)";
"dua.istighfar.translation" = "O Allah, Du bist mein Herr. Es gibt keine Gottheit außer Dir. Du hast mich erschaffen und ich bin Dein Diener. Ich lebe nach meinem Bund und Versprechen an Dich so gut ich kann. Ich suche Zuflucht bei Dir vor dem Übel dessen, was ich getan habe. Ich anerkenne Deine Gnade mir gegenüber und bekenne meine Sünden. So vergib mir, denn niemand vergibt Sünden außer Dir. (Sayyid al-Istighfar)";
"dua.dua_parents.translation" = "Mein Herr, erbarme Dich über sie beide, so wie sie mich erzogen haben, als ich klein war. (Quran 17:24)";
"dua.dua_ummah.translation" = "O Allah, besser die Ummah Muhammads. O Allah, erleichtere das Leid der Ummah Muhammads. O Allah, erbarme Dich der Ummah Muhammads.";
"dua.dua_loved_one.translation" = "O Allah, segne ihn/sie in dem, was Du ihm/ihr gewährt hast. Vergib ihm/ihr, erbarme Dich seiner/ihrer, schenke ihm/ihr Wohlbefinden und vergib ihm/ihr.";
"dua.verse_reflection.translation" = "Wahrlich, in der Erschaffung der Himmel und der Erde und im Wechsel von Nacht und Tag sind Zeichen für die Verständigen. (Quran 3:190)";
"dua.dua_knowledge.translation" = "Mein Herr, mehre mich an Wissen. (Quran 20:114)";
"dua.dua_relief.translation" = "O Allah, ich suche Zuflucht bei Dir vor Kummer und Trauer.";
"dua.dua_morning.translation" = "Wir sind in den Morgen eingetreten und die Herrschaft gehört Allah, und alles Lob gebührt Allah.";
"dua.dua_evening.translation" = "Wir sind in den Abend eingetreten und die Herrschaft gehört Allah, und alles Lob gebührt Allah.";
"dua.dua_dunya.translation" = "Unser Herr, gib uns Gutes in dieser Welt und Gutes im Jenseits, und bewahre uns vor der Strafe des Feuers. (Koran 2:201)";
"dua.dua_heart.translation" = "Unser Herr, lass unsere Herzen nicht abweichen, nachdem Du uns rechtgeleitet hast, und schenke uns Barmherzigkeit von Dir. Wahrlich, Du bist der Gewährende. (Koran 3:8)";
"dua.dua_hasbi.translation" = "Allah genügt mir. Es gibt keinen Gott außer Ihm. Auf Ihn vertraue ich, und Er ist der Herr des gewaltigen Throns. (Koran 9:129)";
"dua.dua_jannah.translation" = "O Allah, ich bitte Dich um das Paradies und suche bei Dir Zuflucht vor dem Feuer.";

// MARK: - Surah full translations (for recitation tasks)
"surah.ikhlas.translation" = "Im Namen Allahs, des Allerbarmers, des Barmherzigen.\nSag: Er ist Allah, Einer. Allah, der Unabhängige. Er zeugt nicht und wurde nicht gezeugt. Und niemand ist Ihm gleich.";
"surah.falaq.translation" = "Im Namen Allahs, des Allerbarmers, des Barmherzigen.\nSag: Ich suche Zuflucht beim Herrn der Morgenröte vor dem Übel dessen, was Er erschaffen hat, und vor dem Übel der Dunkelheit, wenn sie sich ausbreitet, und vor dem Übel der in Knoten blasenden (Zauberer) und vor dem Übel des Neiders, wenn er neidet.";
"surah.nas.translation" = "Im Namen Allahs, des Allerbarmers, des Barmherzigen.\nSag: Ich suche Zuflucht beim Herrn der Menschen, dem König der Menschen, dem Gott der Menschen, vor dem Übel des sich zurückziehenden Einflüsterers, der in die Brüste der Menschen einflüstert, unter den Dschinn und den Menschen.";
"surah.fatiha.translation" = "Im Namen Allahs, des Allerbarmers, des Barmherzigen. Alles Lob gebührt Allah, dem Herrn der Welten, dem Allerbarmer, dem Barmherzigen, dem Herrscher am Tag des Gerichts. Dir allein dienen wir, und Dich allein bitten wir um Hilfe. Führe uns den geraden Weg – den Weg derer, denen Du Gunst erwiesen hast, nicht derer, die zornig sind, noch der Irregehenden.";
"surah.kafirun.translation" = "Im Namen Allahs, des Allerbarmers, des Barmherzigen. Sag: O ihr Ungläubigen, ich diene nicht dem, dem ihr dient. Noch seid ihr Diener dessen, dem ich diene. Noch werde ich Diener dessen sein, dem ihr dient. Noch werdet ihr Diener dessen sein, dem ich diene. Euch euer Glaube, mir mein Glaube.";
"surah.kawthar.translation" = "Im Namen Allahs, des Allerbarmers, des Barmherzigen.
Wahrlich, Wir haben dir Al-Kawthar gegeben. So bete zu deinem Herrn und opfere. Wahrlich, dein Hasser ist der Abgeschnittene.";
"surah.asr.translation" = "Im Namen Allahs, des Allerbarmers, des Barmherzigen.
Bei der Zeit. Wahrlich, der Mensch ist in Verlust, außer denen, die glauben, gute Werke tun, einander die Wahrheit ans Herz legen und einander zur Geduld ermahnen.";

