/* Discovery feed expansion */
"discovery.card.shukr.title" = "Si sois agradecidos, os aumentaré";
"discovery.card.shukr.meaning" = "Allah dice: “Si sois agradecidos, os aumentaré con certeza; pero si negáis, Mi castigo es severo.”";
"discovery.card.shukr.source" = "Corán 14:7";

"discovery.card.dua_near.title" = "Estoy cerca";
"discovery.card.dua_near.meaning" = "Allah dice: “Cuando Mis siervos te pregunten por Mí, ciertamente estoy cerca. Respondo a la súplica de quien Me invoca cuando Me invoca.”";
"discovery.card.dua_near.source" = "Corán 2:186";

"discovery.card.no_despair.title" = "No desesperéis de la misericordia de Allah";
"discovery.card.no_despair.meaning" = "Allah dice: “Di: Oh siervos Míos que os habéis excedido contra vosotros mismos, no desesperéis de la misericordia de Allah. Ciertamente Allah perdona todos los pecados.”";
"discovery.card.no_despair.source" = "Corán 39:53";

"discovery.card.qadr.title" = "La Noche del Decreto";
"discovery.card.qadr.meaning" = "Allah dice: “La Noche del Decreto es mejor que mil meses.”";
"discovery.card.qadr.source" = "Corán 97:3";

"discovery.card.duha_care.title" = "Tu Señor no te ha abandonado";
"discovery.card.duha_care.meaning" = "Allah dice: “Tu Señor no te ha abandonado ni está disgustado. Lo último es mejor para ti que lo primero. Tu Señor te dará y quedarás satisfecho.”";
"discovery.card.duha_care.source" = "Corán 93:3–5";

"discovery.card.asr.title" = "Por el tiempo, el ser humano está en pérdida";
"discovery.card.asr.meaning" = "Allah dice: “Por el tiempo, ciertamente el ser humano está en pérdida — excepto quienes creen, obran el bien y se aconsejan mutuamente la verdad y la paciencia.”";
"discovery.card.asr.source" = "Corán 103:1–3";

"discovery.card.kawthar.title" = "Te hemos dado al-Kawthar";
"discovery.card.kawthar.meaning" = "Allah dice: “Te hemos dado al-Kawthar. Así pues, reza a tu Señor y sacrifica.”";
"discovery.card.kawthar.source" = "Corán 108:1–2";

"discovery.card.no_compulsion.title" = "No hay coacción en la religión";
"discovery.card.no_compulsion.meaning" = "Allah dice: “No hay coacción en la religión. El camino recto se ha distinguido del error.”";
"discovery.card.no_compulsion.source" = "Corán 2:256";

"discovery.card.with_you.title" = "Él está con vosotros dondequiera que estéis";
"discovery.card.with_you.meaning" = "Allah dice: “Él está con vosotros dondequiera que estéis. Y Allah ve lo que hacéis.”";
"discovery.card.with_you.source" = "Corán 57:4";

"discovery.card.closer.title" = "Más cerca que la vena yugular";
"discovery.card.closer.meaning" = "Allah dice: “Creamos al ser humano y sabemos lo que su alma le susurra, y estamos más cerca de él que su vena yugular.”";
"discovery.card.closer.source" = "Corán 50:16";

"discovery.card.spouses.title" = "Cariño y misericordia entre vosotros";
"discovery.card.spouses.meaning" = "Allah dice: “Creó para vosotros cónyuges de vosotros mismos para que encontréis sosiego en ellos, y puso entre vosotros cariño y misericordia.”";
"discovery.card.spouses.source" = "Corán 30:21";

"discovery.card.blessings_count.title" = "No podéis contar las gracias de Allah";
"discovery.card.blessings_count.meaning" = "Allah dice: “Si intentárais contar la gracia de Allah, no podríais enumerarla. Ciertamente Allah es Perdonador, Misericordioso.”";
"discovery.card.blessings_count.source" = "Corán 16:18";

"discovery.card.fasting_prescribed.title" = "Se os ha prescrito el ayuno";
"discovery.card.fasting_prescribed.meaning" = "Allah dice: “Oh vosotros que creéis, se os ha prescrito el ayuno como se prescribió a quienes os precedieron, para que tengáis temor de Allah.”";
"discovery.card.fasting_prescribed.source" = "Corán 2:183";

"discovery.card.yunus_dua.title" = "No hay dios sino Tú";
"discovery.card.yunus_dua.meaning" = "Allah dice que Yunus invocó en las tinieblas: “No hay dios sino Tú. Gloria a Ti. Ciertamente he sido de los injustos.”";
"discovery.card.yunus_dua.source" = "Corán 21:87";

"discovery.card.hasbuna.title" = "Allah nos basta";
"discovery.card.hasbuna.meaning" = "Allah dice que quienes aumentaron en fe dijeron: “Allah nos basta, y Él es el mejor Dispositor.”";
"discovery.card.hasbuna.source" = "Corán 3:173";

"discovery.card.rabbana_atina.title" = "Bien en este mundo y en el otro";
"discovery.card.rabbana_atina.meaning" = "Allah dice: “Señor nuestro, danos bien en este mundo y bien en la Última Vida, y protégenos del castigo del Fuego.”";
"discovery.card.rabbana_atina.source" = "Corán 2:201";

"discovery.card.be_and_it_is.title" = "Sé, y es";
"discovery.card.be_and_it_is.meaning" = "Allah dice: “Su mandato, cuando quiere una cosa, es solo decirle: ‘Sé,’ y es.”";
"discovery.card.be_and_it_is.source" = "Corán 36:82";

"discovery.card.which_favors.title" = "¿Cuál de las gracias de vuestro Señor?";
"discovery.card.which_favors.meaning" = "Allah dice: “¿Cuál de las gracias de vuestro Señor negaréis?”";
"discovery.card.which_favors.source" = "Corán 55:13";

"discovery.card.calamity.title" = "Ninguna desgracia sino con permiso de Allah";
"discovery.card.calamity.meaning" = "Allah dice: “No ocurre ninguna desgracia sino con permiso de Allah. Y quien cree en Allah — Él guía su corazón.”";
"discovery.card.calamity.source" = "Corán 64:11";

"discovery.card.death_life.title" = "Creó la muerte y la vida";
"discovery.card.death_life.meaning" = "Allah dice: “Quien creó la muerte y la vida para probaros cuál de vosotros es mejor en obras — y Él es el Poderoso, el Perdonador.”";
"discovery.card.death_life.source" = "Corán 67:2";

"discovery.card.kafirun.title" = "Para vosotros vuestra religión, para mí la mía";
"discovery.card.kafirun.meaning" = "Allah dice: “Para vosotros vuestra religión, y para mí la mía.”";
"discovery.card.kafirun.source" = "Corán 109:6";

"discovery.card.nas.title" = "Me refugio en el Señor de los hombres";
"discovery.card.nas.meaning" = "Allah dice: “Di: Me refugio en el Señor de los hombres, el Rey de los hombres, el Dios de los hombres.”";
"discovery.card.nas.source" = "Corán 114:1–3";

"discovery.card.falaq.title" = "Me refugio en el Señor del alba";
"discovery.card.falaq.meaning" = "Allah dice: “Di: Me refugio en el Señor del alba, del mal de lo que Él ha creado.”";
"discovery.card.falaq.source" = "Corán 113:1–2";

"discovery.card.orphans_duha.title" = "No oprimas al huérfano";
"discovery.card.orphans_duha.meaning" = "Allah dice: “En cuanto al huérfano, no lo oprimas. Y en cuanto al que pide, no lo rechaces. Y en cuanto a la gracia de tu Señor, proclámala.”";
"discovery.card.orphans_duha.source" = "Corán 93:9–11";

"discovery.card.justice.title" = "Manteneos firmes en la justicia";
"discovery.card.justice.meaning" = "Allah dice: “Oh vosotros que creéis, sed firmes en la justicia, testigos por Allah, aunque sea contra vosotros mismos o contra padres y parientes.”";
"discovery.card.justice.source" = "Corán 4:135";

"discovery.card.amanah.title" = "Devuelvan los depósitos a sus dueños";
"discovery.card.amanah.meaning" = "Allah dice: “Allah os ordena devolver los depósitos a sus dueños, y cuando juzguéis entre la gente, que juzguéis con justicia.”";
"discovery.card.amanah.source" = "Corán 4:58";

"discovery.card.luqman_salah.title" = "Establece la oración, hijito";
"discovery.card.luqman_salah.meaning" = "Luqman dijo: “Hijito mío, establece la oración, ordena el bien, prohíbe el mal, y sé paciente ante lo que te ocurra.”";
"discovery.card.luqman_salah.source" = "Corán 31:17";

"discovery.card.infaq_grain.title" = "La parábola de gastar";
"discovery.card.infaq_grain.meaning" = "Allah dice: “El ejemplo de quienes gastan su riqueza en el camino de Allah es como un grano que produce siete espigas, en cada espiga cien granos. Allah multiplica para quien Él quiere.”";
"discovery.card.infaq_grain.source" = "Corán 2:261";

"discovery.card.rabbana_forgive.title" = "No nos tomes en cuenta si olvidamos";
"discovery.card.rabbana_forgive.meaning" = "Allah dice: “Señor nuestro, no nos tomes en cuenta si olvidamos o erramos. Señor nuestro, no nos impongas una carga como la que impusiste a quienes nos precedieron.”";
"discovery.card.rabbana_forgive.source" = "Corán 2:286";

"discovery.card.establish_salah.title" = "Estableced la oración y dad el zakat";
"discovery.card.establish_salah.meaning" = "Allah dice: “Estableced la oración, dad el zakat e inclinaos con los que se inclinan.”";
"discovery.card.establish_salah.source" = "Corán 2:43";

"discovery.card.way_out.title" = "Quien tenga taqwa, Allah le abrirá una salida";
"discovery.card.way_out.meaning" = "Allah dice: “Quien tenga temor de Allah — Él le abrirá una salida, y le proveerá de donde no espera.”";
"discovery.card.way_out.source" = "Corán 65:2–3";

"discovery.card.sincere_deen.title" = "Adorar a Allah con religión sincera";
"discovery.card.sincere_deen.meaning" = "Allah dice: “No se les ordenó sino adorar a Allah, rindiéndole una religión sincera, inclinados a la verdad, establecer la oración y dar el zakat.”";
"discovery.card.sincere_deen.source" = "Corán 98:5";

"discovery.card.allah_light.title" = "Allah es la Luz de los cielos y la tierra";
"discovery.card.allah_light.meaning" = "Allah dice: “Allah es la Luz de los cielos y la tierra.”";
"discovery.card.allah_light.source" = "Corán 24:35";

"discovery.card.expand_chest.title" = "¿No te hemos ensanchado el pecho?";
"discovery.card.expand_chest.meaning" = "Allah dice: “¿No te hemos ensanchado el pecho, y quitado de ti tu carga que pesaba sobre tu espalda, y elevado tu mención?”";
"discovery.card.expand_chest.source" = "Corán 94:1–4";

"discovery.card.hikmah.title" = "Da la sabiduría a quien Él quiere";
"discovery.card.hikmah.meaning" = "Allah dice: “Da la sabiduría a quien Él quiere, y a quien se le da la sabiduría se le ha dado un gran bien.”";
"discovery.card.hikmah.source" = "Corán 2:269";

"discovery.card.five_pillars.title" = "El islam se basa en cinco";
"discovery.card.five_pillars.meaning" = "El Profeta ﷺ dijo: “El islam se basa en cinco: el testimonio de que no hay dios sino Allah y que Muhammad es el Mensajero de Allah, establecer la oración, dar el zakat, el Hayy y ayunar Ramadán.”";
"discovery.card.five_pillars.source" = "Sahih al-Bukhari 8 · Sahih Muslim 16";

"discovery.card.muslim_tongue.title" = "A salvo de su lengua y su mano";
"discovery.card.muslim_tongue.meaning" = "El Profeta ﷺ dijo: “El musulmán es aquel de cuya lengua y cuya mano están a salvo los musulmanes.”";
"discovery.card.muslim_tongue.source" = "Sahih al-Bukhari 10 · Sahih Muslim 41";

"discovery.card.deen_nasihah.title" = "La religión es el consejo sincero";
"discovery.card.deen_nasihah.meaning" = "El Profeta ﷺ dijo: “La religión es la nasiha (consejo sincero).” Dijeron: ¿A quién? Dijo: “A Allah, a Su Libro, a Su Mensajero, a los líderes de los musulmanes y a su gente común.”";
"discovery.card.deen_nasihah.source" = "Sahih Muslim 55";

"discovery.card.best_quran.title" = "Los mejores de vosotros aprenden y enseñan el Corán";
"discovery.card.best_quran.meaning" = "El Profeta ﷺ dijo: “Los mejores de vosotros son quienes aprenden el Corán y lo enseñan.”";
"discovery.card.best_quran.source" = "Sahih al-Bukhari 5027";

"discovery.card.mother_first.title" = "Tu madre, luego tu madre";
"discovery.card.mother_first.meaning" = "Un hombre preguntó: ¿Quién es más merecedor de mi buen trato? El Profeta ﷺ dijo: “Tu madre.” Dijo: ¿Luego quién? Dijo: “Tu madre.” Dijo: ¿Luego quién? Dijo: “Tu madre.” Dijo: ¿Luego quién? Dijo: “Tu padre.”";
"discovery.card.mother_first.source" = "Sahih al-Bukhari 5971 · Sahih Muslim 2548";

"discovery.card.plant_tree.title" = "Un árbol plantado es caridad";
"discovery.card.plant_tree.meaning" = "El Profeta ﷺ dijo: “Jamás planta un musulmán un árbol o siembra un cultivo, y come de ello un ave, un ser humano o un animal, sino que es caridad para él.”";
"discovery.card.plant_tree.source" = "Sahih Muslim 1553";

"discovery.card.seven_shade.title" = "Siete a la sombra de Allah";
"discovery.card.seven_shade.meaning" = "El Profeta ﷺ dijo: “Siete serán cubiertos por la sombra de Allah el Día en que no haya sombra sino la Suya: un gobernante justo; un joven que creció en la adoración de Allah; un hombre cuyo corazón está apegado a la mezquita; dos que se aman por Allah; un hombre a quien invita una mujer de rango y belleza y dice: ‘Temo a Allah’; quien da caridad tan en secreto que su izquierda no sabe lo que gasta su derecha; y quien recuerda a Allah en privado y se le llenan los ojos.”";
"discovery.card.seven_shade.source" = "Sahih al-Bukhari 1423 · Sahih Muslim 1031";

"discovery.card.tasbih_salah.title" = "Después de la oración: 33, 33, 34";
"discovery.card.tasbih_salah.meaning" = "El Profeta ﷺ enseñó después de la salah: Subhan Allah treinta y tres veces, al-hamdu lillah treinta y tres, y Allahu akbar treinta y cuatro.";
"discovery.card.tasbih_salah.source" = "Sahih Muslim 596";

"discovery.card.hundred_tasbih.title" = "Cien veces al día";
"discovery.card.hundred_tasbih.meaning" = "El Profeta ﷺ dijo: “Quien dice ‘Gloria a Allah y a Él la alabanza’ cien veces al día, se le perdonan sus pecados aunque sean como la espuma del mar.”";
"discovery.card.hundred_tasbih.source" = "Sahih al-Bukhari 6405 · Sahih Muslim 2691";

"discovery.card.enter_masjid.title" = "Cuando entres en la mezquita";
"discovery.card.enter_masjid.meaning" = "El Profeta ﷺ dijo: cuando uno de vosotros entre en la mezquita, que diga: “Oh Allah, ábreme las puertas de Tu misericordia.”";
"discovery.card.enter_masjid.source" = "Sahih Muslim 713";

"discovery.card.do_not_anger.title" = "No te enfades";
"discovery.card.do_not_anger.meaning" = "Un hombre dijo al Profeta ﷺ: Aconséjame. Dijo: “No te enfades.” El hombre repitió su petición varias veces, y él dijo: “No te enfades.”";
"discovery.card.do_not_anger.source" = "Sahih al-Bukhari 6116";

"discovery.card.make_easy.title" = "Facilitad las cosas";
"discovery.card.make_easy.meaning" = "El Profeta ﷺ dijo: “Facilitad y no dificultéis. Dad buenas nuevas y no ahuyentéis.”";
"discovery.card.make_easy.source" = "Sahih al-Bukhari 69";

"discovery.card.religion_ease.title" = "La religión es facilidad";
"discovery.card.religion_ease.meaning" = "El Profeta ﷺ dijo: “La religión es facilidad. Nadie la endurece contra sí mismo sino que ella le vence. Sed moderados, dad lo mejor, alegraos, y pedid ayuda por la mañana, por la tarde y un poco por la noche.”";
"discovery.card.religion_ease.source" = "Sahih al-Bukhari 39";

"discovery.card.feed_hungry.title" = "Alimenta al hambriento";
"discovery.card.feed_hungry.meaning" = "El Profeta ﷺ dijo: “Alimentad al hambriento, visitad al enfermo y liberad al cautivo.”";
"discovery.card.feed_hungry.source" = "Sahih al-Bukhari 5373";

"discovery.card.good_word.title" = "Una palabra buena es caridad";
"discovery.card.good_word.meaning" = "El Profeta ﷺ dijo: “Una palabra buena es caridad.”";
"discovery.card.good_word.source" = "Sahih al-Bukhari 2989 · Sahih Muslim 1009";

"discovery.card.no_cheating.title" = "Quien engaña no es de los nuestros";
"discovery.card.no_cheating.meaning" = "El Profeta ﷺ dijo: “Quien nos engaña no es de los nuestros.”";
"discovery.card.no_cheating.source" = "Sahih Muslim 102";

"discovery.card.sleep_muawwidhat.title" = "Recita las tres últimas suras antes de dormir";
"discovery.card.sleep_muawwidhat.meaning" = "Aisha relató que cuando el Profeta ﷺ se iba a acostar, juntaba las manos, soplaba en ellas, recitaba al-Ijlas, al-Falaq y an-Nas, y luego se pasaba las manos por el cuerpo.";
"discovery.card.sleep_muawwidhat.source" = "Sahih al-Bukhari 5017";

"discovery.card.treat_women.title" = "Temed a Allah respecto a las mujeres";
"discovery.card.treat_women.meaning" = "El Profeta ﷺ dijo en el Sermón de Despedida: “Temed a Allah respecto a las mujeres, pues las habéis tomado como un depósito de Allah, y se os ha hecho lícima la intimidad con ellas por la palabra de Allah.”";
"discovery.card.treat_women.source" = "Sahih Muslim 1218";

"discovery.card.wudu_sins.title" = "El wudu lava los pecados";
"discovery.card.wudu_sins.meaning" = "El Profeta ﷺ dijo: cuando un musulmán — o un creyente — hace wudu y lava su rostro, sale con el agua todo pecado que miró con sus ojos, o con la última gota; cuando lava sus manos, salen los pecados de sus manos; cuando lava sus pies, salen los pecados a los que caminaron sus pies — hasta que sale limpio de pecado.";
"discovery.card.wudu_sins.source" = "Sahih Muslim 244";

/* BEGIN DISCOVERY EXPANSION */
"discovery.card.ayah_1_1.title" = "Al-Faatiha 1";
"discovery.card.ayah_1_1.meaning" = "En el nombre de Dios, el Compasivo con toda la creación, el Misericordioso con los creyentes.";
"discovery.card.ayah_1_1.source" = "Qur’an 1:1";

"discovery.card.ayah_1_4.title" = "Al-Faatiha 4";
"discovery.card.ayah_1_4.meaning" = "Soberano absoluto del Día del Juicio Final,";
"discovery.card.ayah_1_4.source" = "Qur’an 1:4";

"discovery.card.ayah_1_5.title" = "Al-Faatiha 5";
"discovery.card.ayah_1_5.meaning" = "solo a Ti te adoramos y solo de Ti imploramos ayuda.";
"discovery.card.ayah_1_5.source" = "Qur’an 1:5";

"discovery.card.ayah_1_6.title" = "Al-Faatiha 6";
"discovery.card.ayah_1_6.meaning" = "¡Guíanos por el camino recto!";
"discovery.card.ayah_1_6.source" = "Qur’an 1:6";

"discovery.card.ayah_1_7.title" = "Al-Faatiha 7";
"discovery.card.ayah_1_7.meaning" = "El camino de los que has colmado con Tus favores, no el de los que cayeron en Tu ira, ni el de los que se extraviaron.";
"discovery.card.ayah_1_7.source" = "Qur’an 1:7";

"discovery.card.ayah_2_2.title" = "Al-Baqara 2";
"discovery.card.ayah_2_2.meaning" = "Este es el Libro del cual no hay duda, es guía para los que son conscientes de Dios y e temen devocionalmente,";
"discovery.card.ayah_2_2.source" = "Qur’an 2:2";

"discovery.card.ayah_2_21.title" = "Al-Baqara 21";
"discovery.card.ayah_2_21.meaning" = "¡Oh, seres humanos! Adoren a su Señor que los creó a ustedes y a quienes los precedieron, para que así alcancen el temor devocional de Dios.";
"discovery.card.ayah_2_21.source" = "Qur’an 2:21";

"discovery.card.ayah_2_45.title" = "Al-Baqara 45";
"discovery.card.ayah_2_45.meaning" = "Busquen socorro en la paciencia y la oración. El cumplimiento de la oración es difícil, excepto para los que se someten humildemente [a Dios];";
"discovery.card.ayah_2_45.source" = "Qur’an 2:45";

"discovery.card.ayah_2_155.title" = "Al-Baqara 155";
"discovery.card.ayah_2_155.meaning" = "Los pondremos a prueba con algo de temor, hambre, pérdida de bienes materiales, vidas y frutos, pero albricia a los pacientes.";
"discovery.card.ayah_2_155.source" = "Qur’an 2:155";

"discovery.card.ayah_2_165.title" = "Al-Baqara 165";
"discovery.card.ayah_2_165.meaning" = "Existen personas que toman en lugar de Dios a otros que consideran iguales [a Dios], y los aman como solo debe amarse a Dios; pero los creyentes aman más a Dios [de lo que éstos aman a sus divinidades]. Ya sabrán los injustos cuando vean el suplicio que les espera, que a Dios pertenece el poder absoluto y que Dios es severo en el castigo.";
"discovery.card.ayah_2_165.source" = "Qur’an 2:165";

"discovery.card.ayah_2_177.title" = "Al-Baqara 177";
"discovery.card.ayah_2_177.meaning" = "La verdadera virtud no consiste en orientarse hacia el oriente o el occidente [durante la oración], sino que es piadoso quien cree en Dios, el Día del Juicio, los ángeles, el Libro, los Profetas, hace caridad a pesar del apego [que tiene por los bienes materiales] a los parientes, los huérfanos, los pobres, los viajeros insolventes, los mendigos, y colabora para liberar esclavos y cautivos. [Tiene piedad quien] hace la oración prescrita, paga el zakat, cumple con los compromisos contraídos, es paciente en la estrechez, la adversidad y ante la persecución. Ésos son los veraces en su fe y los verdaderos piadosos.";
"discovery.card.ayah_2_177.source" = "Qur’an 2:177";

"discovery.card.ayah_2_185.title" = "Al-Baqara 185";
"discovery.card.ayah_2_185.meaning" = "En el mes de Ramadán fue revelado el Corán como guía para la humanidad y evidencia de la guía y el criterio. Quien presencie la llegada de [la Luna nueva de] el mes deberá ayunar, pero quien esté enfermo o de viaje [y no ayune] deberá reponer posteriormente los días no ayunados y así completar el mes. Dios desea facilitarles las cosas y no dificultárselas; alaben y agradezcan a Dios por haberlos guiado.";
"discovery.card.ayah_2_185.source" = "Qur’an 2:185";

"discovery.card.ayah_2_197.title" = "Al-Baqara 197";
"discovery.card.ayah_2_197.meaning" = "La peregrinación se realiza en unos meses específicos, y quien se consagrara para hacerla, deberá abstenerse [durante ella] de las relaciones maritales, los pecados y las discusiones. Todo lo que hagan de bien Dios lo sabe. Tomen provisiones para el viaje, pero [sepan que] la mejor provisión es la piedad. ¡Oh, dotados de buen discernimiento! Cumplan correctamente Conmigo.";
"discovery.card.ayah_2_197.source" = "Qur’an 2:197";

"discovery.card.ayah_2_208.title" = "Al-Baqara 208";
"discovery.card.ayah_2_208.meaning" = "¡Oh, creyentes! Entréguense por completo [a Dios practicando el Islam] y no sigan los pasos del demonio, porque él es su enemigo declarado.";
"discovery.card.ayah_2_208.source" = "Qur’an 2:208";

"discovery.card.ayah_2_216.title" = "Al-Baqara 216";
"discovery.card.ayah_2_216.meaning" = "Se les ha prescrito combatir aunque les desagrade. Es posible que les disguste algo y sea un bien para ustedes, y es posible que amen algo y sea un mal para ustedes. Dios conoce [todo] pero ustedes no.";
"discovery.card.ayah_2_216.source" = "Qur’an 2:216";

"discovery.card.ayah_2_245.title" = "Al-Baqara 245";
"discovery.card.ayah_2_245.meaning" = "¿Quién hará a Dios un préstamo generoso? Dios se lo devolverá multiplicado. Dios restringe y prodiga [el sustento], y a Él volverán [para ser recompensados por sus acciones].";
"discovery.card.ayah_2_245.source" = "Qur’an 2:245";

"discovery.card.ayah_2_254.title" = "Al-Baqara 254";
"discovery.card.ayah_2_254.meaning" = "¡Oh, creyentes! Den en caridad parte de los beneficios que les he otorgado antes de que llegue el día en el cual no se aceptará rescate, amistad ni intercesión. Los [verdaderos] injustos son los que rechazan la verdad.";
"discovery.card.ayah_2_254.source" = "Qur’an 2:254";

"discovery.card.ayah_2_267.title" = "Al-Baqara 267";
"discovery.card.ayah_2_267.meaning" = "¡Oh, creyentes! Den en caridad de las cosas buenas que hayan adquirido y [también] de lo que les he hecho brotar de la tierra, pero no elijan lo deteriorado para dar caridad así como tampoco lo tomarían para ustedes mismos, salvo que fuera con los ojos cerrados. Sepan que Dios es Opulento, Loable.";
"discovery.card.ayah_2_267.source" = "Qur’an 2:267";

"discovery.card.ayah_2_285.title" = "Al-Baqara 285";
"discovery.card.ayah_2_285.meaning" = "El Mensajero y sus seguidores creen en lo que le fue revelado por su Señor [al Mensajero]. Todos creen en Dios, en Sus ángeles, en Sus Libros y en Sus Mensajeros [diciendo:] \"No hacemos diferencia entre ninguno de Sus Mensajeros\". Y dicen: \"Oímos y obedecemos. Perdónanos Señor nuestro, que ante Ti retornaremos [para ser juzgados]\".";
"discovery.card.ayah_2_285.source" = "Qur’an 2:285";

"discovery.card.ayah_3_8.title" = "Aal-i-Imraan 8";
"discovery.card.ayah_3_8.meaning" = "¡Señor nuestro! No permitas que nuestros corazones se desvíen después de habernos guiado. Concédenos Tu misericordia, Tú eres el Dadivoso.";
"discovery.card.ayah_3_8.source" = "Qur’an 3:8";

"discovery.card.ayah_3_26.title" = "Aal-i-Imraan 26";
"discovery.card.ayah_3_26.meaning" = "Di: \"¡Oh, Dios, Soberano Absoluto! Tú concedes el poder a quien quieres y se lo quitas a quien quieres, fortaleces a quien quieres y humillas a quien quieres. Todo el bien descansa en Tus manos. Tú tienes poder sobre todas las cosas.";
"discovery.card.ayah_3_26.source" = "Qur’an 3:26";

"discovery.card.ayah_3_31.title" = "Aal-i-Imraan 31";
"discovery.card.ayah_3_31.meaning" = "Di: \"Si verdaderamente aman a Dios, ¡síganme!, que Dios los amará y perdonará sus pecados\". Dios es Absolvedor, Misericordioso.";
"discovery.card.ayah_3_31.source" = "Qur’an 3:31";

"discovery.card.ayah_3_92.title" = "Aal-i-Imraan 92";
"discovery.card.ayah_3_92.meaning" = "[Los creyentes] no alcanzarán la piedad auténtica hasta que den [en caridad] lo que más aman. Todo lo que den en caridad Dios lo sabe.";
"discovery.card.ayah_3_92.source" = "Qur’an 3:92";

"discovery.card.ayah_3_102.title" = "Aal-i-Imraan 102";
"discovery.card.ayah_3_102.meaning" = "¡Oh, creyentes! Tengan temor de Dios como es debido, y no mueran sino como creyentes monoteístas.";
"discovery.card.ayah_3_102.source" = "Qur’an 3:102";

"discovery.card.ayah_3_103.title" = "Aal-i-Imraan 103";
"discovery.card.ayah_3_103.meaning" = "Aférrense todos a la religión de Dios y no se dividan en sectas. Recuerden la gracia de Dios cuando los hermanó uniendo sus corazones siendo que eran rivales unos de otros, y cuando se encontraban al borde de un abismo de fuego, los salvó de caer en él. Así les explica Dios Sus signos para que sigan la verdadera guía.";
"discovery.card.ayah_3_103.source" = "Qur’an 3:103";

"discovery.card.ayah_3_110.title" = "Aal-i-Imraan 110";
"discovery.card.ayah_3_110.meaning" = "[¡Musulmanes!] Son la mejor nación que haya surgido de la humanidad porque ordenan el bien, prohíben el mal y creen en Dios. Si la Gente del Libro creyera, sería mejor para ellos; algunos de ellos son creyentes, pero la mayoría son desviados.";
"discovery.card.ayah_3_110.source" = "Qur’an 3:110";

"discovery.card.ayah_3_133.title" = "Aal-i-Imraan 133";
"discovery.card.ayah_3_133.meaning" = "Y apresúrense a buscar el perdón de su Señor y un Paraíso tan vasto como los cielos y la Tierra, que ha sido reservado para los que tienen consciencia de Dios [y cumplen la ley],";
"discovery.card.ayah_3_133.source" = "Qur’an 3:133";

"discovery.card.ayah_3_139.title" = "Aal-i-Imraan 139";
"discovery.card.ayah_3_139.meaning" = "No se desanimen ni entristezcan, porque los que obtendrán el éxito finalmente serán los creyentes.";
"discovery.card.ayah_3_139.source" = "Qur’an 3:139";

"discovery.card.ayah_3_159.title" = "Aal-i-Imraan 159";
"discovery.card.ayah_3_159.meaning" = "[Oh, Mujámmad] Por misericordia de Dios eres compasivo con ellos. Si hubieras sido rudo y de corazón duro se habrían alejado de ti; perdónalos, pide perdón por ellos, y consulta con ellos los asuntos [de interés público]. Pero cuando hayas tomado una decisión encomiéndate a Dios, porque Dios ama a los que se encomiendan a Él.";
"discovery.card.ayah_3_159.source" = "Qur’an 3:159";

"discovery.card.ayah_3_185.title" = "Aal-i-Imraan 185";
"discovery.card.ayah_3_185.meaning" = "Todo ser probará el sabor de la muerte, y cada uno recibirá su recompensa íntegra el Día de la Resurrección. Quien sea salvado del Fuego e ingresado al Paraíso habrá realmente triunfado, porque la vida mundanal es solo un placer ilusorio.";
"discovery.card.ayah_3_185.source" = "Qur’an 3:185";

"discovery.card.ayah_3_190.title" = "Aal-i-Imraan 190";
"discovery.card.ayah_3_190.meaning" = "En la creación de los cielos y de la Tierra, y en la sucesión de la noche y el día, hay signos para los dotados de intelecto,";
"discovery.card.ayah_3_190.source" = "Qur’an 3:190";

"discovery.card.ayah_3_200.title" = "Aal-i-Imraan 200";
"discovery.card.ayah_3_200.meaning" = "¡Oh, creyentes! Tengan paciencia, perseverancia, defiéndanse y tengan temor de Dios, que así tendrán éxito.";
"discovery.card.ayah_3_200.source" = "Qur’an 3:200";

"discovery.card.ayah_4_1.title" = "An-Nisaa 1";
"discovery.card.ayah_4_1.meaning" = "¡Oh, seres humanos! Tengan temor de su Señor, Quien los ha creado de un solo ser, del que creó a su cónyuge e hizo descender de ambos muchos hombres y mujeres. Tengan temor de Dios, en Cuyo nombre se reclaman sus derechos, y respeten los lazos familiares. Dios los observa.";
"discovery.card.ayah_4_1.source" = "Qur’an 4:1";

"discovery.card.ayah_4_29.title" = "An-Nisaa 29";
"discovery.card.ayah_4_29.meaning" = "¡Oh, creyentes! No estafen ni usurpen injustamente, sino que comercien de mutuo acuerdo. No se maten a ustedes mismos. Dios es Misericordioso con ustedes.";
"discovery.card.ayah_4_29.source" = "Qur’an 4:29";

"discovery.card.ayah_4_36.title" = "An-Nisaa 36";
"discovery.card.ayah_4_36.meaning" = "Adoren solamente a Dios y no dediquen actos de adoración a otros. Hagan el bien a sus padres, a sus familiares, a los huérfanos, a los pobres, a los vecinos parientes y no parientes, al compañero, al viajero insolvente y a quienes están a su servicio. Dios no ama a quien se comporta como un arrogante jactancioso.";
"discovery.card.ayah_4_36.source" = "Qur’an 4:36";

"discovery.card.ayah_4_40.title" = "An-Nisaa 40";
"discovery.card.ayah_4_40.meaning" = "Dios no es injusto con nadie ni en el peso de la más ínfima partícula. Por el contrario, retribuye generosamente toda obra de bien, y concede de Su parte una recompensa magnánima.";
"discovery.card.ayah_4_40.source" = "Qur’an 4:40";

"discovery.card.ayah_4_59.title" = "An-Nisaa 59";
"discovery.card.ayah_4_59.meaning" = "¡Oh, creyentes! Obedezcan a Dios, obedezcan al Mensajero y a aquellos de ustedes que tengan autoridad y conocimiento. Si realmente creen en Dios y en el Día del Juicio, cuando tengan discrepancias remítanlas al juicio de Dios y del Mensajero, porque en ello hay bien y es el camino correcto.";
"discovery.card.ayah_4_59.source" = "Qur’an 4:59";

"discovery.card.ayah_4_69.title" = "An-Nisaa 69";
"discovery.card.ayah_4_69.meaning" = "Los que obedezcan a Dios y al Mensajero estarán con los bienaventurados: los Profetas, los veraces, los que murieron dando testimonio [de su fe] y los justos. ¡Qué excelentes compañeros!";
"discovery.card.ayah_4_69.source" = "Qur’an 4:69";

"discovery.card.ayah_4_86.title" = "An-Nisaa 86";
"discovery.card.ayah_4_86.meaning" = "Si los saludan respondan con un saludo igual o mejor. Dios tiene en cuenta todas las cosas.";
"discovery.card.ayah_4_86.source" = "Qur’an 4:86";

"discovery.card.ayah_4_103.title" = "An-Nisaa 103";
"discovery.card.ayah_4_103.meaning" = "Cuando hayan terminado la oración recuerden a Dios de pie, sentados o recostados. Y cuando estén fuera de peligro hagan la oración [normalmente]. La oración ha sido prescrita a los creyentes para ser realizada en horarios específicos.";
"discovery.card.ayah_4_103.source" = "Qur’an 4:103";

"discovery.card.ayah_4_174.title" = "An-Nisaa 174";
"discovery.card.ayah_4_174.meaning" = "¡Oh, seres humanos! Les ha llegado una prueba de su Señor [el Profeta], y les he hecho descender una luz que ilumina [el Corán].";
"discovery.card.ayah_4_174.source" = "Qur’an 4:174";

"discovery.card.ayah_5_2.title" = "Al-Maaida 2";
"discovery.card.ayah_5_2.meaning" = "¡Oh, creyentes! No profanen los ritos de Dios ni los meses sagrados ni los animales ofrendados ni los animales marcados para ofrenda ni perjudiquen a quienes se dirigen a la Casa Sagrada buscando el favor y la complacencia de su Señor. [Solo] cuando hayan finalizado la peregrinación podrán cazar. Que el descontento que tengan hacia quienes les impedían el acceso a la Mezquita Sagrada no los lleve a transgredir [la ley], sino que cooperen con ellos a obrar el bien e impedir el mal, pero no cooperen en el pecado y la enemistad. Y tengan temor de Dios; Dios es severo en el castigo.";
"discovery.card.ayah_5_2.source" = "Qur’an 5:2";

"discovery.card.ayah_5_3.title" = "Al-Maaida 3";
"discovery.card.ayah_5_3.meaning" = "Les es prohibido [comer] la carne del animal muerto por causa natural, la sangre, la carne de cerdo, el animal que haya sido sacrificado invocando otro en lugar de Dios, la del animal muerto por asfixia, golpe, caída, cornada o herido por las fieras, a menos que alcancen a degollarlo [antes de que muera], y lo que es inmolado en altares [en honor a un ídolo]. [También es prohibido] consultar la suerte echando flechas. [Violar alguna de estas leyes] es un pecado. Quienes se empeñan en negar la verdad han perdido la esperanza de [hacerlos renunciar a] su religión. No tengan temor de ellos, sino que tengan temor de Mí. Hoy les he perfeccionado su forma de adoración, he completado Mi gracia sobre ustedes y he dispuesto que el Islam sea su religión. Pero quien, [en caso extremo] por hambre, se vea forzado [y coma de lo prohibido] pero sin intención de transgredir la ley ni excederse, Dios es Perdonador, Misericordioso.";
"discovery.card.ayah_5_3.source" = "Qur’an 5:3";

"discovery.card.ayah_5_6.title" = "Al-Maaida 6";
"discovery.card.ayah_5_6.meaning" = "¡Oh, creyentes! Cuando se dispongan a hacer la oración lávense el rostro y los brazos hasta los codos, pasen las manos [húmedas] por la cabeza y [laven] los pies hasta los tobillos. Si están en estado de impureza mayor, tomen un baño [completo]. Si están enfermos o de viaje o han hecho sus necesidades [biológicas] o han cohabitado con su mujer y no encuentran agua, usen [para la ablución virtual] tierra limpia y pásenla por el rostro y las manos. Dios no quiere imponerles dificultades, solo quiere purificarlos y completar Su favor sobre ustedes para que sean agradecidos.";
"discovery.card.ayah_5_6.source" = "Qur’an 5:6";

"discovery.card.ayah_5_8.title" = "Al-Maaida 8";
"discovery.card.ayah_5_8.meaning" = "¡Oh, creyentes! Sean responsables con [los preceptos de] Dios. Sean justos cuando den testimonio. Que el rencor que sienten no les conduzca a obrar injustamente. Sean justos y equitativos, porque eso es lo más cercano a la piedad. Y tengan temor de Dios, porque Dios está bien informado de lo que hacen.";
"discovery.card.ayah_5_8.source" = "Qur’an 5:8";

"discovery.card.ayah_5_32.title" = "Al-Maaida 32";
"discovery.card.ayah_5_32.meaning" = "Como consecuencia [de este asesinato], legislé para los Hijos de Israel que: \"Quien mata a una persona sin que ésta haya cometido un crimen o sembrado la corrupción en la Tierra, es como si matase a toda la humanidad. Pero quien salva una vida es como si salvase a toda la humanidad\". Mis Mensajeros se presentaron ante ellos con pruebas claras [de la ley], pero muchos de ellos siguen cometiendo graves excesos en el mundo.";
"discovery.card.ayah_5_32.source" = "Qur’an 5:32";

"discovery.card.ayah_5_35.title" = "Al-Maaida 35";
"discovery.card.ayah_5_35.meaning" = "¡Oh, creyentes! Tengan temor de Dios, busquen acercarse a Él [realizando obras de bien] y luchen por Su causa, que así tendrán éxito.";
"discovery.card.ayah_5_35.source" = "Qur’an 5:35";

"discovery.card.ayah_5_54.title" = "Al-Maaida 54";
"discovery.card.ayah_5_54.meaning" = "¡Oh, creyentes! Si apostatan de su religión, Dios los suplantará por otros a quienes amará y ellos Lo amarán, que serán compasivos con los creyentes, severos con los que niegan la verdad, y combatirán por la causa de Dios sin temor a los reproches. Esas son las cualidades de quienes Dios ha bendecido. Dios es Vasto, todo lo sabe.";
"discovery.card.ayah_5_54.source" = "Qur’an 5:54";

"discovery.card.ayah_5_119.title" = "Al-Maaida 119";
"discovery.card.ayah_5_119.meaning" = "Dios dirá [el Día del Juicio]: \"Este es el día en que los sinceros disfrutarán su sinceridad. Tendrán jardines por donde corren ríos, en los que estarán por toda la eternidad. Dios estará complacido de ellos y ellos con Él. Esa será la bienaventuranza.";
"discovery.card.ayah_5_119.source" = "Qur’an 5:119";

"discovery.card.ayah_6_17.title" = "Al-An'aam 17";
"discovery.card.ayah_6_17.meaning" = "Si Dios te aflige con una desgracia, nadie excepto Él podrá librarte de ella. Pero si te agracia con una bendición, Él tiene poder sobre todas las cosas.";
"discovery.card.ayah_6_17.source" = "Qur’an 6:17";

"discovery.card.ayah_6_54.title" = "Al-An'aam 54";
"discovery.card.ayah_6_54.meaning" = "Cuando se presenten ante ti aquellos que creen en Mis signos, diles: \"¡La paz sea con ustedes! Su Señor ha prescrito para Sí mismo la misericordia. Quien cometa una falta por ignorancia, y luego se arrepienta y enmiende, sepa que Dios es Absolvedor, Misericordioso.";
"discovery.card.ayah_6_54.source" = "Qur’an 6:54";

"discovery.card.ayah_6_125.title" = "Al-An'aam 125";
"discovery.card.ayah_6_125.meaning" = "A quien Dios quiere guiar le abre el corazón para que acepte el Islam. En cambio, a quien Él quiere extraviar le oprime fuertemente el pecho como si subiera a un lugar muy elevado. Así es como Dios humilla a quienes se niegan a creer.";
"discovery.card.ayah_6_125.source" = "Qur’an 6:125";

"discovery.card.ayah_6_151.title" = "Al-An'aam 151";
"discovery.card.ayah_6_151.meaning" = "Diles: \"Vengan, que les informaré lo que su Señor les ha prohibido: No deben asociarle nada, deben hacer el bien a sus padres, no matarán a sus hijos por temor a la pobreza, Yo me encargo de su sustento y el de ellos, no deben acercarse al pecado, ni en público ni en privado, y no matarán a nadie que Dios prohibió matar, salvo que sea con justo derecho. Esto es lo que les ha ordenado para que usen el razonamiento.";
"discovery.card.ayah_6_151.source" = "Qur’an 6:151";

"discovery.card.ayah_6_162.title" = "Al-An'aam 162";
"discovery.card.ayah_6_162.meaning" = "Diles: \"Mi oración, mi ofrenda, mi vida y mi muerte pertenecen a Dios, Señor del universo,";
"discovery.card.ayah_6_162.source" = "Qur’an 6:162";

"discovery.card.ayah_7_23.title" = "Al-A'raaf 23";
"discovery.card.ayah_7_23.meaning" = "Ellos dijeron [arrepentidos]: \"¡Señor nuestro! Hemos sido injustos con nosotros mismos; si no nos perdonas y nos tienes misericordia, seremos de los perdidos\".";
"discovery.card.ayah_7_23.source" = "Qur’an 7:23";

"discovery.card.ayah_7_31.title" = "Al-A'raaf 31";
"discovery.card.ayah_7_31.meaning" = "¡Oh, hijos de Adán! Vistan con elegancia cuando acudan a las mezquitas. Coman y beban con mesura, porque Dios no ama a los derrochadores.";
"discovery.card.ayah_7_31.source" = "Qur’an 7:31";

"discovery.card.ayah_7_56.title" = "Al-A'raaf 56";
"discovery.card.ayah_7_56.meaning" = "No siembren corrupción en la Tierra después de que se haya establecido en ella el orden, e invóquenlo con temor y esperanza. La misericordia de Dios está cerca de los que hacen el bien.";
"discovery.card.ayah_7_56.source" = "Qur’an 7:56";

"discovery.card.ayah_7_128.title" = "Al-A'raaf 128";
"discovery.card.ayah_7_128.meaning" = "Moisés dijo a su pueblo: \"Busquen la ayuda de Dios y sean pacientes [ante esta prueba]. La Tierra es de Dios, y la dará en herencia a quien quiera de Sus siervos. El buen fin es para los que tienen temor [de Dios]\".";
"discovery.card.ayah_7_128.source" = "Qur’an 7:128";

"discovery.card.ayah_7_199.title" = "Al-A'raaf 199";
"discovery.card.ayah_7_199.meaning" = "[¡Oh, Mujámmad!] Ante todo, elige perdonar, ordena el bien y apártate de quienes se comportan contigo en forma ignorante.";
"discovery.card.ayah_7_199.source" = "Qur’an 7:199";

"discovery.card.ayah_7_204.title" = "Al-A'raaf 204";
"discovery.card.ayah_7_204.meaning" = "Cuando el Corán sea leído, escúchenlo con atención y guarden silencio para que se les tenga misericordia.";
"discovery.card.ayah_7_204.source" = "Qur’an 7:204";

"discovery.card.ayah_8_2.title" = "Al-Anfaal 2";
"discovery.card.ayah_8_2.meaning" = "Los creyentes son aquellos que cuando les es mencionado el nombre de Dios sus corazones se estremecen, y que cuando les son recitados Sus versículos les aumenta la fe y se encomiendan a su Señor.";
"discovery.card.ayah_8_2.source" = "Qur’an 8:2";

"discovery.card.ayah_8_29.title" = "Al-Anfaal 29";
"discovery.card.ayah_8_29.meaning" = "¡Oh, creyentes! Si tienen temor de Dios, Él les concederá el criterio, perdonará sus faltas y aceptará su arrepentimiento. Dios es el dueño de un favor inmenso.";
"discovery.card.ayah_8_29.source" = "Qur’an 8:29";

"discovery.card.ayah_8_46.title" = "Al-Anfaal 46";
"discovery.card.ayah_8_46.meaning" = "Obedezcan a Dios y a Su Mensajero y no discrepen, porque se debilitarían y serían derrotados. Sean pacientes, porque Dios está con los pacientes.";
"discovery.card.ayah_8_46.source" = "Qur’an 8:46";

"discovery.card.ayah_8_61.title" = "Al-Anfaal 61";
"discovery.card.ayah_8_61.meaning" = "Si [los incrédulos] se inclinan por la paz, acéptala tú también y encomiéndate a Dios. Él todo lo oye, todo lo sabe.";
"discovery.card.ayah_8_61.source" = "Qur’an 8:61";

"discovery.card.ayah_9_18.title" = "At-Tawba 18";
"discovery.card.ayah_9_18.meaning" = "Las mezquitas de Dios deben ser construidas y mantenidas por aquellos que creen en Él, en el Día del Juicio, cumplen con la oración, pagan el zakat, y no temen sino a Dios. Porque ellos son los que siguen la guía.";
"discovery.card.ayah_9_18.source" = "Qur’an 9:18";

"discovery.card.ayah_9_40.title" = "At-Tawba 40";
"discovery.card.ayah_9_40.meaning" = "Si no lo socorren [al Mensajero], sepan que Dios [no necesita de ustedes, pues ya] lo auxilió aquella vez que los incrédulos lo expulsaron [de La Meca], cuando estando en la caverna con su compañero [Abu Bakr], le dijo: \"No te entristezcas, pues Dios está con nosotros\". Entonces, Dios hizo descender Su sosiego sobre él [Abu Bakr], los socorrió con un ejército [de ángeles] que ellos no veían, y dispuso que la palabra de los incrédulos se desvaneciera, y que la palabra de Dios sea la que prevalezca. Dios es Poderoso, Sabio.";
"discovery.card.ayah_9_40.source" = "Qur’an 9:40";

"discovery.card.ayah_9_51.title" = "At-Tawba 51";
"discovery.card.ayah_9_51.meaning" = "Diles [¡oh, Mujámmad!]: \"Solo nos sucede lo que Dios decretó para nosotros. Él es nuestro Protector, y a Dios se encomiendan los creyentes\".";
"discovery.card.ayah_9_51.source" = "Qur’an 9:51";

"discovery.card.ayah_9_71.title" = "At-Tawba 71";
"discovery.card.ayah_9_71.meaning" = "Los creyentes y las creyentes son aliados unos de otros, ordenan el bien y prohíben el mal, cumplen con la oración prescrita, pagan el zakat y obedecen a Dios y a Su Mensajero. De ellos Dios tendrá misericordia. Dios es Poderoso, Sabio.";
"discovery.card.ayah_9_71.source" = "Qur’an 9:71";

"discovery.card.ayah_9_103.title" = "At-Tawba 103";
"discovery.card.ayah_9_103.meaning" = "[¡Oh, Mujámmad!] Toma una parte de sus bienes materiales [como zakat] para expurgarles [con ello sus pecados] y purificarlos [de la avaricia], y ruega por ellos, que tus súplicas les transmiten paz. Dios todo lo oye, todo lo sabe.";
"discovery.card.ayah_9_103.source" = "Qur’an 9:103";

"discovery.card.ayah_9_128.title" = "At-Tawba 128";
"discovery.card.ayah_9_128.meaning" = "Se les ha presentado un Mensajero de entre ustedes mismos que se apena por sus adversidades, se preocupa y desea que alcancen el bien [e ingresen al Paraíso]; es compasivo y misericordioso con los creyentes.";
"discovery.card.ayah_9_128.source" = "Qur’an 9:128";

"discovery.card.ayah_10_25.title" = "Yunus 25";
"discovery.card.ayah_10_25.meaning" = "Dios convoca a la morada de la paz y guía a quien quiere por el sendero recto.";
"discovery.card.ayah_10_25.source" = "Qur’an 10:25";

"discovery.card.ayah_10_57.title" = "Yunus 57";
"discovery.card.ayah_10_57.meaning" = "¡Oh, gente! Les ha llegado el Mensaje de su Señor, que es un motivo de reflexión, cura para toda incertidumbre que hubiera en sus corazones, guía y misericordia para los creyentes.";
"discovery.card.ayah_10_57.source" = "Qur’an 10:57";

"discovery.card.ayah_10_62.title" = "Yunus 62";
"discovery.card.ayah_10_62.meaning" = "Los amigos cercanos de Dios no han de temer ni estarán tristes,";
"discovery.card.ayah_10_62.source" = "Qur’an 10:62";

"discovery.card.ayah_10_107.title" = "Yunus 107";
"discovery.card.ayah_10_107.meaning" = "Si Dios te azota con una desgracia, nadie excepto Él podrá librarte de ella. Y si te concede un bien, nadie podrá impedir que te alcance. Dios concede Su gracia a quien quiere de Sus siervos. Él es el Absolvedor, el Misericordioso.";
"discovery.card.ayah_10_107.source" = "Qur’an 10:107";

"discovery.card.ayah_11_88.title" = "Hud 88";
"discovery.card.ayah_11_88.meaning" = "Dijo: \"¡Oh, pueblo mío! Me baso en una prueba evidente de mi Señor, Él me ha proveído un sustento generoso. No iba a prohibir lo que considero lícito para mí mismo. Solo pretendo su bienestar en la medida que pueda, pero mi éxito depende de Dios; a Él me encomiendo y ante Él me arrepiento.";
"discovery.card.ayah_11_88.source" = "Qur’an 11:88";

"discovery.card.ayah_11_114.title" = "Hud 114";
"discovery.card.ayah_11_114.meaning" = "Observa las oraciones prescritas en los dos extremos del día y durante la noche, pues las obras buenas borran las obras malas. Esto es una exhortación para quienes reflexionan.";
"discovery.card.ayah_11_114.source" = "Qur’an 11:114";

"discovery.card.ayah_12_21.title" = "Yusuf 21";
"discovery.card.ayah_12_21.meaning" = "Y luego el egipcio que lo compró le dijo a su mujer: \"Recíbelo honorablemente, podría sernos útil o quizá lo adoptemos como hijo\". Así concedí a José una buena posición en esa tierra, y le enseñé la interpretación de los sueños. La voluntad de Dios siempre prevalece, pero la mayoría de la gente no lo sabe.";
"discovery.card.ayah_12_21.source" = "Qur’an 12:21";

"discovery.card.ayah_12_87.title" = "Yusuf 87";
"discovery.card.ayah_12_87.meaning" = "¡Hijos míos! Vuelvan [a Egipto], averigüen sobre José y su hermano, y no desesperen de la bondad de Dios, pues no desesperan de la bondad de Dios sino los incrédulos\".";
"discovery.card.ayah_12_87.source" = "Qur’an 12:87";

"discovery.card.ayah_12_90.title" = "Yusuf 90";
"discovery.card.ayah_12_90.meaning" = "Dijeron [sorprendidos]: \"¿Eres tú José?\" Respondió: \"Yo soy José y éste es mi hermano [Benjamín]. Dios nos ha agraciado [con el reencuentro]. Quienes tengan temor de Dios y sean pacientes [ante las adversidades], sepan que Dios no dejará de recompensar a los que hacen el bien\".";
"discovery.card.ayah_12_90.source" = "Qur’an 12:90";

"discovery.card.ayah_13_11.title" = "Ar-Ra'd 11";
"discovery.card.ayah_13_11.meaning" = "El [ser humano] tiene [ángeles] guardianes por delante y por detrás, que lo protegen por orden de Dios. Sepan que Dios no cambia la condición de un pueblo hasta que ellos no cambien lo que hay en sí mismos. Pero si Dios decreta el castigo para un pueblo, no existe nada que lo pueda impedir, y no encontrarán fuera de Él protector alguno.";
"discovery.card.ayah_13_11.source" = "Qur’an 13:11";

"discovery.card.ayah_13_28.title" = "Ar-Ra'd 28";
"discovery.card.ayah_13_28.meaning" = "Los corazones de los creyentes se sosiegan con el recuerdo de Dios. ¿Acaso no es con el recuerdo de Dios que se sosiegan los corazones?";
"discovery.card.ayah_13_28.source" = "Qur’an 13:28";

"discovery.card.ayah_14_24.title" = "Ibrahim 24";
"discovery.card.ayah_14_24.meaning" = "¿Por qué no observas el siguiente ejemplo que te propone Dios?: Una palabra buena es como un árbol bondadoso cuya raíz está firme y sus ramas se extienden hacia el cielo,";
"discovery.card.ayah_14_24.source" = "Qur’an 14:24";

"discovery.card.ayah_15_9.title" = "Al-Hijr 9";
"discovery.card.ayah_15_9.meaning" = "Yo he revelado el Corán y Yo soy su custodio.";
"discovery.card.ayah_15_9.source" = "Qur’an 15:9";

"discovery.card.ayah_15_49.title" = "Al-Hijr 49";
"discovery.card.ayah_15_49.meaning" = "Anúnciales a Mis siervos [oh, Mujámmad] que soy el Absolvedor, el Misericordioso,";
"discovery.card.ayah_15_49.source" = "Qur’an 15:49";

"discovery.card.ayah_16_90.title" = "An-Nahl 90";
"discovery.card.ayah_16_90.meaning" = "Dios ordena la justicia, hacer el bien y ayudar a la familia; pero prohíbe la obscenidad, la mala conducta y la opresión. Así los exhorta para que reflexionen.";
"discovery.card.ayah_16_90.source" = "Qur’an 16:90";

"discovery.card.ayah_16_97.title" = "An-Nahl 97";
"discovery.card.ayah_16_97.meaning" = "Al creyente que obre rectamente, sea varón o mujer, le concederé una vida buena y le multiplicaré la recompensa de sus buenas obras.";
"discovery.card.ayah_16_97.source" = "Qur’an 16:97";

"discovery.card.ayah_16_125.title" = "An-Nahl 125";
"discovery.card.ayah_16_125.meaning" = "Convoca al sendero de tu Señor con sabiduría y bellas palabras. Argumenta de la mejor manera. Tu Señor sabe bien quién se extravía de Su camino y quién sigue la guía.";
"discovery.card.ayah_16_125.source" = "Qur’an 16:125";

"discovery.card.ayah_17_9.title" = "Al-Israa 9";
"discovery.card.ayah_17_9.meaning" = "El Corán guía por el sendero más justo y firme, y di a los creyentes que obran rectamente que recibirán una gran recompensa.";
"discovery.card.ayah_17_9.source" = "Qur’an 17:9";

"discovery.card.ayah_17_24.title" = "Al-Israa 24";
"discovery.card.ayah_17_24.meaning" = "Trátenlos con humildad y compasión, y rueguen [por ellos diciendo]: \"¡Oh, Señor mío! Ten misericordia de ellos como ellos la tuvieron conmigo cuando me criaron siendo niño\".";
"discovery.card.ayah_17_24.source" = "Qur’an 17:24";

"discovery.card.ayah_17_26.title" = "Al-Israa 26";
"discovery.card.ayah_17_26.meaning" = "Da a los parientes lo que es su derecho, también al pobre y al viajero insolvente, pero no derroches,";
"discovery.card.ayah_17_26.source" = "Qur’an 17:26";

"discovery.card.ayah_17_32.title" = "Al-Israa 32";
"discovery.card.ayah_17_32.meaning" = "No se acerquen a lo que lleve a la fornicación, pues es una inmoralidad y un mal camino.";
"discovery.card.ayah_17_32.source" = "Qur’an 17:32";

"discovery.card.ayah_17_53.title" = "Al-Israa 53";
"discovery.card.ayah_17_53.meaning" = "Exhorta a Mis siervos a hablar con respeto, porque el demonio quiere sembrar la discordia entre ellos. El demonio es el enemigo declarado del ser humano.";
"discovery.card.ayah_17_53.source" = "Qur’an 17:53";

"discovery.card.ayah_17_70.title" = "Al-Israa 70";
"discovery.card.ayah_17_70.meaning" = "He honrado a los hijos de Adán y les he facilitado los medios para viajar por la tierra y por el mar, les he proveído de todo lo bueno y los he favorecido sobre muchas otras criaturas.";
"discovery.card.ayah_17_70.source" = "Qur’an 17:70";

"discovery.card.ayah_17_80.title" = "Al-Israa 80";
"discovery.card.ayah_17_80.meaning" = "Di: \"¡Señor mío! Concédeme una entrada y una salida dignas [en todos los asuntos de mi vida], y concédeme los medios para lograr el triunfo\".";
"discovery.card.ayah_17_80.source" = "Qur’an 17:80";

"discovery.card.ayah_17_110.title" = "Al-Israa 110";
"discovery.card.ayah_17_110.meaning" = "Diles: \"Ya sea que Lo invoquen diciendo: ¡Oh, Dios!, ¡Oh, Compasivo!, O cualquier otro nombre con el que Le invoquen, Él los oirá. Sepan que Él posee los nombres [y atributos] más sublimes. Cuando realicen una oración moderen su voz en la recitación, no la hagan con voz muy alta ni tampoco en silencio\".";
"discovery.card.ayah_17_110.source" = "Qur’an 17:110";

"discovery.card.ayah_18_10.title" = "Al-Kahf 10";
"discovery.card.ayah_18_10.meaning" = "Recuerda cuando los jóvenes se refugiaron en la caverna y dijeron: \"¡Señor nuestro! Acógenos en Tu misericordia y concédenos que nuestra situación se solucione correctamente\".";
"discovery.card.ayah_18_10.source" = "Qur’an 18:10";

"discovery.card.ayah_18_24.title" = "Al-Kahf 24";
"discovery.card.ayah_18_24.meaning" = "Salvo que agregues: \"¡Si Dios quiere!\" Pero si te olvidas de mencionar a tu Señor, invoca su nombre y reza diciendo: \"Ruego a mi Señor que me guíe a la vía más recta\".";
"discovery.card.ayah_18_24.source" = "Qur’an 18:24";

"discovery.card.ayah_18_46.title" = "Al-Kahf 46";
"discovery.card.ayah_18_46.meaning" = "Los bienes materiales y los hijos son parte de los encantos de la vida mundanal, [que éstos no los hagan olvidar de lo que Dios ha ordenado. Utilicen bien sus riquezas y eduquen correctamente a sus hijos,] pues las obras que a Dios Le complacen son las que perduran y tienen gran recompensa.";
"discovery.card.ayah_18_46.source" = "Qur’an 18:46";

"discovery.card.ayah_18_110.title" = "Al-Kahf 110";
"discovery.card.ayah_18_110.meaning" = "Diles: \"Yo no soy más que un hombre a quien se le ha revelado que solo deben adorar a Dios, su única divinidad. Quien anhele encontrarse con su Señor [y que Él esté complacido], que realice obras piadosas y que no adore a nadie más que a Él\".";
"discovery.card.ayah_18_110.source" = "Qur’an 18:110";

"discovery.card.ayah_19_4.title" = "Maryam 4";
"discovery.card.ayah_19_4.meaning" = "Dijo: \"¡Señor mío! Mis huesos se han debilitado y mi cabeza se ha llenado de canas. Mis ruegos nunca fueron rechazados.";
"discovery.card.ayah_19_4.source" = "Qur’an 19:4";

"discovery.card.ayah_19_96.title" = "Maryam 96";
"discovery.card.ayah_19_96.meaning" = "El Compasivo hará que quienes hayan creído y obrado rectamente sean amados [por la gente].";
"discovery.card.ayah_19_96.source" = "Qur’an 19:96";

"discovery.card.ayah_20_8.title" = "Taa-Haa 8";
"discovery.card.ayah_20_8.meaning" = "¡Dios! No hay más divinidad que Él. A Él pertenecen los nombres [y los atributos] más sublimes.";
"discovery.card.ayah_20_8.source" = "Qur’an 20:8";

"discovery.card.ayah_20_25.title" = "Taa-Haa 25";
"discovery.card.ayah_20_25.meaning" = "Dijo [Moisés]: \"¡Oh, Señor mío! Abre mi corazón [y dame valor],";
"discovery.card.ayah_20_25.source" = "Qur’an 20:25";

"discovery.card.ayah_20_46.title" = "Taa-Haa 46";
"discovery.card.ayah_20_46.meaning" = "Dijo [Dios]: \"No tengan miedo, pues Yo estoy con ustedes escuchando y observando todo.";
"discovery.card.ayah_20_46.source" = "Qur’an 20:46";

"discovery.card.ayah_20_82.title" = "Taa-Haa 82";
"discovery.card.ayah_20_82.meaning" = "Yo soy Perdonador con quienes se arrepienten, creen, obran rectamente y se encaminan [por el sendero recto].";
"discovery.card.ayah_20_82.source" = "Qur’an 20:82";

"discovery.card.ayah_21_47.title" = "Al-Anbiyaa 47";
"discovery.card.ayah_21_47.meaning" = "Y dispondré la balanza de la justicia el Día de la Resurrección, y nadie será oprimido en lo más mínimo. Todas las obras, aunque sean tan ínfimas como un grano de mostaza, serán tenidas en cuenta. Nadie lleva las cuentas mejor que Yo.";
"discovery.card.ayah_21_47.source" = "Qur’an 21:47";

"discovery.card.ayah_21_73.title" = "Al-Anbiyaa 73";
"discovery.card.ayah_21_73.meaning" = "y líderes ejemplares para que guiasen [a la gente] siguiendo Mi voluntad. Y les inspiré realizar buenas obras, practicar la oración prescrita y pagar el zakat. Fueron devotos en la adoración.";
"discovery.card.ayah_21_73.source" = "Qur’an 21:73";

"discovery.card.ayah_21_92.title" = "Al-Anbiyaa 92";
"discovery.card.ayah_21_92.meaning" = "La religión de todos los Profetas es una religión única. Yo soy su Señor, ¡adórenme solo a Mí!";
"discovery.card.ayah_21_92.source" = "Qur’an 21:92";

"discovery.card.ayah_22_77.title" = "Al-Hajj 77";
"discovery.card.ayah_22_77.meaning" = "¡Oh, creyentes! Inclínense y prostérnense [durante la oración], adoren a su Señor y hagan el bien, que así alcanzarán el triunfo.";
"discovery.card.ayah_22_77.source" = "Qur’an 22:77";

"discovery.card.ayah_22_78.title" = "Al-Hajj 78";
"discovery.card.ayah_22_78.meaning" = "Esfuércense por la causa de Dios como es debido. Él los eligió [para que sigan Su religión] y no les prescribió nada que no puedan cumplir. Ésta es la religión monoteísta de su padre Abraham, él los llamó musulmanes anteriormente y también fueron llamados así en esta revelación, para que el Mensajero fuera testigo [de sus obras] y ustedes sean testigos ante la humanidad [de la llegada de los Profetas anteriores]. Cumplan con la oración, paguen el zakat y aférrense a Dios, pues Él es su Protector. ¡Qué excelente Protector, y qué excelente Defensor!";
"discovery.card.ayah_22_78.source" = "Qur’an 22:78";

"discovery.card.ayah_23_1.title" = "Al-Muminoon 1";
"discovery.card.ayah_23_1.meaning" = "Bienaventurados los creyentes";
"discovery.card.ayah_23_1.source" = "Qur’an 23:1";

"discovery.card.ayah_23_51.title" = "Al-Muminoon 51";
"discovery.card.ayah_23_51.meaning" = "¡Oh, Mensajeros! Coman de las cosas buenas y hagan buenas obras, que Yo bien sé lo que hacen.";
"discovery.card.ayah_23_51.source" = "Qur’an 23:51";

"discovery.card.ayah_23_97.title" = "Al-Muminoon 97";
"discovery.card.ayah_23_97.meaning" = "Di: \"¡Oh, Señor mío! Me refugio en Ti de los susurros de los demonios,";
"discovery.card.ayah_23_97.source" = "Qur’an 23:97";

"discovery.card.ayah_24_22.title" = "An-Noor 22";
"discovery.card.ayah_24_22.meaning" = "Que los que hacen obras de bien y los que tienen riqueza no juren dejar de ayudar [a los pobres debido a su participación en la calumnia a Aishah] a sus parientes, a los pobres y a quienes dejaron sus hogares por la causa de Dios, y [es mejor] que los perdonen y los disculpen. ¿Acaso no aman ser perdonados por Dios? Dios es Indulgente, Misericordioso.";
"discovery.card.ayah_24_22.source" = "Qur’an 24:22";

"discovery.card.ayah_24_31.title" = "An-Noor 31";
"discovery.card.ayah_24_31.meaning" = "Dile a las creyentes que recaten sus miradas, se abstengan de cometer obscenidades, no muestren de sus atractivos [en público] más de lo que es obvio, y que dejen caer el velo sobre su escote, solo muestren sus encantos a sus maridos, sus padres, sus suegros, sus hijos, los hijos de sus maridos, sus hermanos, sus sobrinos por parte de su hermano y de su hermana, las mujeres, las esclavas, sus sirvientes hombres que ya no tengan deseo sexual y los niños que todavía no sienten atracción por el sexo. [Diles también] que no hagan oscilar sus piernas [al caminar] a fin de atraer la atención sobre sus atractivos ocultos. Pidan perdón a Dios por sus pecados, ¡oh, creyentes!, que así alcanzarán el éxito.";
"discovery.card.ayah_24_31.source" = "Qur’an 24:31";

"discovery.card.ayah_24_37.title" = "An-Noor 37";
"discovery.card.ayah_24_37.meaning" = "[En las mezquitas hay] hombres a los que ni los negocios ni las ventas los distraen del recuerdo de Dios, la práctica de la oración prescrita y el pago del zakat, porque temen el día en que los corazones y las miradas se estremezcan.";
"discovery.card.ayah_24_37.source" = "Qur’an 24:37";

"discovery.card.ayah_25_63.title" = "Al-Furqaan 63";
"discovery.card.ayah_25_63.meaning" = "Los siervos del Misericordioso son aquellos que caminan sobre la faz de Tierra con humildad, y cuando son increpados por los ignorantes les responden [con palabras de] paz.";
"discovery.card.ayah_25_63.source" = "Qur’an 25:63";

"discovery.card.ayah_25_74.title" = "Al-Furqaan 74";
"discovery.card.ayah_25_74.meaning" = "Aquellos que piden: \"¡Oh, Señor nuestro! Agrácianos con cónyuges y descendientes que sean un motivo de alegría y tranquilidad para nosotros, y haz que seamos un ejemplo para los que tienen temor [de Dios]\".";
"discovery.card.ayah_25_74.source" = "Qur’an 25:74";

"discovery.card.ayah_26_80.title" = "Ash-Shu'araa 80";
"discovery.card.ayah_26_80.meaning" = "Cuando enfermo, Él es Quien me cura.";
"discovery.card.ayah_26_80.source" = "Qur’an 26:80";

"discovery.card.ayah_26_89.title" = "Ash-Shu'araa 89";
"discovery.card.ayah_26_89.meaning" = "y solo estará a salvo quien tenga el corazón puro\".";
"discovery.card.ayah_26_89.source" = "Qur’an 26:89";

"discovery.card.ayah_27_19.title" = "An-Naml 19";
"discovery.card.ayah_27_19.meaning" = "[Salomón] al oír lo que ella decía, sonrió y exclamó: \"¡Señor mío! Haz que te agradezca los favores que nos has concedido, tanto a mí como a mis padres, que haga obras de bien que Te complazcan, y cuéntame, por Tu misericordia, entre Tus siervos justos\".";
"discovery.card.ayah_27_19.source" = "Qur’an 27:19";

"discovery.card.ayah_27_62.title" = "An-Naml 62";
"discovery.card.ayah_27_62.meaning" = "¿Acaso Quien responde al afligido cuando Lo invoca, alivia los pesares y los ha hecho a ustedes los responsables de la Tierra [puede equipararse a quien no es capaz de hacer nada de eso]? ¿Acaso puede haber otra divinidad junto con Dios? Pocos son los que reflexionan.";
"discovery.card.ayah_27_62.source" = "Qur’an 27:62";

"discovery.card.ayah_28_56.title" = "Al-Qasas 56";
"discovery.card.ayah_28_56.meaning" = "Tú no puedes guiar a quien amas, sino que Dios guía a quien Él quiere. Él sabe quiénes seguirán la guía.";
"discovery.card.ayah_28_56.source" = "Qur’an 28:56";

"discovery.card.ayah_28_77.title" = "Al-Qasas 77";
"discovery.card.ayah_28_77.meaning" = "Gánate el Paraíso con lo que Dios te ha concedido, y no te olvides que también puedes disfrutar de lo que Dios ha hecho lícito en esta vida. Sé generoso [con tu prójimo] como Dios lo es contigo, y no contamines la tierra; Dios no ama a los que contaminan [a sabiendas]\".";
"discovery.card.ayah_28_77.source" = "Qur’an 28:77";

"discovery.card.ayah_29_45.title" = "Al-Ankaboot 45";
"discovery.card.ayah_29_45.meaning" = "Recita lo que se te ha revelado del Libro y cumple con la oración, porque la oración preserva de cometer actos inmorales y reprobables. Tener presente a Dios [en el corazón durante la oración] es lo más importante. Dios sabe lo que hacen.";
"discovery.card.ayah_29_45.source" = "Qur’an 29:45";

"discovery.card.ayah_29_69.title" = "Al-Ankaboot 69";
"discovery.card.ayah_29_69.meaning" = "A quienes se esfuercen por Mi causa los guiaré por Mis caminos. Dios está con los que hacen el bien.";
"discovery.card.ayah_29_69.source" = "Qur’an 29:69";

"discovery.card.ayah_31_12.title" = "Luqman 12";
"discovery.card.ayah_31_12.meaning" = "Agracié a Luqmán con la sabiduría [y le dije]: \"Sé agradecido con Dios, pues quien agradece lo hace en beneficio propio, mientras que el ingrato debe saber que Dios no precisa del agradecimiento [de las personas] y es digno de toda alabanza\".";
"discovery.card.ayah_31_12.source" = "Qur’an 31:12";

"discovery.card.ayah_31_13.title" = "Luqman 13";
"discovery.card.ayah_31_13.meaning" = "[Recuerda] cuando Luqmán exhortó a su hijo diciéndole: \"¡Oh, hijito! No dediques actos de adoración a otro que Dios, pues la idolatría es una gran injusticia\".";
"discovery.card.ayah_31_13.source" = "Qur’an 31:13";

"discovery.card.ayah_31_18.title" = "Luqman 18";
"discovery.card.ayah_31_18.meaning" = "No rechaces a la gente y no andes por la Tierra como un arrogante. Dios no ama a los presumidos ni a los engreídos.";
"discovery.card.ayah_31_18.source" = "Qur’an 31:18";

"discovery.card.ayah_31_19.title" = "Luqman 19";
"discovery.card.ayah_31_19.meaning" = "Sé modesto en tu andar y habla sereno, que el ruido más desagradable es el rebuzno del asno\".";
"discovery.card.ayah_31_19.source" = "Qur’an 31:19";

"discovery.card.ayah_32_16.title" = "As-Sajda 16";
"discovery.card.ayah_32_16.meaning" = "se levantan de sus lechos para invocar a su Señor con temor y anhelo [de Su respuesta], y dan en caridad parte de lo que les he proveído.";
"discovery.card.ayah_32_16.source" = "Qur’an 32:16";

"discovery.card.ayah_32_17.title" = "As-Sajda 17";
"discovery.card.ayah_32_17.meaning" = "Nadie sabe la alegría que les espera [a los creyentes] como recompensa por sus obras.";
"discovery.card.ayah_32_17.source" = "Qur’an 32:17";

"discovery.card.ayah_33_21.title" = "Al-Ahzaab 21";
"discovery.card.ayah_33_21.meaning" = "En el Mensajero de Dios hay un bello ejemplo para quienes tienen esperanza en Dios, [anhelan ser recompensados] en el Día del Juicio y recuerdan frecuentemente a Dios.";
"discovery.card.ayah_33_21.source" = "Qur’an 33:21";

"discovery.card.ayah_33_35.title" = "Al-Ahzaab 35";
"discovery.card.ayah_33_35.meaning" = "Dios les tiene reservado Su perdón y una gran recompensa a los musulmanes y las musulmanas, a los creyentes y las creyentes, a los piadosos y las piadosas, a los justos y las justas, a los pacientes y las pacientes, a los humildes y las humildes, a los que hacen caridades y a las que hacen caridades, a los que ayunan y las que ayunan, a los pudorosos y las pudorosas, a los que recuerdan frecuentemente a Dios y a las que recuerdan frecuentemente a Dios.";
"discovery.card.ayah_33_35.source" = "Qur’an 33:35";

"discovery.card.ayah_33_41.title" = "Al-Ahzaab 41";
"discovery.card.ayah_33_41.meaning" = "¡Oh, creyentes! Tengan presente a Dios en todo momento,";
"discovery.card.ayah_33_41.source" = "Qur’an 33:41";

"discovery.card.ayah_33_56.title" = "Al-Ahzaab 56";
"discovery.card.ayah_33_56.meaning" = "Dios bendice al Profeta y Sus ángeles piden [a Dios] que lo bendiga. ¡Oh, creyentes! Pidan bendiciones y paz por él.";
"discovery.card.ayah_33_56.source" = "Qur’an 33:56";

"discovery.card.ayah_33_70.title" = "Al-Ahzaab 70";
"discovery.card.ayah_33_70.meaning" = "¡Oh, creyentes! Tengan temor de Dios y hablen solo con la verdad.";
"discovery.card.ayah_33_70.source" = "Qur’an 33:70";

"discovery.card.ayah_35_10.title" = "Faatir 10";
"discovery.card.ayah_35_10.meaning" = "Quien desee el poder, debe saber que el poder absoluto pertenece solo a Dios. Hacia Él ascienden las buenas palabras y Él eleva las obras piadosas. Pero quienes se confabulen para hacer el mal tendrán un castigo severo, y sus planes fracasarán.";
"discovery.card.ayah_35_10.source" = "Qur’an 35:10";

"discovery.card.ayah_35_28.title" = "Faatir 28";
"discovery.card.ayah_35_28.meaning" = "y que los seres humanos, los animales y los rebaños los hay de diversos colores? Los siervos que tienen más temor devocional de Dios son los sabios. Dios es Poderoso, Absolvedor.";
"discovery.card.ayah_35_28.source" = "Qur’an 35:28";

"discovery.card.ayah_36_1.title" = "Yaseen 1";
"discovery.card.ayah_36_1.meaning" = "Iá’. Sín.";
"discovery.card.ayah_36_1.source" = "Qur’an 36:1";

"discovery.card.ayah_36_22.title" = "Yaseen 22";
"discovery.card.ayah_36_22.meaning" = "¿Cómo no iba a adorar a Quien me creó, si ante Él comparecerán?";
"discovery.card.ayah_36_22.source" = "Qur’an 36:22";

"discovery.card.ayah_36_58.title" = "Yaseen 58";
"discovery.card.ayah_36_58.meaning" = "\"¡La paz sea con ustedes!\", serán las palabras del Señor Misericordioso.";
"discovery.card.ayah_36_58.source" = "Qur’an 36:58";

"discovery.card.ayah_37_96.title" = "As-Saaffaat 96";
"discovery.card.ayah_37_96.meaning" = "Dios es Quien los creó a ustedes y a lo que ustedes hacen\".";
"discovery.card.ayah_37_96.source" = "Qur’an 37:96";

"discovery.card.ayah_38_29.title" = "Saad 29";
"discovery.card.ayah_38_29.meaning" = "Este Libro que te revelo [¡oh, Mujámmad!] encierra grandes bendiciones, para que mediten sobre sus signos y reflexionen los dotados de intelecto.";
"discovery.card.ayah_38_29.source" = "Qur’an 38:29";

"discovery.card.ayah_39_9.title" = "Az-Zumar 9";
"discovery.card.ayah_39_9.meaning" = "¿Acaso se puede comparar a [ese incrédulo] con quien se prosterna e inclina [en oración] consagrándose en la noche, está consciente de la otra vida y anhela la misericordia de su Señor? Dile: \"¿Acaso son iguales los que tienen conocimiento y los que no tienen conocimiento?\" Solo reflexionan los dotados de entendimiento.";
"discovery.card.ayah_39_9.source" = "Qur’an 39:9";

"discovery.card.ayah_39_10.title" = "Az-Zumar 10";
"discovery.card.ayah_39_10.meaning" = "Diles: \"¡Oh, siervos creyentes! Tengan temor de su Señor, y sepan que quienes obren bien en este mundo recibirán una bella recompensa, y que la Tierra de Dios es amplia. La recompensa para quienes sean pacientes y perseverantes no tendrá límite\".";
"discovery.card.ayah_39_10.source" = "Qur’an 39:10";

"discovery.card.ayah_39_36.title" = "Az-Zumar 36";
"discovery.card.ayah_39_36.meaning" = "¿Acaso Dios no es suficiente [como Protector] para Su siervo? Pero ellos [los idólatras] intentan atemorizarte con sus ídolos [a los cuales adoran] en lugar de Él. Y a quien Dios permite que se desvíe nadie lo podrá guiar.";
"discovery.card.ayah_39_36.source" = "Qur’an 39:36";

"discovery.card.ayah_40_60.title" = "Ghafir 60";
"discovery.card.ayah_40_60.meaning" = "Su Señor dice: \"Invóquenme, que responderé [sus súplicas]\". Pero quienes por soberbia se nieguen a adorarme, ingresarán al Infierno humillados.";
"discovery.card.ayah_40_60.source" = "Qur’an 40:60";

"discovery.card.ayah_40_65.title" = "Ghafir 65";
"discovery.card.ayah_40_65.meaning" = "Él es el Viviente, no hay nada ni nadie con derecho a ser adorado salvo Él; invóquenlo solamente a Él. Alabado sea Dios, Señor del universo.";
"discovery.card.ayah_40_65.source" = "Qur’an 40:65";

"discovery.card.ayah_41_30.title" = "Fussilat 30";
"discovery.card.ayah_41_30.meaning" = "Quienes digan: \"Nuestro Señor es Dios\" y obren correctamente, los ángeles descenderán sobre ellos [y les dirán:] \"No teman ni estén tristes. Bienaventurados sean porque tendrán el Paraíso que les fue prometido.";
"discovery.card.ayah_41_30.source" = "Qur’an 41:30";

"discovery.card.ayah_41_33.title" = "Fussilat 33";
"discovery.card.ayah_41_33.meaning" = "Quién puede expresar mejores palabras que aquel que invita a la gente a creer en Dios, obra rectamente y dice: \"¡Yo soy de los musulmanes!\"";
"discovery.card.ayah_41_33.source" = "Qur’an 41:33";

"discovery.card.ayah_41_34.title" = "Fussilat 34";
"discovery.card.ayah_41_34.meaning" = "No es lo mismo obrar el bien que obrar el mal. Responde con una buena actitud, y verás que aquel con quien tenías enemistad se convierte en un amigo ferviente.";
"discovery.card.ayah_41_34.source" = "Qur’an 41:34";

"discovery.card.ayah_42_13.title" = "Ash-Shura 13";
"discovery.card.ayah_42_13.meaning" = "Les he legislado la misma religión [monoteísta] que le había encomendado a Noé, y que te he revelado a ti [en el Corán] y que le encomendé a Abraham, a Moisés y a Jesús, para que sean firmes en la práctica de la religión, y no creen divisiones. Pero a los idólatras les parece difícil aquello a lo que tú los invitas. Dios elige [para que acepte la fe] a quien quiere, y guía hacia Él a quien se arrepiente.";
"discovery.card.ayah_42_13.source" = "Qur’an 42:13";

"discovery.card.ayah_42_19.title" = "Ash-Shura 19";
"discovery.card.ayah_42_19.meaning" = "Dios es Bondadoso con Sus siervos, sustenta a quien quiere. Él es el Fuerte, el Poderoso.";
"discovery.card.ayah_42_19.source" = "Qur’an 42:19";

"discovery.card.ayah_42_36.title" = "Ash-Shura 36";
"discovery.card.ayah_42_36.meaning" = "Lo que se les ha concedido [de bienes materiales] es parte de los placeres transitorios de esta vida mundanal. Pero la recompensa que Dios tiene reservada [en el Paraíso] será mejor y más duradera, para quienes crean y se encomienden a su Señor,";
"discovery.card.ayah_42_36.source" = "Qur’an 42:36";

"discovery.card.ayah_43_36.title" = "Az-Zukhruf 36";
"discovery.card.ayah_43_36.meaning" = "A quien deje de recordar al Misericordioso le asignaré un demonio que será su compañero inseparable.";
"discovery.card.ayah_43_36.source" = "Qur’an 43:36";

"discovery.card.ayah_44_3.title" = "Ad-Dukhaan 3";
"discovery.card.ayah_44_3.meaning" = "que he revelado en una noche bendita: ¡Les he advertido!";
"discovery.card.ayah_44_3.source" = "Qur’an 44:3";

"discovery.card.ayah_45_15.title" = "Al-Jaathiya 15";
"discovery.card.ayah_45_15.meaning" = "Quien obre el bien lo hará en beneficio propio, pero quien obre el mal lo hará en detrimento propio. Sepan que ante su Señor será el retorno.";
"discovery.card.ayah_45_15.source" = "Qur’an 45:15";

"discovery.card.ayah_46_13.title" = "Al-Ahqaf 13";
"discovery.card.ayah_46_13.meaning" = "Quienes digan: \"¡Nuestro Señor es Dios!, y luego obren correctamente, no tienen de qué sentir temor ni estar tristes [en el Día del Juicio Final]";
"discovery.card.ayah_46_13.source" = "Qur’an 46:13";

"discovery.card.ayah_46_15.title" = "Al-Ahqaf 15";
"discovery.card.ayah_46_15.meaning" = "Le he ordenado al ser humano hacer el bien a sus padres. Su madre lo ha llevado [en el vientre] con esfuerzo, y con dolor lo dio a luz. El período del embarazo y la lactancia dura treinta meses. Cuando alcance la madurez, al llegar a los cuarenta años, debe decir [en súplica]: \"¡Oh, Señor mío! Haz que sepa agradecerte los favores que nos has concedido, tanto a mí como a mis padres, y que pueda realizar obras buenas que Te complazcan. Concédeme una descendencia piadosa. Me arrepiento a Ti [de mis pecados] y soy de los musulmanes\".";
"discovery.card.ayah_46_15.source" = "Qur’an 46:15";

"discovery.card.ayah_47_7.title" = "Muhammad 7";
"discovery.card.ayah_47_7.meaning" = "¡Oh, creyentes! Si auxilian a Dios, Él los auxiliará y afirmará sus pasos.";
"discovery.card.ayah_47_7.source" = "Qur’an 47:7";

"discovery.card.ayah_47_19.title" = "Muhammad 19";
"discovery.card.ayah_47_19.meaning" = "Debes saber que no hay nada ni nadie con derecho a ser adorado salvo Dios, e implórale el perdón de tus faltas y las de los creyentes y las creyentes. Dios conoce bien lo que hacen dentro y fuera de sus hogares.";
"discovery.card.ayah_47_19.source" = "Qur’an 47:19";

"discovery.card.ayah_48_1.title" = "Al-Fath 1";
"discovery.card.ayah_48_1.meaning" = "Te he concedido [¡oh, Mujámmad!] una victoria evidente.";
"discovery.card.ayah_48_1.source" = "Qur’an 48:1";

"discovery.card.ayah_48_29.title" = "Al-Fath 29";
"discovery.card.ayah_48_29.meaning" = "Mujámmad es el Mensajero de Dios. [Los creyentes] que están con él son severos con los que se niegan a creer, pero misericordiosos entre ellos. Los verás [rezando] inclinados y prosternados, anhelando alcanzar la misericordia de Dios y Su complacencia. En sus rostros se encuentran las huellas de la prosternación. Así fueron descritos en la Tora; mientras que en el Evangelio se los compara con una semilla que germina, brota, se fortalece, cobra grosor y se afirma en su tallo, causando alegría a los sembradores. Para que se indignen los que se niegan a creer. A los que crean y obren rectamente, Dios les ha prometido el perdón y una recompensa grandiosa.";
"discovery.card.ayah_48_29.source" = "Qur’an 48:29";

"discovery.card.ayah_49_10.title" = "Al-Hujuraat 10";
"discovery.card.ayah_49_10.meaning" = "Los creyentes son hermanos entre sí; reconcilien a sus hermanos y tengan temor de Dios para que Él les tenga misericordia.";
"discovery.card.ayah_49_10.source" = "Qur’an 49:10";

"discovery.card.ayah_49_11.title" = "Al-Hujuraat 11";
"discovery.card.ayah_49_11.meaning" = "¡Oh, creyentes! No se burlen unos de otros, porque pudiera ser que los que son blancos de las burlas sean mejores que los que se están burlando. Que las mujeres no se burlen de otras mujeres, porque es posible que las que son el blanco de las burlas sean mejores que las que se burlan. No difamen ni pongan apodos ofensivos. ¡Qué malo es comportarse como un corrupto luego de haber sido agraciado con la fe! Quienes no se arrepientan… esos son los injustos.";
"discovery.card.ayah_49_11.source" = "Qur’an 49:11";

"discovery.card.ayah_51_19.title" = "Adh-Dhaariyat 19";
"discovery.card.ayah_51_19.meaning" = "y daban de su dinero lo que era derecho para el mendigo y el indigente.";
"discovery.card.ayah_51_19.source" = "Qur’an 51:19";

"discovery.card.ayah_51_56.title" = "Adh-Dhaariyat 56";
"discovery.card.ayah_51_56.meaning" = "No he creado a los yinnes y a los seres humanos sino para que Me adoren.";
"discovery.card.ayah_51_56.source" = "Qur’an 51:56";

"discovery.card.ayah_52_21.title" = "At-Tur 21";
"discovery.card.ayah_52_21.meaning" = "Los creyentes y sus descendientes que los hayan seguido en la fe serán reunidos, sin que se pierda ninguna de sus obras. Toda persona es responsable de sus propias acciones.";
"discovery.card.ayah_52_21.source" = "Qur’an 52:21";

"discovery.card.ayah_53_32.title" = "An-Najm 32";
"discovery.card.ayah_53_32.meaning" = "aquellos que evitan los pecados graves y las obscenidades, y no cometen más que faltas leves. Tu Señor es inmensamente indulgente. Él los conoce bien, ya que los creó de la tierra y luego hizo que fueran embriones en el vientre de sus madres. No se elogien a sí mismos, Él bien sabe quién es realmente piadoso.";
"discovery.card.ayah_53_32.source" = "Qur’an 53:32";

"discovery.card.ayah_53_39.title" = "An-Najm 39";
"discovery.card.ayah_53_39.meaning" = "que el ser humano no obtendrá sino el fruto de sus esfuerzos,";
"discovery.card.ayah_53_39.source" = "Qur’an 53:39";

"discovery.card.ayah_54_17.title" = "Al-Qamar 17";
"discovery.card.ayah_54_17.meaning" = "He hecho el Corán fácil de comprender y memorizar. Pero, ¿habrá alguien que reflexione?";
"discovery.card.ayah_54_17.source" = "Qur’an 54:17";

"discovery.card.ayah_55_1.title" = "Ar-Rahmaan 1";
"discovery.card.ayah_55_1.meaning" = "El Compasivo";
"discovery.card.ayah_55_1.source" = "Qur’an 55:1";

"discovery.card.ayah_55_46.title" = "Ar-Rahmaan 46";
"discovery.card.ayah_55_46.meaning" = "Para quien haya tenido temor de comparecer ante su Señor habrá dos jardines.";
"discovery.card.ayah_55_46.source" = "Qur’an 55:46";

"discovery.card.ayah_56_10.title" = "Al-Waaqia 10";
"discovery.card.ayah_56_10.meaning" = "Y los adelantados. ¡Estos serán los primeros!";
"discovery.card.ayah_56_10.source" = "Qur’an 56:10";

"discovery.card.ayah_57_16.title" = "Al-Hadid 16";
"discovery.card.ayah_57_16.meaning" = "¿Acaso no es hora de que los creyentes subyuguen sus corazones al recuerdo de Dios y a la Verdad que ha sido revelada, y que no sean como quienes recibieron el Libro anteriormente? A estos, a medida que transcurría el tiempo, se les endurecía el corazón. Muchos de ellos eran corruptos.";
"discovery.card.ayah_57_16.source" = "Qur’an 57:16";

"discovery.card.ayah_57_20.title" = "Al-Hadid 20";
"discovery.card.ayah_57_20.meaning" = "Sepan que la vida mundanal es juego, diversión, encanto, ostentación y rivalidad en riqueza e hijos. Es como la lluvia que genera plantas que alegran a los sembradores con su verdor, pero luego las ven amarillearse hasta convertirse en heno. En la otra vida, ustedes recibirán un castigo severo o el perdón de Dios y Su complacencia. La vida mundanal no es más que un disfrute ilusorio.";
"discovery.card.ayah_57_20.source" = "Qur’an 57:20";

"discovery.card.ayah_57_21.title" = "Al-Hadid 21";
"discovery.card.ayah_57_21.meaning" = "¡Apresúrense a alcanzar el perdón de su Señor y así obtener un Paraíso tan vasto como el cielo y la Tierra, el cual está reservado para quienes creen en Dios y en Sus Mensajeros! Esa es la bendición de Dios, y Él se la concede a quien quiere. Dios es poseedor de una bendición grandiosa.";
"discovery.card.ayah_57_21.source" = "Qur’an 57:21";

"discovery.card.ayah_58_11.title" = "Al-Mujaadila 11";
"discovery.card.ayah_58_11.meaning" = "¡Oh, creyentes! Cuando se les dice: \"Hagan un lugar en las reuniones, háganlo, para que Dios les haga a ustedes un lugar\". Y si se les dice: \"¡Levántense!\" Levántense. Sepan que Dios elevará en grados a los creyentes y a quienes agracie con el conocimiento. Dios sabe cuanto hacen.";
"discovery.card.ayah_58_11.source" = "Qur’an 58:11";

"discovery.card.ayah_59_9.title" = "Al-Hashr 9";
"discovery.card.ayah_59_9.meaning" = "Quienes estaban establecidos y aceptaron la fe antes de su llegada, aman a los que emigraron, no sienten envidia alguna en sus corazones por lo que se les ha dado y los prefieren a sí mismos aunque estén en extrema necesidad. Quienes hayan sido preservados de la avaricia serán los triunfadores.";
"discovery.card.ayah_59_9.source" = "Qur’an 59:9";

"discovery.card.ayah_59_18.title" = "Al-Hashr 18";
"discovery.card.ayah_59_18.meaning" = "¡Oh, creyentes! Tengan temor de Dios, y que cada alma considere cuánto ha obrado para el mañana. Tengan temor de Dios, porque Dios está bien informado de cuanto hacen.";
"discovery.card.ayah_59_18.source" = "Qur’an 59:18";

"discovery.card.ayah_59_22.title" = "Al-Hashr 22";
"discovery.card.ayah_59_22.meaning" = "Él es Al-lah, no hay otra divinidad salvo Él, el Conocedor de lo oculto y de lo manifiesto. Él es el Compasivo, el Misericordioso.";
"discovery.card.ayah_59_22.source" = "Qur’an 59:22";

"discovery.card.ayah_61_2.title" = "As-Saff 2";
"discovery.card.ayah_61_2.meaning" = "¡Creyentes! ¿Por qué dicen una cosa pero hacen otra?";
"discovery.card.ayah_61_2.source" = "Qur’an 61:2";

"discovery.card.ayah_61_10.title" = "As-Saff 10";
"discovery.card.ayah_61_10.meaning" = "¡Creyentes! ¿Quieren que les enseñe un negocio que los salvará del castigo doloroso?";
"discovery.card.ayah_61_10.source" = "Qur’an 61:10";

"discovery.card.ayah_61_13.title" = "As-Saff 13";
"discovery.card.ayah_61_13.meaning" = "También les dará algo que aman: \"Su auxilio y una pronta victoria\". Albricia a los creyentes [con la recompensa que recibirán en esta vida y en la otra].";
"discovery.card.ayah_61_13.source" = "Qur’an 61:13";

"discovery.card.ayah_62_9.title" = "Al-Jumu'a 9";
"discovery.card.ayah_62_9.meaning" = "¡Creyentes! Cuando sea realizado el llamado a la oración del día viernes, acudan al recuerdo de Dios y abandonen el comercio, es lo mejor para ustedes. ¡Si supieran!";
"discovery.card.ayah_62_9.source" = "Qur’an 62:9";

"discovery.card.ayah_62_10.title" = "Al-Jumu'a 10";
"discovery.card.ayah_62_10.meaning" = "Cuando haya terminado la oración recorran la tierra, procuren el sustento y recuerden mucho a Dios, que así triunfarán.";
"discovery.card.ayah_62_10.source" = "Qur’an 62:10";

"discovery.card.ayah_63_9.title" = "Al-Munaafiqoon 9";
"discovery.card.ayah_63_9.meaning" = "¡Creyentes! Que las posesiones materiales y los hijos no los distraigan del recuerdo de Dios. Pues quienes se alejen del recuerdo de Dios serán los perdedores.";
"discovery.card.ayah_63_9.source" = "Qur’an 63:9";

"discovery.card.ayah_64_16.title" = "At-Taghaabun 16";
"discovery.card.ayah_64_16.meaning" = "Tengan temor de Dios tanto como puedan. Escuchen y obedezcan [la revelación], y hagan caridad, porque es lo mejor para ustedes mismos. Sepan que quienes luchen contra su propia avaricia serán los triunfadores.";
"discovery.card.ayah_64_16.source" = "Qur’an 64:16";

"discovery.card.ayah_65_4.title" = "At-Talaaq 4";
"discovery.card.ayah_65_4.meaning" = "El período de espera para aquellas mujeres que hayan llegado a la menopausia, si tienen dudas [sobre el término del periodo], o aquellas que no menstrúan, es de tres meses. En cambio, el de las embarazadas finalizará cuando den a luz. Sepan que a quien tenga temor de Dios, Él le facilitará sus asuntos.";
"discovery.card.ayah_65_4.source" = "Qur’an 65:4";

"discovery.card.ayah_66_8.title" = "At-Tahrim 8";
"discovery.card.ayah_66_8.meaning" = "¡Creyentes! Arrepiéntanse sinceramente ante Dios, puede que así su Señor borre sus faltas y los introduzca en jardines del Paraíso por donde corren ríos. Ese día Dios no avergonzará al Profeta ni a los que creyeron junto a él. Una luz se extenderá delante de ellos y a su derecha, y ellos dirán: \"¡Señor nuestro! Auméntanos nuestra luz y perdónanos. Tú eres sobre toda cosa poderoso\".";
"discovery.card.ayah_66_8.source" = "Qur’an 66:8";

"discovery.card.ayah_67_1.title" = "Al-Mulk 1";
"discovery.card.ayah_67_1.meaning" = "Bendito sea Aquel en Cuyas manos está el reino y tiene el poder sobre todas las cosas.";
"discovery.card.ayah_67_1.source" = "Qur’an 67:1";

"discovery.card.ayah_67_14.title" = "Al-Mulk 14";
"discovery.card.ayah_67_14.meaning" = "¿Acaso no lo va a saber Quien todo lo creó? Él es el Sutil, el que está bien informado.";
"discovery.card.ayah_67_14.source" = "Qur’an 67:14";

"discovery.card.ayah_67_15.title" = "Al-Mulk 15";
"discovery.card.ayah_67_15.meaning" = "Él es Quien les ha facilitado la vida sobre la Tierra. Recorran sus caminos y coman del sustento de Dios, que ante Él comparecerán.";
"discovery.card.ayah_67_15.source" = "Qur’an 67:15";

"discovery.card.ayah_68_4.title" = "Al-Qalam 4";
"discovery.card.ayah_68_4.meaning" = "Eres de una naturaleza y moral grandiosas.";
"discovery.card.ayah_68_4.source" = "Qur’an 68:4";

"discovery.card.ayah_70_19.title" = "Al-Ma'aarij 19";
"discovery.card.ayah_70_19.meaning" = "El hombre fue creado impaciente:";
"discovery.card.ayah_70_19.source" = "Qur’an 70:19";

"discovery.card.ayah_73_20.title" = "Al-Muzzammil 20";
"discovery.card.ayah_73_20.meaning" = "Tu Señor bien sabe que te levantas a orar casi dos tercios de la noche, otras la mitad o un tercio de ella, así como lo hacen algunos de los creyentes que te siguen. Dios es Quien determina cuánto dura la noche y el día, sabe que no pueden hacerlo siempre, por lo que los perdona aligerando su obligación. Así que reciten durante la oración lo que sepan del Corán. Dios sabe que habrá entre ustedes alguien enfermo [al que se le dificulte la oración], otros que estén de viaje recorriendo la tierra en busca del sustento de Dios, y otros combatiendo por Su causa. Así que reciten durante la oración de lo que sepan del Corán. Cumplan con la oración obligatoria y paguen el zakat. Presten a la causa de Dios generosamente, porque toda obra de bien que hagan será en favor de ustedes, y Dios los recompensará grandemente. Pidan a Dios el perdón [de sus faltas y omisiones] porque Él es Absolvedor, Misericordioso.";
"discovery.card.ayah_73_20.source" = "Qur’an 73:20";

"discovery.card.ayah_74_3.title" = "Al-Muddaththir 3";
"discovery.card.ayah_74_3.meaning" = "Proclama la grandeza de tu Señor,";
"discovery.card.ayah_74_3.source" = "Qur’an 74:3";

"discovery.card.ayah_76_8.title" = "Al-Insaan 8";
"discovery.card.ayah_76_8.meaning" = "Y, a pesar del amor que tienen por sus bienes materiales, alimentan al pobre, al huérfano y al prisionero.";
"discovery.card.ayah_76_8.source" = "Qur’an 76:8";

"discovery.card.ayah_76_9.title" = "Al-Insaan 9";
"discovery.card.ayah_76_9.meaning" = "Dicen: \"Les damos de comer simplemente porque anhelamos el rostro de Dios. En realidad no esperamos de ustedes retribución ni agradecimiento.";
"discovery.card.ayah_76_9.source" = "Qur’an 76:9";

"discovery.card.ayah_87_1.title" = "Al-A'laa 1";
"discovery.card.ayah_87_1.meaning" = "Glorifica el nombre de tu Señor, el Altísimo,";
"discovery.card.ayah_87_1.source" = "Qur’an 87:1";

"discovery.card.ayah_87_14.title" = "Al-A'laa 14";
"discovery.card.ayah_87_14.meaning" = "¡Será de los bienaventurados quien se purifique [de la idolatría y los pecados],";
"discovery.card.ayah_87_14.source" = "Qur’an 87:14";

"discovery.card.ayah_89_27.title" = "Al-Fajr 27";
"discovery.card.ayah_89_27.meaning" = "[Le será dicho al creyente:] \"¡Oh, alma que estás en paz con tu Señor!";
"discovery.card.ayah_89_27.source" = "Qur’an 89:27";

"discovery.card.ayah_89_28.title" = "Al-Fajr 28";
"discovery.card.ayah_89_28.meaning" = "Vuelve a la vera de tu Señor complacida, porque Dios está complacido contigo,";
"discovery.card.ayah_89_28.source" = "Qur’an 89:28";

"discovery.card.ayah_90_12.title" = "Al-Balad 12";
"discovery.card.ayah_90_12.meaning" = "¿Y qué te hará comprender lo que es el camino del esfuerzo?";
"discovery.card.ayah_90_12.source" = "Qur’an 90:12";

"discovery.card.ayah_90_13.title" = "Al-Balad 13";
"discovery.card.ayah_90_13.meaning" = "Es liberar [al esclavo] de la esclavitud";
"discovery.card.ayah_90_13.source" = "Qur’an 90:13";

"discovery.card.ayah_91_9.title" = "Ash-Shams 9";
"discovery.card.ayah_91_9.meaning" = "¡Será bienaventurado quien purifique su alma [apartándola de los pecados],";
"discovery.card.ayah_91_9.source" = "Qur’an 91:9";

"discovery.card.ayah_92_5.title" = "Al-Lail 5";
"discovery.card.ayah_92_5.meaning" = "A quien dé caridades, tenga temor [de Dios]";
"discovery.card.ayah_92_5.source" = "Qur’an 92:5";

"discovery.card.ayah_92_18.title" = "Al-Lail 18";
"discovery.card.ayah_92_18.meaning" = "aquel que da parte de su riqueza para purificarse [de la avaricia],";
"discovery.card.ayah_92_18.source" = "Qur’an 92:18";

"discovery.card.ayah_93_5.title" = "Ad-Dhuhaa 5";
"discovery.card.ayah_93_5.meaning" = "Tu Señor te agraciará y te complacerás.";
"discovery.card.ayah_93_5.source" = "Qur’an 93:5";

"discovery.card.ayah_93_6.title" = "Ad-Dhuhaa 6";
"discovery.card.ayah_93_6.meaning" = "¿Acaso no te encontró huérfano y te dio amparo,";
"discovery.card.ayah_93_6.source" = "Qur’an 93:6";

"discovery.card.ayah_93_7.title" = "Ad-Dhuhaa 7";
"discovery.card.ayah_93_7.meaning" = "y te encontró perdido y te guió,";
"discovery.card.ayah_93_7.source" = "Qur’an 93:7";

"discovery.card.ayah_93_8.title" = "Ad-Dhuhaa 8";
"discovery.card.ayah_93_8.meaning" = "y te encontró pobre y te enriqueció?";
"discovery.card.ayah_93_8.source" = "Qur’an 93:8";

"discovery.card.ayah_93_10.title" = "Ad-Dhuhaa 10";
"discovery.card.ayah_93_10.meaning" = "ni rechaces al mendigo.";
"discovery.card.ayah_93_10.source" = "Qur’an 93:10";

"discovery.card.ayah_93_11.title" = "Ad-Dhuhaa 11";
"discovery.card.ayah_93_11.meaning" = "Y divulga las bendiciones de tu Señor.";
"discovery.card.ayah_93_11.source" = "Qur’an 93:11";

"discovery.card.ayah_94_6.title" = "Ash-Sharh 6";
"discovery.card.ayah_94_6.meaning" = "Realmente, luego de toda dificultad viene la facilidad.";
"discovery.card.ayah_94_6.source" = "Qur’an 94:6";

"discovery.card.ayah_94_7.title" = "Ash-Sharh 7";
"discovery.card.ayah_94_7.meaning" = "Cuando cumplas con tus obligaciones dedícate a la adoración,";
"discovery.card.ayah_94_7.source" = "Qur’an 94:7";

"discovery.card.ayah_94_8.title" = "Ash-Sharh 8";
"discovery.card.ayah_94_8.meaning" = "y a tu Señor anhela con devoción.";
"discovery.card.ayah_94_8.source" = "Qur’an 94:8";

"discovery.card.ayah_95_4.title" = "At-Tin 4";
"discovery.card.ayah_95_4.meaning" = "Que he creado al ser humano con la mejor conformación.";
"discovery.card.ayah_95_4.source" = "Qur’an 95:4";

"discovery.card.ayah_96_1.title" = "Al-Alaq 1";
"discovery.card.ayah_96_1.meaning" = "¡Lee! [¡oh, Mujámmad!] En el nombre de tu Señor, Quien creó todas las cosas.";
"discovery.card.ayah_96_1.source" = "Qur’an 96:1";

"discovery.card.ayah_96_5.title" = "Al-Alaq 5";
"discovery.card.ayah_96_5.meaning" = "y le enseñó al hombre lo que este no sabía.";
"discovery.card.ayah_96_5.source" = "Qur’an 96:5";

"discovery.card.ayah_97_1.title" = "Al-Qadr 1";
"discovery.card.ayah_97_1.meaning" = "Comencé la revelación [del Corán] en la noche de la predestinación.";
"discovery.card.ayah_97_1.source" = "Qur’an 97:1";

"discovery.card.ayah_97_5.title" = "Al-Qadr 5";
"discovery.card.ayah_97_5.meaning" = "Es una noche de paz y seguridad hasta el comienzo del alba.";
"discovery.card.ayah_97_5.source" = "Qur’an 97:5";

"discovery.card.ayah_99_7.title" = "Az-Zalzala 7";
"discovery.card.ayah_99_7.meaning" = "Quien haya realizado una obra de bien, tan pequeña como un átomo, la encontrará registrada.";
"discovery.card.ayah_99_7.source" = "Qur’an 99:7";

"discovery.card.ayah_99_8.title" = "Az-Zalzala 8";
"discovery.card.ayah_99_8.meaning" = "Y quien haya realizado una mala obra, tan pequeña como un átomo, la encontrará registrada.";
"discovery.card.ayah_99_8.source" = "Qur’an 99:8";

"discovery.card.ayah_102_1.title" = "At-Takaathur 1";
"discovery.card.ayah_102_1.meaning" = "El afán de tener más y más los domina";
"discovery.card.ayah_102_1.source" = "Qur’an 102:1";

"discovery.card.ayah_102_8.title" = "At-Takaathur 8";
"discovery.card.ayah_102_8.meaning" = "Luego, ese día [del Juicio] se les preguntará por cada bendición que recibieron [durante la vida mundanal].";
"discovery.card.ayah_102_8.source" = "Qur’an 102:8";

"discovery.card.ayah_103_3.title" = "Al-Asr 3";
"discovery.card.ayah_103_3.meaning" = "excepto aquellos que crean, obren rectamente, y se aconsejen mutuamente con la verdad y con la paciencia [ante las adversidades].";
"discovery.card.ayah_103_3.source" = "Qur’an 103:3";

"discovery.card.ayah_107_1.title" = "Al-Maa'un 1";
"discovery.card.ayah_107_1.meaning" = "¿Acaso has observado a quien desmiente el Día del Juicio?";
"discovery.card.ayah_107_1.source" = "Qur’an 107:1";

"discovery.card.ayah_107_4.title" = "Al-Maa'un 4";
"discovery.card.ayah_107_4.meaning" = "¡Ay de los orantes";
"discovery.card.ayah_107_4.source" = "Qur’an 107:4";

"discovery.card.ayah_110_1.title" = "An-Nasr 1";
"discovery.card.ayah_110_1.meaning" = "[¡Oh, Mujámmad!] Cuando llegue el socorro de Dios y la victoria,";
"discovery.card.ayah_110_1.source" = "Qur’an 110:1";

"discovery.card.ayah_110_3.title" = "An-Nasr 3";
"discovery.card.ayah_110_3.meaning" = "glorifica alabando a tu Señor y pide Su perdón; Él es Indulgente.";
"discovery.card.ayah_110_3.source" = "Qur’an 110:3";

"discovery.card.ayah_112_2.title" = "Al-Ikhlaas 2";
"discovery.card.ayah_112_2.meaning" = "Al-lah es el Absoluto.";
"discovery.card.ayah_112_2.source" = "Qur’an 112:2";

"discovery.card.ayah_112_3.title" = "Al-Ikhlaas 3";
"discovery.card.ayah_112_3.meaning" = "No engendró ni fue engendrado.";
"discovery.card.ayah_112_3.source" = "Qur’an 112:3";

"discovery.card.ayah_112_4.title" = "Al-Ikhlaas 4";
"discovery.card.ayah_112_4.meaning" = "Y no hay nada ni nadie que sea semejante a Él\".";
"discovery.card.ayah_112_4.source" = "Qur’an 112:4";

"discovery.card.sunnah_bukhari_10.title" = "Sahih al-Bujari 10";
"discovery.card.sunnah_bukhari_10.meaning" = "Relató 'Abdullah bin 'Amr: El Profeta (ﷺ) dijo: \"Un musulmán es quien evita dañar a los musulmanes con su lengua y sus manos. Y un Muhajir (emigrante) es quien abandona todo lo que Allah ha prohibido.\"";
"discovery.card.sunnah_bukhari_10.source" = "Sahih al-Bukhari 10";

"discovery.card.sunnah_bukhari_11.title" = "Sahih al-Bujari 11";
"discovery.card.sunnah_bukhari_11.meaning" = "Relató Abu Musa: Algunas personas preguntaron al Mensajero de Allah (ﷺ): \"¿De quién es el islam el mejor? Es decir: (¿Quién es un musulmán muy bueno?)\" Él respondió: \"Quien evita dañar a los musulmanes con su lengua y sus manos.\"";
"discovery.card.sunnah_bukhari_11.source" = "Sahih al-Bukhari 11";

"discovery.card.sunnah_bukhari_12.title" = "Sahih al-Bujari 12";
"discovery.card.sunnah_bukhari_12.meaning" = "Relató 'Abdullah bin 'Amr: Un hombre preguntó al Profeta (ﷺ): \"¿Qué clase de obras o (qué cualidades del) islam son buenas?\" El Profeta (ﷺ) respondió: \"Dar de comer (a los pobres) y saludar a quienes conoces y a quienes no conoces.\"";
"discovery.card.sunnah_bukhari_12.source" = "Sahih al-Bukhari 12";

"discovery.card.sunnah_bukhari_13.title" = "Sahih al-Bujari 13";
"discovery.card.sunnah_bukhari_13.meaning" = "Relató Anas: El Profeta (ﷺ) dijo: \"Ninguno de vosotros tendrá fe hasta que desee para su hermano (musulmán) lo que desea para sí mismo.\"";
"discovery.card.sunnah_bukhari_13.source" = "Sahih al-Bukhari 13";

"discovery.card.sunnah_bukhari_14.title" = "Sahih al-Bujari 14";
"discovery.card.sunnah_bukhari_14.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) dijo: \"Por Aquel en Cuyas Manos está mi vida, ninguno de vosotros tendrá fe hasta que me ame más que a su padre y a sus hijos.\"";
"discovery.card.sunnah_bukhari_14.source" = "Sahih al-Bukhari 14";

"discovery.card.sunnah_bukhari_15.title" = "Sahih al-Bujari 15";
"discovery.card.sunnah_bukhari_15.meaning" = "Relató Anas: El Profeta (ﷺ) dijo: \"Ninguno de vosotros tendrá fe hasta que me ame más que a su padre, a sus hijos y a toda la humanidad.\"";
"discovery.card.sunnah_bukhari_15.source" = "Sahih al-Bukhari 15";

"discovery.card.sunnah_bukhari_17.title" = "Sahih al-Bujari 17";
"discovery.card.sunnah_bukhari_17.meaning" = "Relató Anas: El Profeta (ﷺ) dijo: \"El amor por los Ansar es una señal de fe y el odio hacia los Ansar es una señal de hipocresía.\"";
"discovery.card.sunnah_bukhari_17.source" = "Sahih al-Bukhari 17";

"discovery.card.sunnah_bukhari_19.title" = "Sahih al-Bujari 19";
"discovery.card.sunnah_bukhari_19.meaning" = "Relató Abu Said Al-Khudri: El Mensajero de Allah (ﷺ) dijo: \"Pronto llegará un tiempo en que la mejor propiedad de un musulmán serán ovejas que llevará a las cimas de las montañas y a los lugares de lluvia (valles) para huir con su religión de las aflicciones.\"";
"discovery.card.sunnah_bukhari_19.source" = "Sahih al-Bukhari 19";

"discovery.card.sunnah_bukhari_24.title" = "Sahih al-Bujari 24";
"discovery.card.sunnah_bukhari_24.meaning" = "Relató 'Abdullah (bin 'Umar): Una vez el Mensajero de Allah (ﷺ) pasó junto a un Ansari (hombre) que reprendía a su hermano respecto a Haya'. Entonces el Mensajero de Allah (ﷺ) dijo: \"Déjalo, pues Haya' forma parte de la fe.\"";
"discovery.card.sunnah_bukhari_24.source" = "Sahih al-Bukhari 24";

"discovery.card.sunnah_bukhari_28.title" = "Sahih al-Bujari 28";
"discovery.card.sunnah_bukhari_28.meaning" = "Relató 'Abdullah bin 'Amr: Una persona preguntó al Mensajero de Allah (ﷺ): \"¿Qué (clase de) obras en o (qué cualidades del) islam son buenas?\" Él respondió: \"Dar de comer (a los pobres) y saludar a quienes conoces y a quienes no conoces.\"";
"discovery.card.sunnah_bukhari_28.source" = "Sahih al-Bukhari 28";

"discovery.card.sunnah_bukhari_35.title" = "Sahih al-Bujari 35";
"discovery.card.sunnah_bukhari_35.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) dijo: \"Quien realiza las oraciones en la noche de Qadr con fe sincera y con la esperanza de alcanzar las recompensas de Allah (no para hacerse notar), todos sus pecados pasados le serán perdonados.\"";
"discovery.card.sunnah_bukhari_35.source" = "Sahih al-Bukhari 35";

"discovery.card.sunnah_bukhari_37.title" = "Sahih al-Bujari 37";
"discovery.card.sunnah_bukhari_37.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) dijo: \"Quien realiza las oraciones durante las noches de Ramadán fielmente, con fe sincera y con la esperanza de alcanzar las recompensas de Allah (no para hacerse notar), todos sus pecados pasados le serán perdonados.\"";
"discovery.card.sunnah_bukhari_37.source" = "Sahih al-Bukhari 37";

"discovery.card.sunnah_bukhari_38.title" = "Sahih al-Bujari 38";
"discovery.card.sunnah_bukhari_38.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) dijo: \"Quien observa los ayunos durante el mes de Ramadán con fe sincera y con la esperanza de alcanzar las recompensas de Allah, todos sus pecados pasados le serán perdonados.\"";
"discovery.card.sunnah_bukhari_38.source" = "Sahih al-Bukhari 38";

"discovery.card.sunnah_bukhari_42.title" = "Sahih al-Bujari 42";
"discovery.card.sunnah_bukhari_42.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) dijo: \"Si alguno de vosotros mejora (sigue estrictamente) su religión islámica, entonces sus buenas obras serán recompensadas de diez a setecientas veces por cada buena obra, y una mala obra se registrará tal como es.\"";
"discovery.card.sunnah_bukhari_42.source" = "Sahih al-Bukhari 42";

"discovery.card.sunnah_bukhari_48.title" = "Sahih al-Bujari 48";
"discovery.card.sunnah_bukhari_48.meaning" = "Relató 'Abdullah: El Profeta (ﷺ) dijo: \"Insultar a un musulmán es Fusuq (una mala acción) y matarlo es Kufr (incredulidad).\"";
"discovery.card.sunnah_bukhari_48.source" = "Sahih al-Bukhari 48";

"discovery.card.sunnah_bukhari_55.title" = "Sahih al-Bujari 55";
"discovery.card.sunnah_bukhari_55.meaning" = "Relató Abu Mas'ud: El Profeta (ﷺ) dijo: \"Si un hombre gasta en su familia (con la intención de obtener una recompensa de Allah) sinceramente por Allah, entonces eso es (una especie de) limosna como recompensa para él.\"";
"discovery.card.sunnah_bukhari_55.source" = "Sahih al-Bukhari 55";

"discovery.card.sunnah_bukhari_56.title" = "Sahih al-Bujari 56";
"discovery.card.sunnah_bukhari_56.meaning" = "Relató Sa'd bin Abi Waqqas: El Mensajero de Allah (ﷺ) dijo: \"Serás recompensado por todo lo que gastes por Allah, aunque sea un bocado que pongas en la boca de tu esposa.\"";
"discovery.card.sunnah_bukhari_56.source" = "Sahih al-Bukhari 56";

"discovery.card.sunnah_bukhari_57.title" = "Sahih al-Bujari 57";
"discovery.card.sunnah_bukhari_57.meaning" = "Relató Jarir bin Abdullah: Di el juramento de fidelidad al Mensajero de Allah (ﷺ) por lo siguiente: 1. cumplir las oraciones perfectamente 2. pagar el Zakat (caridad obligatoria) 3. y ser sincero y leal con cada musulmán.";
"discovery.card.sunnah_bukhari_57.source" = "Sahih al-Bukhari 57";

"discovery.card.sunnah_bukhari_68.title" = "Sahih al-Bujari 68";
"discovery.card.sunnah_bukhari_68.meaning" = "Relató Ibn Mas`ud: El Profeta (ﷺ) cuidaba de nosotros al predicar eligiendo un momento adecuado, para que no nos aburriéramos. (Se abstenía de importunarnos todo el tiempo con sermones y conocimiento.)";
"discovery.card.sunnah_bukhari_68.source" = "Sahih al-Bukhari 68";

"discovery.card.sunnah_bukhari_69.title" = "Sahih al-Bujari 69";
"discovery.card.sunnah_bukhari_69.meaning" = "Relató Anas bin Malik: El Profeta (ﷺ) dijo: \"Facilitad las cosas a la gente (en asuntos religiosos), y no se las hagáis difíciles, dadles buenas nuevas y no los hagáis huir (del islam).\"";
"discovery.card.sunnah_bukhari_69.source" = "Sahih al-Bukhari 69";

"discovery.card.sunnah_bukhari_75.title" = "Sahih al-Bujari 75";
"discovery.card.sunnah_bukhari_75.meaning" = "Relató Ibn `Abbas: Una vez el Profeta (ﷺ) me abrazó y dijo: \"¡Oh Allah! Concédele el conocimiento del Libro (el Corán).\"";
"discovery.card.sunnah_bukhari_75.source" = "Sahih al-Bukhari 75";

"discovery.card.sunnah_bukhari_77.title" = "Sahih al-Bujari 77";
"discovery.card.sunnah_bukhari_77.meaning" = "Relató Mahmud bin Rabi`a: Cuando yo era un niño de cinco años, recuerdo que el Profeta (ﷺ) tomó agua de un cubo (usado para sacar agua de un pozo) con la boca y la lanzó sobre mi rostro.";
"discovery.card.sunnah_bukhari_77.source" = "Sahih al-Bukhari 77";

"discovery.card.sunnah_bukhari_94.title" = "Sahih al-Bujari 94";
"discovery.card.sunnah_bukhari_94.meaning" = "Relató Anas: Siempre que el Profeta (ﷺ) pedía permiso para entrar, golpeaba la puerta tres veces con el saludo, y siempre que decía una frase (decía algo) solía repetirla tres veces.";
"discovery.card.sunnah_bukhari_94.source" = "Sahih al-Bukhari 94";

"discovery.card.sunnah_bukhari_95.title" = "Sahih al-Bujari 95";
"discovery.card.sunnah_bukhari_95.meaning" = "Relató Anas: Siempre que el Profeta (ﷺ) decía una frase (decía algo), solía repetirla tres veces para que la gente pudiera entenderla bien de él, y siempre que pedía permiso para entrar, (golpeaba la puerta) tres veces con el saludo.";
"discovery.card.sunnah_bukhari_95.source" = "Sahih al-Bukhari 95";

"discovery.card.sunnah_bukhari_102.title" = "Sahih al-Bujari 102";
"discovery.card.sunnah_bukhari_102.meaning" = "Relató Abu Sa`id Al-Khudri: como arriba (los subnarradores son diferentes). Abu Huraira precisó que los tres niños mencionados en el hadiz anterior no habían alcanzado la edad de cometer pecados (es decir, la edad de la pubertad).";
"discovery.card.sunnah_bukhari_102.source" = "Sahih al-Bukhari 102";

"discovery.card.sunnah_bukhari_106.title" = "Sahih al-Bujari 106";
"discovery.card.sunnah_bukhari_106.meaning" = "Relató `Ali: El Profeta (ﷺ) dijo: \"No mintáis acerca de mí, pues quien miente acerca de mí (intencionadamente) entrará ciertamente en el Fuego del Infierno.\"";
"discovery.card.sunnah_bukhari_106.source" = "Sahih al-Bukhari 106";

"discovery.card.sunnah_bukhari_108.title" = "Sahih al-Bujari 108";
"discovery.card.sunnah_bukhari_108.meaning" = "Relató Anas: Lo que me impide narraros un gran número de hadices es que el Profeta (ﷺ) dijo: \"Quien miente acerca de mí intencionadamente, que ocupe entonces (ciertamente) su asiento en el Fuego del Infierno.\"";
"discovery.card.sunnah_bukhari_108.source" = "Sahih al-Bukhari 108";

"discovery.card.sunnah_bukhari_109.title" = "Sahih al-Bujari 109";
"discovery.card.sunnah_bukhari_109.meaning" = "Relató Salama: Oí al Profeta (ﷺ) decir: \"Quien (intencionadamente) me atribuye lo que no he dicho, que ocupe entonces (ciertamente) su asiento en el Fuego del Infierno.\"";
"discovery.card.sunnah_bukhari_109.source" = "Sahih al-Bukhari 109";

"discovery.card.sunnah_bukhari_113.title" = "Sahih al-Bujari 113";
"discovery.card.sunnah_bukhari_113.meaning" = "Relató Abu Huraira: No hay nadie entre los compañeros del Profeta (ﷺ) que haya narrado más hadices que yo, excepto `Abdullah bin `Amr (bin Al-`As), que solía escribirlos, y yo nunca hice lo mismo.";
"discovery.card.sunnah_bukhari_113.source" = "Sahih al-Bukhari 113";

"discovery.card.sunnah_bukhari_120.title" = "Sahih al-Bujari 120";
"discovery.card.sunnah_bukhari_120.meaning" = "Relató Abu Huraira: He memorizado dos clases de conocimiento del Mensajero de Allah (ﷺ). He difundido una de ellas entre vosotros, y si difundiera la segunda, me cortarían la faringe (la garganta) (es decir, me matarían).";
"discovery.card.sunnah_bukhari_120.source" = "Sahih al-Bukhari 120";

"discovery.card.sunnah_bukhari_121.title" = "Sahih al-Bujari 121";
"discovery.card.sunnah_bukhari_121.meaning" = "Relató Jarir: El Profeta (ﷺ) me dijo durante Hajjat-al-Wida`: Que la gente guarde silencio y escuche. Luego dijo (dirigiéndose a la gente): \"No (os volváis infieles) recaigáis en la incredulidad después de mí golpeándoos los cuellos (cortándoos las gargantas) unos a otros (matándoos unos a otros).\"";
"discovery.card.sunnah_bukhari_121.source" = "Sahih al-Bukhari 121";

"discovery.card.sunnah_bukhari_127.title" = "Sahih al-Bujari 127";
"discovery.card.sunnah_bukhari_127.meaning" = "Relató Abu at-Tufail: La declaración mencionada arriba de `Ali.";
"discovery.card.sunnah_bukhari_127.source" = "Sahih al-Bukhari 127";

"discovery.card.sunnah_bukhari_132.title" = "Sahih al-Bujari 132";
"discovery.card.sunnah_bukhari_132.meaning" = "Relató `Ali: Solía tener con frecuencia una secreción uretral involuntaria, así que pedí a Al-Miqdad que preguntara al Profeta (ﷺ) al respecto. Al-Miqdad le preguntó y él respondió: \"Hay que realizar la ablución (después de ello).\"";
"discovery.card.sunnah_bukhari_132.source" = "Sahih al-Bukhari 132";

"discovery.card.sunnah_bukhari_137.title" = "Sahih al-Bujari 137";
"discovery.card.sunnah_bukhari_137.meaning" = "Relató `Abbad bin Tamim: Mi tío preguntó al Mensajero de Allah (ﷺ) acerca de una persona que imaginaba haber expulsado viento durante la oración. El Mensajero de Allah respondió: \"No debe dejar su oración a menos que oiga un sonido o huela algo.\"";
"discovery.card.sunnah_bukhari_137.source" = "Sahih al-Bukhari 137";

"discovery.card.sunnah_bukhari_142.title" = "Sahih al-Bujari 142";
"discovery.card.sunnah_bukhari_142.meaning" = "Relató Anas: Siempre que el Profeta (ﷺ) iba a hacer sus necesidades, decía: \"Allah-umma inni a`udhu bika minal khubuthi wal khaba'ith\", es decir: \"Oh Allah, busco refugio en Ti de todas las cosas ofensivas y malvadas (malas acciones y malos espíritus).\"";
"discovery.card.sunnah_bukhari_142.source" = "Sahih al-Bukhari 142";

"discovery.card.sunnah_bukhari_143.title" = "Sahih al-Bujari 143";
"discovery.card.sunnah_bukhari_143.meaning" = "Relató Ibn `Abbas: Una vez el Profeta (ﷺ) entró en un retrete y yo coloqué agua para su ablución. Preguntó: \"¿Quién la colocó?\" Se le informó debidamente y entonces dijo: \"¡Oh Allah! Haz de él (Ibn `Abbas) un sabio erudito en la religión (el islam).\"";
"discovery.card.sunnah_bukhari_143.source" = "Sahih al-Bukhari 143";

"discovery.card.sunnah_bukhari_144.title" = "Sahih al-Bujari 144";
"discovery.card.sunnah_bukhari_144.meaning" = "Relató Abu Aiyub Al-Ansari: El Mensajero de Allah (ﷺ) dijo: \"Si alguno de vosotros va a un espacio abierto para hacer sus necesidades, no debe ni mirar hacia la Qibla ni darle la espalda; debe orientarse hacia el este o hacia el oeste.\"";
"discovery.card.sunnah_bukhari_144.source" = "Sahih al-Bukhari 144";

"discovery.card.sunnah_bukhari_147.title" = "Sahih al-Bujari 147";
"discovery.card.sunnah_bukhari_147.meaning" = "Relató `Aisha: El Profeta (ﷺ) dijo a sus esposas: \"Se os permite salir a hacer vuestras necesidades.\"";
"discovery.card.sunnah_bukhari_147.source" = "Sahih al-Bukhari 147";

"discovery.card.sunnah_bukhari_148.title" = "Sahih al-Bujari 148";
"discovery.card.sunnah_bukhari_148.meaning" = "Relató `Abdullah bin `Umar: Subí al techo de la casa de Hafsa por un asunto y vi al Mensajero de Allah (ﷺ) haciendo sus necesidades orientado hacia Sham (Siria, Jordania, Palestina y el Líbano considerados como un solo país) de espaldas a la Qibla.";
"discovery.card.sunnah_bukhari_148.source" = "Sahih al-Bukhari 148";

"discovery.card.sunnah_bukhari_149.title" = "Sahih al-Bujari 149";
"discovery.card.sunnah_bukhari_149.meaning" = "Relató `Abdullah bin `Umar: Una vez subí al techo de nuestra casa y vi al Mensajero de Allah (ﷺ) haciendo sus necesidades sentado sobre dos ladrillos, orientado hacia Baitul-Maqdis (Jerusalén).";
"discovery.card.sunnah_bukhari_149.source" = "Sahih al-Bukhari 149";

"discovery.card.sunnah_bukhari_150.title" = "Sahih al-Bujari 150";
"discovery.card.sunnah_bukhari_150.meaning" = "Relató Anas bin Malik: Siempre que el Mensajero de Allah (ﷺ) iba a hacer sus necesidades, otro muchacho y yo lo acompañábamos con un recipiente lleno de agua. (Hisham comentó: \"Para que pudiera lavarse las partes íntimas con él.\")";
"discovery.card.sunnah_bukhari_150.source" = "Sahih al-Bukhari 150";

"discovery.card.sunnah_bukhari_151.title" = "Sahih al-Bujari 151";
"discovery.card.sunnah_bukhari_151.meaning" = "Relató Anas: Siempre que el Mensajero de Allah (ﷺ) iba a hacer sus necesidades, otro muchacho de entre nosotros y yo íbamos detrás de él con un recipiente lleno de agua.";
"discovery.card.sunnah_bukhari_151.source" = "Sahih al-Bukhari 151";

"discovery.card.sunnah_bukhari_153.title" = "Sahih al-Bujari 153";
"discovery.card.sunnah_bukhari_153.meaning" = "Relató Abu Qatada: El Mensajero de Allah (ﷺ) dijo: \"Siempre que alguno de vosotros beba agua, no debe respirar en el recipiente, y siempre que alguno de vosotros vaya a un retrete, no debe ni tocar su pene ni limpiarse las partes íntimas con la mano derecha.\"";
"discovery.card.sunnah_bukhari_153.source" = "Sahih al-Bukhari 153";

"discovery.card.sunnah_bukhari_154.title" = "Sahih al-Bujari 154";
"discovery.card.sunnah_bukhari_154.meaning" = "Relató Abu Qatada: El Profeta (ﷺ) dijo: \"Siempre que alguno de vosotros orine, no debe sujetar su pene ni limpiarse las partes íntimas con la mano derecha. (Y al beber) no se debe respirar en el recipiente.\"";
"discovery.card.sunnah_bukhari_154.source" = "Sahih al-Bukhari 154";

"discovery.card.sunnah_bukhari_157.title" = "Sahih al-Bujari 157";
"discovery.card.sunnah_bukhari_157.meaning" = "Relató Ibn `Abbas: El Profeta (ﷺ) realizó la ablución lavando las partes del cuerpo solo una vez.";
"discovery.card.sunnah_bukhari_157.source" = "Sahih al-Bukhari 157";

"discovery.card.sunnah_bukhari_158.title" = "Sahih al-Bujari 158";
"discovery.card.sunnah_bukhari_158.meaning" = "Relató `Abdullah bin Zaid: El Profeta (ﷺ) realizó la ablución lavando las partes del cuerpo dos veces.";
"discovery.card.sunnah_bukhari_158.source" = "Sahih al-Bukhari 158";

"discovery.card.sunnah_bukhari_161.title" = "Sahih al-Bujari 161";
"discovery.card.sunnah_bukhari_161.meaning" = "Relató Abu Huraira: El Profeta (ﷺ) dijo: \"Quien realiza la ablución debe limpiarse la nariz con agua metiendo agua en ella y luego soplándola, y quien se limpia las partes íntimas con piedras debe hacerlo con un número impar de piedras.\"";
"discovery.card.sunnah_bukhari_161.source" = "Sahih al-Bukhari 161";

"discovery.card.sunnah_bukhari_165.title" = "Sahih al-Bujari 165";
"discovery.card.sunnah_bukhari_165.meaning" = "Relató Muhammad Ibn Ziyad: Oí a Abu Huraira decir, mientras pasaba junto a nosotros cuando la gente hacía la ablución de un recipiente con agua: \"Realizad la ablución de forma perfecta y minuciosa, pues Abul-Qasim (el Profeta) dijo: 'Proteged vuestros talones del Fuego del Infierno.'\"";
"discovery.card.sunnah_bukhari_165.source" = "Sahih al-Bukhari 165";

"discovery.card.sunnah_bukhari_167.title" = "Sahih al-Bujari 167";
"discovery.card.sunnah_bukhari_167.meaning" = "Relató Um-`Atiya: Que el Profeta (ﷺ), en el momento de lavar a su hija fallecida, les había dicho: \"Empezad por el lado derecho, comenzando por aquellas partes que se lavan en la ablución.\"";
"discovery.card.sunnah_bukhari_167.source" = "Sahih al-Bukhari 167";

"discovery.card.sunnah_bukhari_168.title" = "Sahih al-Bujari 168";
"discovery.card.sunnah_bukhari_168.meaning" = "Relató `Aisha: Al Profeta (ﷺ) le gustaba empezar por el lado derecho al ponerse los zapatos, peinarse el cabello, limpiarse o lavarse, y al hacer cualquier otra cosa.";
"discovery.card.sunnah_bukhari_168.source" = "Sahih al-Bukhari 168";

"discovery.card.sunnah_bukhari_170.title" = "Sahih al-Bujari 170";
"discovery.card.sunnah_bukhari_170.meaning" = "Relató Ibn Seereen: Dije a `Abida: \"Tengo algunos cabellos del Profeta (ﷺ) que obtuve de Anas o de su familia.\" `Abida respondió: \"Sin duda, si tuviera un solo cabello de esos, me habría sido más querido que el mundo entero y cuanto hay en él.\"";
"discovery.card.sunnah_bukhari_170.source" = "Sahih al-Bukhari 170";

"discovery.card.sunnah_bukhari_171.title" = "Sahih al-Bujari 171";
"discovery.card.sunnah_bukhari_171.meaning" = "Relató Anas: Cuando el Mensajero de Allah (ﷺ) se hizo afeitar la cabeza, Abu Talha fue el primero en tomar algunos de sus cabellos.";
"discovery.card.sunnah_bukhari_171.source" = "Sahih al-Bukhari 171";

"discovery.card.sunnah_bukhari_172.title" = "Sahih al-Bujari 172";
"discovery.card.sunnah_bukhari_172.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) dijo: \"Si un perro bebe del recipiente de alguno de vosotros, es necesario lavarlo siete veces.\"";
"discovery.card.sunnah_bukhari_172.source" = "Sahih al-Bukhari 172";

"discovery.card.sunnah_bukhari_174.title" = "Sahih al-Bujari 174";
"discovery.card.sunnah_bukhari_174.meaning" = "Y relató Hamza bin 'Abdullah: Mi padre dijo: \"En vida del Mensajero de Allah, los perros solían orinar y pasar por las mezquitas (entrar y salir); no obstante, nunca se rociaba agua sobre ello (la orina del perro).\"";
"discovery.card.sunnah_bukhari_174.source" = "Sahih al-Bukhari 174";

"discovery.card.sunnah_bukhari_177.title" = "Sahih al-Bujari 177";
"discovery.card.sunnah_bukhari_177.meaning" = "Relató `Abbad bin Tamim: Mi tío dijo: El Profeta (ﷺ) dijo: \"Uno no debe dejar su oración a menos que oiga un sonido o huela algo.\"";
"discovery.card.sunnah_bukhari_177.source" = "Sahih al-Bukhari 177";

"discovery.card.sunnah_bukhari_178.title" = "Sahih al-Bujari 178";
"discovery.card.sunnah_bukhari_178.meaning" = "Relató `Ali: Tenía con frecuencia secreciones uretrales involuntarias y me daba vergüenza preguntar al Mensajero de Allah (ﷺ) al respecto. Así que pedí a Al-Miqdad bin Al-Aswad que le preguntara (al Profeta (ﷺ) ) sobre ello. Al-Miqdad le preguntó y él respondió: \"Hay que realizar la ablución (después de ello).\"";
"discovery.card.sunnah_bukhari_178.source" = "Sahih al-Bukhari 178";

"discovery.card.sunnah_bukhari_188.title" = "Sahih al-Bujari 188";
"discovery.card.sunnah_bukhari_188.meaning" = "Abu Musa dijo: El Profeta pidió un vaso con agua, se lavó en él las manos y el rostro, luego arrojó un sorbo de agua en el vaso y nos dijo a ambos (Abu Musa y Bilal): \"Bebed del vaso y derramad un poco de su agua sobre vuestros rostros y pechos.\"";
"discovery.card.sunnah_bukhari_188.source" = "Sahih al-Bukhari 188";

"discovery.card.sunnah_bukhari_193.title" = "Sahih al-Bujari 193";
"discovery.card.sunnah_bukhari_193.meaning" = "Relató 'Abdullah bin 'Umar: \"En vida del Mensajero de Allah (ﷺ) los hombres y las mujeres hacían la ablución juntos.\"";
"discovery.card.sunnah_bukhari_193.source" = "Sahih al-Bukhari 193";

"discovery.card.sunnah_bukhari_196.title" = "Sahih al-Bujari 196";
"discovery.card.sunnah_bukhari_196.meaning" = "Relató Abu Musa: Una vez el Profeta (ﷺ) pidió un vaso con agua. Se lavó en él las manos y el rostro y también arrojó en él un sorbo de agua.";
"discovery.card.sunnah_bukhari_196.source" = "Sahih al-Bukhari 196";

"discovery.card.sunnah_bukhari_201.title" = "Sahih al-Bujari 201";
"discovery.card.sunnah_bukhari_201.meaning" = "Relató Anas: El Profeta (ﷺ) se bañaba con un Sa` hasta cinco Mudds (1 Sa` = [??] Mudds) de agua y hacía la ablución con un Mudd de agua.";
"discovery.card.sunnah_bukhari_201.source" = "Sahih al-Bukhari 201";

"discovery.card.sunnah_bukhari_204.title" = "Sahih al-Bujari 204";
"discovery.card.sunnah_bukhari_204.meaning" = "Relató Ja`far bin `Amr bin Umaiya Ad-Damri: Mi padre dijo: \"Vi al Profeta (ﷺ) pasar las manos mojadas sobre sus khuffs (calcetines de tela gruesa o de cuero).\"";
"discovery.card.sunnah_bukhari_204.source" = "Sahih al-Bukhari 204";

"discovery.card.sunnah_bukhari_205.title" = "Sahih al-Bujari 205";
"discovery.card.sunnah_bukhari_205.meaning" = "Relató Ja`far bin `Amr: Mi padre dijo: \"Vi al Profeta (ﷺ) pasar las manos mojadas sobre su turbante y sus khuffs (calcetines de tela gruesa o de cuero).\"";
"discovery.card.sunnah_bukhari_205.source" = "Sahih al-Bukhari 205";

"discovery.card.sunnah_bukhari_207.title" = "Sahih al-Bujari 207";
"discovery.card.sunnah_bukhari_207.meaning" = "Relató `Abdullah bin `Abbas: El Mensajero de Allah (ﷺ) comió un trozo de cordero cocido de la región del hombro y oró sin repetir la ablución.";
"discovery.card.sunnah_bukhari_207.source" = "Sahih al-Bukhari 207";

"discovery.card.sunnah_bukhari_208.title" = "Sahih al-Bujari 208";
"discovery.card.sunnah_bukhari_208.meaning" = "Relató Ja`far bin `Amr bin Umaiya: Mi padre dijo: \"Vi al Mensajero de Allah (ﷺ) tomar un trozo de cordero (cocido) de la región del hombro y entonces lo llamaron a la oración. Dejó el cuchillo y oró sin repetir la ablución.\"";
"discovery.card.sunnah_bukhari_208.source" = "Sahih al-Bukhari 208";

"discovery.card.sunnah_bukhari_210.title" = "Sahih al-Bujari 210";
"discovery.card.sunnah_bukhari_210.meaning" = "Relató Maimuna: El Profeta (ﷺ) comió (un trozo de) cordero de la región del hombro y luego oró sin repetir la ablución.";
"discovery.card.sunnah_bukhari_210.source" = "Sahih al-Bukhari 210";

"discovery.card.sunnah_bukhari_211.title" = "Sahih al-Bujari 211";
"discovery.card.sunnah_bukhari_211.meaning" = "Relató Ibn `Abbas: El Mensajero de Allah (ﷺ) bebió leche, se enjuagó la boca y dijo: \"Tiene grasa.\"";
"discovery.card.sunnah_bukhari_211.source" = "Sahih al-Bukhari 211";

"discovery.card.sunnah_bukhari_212.title" = "Sahih al-Bujari 212";
"discovery.card.sunnah_bukhari_212.meaning" = "Relató `Aisha: El Mensajero de Allah (ﷺ) dijo: \"Si alguno de vosotros siente somnolencia mientras ora, que se acueste (a dormir) hasta que se le pase el sueño, porque quien ora somnoliento no sabe si pide perdón o si pide algo malo para sí mismo.\"";
"discovery.card.sunnah_bukhari_212.source" = "Sahih al-Bukhari 212";

"discovery.card.sunnah_bukhari_213.title" = "Sahih al-Bujari 213";
"discovery.card.sunnah_bukhari_213.meaning" = "Relató Anas: El Profeta (ﷺ) dijo: \"Si alguno de vosotros siente somnolencia mientras ora, que duerma hasta que comprenda lo que está diciendo (recitando).\"";
"discovery.card.sunnah_bukhari_213.source" = "Sahih al-Bukhari 213";

"discovery.card.sunnah_bukhari_214.title" = "Sahih al-Bujari 214";
"discovery.card.sunnah_bukhari_214.meaning" = "Relató `Amr bin `Amir: Anas dijo: \"El Profeta (ﷺ) hacía la ablución para cada oración.\" Pregunté a Anas: \"¿Qué solíais hacer vosotros?\" Anas respondió: \"Orábamos con la misma ablución hasta que la invalidábamos con un hadath.\"";
"discovery.card.sunnah_bukhari_214.source" = "Sahih al-Bukhari 214";

"discovery.card.sunnah_bukhari_217.title" = "Sahih al-Bujari 217";
"discovery.card.sunnah_bukhari_217.meaning" = "Relató Anas bin Malik: Cada vez que el Profeta (ﷺ) iba a satisfacer una necesidad natural, yo le llevaba agua con la que se limpiaba las partes íntimas.";
"discovery.card.sunnah_bukhari_217.source" = "Sahih al-Bukhari 217";

"discovery.card.sunnah_bukhari_219.title" = "Sahih al-Bujari 219";
"discovery.card.sunnah_bukhari_219.meaning" = "Relató Anas bin Malik: El Profeta (ﷺ) vio a un beduino orinando en la mezquita y dijo a la gente que no lo molestara. Cuando terminó, el Profeta (ﷺ) pidió un poco de agua y la vertió sobre (la orina).";
"discovery.card.sunnah_bukhari_219.source" = "Sahih al-Bukhari 219";

"discovery.card.sunnah_bukhari_221.title" = "Sahih al-Bujari 221";
"discovery.card.sunnah_bukhari_221.meaning" = "Relató Anas bin Malik: El Profeta (ﷺ) dijo lo mismo que arriba.";
"discovery.card.sunnah_bukhari_221.source" = "Sahih al-Bukhari 221";

"discovery.card.sunnah_bukhari_222.title" = "Sahih al-Bujari 222";
"discovery.card.sunnah_bukhari_222.meaning" = "Relató `Aisha: (la madre de los creyentes) Trajeron a un niño ante el Mensajero de Allah (ﷺ) y orinó sobre el vestido del Profeta. El Profeta (ﷺ) pidió agua y la vertió sobre el lugar manchado.";
"discovery.card.sunnah_bukhari_222.source" = "Sahih al-Bukhari 222";

"discovery.card.sunnah_bukhari_224.title" = "Sahih al-Bujari 224";
"discovery.card.sunnah_bukhari_224.meaning" = "Relató Hudhaifa: Una vez el Profeta (ﷺ) fue a los basureros de unas gentes y orinó de pie. Luego pidió agua, se la llevé y realizó la ablución.";
"discovery.card.sunnah_bukhari_224.source" = "Sahih al-Bukhari 224";

"discovery.card.sunnah_bukhari_225.title" = "Sahih al-Bujari 225";
"discovery.card.sunnah_bukhari_225.meaning" = "Relató Hudhaifa': El Profeta (ﷺ) y yo caminamos hasta que llegamos a los basureros de unas gentes. Se detuvo, como se detiene cualquiera de vosotros, detrás de un muro y orinó. Me alejé, pero me hizo señas para que me acercara. Así que me acerqué y me quedé cerca de su espalda hasta que terminó.";
"discovery.card.sunnah_bukhari_225.source" = "Sahih al-Bukhari 225";

"discovery.card.sunnah_bukhari_229.title" = "Sahih al-Bujari 229";
"discovery.card.sunnah_bukhari_229.meaning" = "Relató `Aisha: Yo lavaba las huellas de Janaba (semen) de la ropa del Profeta (ﷺ) y él iba a orar mientras aún había huellas de agua en ella (las manchas de agua aún se veían).";
"discovery.card.sunnah_bukhari_229.source" = "Sahih al-Bukhari 229";

"discovery.card.sunnah_bukhari_230.title" = "Sahih al-Bujari 230";
"discovery.card.sunnah_bukhari_230.meaning" = "Relató Sulaiman bin Yasar: Pregunté a `Aisha acerca de la ropa manchada de semen. Ella respondió: \"Yo lo lavaba de la ropa del Mensajero de Allah (ﷺ) y él iba a la oración mientras las manchas de agua aún se veían.\"";
"discovery.card.sunnah_bukhari_230.source" = "Sahih al-Bukhari 230";

"discovery.card.sunnah_bukhari_231.title" = "Sahih al-Bujari 231";
"discovery.card.sunnah_bukhari_231.meaning" = "Relató `Amr bin Maimun: Oí a Sulaiman bin Yasar hablar de la ropa manchada de semen. Dijo que `Aisha había dicho: \"Yo lo lavaba de la ropa del Mensajero de Allah (ﷺ) y él iba a las oraciones mientras las manchas de agua aún se veían en ella.\"";
"discovery.card.sunnah_bukhari_231.source" = "Sahih al-Bukhari 231";

"discovery.card.sunnah_bukhari_232.title" = "Sahih al-Bujari 232";
"discovery.card.sunnah_bukhari_232.meaning" = "Relató `Aishah: Yo lavaba el semen de la ropa del Profeta (ﷺ) y aun así veía una o más manchas en ella.";
"discovery.card.sunnah_bukhari_232.source" = "Sahih al-Bukhari 232";

"discovery.card.sunnah_bukhari_234.title" = "Sahih al-Bujari 234";
"discovery.card.sunnah_bukhari_234.meaning" = "Relató Anas: Antes de la construcción de la mezquita, el Profeta (ﷺ) oraba en los rediles de ovejas.";
"discovery.card.sunnah_bukhari_234.source" = "Sahih al-Bukhari 234";

"discovery.card.sunnah_bukhari_235.title" = "Sahih al-Bujari 235";
"discovery.card.sunnah_bukhari_235.meaning" = "Relató Maimuna: Se preguntó al Mensajero de Allah (ﷺ) acerca del ghee (mantequilla clarificada) en el que había caído un ratón. Dijo: \"Sacad el ratón, tirad el ghee que hay alrededor y usad el resto.\"";
"discovery.card.sunnah_bukhari_235.source" = "Sahih al-Bukhari 235";

"discovery.card.sunnah_bukhari_236.title" = "Sahih al-Bujari 236";
"discovery.card.sunnah_bukhari_236.meaning" = "Relató Maimuna: Se preguntó al Profeta (ﷺ) acerca del ghee en el que había caído un ratón. Dijo: \"Sacad el ratón y tirad el ghee que hay alrededor (y usad el resto).\"";
"discovery.card.sunnah_bukhari_236.source" = "Sahih al-Bukhari 236";

"discovery.card.sunnah_bukhari_237.title" = "Sahih al-Bujari 237";
"discovery.card.sunnah_bukhari_237.meaning" = "Relató Abu Huraira: El Profeta (ﷺ) dijo: \"Una herida que un musulmán reciba en la causa de Allah aparecerá el Día de la Resurrección tal como estaba en el momento de infligirse; la sangre fluirá de la herida, su color será el de la sangre, pero olerá a almizcle.\"";
"discovery.card.sunnah_bukhari_237.source" = "Sahih al-Bukhari 237";

"discovery.card.sunnah_bukhari_238.title" = "Sahih al-Bujari 238";
"discovery.card.sunnah_bukhari_238.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) dijo: \"Nosotros (los musulmanes) somos los últimos (en venir al mundo) pero (seremos) los primeros (el Día de la Resurrección).\"";
"discovery.card.sunnah_bukhari_238.source" = "Sahih al-Bukhari 238";

"discovery.card.sunnah_bukhari_239.title" = "Sahih al-Bujari 239";
"discovery.card.sunnah_bukhari_239.meaning" = "El mismo narrador dijo que el Profeta (ﷺ) había dicho: \"No debéis orinar en agua estancada que no fluye para luego (necesitar) lavaros en ella.\"";
"discovery.card.sunnah_bukhari_239.source" = "Sahih al-Bukhari 239";

"discovery.card.sunnah_bukhari_241.title" = "Sahih al-Bujari 241";
"discovery.card.sunnah_bukhari_241.meaning" = "Relató Anas: El Profeta (ﷺ) escupió una vez en su ropa.";
"discovery.card.sunnah_bukhari_241.source" = "Sahih al-Bukhari 241";

"discovery.card.sunnah_bukhari_242.title" = "Sahih al-Bujari 242";
"discovery.card.sunnah_bukhari_242.meaning" = "Relató Aisha: El Profeta (ﷺ) dijo: \"Todas las bebidas que producen embriaguez son haram (prohibidas de beber).\"";
"discovery.card.sunnah_bukhari_242.source" = "Sahih al-Bukhari 242";

"discovery.card.sunnah_bukhari_250.title" = "Sahih al-Bujari 250";
"discovery.card.sunnah_bukhari_250.meaning" = "Relató `Aisha: El Profeta (ﷺ) y yo nos bañábamos de un solo recipiente llamado Faraq.";
"discovery.card.sunnah_bukhari_250.source" = "Sahih al-Bukhari 250";

"discovery.card.sunnah_bukhari_251.title" = "Sahih al-Bujari 251";
"discovery.card.sunnah_bukhari_251.meaning" = "Relató Abu Salama: El hermano de `Aisha y yo fuimos a ver a `Aisha y él le preguntó acerca del baño del Profeta. Ella trajo un recipiente con aproximadamente un Sa` de agua, se bañó y se lo vertió sobre la cabeza, y en ese momento había una pantalla entre ella y nosotros.";
"discovery.card.sunnah_bukhari_251.source" = "Sahih al-Bukhari 251";

"discovery.card.sunnah_bukhari_253.title" = "Sahih al-Bujari 253";
"discovery.card.sunnah_bukhari_253.meaning" = "Relató Ibn `Abbas: El Profeta (ﷺ) y Maimuna se bañaban de un solo recipiente.";
"discovery.card.sunnah_bukhari_253.source" = "Sahih al-Bukhari 253";

"discovery.card.sunnah_bukhari_254.title" = "Sahih al-Bujari 254";
"discovery.card.sunnah_bukhari_254.meaning" = "Relató Jubair bin Mut`im: El Mensajero de Allah (ﷺ) dijo: \"En cuanto a mí, vierto agua tres veces sobre mi cabeza.\" Y señaló con ambas manos.";
"discovery.card.sunnah_bukhari_254.source" = "Sahih al-Bukhari 254";

"discovery.card.sunnah_bukhari_255.title" = "Sahih al-Bujari 255";
"discovery.card.sunnah_bukhari_255.meaning" = "Relató Jabir bin `Abdullah: El Profeta (ﷺ) vertía agua tres veces sobre su cabeza.";
"discovery.card.sunnah_bukhari_255.source" = "Sahih al-Bukhari 255";

"discovery.card.sunnah_bukhari_261.title" = "Sahih al-Bujari 261";
"discovery.card.sunnah_bukhari_261.meaning" = "Relató Aisha: El Profeta (ﷺ) y yo nos bañábamos de un solo recipiente de agua y nuestras manos entraban en el recipiente una tras otra por turnos.";
"discovery.card.sunnah_bukhari_261.source" = "Sahih al-Bukhari 261";

"discovery.card.sunnah_bukhari_262.title" = "Sahih al-Bujari 262";
"discovery.card.sunnah_bukhari_262.meaning" = "Relató `Aisha: Cada vez que el Mensajero de Allah (ﷺ) tomaba el baño de Janaba, se lavaba primero las manos.";
"discovery.card.sunnah_bukhari_262.source" = "Sahih al-Bukhari 262";

"discovery.card.sunnah_bukhari_263.title" = "Sahih al-Bujari 263";
"discovery.card.sunnah_bukhari_263.meaning" = "Relató `Aisha: El Profeta (ﷺ) y yo nos bañábamos de un solo recipiente de agua después de la Janaba.";
"discovery.card.sunnah_bukhari_263.source" = "Sahih al-Bukhari 263";

"discovery.card.sunnah_bukhari_264.title" = "Sahih al-Bujari 264";
"discovery.card.sunnah_bukhari_264.meaning" = "Relató Anas bin Malik: El Profeta (ﷺ) y una de sus esposas se bañaban de un solo recipiente de agua. (Shu`ba añadió a la declaración de Anas: \"Después de la Janaba.\")";
"discovery.card.sunnah_bukhari_264.source" = "Sahih al-Bukhari 264";

"discovery.card.sunnah_bukhari_269.title" = "Sahih al-Bujari 269";
"discovery.card.sunnah_bukhari_269.meaning" = "Relató `Ali: Tenía con frecuencia secreción uretral involuntaria. Siendo yerno del Profeta (ﷺ), pedí a un hombre que le preguntara al respecto. El hombre preguntó al Profeta (ﷺ) sobre ello. El Profeta (ﷺ) respondió: \"Haz la ablución después de lavar tu órgano (pene).\"";
"discovery.card.sunnah_bukhari_269.source" = "Sahih al-Bukhari 269";

"discovery.card.sunnah_bukhari_271.title" = "Sahih al-Bujari 271";
"discovery.card.sunnah_bukhari_271.meaning" = "Relató `Aisha: Es como si aún viera el brillo del perfume en la raya del cabello del Profeta mientras estaba Muhrim.";
"discovery.card.sunnah_bukhari_271.source" = "Sahih al-Bukhari 271";

"discovery.card.sunnah_bukhari_277.title" = "Sahih al-Bujari 277";
"discovery.card.sunnah_bukhari_277.meaning" = "Relató Aisha: Cada vez que alguna de nosotras estaba Junub, vertía agua sobre su cabeza tres veces con ambas manos y luego frotaba el lado derecho de su cabeza con una mano y el lado izquierdo de la cabeza con la otra mano.";
"discovery.card.sunnah_bukhari_277.source" = "Sahih al-Bukhari 277";

"discovery.card.sunnah_bukhari_280.title" = "Sahih al-Bujari 280";
"discovery.card.sunnah_bukhari_280.meaning" = "Relató Um Hani bint Abi Talib: Fui al Mensajero de Allah (ﷺ) el año de la conquista de La Meca y lo encontré bañándose mientras Fatima lo cubría. El Profeta (ﷺ) preguntó: \"¿Quién es?\" Respondí: \"Soy Um-Hani.\"";
"discovery.card.sunnah_bukhari_280.source" = "Sahih al-Bukhari 280";

"discovery.card.sunnah_bukhari_284.title" = "Sahih al-Bujari 284";
"discovery.card.sunnah_bukhari_284.meaning" = "Relató Anas bin Malik: El Profeta (ﷺ) visitaba a todas sus esposas en una sola noche, y entonces tenía nueve esposas.";
"discovery.card.sunnah_bukhari_284.source" = "Sahih al-Bukhari 284";

"discovery.card.sunnah_bukhari_286.title" = "Sahih al-Bujari 286";
"discovery.card.sunnah_bukhari_286.meaning" = "Relató Abu Salama: Pregunté a `Aisha: \"¿Solía el Profeta (ﷺ) dormir mientras estaba Junub?\" Ella respondió: \"Sí, pero hacía la ablución (antes de acostarse).\"";
"discovery.card.sunnah_bukhari_286.source" = "Sahih al-Bukhari 286";

"discovery.card.sunnah_bukhari_287.title" = "Sahih al-Bujari 287";
"discovery.card.sunnah_bukhari_287.meaning" = "Relató `Umar bin Al-Khattab: Pregunté al Mensajero de Allah (ﷺ): \"¿Puede alguno de nosotros dormir mientras está Junub?\" Él respondió: \"Sí, si hace la ablución, puede dormir mientras está Junub.\"";
"discovery.card.sunnah_bukhari_287.source" = "Sahih al-Bukhari 287";

"discovery.card.sunnah_bukhari_288.title" = "Sahih al-Bujari 288";
"discovery.card.sunnah_bukhari_288.meaning" = "Relató `Aisha: Cuando el Profeta (ﷺ) pretendía dormir mientras estaba Junub, se lavaba las partes íntimas y hacía la ablución como para la oración.";
"discovery.card.sunnah_bukhari_288.source" = "Sahih al-Bukhari 288";

"discovery.card.sunnah_bukhari_289.title" = "Sahih al-Bujari 289";
"discovery.card.sunnah_bukhari_289.meaning" = "Relató `Abdullah: `Umar preguntó al Profeta (ﷺ): \"¿Puede alguno de nosotros dormir mientras está Junub?\" Él respondió: \"Sí, si hace la ablución.\"";
"discovery.card.sunnah_bukhari_289.source" = "Sahih al-Bukhari 289";

"discovery.card.sunnah_bukhari_290.title" = "Sahih al-Bujari 290";
"discovery.card.sunnah_bukhari_290.meaning" = "Relató `Abdullah bin `Umar: `Umar bin Al-Khattab dijo al Mensajero de Allah (ﷺ): \"Me volví Junub por la noche.\" El Mensajero de Allah (ﷺ) respondió: \"Haz la ablución después de lavar tus partes íntimas y luego duerme.\"";
"discovery.card.sunnah_bukhari_290.source" = "Sahih al-Bukhari 290";

"discovery.card.sunnah_bukhari_291.title" = "Sahih al-Bujari 291";
"discovery.card.sunnah_bukhari_291.meaning" = "Relató Hisham: como el siguiente hadiz 290. Relató Abu Huraira: El Profeta (ﷺ) dijo: \"Cuando un hombre se sienta entre las cuatro partes de una mujer y tiene relación sexual con ella, el baño se vuelve obligatorio.\"";
"discovery.card.sunnah_bukhari_291.source" = "Sahih al-Bukhari 291";

"discovery.card.sunnah_bukhari_295.title" = "Sahih al-Bujari 295";
"discovery.card.sunnah_bukhari_295.meaning" = "Relató `Aisha: Mientras tenía la menstruación, peinaba el cabello del Mensajero de Allah (ﷺ).";
"discovery.card.sunnah_bukhari_295.source" = "Sahih al-Bukhari 295";

"discovery.card.sunnah_bukhari_297.title" = "Sahih al-Bujari 297";
"discovery.card.sunnah_bukhari_297.meaning" = "Relató `Aisha: El Profeta (ﷺ) se recostaba en mi regazo y recitaba el Corán mientras yo tenía la menstruación.";
"discovery.card.sunnah_bukhari_297.source" = "Sahih al-Bukhari 297";

"discovery.card.sunnah_bukhari_298.title" = "Sahih al-Bujari 298";
"discovery.card.sunnah_bukhari_298.meaning" = "Relató Um Salama: Mientras estaba recostada con el Profeta (ﷺ) bajo una sola manta de lana, me vino la menstruación. Me escabullí y me puse la ropa de la menstruación. Él dijo: \"¿Has tenido 'Nifas' (menstruación)?\" Respondí: \"Sí.\" Entonces me llamó y me hizo recostar con él bajo la misma manta.";
"discovery.card.sunnah_bukhari_298.source" = "Sahih al-Bukhari 298";

"discovery.card.sunnah_bukhari_303.title" = "Sahih al-Bujari 303";
"discovery.card.sunnah_bukhari_303.meaning" = "Relató Maimuna: Siempre que el Mensajero de Allah (ﷺ) quería acariciar a una de sus esposas durante la menstruación, le pedía que se pusiera un Izar.";
"discovery.card.sunnah_bukhari_303.source" = "Sahih al-Bukhari 303";

"discovery.card.sunnah_bukhari_310.title" = "Sahih al-Bujari 310";
"discovery.card.sunnah_bukhari_310.meaning" = "Relató `Aisha: Una de las esposas del Mensajero de Allah (ﷺ) se unió a él en I`tikaf y notó sangre y secreción amarillenta (de sus partes íntimas) y ponía un recipiente debajo de ella cuando oraba.";
"discovery.card.sunnah_bukhari_310.source" = "Sahih al-Bukhari 310";

"discovery.card.sunnah_bukhari_311.title" = "Sahih al-Bujari 311";
"discovery.card.sunnah_bukhari_311.meaning" = "Relató `Aisha: Una de las madres de los creyentes (es decir, las esposas del Profeta (ﷺ)) hizo I`tikaf mientras tenía sangrado entre dos menstruaciones.";
"discovery.card.sunnah_bukhari_311.source" = "Sahih al-Bukhari 311";

"discovery.card.sunnah_bukhari_312.title" = "Sahih al-Bujari 312";
"discovery.card.sunnah_bukhari_312.meaning" = "Relató `Aisha: Ninguna de nosotras tenía más de una sola prenda y la usábamos durante la menstruación. Cuando se manchaba con sangre menstrual, aplicábamos saliva sobre la mancha de sangre y frotábamos la sangre con las uñas.";
"discovery.card.sunnah_bukhari_312.source" = "Sahih al-Bukhari 312";

"discovery.card.sunnah_bukhari_323.title" = "Sahih al-Bujari 323";
"discovery.card.sunnah_bukhari_323.meaning" = "Relató Um Salama: Mientras estaba recostada con el Profeta (ﷺ) bajo una manta de lana, me vino la menstruación. Me escabullí y me puse la ropa de la menstruación. El Profeta (ﷺ) dijo: \"¿Te ha venido la menstruación?\" Respondí: \"Sí.\" Me llamó y dormí con él bajo la manta de lana.";
"discovery.card.sunnah_bukhari_323.source" = "Sahih al-Bukhari 323";

"discovery.card.sunnah_bukhari_326.title" = "Sahih al-Bujari 326";
"discovery.card.sunnah_bukhari_326.meaning" = "Relató Um `Atiya: Nunca consideramos las secreciones amarillentas como algo importante (como la menstruación).";
"discovery.card.sunnah_bukhari_326.source" = "Sahih al-Bukhari 326";

"discovery.card.sunnah_bukhari_328.title" = "Sahih al-Bujari 328";
"discovery.card.sunnah_bukhari_328.meaning" = "Relató `Aisha: (la esposa del Profeta) Dije al Mensajero de Allah (ﷺ) que Safiya bint Huyai había tenido la menstruación. Él dijo: \"Probablemente nos retrasará. ¿Realizó el Tawaf (Al-Ifada) con vosotras?\" Respondimos: \"Sí.\" Entonces el Profeta (ﷺ) le dijo que partiera.";
"discovery.card.sunnah_bukhari_328.source" = "Sahih al-Bukhari 328";

"discovery.card.sunnah_bukhari_331.title" = "Sahih al-Bujari 331";
"discovery.card.sunnah_bukhari_331.meaning" = "Relató `Aisha: El Profeta (ﷺ) me dijo: \"Deja la oración cuando comience tu menstruación y, cuando haya terminado, lava la sangre de tu cuerpo (tómate un baño) y empieza a orar.\"";
"discovery.card.sunnah_bukhari_331.source" = "Sahih al-Bukhari 331";

"discovery.card.sunnah_bukhari_332.title" = "Sahih al-Bujari 332";
"discovery.card.sunnah_bukhari_332.meaning" = "Relató Samura bin Jundub: El Profeta (ﷺ) ofreció la oración fúnebre por el cuerpo de una mujer que murió durante el parto y se colocó junto a la mitad de su cuerpo.";
"discovery.card.sunnah_bukhari_332.source" = "Sahih al-Bukhari 332";

"discovery.card.sunnah_bukhari_333.title" = "Sahih al-Bujari 333";
"discovery.card.sunnah_bukhari_333.meaning" = "Relató Maimuna: (la esposa del Profeta) Durante mi menstruación nunca oraba, pero me sentaba en la estera junto a la mezquita del Mensajero de Allah (ﷺ). Él ofrecía la oración sobre su sábana y, al prosternarse, algunas de sus prendas me tocaban.";
"discovery.card.sunnah_bukhari_333.source" = "Sahih al-Bukhari 333";

"discovery.card.sunnah_bukhari_340.title" = "Sahih al-Bujari 340";
"discovery.card.sunnah_bukhari_340.meaning" = "Relató `Abdur Rahman bin Abza: que mientras estaba en compañía de `Umar, `Ammar dijo a `Umar: \"Estábamos en un destacamento y nos volvimos Junub, y soplé el polvo de mis manos (me revolqué sobre la tierra y oré).\"";
"discovery.card.sunnah_bukhari_340.source" = "Sahih al-Bukhari 340";

"discovery.card.sunnah_bukhari_341.title" = "Sahih al-Bujari 341";
"discovery.card.sunnah_bukhari_341.meaning" = "Relató `Abdur Rahman bin Abza: `Ammar dijo a `Umar: \"Me revolqué en el polvo y fui al Profeta (ﷺ), quien dijo: 'Pasar las manos polvorientas sobre el rostro y el dorso de las manos te basta.'\"";
"discovery.card.sunnah_bukhari_341.source" = "Sahih al-Bukhari 341";

"discovery.card.sunnah_bukhari_343.title" = "Sahih al-Bujari 343";
"discovery.card.sunnah_bukhari_343.meaning" = "Relató `Ammar: El Profeta (ﷺ) golpeó la tierra con las manos y luego las pasó sobre su rostro y el dorso de sus manos (mientras demostraba el Tayammum).";
"discovery.card.sunnah_bukhari_343.source" = "Sahih al-Bukhari 343";

"discovery.card.sunnah_bukhari_353.title" = "Sahih al-Bujari 353";
"discovery.card.sunnah_bukhari_353.meaning" = "Relató Muhammad bin Al Munkadir: Vi a Jabir bin `Abdullah orar con una sola prenda y dijo que había visto al Profeta (ﷺ) orar con una sola prenda.";
"discovery.card.sunnah_bukhari_353.source" = "Sahih al-Bukhari 353";

"discovery.card.sunnah_bukhari_354.title" = "Sahih al-Bujari 354";
"discovery.card.sunnah_bukhari_354.meaning" = "Relató `Umar bin Abi Salama: El Profeta (ﷺ) oró con una sola prenda y cruzó sus extremos.";
"discovery.card.sunnah_bukhari_354.source" = "Sahih al-Bukhari 354";

"discovery.card.sunnah_bukhari_355.title" = "Sahih al-Bujari 355";
"discovery.card.sunnah_bukhari_355.meaning" = "Relató `Umar bin Abi Salama: Vi al Profeta (ﷺ) orar con una sola prenda en la casa de Um-Salama, y había cruzado sus extremos sobre los hombros.";
"discovery.card.sunnah_bukhari_355.source" = "Sahih al-Bukhari 355";

"discovery.card.sunnah_bukhari_356.title" = "Sahih al-Bujari 356";
"discovery.card.sunnah_bukhari_356.meaning" = "Relató `Umar bin Abi Salama: En la casa de Um-Salama vi al Mensajero de Allah (ﷺ) orar, envuelto en una sola prenda alrededor de su cuerpo, con los extremos cruzados sobre los hombros.";
"discovery.card.sunnah_bukhari_356.source" = "Sahih al-Bukhari 356";

"discovery.card.sunnah_bukhari_358.title" = "Sahih al-Bujari 358";
"discovery.card.sunnah_bukhari_358.meaning" = "Relató Abu Huraira: Una persona preguntó al Mensajero de Allah (ﷺ) acerca de ofrecer la oración con una sola prenda. El Mensajero de Allah (ﷺ) respondió: \"¿Acaso cada uno de vosotros tiene dos prendas?\"";
"discovery.card.sunnah_bukhari_358.source" = "Sahih al-Bukhari 358";

"discovery.card.sunnah_bukhari_359.title" = "Sahih al-Bujari 359";
"discovery.card.sunnah_bukhari_359.meaning" = "Relató Abu Huraira: El Profeta (ﷺ) dijo: \"Ninguno de vosotros debe orar con una sola prenda que no cubra los hombros.\"";
"discovery.card.sunnah_bukhari_359.source" = "Sahih al-Bukhari 359";

"discovery.card.sunnah_bukhari_360.title" = "Sahih al-Bujari 360";
"discovery.card.sunnah_bukhari_360.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) dijo: \"Quien ore con una sola prenda debe cruzar sus extremos (sobre los hombros).\"";
"discovery.card.sunnah_bukhari_360.source" = "Sahih al-Bukhari 360";

"discovery.card.sunnah_bukhari_362.title" = "Sahih al-Bujari 362";
"discovery.card.sunnah_bukhari_362.meaning" = "Relató Sahl: Los hombres oraban con el Profeta (ﷺ) con sus Izars atados alrededor del cuello, como solían hacer los muchachos; por eso el Profeta (ﷺ) dijo a las mujeres que no levantaran la cabeza hasta que los hombres se sentaran erguidos (durante la oración).";
"discovery.card.sunnah_bukhari_362.source" = "Sahih al-Bukhari 362";

"discovery.card.sunnah_bukhari_372.title" = "Sahih al-Bujari 372";
"discovery.card.sunnah_bukhari_372.meaning" = "Relató `Aisha: El Mensajero de Allah (ﷺ) ofrecía la oración del Fajr y algunas mujeres creyentes, cubiertas con sus velos, asistían a la oración del Fajr con él y luego regresaban a sus casas sin ser reconocidas.";
"discovery.card.sunnah_bukhari_372.source" = "Sahih al-Bukhari 372";

"discovery.card.sunnah_bukhari_375.title" = "Sahih al-Bujari 375";
"discovery.card.sunnah_bukhari_375.meaning" = "Relató `Uqba bin 'Amir: Se le dio al Profeta (ﷺ) un Farruj de seda como regalo. Lo llevó puesto mientras oraba. Cuando terminó su oración, se lo quitó bruscamente, como si sintiera una fuerte aversión hacia él, y dijo: \"No es la vestimenta de las personas piadosas que temen a Allah.\"";
"discovery.card.sunnah_bukhari_375.source" = "Sahih al-Bukhari 375";

"discovery.card.sunnah_bukhari_381.title" = "Sahih al-Bujari 381";
"discovery.card.sunnah_bukhari_381.meaning" = "Relató Maimuna: El Mensajero de Allah (ﷺ) solía orar sobre una Khumra.";
"discovery.card.sunnah_bukhari_381.source" = "Sahih al-Bukhari 381";

"discovery.card.sunnah_bukhari_383.title" = "Sahih al-Bujari 383";
"discovery.card.sunnah_bukhari_383.meaning" = "Relató `Aisha: El Mensajero de Allah oraba mientras yo estaba tendida como un cuerpo muerto sobre el lecho familiar, entre él y su Qibla.";
"discovery.card.sunnah_bukhari_383.source" = "Sahih al-Bukhari 383";

"discovery.card.sunnah_bukhari_384.title" = "Sahih al-Bujari 384";
"discovery.card.sunnah_bukhari_384.meaning" = "Relató `Urwa: El Profeta (ﷺ) oraba mientras `Aisha estaba tendida entre él y su Qibla sobre el lecho en el que solían dormir.";
"discovery.card.sunnah_bukhari_384.source" = "Sahih al-Bukhari 384";

"discovery.card.sunnah_bukhari_385.title" = "Sahih al-Bujari 385";
"discovery.card.sunnah_bukhari_385.meaning" = "Relató Anas bin Malik: Solíamos orar con el Profeta (ﷺ) y algunos de nosotros colocábamos los extremos de nuestras prendas en el lugar de la prosternación a causa del calor abrasador.";
"discovery.card.sunnah_bukhari_385.source" = "Sahih al-Bukhari 385";

"discovery.card.sunnah_bukhari_386.title" = "Sahih al-Bujari 386";
"discovery.card.sunnah_bukhari_386.meaning" = "Relató Abu Maslama: Sa`id bin Yazid Al-Azdi: Pregunté a Anas bin Malik si el Profeta (ﷺ) había orado alguna vez con los zapatos puestos. Él respondió: \"Sí.\"";
"discovery.card.sunnah_bukhari_386.source" = "Sahih al-Bukhari 386";

"discovery.card.sunnah_bukhari_388.title" = "Sahih al-Bujari 388";
"discovery.card.sunnah_bukhari_388.meaning" = "Relató Al-Mughira bin Shu'ba: Ayudé al Profeta (ﷺ) a realizar la ablución y pasó sus manos húmedas sobre sus Khuffs y oró.";
"discovery.card.sunnah_bukhari_388.source" = "Sahih al-Bukhari 388";

"discovery.card.sunnah_bukhari_390.title" = "Sahih al-Bujari 390";
"discovery.card.sunnah_bukhari_390.meaning" = "Relató 'Abdullah bin Malik: Ibn Buhaina, \"Cuando el Profeta (ﷺ) oraba, separaba los brazos de su cuerpo tan ampliamente que se veía la blancura de sus axilas.\"";
"discovery.card.sunnah_bukhari_390.source" = "Sahih al-Bukhari 390";

"discovery.card.sunnah_bukhari_391.title" = "Sahih al-Bujari 391";
"discovery.card.sunnah_bukhari_391.meaning" = "Relató Anas bin Malik: El Mensajero de Allah (ﷺ) dijo: \"Quien ore como nosotros, se oriente hacia nuestra Qibla y coma de nuestros animales sacrificados es musulmán y está bajo la protección de Allah y de Su Mensajero. Así pues, no traicionéis a Allah traicionando a quienes están bajo Su protección.\"";
"discovery.card.sunnah_bukhari_391.source" = "Sahih al-Bukhari 391";

"discovery.card.sunnah_bukhari_398.title" = "Sahih al-Bujari 398";
"discovery.card.sunnah_bukhari_398.meaning" = "Relató Ibn `Abbas: Cuando el Profeta (ﷺ) entró en la Ka`ba, invocó a Allah en cada uno de sus lados y no oró hasta que salió; luego ofreció una oración de dos rak`at orientado hacia la Ka`ba y dijo: \"Esta es la Qibla.\"";
"discovery.card.sunnah_bukhari_398.source" = "Sahih al-Bukhari 398";

"discovery.card.sunnah_bukhari_400.title" = "Sahih al-Bujari 400";
"discovery.card.sunnah_bukhari_400.meaning" = "Relató Jabir: El Mensajero de Allah (ﷺ) solía orar (oración voluntaria, no obligatoria) montado en su cabalgadura (Rahila), hacia dondequiera que esta se volviera, y cuando quería hacer la oración obligatoria, desmontaba y oraba orientado hacia la Qibla.";
"discovery.card.sunnah_bukhari_400.source" = "Sahih al-Bukhari 400";

"discovery.card.sunnah_bukhari_404.title" = "Sahih al-Bujari 404";
"discovery.card.sunnah_bukhari_404.meaning" = "Relató `Abdullah: Una vez el Profeta (ﷺ) ofreció cinco rak`at en la oración del Zuhr. Se le preguntó: \"¿Hay un aumento en la oración?\" El Profeta (ﷺ) dijo: \"¿Y qué es eso?\" Dijeron: \"Has orado cinco rak`at.\" Entonces dobló las piernas y realizó dos prosternaciones (de Sahu).";
"discovery.card.sunnah_bukhari_404.source" = "Sahih al-Bukhari 404";

"discovery.card.sunnah_bukhari_407.title" = "Sahih al-Bujari 407";
"discovery.card.sunnah_bukhari_407.meaning" = "Relató `Aisha: (la madre de los creyentes) El Mensajero de Allah (ﷺ) vio secreciones nasales, expectoración o esputo en la pared de la mezquita en dirección a la Qibla y lo raspó.";
"discovery.card.sunnah_bukhari_407.source" = "Sahih al-Bukhari 407";

"discovery.card.sunnah_bukhari_412.title" = "Sahih al-Bujari 412";
"discovery.card.sunnah_bukhari_412.meaning" = "Relató Anas: El Profeta (ﷺ) dijo: \"Ninguno de vosotros debe escupir delante ni a su derecha, pero puede escupir a su izquierda o bajo su pie.\"";
"discovery.card.sunnah_bukhari_412.source" = "Sahih al-Bukhari 412";

"discovery.card.sunnah_bukhari_413.title" = "Sahih al-Bujari 413";
"discovery.card.sunnah_bukhari_413.meaning" = "Relató Anas bin Malik: El Profeta (ﷺ) dijo: \"Un creyente, mientras está en la oración, habla en privado con su Señor, así que no debe escupir delante de él ni a su derecha, pero puede escupir a su izquierda o bajo su pie.\"";
"discovery.card.sunnah_bukhari_413.source" = "Sahih al-Bukhari 413";

"discovery.card.sunnah_bukhari_414.title" = "Sahih al-Bujari 414";
"discovery.card.sunnah_bukhari_414.meaning" = "Relató Abu Sa`id: El Profeta (ﷺ) vio esputo en (la pared de) la mezquita en dirección a la Qibla y lo raspó con gravilla. Luego prohibió escupir delante o a la derecha, pero lo permitió a la izquierda o bajo el pie izquierdo.";
"discovery.card.sunnah_bukhari_414.source" = "Sahih al-Bukhari 414";

"discovery.card.sunnah_bukhari_415.title" = "Sahih al-Bujari 415";
"discovery.card.sunnah_bukhari_415.meaning" = "Relató Anas bin Malik: El Profeta (ﷺ) dijo: \"Escupir en la mezquita es un pecado y su expiación es enterrarlo.\"";
"discovery.card.sunnah_bukhari_415.source" = "Sahih al-Bukhari 415";

"discovery.card.sunnah_bukhari_418.title" = "Sahih al-Bujari 418";
"discovery.card.sunnah_bukhari_418.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) dijo: \"¿Acaso pensáis o veis que mi rostro está hacia la Qibla? Por Allah, ni vuestra humildad ni vuestra inclinación se me ocultan; ciertamente os veo desde mi espalda.\"";
"discovery.card.sunnah_bukhari_418.source" = "Sahih al-Bukhari 418";

"discovery.card.sunnah_bukhari_419.title" = "Sahih al-Bujari 419";
"discovery.card.sunnah_bukhari_419.meaning" = "Relató Anas bin Malik: El Profeta (ﷺ) nos dirigió en una oración y luego subió al púlpito y dijo: \"En vuestra oración y vuestra inclinación, ciertamente os veo desde mi espalda como os veo (al miraros).\"";
"discovery.card.sunnah_bukhari_419.source" = "Sahih al-Bukhari 419";

"discovery.card.sunnah_bukhari_422.title" = "Sahih al-Bujari 422";
"discovery.card.sunnah_bukhari_422.meaning" = "Relató Anas: Encontré al Profeta (ﷺ) en la mezquita junto con algunas personas. Me dijo: \"¿Te ha enviado Abu Talha?\" Dije: \"Sí.\" Dijo: \"¿Para una comida?\" Dije: \"Sí.\" Luego dijo a sus compañeros: \"Levantaos.\" Partieron y yo iba delante de ellos.";
"discovery.card.sunnah_bukhari_422.source" = "Sahih al-Bukhari 422";

"discovery.card.sunnah_bukhari_424.title" = "Sahih al-Bujari 424";
"discovery.card.sunnah_bukhari_424.meaning" = "Relató `Itban bin Malik: El Profeta (ﷺ) vino a mi casa y dijo: \"¿Dónde quieres que ore?\" Señalé un lugar. El Profeta dijo entonces: \"Allahu Akbar\", y nos alineamos detrás de él y ofreció una oración de dos rak`at.";
"discovery.card.sunnah_bukhari_424.source" = "Sahih al-Bukhari 424";

"discovery.card.sunnah_bukhari_426.title" = "Sahih al-Bujari 426";
"discovery.card.sunnah_bukhari_426.meaning" = "Relató `Aisha: El Profeta (ﷺ) solía empezar todo por la derecha (para las cosas buenas) siempre que fuera posible en todos sus asuntos; por ejemplo: al lavarse, peinarse o ponerse los zapatos.";
"discovery.card.sunnah_bukhari_426.source" = "Sahih al-Bukhari 426";

"discovery.card.sunnah_bukhari_429.title" = "Sahih al-Bujari 429";
"discovery.card.sunnah_bukhari_429.meaning" = "Relató Abu Al-Taiyah: Anas dijo: \"El Profeta (ﷺ) oró en el redil de ovejas.\" Más tarde le oí decir: \"Oró en los rediles de ovejas antes de la construcción de la mezquita.\"";
"discovery.card.sunnah_bukhari_429.source" = "Sahih al-Bukhari 429";

"discovery.card.sunnah_bukhari_430.title" = "Sahih al-Bujari 430";
"discovery.card.sunnah_bukhari_430.meaning" = "Relató Nafi`: Vi a Ibn `Umar orar tomando su camello como Sutra delante de él, y dijo: \"Vi al Profeta hacer lo mismo.\"";
"discovery.card.sunnah_bukhari_430.source" = "Sahih al-Bukhari 430";

"discovery.card.sunnah_bukhari_431.title" = "Sahih al-Bujari 431";
"discovery.card.sunnah_bukhari_431.meaning" = "Relató `Abdullah bin `Abbas: El sol se eclipsó y el Mensajero de Allah (ﷺ) ofreció la oración del eclipse y dijo: \"Se me ha mostrado el Fuego del Infierno (ahora) y nunca vi un espectáculo peor y más horrible que el que he visto hoy.\"";
"discovery.card.sunnah_bukhari_431.source" = "Sahih al-Bukhari 431";

"discovery.card.sunnah_bukhari_432.title" = "Sahih al-Bujari 432";
"discovery.card.sunnah_bukhari_432.meaning" = "Relató Ibn `Umar: El Profeta (ﷺ) había dicho: \"Ofreced algunas de vuestras oraciones (Nawafil) en casa, y no convirtáis vuestras casas en tumbas.\"";
"discovery.card.sunnah_bukhari_432.source" = "Sahih al-Bukhari 432";

"discovery.card.sunnah_bukhari_437.title" = "Sahih al-Bujari 437";
"discovery.card.sunnah_bukhari_437.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) dijo: \"Que la maldición de Allah recaiga sobre los judíos, pues construyeron los lugares de culto sobre las tumbas de sus Profetas.\"";
"discovery.card.sunnah_bukhari_437.source" = "Sahih al-Bukhari 437";

"discovery.card.sunnah_bukhari_440.title" = "Sahih al-Bujari 440";
"discovery.card.sunnah_bukhari_440.meaning" = "Relató Nafi`: `Abdullah bin `Umar dijo: Solía dormir en la mezquita del Profeta (ﷺ) cuando era joven y soltero.";
"discovery.card.sunnah_bukhari_440.source" = "Sahih al-Bukhari 440";

"discovery.card.sunnah_bukhari_443.title" = "Sahih al-Bujari 443";
"discovery.card.sunnah_bukhari_443.meaning" = "Relató Jabir bin `Abdullah: Fui al Profeta (ﷺ) en la mezquita (el subnarrador Mis`ar pensaba que Jabir había dicho: \"Por la mañana.\") Me ordenó orar dos rak`at. Me debía algo de dinero, me lo devolvió y me dio más de lo que me correspondía.";
"discovery.card.sunnah_bukhari_443.source" = "Sahih al-Bukhari 443";

"discovery.card.sunnah_bukhari_444.title" = "Sahih al-Bujari 444";
"discovery.card.sunnah_bukhari_444.meaning" = "Relató Abu Qatada Al-Aslami: El Mensajero de Allah (ﷺ) dijo: \"Si alguno de vosotros entra en una mezquita, debe orar dos rak`at antes de sentarse.\"";
"discovery.card.sunnah_bukhari_444.source" = "Sahih al-Bukhari 444";

"discovery.card.sunnah_bukhari_445.title" = "Sahih al-Bujari 445";
"discovery.card.sunnah_bukhari_445.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) dijo: \"Los ángeles siguen pidiendo a Allah el perdón por cualquiera de vosotros, mientras permanece en su Musalla (lugar de oración) y no expulsa gases (Hadath). Dicen: '¡Oh Allah! Perdónale, ¡oh Allah! Ten misericordia de él.'\"";
"discovery.card.sunnah_bukhari_445.source" = "Sahih al-Bukhari 445";

"discovery.card.sunnah_bukhari_448.title" = "Sahih al-Bujari 448";
"discovery.card.sunnah_bukhari_448.meaning" = "Relató Sahl: El Mensajero de Allah (ﷺ) envió a alguien a una mujer diciéndole: \"Ordena a su esclavo, carpintero, que prepare un púlpito de madera para que se siente en él.\"";
"discovery.card.sunnah_bukhari_448.source" = "Sahih al-Bukhari 448";

"discovery.card.sunnah_bukhari_449.title" = "Sahih al-Bujari 449";
"discovery.card.sunnah_bukhari_449.meaning" = "Relató Jabir: Una mujer dijo: \"¡Oh Mensajero de Allah (ﷺ)! ¿Hago construir algo para que te sientes, ya que tengo un esclavo que es carpintero?\" Él respondió: \"Sí, si quieres.\" Así que ella hizo construir aquel púlpito.";
"discovery.card.sunnah_bukhari_449.source" = "Sahih al-Bukhari 449";

"discovery.card.sunnah_bukhari_451.title" = "Sahih al-Bujari 451";
"discovery.card.sunnah_bukhari_451.meaning" = "Relató `Amr: Oí a Jabir bin `Abdullah decir: \"Un hombre pasó por la mezquita llevando flechas. El Mensajero de Allah ﷺ le dijo: 'Sujétalas por las puntas.'\"";
"discovery.card.sunnah_bukhari_451.source" = "Sahih al-Bukhari 451";

"discovery.card.sunnah_bukhari_452.title" = "Sahih al-Bujari 452";
"discovery.card.sunnah_bukhari_452.meaning" = "Relató Abu Burda bin `Abdullah: (por autoridad de su padre) El Profeta (ﷺ) dijo: \"Quien pase por nuestras mezquitas o mercados con flechas debe sujetarlas por las puntas para no herir a un musulmán.\"";
"discovery.card.sunnah_bukhari_452.source" = "Sahih al-Bukhari 452";

"discovery.card.sunnah_bukhari_453.title" = "Sahih al-Bujari 453";
"discovery.card.sunnah_bukhari_453.meaning" = "Relató Hassan bin Thabit Al-Ansari: Pregunté a Abu Huraira: \"¡Por Allah! Dime la verdad: ¿oíste al Profeta (ﷺ) decir: '¡Oh Hassan! Responde en nombre del Mensajero de Allah (ﷺ). ¡Oh Allah! Ayúdalo con el Espíritu Santo.'\" Abu Huraira dijo: \"Sí.\"";
"discovery.card.sunnah_bukhari_453.source" = "Sahih al-Bukhari 453";

"discovery.card.sunnah_bukhari_459.title" = "Sahih al-Bujari 459";
"discovery.card.sunnah_bukhari_459.meaning" = "Relató `Aisha: Cuando se revelaron los versículos de la sura \"Al-Baqara\" acerca de la usura (Riba), el Profeta (ﷺ) fue a la mezquita, los recitó ante la gente y luego prohibió el comercio del alcohol.";
"discovery.card.sunnah_bukhari_459.source" = "Sahih al-Bukhari 459";

"discovery.card.sunnah_bukhari_460.title" = "Sahih al-Bujari 460";
"discovery.card.sunnah_bukhari_460.meaning" = "Relató Abu Rafi: Abu Huraira dijo: \"Un hombre o una mujer solía limpiar la mezquita.\" (Un subnarrador dijo: 'Lo más probable es que fuera una mujer.') Luego relató el hadiz del Profeta.";
"discovery.card.sunnah_bukhari_460.source" = "Sahih al-Bukhari 460";

"discovery.card.sunnah_bukhari_464.title" = "Sahih al-Bujari 464";
"discovery.card.sunnah_bukhari_464.meaning" = "Relató Um Salama: Me quejé al Mensajero de Allah (ﷺ) de que estaba enferma. Me dijo que realizara el Tawaf detrás de la gente montada. Así lo hice, y el Mensajero de Allah (ﷺ) oraba junto a la Ka`ba y recitaba la sura que comienza con \"Wat-tur wa kitabin mastur\".";
"discovery.card.sunnah_bukhari_464.source" = "Sahih al-Bukhari 464";

"discovery.card.sunnah_bukhari_469.title" = "Sahih al-Bujari 469";
"discovery.card.sunnah_bukhari_469.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) envió jinetes a Najd y trajeron a un hombre llamado Thumama bin Uthal de Bani Hanifa. Lo ataron a uno de los pilares de la mezquita.";
"discovery.card.sunnah_bukhari_469.source" = "Sahih al-Bukhari 469";

"discovery.card.sunnah_bukhari_475.title" = "Sahih al-Bujari 475";
"discovery.card.sunnah_bukhari_475.meaning" = "Relató `Abbad bin Tamim: que su tío dijo: \"Vi al Mensajero de Allah (ﷺ) tendido de espaldas en la mezquita, con una pierna sobre la otra.\" Relató Sa`id bin Al-Musaiyab que `Umar y `Uthman solían hacer lo mismo.";
"discovery.card.sunnah_bukhari_475.source" = "Sahih al-Bukhari 475";

"discovery.card.sunnah_bukhari_478.title" = "Sahih al-Bujari 478";
"discovery.card.sunnah_bukhari_478.meaning" = "Relató Ibn `Umar o Ibn `Amr: El Profeta (ﷺ) juntó las manos entrelazando los dedos.";
"discovery.card.sunnah_bukhari_478.source" = "Sahih al-Bukhari 478";

"discovery.card.sunnah_bukhari_480.title" = "Sahih al-Bujari 480";
"discovery.card.sunnah_bukhari_480.meaning" = "Relató `Abdullah: Que el Mensajero de Allah (ﷺ) dijo: \"¡Oh `Abdullah bin `Amr! ¿Cuál será tu estado cuando te quedes con los sedimentos (los peores) de la gente?\" (Estarán en conflicto unos con otros.)";
"discovery.card.sunnah_bukhari_480.source" = "Sahih al-Bukhari 480";

"discovery.card.sunnah_bukhari_481.title" = "Sahih al-Bujari 481";
"discovery.card.sunnah_bukhari_481.meaning" = "Relató Abu Musa: El Profeta (ﷺ) dijo: \"Un creyente para otro creyente es como los ladrillos de un muro, que se refuerzan mutuamente.\" Mientras decía eso, el Profeta (ﷺ) juntó las manos entrelazando los dedos.";
"discovery.card.sunnah_bukhari_481.source" = "Sahih al-Bukhari 481";

"discovery.card.sunnah_bukhari_484.title" = "Sahih al-Bujari 484";
"discovery.card.sunnah_bukhari_484.meaning" = "El hadiz narrado trata de los distintos lugares en el camino de Medina a La Meca donde el Profeta (ﷺ) oró y no está traducido.";
"discovery.card.sunnah_bukhari_484.source" = "Sahih al-Bukhari 484";

"discovery.card.sunnah_bukhari_496.title" = "Sahih al-Bujari 496";
"discovery.card.sunnah_bukhari_496.meaning" = "Relató Sahl (bin Sa`d): La distancia entre el Musalla del Mensajero de Allah (ﷺ) y el muro era justo suficiente para que pasara una oveja.";
"discovery.card.sunnah_bukhari_496.source" = "Sahih al-Bukhari 496";

"discovery.card.sunnah_bukhari_497.title" = "Sahih al-Bujari 497";
"discovery.card.sunnah_bukhari_497.meaning" = "Relató Salama: La distancia entre el muro de la mezquita y el púlpito apenas bastaba para que pasara una oveja.";
"discovery.card.sunnah_bukhari_497.source" = "Sahih al-Bukhari 497";

"discovery.card.sunnah_bukhari_498.title" = "Sahih al-Bujari 498";
"discovery.card.sunnah_bukhari_498.meaning" = "Relató `Abdullah: El Profeta (ﷺ) hacía clavar una Harba delante de él (como Sutra) y oraba detrás de ella.";
"discovery.card.sunnah_bukhari_498.source" = "Sahih al-Bukhari 498";

"discovery.card.sunnah_bukhari_503.title" = "Sahih al-Bujari 503";
"discovery.card.sunnah_bukhari_503.meaning" = "Relató Anas: Vi a las personas más conocidas entre los compañeros del Profeta (ﷺ) apresurarse hacia los pilares en la oración del Maghrib antes de que el Profeta (ﷺ) llegara a la oración.";
"discovery.card.sunnah_bukhari_503.source" = "Sahih al-Bukhari 503";

"discovery.card.sunnah_bukhari_512.title" = "Sahih al-Bujari 512";
"discovery.card.sunnah_bukhari_512.meaning" = "Relató `Aisha: El Profeta (ﷺ) solía orar mientras yo dormía a lo ancho en su cama delante de él. Cuando quería orar el witr, me despertaba y yo oraba el witr.";
"discovery.card.sunnah_bukhari_512.source" = "Sahih al-Bukhari 512";

"discovery.card.sunnah_bukhari_515.title" = "Sahih al-Bujari 515";
"discovery.card.sunnah_bukhari_515.meaning" = "Relató `Aisha: (la esposa del Profeta) El Mensajero de Allah (ﷺ) se levantaba por la noche a orar mientras yo yacía a lo ancho entre él y la Qibla en la cama de su familia.";
"discovery.card.sunnah_bukhari_515.source" = "Sahih al-Bukhari 515";

"discovery.card.sunnah_bukhari_517.title" = "Sahih al-Bujari 517";
"discovery.card.sunnah_bukhari_517.meaning" = "Relató Maimuna bint Al-Harith: Mi cama estaba junto al lugar de oración (Musalla) del Profeta (ﷺ) y a veces su prenda caía sobre mí mientras yo yacía en mi cama.";
"discovery.card.sunnah_bukhari_517.source" = "Sahih al-Bukhari 517";

"discovery.card.sunnah_bukhari_518.title" = "Sahih al-Bujari 518";
"discovery.card.sunnah_bukhari_518.meaning" = "Relató Maimuna: El Profeta (ﷺ) solía orar mientras yo dormía a su lado durante mi menstruación, y en la prosternación su prenda me tocaba.";
"discovery.card.sunnah_bukhari_518.source" = "Sahih al-Bukhari 518";

"discovery.card.sunnah_bukhari_519.title" = "Sahih al-Bujari 519";
"discovery.card.sunnah_bukhari_519.meaning" = "Relató `Aisha: No está bien que nos hayáis igualado (a las mujeres) a perros y asnos. Sin duda vi al Mensajero de Allah (ﷺ) orar mientras yo yacía entre él y la Qibla, y cuando quería prosternarse, empujaba mis piernas y yo las retiraba.";
"discovery.card.sunnah_bukhari_519.source" = "Sahih al-Bukhari 519";

"discovery.card.sunnah_bukhari_524.title" = "Sahih al-Bujari 524";
"discovery.card.sunnah_bukhari_524.meaning" = "Relató Jarir bin `Abdullah: Presté juramento de fidelidad al Mensajero de Allah (ﷺ) de cumplir perfectamente las oraciones, pagar la Zakat con regularidad y dar buen consejo a todo musulmán.";
"discovery.card.sunnah_bukhari_524.source" = "Sahih al-Bukhari 524";

"discovery.card.sunnah_bukhari_529.title" = "Sahih al-Bujari 529";
"discovery.card.sunnah_bukhari_529.meaning" = "Relató Ghailan: Anas dijo: \"Ya no encuentro (hoy en día) las cosas como eran en la época del Profeta.\" Alguien dijo: \"La oración (sigue igual).\" Anas dijo: \"¿Acaso no habéis hecho en la oración lo que habéis hecho?\"";
"discovery.card.sunnah_bukhari_529.source" = "Sahih al-Bukhari 529";

"discovery.card.sunnah_bukhari_532.title" = "Sahih al-Bujari 532";
"discovery.card.sunnah_bukhari_532.meaning" = "Relató Anas: El Profeta (ﷺ) dijo: \"Haced bien la prosternación y no pongáis los antebrazos planos con los codos tocando el suelo como un perro. Y si queréis escupir, no escupáis delante ni a la derecha, porque quien está en oración habla en privado con su Señor.\"";
"discovery.card.sunnah_bukhari_532.source" = "Sahih al-Bukhari 532";

"discovery.card.sunnah_bukhari_533.title" = "Sahih al-Bujari 533";
"discovery.card.sunnah_bukhari_533.meaning" = "Relataron Abu Huraira y `Abdullah bin `Umar: El Mensajero de Allah (ﷺ) dijo: \"Si hace mucho calor, orad el Zuhr cuando refresque un poco, pues la intensidad del calor proviene del ardor del fuego del Infierno.\"";
"discovery.card.sunnah_bukhari_533.source" = "Sahih al-Bukhari 533";

"discovery.card.sunnah_bukhari_538.title" = "Sahih al-Bujari 538";
"discovery.card.sunnah_bukhari_538.meaning" = "Relató Abu Sa`id: que el Mensajero de Allah (ﷺ) dijo: \"Orad el Zuhr cuando refresque un poco, pues la intensidad del calor proviene del ardor del fuego del Infierno.\"";
"discovery.card.sunnah_bukhari_538.source" = "Sahih al-Bukhari 538";

"discovery.card.sunnah_bukhari_542.title" = "Sahih al-Bujari 542";
"discovery.card.sunnah_bukhari_542.meaning" = "Relató Anas bin Malik: Cuando hacíamos la oración del Zuhr detrás del Mensajero de Allah (ﷺ), nos prosternábamos sobre nuestra ropa para protegernos del calor.";
"discovery.card.sunnah_bukhari_542.source" = "Sahih al-Bukhari 542";

"discovery.card.sunnah_bukhari_543.title" = "Sahih al-Bujari 543";
"discovery.card.sunnah_bukhari_543.meaning" = "Relató Ibn `Abbas: \"El Profeta (ﷺ) oró ocho rak`at por el Zuhr y el `Asr, y siete por el Maghrib y el `Isha en Medina.\" Aiyub dijo: \"Quizá fueron noches de lluvia.\" Anas dijo: \"Puede ser.\"";
"discovery.card.sunnah_bukhari_543.source" = "Sahih al-Bukhari 543";

"discovery.card.sunnah_bukhari_544.title" = "Sahih al-Bujari 544";
"discovery.card.sunnah_bukhari_544.meaning" = "Relató Aisha: El Mensajero de Allah (ﷺ) solía hacer la oración del `Asr cuando la luz del sol aún no había desaparecido de mi aposento.";
"discovery.card.sunnah_bukhari_544.source" = "Sahih al-Bukhari 544";

"discovery.card.sunnah_bukhari_545.title" = "Sahih al-Bujari 545";
"discovery.card.sunnah_bukhari_545.meaning" = "Relató `Aisha: El Mensajero de Allah (ﷺ) solía hacer la oración del `Asr cuando el sol aún estaba dentro de mi aposento y aún no había aparecido sombra en él.";
"discovery.card.sunnah_bukhari_545.source" = "Sahih al-Bukhari 545";

"discovery.card.sunnah_bukhari_546.title" = "Sahih al-Bujari 546";
"discovery.card.sunnah_bukhari_546.meaning" = "Relató Aisha: El Profeta (ﷺ) solía orar el `Asr cuando el sol aún estaba dentro de mi aposento y aún no había aparecido sombra en él.";
"discovery.card.sunnah_bukhari_546.source" = "Sahih al-Bukhari 546";

"discovery.card.sunnah_bukhari_548.title" = "Sahih al-Bujari 548";
"discovery.card.sunnah_bukhari_548.meaning" = "Relató Anas bin Malik: Solíamos orar el `Asr y, después de eso, si alguien iba a la tribu de Bani `Amr bin `Auf, los encontraba aún orando el `Asr.";
"discovery.card.sunnah_bukhari_548.source" = "Sahih al-Bukhari 548";

"discovery.card.sunnah_bukhari_551.title" = "Sahih al-Bujari 551";
"discovery.card.sunnah_bukhari_551.meaning" = "Relató Anas bin Malik: Solíamos orar el `Asr y, después de eso, si uno de nosotros iba a Quba', llegaba allí mientras el sol aún estaba alto.";
"discovery.card.sunnah_bukhari_551.source" = "Sahih al-Bukhari 551";

"discovery.card.sunnah_bukhari_552.title" = "Sahih al-Bujari 552";
"discovery.card.sunnah_bukhari_552.meaning" = "Relató Ibn `Umar: El Mensajero de Allah (ﷺ) dijo: \"Quien pierde (intencionadamente) la oración del `Asr, es como si hubiera perdido a su familia y sus bienes.\"";
"discovery.card.sunnah_bukhari_552.source" = "Sahih al-Bukhari 552";

"discovery.card.sunnah_bukhari_553.title" = "Sahih al-Bujari 553";
"discovery.card.sunnah_bukhari_553.meaning" = "Relató Abu Al-Malih: Estábamos con Buraida en una batalla un día nublado y él dijo: \"Haced pronto la oración del `Asr, pues el Profeta dijo: 'Quien deja la oración del `Asr, todas sus (buenas) obras quedarán anuladas.'\"";
"discovery.card.sunnah_bukhari_553.source" = "Sahih al-Bukhari 553";

"discovery.card.sunnah_bukhari_556.title" = "Sahih al-Bujari 556";
"discovery.card.sunnah_bukhari_556.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) dijo: \"Si alguno de vosotros alcanza una rak`a de la oración del `Asr antes de la puesta del sol, debe completar su oración. Si alguno de vosotros alcanza una rak`a de la oración del Fajr antes de la salida del sol, debe completar su oración.\"";
"discovery.card.sunnah_bukhari_556.source" = "Sahih al-Bukhari 556";

"discovery.card.sunnah_bukhari_559.title" = "Sahih al-Bujari 559";
"discovery.card.sunnah_bukhari_559.meaning" = "Relató Rafi` bin Khadij: Solíamos hacer la oración del Maghrib con el Profeta (ﷺ) y, al terminar la oración, uno de nosotros podía irse y aún ver tan lejos como los lugares a los que llega una flecha disparada con un arco.";
"discovery.card.sunnah_bukhari_559.source" = "Sahih al-Bukhari 559";

"discovery.card.sunnah_bukhari_561.title" = "Sahih al-Bujari 561";
"discovery.card.sunnah_bukhari_561.meaning" = "Relató Salama: Solíamos orar el Maghrib con el Profeta (ﷺ) cuando el sol desaparecía del horizonte.";
"discovery.card.sunnah_bukhari_561.source" = "Sahih al-Bukhari 561";

"discovery.card.sunnah_bukhari_562.title" = "Sahih al-Bujari 562";
"discovery.card.sunnah_bukhari_562.meaning" = "Relató Ibn `Abbas: El Profeta (ﷺ) oró siete rak`at juntas y ocho rak`at juntas.";
"discovery.card.sunnah_bukhari_562.source" = "Sahih al-Bukhari 562";

"discovery.card.sunnah_bukhari_563.title" = "Sahih al-Bujari 563";
"discovery.card.sunnah_bukhari_563.meaning" = "Relató `Abdullah Al-Muzani: El Profeta (ﷺ) dijo: \"No os dejéis influir por los beduinos respecto al nombre de vuestra oración del Maghrib, que ellos llaman `Isha'.\"";
"discovery.card.sunnah_bukhari_563.source" = "Sahih al-Bukhari 563";

"discovery.card.sunnah_bukhari_568.title" = "Sahih al-Bujari 568";
"discovery.card.sunnah_bukhari_568.meaning" = "Relató Abu Barza: Al Mensajero de Allah (ﷺ) le disgustaba dormir antes de la oración del `Isha' y hablar después de ella.";
"discovery.card.sunnah_bukhari_568.source" = "Sahih al-Bukhari 568";

"discovery.card.sunnah_bukhari_574.title" = "Sahih al-Bujari 574";
"discovery.card.sunnah_bukhari_574.meaning" = "Relató Abu Bakr bin Abi Musa: Mi padre dijo: \"El Mensajero de Allah (ﷺ) dijo: 'Quien rece las dos oraciones frescas (`Asr y Fajr) irá al Paraíso.'\"";
"discovery.card.sunnah_bukhari_574.source" = "Sahih al-Bukhari 574";

"discovery.card.sunnah_bukhari_577.title" = "Sahih al-Bujari 577";
"discovery.card.sunnah_bukhari_577.meaning" = "Relató Sahl bin Sa`d: Solía tomar la comida del \"Suhur\" con mi familia y apresurarme para alcanzar el Fajr (oración de la mañana) con el Mensajero de Allah (ﷺ).";
"discovery.card.sunnah_bukhari_577.source" = "Sahih al-Bukhari 577";

"discovery.card.sunnah_bukhari_578.title" = "Sahih al-Bujari 578";
"discovery.card.sunnah_bukhari_578.meaning" = "Relató `Aisha: Las mujeres creyentes, cubiertas con sus velos, asistían a la oración del Fajr con el Mensajero de Allah ﷺ, y al terminar la oración volvían a sus casas y nadie podía reconocerlas a causa de la oscuridad.";
"discovery.card.sunnah_bukhari_578.source" = "Sahih al-Bukhari 578";

"discovery.card.sunnah_bukhari_579.title" = "Sahih al-Bujari 579";
"discovery.card.sunnah_bukhari_579.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) dijo: \"Quien alcance una rak`a (de la oración del Fajr) antes de la salida del sol, ha alcanzado la oración (de la mañana), y quien alcance una rak`a de la oración del `Asr antes de la puesta del sol, ha alcanzado la oración del `Asr.\"";
"discovery.card.sunnah_bukhari_579.source" = "Sahih al-Bukhari 579";

"discovery.card.sunnah_bukhari_580.title" = "Sahih al-Bujari 580";
"discovery.card.sunnah_bukhari_580.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) dijo: \"Quien alcance una rak`a de una oración (en su tiempo debido), ha alcanzado la oración.\"";
"discovery.card.sunnah_bukhari_580.source" = "Sahih al-Bukhari 580";

"discovery.card.sunnah_bukhari_581.title" = "Sahih al-Bujari 581";
"discovery.card.sunnah_bukhari_581.meaning" = "Relató `Umar: \"El Profeta (ﷺ) prohibió orar después de la oración del Fajr hasta que salga el sol y después de la oración del `Asr hasta que se ponga el sol.\" Relató Ibn `Abbas: Algunas personas me contaron la misma narración (que la anterior).";
"discovery.card.sunnah_bukhari_581.source" = "Sahih al-Bukhari 581";

"discovery.card.sunnah_bukhari_585.title" = "Sahih al-Bujari 585";
"discovery.card.sunnah_bukhari_585.meaning" = "Relató Ibn `Umar: El Mensajero de Allah (ﷺ) dijo: \"Ninguno de vosotros debe intentar orar al salir o al ponerse el sol.\"";
"discovery.card.sunnah_bukhari_585.source" = "Sahih al-Bukhari 585";

"discovery.card.sunnah_bukhari_586.title" = "Sahih al-Bujari 586";
"discovery.card.sunnah_bukhari_586.meaning" = "Relató Abu Sa`id Al-Khudri: Oí al Mensajero de Allah (ﷺ) decir: \"No hay oración después de la oración de la mañana hasta que salga el sol, y no hay oración después de la oración del `Asr hasta que se ponga el sol.\"";
"discovery.card.sunnah_bukhari_586.source" = "Sahih al-Bukhari 586";

"discovery.card.sunnah_bukhari_587.title" = "Sahih al-Bujari 587";
"discovery.card.sunnah_bukhari_587.meaning" = "Relató Muawiya: Hacéis una oración que yo no vi practicar al Mensajero de Allah (ﷺ) cuando estábamos en su compañía, y ciertamente la había prohibido (es decir, dos rak`at después de la oración del `Asr).";
"discovery.card.sunnah_bukhari_587.source" = "Sahih al-Bukhari 587";

"discovery.card.sunnah_bukhari_588.title" = "Sahih al-Bujari 588";
"discovery.card.sunnah_bukhari_588.meaning" = "Relató Abu Huraira: El Mensajero de Allah (ﷺ) prohibió dos oraciones: -1. después de la oración de la mañana hasta que sale el sol. -2. después de la oración del `Asr hasta que se pone el sol.";
"discovery.card.sunnah_bukhari_588.source" = "Sahih al-Bukhari 588";

"discovery.card.sunnah_bukhari_589.title" = "Sahih al-Bujari 589";
"discovery.card.sunnah_bukhari_589.meaning" = "Relató Ibn `Umar: Rezo como vi rezar a mis compañeros. No prohíbo orar en ningún momento del día o de la noche, excepto al ponerse y al salir el sol.";
"discovery.card.sunnah_bukhari_589.source" = "Sahih al-Bukhari 589";

"discovery.card.sunnah_bukhari_591.title" = "Sahih al-Bujari 591";
"discovery.card.sunnah_bukhari_591.meaning" = "Relató el padre de Hisham: `Aisha (dirigiéndose a mí) dijo: \"¡Oh hijo de mi hermana! El Profeta (ﷺ) nunca dejó de hacer dos prosternaciones (es decir, rak`at) después de la oración del `Asr en mi casa.\"";
"discovery.card.sunnah_bukhari_591.source" = "Sahih al-Bukhari 591";

"discovery.card.sunnah_bukhari_592.title" = "Sahih al-Bujari 592";
"discovery.card.sunnah_bukhari_592.meaning" = "Relató `Aisha: El Mensajero de Allah (ﷺ) nunca dejó de hacer dos rak`at antes de la oración del Fajr y después de la oración del `Asr, en público y en secreto.";
"discovery.card.sunnah_bukhari_592.source" = "Sahih al-Bukhari 592";

"discovery.card.sunnah_bukhari_593.title" = "Sahih al-Bujari 593";
"discovery.card.sunnah_bukhari_593.meaning" = "Relató `Aisha: Cada vez que el Profeta (ﷺ) venía a mí después de la oración del `Asr, siempre oraba dos rak`at.";
"discovery.card.sunnah_bukhari_593.source" = "Sahih al-Bukhari 593";

