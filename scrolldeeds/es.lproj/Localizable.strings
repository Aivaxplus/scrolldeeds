"discovery.card.fact_prophet_isa.source" = "Qur’an 3:45";

"discovery.card.fact_prophet_muhammad.title" = "Profeta Muhammad ﷺ";
"discovery.card.fact_prophet_muhammad.meaning" = "El Corán nombra al profeta Muhammad ﷺ. Su historia forma parte de la guía del Libro.";
"discovery.card.fact_prophet_muhammad.source" = "Qur’an 33:40";

"discovery.card.fact_five_prayers.title" = "Cinco oraciones diarias";
"discovery.card.fact_five_prayers.meaning" = "El islam se sostiene en cinco: el testimonio, el salah, el zakat, el Hayy y el ayuno de Ramadán. El salah es cinco veces al día.";
"discovery.card.fact_five_prayers.source" = "Sahih al-Bukhari 8 · Sahih Muslim 16";

"discovery.card.fact_night_qadr.title" = "Mejor que mil meses";
"discovery.card.fact_night_qadr.meaning" = "Laylat al-Qadr es mejor que mil meses. Es en Ramadán; la noche exacta no está fijada en el Corán.";
"discovery.card.fact_night_qadr.source" = "Qur’an 97:3";

"discovery.card.fact_hijrah.title" = "La Hégira";
"discovery.card.fact_hijrah.meaning" = "El Profeta ﷺ emigró de La Meca a Medina. El Corán menciona la ayuda de Allah en la cueva de ese viaje.";
"discovery.card.fact_hijrah.source" = "Qur’an 9:40 · seerah of the Hijrah";

"discovery.card.fact_seal_prophets.title" = "El sello de los profetas";
"discovery.card.fact_seal_prophets.meaning" = "El Corán llama a Muhammad ﷺ Mensajero de Allah y sello de los profetas.";
"discovery.card.fact_seal_prophets.source" = "Qur’an 33:40";

"discovery.card.fact_two_testimonies.title" = "No hay dios sino Allah";
"discovery.card.fact_two_testimonies.meaning" = "El primer pilar es atestiguar que no hay dios sino Allah, y que Muhammad ﷺ es Su mensajero.";
"discovery.card.fact_two_testimonies.source" = "Qur’an 47:19 · Sahih al-Bukhari 8";

"discovery.card.fact_zakat_pillar.title" = "El zakat es un pilar";
"discovery.card.fact_zakat_pillar.meaning" = "El Corán une el salah con el zakat. La limosna debida es uno de los cinco pilares del islam.";
"discovery.card.fact_zakat_pillar.source" = "Qur’an 2:43 · Sahih al-Bukhari 8";

"discovery.card.fact_hajj_pillar.title" = "Hayy a la Casa";
"discovery.card.fact_hajj_pillar.meaning" = "El Hayy a la Kaaba es un deber para quien pueda hallar un camino. Es uno de los cinco pilares.";
"discovery.card.fact_hajj_pillar.source" = "Qur’an 3:97 · Sahih al-Bukhari 8";

"discovery.card.fact_fast_ramadan.title" = "Se os prescribió el ayuno";
"discovery.card.fact_fast_ramadan.meaning" = "Se os prescribió el ayuno como se prescribió a quienes os precedieron, para que alcancéis taqwa.";
"discovery.card.fact_fast_ramadan.source" = "Qur’an 2:183 · Sahih al-Bukhari 8";

"discovery.card.fact_fatiha_every_salah.title" = "No hay salah sin Al-Fatiha";
"discovery.card.fact_fatiha_every_salah.meaning" = "El Profeta ﷺ dijo que no hay salah para quien no recita la Apertura del Libro.";
"discovery.card.fact_fatiha_every_salah.source" = "Sahih al-Bukhari 756 · Sahih Muslim 394";

"discovery.card.fact_quran_preserved.title" = "Nosotros lo guardaremos";
"discovery.card.fact_quran_preserved.meaning" = "Allah dijo del Recuerdo: “Ciertamente, Nosotros hemos revelado el Recuerdo y Nosotros lo guardaremos.”";
"discovery.card.fact_quran_preserved.source" = "Qur’an 15:9";

"discovery.card.fact_ramadan_reveal.title" = "Revelado en Ramadán";
"discovery.card.fact_ramadan_reveal.meaning" = "El Corán fue revelado en el mes de Ramadán, como guía para las personas y pruebas claras del criterio.";
"discovery.card.fact_ramadan_reveal.source" = "Qur’an 2:185";

"discovery.card.fact_surah_count.title" = "114 suras";
"discovery.card.fact_surah_count.meaning" = "El Corán del mushaf utmaní está ordenado en 114 suras, de Al-Fatiha a An-Nas.";
"discovery.card.fact_surah_count.source" = "Uthmani mushaf";

"discovery.card.fact_juz_count.title" = "30 yuz";
"discovery.card.fact_juz_count.meaning" = "Para recitarlo, el Corán se divide en 30 yuz: uno por noche en un khatm típico de Ramadán.";
"discovery.card.fact_juz_count.source" = "Uthmani mushaf";

"discovery.card.fact_iqra_first.title" = "La primera palabra: Iqra";
"discovery.card.fact_iqra_first.meaning" = "La primera revelación al Profeta ﷺ en la cueva de Hira comenzó: “Lee, en el nombre de tu Señor que creó.”";
"discovery.card.fact_iqra_first.source" = "Qur’an 96:1 · Sahih al-Bukhari 3";

"discovery.card.fact_longest_surah.title" = "La sura más larga";
"discovery.card.fact_longest_surah.meaning" = "Al-Baqarah es la sura más larga del Corán, con 286 aleyas. Se reveló en Medina.";
"discovery.card.fact_longest_surah.source" = "Uthmani mushaf · Qur’an 2";

"discovery.card.fact_shortest_surah.title" = "La sura más corta";
"discovery.card.fact_shortest_surah.meaning" = "Al-Kawthar es la sura más corta, con tres aleyas.";
"discovery.card.fact_shortest_surah.source" = "Uthmani mushaf · Qur’an 108";

"discovery.card.fact_first_house.title" = "La primera Casa";
"discovery.card.fact_first_house.meaning" = "El Corán dice que la primera Casa erigida para las personas es la de Bakka (La Meca), bendita y guía para los mundos.";
"discovery.card.fact_first_house.source" = "Qur’an 3:96";

"discovery.card.fact_qiblah_change.title" = "Se cambió la qibla";
"discovery.card.fact_qiblah_change.meaning" = "Allah ordenó al Profeta ﷺ volver el rostro hacia la Mezquita Sagrada. Esa pasó a ser la qibla de los musulmanes.";
"discovery.card.fact_qiblah_change.source" = "Qur’an 2:144";

"discovery.card.fact_arabic_quran.title" = "Un Corán árabe";
"discovery.card.fact_arabic_quran.meaning" = "El Corán fue revelado como recitación árabe para que su primer público lo entendiera.";
"discovery.card.fact_arabic_quran.source" = "Qur’an 12:2";

"discovery.card.fact_in_stages.title" = "Revelado por etapas";
"discovery.card.fact_in_stages.meaning" = "El Corán no bajó de una sola vez. Se recitó por etapas a lo largo de la misión del Profeta ﷺ.";
"discovery.card.fact_in_stages.source" = "Qur’an 17:106";

"discovery.card.fact_isra.title" = "El viaje nocturno";
"discovery.card.fact_isra.meaning" = "Gloria a Quien llevó a Su siervo de noche desde la Mezquita Sagrada hasta la Mezquita Más Lejana, cuyos alrededores bendijimos.";
"discovery.card.fact_isra.source" = "Qur’an 17:1";

"discovery.card.fact_mercy_to_worlds.title" = "Misericordia para los mundos";
"discovery.card.fact_mercy_to_worlds.meaning" = "El Corán dice que el Profeta ﷺ no fue enviado sino como misericordia para los mundos.";
"discovery.card.fact_mercy_to_worlds.source" = "Qur’an 21:107";

"discovery.card.fact_uswa_hasana.title" = "Un bello ejemplo";
"discovery.card.fact_uswa_hasana.meaning" = "En el Mensajero de Allah ﷺ tenéis un bello ejemplo para quien espera en Allah y el Último Día.";
"discovery.card.fact_uswa_hasana.source" = "Qur’an 33:21";

"discovery.card.fact_great_character.title" = "Un carácter inmenso";
"discovery.card.fact_great_character.meaning" = "Allah dijo del Profeta ﷺ: “Y eres de un carácter inmenso.”";
"discovery.card.fact_great_character.source" = "Qur’an 68:4";

"discovery.card.fact_salawat.title" = "Allah envía salah sobre él";
"discovery.card.fact_salawat.meaning" = "Allah y Sus ángeles envían salah sobre el Profeta ﷺ. Se ordena a los creyentes enviar también salah y saludo sobre él.";
"discovery.card.fact_salawat.source" = "Qur’an 33:56";

"discovery.card.fact_jumuah.title" = "Cuando se llama el viernes";
"discovery.card.fact_jumuah.meaning" = "Cuando se llama a la oración del viernes, dejad el comercio y acudid al recuerdo de Allah.";
"discovery.card.fact_jumuah.source" = "Qur’an 62:9";

"discovery.card.fact_wudu_ayah.title" = "El wudu en el Corán";
"discovery.card.fact_wudu_ayah.meaning" = "El Corán describe el wudu: lavad el rostro y los brazos hasta los codos, pasad la mano por la cabeza y lavad los pies hasta los tobillos.";
"discovery.card.fact_wudu_ayah.source" = "Qur’an 5:6";

"discovery.card.fact_no_compulsion.title" = "No hay coacción en la religión";
"discovery.card.fact_no_compulsion.meaning" = "No hay coacción en la religión. El camino recto se ha distinguido del error.";
"discovery.card.fact_no_compulsion.source" = "Qur’an 2:256";

"discovery.card.fact_quran_easy_remember.title" = "Facilitado para recordar";
"discovery.card.fact_quran_easy_remember.meaning" = "Allah dijo: “Ciertamente hemos hecho el Corán fácil de recordar. ¿Hay quien recuerde?” Esta frase se repite en la sura Al-Qamar.";
"discovery.card.fact_quran_easy_remember.source" = "Qur’an 54:17";

"discovery.card.fact_bismillah_tawbah.title" = "Sin Bismillah antes de At-Tawbah";
"discovery.card.fact_bismillah_tawbah.meaning" = "En el mushaf utmaní cada sura empieza con la Bismillah, excepto At-Tawbah (sura 9).";
"discovery.card.fact_bismillah_tawbah.source" = "Uthmani mushaf · Qur’an 9";

"discovery.card.fact_fatiha_seven.title" = "Siete reiterados";
"discovery.card.fact_fatiha_seven.meaning" = "Al-Fatiha tiene siete aleyas. Muchos eruditos entienden «los siete reiterados» (15:87) como esta sura, recitada en cada salah.";
"discovery.card.fact_fatiha_seven.source" = "Qur’an 15:87 · Qur’an 1";

"discovery.card.fact_ikhlas_third.title" = "Ikhlas es un tercio del Corán";
"discovery.card.fact_ikhlas_third.meaning" = "El Profeta ﷺ dijo que «Qul Huwa Allahu Ahad» (Al-Ikhlas) equivale a un tercio del Corán.";
"discovery.card.fact_ikhlas_third.source" = "Sahih al-Bukhari 5015";

"discovery.card.fact_kursi_greatest.title" = "La aleya más grande";
"discovery.card.fact_kursi_greatest.meaning" = "El Profeta ﷺ preguntó a Ubayy ibn Ka‘b cuál era la aleya más grande del Libro de Allah. Respondió Ayat al-Kursi, y el Profeta ﷺ lo confirmó.";
"discovery.card.fact_kursi_greatest.source" = "Sahih Muslim 810";

"discovery.card.fact_muawwidhatayn.title" = "Las dos suras de protección";
"discovery.card.fact_muawwidhatayn.meaning" = "Al-Falaq y An-Nas se llaman las Mu‘awwidhatayn. El Profeta ﷺ las usaba como protección y las enseñó.";
"discovery.card.fact_muawwidhatayn.source" = "Sahih al-Bukhari 5016";

"discovery.card.fact_iman_six.title" = "Seis pilares del iman";
"discovery.card.fact_iman_six.meaning" = "El iman es creer en Allah, Sus ángeles, Sus libros, Sus mensajeros, el Último Día y el decreto — lo bueno y lo duro.";
"discovery.card.fact_iman_six.source" = "Sahih Muslim 8 · Qur’an 4:136";

"discovery.card.fact_revealed_books.title" = "Libros nombrados en el Corán";
"discovery.card.fact_revealed_books.meaning" = "Además del Corán, el Libro nombra la Tora, el Evangelio y los Salmos: escrituras dadas a mensajeros anteriores.";
"discovery.card.fact_revealed_books.source" = "Qur’an 3:3 · Qur’an 4:163 · Qur’an 5:46";

"discovery.card.fact_twelve_months.title" = "Doce meses ante Allah";
"discovery.card.fact_twelve_months.meaning" = "El número de meses ante Allah es doce, en el Libro de Allah desde que creó los cielos y la tierra: cuatro de ellos sagrados.";
"discovery.card.fact_twelve_months.source" = "Qur’an 9:36";

"discovery.card.fact_maqam_ibrahim.title" = "La estación de Ibrahim";
"discovery.card.fact_maqam_ibrahim.meaning" = "Tomad la estación de Ibrahim como lugar de oración. El Corán la une a la Casa que Ibrahim e Ismail debían purificar.";
"discovery.card.fact_maqam_ibrahim.source" = "Qur’an 2:125";

"discovery.card.fact_named_prophets.title" = "25 profetas nombrados";
"discovery.card.fact_named_prophets.meaning" = "El Corán nombra veinticinco profetas, de Adán a Muhammad ﷺ. Otros mensajeros se mencionan sin nombre.";
"discovery.card.fact_named_prophets.source" = "Qur’an · 25 named prophets";

"discovery.card.fact_ninety_nine_names.title" = "Noventa y nueve nombres";
"discovery.card.fact_ninety_nine_names.meaning" = "El Profeta ﷺ dijo que Allah tiene noventa y nueve nombres, cien menos uno; quien los enumeré entrará en el Paraíso.";
"discovery.card.fact_ninety_nine_names.source" = "Sahih al-Bukhari 2736 · Sahih Muslim 2677";

"discovery.card.fact_seven_mathani.title" = "Siete de las repetidas";
"discovery.card.fact_seven_mathani.meaning" = "Allah dice que dio al Profeta ﷺ siete de las a menudo repetidas y el Gran Corán. Muchos sabios lo entienden como Al-Fatiha.";
"discovery.card.fact_seven_mathani.source" = "Qur’an 15:87";

"discovery.card.fact_safa_marwa.title" = "Safa y Marwa";
"discovery.card.fact_safa_marwa.meaning" = "Safa y Marwa son de los ritos de Allah. Quien haga Hayy o Umra a la Casa no peca al andar entre ambas.";
"discovery.card.fact_safa_marwa.source" = "Qur’an 2:158";

"discovery.card.fact_four_sacred_named.title" = "Cuatro meses sagrados";
"discovery.card.fact_four_sacred_named.meaning" = "De los doce meses, cuatro son sagrados: Dhul-Qa'da, Dhul-Hiyya, Muharram y Rayab, el que está entre Yumada y Sha'ban.";
"discovery.card.fact_four_sacred_named.source" = "Qur’an 9:36 · Sahih al-Bukhari 3197";

"discovery.card.fact_three_mosques.title" = "Tres mezquitas para un viaje";
"discovery.card.fact_three_mosques.meaning" = "El Profeta ﷺ dijo: no emprendáis viaje para visitar una mezquita salvo tres: la Sagrada, esta mía y Al-Aqsa.";
"discovery.card.fact_three_mosques.source" = "Sahih al-Bukhari 1189 · Sahih Muslim 1397";

"discovery.card.fact_last_two_baqarah.title" = "Las dos últimas aleyas de Al-Baqarah";
"discovery.card.fact_last_two_baqarah.meaning" = "El Profeta ﷺ dijo que quien recita las dos últimas aleyas de Al-Baqarah por la noche, le bastarán.";
"discovery.card.fact_last_two_baqarah.source" = "Sahih al-Bukhari 5009 · Sahih Muslim 808";

"discovery.card.fact_best_days_dhulhijjah.title" = "Los mejores días del año";
