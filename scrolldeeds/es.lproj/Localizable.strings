"conv_paywall.faq.header" = "Preguntas más frecuentes";
"conv_paywall.faq.q1" = "¿Esto funciona de verdad?";
"conv_paywall.faq.a1" = "Sí. El bloqueo real de iOS fuerza la pausa. Una buena acción da monedas, y un corazón abre tus apps. Ese ciclo cambia el hábito, insha’Allah.";
"conv_paywall.faq.q2" = "¿Por qué se creó Nafsi?";
"conv_paywall.faq.a2" = "Porque el doomscroll roba adoración, foco y paz. Creamos un sistema claro: bloquea las apps hasta que hagas una buena acción.";
"conv_paywall.faq.q3" = "¿La app seguirá mejorando?";
"conv_paywall.faq.a3" = "Sí. Publicamos actualizaciones con regularidad y nos obsesiona ayudar a musulmanes a crear hábitos que duren.";
"conv_paywall.faq.q4" = "¿Quién creó Nafsi?";
"conv_paywall.faq.a4" = "Assalamu alaikum — soy Sabri, el fundador. Primero hice Nafsi para mí, luego para cada musulmán en la misma lucha.";
"conv_paywall.faq.q5" = "¿En qué se diferencia Nafsi?";
"conv_paywall.faq.a5" = "No solo medimos el tiempo de pantalla. Convertimos la distracción en acciones — con bloqueo real de iOS y desbloqueos espirituales.";
"conv_paywall.sticky_cta" = "Bismillah, da el paso";
"conv_paywall.team.header" = "Bloquea el teléfono. Levántate para el Fajr. Domina tu nafs.";
"conv_paywall.team.body" = "Nafsi bloquea tus apps hasta una buena acción, y te despierta para el Fajr hasta que fotografíes el objeto que elegiste. Así tomas el control de tu nafs — no más tarde, ahora.\n\nBloqueo. Acción. Fajr. Actualizaciones que mantienen el sistema honesto.";
"conv_paywall.team.body_named" = "%@, Nafsi bloquea tus apps hasta una buena acción, y te despierta para el Fajr hasta que fotografíes el objeto que elegiste. Así tomas el control de tu nafs — no más tarde, ahora.\n\nBloqueo. Acción. Fajr. Actualizaciones que mantienen el sistema honesto.";
