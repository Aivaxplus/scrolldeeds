// MARK: - Traducciones completas de las duás
"dua.ayat_al_kursi.translation" = "Allah — no hay más dios que Él, el Viviente, el Eterno. Ni el sopor ni el sueño se apoderan de Él. Suyo es cuanto hay en los cielos y en la tierra. ¿Quién puede interceder ante Él sin Su permiso? Sabe lo que hay ante ellos y lo que hay tras ellos, y ellos no abarcan de Su ciencia sino lo que Él quiere. Su Trono se extiende por los cielos y la tierra, y no Le fatiga su custodia. Él es el Excelso, el Inmenso. (Corán 2:255)";
"dua.istighfar.translation" = "Oh Allah, Tú eres mi Señor. No hay dios sino Tú. Tú me creaste y soy Tu siervo. Vivo según mi pacto y promesa contigo lo mejor que puedo. Busco refugio en Ti del mal de lo que he hecho. Reconozco Tu gracia hacia mí y confieso mis pecados. Por tanto, perdóname, pues nadie perdona los pecados excepto Tú. (Sayyid al-Istighfar)";
"dua.dua_parents.translation" = "Señor mío, ten misericordia de ellos como me criaron cuando era pequeño. (Corán 17:24)";
"dua.dua_ummah.translation" = "Oh Allah, rectifica la Ummah de Muhammad. Oh Allah, alivia el sufrimiento de la Ummah de Muhammad. Oh Allah, ten misericordia de la Ummah de Muhammad.";
"dua.dua_loved_one.translation" = "Oh Allah, bendícelo/a en lo que le has provisto. Perdónalo/a, ten misericordia de él/ella, otórgale bienestar y perdónalo/a.";
"dua.verse_reflection.translation" = "Ciertamente, en la creación de los cielos y la tierra y en la alternancia de la noche y el día hay signos para los que tienen entendimiento. (Corán 3:190)";
"dua.dua_knowledge.translation" = "Señor mío, auméntame en conocimiento. (Corán 20:114)";
"dua.dua_relief.translation" = "Oh Allah, me refugio en Ti de la preocupación y la tristeza.";
"dua.dua_morning.translation" = "Hemos llegado a la mañana y el reino pertenece a Allah, y toda alabanza es para Allah.";
"dua.dua_evening.translation" = "Hemos llegado a la tarde y el reino pertenece a Allah, y toda alabanza es para Allah.";
"dua.dua_dunya.translation" = "Señor nuestro, danos el bien en este mundo y el bien en el Más Allá, y protégenos del castigo del Fuego. (Corán 2:201)";
"dua.dua_heart.translation" = "Señor nuestro, no desvíes nuestros corazones después de habernos guiado, y concédenos misericordia de Ti. En verdad, Tú eres el Otorgador. (Corán 3:8)";
"dua.dua_hasbi.translation" = "Allah me basta. No hay dios sino Él. En Él he puesto mi confianza, y Él es el Señor del Trono Inmenso. (Corán 9:129)";
"dua.dua_jannah.translation" = "Oh Allah, te pido el Paraíso y busco refugio en Ti contra el Fuego.";

// MARK: - Surah full translations (for recitation tasks)
"surah.ikhlas.translation" = "En el nombre de Allah, el Misericordioso, el Compasivo.\nDi: Él es Allah, Uno. Allah, el Eterno. No ha engendrado ni ha sido engendrado. Y no hay nadie igual a Él.";
"surah.falaq.translation" = "En el nombre de Allah, el Misericordioso, el Compasivo.\nDi: Me refugio en el Señor del alba del mal de lo que Él ha creado, del mal de la oscuridad cuando se extiende, del mal de las que soplan en los nudos, y del mal del envidioso cuando envidia.";
"surah.nas.translation" = "En el nombre de Allah, el Misericordioso, el Compasivo.\nDi: Me refugio en el Señor de los hombres, el Rey de los hombres, el Dios de los hombres, del mal del susurrador que se escabulle, que susurra en los pechos de los hombres, entre los genios y los hombres.";
"surah.fatiha.translation" = "En el nombre de Allah, el Misericordioso, el Compasivo. Alabado sea Allah, Señor de los mundos, el Misericordioso, el Compasivo, Dueño del Día del Juicio. A Ti solo adoramos y a Ti solo pedimos ayuda. Guíanos por el camino recto, el camino de los que Tú has agraciado, no de los que han incurrido en la ira ni de los extraviados.";
"surah.kafirun.translation" = "En el nombre de Allah, el Misericordioso, el Compasivo. Di: Oh incrédulos, no adoro lo que vosotros adoráis. Ni vosotros adoráis lo que yo adoro. Ni yo adoro lo que vosotros adoráis. Ni vosotros adoráis lo que yo adoro. Para vosotros vuestra religión, para mí mi religión.";
"surah.kawthar.translation" = "En el nombre de Allah, el Misericordioso, el Compasivo.
En verdad, te hemos concedido Al-Kawthar. Así que ora a tu Señor y sacrifica. En verdad, quien te odia es el que queda cortado.";
"surah.asr.translation" = "En el nombre de Allah, el Misericordioso, el Compasivo.
Por el tiempo. En verdad, el ser humano está en pérdida, excepto quienes creen, hacen buenas obras, se encomiendan mutuamente la verdad y se encomiendan mutuamente la paciencia.";

