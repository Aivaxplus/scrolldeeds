"discovery.explain.allah_name.title" = "%@, un nombre de Allah";
"discovery.explain.allah_name.body" = "%@ es uno de los nombres de Allah. Este título de misericordia le pertenece solo a Él.";
"discovery.explain.muqattaat.body" = "%@ son letras con las que Allah abrió esta sura. Su significado exacto está junto a Allah.";

"discovery.card.smile.title" = "Una sonrisa es caridad";
"discovery.card.smile.meaning" = "El Profeta ﷺ dijo: “Tu sonrisa en el rostro de tu hermano es caridad.”";
"discovery.card.smile.source" = "Jami‘ at-Tirmidhi 1956 (hasan)";

"discovery.card.salam.title" = "Difunde el salam";
"discovery.card.salam.meaning" = "Un hombre preguntó cuál es el mejor islam. El Profeta ﷺ dijo: dar de comer a la gente, y saludar con salam a quien conoces y a quien no. También dijo: difundid el saludo de paz entre vosotros.";
"discovery.card.salam.source" = "Sahih al-Bukhari 28 · Sahih Muslim 54";

"discovery.card.right_hand.title" = "Come con la mano derecha";
"discovery.card.right_hand.meaning" = "El Profeta ﷺ dijo: “Cuando uno de vosotros coma, que coma con la mano derecha, y cuando beba, que beba con la mano derecha, pues Shaytan come y bebe con la izquierda.”";
"discovery.card.right_hand.source" = "Sahih Muslim 2020";

"discovery.card.bismillah_eat.title" = "Empieza con Bismillah";
"discovery.card.bismillah_eat.meaning" = "El Profeta ﷺ dijo: cuando uno de vosotros coma, que mencione el nombre de Allah. Si lo olvida al inicio, que diga: “En el nombre de Allah, en su principio y en su final.”";
"discovery.card.bismillah_eat.source" = "Sunan Abi Dawud 3767 · Jami‘ at-Tirmidhi 1858";

"discovery.card.right_shoe.title" = "Empieza por la sandalia derecha";
"discovery.card.right_shoe.meaning" = "El Profeta ﷺ dijo: “Si uno de vosotros se pone las sandalias, que empiece por la derecha; y cuando se las quite, que empiece por la izquierda.”";
"discovery.card.right_shoe.source" = "Sahih al-Bukhari 5855";

"discovery.card.siwak.title" = "El siwak";
"discovery.card.siwak.meaning" = "El Profeta ﷺ dijo: “Si no temiera dificultad para mi ummah, les habría ordenado usar el siwak en cada oración.”";
"discovery.card.siwak.source" = "Sahih al-Bukhari 887 · Sahih Muslim 252";

"discovery.card.anger.title" = "La fuerza es el dominio propio";
"discovery.card.anger.meaning" = "El Profeta ﷺ dijo: “El fuerte no es quien vence a la gente con su fuerza; el fuerte es quien se controla cuando se enfada.”";
"discovery.card.anger.source" = "Sahih al-Bukhari 6114 · Sahih Muslim 2609";

"discovery.card.visit_sick.title" = "Visita al enfermo";
"discovery.card.visit_sick.meaning" = "El Profeta ﷺ dijo: “Los derechos del musulmán sobre el musulmán son cinco: devolver el saludo, visitar al enfermo, seguir el funeral, aceptar una invitación, y decir ‘yarhamuk Allah’ a quien estornuda.”";
"discovery.card.visit_sick.source" = "Sahih al-Bukhari 1240 · Sahih Muslim 2162";

"discovery.card.two_words.title" = "Dos palabras, pesadas en la Balanza";
"discovery.card.two_words.meaning" = "El Profeta ﷺ dijo: “Hay dos palabras ligeras en la lengua, pesadas en la Balanza y amadas por el Más Misericordioso: Gloria a Allah y a Él la alabanza; gloria a Allah, el Inmenso.”";
"discovery.card.two_words.source" = "Sahih al-Bukhari 6406 · Sahih Muslim 2694";

"discovery.card.ease.title" = "Con la dificultad viene el alivio";
"discovery.card.ease.meaning" = "Allah dice: “Ciertamente, con la dificultad viene el alivio.” El alivio se promete con la carga, no solo después.";
"discovery.card.ease.source" = "Corán 94:5–6";

"discovery.card.neighbor.title" = "Honra a tu vecino";
"discovery.card.neighbor.meaning" = "El Profeta ﷺ dijo: “Jibril no dejó de aconsejarme sobre el vecino hasta que pensé que le daría parte de la herencia.”";
"discovery.card.neighbor.source" = "Sahih al-Bukhari 6014 · Sahih Muslim 2624";

"discovery.card.knowledge.title" = "Señor mío, auméntame en conocimiento";
"discovery.card.knowledge.meaning" = "Allah enseñó a Su Mensajero ﷺ esta súplica: “Señor mío, auméntame en conocimiento.”";
"discovery.card.knowledge.source" = "Corán 20:114";

"discovery.card.intention.title" = "Las acciones son según la intención";
"discovery.card.intention.meaning" = "El Profeta ﷺ dijo: “Las acciones son solo según las intenciones, y cada persona tendrá lo que pretendió.”";
"discovery.card.intention.source" = "Sahih al-Bukhari 1 · Sahih Muslim 1907";

"discovery.card.half_date.title" = "Aunque sea medio dátil";
"discovery.card.half_date.meaning" = "El Profeta ﷺ dijo: “Protegeos del Fuego, aunque sea con medio dátil de caridad.”";
"discovery.card.half_date.source" = "Sahih al-Bukhari 1417 · Sahih Muslim 1016";

"discovery.card.remove_harm.title" = "Quita un daño del camino";
"discovery.card.remove_harm.meaning" = "El Profeta ﷺ dijo: “La fe tiene más de setenta ramas. La más excelente es decir que no hay dios sino Allah, y la más baja es quitar algo dañino del camino.”";
"discovery.card.remove_harm.source" = "Sahih Muslim 35";

"discovery.card.ikhlas.title" = "Sura al-Ijlas";
"discovery.card.ikhlas.meaning" = "El Profeta ﷺ dijo que “Di: Él es Allah, Uno” equivale a un tercio del Corán.";
"discovery.card.ikhlas.source" = "Corán 112 · Sahih al-Bukhari 5013";

"discovery.card.kursi.title" = "Ayat al-Kursi";
"discovery.card.kursi.meaning" = "“Allah — no hay dios sino Él, el Viviente, el Sustentador.” En un relato auténtico, a quien recitó este versículo por la noche se le dijo que estaría protegido hasta la mañana; el Profeta ﷺ lo confirmó.";
"discovery.card.kursi.source" = "Corán 2:255 · Sahih al-Bukhari 2311";

"discovery.card.mercy.title" = "Sé misericordioso";
"discovery.card.mercy.meaning" = "El Profeta ﷺ dijo: “Allah no mostrará misericordia a quienes no muestran misericordia a la gente.”";
"discovery.card.mercy.source" = "Sahih al-Bukhari 7376 · Sahih Muslim 2319";

"discovery.card.parents.title" = "Ni siquiera digas ‘uff’";
"discovery.card.parents.meaning" = "Allah dice: “Tu Señor ha decretado que no adoréis sino a Él, y que seáis buenos con los padres. Si uno de ellos o ambos llegan a la vejez contigo, no les digas ‘uff’ ni los rechaces, sino háblales con nobleza.”";
"discovery.card.parents.source" = "Corán 17:23";

"discovery.card.backbite.title" = "No hables mal a espaldas";
"discovery.card.backbite.meaning" = "Allah dice: “No os espiéis ni habléis mal unos de otros. ¿Acaso a uno de vosotros le gustaría comer la carne de su hermano muerto? Lo detestaríais.”";
"discovery.card.backbite.source" = "Corán 49:12";

"discovery.card.inshaallah.title" = "Di in sha Allah";
"discovery.card.inshaallah.meaning" = "Allah dice: “Y no digas jamás de algo: ‘Haré eso mañana,’ salvo [añadiendo]: ‘Si Allah quiere.’”";
"discovery.card.inshaallah.source" = "Corán 18:23–24";

"discovery.card.purification.title" = "La purificación es la mitad de la fe";
"discovery.card.purification.meaning" = "El Profeta ﷺ dijo: “La purificación es la mitad de la fe.”";
"discovery.card.purification.source" = "Sahih Muslim 223";

"discovery.card.conceal.title" = "Cubre una falta";
"discovery.card.conceal.meaning" = "El Profeta ﷺ dijo: “Quien cubra [la falta de] un musulmán, Allah lo cubrirá el Día de la Resurrección.”";
"discovery.card.conceal.source" = "Sahih al-Bukhari 2442 · Sahih Muslim 2580";

"discovery.card.night_prayer.title" = "La oración de la noche";
"discovery.card.night_prayer.meaning" = "El Profeta ﷺ dijo: “La mejor oración después de las obligatorias es la oración de la noche.”";
"discovery.card.night_prayer.source" = "Sahih Muslim 1163";

"discovery.card.return_salam.title" = "Devuelve el saludo";
"discovery.card.return_salam.meaning" = "Allah dice: “Cuando se os salude, devolved un saludo mejor, o devolvedlo igual. Ciertamente Allah lleva cuenta de todas las cosas.”";
"discovery.card.return_salam.source" = "Corán 4:86";

"discovery.card.patience.title" = "Buscad ayuda en la paciencia y la oración";
"discovery.card.patience.meaning" = "Allah dice: “Oh vosotros que creéis, buscad ayuda a través de la paciencia y la oración. Ciertamente Allah está con los pacientes.”";
"discovery.card.patience.source" = "Corán 2:153";

"discovery.card.tawakkul.title" = "Allah es suficiente";
"discovery.card.tawakkul.meaning" = "Allah dice: “Y quien se confíe a Allah — Él le basta. Ciertamente Allah cumplirá Su propósito.”";
"discovery.card.tawakkul.source" = "Corán 65:3";

"discovery.card.istighfar.title" = "Pide perdón a menudo";
"discovery.card.istighfar.meaning" = "El Profeta ﷺ dijo: “Por Allah, pido perdón a Allah y me arrepiento ante Él más de setenta veces al día.”";
"discovery.card.istighfar.source" = "Sahih al-Bukhari 6307";

"discovery.card.wudu_sleep.title" = "Duerme con wudu";
"discovery.card.wudu_sleep.meaning" = "El Profeta ﷺ dijo: “Cuando vayas a tu cama, haz wudu como para la oración, y luego acuéstate sobre tu lado derecho.”";
"discovery.card.wudu_sleep.source" = "Sahih al-Bukhari 247 · Sahih Muslim 2710";

"discovery.card.enter_home.title" = "Menciona a Allah al entrar";
"discovery.card.enter_home.meaning" = "El Profeta ﷺ dijo: cuando un hombre entra en su casa y menciona a Allah al entrar y al comer, Shaytan dice: “No tenéis posada ni cena.”";
"discovery.card.enter_home.source" = "Sahih Muslim 2018";

"discovery.card.lower_gaze.title" = "Baja la mirada";
"discovery.card.lower_gaze.meaning" = "Allah dice: “Di a los creyentes que bajen la mirada y guarden su castidad. Eso es más puro para ellos. Ciertamente Allah está al tanto de lo que hacen.”";
"discovery.card.lower_gaze.source" = "Corán 24:30";

"discovery.card.upper_hand.title" = "La mano de arriba";
"discovery.card.upper_hand.meaning" = "El Profeta ﷺ dijo: “La mano de arriba es mejor que la de abajo. La de arriba es la que da, y la de abajo es la que pide.”";
"discovery.card.upper_hand.source" = "Sahih al-Bukhari 1427 · Sahih Muslim 1033";

"discovery.card.fatiha.title" = "La Apertura";
"discovery.card.fatiha.meaning" = "El Profeta ﷺ dijo que Allah dice: He dividido la oración entre Mí y Mi siervo en dos mitades. Cuando dice: “Alabado sea Allah, Señor de los mundos,” Allah dice: Mi siervo Me ha alabado.";
"discovery.card.fatiha.source" = "Corán 1 · Sahih Muslim 395";

"discovery.card.honor_guest.title" = "Honra al huésped";
"discovery.card.honor_guest.meaning" = "El Profeta ﷺ dijo: “Quien cree en Allah y en el Último Día, que honre a su huésped.”";
"discovery.card.honor_guest.source" = "Sahih al-Bukhari 6018 · Sahih Muslim 47";

"discovery.card.love_brother.title" = "Ama para tu hermano";
"discovery.card.love_brother.meaning" = "El Profeta ﷺ dijo: “Ninguno de vosotros [de verdad] cree hasta que ame para su hermano lo que ama para sí mismo.”";
"discovery.card.love_brother.source" = "Sahih al-Bukhari 13 · Sahih Muslim 45";

"discovery.card.remember_me.title" = "Acordaos de Mí, Me acordaré de vosotros";
"discovery.card.remember_me.meaning" = "Allah dice: “Acordaos de Mí; Me acordaré de vosotros. Y sedme agradecidos y no Me neguéis.”";
"discovery.card.remember_me.source" = "Corán 2:152";

"discovery.card.no_envy.title" = "No os envidiéis";
"discovery.card.no_envy.meaning" = "El Profeta ﷺ dijo: “No os envidiéis, no os odiéis, no os deis la espalda, y sed, siervos de Allah, hermanos.”";
"discovery.card.no_envy.source" = "Sahih al-Bukhari 6065 · Sahih Muslim 2563";

"discovery.card.truthfulness.title" = "La veracidad conduce al Paraíso";
"discovery.card.truthfulness.meaning" = "El Profeta ﷺ dijo: “La veracidad conduce a la rectitud, y la rectitud conduce al Paraíso. Un hombre sigue siendo veraz hasta que queda registrado ante Allah como siddiq.”";
"discovery.card.truthfulness.source" = "Sahih al-Bukhari 6094 · Sahih Muslim 2607";

"discovery.card.ghusl_friday.title" = "Ghusl el viernes";
"discovery.card.ghusl_friday.meaning" = "El Profeta ﷺ dijo: “El ghusl del viernes es obligatorio para todo adulto.”";
"discovery.card.ghusl_friday.source" = "Sahih al-Bukhari 879 · Sahih Muslim 846";

"discovery.card.speak_good.title" = "Habla bien o calla";
"discovery.card.speak_good.meaning" = "El Profeta ﷺ dijo: “Quien cree en Allah y en el Último Día, que hable bien o que calle.”";
"discovery.card.speak_good.source" = "Sahih al-Bukhari 6018 · Sahih Muslim 47";

"discovery.card.fajr_sunnah.title" = "Las dos rak‘ahs del Fajr";
"discovery.card.fajr_sunnah.meaning" = "El Profeta ﷺ dijo: “Las dos rak‘ahs del Fajr son mejores que este mundo y todo lo que hay en él.”";
"discovery.card.fajr_sunnah.source" = "Sahih Muslim 725";

"discovery.card.haya.title" = "El pudor es parte de la fe";
"discovery.card.haya.meaning" = "El Profeta ﷺ dijo: “El pudor es una rama de la fe.”";
"discovery.card.haya.source" = "Sahih al-Bukhari 9 · Sahih Muslim 35";

"discovery.card.no_burden.title" = "Allah no carga un alma";
"discovery.card.no_burden.meaning" = "Allah dice: “Allah no impone a ningún alma una carga superior a su capacidad.”";
"discovery.card.no_burden.source" = "Corán 2:286";

"discovery.card.mankind.title" = "El más noble es el más temeroso de Allah";
"discovery.card.mankind.meaning" = "Allah dice: “Oh humanidad, os creamos de un varón y una mujer y os hicimos pueblos y tribus para que os conozcáis. El más noble de vosotros ante Allah es el más temeroso.”";
"discovery.card.mankind.source" = "Corán 49:13";

