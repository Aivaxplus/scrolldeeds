"knowledge.card.smile_sadaqah.title" = "Una sonrisa es caridad";
"knowledge.card.smile_sadaqah.arabic" = "تَبَسُّمُكَ فِي وَجْهِ أَخِيكَ صَدَقَةٌ";
"knowledge.card.smile_sadaqah.body" = "El Profeta ﷺ dijo que tu sonrisa a tu hermano es sadaqah. Un gesto pequeño, una obra real.";
"knowledge.card.smile_sadaqah.source" = "Jami' at-Tirmidhi 1956";

"knowledge.card.bismillah_food.title" = "Empieza con Bismillah";
"knowledge.card.bismillah_food.arabic" = "بِسْمِ اللَّهِ";
"knowledge.card.bismillah_food.body" = "Empieza a comer y a beber con el nombre de Allah. Si lo olvidas al inicio, dilo al principio y al final.";
"knowledge.card.bismillah_food.source" = "Sunan Abi Dawud 3767";

"knowledge.card.right_hand.title" = "Come con la mano derecha";
"knowledge.card.right_hand.arabic" = "";
"knowledge.card.right_hand.body" = "El Profeta ﷺ nos enseñó a comer y beber con la mano derecha. Una sunna silenciosa en cada comida.";
"knowledge.card.right_hand.source" = "Sahih Muslim 2020";

"knowledge.card.remove_harm.title" = "Quita un daño del camino";
"knowledge.card.remove_harm.arabic" = "";
"knowledge.card.remove_harm.body" = "Quitar algo dañino del camino es una rama de la fe. Hay obras que puedes hacer mientras caminas.";
"knowledge.card.remove_harm.source" = "Sahih Muslim 35";

"knowledge.card.greet_salam.title" = "Difunde el salam";
"knowledge.card.greet_salam.arabic" = "السَّلَامُ عَلَيْكُمْ";
"knowledge.card.greet_salam.body" = "Saluda a quien conoces y a quien no. Difundir el salam forma parte del islam.";
"knowledge.card.greet_salam.source" = "Sahih al-Bukhari 28 · Sahih Muslim 39";

"knowledge.card.miswak.title" = "El siwak";
"knowledge.card.miswak.arabic" = "";
"knowledge.card.miswak.body" = "El siwak limpia la boca y complace al Señor. Un palito pequeño, una sunna amada.";
"knowledge.card.miswak.source" = "Sahih al-Bukhari 1934";

"knowledge.card.anger_sit.title" = "Si sube la ira, siéntate";
"knowledge.card.anger_sit.arabic" = "";
"knowledge.card.anger_sit.body" = "Si estás de pie, siéntate. Si estás sentado, recuéstate. La ira viene de Shaytan: cambia tu postura antes de que te cambie a ti.";
"knowledge.card.anger_sit.source" = "Sunan Abi Dawud 4782";

"knowledge.card.even_date.title" = "Aunque sea medio dátil";
"knowledge.card.even_date.arabic" = "";
"knowledge.card.even_date.body" = "Protégete del Fuego aunque sea con medio dátil en caridad. Ningún regalo es pequeño si es sincero.";
"knowledge.card.even_date.source" = "Sahih al-Bukhari 1417";

"knowledge.card.ayatul_kursi.title" = "Ayat al-Kursi";
"knowledge.card.ayatul_kursi.arabic" = "اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ";
"knowledge.card.ayatul_kursi.body" = "Recítala después de cada salah y antes de dormir. Un versículo de protección, una noche bajo el cuidado de Allah.";
"knowledge.card.ayatul_kursi.source" = "Corán 2:255 · Sahih al-Bukhari 2311";

"knowledge.card.ikhlas.title" = "Sura al-Ijlas";
"knowledge.card.ikhlas.arabic" = "قُلْ هُوَ اللَّهُ أَحَدٌ";
"knowledge.card.ikhlas.body" = "Equivale a un tercio del Corán en recompensa. Pocas líneas en la lengua, un gran peso ante Allah.";
"knowledge.card.ikhlas.source" = "Sahih al-Bukhari 5013";

"knowledge.card.wudu_sleep.title" = "Duerme con wudu";
"knowledge.card.wudu_sleep.arabic" = "";
"knowledge.card.wudu_sleep.body" = "El Profeta ﷺ aconsejó acostarse en estado de wudu. Cierra el día como lo empezaste: limpio para Allah.";
"knowledge.card.wudu_sleep.source" = "Sahih al-Bukhari 247";

"knowledge.card.visit_sick.title" = "Visita al enfermo";
"knowledge.card.visit_sick.arabic" = "";
"knowledge.card.visit_sick.body" = "Visitar al enfermo es un derecho del musulmán sobre el musulmán. Estar presente es una obra, no solo palabras.";
"knowledge.card.visit_sick.source" = "Sahih Muslim 2162";

