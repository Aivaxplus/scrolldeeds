"notification.spiritual.quran1.title" = "Acuérdate de Mí";
"notification.spiritual.quran1.body" = "“Acordaos de Mí, que Yo Me acordaré de vosotros.” — Corán 2:152";
"notification.spiritual.sunnah1.title" = "Las obras más amadas";
"notification.spiritual.sunnah1.body" = "“Las obras más amadas por Alá son las más constantes, aunque sean pocas.” — Sahih al-Bukhari 6465; Sahih Muslim 783";
"notification.spiritual.reminder1.title" = "Allah te ve";
"notification.spiritual.reminder1.body" = "Lo que haces ahora vuelve el Día del Juicio. Elige qué quieres mostrarle.";
"notification.spiritual.quran2.title" = "Con la dificultad, la facilidad";
"notification.spiritual.quran2.body" = "“Ciertamente, con la dificultad viene la facilidad.” — Corán 94:6";
"notification.spiritual.sunnah2.title" = "Habla bien o calla";
"notification.spiritual.sunnah2.body" = "“Quien cree en Alá y en el Último Día, que hable bien o que calle.” — Sahih al-Bukhari 6018; Sahih Muslim 47";
"notification.spiritual.reminder2.title" = "La akhirah espera";
"notification.spiritual.reminder2.body" = "Este minuto cuenta. Un dhikr pesa menos que una hora de scroll.";
"notification.spiritual.quran3.title" = "Recuerda, si aprovecha";
"notification.spiritual.quran3.body" = "“Recuerda, pues, si el recuerdo es de provecho.” — Corán 87:9";
"notification.spiritual.sunnah3.title" = "Las obras son por la intención";
"notification.spiritual.sunnah3.body" = "“Las obras son según las intenciones, y cada uno tendrá lo que se propuso.” — Sahih al-Bukhari 1; Sahih Muslim 1907";
"notification.spiritual.reminder3.title" = "¿Dónde estarás después?";
"notification.spiritual.reminder3.body" = "Sé en este mundo como un viajero. El feed no es tu casa.";
"notification.spiritual.quran4.title" = "Alá está con los pacientes";
"notification.spiritual.quran4.body" = "“¡Oh, creyentes! Buscad auxilio en la paciencia y la oración. Ciertamente, Alá está con los pacientes.” — Corán 2:153";
"notification.spiritual.sunnah4.title" = "El fuerte";
"notification.spiritual.sunnah4.body" = "“El fuerte no es quien derriba a la gente, sino quien se controla en la ira.” — Sahih al-Bukhari 6114; Sahih Muslim 2609";
"notification.spiritual.reminder4.title" = "Un aliento es una oportunidad";
"notification.spiritual.reminder4.body" = "Allah te dio otro aliento. Úsalo para istighfar, no para el siguiente vídeo.";
"notification.spiritual.quran5.title" = "Los corazones se sosiegan";
"notification.spiritual.quran5.body" = "“¿Acaso no es con el recuerdo de Alá como se sosiegan los corazones?” — Corán 13:28";
"notification.spiritual.sunnah5.title" = "Facilitad y no dificultéis";
"notification.spiritual.sunnah5.body" = "“Facilitad y no dificultéis; dad buenas nuevas y no ahuyentéis.” — Sahih al-Bukhari 69; Sahih Muslim 1734";
"notification.spiritual.reminder5.title" = "La tumba preguntará";
"notification.spiritual.reminder5.body" = "¿Qué te llevas: una racha de clips, o una palabra que Allah ama?";
"notification.spiritual.quran6.title" = "Estableced la oración";
"notification.spiritual.quran6.body" = "“Y estableced la oración, dad el azaque e inclinaos con quienes se inclinan.” — Corán 2:43";
"notification.spiritual.sunnah6.title" = "Aprended el Corán y enseñadlo";
"notification.spiritual.sunnah6.body" = "“Los mejores de vosotros son quienes aprenden el Corán y lo enseñan.” — Sahih al-Bukhari 5027";
"notification.spiritual.reminder6.title" = "Él está cerca";
"notification.spiritual.reminder6.body" = "Si Mis siervos te preguntan por Mí, Yo estoy cerca. Llámalo ahora.";
"notification.spiritual.quran7.title" = "Tu Señor no te ha abandonado";
"notification.spiritual.quran7.body" = "“Tu Señor no te ha abandonado ni te aborrece.” — Corán 93:3";
"notification.spiritual.sunnah7.title" = "La pureza es la mitad de la fe";
"notification.spiritual.sunnah7.body" = "“La pureza es la mitad de la fe.” — Sahih Muslim 223";
"notification.spiritual.reminder7.title" = "La balanza";
"notification.spiritual.reminder7.body" = "Un Subhanallah puede pesar más que todo lo que hoy has scrolleado.";
"notification.spiritual.quran8.title" = "Te encontró extraviado y te guió";
"notification.spiritual.quran8.body" = "“Y te encontró extraviado y te guió.” — Corán 93:7";
"notification.spiritual.sunnah8.title" = "Sé en este mundo como un viajero";
"notification.spiritual.sunnah8.body" = "“Sé en este mundo como si fueras un extraño o un viajero.” — Sahih al-Bukhari 6416";
"notification.spiritual.reminder8.title" = "No olvides el regreso";
"notification.spiritual.reminder8.body" = "Toda alma probará la muerte. Vive esta hora como algo de lo que tendrás que responder.";
"notification.spiritual.quran9.title" = "No olvides tu porción";
"notification.spiritual.quran9.body" = "“Y no olvides tu porción de este mundo. Y obra el bien como Alá lo ha obrado contigo.” — Corán 28:77";
"notification.spiritual.sunnah9.title" = "Ama para tu hermano";
"notification.spiritual.sunnah9.body" = "“Ninguno de vosotros cree de verdad hasta que ame para su hermano lo que ama para sí.” — Sahih al-Bukhari 13; Sahih Muslim 45";
"notification.spiritual.reminder9.title" = "Allah basta";
"notification.spiritual.reminder9.body" = "Lo que buscas en el feed no llena lo que solo Allah llena.";
"notification.spiritual.quran10.title" = "Recuérdalo de pie y sentado";
"notification.spiritual.quran10.body" = "“Quienes recuerdan a Alá de pie, sentados o recostados.” — Corán 3:191";
"notification.spiritual.sunnah10.title" = "Seguros de lengua y mano";
"notification.spiritual.sunnah10.body" = "“El musulmán es aquel de cuya lengua y mano están a salvo los musulmanes.” — Sahih al-Bukhari 10; Sahih Muslim 40";
"notification.spiritual.reminder10.title" = "Una palabra para Él";
"notification.spiritual.reminder10.body" = "Di Astaghfirullah. Borra. El scroll solo añade lo que no quieres cargar.";
"notification.spiritual.quran11.title" = "La oración retiene de lo indecente";
"notification.spiritual.quran11.body" = "“Ciertamente, la oración retiene de lo indecente y lo reprobable, y el recuerdo de Alá es aún mayor.” — Corán 29:45";
"notification.spiritual.sunnah11.title" = "Dos palabras, pesadas en la balanza";
"notification.spiritual.sunnah11.body" = "“Dos palabras son ligeras en la lengua, pesadas en la balanza y amadas por el Misericordioso: Subhanallahi wa bihamdihi, Subhanallahil-Azeem.” — Sahih al-Bukhari 6406; Sahih Muslim 2694";
"notification.spiritual.reminder11.title" = "El Día llega";
"notification.spiritual.reminder11.body" = "A nadie se le hará injusticia. Lo que ahora parece pequeño quedará en tu registro.";
"notification.spiritual.quran12.title" = "¿No ha llegado ya el momento?";
"notification.spiritual.quran12.body" = "“¿No ha llegado ya el momento para quienes creen de que sus corazones se humillen ante el recuerdo de Alá?” — Corán 57:16";
"notification.spiritual.sunnah12.title" = "No te enfades";
"notification.spiritual.sunnah12.body" = "Alguien dijo: “Aconséjame.” Él ﷺ dijo: “No te enfades.” Lo repitió, y él ﷺ siguió diciendo: “No te enfades.” — Sahih al-Bukhari 6116";
"notification.spiritual.reminder12.title" = "Vuelve el corazón";
"notification.spiritual.reminder12.body" = "En el recuerdo de Allah encuentran descanso los corazones.";
"notification.spiritual.quran13.title" = "Buscad auxilio en la paciencia";
"notification.spiritual.quran13.body" = "“Y buscad auxilio en la paciencia y la oración. Ciertamente es dura, excepto para los humildes.” — Corán 2:45";
"notification.spiritual.sunnah13.title" = "Sin misericordia para quien no la da";
"notification.spiritual.sunnah13.body" = "“Alá no es misericordioso con quien no es misericordioso con la gente.” — Sahih al-Bukhari 5997; Sahih Muslim 2319";
"notification.spiritual.reminder13.title" = "Para tu Señor";
"notification.spiritual.reminder13.body" = "Salah, dhikr, una aleya. Eso permanece. La línea de tiempo desaparece.";
"notification.spiritual.quran14.title" = "Estoy cerca";
"notification.spiritual.quran14.body" = "“Y cuando Mis siervos te pregunten por Mí: Yo estoy cerca. Respondo a la súplica de quien Me invoca cuando Me invoca.” — Corán 2:186";
"notification.spiritual.sunnah14.title" = "Toda buena obra es sadaqa";
"notification.spiritual.sunnah14.body" = "“Toda buena obra es caridad.” — Sahih al-Bukhari 6022; Sahih Muslim 1005";
"notification.spiritual.reminder14.title" = "Dos minutos con Allah";
"notification.spiritual.reminder14.body" = "Deja el teléfono. Di Subhanallah, Alhamdulillah, Allahu akbar.";
"notification.spiritual.quran15.title" = "Ningún alma es sobrecargada";
"notification.spiritual.quran15.body" = "“Alá no impone a ningún alma sino según su capacidad.” — Corán 2:286";
"notification.spiritual.sunnah15.title" = "Aparta el daño del camino";
"notification.spiritual.sunnah15.body" = "“Apartar algo dañino del camino es caridad.” — Sahih al-Bukhari 2989; Sahih Muslim 1009";
"notification.spiritual.reminder15.title" = "¿A quién esperas encontrar?";
"notification.spiritual.reminder15.body" = "El encuentro con Allah es real. Prepara hoy una buena acción.";
"notification.spiritual.quran16.title" = "No desfallezcáis ni os entristezcáis";
"notification.spiritual.quran16.body" = "“No desfallezcáis ni os entristezcáis: seréis superiores si sois creyentes.” — Corán 3:139";
"notification.spiritual.sunnah16.title" = "La haya es parte de la fe";
"notification.spiritual.sunnah16.body" = "“La haya (modestia) es una rama de la fe.” — Sahih al-Bukhari 24; Sahih Muslim 36";
"notification.spiritual.reminder16.title" = "Este mundo es corto";
"notification.spiritual.reminder16.body" = "Lo que ahora pospones por Allah se sentirá, entonces, más largo que todo este feed.";
"notification.spiritual.quran17.title" = "Sed pacientes y permaneced firmes";
"notification.spiritual.quran17.body" = "“¡Oh, creyentes! Sed pacientes, perseverad, permaneced firmes y temed a Alá, para que tengáis éxito.” — Corán 3:200";
"notification.spiritual.sunnah17.title" = "La religión es consejo sincero";
"notification.spiritual.sunnah17.body" = "“La religión es naseehah.” Dijimos: “¿Hacia quién?” Dijo: “Hacia Alá, Su Libro, Su Mensajero, los líderes de los musulmanes y su gente común.” — Sahih Muslim 55";
"notification.spiritual.reminder17.title" = "Pide perdón";
"notification.spiritual.reminder17.body" = "A Allah le agrada que vuelvas. Un tawbah sincero pesa más que un scroll perfecto.";
"notification.spiritual.quran18.title" = "La oración en tiempos fijos";
"notification.spiritual.quran18.body" = "“Ciertamente, la oración ha sido prescrita a los creyentes en tiempos determinados.” — Corán 4:103";
"notification.spiritual.sunnah18.title" = "Honra a tu huésped";
"notification.spiritual.sunnah18.body" = "“Quien cree en Alá y en el Último Día, que honre a su huésped.” — Sahih al-Bukhari 6018; Sahih Muslim 47";
"notification.spiritual.reminder18.title" = "Tu registro";
"notification.spiritual.reminder18.body" = "Los ángeles están escribiendo. Que este momento sea una hasanah, no descuido.";
"notification.spiritual.quran19.title" = "Recuerda a tu Señor en ti mismo";
"notification.spiritual.quran19.body" = "“Y recuerda a tu Señor en ti mismo, con humildad y temor, no en voz alta, por las mañanas y las tardes.” — Corán 7:205";
"notification.spiritual.sunnah19.title" = "Los creyentes se sostienen";
"notification.spiritual.sunnah19.body" = "“El creyente respecto al creyente es como un edificio: cada parte sostiene a la otra.” — Sahih al-Bukhari 481; Sahih Muslim 2585";
"notification.spiritual.reminder19.title" = "La otra vida está más cerca";
"notification.spiritual.reminder19.body" = "No sabes qué aliento es el último. Recuerda a Allah antes de seguir scrolleando.";
"notification.spiritual.quran20.title" = "Alá no cambia a un pueblo";
"notification.spiritual.quran20.body" = "“Alá no cambia lo que hay en un pueblo hasta que ellos cambian lo que hay en sí mismos.” — Corán 13:11";
"notification.spiritual.sunnah20.title" = "Ama al Mensajero ﷺ";
"notification.spiritual.sunnah20.body" = "“Ninguno de vosotros cree de verdad hasta que yo le sea más amado que su padre, su hijo y toda la gente.” — Sahih al-Bukhari 15; Sahih Muslim 44";
"notification.spiritual.reminder20.title" = "Una aleya a la que aferrarte";
"notification.spiritual.reminder20.body" = "Quien teme a Allah, Él le abre una salida.";
"notification.spiritual.quran21.title" = "Una vida buena para quien obra el bien";
"notification.spiritual.quran21.body" = "“Quien obra el bien, varón o mujer, siendo creyente, le haremos vivir una vida buena.” — Corán 16:97";
"notification.spiritual.sunnah21.title" = "Alá mira los corazones";
"notification.spiritual.sunnah21.body" = "“Alá no mira vuestro aspecto ni vuestra riqueza, sino vuestros corazones y vuestras obras.” — Sahih Muslim 2564";
"notification.spiritual.reminder21.title" = "Después de la muerte";
"notification.spiritual.reminder21.body" = "Tres cosas permanecen: una caridad continua, conocimiento útil y un hijo que hace du'a. Lo demás se queda aquí.";
"notification.spiritual.quran22.title" = "Invocadme";
"notification.spiritual.quran22.body" = "“Y vuestro Señor dice: Invocadme; os responderé.” — Corán 40:60";
"notification.spiritual.sunnah22.title" = "La mano de arriba";
"notification.spiritual.sunnah22.body" = "“La mano de arriba es mejor que la de abajo. La de arriba da, la de abajo recibe.” — Sahih al-Bukhari 1429; Sahih Muslim 1033";
"notification.spiritual.reminder22.title" = "Vuelve a Allah";
"notification.spiritual.reminder22.body" = "Si tú Lo olvidas, Él te deja con eso. Regresa con un La ilaha illallah.";
"notification.spiritual.quran23.title" = "No desesperéis de Su misericordia";
"notification.spiritual.quran23.body" = "“Di: ¡Siervos Míos que os habéis excedido contra vosotros mismos! No desesperéis de la misericordia de Alá. Alá perdona todos los pecados.” — Corán 39:53";
"notification.spiritual.sunnah23.title" = "Contento con Alá como Señor";
"notification.spiritual.sunnah23.body" = "“Quien está contento con Alá como Señor, el islam como religión y Muhammad ﷺ como mensajero, ha gustado el sabor de la fe.” — Sahih Muslim 34";
"notification.spiritual.reminder23.title" = "La última parte de la noche";
