"knowledge.card.ikhlas.arabic" = "قُلْ هُوَ اللَّهُ أَحَدٌ";
"knowledge.card.ikhlas.body" = "Equal to a third of the Qur’an in reward. A few lines on the tongue, a huge scale with Allah.";
"knowledge.card.ikhlas.source" = "Sahih al-Bukhari 5013";

"knowledge.card.wudu_sleep.title" = "Sleep with wudu";
"knowledge.card.wudu_sleep.arabic" = "";
"knowledge.card.wudu_sleep.body" = "The Prophet ﷺ advised going to bed in a state of wudu. End the day the way you began it: clean for Allah.";
"knowledge.card.wudu_sleep.source" = "Sahih al-Bukhari 247";

"knowledge.card.visit_sick.title" = "Visit the sick";
"knowledge.card.visit_sick.arabic" = "";
"knowledge.card.visit_sick.body" = "Visiting the sick is a right of the Muslim upon the Muslim. Presence is a deed, not only words.";
"knowledge.card.visit_sick.source" = "Sahih Muslim 2162";

