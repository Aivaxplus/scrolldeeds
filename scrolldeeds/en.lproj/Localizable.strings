"discovery.card.fact_prophet_isa.meaning" = "The Quran names the prophet Isa. His story is part of the Book’s guidance, not a legend.";
"discovery.card.fact_prophet_isa.source" = "Qur’an 3:45";

"discovery.card.fact_prophet_muhammad.title" = "Prophet Muhammad ﷺ";
"discovery.card.fact_prophet_muhammad.meaning" = "The Quran names the prophet Muhammad ﷺ. His story is part of the Book’s guidance, not a legend.";
"discovery.card.fact_prophet_muhammad.source" = "Qur’an 33:40";

"discovery.card.fact_five_prayers.title" = "Five daily prayers";
"discovery.card.fact_five_prayers.meaning" = "Islam is built on five: the testimony of faith, salah, zakat, Hajj, and fasting Ramadan. Salah is five times every day.";
"discovery.card.fact_five_prayers.source" = "Sahih al-Bukhari 8 · Sahih Muslim 16";

"discovery.card.fact_night_qadr.title" = "Better than a thousand months";
"discovery.card.fact_night_qadr.meaning" = "Laylat al-Qadr is better than a thousand months. It is in Ramadan; its exact night is not fixed in the Quran.";
"discovery.card.fact_night_qadr.source" = "Qur’an 97:3";

"discovery.card.fact_hijrah.title" = "The Hijrah";
"discovery.card.fact_hijrah.meaning" = "The Prophet ﷺ migrated from Makkah to Madinah. The Quran mentions Allah’s help to him in the cave on that journey.";
"discovery.card.fact_hijrah.source" = "Qur’an 9:40 · seerah of the Hijrah";

"discovery.card.fact_seal_prophets.title" = "The Seal of the Prophets";
"discovery.card.fact_seal_prophets.meaning" = "The Quran calls Muhammad ﷺ the Messenger of Allah and the seal of the prophets.";
"discovery.card.fact_seal_prophets.source" = "Qur’an 33:40";

"discovery.card.fact_two_testimonies.title" = "There is no god but Allah";
"discovery.card.fact_two_testimonies.meaning" = "The first pillar is to witness that there is no god but Allah, and that Muhammad ﷺ is His messenger.";
"discovery.card.fact_two_testimonies.source" = "Qur’an 47:19 · Sahih al-Bukhari 8";

"discovery.card.fact_zakat_pillar.title" = "Zakat is a pillar";
"discovery.card.fact_zakat_pillar.meaning" = "The Quran pairs salah with zakat. Giving the due alms is one of the five pillars of Islam.";
"discovery.card.fact_zakat_pillar.source" = "Qur’an 2:43 · Sahih al-Bukhari 8";

"discovery.card.fact_hajj_pillar.title" = "Hajj to the House";
"discovery.card.fact_hajj_pillar.meaning" = "Hajj to the Kaaba is a duty for those who can find a way to it. It is one of the five pillars.";
"discovery.card.fact_hajj_pillar.source" = "Qur’an 3:97 · Sahih al-Bukhari 8";

"discovery.card.fact_fast_ramadan.title" = "Fasting was prescribed";
"discovery.card.fact_fast_ramadan.meaning" = "Fasting was prescribed for you as it was prescribed for those before you, so that you may become mindful of Allah.";
"discovery.card.fact_fast_ramadan.source" = "Qur’an 2:183 · Sahih al-Bukhari 8";

"discovery.card.fact_fatiha_every_salah.title" = "No salah without Al-Fatiha";
"discovery.card.fact_fatiha_every_salah.meaning" = "The Prophet ﷺ said there is no salah for the one who does not recite the Opening of the Book.";
"discovery.card.fact_fatiha_every_salah.source" = "Sahih al-Bukhari 756 · Sahih Muslim 394";

"discovery.card.fact_quran_preserved.title" = "We will guard it";
"discovery.card.fact_quran_preserved.meaning" = "Allah said of the Reminder: “It is We who sent down the Reminder, and We will surely guard it.”";
"discovery.card.fact_quran_preserved.source" = "Qur’an 15:9";

"discovery.card.fact_ramadan_reveal.title" = "Sent down in Ramadan";
"discovery.card.fact_ramadan_reveal.meaning" = "The Quran was sent down in the month of Ramadan, as guidance for people and clear proofs of the criterion.";
"discovery.card.fact_ramadan_reveal.source" = "Qur’an 2:185";

"discovery.card.fact_surah_count.title" = "114 surahs";
"discovery.card.fact_surah_count.meaning" = "The Quran as compiled in the Uthmani mushaf is arranged in 114 surahs, from Al-Fatiha to An-Nas.";
"discovery.card.fact_surah_count.source" = "Uthmani mushaf";

"discovery.card.fact_juz_count.title" = "30 juz";
"discovery.card.fact_juz_count.meaning" = "For recitation, the Quran is divided into 30 juz — one for each night of a typical Ramadan khatm.";
"discovery.card.fact_juz_count.source" = "Uthmani mushaf";

"discovery.card.fact_iqra_first.title" = "The first word: Iqra";
"discovery.card.fact_iqra_first.meaning" = "The first revelation to the Prophet ﷺ in the cave of Hira began with: “Read, in the name of your Lord who created.”";
"discovery.card.fact_iqra_first.source" = "Qur’an 96:1 · Sahih al-Bukhari 3";

"discovery.card.fact_longest_surah.title" = "The longest surah";
"discovery.card.fact_longest_surah.meaning" = "Al-Baqarah is the longest surah in the Quran, with 286 ayahs. It was revealed in Madinah.";
"discovery.card.fact_longest_surah.source" = "Uthmani mushaf · Qur’an 2";

"discovery.card.fact_shortest_surah.title" = "The shortest surah";
"discovery.card.fact_shortest_surah.meaning" = "Al-Kawthar is the shortest surah, with three ayahs.";
"discovery.card.fact_shortest_surah.source" = "Uthmani mushaf · Qur’an 108";

"discovery.card.fact_first_house.title" = "The first House";
"discovery.card.fact_first_house.meaning" = "The Quran says the first House set up for people is the one at Bakkah (Makkah), blessed and a guidance for the worlds.";
"discovery.card.fact_first_house.source" = "Qur’an 3:96";

"discovery.card.fact_qiblah_change.title" = "The qiblah was turned";
"discovery.card.fact_qiblah_change.meaning" = "Allah commanded the Prophet ﷺ to turn his face toward the Sacred Mosque. That became the qiblah of the Muslims.";
"discovery.card.fact_qiblah_change.source" = "Qur’an 2:144";

"discovery.card.fact_arabic_quran.title" = "An Arabic Quran";
"discovery.card.fact_arabic_quran.meaning" = "The Quran was sent down as an Arabic recitation so that its first audience could understand it.";
"discovery.card.fact_arabic_quran.source" = "Qur’an 12:2";

"discovery.card.fact_in_stages.title" = "Sent down in stages";
"discovery.card.fact_in_stages.meaning" = "The Quran was not sent down all at once. It was recited in stages over the years of the Prophet’s ﷺ mission.";
"discovery.card.fact_in_stages.source" = "Qur’an 17:106";

"discovery.card.fact_isra.title" = "The Night Journey";
"discovery.card.fact_isra.meaning" = "Glory be to the One who took His servant by night from the Sacred Mosque to the Farthest Mosque, whose surroundings We blessed.";
"discovery.card.fact_isra.source" = "Qur’an 17:1";

"discovery.card.fact_mercy_to_worlds.title" = "A mercy to the worlds";
"discovery.card.fact_mercy_to_worlds.meaning" = "The Quran says the Prophet ﷺ was not sent except as a mercy to the worlds.";
"discovery.card.fact_mercy_to_worlds.source" = "Qur’an 21:107";

"discovery.card.fact_uswa_hasana.title" = "A beautiful example";
"discovery.card.fact_uswa_hasana.meaning" = "In the Messenger of Allah ﷺ you have a beautiful example for whoever hopes in Allah and the Last Day.";
"discovery.card.fact_uswa_hasana.source" = "Qur’an 33:21";

"discovery.card.fact_great_character.title" = "A tremendous character";
"discovery.card.fact_great_character.meaning" = "Allah said of the Prophet ﷺ: “And you are surely on a tremendous character.”";
"discovery.card.fact_great_character.source" = "Qur’an 68:4";

"discovery.card.fact_salawat.title" = "Allah sends salah upon him";
"discovery.card.fact_salawat.meaning" = "Allah and His angels send salah upon the Prophet ﷺ. Believers are commanded to send salah and greetings upon him too.";
"discovery.card.fact_salawat.source" = "Qur’an 33:56";

"discovery.card.fact_jumuah.title" = "When Friday is called";
"discovery.card.fact_jumuah.meaning" = "When the call is made for Friday prayer, leave trade and hasten to the remembrance of Allah.";
"discovery.card.fact_jumuah.source" = "Qur’an 62:9";

"discovery.card.fact_wudu_ayah.title" = "How wudu is in the Quran";
"discovery.card.fact_wudu_ayah.meaning" = "The Quran names the wudu: wash the faces and arms to the elbows, wipe the heads, and wash the feet to the ankles.";
"discovery.card.fact_wudu_ayah.source" = "Qur’an 5:6";

"discovery.card.fact_no_compulsion.title" = "No compulsion in the religion";
"discovery.card.fact_no_compulsion.meaning" = "There is no compulsion in the religion. Right guidance has become distinct from error.";
"discovery.card.fact_no_compulsion.source" = "Qur’an 2:256";

"discovery.card.fact_quran_easy_remember.title" = "Made easy to remember";
"discovery.card.fact_quran_easy_remember.meaning" = "Allah said: “We have certainly made the Quran easy to remember. So is there any who will remember?” This wording is repeated in Surah Al-Qamar.";
"discovery.card.fact_quran_easy_remember.source" = "Qur’an 54:17";

"discovery.card.fact_bismillah_tawbah.title" = "No Bismillah before At-Tawbah";
"discovery.card.fact_bismillah_tawbah.meaning" = "In the Uthmani mushaf every surah begins with the Bismillah except At-Tawbah (surah 9).";
"discovery.card.fact_bismillah_tawbah.source" = "Uthmani mushaf · Qur’an 9";

"discovery.card.fact_fatiha_seven.title" = "Seven oft-repeated";
"discovery.card.fact_fatiha_seven.meaning" = "Al-Fatiha has seven ayahs. Many scholars take “the seven oft-repeated” in 15:87 to refer to it — recited in every salah.";
"discovery.card.fact_fatiha_seven.source" = "Qur’an 15:87 · Qur’an 1";

"discovery.card.fact_ikhlas_third.title" = "Ikhlas is a third of the Quran";
"discovery.card.fact_ikhlas_third.meaning" = "The Prophet ﷺ said that “Qul Huwa Allahu Ahad” (Al-Ikhlas) is equal to a third of the Quran.";
"discovery.card.fact_ikhlas_third.source" = "Sahih al-Bukhari 5015";

"discovery.card.fact_kursi_greatest.title" = "The greatest ayah";
"discovery.card.fact_kursi_greatest.meaning" = "The Prophet ﷺ asked Ubayy ibn Ka‘b which ayah in the Book of Allah is greatest. He answered Ayat al-Kursi, and the Prophet ﷺ confirmed it.";
"discovery.card.fact_kursi_greatest.source" = "Sahih Muslim 810";

"discovery.card.fact_muawwidhatayn.title" = "The two protecting surahs";
"discovery.card.fact_muawwidhatayn.meaning" = "Al-Falaq and An-Nas are called the Mu‘awwidhatayn. The Prophet ﷺ used them for protection and taught them.";
"discovery.card.fact_muawwidhatayn.source" = "Sahih al-Bukhari 5016";

"discovery.card.fact_iman_six.title" = "Six articles of iman";
"discovery.card.fact_iman_six.meaning" = "Iman is to believe in Allah, His angels, His books, His messengers, the Last Day, and divine decree — its good and its hard.";
"discovery.card.fact_iman_six.source" = "Sahih Muslim 8 · Qur’an 4:136";

"discovery.card.fact_revealed_books.title" = "Books named in the Quran";
"discovery.card.fact_revealed_books.meaning" = "Besides the Quran, the Book names the Tawrah, the Injil, and the Zabur — scriptures given to messengers before.";
"discovery.card.fact_revealed_books.source" = "Qur’an 3:3 · Qur’an 4:163 · Qur’an 5:46";

"discovery.card.fact_twelve_months.title" = "Twelve months with Allah";
"discovery.card.fact_twelve_months.meaning" = "The number of months with Allah is twelve, in the Book of Allah, the day He created the heavens and the earth — four of them sacred.";
"discovery.card.fact_twelve_months.source" = "Qur’an 9:36";

"discovery.card.fact_maqam_ibrahim.title" = "The Station of Ibrahim";
"discovery.card.fact_maqam_ibrahim.meaning" = "Take the Station of Ibrahim as a place of prayer. The Quran links it to the House that Ibrahim and Ismail were commanded to purify.";
"discovery.card.fact_maqam_ibrahim.source" = "Qur’an 2:125";

"discovery.card.fact_named_prophets.title" = "25 prophets named";
"discovery.card.fact_named_prophets.meaning" = "The Quran names twenty-five prophets, from Adam to Muhammad ﷺ. Other messengers are mentioned without being named.";
"discovery.card.fact_named_prophets.source" = "Qur’an · 25 named prophets";

"discovery.card.fact_ninety_nine_names.title" = "Ninety-nine names";
"discovery.card.fact_ninety_nine_names.meaning" = "The Prophet ﷺ said Allah has ninety-nine names, one hundred minus one; whoever enumerates them will enter Paradise.";
"discovery.card.fact_ninety_nine_names.source" = "Sahih al-Bukhari 2736 · Sahih Muslim 2677";

"discovery.card.fact_seven_mathani.title" = "Seven of the oft-repeated";
"discovery.card.fact_seven_mathani.meaning" = "Allah says He gave the Prophet ﷺ seven of the oft-repeated and the Great Quran. Many scholars take this as Al-Fatiha.";
"discovery.card.fact_seven_mathani.source" = "Qur’an 15:87";

"discovery.card.fact_safa_marwa.title" = "Safa and Marwah";
"discovery.card.fact_safa_marwa.meaning" = "Safa and Marwah are among the rites of Allah. Whoever makes Hajj or Umrah to the House, there is no blame in walking between them.";
"discovery.card.fact_safa_marwa.source" = "Qur’an 2:158";

"discovery.card.fact_four_sacred_named.title" = "Four sacred months";
"discovery.card.fact_four_sacred_named.meaning" = "Of the twelve months, four are sacred: Dhul-Qa'dah, Dhul-Hijjah, Muharram, and Rajab — the one that stands between Jumada and Sha'ban.";
"discovery.card.fact_four_sacred_named.source" = "Qur’an 9:36 · Sahih al-Bukhari 3197";

"discovery.card.fact_three_mosques.title" = "Three mosques for a journey";
"discovery.card.fact_three_mosques.meaning" = "The Prophet ﷺ said: do not set out on a journey to visit a mosque except three: the Sacred Mosque, this mosque of mine, and Al-Aqsa.";
"discovery.card.fact_three_mosques.source" = "Sahih al-Bukhari 1189 · Sahih Muslim 1397";

"discovery.card.fact_last_two_baqarah.title" = "The last two ayahs of Al-Baqarah";
"discovery.card.fact_last_two_baqarah.meaning" = "The Prophet ﷺ said whoever recites the last two ayahs of Al-Baqarah at night, they will suffice him.";
"discovery.card.fact_last_two_baqarah.source" = "Sahih al-Bukhari 5009 · Sahih Muslim 808";

"discovery.card.fact_best_days_dhulhijjah.title" = "The best days of the year";
"discovery.card.fact_best_days_dhulhijjah.meaning" = "The Prophet ﷺ said there are no days in which righteous deeds are more beloved to Allah than these ten days — the first ten of Dhul-Hijjah.";
"discovery.card.fact_best_days_dhulhijjah.source" = "Sahih al-Bukhari 969";

"discovery.card.fact_ayah_total.title" = "6236 ayahs";
