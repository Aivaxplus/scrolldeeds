/* Discovery feed expansion */
"discovery.card.shukr.title" = "If you are grateful, I will increase you";
"discovery.card.shukr.meaning" = "Allah says: “If you are grateful, I will surely increase you; but if you deny, indeed My punishment is severe.”";
"discovery.card.shukr.source" = "Qur’an 14:7";

"discovery.card.dua_near.title" = "I am near";
"discovery.card.dua_near.meaning" = "Allah says: “When My servants ask you about Me, indeed I am near. I answer the call of the caller when he calls upon Me.”";
"discovery.card.dua_near.source" = "Qur’an 2:186";

"discovery.card.no_despair.title" = "Do not despair of Allah’s mercy";
"discovery.card.no_despair.meaning" = "Allah says: “Say: O My servants who have transgressed against themselves, do not despair of the mercy of Allah. Indeed, Allah forgives all sins.”";
"discovery.card.no_despair.source" = "Qur’an 39:53";

"discovery.card.qadr.title" = "The Night of Decree";
"discovery.card.qadr.meaning" = "Allah says: “The Night of Decree is better than a thousand months.”";
"discovery.card.qadr.source" = "Qur’an 97:3";

"discovery.card.duha_care.title" = "Your Lord has not forsaken you";
"discovery.card.duha_care.meaning" = "Allah says: “Your Lord has not forsaken you, nor is He displeased. The Last is better for you than the First. Your Lord will give you, and you will be satisfied.”";
"discovery.card.duha_care.source" = "Qur’an 93:3–5";

"discovery.card.asr.title" = "By time, mankind is in loss";
"discovery.card.asr.meaning" = "Allah says: “By time, indeed mankind is in loss — except those who believe, do righteous deeds, and advise one another to truth and to patience.”";
"discovery.card.asr.source" = "Qur’an 103:1–3";

"discovery.card.kawthar.title" = "We have given you al-Kawthar";
"discovery.card.kawthar.meaning" = "Allah says: “We have given you al-Kawthar. So pray to your Lord and sacrifice.”";
"discovery.card.kawthar.source" = "Qur’an 108:1–2";

"discovery.card.no_compulsion.title" = "No compulsion in religion";
"discovery.card.no_compulsion.meaning" = "Allah says: “There is no compulsion in religion. The right way has become distinct from error.”";
"discovery.card.no_compulsion.source" = "Qur’an 2:256";

"discovery.card.with_you.title" = "He is with you wherever you are";
"discovery.card.with_you.meaning" = "Allah says: “He is with you wherever you are. And Allah, of what you do, is All-Seeing.”";
"discovery.card.with_you.source" = "Qur’an 57:4";

"discovery.card.closer.title" = "Closer than the jugular vein";
"discovery.card.closer.meaning" = "Allah says: “We created man and We know what his soul whispers to him, and We are closer to him than his jugular vein.”";
"discovery.card.closer.source" = "Qur’an 50:16";

"discovery.card.spouses.title" = "Affection and mercy between you";
"discovery.card.spouses.meaning" = "Allah says: “He created for you from yourselves spouses, that you may find rest in them, and He placed between you affection and mercy.”";
"discovery.card.spouses.source" = "Qur’an 30:21";

"discovery.card.blessings_count.title" = "You cannot count Allah’s favors";
"discovery.card.blessings_count.meaning" = "Allah says: “If you tried to count the favor of Allah, you could not enumerate it. Indeed, Allah is Forgiving, Merciful.”";
"discovery.card.blessings_count.source" = "Qur’an 16:18";

"discovery.card.fasting_prescribed.title" = "Fasting has been prescribed";
"discovery.card.fasting_prescribed.meaning" = "Allah says: “O you who believe, fasting has been prescribed for you as it was prescribed for those before you, that you may become mindful of Allah.”";
"discovery.card.fasting_prescribed.source" = "Qur’an 2:183";

"discovery.card.yunus_dua.title" = "There is no god but You";
"discovery.card.yunus_dua.meaning" = "Allah says that Yunus called in the darkness: “There is no god except You. Glory be to You. Indeed, I have been of the wrongdoers.”";
"discovery.card.yunus_dua.source" = "Qur’an 21:87";

"discovery.card.hasbuna.title" = "Allah is sufficient for us";
"discovery.card.hasbuna.meaning" = "Allah says that those whose faith increased said: “Allah is sufficient for us, and He is the best Disposer of affairs.”";
"discovery.card.hasbuna.source" = "Qur’an 3:173";

"discovery.card.rabbana_atina.title" = "Good in this world and the next";
"discovery.card.rabbana_atina.meaning" = "Allah says: “Our Lord, give us good in this world and good in the Hereafter, and protect us from the punishment of the Fire.”";
"discovery.card.rabbana_atina.source" = "Qur’an 2:201";

"discovery.card.be_and_it_is.title" = "Be, and it is";
"discovery.card.be_and_it_is.meaning" = "Allah says: “His command, when He intends a thing, is only that He says to it, ‘Be,’ and it is.”";
"discovery.card.be_and_it_is.source" = "Qur’an 36:82";

"discovery.card.which_favors.title" = "Which of your Lord’s favors?";
"discovery.card.which_favors.meaning" = "Allah says: “Then which of the favors of your Lord will you both deny?”";
"discovery.card.which_favors.source" = "Qur’an 55:13";

"discovery.card.calamity.title" = "No calamity except by Allah’s leave";
"discovery.card.calamity.meaning" = "Allah says: “No calamity strikes except by the permission of Allah. And whoever believes in Allah — He guides his heart.”";
"discovery.card.calamity.source" = "Qur’an 64:11";

"discovery.card.death_life.title" = "He created death and life";
"discovery.card.death_life.meaning" = "Allah says: “He who created death and life to test you as to which of you is best in deed — and He is the Exalted in Might, the Forgiving.”";
"discovery.card.death_life.source" = "Qur’an 67:2";

"discovery.card.kafirun.title" = "To you your religion, to me mine";
"discovery.card.kafirun.meaning" = "Allah says: “To you your religion, and to me mine.”";
"discovery.card.kafirun.source" = "Qur’an 109:6";

"discovery.card.nas.title" = "I seek refuge in the Lord of mankind";
"discovery.card.nas.meaning" = "Allah says: “Say: I seek refuge in the Lord of mankind, the King of mankind, the God of mankind.”";
"discovery.card.nas.source" = "Qur’an 114:1–3";

"discovery.card.falaq.title" = "I seek refuge in the Lord of daybreak";
"discovery.card.falaq.meaning" = "Allah says: “Say: I seek refuge in the Lord of daybreak, from the evil of what He created.”";
"discovery.card.falaq.source" = "Qur’an 113:1–2";

"discovery.card.orphans_duha.title" = "Do not oppress the orphan";
"discovery.card.orphans_duha.meaning" = "Allah says: “As for the orphan, do not oppress him. And as for the petitioner, do not repel him. And as for the favor of your Lord, proclaim it.”";
"discovery.card.orphans_duha.source" = "Qur’an 93:9–11";

"discovery.card.justice.title" = "Stand firmly for justice";
"discovery.card.justice.meaning" = "Allah says: “O you who believe, be persistently standing firm in justice, witnesses for Allah, even if it be against yourselves or parents and relatives.”";
"discovery.card.justice.source" = "Qur’an 4:135";

"discovery.card.amanah.title" = "Give trusts back to their owners";
"discovery.card.amanah.meaning" = "Allah says: “Allah commands you to render trusts to whom they are due, and when you judge between people, to judge with justice.”";
"discovery.card.amanah.source" = "Qur’an 4:58";

"discovery.card.luqman_salah.title" = "Establish the prayer, my son";
"discovery.card.luqman_salah.meaning" = "Luqman said: “O my son, establish the prayer, enjoin what is right, forbid what is wrong, and be patient over what befalls you.”";
"discovery.card.luqman_salah.source" = "Qur’an 31:17";

"discovery.card.infaq_grain.title" = "The parable of spending";
"discovery.card.infaq_grain.meaning" = "Allah says: “The example of those who spend their wealth in the way of Allah is like a grain that sprouts seven ears, in every ear a hundred grains. Allah multiplies for whom He wills.”";
"discovery.card.infaq_grain.source" = "Qur’an 2:261";

"discovery.card.rabbana_forgive.title" = "Do not take us to task if we forget";
"discovery.card.rabbana_forgive.meaning" = "Allah says: “Our Lord, do not take us to task if we forget or err. Our Lord, do not lay upon us a burden like that You laid upon those before us.”";
"discovery.card.rabbana_forgive.source" = "Qur’an 2:286";

"discovery.card.establish_salah.title" = "Establish the prayer and give zakah";
"discovery.card.establish_salah.meaning" = "Allah says: “Establish the prayer and give zakah and bow with those who bow.”";
"discovery.card.establish_salah.source" = "Qur’an 2:43";

"discovery.card.way_out.title" = "Whoever has taqwa, Allah makes a way out";
"discovery.card.way_out.meaning" = "Allah says: “Whoever has taqwa of Allah — He will make for him a way out, and will provide for him from where he does not expect.”";
"discovery.card.way_out.source" = "Qur’an 65:2–3";

"discovery.card.sincere_deen.title" = "Worship Allah, making the religion sincere";
"discovery.card.sincere_deen.meaning" = "Allah says: “They were not commanded except to worship Allah, making the religion sincere to Him, inclining to truth, and to establish the prayer and give zakah.”";
"discovery.card.sincere_deen.source" = "Qur’an 98:5";

"discovery.card.allah_light.title" = "Allah is the Light of the heavens and the earth";
"discovery.card.allah_light.meaning" = "Allah says: “Allah is the Light of the heavens and the earth.”";
"discovery.card.allah_light.source" = "Qur’an 24:35";

"discovery.card.expand_chest.title" = "Did We not expand your chest?";
"discovery.card.expand_chest.meaning" = "Allah says: “Did We not expand for you your chest, and remove from you your burden that had weighed upon your back, and raise high your remembrance?”";
"discovery.card.expand_chest.source" = "Qur’an 94:1–4";

"discovery.card.hikmah.title" = "He gives wisdom to whom He wills";
"discovery.card.hikmah.meaning" = "Allah says: “He gives wisdom to whom He wills, and whoever is given wisdom has certainly been given much good.”";
"discovery.card.hikmah.source" = "Qur’an 2:269";

"discovery.card.five_pillars.title" = "Islam is built on five";
"discovery.card.five_pillars.meaning" = "The Prophet ﷺ said: “Islam is built on five: the testimony that there is no god but Allah and that Muhammad is the Messenger of Allah, establishing the prayer, giving zakah, Hajj, and fasting Ramadan.”";
"discovery.card.five_pillars.source" = "Sahih al-Bukhari 8 · Sahih Muslim 16";

"discovery.card.muslim_tongue.title" = "Safe from his tongue and hand";
"discovery.card.muslim_tongue.meaning" = "The Prophet ﷺ said: “The Muslim is the one from whose tongue and hand the Muslims are safe.”";
"discovery.card.muslim_tongue.source" = "Sahih al-Bukhari 10 · Sahih Muslim 41";

"discovery.card.deen_nasihah.title" = "The religion is sincere advice";
"discovery.card.deen_nasihah.meaning" = "The Prophet ﷺ said: “The religion is nasihah (sincere advice).” They said: To whom? He said: “To Allah, His Book, His Messenger, the leaders of the Muslims, and their common folk.”";
"discovery.card.deen_nasihah.source" = "Sahih Muslim 55";

"discovery.card.best_quran.title" = "The best of you learn and teach the Qur’an";
"discovery.card.best_quran.meaning" = "The Prophet ﷺ said: “The best of you are those who learn the Qur’an and teach it.”";
"discovery.card.best_quran.source" = "Sahih al-Bukhari 5027";

"discovery.card.mother_first.title" = "Your mother, then your mother";
"discovery.card.mother_first.meaning" = "A man asked: Who is most deserving of my good companionship? The Prophet ﷺ said: “Your mother.” He said: Then who? He said: “Your mother.” He said: Then who? He said: “Your mother.” He said: Then who? He said: “Your father.”";
"discovery.card.mother_first.source" = "Sahih al-Bukhari 5971 · Sahih Muslim 2548";

"discovery.card.plant_tree.title" = "A planted tree is charity";
"discovery.card.plant_tree.meaning" = "The Prophet ﷺ said: “Never does a Muslim plant a tree or sow a crop, and a bird, a human, or an animal eats from it, except that it is charity for him.”";
"discovery.card.plant_tree.source" = "Sahih Muslim 1553";

"discovery.card.seven_shade.title" = "Seven in Allah’s shade";
"discovery.card.seven_shade.meaning" = "The Prophet ﷺ said: “Seven will be shaded by Allah on the Day when there is no shade but His: a just ruler; a youth who grew up in the worship of Allah; a man whose heart is attached to the mosque; two who love one another for Allah; a man who is invited by a woman of status and beauty and says, ‘I fear Allah’; one who gives charity so secretly that his left hand does not know what his right spends; and one who remembers Allah in private and his eyes overflow.”";
"discovery.card.seven_shade.source" = "Sahih al-Bukhari 1423 · Sahih Muslim 1031";

"discovery.card.tasbih_salah.title" = "After the prayer: 33, 33, 34";
"discovery.card.tasbih_salah.meaning" = "The Prophet ﷺ taught after the salah: Subhan Allah thirty-three times, al-hamdu lillah thirty-three times, and Allahu akbar thirty-four times.";
"discovery.card.tasbih_salah.source" = "Sahih Muslim 596";

"discovery.card.hundred_tasbih.title" = "A hundred times a day";
"discovery.card.hundred_tasbih.meaning" = "The Prophet ﷺ said: “Whoever says ‘Glory be to Allah and praise be to Him’ a hundred times a day, his sins are forgiven even if they are like the foam of the sea.”";
"discovery.card.hundred_tasbih.source" = "Sahih al-Bukhari 6405 · Sahih Muslim 2691";

"discovery.card.enter_masjid.title" = "When you enter the mosque";
"discovery.card.enter_masjid.meaning" = "The Prophet ﷺ said: when one of you enters the mosque, let him say: “O Allah, open for me the doors of Your mercy.”";
"discovery.card.enter_masjid.source" = "Sahih Muslim 713";

"discovery.card.do_not_anger.title" = "Do not become angry";
"discovery.card.do_not_anger.meaning" = "A man said to the Prophet ﷺ: Advise me. He said: “Do not become angry.” The man repeated his request several times, and he said: “Do not become angry.”";
"discovery.card.do_not_anger.source" = "Sahih al-Bukhari 6116";

"discovery.card.make_easy.title" = "Make things easy";
"discovery.card.make_easy.meaning" = "The Prophet ﷺ said: “Make things easy and do not make them difficult. Give glad tidings and do not drive people away.”";
"discovery.card.make_easy.source" = "Sahih al-Bukhari 69";

"discovery.card.religion_ease.title" = "The religion is ease";
"discovery.card.religion_ease.meaning" = "The Prophet ﷺ said: “The religion is ease. No one makes the religion hard on himself except that it will overcome him. So be moderate, do your best, rejoice, and seek help in the morning, the afternoon, and a little at night.”";
"discovery.card.religion_ease.source" = "Sahih al-Bukhari 39";

"discovery.card.feed_hungry.title" = "Feed the hungry";
"discovery.card.feed_hungry.meaning" = "The Prophet ﷺ said: “Feed the hungry, visit the sick, and free the captive.”";
"discovery.card.feed_hungry.source" = "Sahih al-Bukhari 5373";

"discovery.card.good_word.title" = "A good word is charity";
"discovery.card.good_word.meaning" = "The Prophet ﷺ said: “A good word is charity.”";
"discovery.card.good_word.source" = "Sahih al-Bukhari 2989 · Sahih Muslim 1009";

"discovery.card.no_cheating.title" = "Whoever cheats is not of us";
"discovery.card.no_cheating.meaning" = "The Prophet ﷺ said: “Whoever cheats us is not of us.”";
"discovery.card.no_cheating.source" = "Sahih Muslim 102";

"discovery.card.sleep_muawwidhat.title" = "Recite the last three surahs before sleep";
"discovery.card.sleep_muawwidhat.meaning" = "Aisha reported that when the Prophet ﷺ went to bed, he would cup his hands, blow into them, and recite Surah al-Ikhlas, al-Falaq and an-Nas, then wipe over his body.";
"discovery.card.sleep_muawwidhat.source" = "Sahih al-Bukhari 5017";

"discovery.card.treat_women.title" = "Fear Allah regarding women";
"discovery.card.treat_women.meaning" = "The Prophet ﷺ said in the Farewell Sermon: “Fear Allah regarding women, for you have taken them as a trust from Allah, and intimacy with them has been made lawful for you by the word of Allah.”";
"discovery.card.treat_women.source" = "Sahih Muslim 1218";

"discovery.card.wudu_sins.title" = "Wudu washes away sins";
"discovery.card.wudu_sins.meaning" = "The Prophet ﷺ said: when a Muslim — or a believer — performs wudu and washes his face, every sin he looked at with his eyes leaves with the water, or with the last drop of water; when he washes his hands, every sin his hands committed leaves; when he washes his feet, every sin his feet walked to leaves — until he comes out cleansed of sin.";
"discovery.card.wudu_sins.source" = "Sahih Muslim 244";

/* BEGIN DISCOVERY EXPANSION */
"discovery.card.ayah_1_1.title" = "Al-Faatiha 1";
"discovery.card.ayah_1_1.meaning" = "In the name of Allah, the Entirely Merciful, the Especially Merciful.";
"discovery.card.ayah_1_1.source" = "Qur’an 1:1";

"discovery.card.ayah_1_4.title" = "Al-Faatiha 4";
"discovery.card.ayah_1_4.meaning" = "Sovereign of the Day of Recompense.";
"discovery.card.ayah_1_4.source" = "Qur’an 1:4";

"discovery.card.ayah_1_5.title" = "Al-Faatiha 5";
"discovery.card.ayah_1_5.meaning" = "It is You we worship and You we ask for help.";
"discovery.card.ayah_1_5.source" = "Qur’an 1:5";

"discovery.card.ayah_1_6.title" = "Al-Faatiha 6";
"discovery.card.ayah_1_6.meaning" = "Guide us to the straight path -";
"discovery.card.ayah_1_6.source" = "Qur’an 1:6";

"discovery.card.ayah_1_7.title" = "Al-Faatiha 7";
"discovery.card.ayah_1_7.meaning" = "The path of those upon whom You have bestowed favor, not of those who have evoked [Your] anger or of those who are astray.";
"discovery.card.ayah_1_7.source" = "Qur’an 1:7";

"discovery.card.ayah_2_2.title" = "Al-Baqara 2";
"discovery.card.ayah_2_2.meaning" = "This is the Book about which there is no doubt, a guidance for those conscious of Allah -";
"discovery.card.ayah_2_2.source" = "Qur’an 2:2";

"discovery.card.ayah_2_21.title" = "Al-Baqara 21";
"discovery.card.ayah_2_21.meaning" = "O mankind, worship your Lord, who created you and those before you, that you may become righteous -";
"discovery.card.ayah_2_21.source" = "Qur’an 2:21";

"discovery.card.ayah_2_45.title" = "Al-Baqara 45";
"discovery.card.ayah_2_45.meaning" = "And seek help through patience and prayer, and indeed, it is difficult except for the humbly submissive [to Allah]";
"discovery.card.ayah_2_45.source" = "Qur’an 2:45";

"discovery.card.ayah_2_155.title" = "Al-Baqara 155";
"discovery.card.ayah_2_155.meaning" = "And We will surely test you with something of fear and hunger and a loss of wealth and lives and fruits, but give good tidings to the patient,";
"discovery.card.ayah_2_155.source" = "Qur’an 2:155";

"discovery.card.ayah_2_165.title" = "Al-Baqara 165";
"discovery.card.ayah_2_165.meaning" = "And [yet], among the people are those who take other than Allah as equals [to Him]. They love them as they [should] love Allah. But those who believe are stronger in love for Allah. And if only they who have wronged would consider [that] when they see the punishment, [they will be certain] that all power belongs to Allah and that Allah is severe in punishment.";
"discovery.card.ayah_2_165.source" = "Qur’an 2:165";

"discovery.card.ayah_2_177.title" = "Al-Baqara 177";
"discovery.card.ayah_2_177.meaning" = "Righteousness is not that you turn your faces toward the east or the west, but [true] righteousness is [in] one who believes in Allah, the Last Day, the angels, the Book, and the prophets and gives wealth, in spite of love for it, to relatives, orphans, the needy, the traveler, those who ask [for help], and for freeing slaves; [and who] establishes prayer and gives zakah; [those who] fulfill their promise when they promise; and [those who] are patient in poverty and hardship and during battle. Those are the ones who have been true, and it is those who are the righteous.";
"discovery.card.ayah_2_177.source" = "Qur’an 2:177";

"discovery.card.ayah_2_185.title" = "Al-Baqara 185";
"discovery.card.ayah_2_185.meaning" = "The month of Ramadhan [is that] in which was revealed the Qur'an, a guidance for the people and clear proofs of guidance and criterion. So whoever sights [the new moon of] the month, let him fast it; and whoever is ill or on a journey - then an equal number of other days. Allah intends for you ease and does not intend for you hardship and [wants] for you to complete the period and to glorify Allah for that [to] which He has guided you; and perhaps you will be grateful.";
"discovery.card.ayah_2_185.source" = "Qur’an 2:185";

"discovery.card.ayah_2_197.title" = "Al-Baqara 197";
"discovery.card.ayah_2_197.meaning" = "Hajj is [during] well-known months, so whoever has made Hajj obligatory upon himself therein [by entering the state of ihram], there is [to be for him] no sexual relations and no disobedience and no disputing during Hajj. And whatever good you do - Allah knows it. And take provisions, but indeed, the best provision is fear of Allah. And fear Me, O you of understanding.";
"discovery.card.ayah_2_197.source" = "Qur’an 2:197";

"discovery.card.ayah_2_208.title" = "Al-Baqara 208";
"discovery.card.ayah_2_208.meaning" = "O you who have believed, enter into Islam completely [and perfectly] and do not follow the footsteps of Satan. Indeed, he is to you a clear enemy.";
"discovery.card.ayah_2_208.source" = "Qur’an 2:208";

"discovery.card.ayah_2_216.title" = "Al-Baqara 216";
"discovery.card.ayah_2_216.meaning" = "Fighting has been enjoined upon you while it is hateful to you. But perhaps you hate a thing and it is good for you; and perhaps you love a thing and it is bad for you. And Allah Knows, while you know not.";
"discovery.card.ayah_2_216.source" = "Qur’an 2:216";

"discovery.card.ayah_2_245.title" = "Al-Baqara 245";
"discovery.card.ayah_2_245.meaning" = "Who is it that would loan Allah a goodly loan so He may multiply it for him many times over? And it is Allah who withholds and grants abundance, and to Him you will be returned.";
"discovery.card.ayah_2_245.source" = "Qur’an 2:245";

"discovery.card.ayah_2_254.title" = "Al-Baqara 254";
"discovery.card.ayah_2_254.meaning" = "O you who have believed, spend from that which We have provided for you before there comes a Day in which there is no exchange and no friendship and no intercession. And the disbelievers - they are the wrongdoers.";
"discovery.card.ayah_2_254.source" = "Qur’an 2:254";

"discovery.card.ayah_2_267.title" = "Al-Baqara 267";
"discovery.card.ayah_2_267.meaning" = "O you who have believed, spend from the good things which you have earned and from that which We have produced for you from the earth. And do not aim toward the defective therefrom, spending [from that] while you would not take it [yourself] except with closed eyes. And know that Allah is Free of need and Praiseworthy.";
"discovery.card.ayah_2_267.source" = "Qur’an 2:267";

"discovery.card.ayah_2_285.title" = "Al-Baqara 285";
"discovery.card.ayah_2_285.meaning" = "The Messenger has believed in what was revealed to him from his Lord, and [so have] the believers. All of them have believed in Allah and His angels and His books and His messengers, [saying], \"We make no distinction between any of His messengers.\" And they say, \"We hear and we obey. [We seek] Your forgiveness, our Lord, and to You is the [final] destination.\"";
"discovery.card.ayah_2_285.source" = "Qur’an 2:285";

"discovery.card.ayah_3_8.title" = "Aal-i-Imraan 8";
"discovery.card.ayah_3_8.meaning" = "[Who say], \"Our Lord, let not our hearts deviate after You have guided us and grant us from Yourself mercy. Indeed, You are the Bestower.";
"discovery.card.ayah_3_8.source" = "Qur’an 3:8";

"discovery.card.ayah_3_26.title" = "Aal-i-Imraan 26";
"discovery.card.ayah_3_26.meaning" = "Say, \"O Allah, Owner of Sovereignty, You give sovereignty to whom You will and You take sovereignty away from whom You will. You honor whom You will and You humble whom You will. In Your hand is [all] good. Indeed, You are over all things competent.";
"discovery.card.ayah_3_26.source" = "Qur’an 3:26";

"discovery.card.ayah_3_31.title" = "Aal-i-Imraan 31";
"discovery.card.ayah_3_31.meaning" = "Say, [O Muhammad], \"If you should love Allah, then follow me, [so] Allah will love you and forgive you your sins. And Allah is Forgiving and Merciful.\"";
"discovery.card.ayah_3_31.source" = "Qur’an 3:31";

"discovery.card.ayah_3_92.title" = "Aal-i-Imraan 92";
"discovery.card.ayah_3_92.meaning" = "Never will you attain the good [reward] until you spend [in the way of Allah] from that which you love. And whatever you spend - indeed, Allah is Knowing of it.";
"discovery.card.ayah_3_92.source" = "Qur’an 3:92";

"discovery.card.ayah_3_102.title" = "Aal-i-Imraan 102";
"discovery.card.ayah_3_102.meaning" = "O you who have believed, fear Allah as He should be feared and do not die except as Muslims [in submission to Him].";
"discovery.card.ayah_3_102.source" = "Qur’an 3:102";

"discovery.card.ayah_3_103.title" = "Aal-i-Imraan 103";
"discovery.card.ayah_3_103.meaning" = "And hold firmly to the rope of Allah all together and do not become divided. And remember the favor of Allah upon you - when you were enemies and He brought your hearts together and you became, by His favor, brothers. And you were on the edge of a pit of the Fire, and He saved you from it. Thus does Allah make clear to you His verses that you may be guided.";
"discovery.card.ayah_3_103.source" = "Qur’an 3:103";

"discovery.card.ayah_3_110.title" = "Aal-i-Imraan 110";
"discovery.card.ayah_3_110.meaning" = "You are the best nation produced [as an example] for mankind. You enjoin what is right and forbid what is wrong and believe in Allah. If only the People of the Scripture had believed, it would have been better for them. Among them are believers, but most of them are defiantly disobedient.";
"discovery.card.ayah_3_110.source" = "Qur’an 3:110";

"discovery.card.ayah_3_133.title" = "Aal-i-Imraan 133";
"discovery.card.ayah_3_133.meaning" = "And hasten to forgiveness from your Lord and a garden as wide as the heavens and earth, prepared for the righteous";
"discovery.card.ayah_3_133.source" = "Qur’an 3:133";

"discovery.card.ayah_3_139.title" = "Aal-i-Imraan 139";
"discovery.card.ayah_3_139.meaning" = "So do not weaken and do not grieve, and you will be superior if you are [true] believers.";
"discovery.card.ayah_3_139.source" = "Qur’an 3:139";

"discovery.card.ayah_3_159.title" = "Aal-i-Imraan 159";
"discovery.card.ayah_3_159.meaning" = "So by mercy from Allah, [O Muhammad], you were lenient with them. And if you had been rude [in speech] and harsh in heart, they would have disbanded from about you. So pardon them and ask forgiveness for them and consult them in the matter. And when you have decided, then rely upon Allah. Indeed, Allah loves those who rely [upon Him].";
"discovery.card.ayah_3_159.source" = "Qur’an 3:159";

"discovery.card.ayah_3_185.title" = "Aal-i-Imraan 185";
"discovery.card.ayah_3_185.meaning" = "Every soul will taste death, and you will only be given your [full] compensation on the Day of Resurrection. So he who is drawn away from the Fire and admitted to Paradise has attained [his desire]. And what is the life of this world except the enjoyment of delusion.";
"discovery.card.ayah_3_185.source" = "Qur’an 3:185";

"discovery.card.ayah_3_190.title" = "Aal-i-Imraan 190";
"discovery.card.ayah_3_190.meaning" = "Indeed, in the creation of the heavens and the earth and the alternation of the night and the day are signs for those of understanding.";
"discovery.card.ayah_3_190.source" = "Qur’an 3:190";

"discovery.card.ayah_3_200.title" = "Aal-i-Imraan 200";
"discovery.card.ayah_3_200.meaning" = "O you who have believed, persevere and endure and remain stationed and fear Allah that you may be successful.";
"discovery.card.ayah_3_200.source" = "Qur’an 3:200";

"discovery.card.ayah_4_1.title" = "An-Nisaa 1";
"discovery.card.ayah_4_1.meaning" = "O mankind, fear your Lord, who created you from one soul and created from it its mate and dispersed from both of them many men and women. And fear Allah, through whom you ask one another, and the wombs. Indeed Allah is ever, over you, an Observer.";
"discovery.card.ayah_4_1.source" = "Qur’an 4:1";

"discovery.card.ayah_4_29.title" = "An-Nisaa 29";
"discovery.card.ayah_4_29.meaning" = "O you who have believed, do not consume one another's wealth unjustly but only [in lawful] business by mutual consent. And do not kill yourselves [or one another]. Indeed, Allah is to you ever Merciful.";
"discovery.card.ayah_4_29.source" = "Qur’an 4:29";

"discovery.card.ayah_4_36.title" = "An-Nisaa 36";
"discovery.card.ayah_4_36.meaning" = "Worship Allah and associate nothing with Him, and to parents do good, and to relatives, orphans, the needy, the near neighbor, the neighbor farther away, the companion at your side, the traveler, and those whom your right hands possess. Indeed, Allah does not like those who are self-deluding and boastful.";
"discovery.card.ayah_4_36.source" = "Qur’an 4:36";

"discovery.card.ayah_4_40.title" = "An-Nisaa 40";
"discovery.card.ayah_4_40.meaning" = "Indeed, Allah does not do injustice, [even] as much as an atom's weight; while if there is a good deed, He multiplies it and gives from Himself a great reward.";
"discovery.card.ayah_4_40.source" = "Qur’an 4:40";

"discovery.card.ayah_4_59.title" = "An-Nisaa 59";
"discovery.card.ayah_4_59.meaning" = "O you who have believed, obey Allah and obey the Messenger and those in authority among you. And if you disagree over anything, refer it to Allah and the Messenger, if you should believe in Allah and the Last Day. That is the best [way] and best in result.";
"discovery.card.ayah_4_59.source" = "Qur’an 4:59";

"discovery.card.ayah_4_69.title" = "An-Nisaa 69";
"discovery.card.ayah_4_69.meaning" = "And whoever obeys Allah and the Messenger - those will be with the ones upon whom Allah has bestowed favor of the prophets, the steadfast affirmers of truth, the martyrs and the righteous. And excellent are those as companions.";
"discovery.card.ayah_4_69.source" = "Qur’an 4:69";

"discovery.card.ayah_4_86.title" = "An-Nisaa 86";
"discovery.card.ayah_4_86.meaning" = "And when you are greeted with a greeting, greet [in return] with one better than it or [at least] return it [in a like manner]. Indeed, Allah is ever, over all things, an Accountant.";
"discovery.card.ayah_4_86.source" = "Qur’an 4:86";

"discovery.card.ayah_4_103.title" = "An-Nisaa 103";
"discovery.card.ayah_4_103.meaning" = "And when you have completed the prayer, remember Allah standing, sitting, or [lying] on your sides. But when you become secure, re-establish [regular] prayer. Indeed, prayer has been decreed upon the believers a decree of specified times.";
"discovery.card.ayah_4_103.source" = "Qur’an 4:103";

"discovery.card.ayah_4_174.title" = "An-Nisaa 174";
"discovery.card.ayah_4_174.meaning" = "O mankind, there has come to you a conclusive proof from your Lord, and We have sent down to you a clear light.";
"discovery.card.ayah_4_174.source" = "Qur’an 4:174";

"discovery.card.ayah_5_2.title" = "Al-Maaida 2";
"discovery.card.ayah_5_2.meaning" = "O you who have believed, do not violate the rites of Allah or [the sanctity of] the sacred month or [neglect the marking of] the sacrificial animals and garlanding [them] or [violate the safety of] those coming to the Sacred House seeking bounty from their Lord and [His] approval. But when you come out of ihram, then [you may] hunt. And do not let the hatred of a people for having obstructed you from al-Masjid al-Haram lead you to transgress. And cooperate in righteousness and piety, but do not cooperate in sin and aggression. And fear Allah; indeed, Allah is severe in penalty.";
"discovery.card.ayah_5_2.source" = "Qur’an 5:2";

"discovery.card.ayah_5_3.title" = "Al-Maaida 3";
"discovery.card.ayah_5_3.meaning" = "Prohibited to you are dead animals, blood, the flesh of swine, and that which has been dedicated to other than Allah, and [those animals] killed by strangling or by a violent blow or by a head-long fall or by the goring of horns, and those from which a wild animal has eaten, except what you [are able to] slaughter [before its death], and those which are sacrificed on stone altars, and [prohibited is] that you seek decision through divining arrows. That is grave disobedience. This day those who disbelieve have despaired of [defeating] your religion; so fear them not, but fear Me. This day I have perfected for you your religion and completed My favor upon you and have approved for you Islam as religion. But whoever is forced by severe hunger with no inclination to sin - then indeed, Allah is Forgiving and Merciful.";
"discovery.card.ayah_5_3.source" = "Qur’an 5:3";

"discovery.card.ayah_5_6.title" = "Al-Maaida 6";
"discovery.card.ayah_5_6.meaning" = "O you who have believed, when you rise to [perform] prayer, wash your faces and your forearms to the elbows and wipe over your heads and wash your feet to the ankles. And if you are in a state of janabah, then purify yourselves. But if you are ill or on a journey or one of you comes from the place of relieving himself or you have contacted women and do not find water, then seek clean earth and wipe over your faces and hands with it. Allah does not intend to make difficulty for you, but He intends to purify you and complete His favor upon you that you may be grateful.";
"discovery.card.ayah_5_6.source" = "Qur’an 5:6";

"discovery.card.ayah_5_8.title" = "Al-Maaida 8";
"discovery.card.ayah_5_8.meaning" = "O you who have believed, be persistently standing firm for Allah, witnesses in justice, and do not let the hatred of a people prevent you from being just. Be just; that is nearer to righteousness. And fear Allah; indeed, Allah is Acquainted with what you do.";
"discovery.card.ayah_5_8.source" = "Qur’an 5:8";

"discovery.card.ayah_5_32.title" = "Al-Maaida 32";
"discovery.card.ayah_5_32.meaning" = "Because of that, We decreed upon the Children of Israel that whoever kills a soul unless for a soul or for corruption [done] in the land - it is as if he had slain mankind entirely. And whoever saves one - it is as if he had saved mankind entirely. And our messengers had certainly come to them with clear proofs. Then indeed many of them, [even] after that, throughout the land, were transgressors.";
"discovery.card.ayah_5_32.source" = "Qur’an 5:32";

"discovery.card.ayah_5_35.title" = "Al-Maaida 35";
"discovery.card.ayah_5_35.meaning" = "O you who have believed, fear Allah and seek the means [of nearness] to Him and strive in His cause that you may succeed.";
"discovery.card.ayah_5_35.source" = "Qur’an 5:35";

"discovery.card.ayah_5_54.title" = "Al-Maaida 54";
"discovery.card.ayah_5_54.meaning" = "O you who have believed, whoever of you should revert from his religion - Allah will bring forth [in place of them] a people He will love and who will love Him [who are] humble toward the believers, powerful against the disbelievers; they strive in the cause of Allah and do not fear the blame of a critic. That is the favor of Allah; He bestows it upon whom He wills. And Allah is all-Encompassing and Knowing.";
"discovery.card.ayah_5_54.source" = "Qur’an 5:54";

"discovery.card.ayah_5_119.title" = "Al-Maaida 119";
"discovery.card.ayah_5_119.meaning" = "Allah will say, \"This is the Day when the truthful will benefit from their truthfulness.\" For them are gardens [in Paradise] beneath which rivers flow, wherein they will abide forever, Allah being pleased with them, and they with Him. That is the great attainment.";
"discovery.card.ayah_5_119.source" = "Qur’an 5:119";

"discovery.card.ayah_6_17.title" = "Al-An'aam 17";
"discovery.card.ayah_6_17.meaning" = "And if Allah should touch you with adversity, there is no remover of it except Him. And if He touches you with good - then He is over all things competent.";
"discovery.card.ayah_6_17.source" = "Qur’an 6:17";

"discovery.card.ayah_6_54.title" = "Al-An'aam 54";
"discovery.card.ayah_6_54.meaning" = "And when those come to you who believe in Our verses, say, \"Peace be upon you. Your Lord has decreed upon Himself mercy: that any of you who does wrong out of ignorance and then repents after that and corrects himself - indeed, He is Forgiving and Merciful.\"";
"discovery.card.ayah_6_54.source" = "Qur’an 6:54";

"discovery.card.ayah_6_125.title" = "Al-An'aam 125";
"discovery.card.ayah_6_125.meaning" = "So whoever Allah wants to guide - He expands his breast to [contain] Islam; and whoever He wants to misguide - He makes his breast tight and constricted as though he were climbing into the sky. Thus does Allah place defilement upon those who do not believe.";
"discovery.card.ayah_6_125.source" = "Qur’an 6:125";

"discovery.card.ayah_6_151.title" = "Al-An'aam 151";
"discovery.card.ayah_6_151.meaning" = "Say, \"Come, I will recite what your Lord has prohibited to you. [He commands] that you not associate anything with Him, and to parents, good treatment, and do not kill your children out of poverty; We will provide for you and them. And do not approach immoralities - what is apparent of them and what is concealed. And do not kill the soul which Allah has forbidden [to be killed] except by [legal] right. This has He instructed you that you may use reason.\"";
"discovery.card.ayah_6_151.source" = "Qur’an 6:151";

"discovery.card.ayah_6_162.title" = "Al-An'aam 162";
"discovery.card.ayah_6_162.meaning" = "Say, \"Indeed, my prayer, my rites of sacrifice, my living and my dying are for Allah, Lord of the worlds.";
"discovery.card.ayah_6_162.source" = "Qur’an 6:162";

"discovery.card.ayah_7_23.title" = "Al-A'raaf 23";
"discovery.card.ayah_7_23.meaning" = "They said, \"Our Lord, we have wronged ourselves, and if You do not forgive us and have mercy upon us, we will surely be among the losers.\"";
"discovery.card.ayah_7_23.source" = "Qur’an 7:23";

"discovery.card.ayah_7_31.title" = "Al-A'raaf 31";
"discovery.card.ayah_7_31.meaning" = "O children of Adam, take your adornment at every masjid, and eat and drink, but be not excessive. Indeed, He likes not those who commit excess.";
"discovery.card.ayah_7_31.source" = "Qur’an 7:31";

"discovery.card.ayah_7_56.title" = "Al-A'raaf 56";
"discovery.card.ayah_7_56.meaning" = "And cause not corruption upon the earth after its reformation. And invoke Him in fear and aspiration. Indeed, the mercy of Allah is near to the doers of good.";
"discovery.card.ayah_7_56.source" = "Qur’an 7:56";

"discovery.card.ayah_7_128.title" = "Al-A'raaf 128";
"discovery.card.ayah_7_128.meaning" = "Said Moses to his people, \"Seek help through Allah and be patient. Indeed, the earth belongs to Allah. He causes to inherit it whom He wills of His servants. And the [best] outcome is for the righteous.\"";
"discovery.card.ayah_7_128.source" = "Qur’an 7:128";

"discovery.card.ayah_7_199.title" = "Al-A'raaf 199";
"discovery.card.ayah_7_199.meaning" = "Take what is given freely, enjoin what is good, and turn away from the ignorant.";
"discovery.card.ayah_7_199.source" = "Qur’an 7:199";

"discovery.card.ayah_7_204.title" = "Al-A'raaf 204";
"discovery.card.ayah_7_204.meaning" = "So when the Qur'an is recited, then listen to it and pay attention that you may receive mercy.";
"discovery.card.ayah_7_204.source" = "Qur’an 7:204";

"discovery.card.ayah_8_2.title" = "Al-Anfaal 2";
"discovery.card.ayah_8_2.meaning" = "The believers are only those who, when Allah is mentioned, their hearts become fearful, and when His verses are recited to them, it increases them in faith; and upon their Lord they rely -";
"discovery.card.ayah_8_2.source" = "Qur’an 8:2";

"discovery.card.ayah_8_29.title" = "Al-Anfaal 29";
"discovery.card.ayah_8_29.meaning" = "O you who have believed, if you fear Allah, He will grant you a criterion and will remove from you your misdeeds and forgive you. And Allah is the possessor of great bounty.";
"discovery.card.ayah_8_29.source" = "Qur’an 8:29";

"discovery.card.ayah_8_46.title" = "Al-Anfaal 46";
"discovery.card.ayah_8_46.meaning" = "And obey Allah and His Messenger, and do not dispute and [thus] lose courage and [then] your strength would depart; and be patient. Indeed, Allah is with the patient.";
"discovery.card.ayah_8_46.source" = "Qur’an 8:46";

"discovery.card.ayah_8_61.title" = "Al-Anfaal 61";
"discovery.card.ayah_8_61.meaning" = "And if they incline to peace, then incline to it [also] and rely upon Allah. Indeed, it is He who is the Hearing, the Knowing.";
"discovery.card.ayah_8_61.source" = "Qur’an 8:61";

"discovery.card.ayah_9_18.title" = "At-Tawba 18";
"discovery.card.ayah_9_18.meaning" = "The mosques of Allah are only to be maintained by those who believe in Allah and the Last Day and establish prayer and give zakah and do not fear except Allah, for it is expected that those will be of the [rightly] guided.";
"discovery.card.ayah_9_18.source" = "Qur’an 9:18";

"discovery.card.ayah_9_40.title" = "At-Tawba 40";
"discovery.card.ayah_9_40.meaning" = "If you do not aid the Prophet - Allah has already aided him when those who disbelieved had driven him out [of Makkah] as one of two, when they were in the cave and he said to his companion, \"Do not grieve; indeed Allah is with us.\" And Allah sent down his tranquillity upon him and supported him with angels you did not see and made the word of those who disbelieved the lowest, while the word of Allah - that is the highest. And Allah is Exalted in Might and Wise.";
"discovery.card.ayah_9_40.source" = "Qur’an 9:40";

"discovery.card.ayah_9_51.title" = "At-Tawba 51";
"discovery.card.ayah_9_51.meaning" = "Say, \"Never will we be struck except by what Allah has decreed for us; He is our protector.\" And upon Allah let the believers rely.";
"discovery.card.ayah_9_51.source" = "Qur’an 9:51";

"discovery.card.ayah_9_71.title" = "At-Tawba 71";
"discovery.card.ayah_9_71.meaning" = "The believing men and believing women are allies of one another. They enjoin what is right and forbid what is wrong and establish prayer and give zakah and obey Allah and His Messenger. Those - Allah will have mercy upon them. Indeed, Allah is Exalted in Might and Wise.";
"discovery.card.ayah_9_71.source" = "Qur’an 9:71";

"discovery.card.ayah_9_103.title" = "At-Tawba 103";
"discovery.card.ayah_9_103.meaning" = "Take, [O, Muhammad], from their wealth a charity by which you purify them and cause them increase, and invoke [Allah 's blessings] upon them. Indeed, your invocations are reassurance for them. And Allah is Hearing and Knowing.";
"discovery.card.ayah_9_103.source" = "Qur’an 9:103";

"discovery.card.ayah_9_128.title" = "At-Tawba 128";
"discovery.card.ayah_9_128.meaning" = "There has certainly come to you a Messenger from among yourselves. Grievous to him is what you suffer; [he is] concerned over you and to the believers is kind and merciful.";
"discovery.card.ayah_9_128.source" = "Qur’an 9:128";

"discovery.card.ayah_10_25.title" = "Yunus 25";
"discovery.card.ayah_10_25.meaning" = "And Allah invites to the Home of Peace and guides whom He wills to a straight path";
"discovery.card.ayah_10_25.source" = "Qur’an 10:25";

"discovery.card.ayah_10_57.title" = "Yunus 57";
"discovery.card.ayah_10_57.meaning" = "O mankind, there has to come to you instruction from your Lord and healing for what is in the breasts and guidance and mercy for the believers.";
"discovery.card.ayah_10_57.source" = "Qur’an 10:57";

"discovery.card.ayah_10_62.title" = "Yunus 62";
"discovery.card.ayah_10_62.meaning" = "Unquestionably, [for] the allies of Allah there will be no fear concerning them, nor will they grieve";
"discovery.card.ayah_10_62.source" = "Qur’an 10:62";

"discovery.card.ayah_10_107.title" = "Yunus 107";
"discovery.card.ayah_10_107.meaning" = "And if Allah should touch you with adversity, there is no remover of it except Him; and if He intends for you good, then there is no repeller of His bounty. He causes it to reach whom He wills of His servants. And He is the Forgiving, the Merciful";
"discovery.card.ayah_10_107.source" = "Qur’an 10:107";

"discovery.card.ayah_11_88.title" = "Hud 88";
"discovery.card.ayah_11_88.meaning" = "He said, \"O my people, have you considered: if I am upon clear evidence from my Lord and He has provided me with a good provision from Him...? And I do not intend to differ from you in that which I have forbidden you; I only intend reform as much as I am able. And my success is not but through Allah. Upon him I have relied, and to Him I return.";
"discovery.card.ayah_11_88.source" = "Qur’an 11:88";

"discovery.card.ayah_11_114.title" = "Hud 114";
"discovery.card.ayah_11_114.meaning" = "And establish prayer at the two ends of the day and at the approach of the night. Indeed, good deeds do away with misdeeds. That is a reminder for those who remember.";
"discovery.card.ayah_11_114.source" = "Qur’an 11:114";

"discovery.card.ayah_12_21.title" = "Yusuf 21";
"discovery.card.ayah_12_21.meaning" = "And the one from Egypt who bought him said to his wife, \"Make his residence comfortable. Perhaps he will benefit us, or we will adopt him as a son.\" And thus, We established Joseph in the land that We might teach him the interpretation of events. And Allah is predominant over His affair, but most of the people do not know.";
"discovery.card.ayah_12_21.source" = "Qur’an 12:21";

"discovery.card.ayah_12_87.title" = "Yusuf 87";
"discovery.card.ayah_12_87.meaning" = "O my sons, go and find out about Joseph and his brother and despair not of relief from Allah. Indeed, no one despairs of relief from Allah except the disbelieving people.\"";
"discovery.card.ayah_12_87.source" = "Qur’an 12:87";

"discovery.card.ayah_12_90.title" = "Yusuf 90";
"discovery.card.ayah_12_90.meaning" = "They said, \"Are you indeed Joseph?\" He said \"I am Joseph, and this is my brother. Allah has certainly favored us. Indeed, he who fears Allah and is patient, then indeed, Allah does not allow to be lost the reward of those who do good.\"";
"discovery.card.ayah_12_90.source" = "Qur’an 12:90";

"discovery.card.ayah_13_11.title" = "Ar-Ra'd 11";
"discovery.card.ayah_13_11.meaning" = "For each one are successive [angels] before and behind him who protect him by the decree of Allah. Indeed, Allah will not change the condition of a people until they change what is in themselves. And when Allah intends for a people ill, there is no repelling it. And there is not for them besides Him any patron.";
"discovery.card.ayah_13_11.source" = "Qur’an 13:11";

"discovery.card.ayah_13_28.title" = "Ar-Ra'd 28";
"discovery.card.ayah_13_28.meaning" = "Those who have believed and whose hearts are assured by the remembrance of Allah. Unquestionably, by the remembrance of Allah hearts are assured.\"";
"discovery.card.ayah_13_28.source" = "Qur’an 13:28";

"discovery.card.ayah_14_24.title" = "Ibrahim 24";
"discovery.card.ayah_14_24.meaning" = "Have you not considered how Allah presents an example, [making] a good word like a good tree, whose root is firmly fixed and its branches [high] in the sky?";
"discovery.card.ayah_14_24.source" = "Qur’an 14:24";

"discovery.card.ayah_15_9.title" = "Al-Hijr 9";
"discovery.card.ayah_15_9.meaning" = "Indeed, it is We who sent down the Qur'an and indeed, We will be its guardian.";
"discovery.card.ayah_15_9.source" = "Qur’an 15:9";

"discovery.card.ayah_15_49.title" = "Al-Hijr 49";
"discovery.card.ayah_15_49.meaning" = "[O Muhammad], inform My servants that it is I who am the Forgiving, the Merciful.";
"discovery.card.ayah_15_49.source" = "Qur’an 15:49";

"discovery.card.ayah_16_90.title" = "An-Nahl 90";
"discovery.card.ayah_16_90.meaning" = "Indeed, Allah orders justice and good conduct and giving to relatives and forbids immorality and bad conduct and oppression. He admonishes you that perhaps you will be reminded.";
"discovery.card.ayah_16_90.source" = "Qur’an 16:90";

"discovery.card.ayah_16_97.title" = "An-Nahl 97";
"discovery.card.ayah_16_97.meaning" = "Whoever does righteousness, whether male or female, while he is a believer - We will surely cause him to live a good life, and We will surely give them their reward [in the Hereafter] according to the best of what they used to do.";
"discovery.card.ayah_16_97.source" = "Qur’an 16:97";

"discovery.card.ayah_16_125.title" = "An-Nahl 125";
"discovery.card.ayah_16_125.meaning" = "Invite to the way of your Lord with wisdom and good instruction, and argue with them in a way that is best. Indeed, your Lord is most knowing of who has strayed from His way, and He is most knowing of who is [rightly] guided.";
"discovery.card.ayah_16_125.source" = "Qur’an 16:125";

"discovery.card.ayah_17_9.title" = "Al-Israa 9";
"discovery.card.ayah_17_9.meaning" = "Indeed, this Qur'an guides to that which is most suitable and gives good tidings to the believers who do righteous deeds that they will have a great reward.";
"discovery.card.ayah_17_9.source" = "Qur’an 17:9";

"discovery.card.ayah_17_24.title" = "Al-Israa 24";
"discovery.card.ayah_17_24.meaning" = "And lower to them the wing of humility out of mercy and say, \"My Lord, have mercy upon them as they brought me up [when I was] small.\"";
"discovery.card.ayah_17_24.source" = "Qur’an 17:24";

"discovery.card.ayah_17_26.title" = "Al-Israa 26";
"discovery.card.ayah_17_26.meaning" = "And give the relative his right, and [also] the poor and the traveler, and do not spend wastefully.";
"discovery.card.ayah_17_26.source" = "Qur’an 17:26";

"discovery.card.ayah_17_32.title" = "Al-Israa 32";
"discovery.card.ayah_17_32.meaning" = "And do not approach unlawful sexual intercourse. Indeed, it is ever an immorality and is evil as a way.";
"discovery.card.ayah_17_32.source" = "Qur’an 17:32";

"discovery.card.ayah_17_53.title" = "Al-Israa 53";
"discovery.card.ayah_17_53.meaning" = "And tell My servants to say that which is best. Indeed, Satan induces [dissension] among them. Indeed Satan is ever, to mankind, a clear enemy.";
"discovery.card.ayah_17_53.source" = "Qur’an 17:53";

"discovery.card.ayah_17_70.title" = "Al-Israa 70";
"discovery.card.ayah_17_70.meaning" = "And We have certainly honored the children of Adam and carried them on the land and sea and provided for them of the good things and preferred them over much of what We have created, with [definite] preference.";
"discovery.card.ayah_17_70.source" = "Qur’an 17:70";

"discovery.card.ayah_17_80.title" = "Al-Israa 80";
"discovery.card.ayah_17_80.meaning" = "And say, \"My Lord, cause me to enter a sound entrance and to exit a sound exit and grant me from Yourself a supporting authority.\"";
"discovery.card.ayah_17_80.source" = "Qur’an 17:80";

"discovery.card.ayah_17_110.title" = "Al-Israa 110";
"discovery.card.ayah_17_110.meaning" = "Say, \"Call upon Allah or call upon the Most Merciful. Whichever [name] you call - to Him belong the best names.\" And do not recite [too] loudly in your prayer or [too] quietly but seek between that an [intermediate] way.";
"discovery.card.ayah_17_110.source" = "Qur’an 17:110";

"discovery.card.ayah_18_10.title" = "Al-Kahf 10";
"discovery.card.ayah_18_10.meaning" = "[Mention] when the youths retreated to the cave and said, \"Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance.\"";
"discovery.card.ayah_18_10.source" = "Qur’an 18:10";

"discovery.card.ayah_18_24.title" = "Al-Kahf 24";
"discovery.card.ayah_18_24.meaning" = "Except [when adding], \"If Allah wills.\" And remember your Lord when you forget [it] and say, \"Perhaps my Lord will guide me to what is nearer than this to right conduct.\"";
"discovery.card.ayah_18_24.source" = "Qur’an 18:24";

"discovery.card.ayah_18_46.title" = "Al-Kahf 46";
"discovery.card.ayah_18_46.meaning" = "Wealth and children are [but] adornment of the worldly life. But the enduring good deeds are better to your Lord for reward and better for [one's] hope.";
"discovery.card.ayah_18_46.source" = "Qur’an 18:46";

"discovery.card.ayah_18_110.title" = "Al-Kahf 110";
"discovery.card.ayah_18_110.meaning" = "Say, \"I am only a man like you, to whom has been revealed that your god is one God. So whoever would hope for the meeting with his Lord - let him do righteous work and not associate in the worship of his Lord anyone.\"";
"discovery.card.ayah_18_110.source" = "Qur’an 18:110";

"discovery.card.ayah_19_4.title" = "Maryam 4";
"discovery.card.ayah_19_4.meaning" = "He said, \"My Lord, indeed my bones have weakened, and my head has filled with white, and never have I been in my supplication to You, my Lord, unhappy.";
"discovery.card.ayah_19_4.source" = "Qur’an 19:4";

"discovery.card.ayah_19_96.title" = "Maryam 96";
"discovery.card.ayah_19_96.meaning" = "Indeed, those who have believed and done righteous deeds - the Most Merciful will appoint for them affection.";
"discovery.card.ayah_19_96.source" = "Qur’an 19:96";

"discovery.card.ayah_20_8.title" = "Taa-Haa 8";
"discovery.card.ayah_20_8.meaning" = "Allah - there is no deity except Him. To Him belong the best names.";
"discovery.card.ayah_20_8.source" = "Qur’an 20:8";

"discovery.card.ayah_20_25.title" = "Taa-Haa 25";
"discovery.card.ayah_20_25.meaning" = "[Moses] said, \"My Lord, expand for me my breast [with assurance]";
"discovery.card.ayah_20_25.source" = "Qur’an 20:25";

"discovery.card.ayah_20_46.title" = "Taa-Haa 46";
"discovery.card.ayah_20_46.meaning" = "[Allah] said, \"Fear not. Indeed, I am with you both; I hear and I see.";
"discovery.card.ayah_20_46.source" = "Qur’an 20:46";

"discovery.card.ayah_20_82.title" = "Taa-Haa 82";
"discovery.card.ayah_20_82.meaning" = "But indeed, I am the Perpetual Forgiver of whoever repents and believes and does righteousness and then continues in guidance.";
"discovery.card.ayah_20_82.source" = "Qur’an 20:82";

"discovery.card.ayah_21_47.title" = "Al-Anbiyaa 47";
"discovery.card.ayah_21_47.meaning" = "And We place the scales of justice for the Day of Resurrection, so no soul will be treated unjustly at all. And if there is [even] the weight of a mustard seed, We will bring it forth. And sufficient are We as accountant.";
"discovery.card.ayah_21_47.source" = "Qur’an 21:47";

"discovery.card.ayah_21_73.title" = "Al-Anbiyaa 73";
"discovery.card.ayah_21_73.meaning" = "And We made them leaders guiding by Our command. And We inspired to them the doing of good deeds, establishment of prayer, and giving of zakah; and they were worshippers of Us.";
"discovery.card.ayah_21_73.source" = "Qur’an 21:73";

"discovery.card.ayah_21_92.title" = "Al-Anbiyaa 92";
"discovery.card.ayah_21_92.meaning" = "Indeed this, your religion, is one religion, and I am your Lord, so worship Me.";
"discovery.card.ayah_21_92.source" = "Qur’an 21:92";

"discovery.card.ayah_22_77.title" = "Al-Hajj 77";
"discovery.card.ayah_22_77.meaning" = "O you who have believed, bow and prostrate and worship your Lord and do good - that you may succeed.";
"discovery.card.ayah_22_77.source" = "Qur’an 22:77";

"discovery.card.ayah_22_78.title" = "Al-Hajj 78";
"discovery.card.ayah_22_78.meaning" = "And strive for Allah with the striving due to Him. He has chosen you and has not placed upon you in the religion any difficulty. [It is] the religion of your father, Abraham. Allah named you \"Muslims\" before [in former scriptures] and in this [revelation] that the Messenger may be a witness over you and you may be witnesses over the people. So establish prayer and give zakah and hold fast to Allah. He is your protector; and excellent is the protector, and excellent is the helper.";
"discovery.card.ayah_22_78.source" = "Qur’an 22:78";

"discovery.card.ayah_23_1.title" = "Al-Muminoon 1";
"discovery.card.ayah_23_1.meaning" = "Certainly will the believers have succeeded:";
"discovery.card.ayah_23_1.source" = "Qur’an 23:1";

"discovery.card.ayah_23_51.title" = "Al-Muminoon 51";
"discovery.card.ayah_23_51.meaning" = "[Allah said], \"O messengers, eat from the good foods and work righteousness. Indeed, I, of what you do, am Knowing.";
"discovery.card.ayah_23_51.source" = "Qur’an 23:51";

"discovery.card.ayah_23_97.title" = "Al-Muminoon 97";
"discovery.card.ayah_23_97.meaning" = "And say, \"My Lord, I seek refuge in You from the incitements of the devils,";
"discovery.card.ayah_23_97.source" = "Qur’an 23:97";

"discovery.card.ayah_24_22.title" = "An-Noor 22";
"discovery.card.ayah_24_22.meaning" = "And let not those of virtue among you and wealth swear not to give [aid] to their relatives and the needy and the emigrants for the cause of Allah, and let them pardon and overlook. Would you not like that Allah should forgive you? And Allah is Forgiving and Merciful.";
"discovery.card.ayah_24_22.source" = "Qur’an 24:22";

"discovery.card.ayah_24_31.title" = "An-Noor 31";
"discovery.card.ayah_24_31.meaning" = "And tell the believing women to reduce [some] of their vision and guard their private parts and not expose their adornment except that which [necessarily] appears thereof and to wrap [a portion of] their headcovers over their chests and not expose their adornment except to their husbands, their fathers, their husbands' fathers, their sons, their husbands' sons, their brothers, their brothers' sons, their sisters' sons, their women, that which their right hands possess, or those male attendants having no physical desire, or children who are not yet aware of the private aspects of women. And let them not stamp their feet to make known what they conceal of their adornment. And turn to Allah in repentance, all of you, O believers, that you might succeed.";
"discovery.card.ayah_24_31.source" = "Qur’an 24:31";

"discovery.card.ayah_24_37.title" = "An-Noor 37";
"discovery.card.ayah_24_37.meaning" = "[Are] men whom neither commerce nor sale distracts from the remembrance of Allah and performance of prayer and giving of zakah. They fear a Day in which the hearts and eyes will [fearfully] turn about -";
"discovery.card.ayah_24_37.source" = "Qur’an 24:37";

"discovery.card.ayah_25_63.title" = "Al-Furqaan 63";
"discovery.card.ayah_25_63.meaning" = "And the servants of the Most Merciful are those who walk upon the earth easily, and when the ignorant address them [harshly], they say [words of] peace,";
"discovery.card.ayah_25_63.source" = "Qur’an 25:63";

"discovery.card.ayah_25_74.title" = "Al-Furqaan 74";
"discovery.card.ayah_25_74.meaning" = "And those who say, \"Our Lord, grant us from among our wives and offspring comfort to our eyes and make us an example for the righteous.\"";
"discovery.card.ayah_25_74.source" = "Qur’an 25:74";

"discovery.card.ayah_26_80.title" = "Ash-Shu'araa 80";
"discovery.card.ayah_26_80.meaning" = "And when I am ill, it is He who cures me";
"discovery.card.ayah_26_80.source" = "Qur’an 26:80";

"discovery.card.ayah_26_89.title" = "Ash-Shu'araa 89";
"discovery.card.ayah_26_89.meaning" = "But only one who comes to Allah with a sound heart.\"";
"discovery.card.ayah_26_89.source" = "Qur’an 26:89";

"discovery.card.ayah_27_19.title" = "An-Naml 19";
"discovery.card.ayah_27_19.meaning" = "So [Solomon] smiled, amused at her speech, and said, \"My Lord, enable me to be grateful for Your favor which You have bestowed upon me and upon my parents and to do righteousness of which You approve. And admit me by Your mercy into [the ranks of] Your righteous servants.\"";
"discovery.card.ayah_27_19.source" = "Qur’an 27:19";

"discovery.card.ayah_27_62.title" = "An-Naml 62";
"discovery.card.ayah_27_62.meaning" = "Is He [not best] who responds to the desperate one when he calls upon Him and removes evil and makes you inheritors of the earth? Is there a deity with Allah? Little do you remember.";
"discovery.card.ayah_27_62.source" = "Qur’an 27:62";

"discovery.card.ayah_28_56.title" = "Al-Qasas 56";
"discovery.card.ayah_28_56.meaning" = "Indeed, [O Muhammad], you do not guide whom you like, but Allah guides whom He wills. And He is most knowing of the [rightly] guided.";
"discovery.card.ayah_28_56.source" = "Qur’an 28:56";

"discovery.card.ayah_28_77.title" = "Al-Qasas 77";
"discovery.card.ayah_28_77.meaning" = "But seek, through that which Allah has given you, the home of the Hereafter; and [yet], do not forget your share of the world. And do good as Allah has done good to you. And desire not corruption in the land. Indeed, Allah does not like corrupters.\"";
"discovery.card.ayah_28_77.source" = "Qur’an 28:77";

"discovery.card.ayah_29_45.title" = "Al-Ankaboot 45";
"discovery.card.ayah_29_45.meaning" = "Recite, [O Muhammad], what has been revealed to you of the Book and establish prayer. Indeed, prayer prohibits immorality and wrongdoing, and the remembrance of Allah is greater. And Allah knows that which you do.";
"discovery.card.ayah_29_45.source" = "Qur’an 29:45";

"discovery.card.ayah_29_69.title" = "Al-Ankaboot 69";
"discovery.card.ayah_29_69.meaning" = "And those who strive for Us - We will surely guide them to Our ways. And indeed, Allah is with the doers of good.";
"discovery.card.ayah_29_69.source" = "Qur’an 29:69";

"discovery.card.ayah_31_12.title" = "Luqman 12";
"discovery.card.ayah_31_12.meaning" = "And We had certainly given Luqman wisdom [and said], \"Be grateful to Allah.\" And whoever is grateful is grateful for [the benefit of] himself. And whoever denies [His favor] - then indeed, Allah is Free of need and Praiseworthy.";
"discovery.card.ayah_31_12.source" = "Qur’an 31:12";

"discovery.card.ayah_31_13.title" = "Luqman 13";
"discovery.card.ayah_31_13.meaning" = "And [mention, O Muhammad], when Luqman said to his son while he was instructing him, \"O my son, do not associate [anything] with Allah. Indeed, association [with him] is great injustice.\"";
"discovery.card.ayah_31_13.source" = "Qur’an 31:13";

"discovery.card.ayah_31_18.title" = "Luqman 18";
"discovery.card.ayah_31_18.meaning" = "And do not turn your cheek [in contempt] toward people and do not walk through the earth exultantly. Indeed, Allah does not like everyone self-deluded and boastful.";
"discovery.card.ayah_31_18.source" = "Qur’an 31:18";

"discovery.card.ayah_31_19.title" = "Luqman 19";
"discovery.card.ayah_31_19.meaning" = "And be moderate in your pace and lower your voice; indeed, the most disagreeable of sounds is the voice of donkeys.\"";
"discovery.card.ayah_31_19.source" = "Qur’an 31:19";

"discovery.card.ayah_32_16.title" = "As-Sajda 16";
"discovery.card.ayah_32_16.meaning" = "They arise from [their] beds; they supplicate their Lord in fear and aspiration, and from what We have provided them, they spend.";
"discovery.card.ayah_32_16.source" = "Qur’an 32:16";

"discovery.card.ayah_32_17.title" = "As-Sajda 17";
"discovery.card.ayah_32_17.meaning" = "And no soul knows what has been hidden for them of comfort for eyes as reward for what they used to do.";
"discovery.card.ayah_32_17.source" = "Qur’an 32:17";

"discovery.card.ayah_33_21.title" = "Al-Ahzaab 21";
"discovery.card.ayah_33_21.meaning" = "There has certainly been for you in the Messenger of Allah an excellent pattern for anyone whose hope is in Allah and the Last Day and [who] remembers Allah often.";
"discovery.card.ayah_33_21.source" = "Qur’an 33:21";

"discovery.card.ayah_33_35.title" = "Al-Ahzaab 35";
"discovery.card.ayah_33_35.meaning" = "Indeed, the Muslim men and Muslim women, the believing men and believing women, the obedient men and obedient women, the truthful men and truthful women, the patient men and patient women, the humble men and humble women, the charitable men and charitable women, the fasting men and fasting women, the men who guard their private parts and the women who do so, and the men who remember Allah often and the women who do so - for them Allah has prepared forgiveness and a great reward.";
"discovery.card.ayah_33_35.source" = "Qur’an 33:35";

"discovery.card.ayah_33_41.title" = "Al-Ahzaab 41";
"discovery.card.ayah_33_41.meaning" = "O you who have believed, remember Allah with much remembrance";
"discovery.card.ayah_33_41.source" = "Qur’an 33:41";

"discovery.card.ayah_33_56.title" = "Al-Ahzaab 56";
"discovery.card.ayah_33_56.meaning" = "Indeed, Allah confers blessing upon the Prophet, and His angels [ask Him to do so]. O you who have believed, ask [Allah to confer] blessing upon him and ask [Allah to grant him] peace.";
"discovery.card.ayah_33_56.source" = "Qur’an 33:56";

"discovery.card.ayah_33_70.title" = "Al-Ahzaab 70";
"discovery.card.ayah_33_70.meaning" = "O you who have believed, fear Allah and speak words of appropriate justice.";
"discovery.card.ayah_33_70.source" = "Qur’an 33:70";

"discovery.card.ayah_35_10.title" = "Faatir 10";
"discovery.card.ayah_35_10.meaning" = "Whoever desires honor [through power] - then to Allah belongs all honor. To Him ascends good speech, and righteous work raises it. But they who plot evil deeds will have a severe punishment, and the plotting of those - it will perish.";
"discovery.card.ayah_35_10.source" = "Qur’an 35:10";

"discovery.card.ayah_35_28.title" = "Faatir 28";
"discovery.card.ayah_35_28.meaning" = "And among people and moving creatures and grazing livestock are various colors similarly. Only those fear Allah, from among His servants, who have knowledge. Indeed, Allah is Exalted in Might and Forgiving.";
"discovery.card.ayah_35_28.source" = "Qur’an 35:28";

"discovery.card.ayah_36_1.title" = "Yaseen 1";
"discovery.card.ayah_36_1.meaning" = "Ya, Seen.";
"discovery.card.ayah_36_1.source" = "Qur’an 36:1";

"discovery.card.ayah_36_22.title" = "Yaseen 22";
"discovery.card.ayah_36_22.meaning" = "And why should I not worship He who created me and to whom you will be returned?";
"discovery.card.ayah_36_22.source" = "Qur’an 36:22";

"discovery.card.ayah_36_58.title" = "Yaseen 58";
"discovery.card.ayah_36_58.meaning" = "[And] \"Peace,\" a word from a Merciful Lord.";
"discovery.card.ayah_36_58.source" = "Qur’an 36:58";

"discovery.card.ayah_37_96.title" = "As-Saaffaat 96";
"discovery.card.ayah_37_96.meaning" = "While Allah created you and that which you do?\"";
"discovery.card.ayah_37_96.source" = "Qur’an 37:96";

"discovery.card.ayah_38_29.title" = "Saad 29";
"discovery.card.ayah_38_29.meaning" = "[This is] a blessed Book which We have revealed to you, [O Muhammad], that they might reflect upon its verses and that those of understanding would be reminded.";
"discovery.card.ayah_38_29.source" = "Qur’an 38:29";

"discovery.card.ayah_39_9.title" = "Az-Zumar 9";
"discovery.card.ayah_39_9.meaning" = "Is one who is devoutly obedient during periods of the night, prostrating and standing [in prayer], fearing the Hereafter and hoping for the mercy of his Lord, [like one who does not]? Say, \"Are those who know equal to those who do not know?\" Only they will remember [who are] people of understanding.";
"discovery.card.ayah_39_9.source" = "Qur’an 39:9";

"discovery.card.ayah_39_10.title" = "Az-Zumar 10";
"discovery.card.ayah_39_10.meaning" = "Say, \"O My servants who have believed, fear your Lord. For those who do good in this world is good, and the earth of Allah is spacious. Indeed, the patient will be given their reward without account.\"";
"discovery.card.ayah_39_10.source" = "Qur’an 39:10";

"discovery.card.ayah_39_36.title" = "Az-Zumar 36";
"discovery.card.ayah_39_36.meaning" = "Is not Allah sufficient for His Servant [Prophet Muhammad]? And [yet], they threaten you with those [they worship] other than Him. And whoever Allah leaves astray - for him there is no guide.";
"discovery.card.ayah_39_36.source" = "Qur’an 39:36";

"discovery.card.ayah_40_60.title" = "Ghafir 60";
"discovery.card.ayah_40_60.meaning" = "And your Lord says, \"Call upon Me; I will respond to you.\" Indeed, those who disdain My worship will enter Hell [rendered] contemptible.";
"discovery.card.ayah_40_60.source" = "Qur’an 40:60";

"discovery.card.ayah_40_65.title" = "Ghafir 65";
"discovery.card.ayah_40_65.meaning" = "He is the Ever-Living; there is no deity except Him, so call upon Him, [being] sincere to Him in religion. [All] praise is [due] to Allah, Lord of the worlds.";
"discovery.card.ayah_40_65.source" = "Qur’an 40:65";

"discovery.card.ayah_41_30.title" = "Fussilat 30";
"discovery.card.ayah_41_30.meaning" = "Indeed, those who have said, \"Our Lord is Allah \" and then remained on a right course - the angels will descend upon them, [saying], \"Do not fear and do not grieve but receive good tidings of Paradise, which you were promised.";
"discovery.card.ayah_41_30.source" = "Qur’an 41:30";

"discovery.card.ayah_41_33.title" = "Fussilat 33";
"discovery.card.ayah_41_33.meaning" = "And who is better in speech than one who invites to Allah and does righteousness and says, \"Indeed, I am of the Muslims.\"";
"discovery.card.ayah_41_33.source" = "Qur’an 41:33";

"discovery.card.ayah_41_34.title" = "Fussilat 34";
"discovery.card.ayah_41_34.meaning" = "And not equal are the good deed and the bad. Repel [evil] by that [deed] which is better; and thereupon the one whom between you and him is enmity [will become] as though he was a devoted friend.";
"discovery.card.ayah_41_34.source" = "Qur’an 41:34";

"discovery.card.ayah_42_13.title" = "Ash-Shura 13";
"discovery.card.ayah_42_13.meaning" = "He has ordained for you of religion what He enjoined upon Noah and that which We have revealed to you, [O Muhammad], and what We enjoined upon Abraham and Moses and Jesus - to establish the religion and not be divided therein. Difficult for those who associate others with Allah is that to which you invite them. Allah chooses for Himself whom He wills and guides to Himself whoever turns back [to Him].";
"discovery.card.ayah_42_13.source" = "Qur’an 42:13";

"discovery.card.ayah_42_19.title" = "Ash-Shura 19";
"discovery.card.ayah_42_19.meaning" = "Allah is Subtle with His servants; He gives provisions to whom He wills. And He is the Powerful, the Exalted in Might.";
"discovery.card.ayah_42_19.source" = "Qur’an 42:19";

"discovery.card.ayah_42_36.title" = "Ash-Shura 36";
"discovery.card.ayah_42_36.meaning" = "So whatever thing you have been given - it is but [for] enjoyment of the worldly life. But what is with Allah is better and more lasting for those who have believed and upon their Lord rely";
"discovery.card.ayah_42_36.source" = "Qur’an 42:36";

"discovery.card.ayah_43_36.title" = "Az-Zukhruf 36";
"discovery.card.ayah_43_36.meaning" = "And whoever is blinded from remembrance of the Most Merciful - We appoint for him a devil, and he is to him a companion.";
"discovery.card.ayah_43_36.source" = "Qur’an 43:36";

"discovery.card.ayah_44_3.title" = "Ad-Dukhaan 3";
"discovery.card.ayah_44_3.meaning" = "Indeed, We sent it down during a blessed night. Indeed, We were to warn [mankind].";
"discovery.card.ayah_44_3.source" = "Qur’an 44:3";

"discovery.card.ayah_45_15.title" = "Al-Jaathiya 15";
"discovery.card.ayah_45_15.meaning" = "Whoever does a good deed - it is for himself; and whoever does evil - it is against the self. Then to your Lord you will be returned.";
"discovery.card.ayah_45_15.source" = "Qur’an 45:15";

"discovery.card.ayah_46_13.title" = "Al-Ahqaf 13";
"discovery.card.ayah_46_13.meaning" = "Indeed, those who have said, \"Our Lord is Allah,\" and then remained on a right course - there will be no fear concerning them, nor will they grieve.";
"discovery.card.ayah_46_13.source" = "Qur’an 46:13";

"discovery.card.ayah_46_15.title" = "Al-Ahqaf 15";
"discovery.card.ayah_46_15.meaning" = "And We have enjoined upon man, to his parents, good treatment. His mother carried him with hardship and gave birth to him with hardship, and his gestation and weaning [period] is thirty months. [He grows] until, when he reaches maturity and reaches [the age of] forty years, he says, \"My Lord, enable me to be grateful for Your favor which You have bestowed upon me and upon my parents and to work righteousness of which You will approve and make righteous for me my offspring. Indeed, I have repented to You, and indeed, I am of the Muslims.\"";
"discovery.card.ayah_46_15.source" = "Qur’an 46:15";

"discovery.card.ayah_47_7.title" = "Muhammad 7";
"discovery.card.ayah_47_7.meaning" = "O you who have believed, if you support Allah, He will support you and plant firmly your feet.";
"discovery.card.ayah_47_7.source" = "Qur’an 47:7";

"discovery.card.ayah_47_19.title" = "Muhammad 19";
"discovery.card.ayah_47_19.meaning" = "So know, [O Muhammad], that there is no deity except Allah and ask forgiveness for your sin and for the believing men and believing women. And Allah knows of your movement and your resting place.";
"discovery.card.ayah_47_19.source" = "Qur’an 47:19";

"discovery.card.ayah_48_1.title" = "Al-Fath 1";
"discovery.card.ayah_48_1.meaning" = "Indeed, We have given you, [O Muhammad], a clear conquest";
"discovery.card.ayah_48_1.source" = "Qur’an 48:1";

"discovery.card.ayah_48_29.title" = "Al-Fath 29";
"discovery.card.ayah_48_29.meaning" = "Muhammad is the Messenger of Allah; and those with him are forceful against the disbelievers, merciful among themselves. You see them bowing and prostrating [in prayer], seeking bounty from Allah and [His] pleasure. Their mark is on their faces from the trace of prostration. That is their description in the Torah. And their description in the Gospel is as a plant which produces its offshoots and strengthens them so they grow firm and stand upon their stalks, delighting the sowers - so that Allah may enrage by them the disbelievers. Allah has promised those who believe and do righteous deeds among them forgiveness and a great reward.";
"discovery.card.ayah_48_29.source" = "Qur’an 48:29";

"discovery.card.ayah_49_10.title" = "Al-Hujuraat 10";
"discovery.card.ayah_49_10.meaning" = "The believers are but brothers, so make settlement between your brothers. And fear Allah that you may receive mercy.";
"discovery.card.ayah_49_10.source" = "Qur’an 49:10";

"discovery.card.ayah_49_11.title" = "Al-Hujuraat 11";
"discovery.card.ayah_49_11.meaning" = "O you who have believed, let not a people ridicule [another] people; perhaps they may be better than them; nor let women ridicule [other] women; perhaps they may be better than them. And do not insult one another and do not call each other by [offensive] nicknames. Wretched is the name of disobedience after [one's] faith. And whoever does not repent - then it is those who are the wrongdoers.";
"discovery.card.ayah_49_11.source" = "Qur’an 49:11";

"discovery.card.ayah_51_19.title" = "Adh-Dhaariyat 19";
"discovery.card.ayah_51_19.meaning" = "And from their properties was [given] the right of the [needy] petitioner and the deprived.";
"discovery.card.ayah_51_19.source" = "Qur’an 51:19";

"discovery.card.ayah_51_56.title" = "Adh-Dhaariyat 56";
"discovery.card.ayah_51_56.meaning" = "And I did not create the jinn and mankind except to worship Me.";
"discovery.card.ayah_51_56.source" = "Qur’an 51:56";

"discovery.card.ayah_52_21.title" = "At-Tur 21";
"discovery.card.ayah_52_21.meaning" = "And those who believed and whose descendants followed them in faith - We will join with them their descendants, and We will not deprive them of anything of their deeds. Every person, for what he earned, is retained.";
"discovery.card.ayah_52_21.source" = "Qur’an 52:21";

"discovery.card.ayah_53_32.title" = "An-Najm 32";
"discovery.card.ayah_53_32.meaning" = "Those who avoid the major sins and immoralities, only [committing] slight ones. Indeed, your Lord is vast in forgiveness. He was most knowing of you when He produced you from the earth and when you were fetuses in the wombs of your mothers. So do not claim yourselves to be pure; He is most knowing of who fears Him.";
"discovery.card.ayah_53_32.source" = "Qur’an 53:32";

"discovery.card.ayah_53_39.title" = "An-Najm 39";
"discovery.card.ayah_53_39.meaning" = "And that there is not for man except that [good] for which he strives";
"discovery.card.ayah_53_39.source" = "Qur’an 53:39";

"discovery.card.ayah_54_17.title" = "Al-Qamar 17";
"discovery.card.ayah_54_17.meaning" = "And We have certainly made the Qur'an easy for remembrance, so is there any who will remember?";
"discovery.card.ayah_54_17.source" = "Qur’an 54:17";

"discovery.card.ayah_55_1.title" = "Ar-Rahmaan 1";
"discovery.card.ayah_55_1.meaning" = "The Most Merciful";
"discovery.card.ayah_55_1.source" = "Qur’an 55:1";

"discovery.card.ayah_55_46.title" = "Ar-Rahmaan 46";
"discovery.card.ayah_55_46.meaning" = "But for he who has feared the position of his Lord are two gardens -";
"discovery.card.ayah_55_46.source" = "Qur’an 55:46";

"discovery.card.ayah_56_10.title" = "Al-Waaqia 10";
"discovery.card.ayah_56_10.meaning" = "And the forerunners, the forerunners -";
"discovery.card.ayah_56_10.source" = "Qur’an 56:10";

"discovery.card.ayah_57_16.title" = "Al-Hadid 16";
"discovery.card.ayah_57_16.meaning" = "Has the time not come for those who have believed that their hearts should become humbly submissive at the remembrance of Allah and what has come down of the truth? And let them not be like those who were given the Scripture before, and a long period passed over them, so their hearts hardened; and many of them are defiantly disobedient.";
"discovery.card.ayah_57_16.source" = "Qur’an 57:16";

"discovery.card.ayah_57_20.title" = "Al-Hadid 20";
"discovery.card.ayah_57_20.meaning" = "Know that the life of this world is but amusement and diversion and adornment and boasting to one another and competition in increase of wealth and children - like the example of a rain whose [resulting] plant growth pleases the tillers; then it dries and you see it turned yellow; then it becomes [scattered] debris. And in the Hereafter is severe punishment and forgiveness from Allah and approval. And what is the worldly life except the enjoyment of delusion.";
"discovery.card.ayah_57_20.source" = "Qur’an 57:20";

"discovery.card.ayah_57_21.title" = "Al-Hadid 21";
"discovery.card.ayah_57_21.meaning" = "Race toward forgiveness from your Lord and a Garden whose width is like the width of the heavens and earth, prepared for those who believed in Allah and His messengers. That is the bounty of Allah which He gives to whom He wills, and Allah is the possessor of great bounty.";
"discovery.card.ayah_57_21.source" = "Qur’an 57:21";

"discovery.card.ayah_58_11.title" = "Al-Mujaadila 11";
"discovery.card.ayah_58_11.meaning" = "O you who have believed, when you are told, \"Space yourselves\" in assemblies, then make space; Allah will make space for you. And when you are told, \"Arise,\" then arise; Allah will raise those who have believed among you and those who were given knowledge, by degrees. And Allah is Acquainted with what you do.";
"discovery.card.ayah_58_11.source" = "Qur’an 58:11";

"discovery.card.ayah_59_9.title" = "Al-Hashr 9";
"discovery.card.ayah_59_9.meaning" = "And [also for] those who were settled in al-Madinah and [adopted] the faith before them. They love those who emigrated to them and find not any want in their breasts of what the emigrants were given but give [them] preference over themselves, even though they are in privation. And whoever is protected from the stinginess of his soul - it is those who will be the successful.";
"discovery.card.ayah_59_9.source" = "Qur’an 59:9";

"discovery.card.ayah_59_18.title" = "Al-Hashr 18";
"discovery.card.ayah_59_18.meaning" = "O you who have believed, fear Allah. And let every soul look to what it has put forth for tomorrow - and fear Allah. Indeed, Allah is Acquainted with what you do.";
"discovery.card.ayah_59_18.source" = "Qur’an 59:18";

"discovery.card.ayah_59_22.title" = "Al-Hashr 22";
"discovery.card.ayah_59_22.meaning" = "He is Allah, other than whom there is no deity, Knower of the unseen and the witnessed. He is the Entirely Merciful, the Especially Merciful.";
"discovery.card.ayah_59_22.source" = "Qur’an 59:22";

"discovery.card.ayah_61_2.title" = "As-Saff 2";
"discovery.card.ayah_61_2.meaning" = "O you who have believed, why do you say what you do not do?";
"discovery.card.ayah_61_2.source" = "Qur’an 61:2";

"discovery.card.ayah_61_10.title" = "As-Saff 10";
"discovery.card.ayah_61_10.meaning" = "O you who have believed, shall I guide you to a transaction that will save you from a painful punishment?";
"discovery.card.ayah_61_10.source" = "Qur’an 61:10";

"discovery.card.ayah_61_13.title" = "As-Saff 13";
"discovery.card.ayah_61_13.meaning" = "And [you will obtain] another [favor] that you love - victory from Allah and an imminent conquest; and give good tidings to the believers.";
"discovery.card.ayah_61_13.source" = "Qur’an 61:13";

"discovery.card.ayah_62_9.title" = "Al-Jumu'a 9";
"discovery.card.ayah_62_9.meaning" = "O you who have believed, when [the adhan] is called for the prayer on the day of Jumu'ah [Friday], then proceed to the remembrance of Allah and leave trade. That is better for you, if you only knew.";
"discovery.card.ayah_62_9.source" = "Qur’an 62:9";

"discovery.card.ayah_62_10.title" = "Al-Jumu'a 10";
"discovery.card.ayah_62_10.meaning" = "And when the prayer has been concluded, disperse within the land and seek from the bounty of Allah, and remember Allah often that you may succeed.";
"discovery.card.ayah_62_10.source" = "Qur’an 62:10";

"discovery.card.ayah_63_9.title" = "Al-Munaafiqoon 9";
"discovery.card.ayah_63_9.meaning" = "O you who have believed, let not your wealth and your children divert you from remembrance of Allah. And whoever does that - then those are the losers.";
"discovery.card.ayah_63_9.source" = "Qur’an 63:9";

"discovery.card.ayah_64_16.title" = "At-Taghaabun 16";
"discovery.card.ayah_64_16.meaning" = "So fear Allah as much as you are able and listen and obey and spend [in the way of Allah]; it is better for your selves. And whoever is protected from the stinginess of his soul - it is those who will be the successful.";
"discovery.card.ayah_64_16.source" = "Qur’an 64:16";

"discovery.card.ayah_65_4.title" = "At-Talaaq 4";
"discovery.card.ayah_65_4.meaning" = "And those who no longer expect menstruation among your women - if you doubt, then their period is three months, and [also for] those who have not menstruated. And for those who are pregnant, their term is until they give birth. And whoever fears Allah - He will make for him of his matter ease.";
"discovery.card.ayah_65_4.source" = "Qur’an 65:4";

"discovery.card.ayah_66_8.title" = "At-Tahrim 8";
"discovery.card.ayah_66_8.meaning" = "O you who have believed, repent to Allah with sincere repentance. Perhaps your Lord will remove from you your misdeeds and admit you into gardens beneath which rivers flow [on] the Day when Allah will not disgrace the Prophet and those who believed with him. Their light will proceed before them and on their right; they will say, \"Our Lord, perfect for us our light and forgive us. Indeed, You are over all things competent.\"";
"discovery.card.ayah_66_8.source" = "Qur’an 66:8";

"discovery.card.ayah_67_1.title" = "Al-Mulk 1";
"discovery.card.ayah_67_1.meaning" = "Blessed is He in whose hand is dominion, and He is over all things competent -";
"discovery.card.ayah_67_1.source" = "Qur’an 67:1";

"discovery.card.ayah_67_14.title" = "Al-Mulk 14";
"discovery.card.ayah_67_14.meaning" = "Does He who created not know, while He is the Subtle, the Acquainted?";
"discovery.card.ayah_67_14.source" = "Qur’an 67:14";

"discovery.card.ayah_67_15.title" = "Al-Mulk 15";
"discovery.card.ayah_67_15.meaning" = "It is He who made the earth tame for you - so walk among its slopes and eat of His provision - and to Him is the resurrection.";
"discovery.card.ayah_67_15.source" = "Qur’an 67:15";

"discovery.card.ayah_68_4.title" = "Al-Qalam 4";
"discovery.card.ayah_68_4.meaning" = "And indeed, you are of a great moral character.";
"discovery.card.ayah_68_4.source" = "Qur’an 68:4";

"discovery.card.ayah_70_19.title" = "Al-Ma'aarij 19";
"discovery.card.ayah_70_19.meaning" = "Indeed, mankind was created anxious:";
"discovery.card.ayah_70_19.source" = "Qur’an 70:19";

"discovery.card.ayah_73_20.title" = "Al-Muzzammil 20";
"discovery.card.ayah_73_20.meaning" = "Indeed, your Lord knows, [O Muhammad], that you stand [in prayer] almost two thirds of the night or half of it or a third of it, and [so do] a group of those with you. And Allah determines [the extent of] the night and the day. He has known that you [Muslims] will not be able to do it and has turned to you in forgiveness, so recite what is easy [for you] of the Qur'an. He has known that there will be among you those who are ill and others traveling throughout the land seeking [something] of the bounty of Allah and others fighting for the cause of Allah. So recite what is easy from it and establish prayer and give zakah and loan Allah a goodly loan. And whatever good you put forward for yourselves - you will find it with Allah. It is better and greater in reward. And seek forgiveness of Allah. Indeed, Allah is Forgiving and Merciful.";
"discovery.card.ayah_73_20.source" = "Qur’an 73:20";

"discovery.card.ayah_74_3.title" = "Al-Muddaththir 3";
"discovery.card.ayah_74_3.meaning" = "And your Lord glorify";
"discovery.card.ayah_74_3.source" = "Qur’an 74:3";

"discovery.card.ayah_76_8.title" = "Al-Insaan 8";
"discovery.card.ayah_76_8.meaning" = "And they give food in spite of love for it to the needy, the orphan, and the captive,";
"discovery.card.ayah_76_8.source" = "Qur’an 76:8";

"discovery.card.ayah_76_9.title" = "Al-Insaan 9";
"discovery.card.ayah_76_9.meaning" = "[Saying], \"We feed you only for the countenance of Allah. We wish not from you reward or gratitude.";
"discovery.card.ayah_76_9.source" = "Qur’an 76:9";

"discovery.card.ayah_87_1.title" = "Al-A'laa 1";
"discovery.card.ayah_87_1.meaning" = "Exalt the name of your Lord, the Most High,";
"discovery.card.ayah_87_1.source" = "Qur’an 87:1";

"discovery.card.ayah_87_14.title" = "Al-A'laa 14";
"discovery.card.ayah_87_14.meaning" = "He has certainly succeeded who purifies himself";
"discovery.card.ayah_87_14.source" = "Qur’an 87:14";

"discovery.card.ayah_89_27.title" = "Al-Fajr 27";
"discovery.card.ayah_89_27.meaning" = "[To the righteous it will be said], \"O reassured soul,";
"discovery.card.ayah_89_27.source" = "Qur’an 89:27";

"discovery.card.ayah_89_28.title" = "Al-Fajr 28";
"discovery.card.ayah_89_28.meaning" = "Return to your Lord, well-pleased and pleasing [to Him],";
"discovery.card.ayah_89_28.source" = "Qur’an 89:28";

"discovery.card.ayah_90_12.title" = "Al-Balad 12";
"discovery.card.ayah_90_12.meaning" = "And what can make you know what is [breaking through] the difficult pass?";
"discovery.card.ayah_90_12.source" = "Qur’an 90:12";

"discovery.card.ayah_90_13.title" = "Al-Balad 13";
"discovery.card.ayah_90_13.meaning" = "It is the freeing of a slave";
"discovery.card.ayah_90_13.source" = "Qur’an 90:13";

"discovery.card.ayah_91_9.title" = "Ash-Shams 9";
"discovery.card.ayah_91_9.meaning" = "He has succeeded who purifies it,";
"discovery.card.ayah_91_9.source" = "Qur’an 91:9";

"discovery.card.ayah_92_5.title" = "Al-Lail 5";
"discovery.card.ayah_92_5.meaning" = "As for he who gives and fears Allah";
"discovery.card.ayah_92_5.source" = "Qur’an 92:5";

"discovery.card.ayah_92_18.title" = "Al-Lail 18";
"discovery.card.ayah_92_18.meaning" = "[He] who gives [from] his wealth to purify himself";
"discovery.card.ayah_92_18.source" = "Qur’an 92:18";

"discovery.card.ayah_93_5.title" = "Ad-Dhuhaa 5";
"discovery.card.ayah_93_5.meaning" = "And your Lord is going to give you, and you will be satisfied.";
"discovery.card.ayah_93_5.source" = "Qur’an 93:5";

"discovery.card.ayah_93_6.title" = "Ad-Dhuhaa 6";
"discovery.card.ayah_93_6.meaning" = "Did He not find you an orphan and give [you] refuge?";
"discovery.card.ayah_93_6.source" = "Qur’an 93:6";

"discovery.card.ayah_93_7.title" = "Ad-Dhuhaa 7";
"discovery.card.ayah_93_7.meaning" = "And He found you lost and guided [you],";
"discovery.card.ayah_93_7.source" = "Qur’an 93:7";

"discovery.card.ayah_93_8.title" = "Ad-Dhuhaa 8";
"discovery.card.ayah_93_8.meaning" = "And He found you poor and made [you] self-sufficient.";
"discovery.card.ayah_93_8.source" = "Qur’an 93:8";

"discovery.card.ayah_93_10.title" = "Ad-Dhuhaa 10";
"discovery.card.ayah_93_10.meaning" = "And as for the petitioner, do not repel [him].";
"discovery.card.ayah_93_10.source" = "Qur’an 93:10";

"discovery.card.ayah_93_11.title" = "Ad-Dhuhaa 11";
"discovery.card.ayah_93_11.meaning" = "But as for the favor of your Lord, report [it].";
"discovery.card.ayah_93_11.source" = "Qur’an 93:11";

"discovery.card.ayah_94_6.title" = "Ash-Sharh 6";
"discovery.card.ayah_94_6.meaning" = "Indeed, with hardship [will be] ease.";
"discovery.card.ayah_94_6.source" = "Qur’an 94:6";

"discovery.card.ayah_94_7.title" = "Ash-Sharh 7";
"discovery.card.ayah_94_7.meaning" = "So when you have finished [your duties], then stand up [for worship].";
"discovery.card.ayah_94_7.source" = "Qur’an 94:7";

"discovery.card.ayah_94_8.title" = "Ash-Sharh 8";
"discovery.card.ayah_94_8.meaning" = "And to your Lord direct [your] longing.";
"discovery.card.ayah_94_8.source" = "Qur’an 94:8";

"discovery.card.ayah_95_4.title" = "At-Tin 4";
"discovery.card.ayah_95_4.meaning" = "We have certainly created man in the best of stature;";
"discovery.card.ayah_95_4.source" = "Qur’an 95:4";

"discovery.card.ayah_96_1.title" = "Al-Alaq 1";
"discovery.card.ayah_96_1.meaning" = "Recite in the name of your Lord who created -";
"discovery.card.ayah_96_1.source" = "Qur’an 96:1";

"discovery.card.ayah_96_5.title" = "Al-Alaq 5";
"discovery.card.ayah_96_5.meaning" = "Taught man that which he knew not.";
"discovery.card.ayah_96_5.source" = "Qur’an 96:5";

"discovery.card.ayah_97_1.title" = "Al-Qadr 1";
"discovery.card.ayah_97_1.meaning" = "Indeed, We sent the Qur'an down during the Night of Decree.";
"discovery.card.ayah_97_1.source" = "Qur’an 97:1";

"discovery.card.ayah_97_5.title" = "Al-Qadr 5";
"discovery.card.ayah_97_5.meaning" = "Peace it is until the emergence of dawn.";
"discovery.card.ayah_97_5.source" = "Qur’an 97:5";

"discovery.card.ayah_99_7.title" = "Az-Zalzala 7";
"discovery.card.ayah_99_7.meaning" = "So whoever does an atom's weight of good will see it,";
"discovery.card.ayah_99_7.source" = "Qur’an 99:7";

"discovery.card.ayah_99_8.title" = "Az-Zalzala 8";
"discovery.card.ayah_99_8.meaning" = "And whoever does an atom's weight of evil will see it.";
"discovery.card.ayah_99_8.source" = "Qur’an 99:8";

"discovery.card.ayah_102_1.title" = "At-Takaathur 1";
"discovery.card.ayah_102_1.meaning" = "Competition in [worldly] increase diverts you";
"discovery.card.ayah_102_1.source" = "Qur’an 102:1";

"discovery.card.ayah_102_8.title" = "At-Takaathur 8";
"discovery.card.ayah_102_8.meaning" = "Then you will surely be asked that Day about pleasure.";
"discovery.card.ayah_102_8.source" = "Qur’an 102:8";

"discovery.card.ayah_103_3.title" = "Al-Asr 3";
"discovery.card.ayah_103_3.meaning" = "Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.";
"discovery.card.ayah_103_3.source" = "Qur’an 103:3";

"discovery.card.ayah_107_1.title" = "Al-Maa'un 1";
"discovery.card.ayah_107_1.meaning" = "Have you seen the one who denies the Recompense?";
"discovery.card.ayah_107_1.source" = "Qur’an 107:1";

"discovery.card.ayah_107_4.title" = "Al-Maa'un 4";
"discovery.card.ayah_107_4.meaning" = "So woe to those who pray";
"discovery.card.ayah_107_4.source" = "Qur’an 107:4";

"discovery.card.ayah_110_1.title" = "An-Nasr 1";
"discovery.card.ayah_110_1.meaning" = "When the victory of Allah has come and the conquest,";
"discovery.card.ayah_110_1.source" = "Qur’an 110:1";

"discovery.card.ayah_110_3.title" = "An-Nasr 3";
"discovery.card.ayah_110_3.meaning" = "Then exalt [Him] with praise of your Lord and ask forgiveness of Him. Indeed, He is ever Accepting of repentance.";
"discovery.card.ayah_110_3.source" = "Qur’an 110:3";

"discovery.card.ayah_112_2.title" = "Al-Ikhlaas 2";
"discovery.card.ayah_112_2.meaning" = "Allah, the Eternal Refuge.";
"discovery.card.ayah_112_2.source" = "Qur’an 112:2";

"discovery.card.ayah_112_3.title" = "Al-Ikhlaas 3";
"discovery.card.ayah_112_3.meaning" = "He neither begets nor is born,";
"discovery.card.ayah_112_3.source" = "Qur’an 112:3";

"discovery.card.ayah_112_4.title" = "Al-Ikhlaas 4";
"discovery.card.ayah_112_4.meaning" = "Nor is there to Him any equivalent.\"";
"discovery.card.ayah_112_4.source" = "Qur’an 112:4";

"discovery.card.sunnah_bukhari_10.title" = "Sahih al-Bukhari 10";
"discovery.card.sunnah_bukhari_10.meaning" = "Narrated 'Abdullah bin 'Amr: The Prophet (ﷺ) said, \"A Muslim is the one who avoids harming Muslims with his tongue and hands. And a Muhajir (emigrant) is the one who gives up (abandons) all what Allah has forbidden";
"discovery.card.sunnah_bukhari_10.source" = "Sahih al-Bukhari 10";

"discovery.card.sunnah_bukhari_11.title" = "Sahih al-Bukhari 11";
"discovery.card.sunnah_bukhari_11.meaning" = "Narrated Abu Musa: Some people asked Allah's Messenger (ﷺ), \"Whose Islam is the best? i.e. (Who is a very good Muslim)?\" He replied, \"One who avoids harming the Muslims with his tongue and hands";
"discovery.card.sunnah_bukhari_11.source" = "Sahih al-Bukhari 11";

"discovery.card.sunnah_bukhari_12.title" = "Sahih al-Bukhari 12";
"discovery.card.sunnah_bukhari_12.meaning" = "Narrated 'Abdullah bin 'Amr: A man asked the Prophet (ﷺ) , \"What sort of deeds or (what qualities of) Islam are good?\" The Prophet (ﷺ) replied, 'To feed (the poor) and greet those whom you know and those whom you do not Know (See Hadith No)";
"discovery.card.sunnah_bukhari_12.source" = "Sahih al-Bukhari 12";

"discovery.card.sunnah_bukhari_13.title" = "Sahih al-Bukhari 13";
"discovery.card.sunnah_bukhari_13.meaning" = "Narrated Anas: The Prophet (ﷺ) said, \"None of you will have faith till he wishes for his (Muslim) brother what he likes for himself";
"discovery.card.sunnah_bukhari_13.source" = "Sahih al-Bukhari 13";

"discovery.card.sunnah_bukhari_14.title" = "Sahih al-Bukhari 14";
"discovery.card.sunnah_bukhari_14.meaning" = "Narrated Abu Huraira: \"Allah's Messenger (ﷺ) said, \"By Him in Whose Hands my life is, none of you will have faith till he loves me more than his father and his children";
"discovery.card.sunnah_bukhari_14.source" = "Sahih al-Bukhari 14";

"discovery.card.sunnah_bukhari_15.title" = "Sahih al-Bukhari 15";
"discovery.card.sunnah_bukhari_15.meaning" = "Narrated Anas: The Prophet (ﷺ) said \"None of you will have faith till he loves me more than his father, his children and all mankind";
"discovery.card.sunnah_bukhari_15.source" = "Sahih al-Bukhari 15";

"discovery.card.sunnah_bukhari_17.title" = "Sahih al-Bukhari 17";
"discovery.card.sunnah_bukhari_17.meaning" = "Narrated Anas: The Prophet (ﷺ) said, \"Love for the Ansar is a sign of faith and hatred for the Ansar is a sign of hypocrisy";
"discovery.card.sunnah_bukhari_17.source" = "Sahih al-Bukhari 17";

"discovery.card.sunnah_bukhari_19.title" = "Sahih al-Bukhari 19";
"discovery.card.sunnah_bukhari_19.meaning" = "Narrated Abu Said Al-Khudri: Allah's Messenger (ﷺ) said, \"A time will soon come when the best property of a Muslim will be sheep which he will take on the top of mountains and the places of rainfall (valleys) so as to flee with his religion from afflictions";
"discovery.card.sunnah_bukhari_19.source" = "Sahih al-Bukhari 19";

"discovery.card.sunnah_bukhari_24.title" = "Sahih al-Bukhari 24";
"discovery.card.sunnah_bukhari_24.meaning" = "Narrated 'Abdullah (bin 'Umar): Once Allah's Messenger (ﷺ) passed by an Ansari (man) who was admonishing his brother regarding Haya'. On that Allah's Messenger (ﷺ) said, \"Leave him as Haya' is a part of faith.\" (See Hadith)";
"discovery.card.sunnah_bukhari_24.source" = "Sahih al-Bukhari 24";

"discovery.card.sunnah_bukhari_28.title" = "Sahih al-Bukhari 28";
"discovery.card.sunnah_bukhari_28.meaning" = "Narrated 'Abdullah bin 'Amr: A person asked Allah's Messenger (ﷺ), \"What (sort of) deeds in or (what qualities of) Islam are good?\" He replied, \"To feed (the poor) and greet those whom you know and those whom you don't know";
"discovery.card.sunnah_bukhari_28.source" = "Sahih al-Bukhari 28";

"discovery.card.sunnah_bukhari_35.title" = "Sahih al-Bukhari 35";
"discovery.card.sunnah_bukhari_35.meaning" = "Narrated Abu Huraira: Allah's Messenger (ﷺ) said, \"Whoever establishes the prayers on the night of Qadr out of sincere faith and hoping to attain Allah's rewards (not to show off) then all his past sins will be forgiven";
"discovery.card.sunnah_bukhari_35.source" = "Sahih al-Bukhari 35";

"discovery.card.sunnah_bukhari_37.title" = "Sahih al-Bukhari 37";
"discovery.card.sunnah_bukhari_37.meaning" = "Narrated Abu Huraira: Allah's Messenger (ﷺ) said: \"Whoever establishes prayers during the nights of Ramadan faithfully out of sincere faith and hoping to attain Allah's rewards (not for showing off), all his past sins will be forgiven";
"discovery.card.sunnah_bukhari_37.source" = "Sahih al-Bukhari 37";

"discovery.card.sunnah_bukhari_38.title" = "Sahih al-Bukhari 38";
"discovery.card.sunnah_bukhari_38.meaning" = "Narrated Abu Huraira: Allah's Messenger (ﷺ) said, \"Whoever observes fasts during the month of Ramadan out of sincere faith, and hoping to attain Allah's rewards, then all his past sins will be forgiven";
"discovery.card.sunnah_bukhari_38.source" = "Sahih al-Bukhari 38";

"discovery.card.sunnah_bukhari_42.title" = "Sahih al-Bukhari 42";
"discovery.card.sunnah_bukhari_42.meaning" = "Narrated Abu Huraira: Allah's Messenger (ﷺ) said, \"If any one of you improves (follows strictly) his Islamic religion then his good deeds will be rewarded ten times to seven hundred times for each good deed and a bad deed will be recorded as it is";
"discovery.card.sunnah_bukhari_42.source" = "Sahih al-Bukhari 42";

"discovery.card.sunnah_bukhari_48.title" = "Sahih al-Bukhari 48";
"discovery.card.sunnah_bukhari_48.meaning" = "Narrated 'Abdullah: The Prophet (ﷺ) said, \"Abusing a Muslim is Fusuq (an evil doing) and killing him is Kufr (disbelief)";
"discovery.card.sunnah_bukhari_48.source" = "Sahih al-Bukhari 48";

"discovery.card.sunnah_bukhari_55.title" = "Sahih al-Bukhari 55";
"discovery.card.sunnah_bukhari_55.meaning" = "Narrated Abu Mas'ud: The Prophet (ﷺ) said, \"If a man spends on his family (with the intention of having a reward from Allah) sincerely for Allah's sake then it is a (kind of) alms-giving in reward for him";
"discovery.card.sunnah_bukhari_55.source" = "Sahih al-Bukhari 55";

"discovery.card.sunnah_bukhari_56.title" = "Sahih al-Bukhari 56";
"discovery.card.sunnah_bukhari_56.meaning" = "Narrated Sa'd bin Abi Waqqas: Allah's Messenger (ﷺ) said, \"You will be rewarded for whatever you spend for Allah's sake even if it were a morsel which you put in your wife's mouth";
"discovery.card.sunnah_bukhari_56.source" = "Sahih al-Bukhari 56";

"discovery.card.sunnah_bukhari_57.title" = "Sahih al-Bukhari 57";
"discovery.card.sunnah_bukhari_57.meaning" = "Narrated Jarir bin Abdullah: I gave the pledge of allegiance to Allah's Messenger (ﷺ) for the following: 1. offer prayers perfectly 2. pay the Zakat (obligatory charity) 3. and be sincere and true to every Muslim";
"discovery.card.sunnah_bukhari_57.source" = "Sahih al-Bukhari 57";

"discovery.card.sunnah_bukhari_68.title" = "Sahih al-Bukhari 68";
"discovery.card.sunnah_bukhari_68.meaning" = "Narrated Ibn Mas`ud:The Prophet (ﷺ) used to take care of us in preaching by selecting a suitable time, so that we might not get bored. (He abstained from pestering us with sermons and knowledge all the time)";
"discovery.card.sunnah_bukhari_68.source" = "Sahih al-Bukhari 68";

"discovery.card.sunnah_bukhari_69.title" = "Sahih al-Bukhari 69";
"discovery.card.sunnah_bukhari_69.meaning" = "Narrated Anas bin Malik:The Prophet (ﷺ) said, \"Facilitate things to people (concerning religious matters), and do not make it hard for them and give them good tidings and do not make them run away (from Islam)";
"discovery.card.sunnah_bukhari_69.source" = "Sahih al-Bukhari 69";

"discovery.card.sunnah_bukhari_75.title" = "Sahih al-Bukhari 75";
"discovery.card.sunnah_bukhari_75.meaning" = "Narrated Ibn `Abbas:Once the Prophet (ﷺ) embraced me and said, \"O Allah! Bestow on him the knowledge of the Book (Qur'an)";
"discovery.card.sunnah_bukhari_75.source" = "Sahih al-Bukhari 75";

"discovery.card.sunnah_bukhari_77.title" = "Sahih al-Bukhari 77";
"discovery.card.sunnah_bukhari_77.meaning" = "Narrated Mahmud bin Rabi`a:When I was a boy of five, I remember, the Prophet (ﷺ) took water from a bucket (used for getting water out of a well) with his mouth and threw it on my face";
"discovery.card.sunnah_bukhari_77.source" = "Sahih al-Bukhari 77";

"discovery.card.sunnah_bukhari_94.title" = "Sahih al-Bukhari 94";
"discovery.card.sunnah_bukhari_94.meaning" = "Narrated Anas:Whenever the Prophet (ﷺ) asked permission to enter, he knocked the door thrice with greeting and whenever he spoke a sentence (said a thing) he used to repeat it thrice. (See Hadith No. 261, Vol)";
"discovery.card.sunnah_bukhari_94.source" = "Sahih al-Bukhari 94";

"discovery.card.sunnah_bukhari_95.title" = "Sahih al-Bukhari 95";
"discovery.card.sunnah_bukhari_95.meaning" = "Narrated Anas:Whenever the Prophet (ﷺ) spoke a sentence (said a thing), he used to repeat it thrice so that the people could understand it properly from him and whenever he asked permission to enter, (he knocked the door) thrice with greeting";
"discovery.card.sunnah_bukhari_95.source" = "Sahih al-Bukhari 95";

"discovery.card.sunnah_bukhari_102.title" = "Sahih al-Bukhari 102";
"discovery.card.sunnah_bukhari_102.meaning" = "Narrated Abu Sa`id Al-Khudri:as above (the sub narrators are different). Abu Huraira qualified the three children referred to in the above mentioned Hadith as not having reached the age of committing sins (i.e. age of puberty)";
"discovery.card.sunnah_bukhari_102.source" = "Sahih al-Bukhari 102";

"discovery.card.sunnah_bukhari_106.title" = "Sahih al-Bukhari 106";
"discovery.card.sunnah_bukhari_106.meaning" = "Narrated `Ali:The Prophet (ﷺ) said, \"Do not tell a lie against me for whoever tells a lie against me (intentionally) then he will surely enter the Hell-fire";
"discovery.card.sunnah_bukhari_106.source" = "Sahih al-Bukhari 106";

"discovery.card.sunnah_bukhari_108.title" = "Sahih al-Bukhari 108";
"discovery.card.sunnah_bukhari_108.meaning" = "Narrated Anas:The fact which stops me from narrating a great number of Hadiths to you is that the Prophet (ﷺ) said: \"Whoever tells a lie against me intentionally, then (surely) let him occupy his seat in Hell-fire";
"discovery.card.sunnah_bukhari_108.source" = "Sahih al-Bukhari 108";

"discovery.card.sunnah_bukhari_109.title" = "Sahih al-Bukhari 109";
"discovery.card.sunnah_bukhari_109.meaning" = "Narrated Salama:I heard the Prophet (ﷺ) saying, \"Whoever (intentionally) ascribes to me what I have not said then (surely) let him occupy his seat in Hell-fire";
"discovery.card.sunnah_bukhari_109.source" = "Sahih al-Bukhari 109";

"discovery.card.sunnah_bukhari_113.title" = "Sahih al-Bukhari 113";
"discovery.card.sunnah_bukhari_113.meaning" = "Narrated Abu Huraira:There is none among the companions of the Prophet (ﷺ) who has narrated more Hadiths than I except `Abdullah bin `Amr (bin Al-`As) who used to write them and I never did the same";
"discovery.card.sunnah_bukhari_113.source" = "Sahih al-Bukhari 113";

"discovery.card.sunnah_bukhari_120.title" = "Sahih al-Bukhari 120";
"discovery.card.sunnah_bukhari_120.meaning" = "Narrated Abu Huraira:I have memorized two kinds of knowledge from Allah's Messenger (ﷺ) . I have propagated one of them to you and if I propagated the second, then my pharynx (throat) would be cut (i.e. killed)";
"discovery.card.sunnah_bukhari_120.source" = "Sahih al-Bukhari 120";

"discovery.card.sunnah_bukhari_121.title" = "Sahih al-Bukhari 121";
"discovery.card.sunnah_bukhari_121.meaning" = "Narrated Jarir:The Prophet (ﷺ) said to me during Hajjat-al-Wida`: Let the people keep quiet and listen. Then he said (addressing the people), \"Do not (become infidels) revert to disbelief after me by striking the necks (cutting the throats) of one another (killing each other)";
"discovery.card.sunnah_bukhari_121.source" = "Sahih al-Bukhari 121";

"discovery.card.sunnah_bukhari_127.title" = "Sahih al-Bukhari 127";
"discovery.card.sunnah_bukhari_127.meaning" = "Narrated Abu at-Tufail:The above mentioned Statement of `Ali";
"discovery.card.sunnah_bukhari_127.source" = "Sahih al-Bukhari 127";

"discovery.card.sunnah_bukhari_132.title" = "Sahih al-Bukhari 132";
"discovery.card.sunnah_bukhari_132.meaning" = "Narrated `Ali:I used to get the emotional urethral discharge frequently so I requested Al-Miqdad to ask the Prophet (ﷺ) about it. Al-Miqdad asked him and he replied, \"One has to perform ablution (after it).\" (See Hadith No)";
"discovery.card.sunnah_bukhari_132.source" = "Sahih al-Bukhari 132";

"discovery.card.sunnah_bukhari_137.title" = "Sahih al-Bukhari 137";
"discovery.card.sunnah_bukhari_137.meaning" = "Narrated `Abbad bin Tamim:My uncle asked Allah's Messenger (ﷺ) about a person who imagined to have passed wind during the prayer. Allah's Apostle replied: \"He should not leave his prayers unless he hears sound or smells something";
"discovery.card.sunnah_bukhari_137.source" = "Sahih al-Bukhari 137";

"discovery.card.sunnah_bukhari_142.title" = "Sahih al-Bukhari 142";
"discovery.card.sunnah_bukhari_142.meaning" = "Narrated Anas:Whenever the Prophet (ﷺ) went to answer the call of nature, he used to say, \"Allah-umma inni a`udhu bika minal khubuthi wal khaba'ith i.e. O Allah, I seek Refuge with You from all offensive and wicked things (evil deeds and evil spirits)";
"discovery.card.sunnah_bukhari_142.source" = "Sahih al-Bukhari 142";

"discovery.card.sunnah_bukhari_143.title" = "Sahih al-Bukhari 143";
"discovery.card.sunnah_bukhari_143.meaning" = "Narrated Ibn `Abbas:Once the Prophet (ﷺ) entered a lavatory and I placed water for his ablution. He asked, \"Who placed it?\" He was informed accordingly and so he said, \"O Allah! Make him (Ibn `Abbas) a learned scholar in religion (Islam)";
"discovery.card.sunnah_bukhari_143.source" = "Sahih al-Bukhari 143";

"discovery.card.sunnah_bukhari_144.title" = "Sahih al-Bukhari 144";
"discovery.card.sunnah_bukhari_144.meaning" = "Narrated Abu Aiyub Al-Ansari:Allah's Messenger (ﷺ) said, \"If anyone of you goes to an open space for answering the call of nature he should neither face nor turn his back towards the Qibla; he should either face the east or the west";
"discovery.card.sunnah_bukhari_144.source" = "Sahih al-Bukhari 144";

"discovery.card.sunnah_bukhari_147.title" = "Sahih al-Bukhari 147";
"discovery.card.sunnah_bukhari_147.meaning" = "Narrated `Aisha:The Prophet (ﷺ) said to his wives, \"You are allowed to go out to answer the call of nature";
"discovery.card.sunnah_bukhari_147.source" = "Sahih al-Bukhari 147";

"discovery.card.sunnah_bukhari_148.title" = "Sahih al-Bukhari 148";
"discovery.card.sunnah_bukhari_148.meaning" = "Narrated `Abdullah bin `Umar:I went up to the roof of Hafsa's house for some job and I saw Allah's Messenger (ﷺ) answering the call of nature facing Sham (Syria, Jordan, Palestine and Lebanon regarded as one country) with his back towards the Qibla. (See Hadith No)";
"discovery.card.sunnah_bukhari_148.source" = "Sahih al-Bukhari 148";

"discovery.card.sunnah_bukhari_149.title" = "Sahih al-Bukhari 149";
"discovery.card.sunnah_bukhari_149.meaning" = "Narrated `Abdullah bin `Umar:Once I went up the roof of our house and saw Allah's Messenger (ﷺ) answering the call of nature while sitting over two bricks facing Baitul-Maqdis (Jerusalem). (See Hadith No)";
"discovery.card.sunnah_bukhari_149.source" = "Sahih al-Bukhari 149";

"discovery.card.sunnah_bukhari_150.title" = "Sahih al-Bukhari 150";
"discovery.card.sunnah_bukhari_150.meaning" = "Narrated Anas bin Malik:Whenever Allah's Messenger (ﷺ) went to answer the call of nature, I along with another boy used to accompany him with a tumbler full of water. (Hisham commented, \"So that he might wash his private parts with it)";
"discovery.card.sunnah_bukhari_150.source" = "Sahih al-Bukhari 150";

"discovery.card.sunnah_bukhari_151.title" = "Sahih al-Bukhari 151";
"discovery.card.sunnah_bukhari_151.meaning" = "Narrated Anas:Whenever Allah's Messenger (ﷺ) went to answer the call of nature, I along with another boy from us used to go behind him with a tumbler full of water";
"discovery.card.sunnah_bukhari_151.source" = "Sahih al-Bukhari 151";

"discovery.card.sunnah_bukhari_153.title" = "Sahih al-Bukhari 153";
"discovery.card.sunnah_bukhari_153.meaning" = "Narrated Abu Qatada:Allah's Messenger (ﷺ) said, \"Whenever anyone of you drinks water, he should not breathe in the drinking utensil, and whenever anyone of you goes to a lavatory, he should neither touch his penis nor clean his private parts with his right hand";
"discovery.card.sunnah_bukhari_153.source" = "Sahih al-Bukhari 153";

"discovery.card.sunnah_bukhari_154.title" = "Sahih al-Bukhari 154";
"discovery.card.sunnah_bukhari_154.meaning" = "Narrated Abu Qatada:The Prophet (ﷺ) said, \"Whenever anyone of you makes water he should not hold his penis or clean his private parts with his right hand. (And while drinking) one should not breathe in the drinking utensil";
"discovery.card.sunnah_bukhari_154.source" = "Sahih al-Bukhari 154";

"discovery.card.sunnah_bukhari_157.title" = "Sahih al-Bukhari 157";
"discovery.card.sunnah_bukhari_157.meaning" = "Narrated Ibn `Abbas:The Prophet (ﷺ) performed ablution by washing the body parts only once";
"discovery.card.sunnah_bukhari_157.source" = "Sahih al-Bukhari 157";

"discovery.card.sunnah_bukhari_158.title" = "Sahih al-Bukhari 158";
"discovery.card.sunnah_bukhari_158.meaning" = "Narrated `Abdullah bin Zaid:The Prophet (ﷺ) performed ablution by washing the body parts twice";
"discovery.card.sunnah_bukhari_158.source" = "Sahih al-Bukhari 158";

"discovery.card.sunnah_bukhari_161.title" = "Sahih al-Bukhari 161";
"discovery.card.sunnah_bukhari_161.meaning" = "Narrated Abu Huraira:The Prophet (ﷺ) said, \"Whoever performs ablution should clean his nose with water by putting the water in it and then blowing it out, and whoever cleans his private parts with stones should do it with odd number of stones";
"discovery.card.sunnah_bukhari_161.source" = "Sahih al-Bukhari 161";

"discovery.card.sunnah_bukhari_165.title" = "Sahih al-Bukhari 165";
"discovery.card.sunnah_bukhari_165.meaning" = "Narrated Muhammad Ibn Ziyad:I heard Abu Huraira saying as he passed by us while the people were performing ablution from a utensil containing water, \"Perform ablution perfectly and thoroughly for Abul-Qasim (the Prophet) said, 'Save your heels from the Hell-fire";
"discovery.card.sunnah_bukhari_165.source" = "Sahih al-Bukhari 165";

"discovery.card.sunnah_bukhari_167.title" = "Sahih al-Bukhari 167";
"discovery.card.sunnah_bukhari_167.meaning" = "Narrated Um-`Atiya:That the Prophet (ﷺ) at the time of washing his deceased daughter had said to them, \"Start from the right side beginning with those parts which are washed in ablution";
"discovery.card.sunnah_bukhari_167.source" = "Sahih al-Bukhari 167";

"discovery.card.sunnah_bukhari_168.title" = "Sahih al-Bukhari 168";
"discovery.card.sunnah_bukhari_168.meaning" = "Narrated `Aisha:The Prophet (ﷺ) used to like to start from the right side on wearing shoes, combing his hair and cleaning or washing himself and on doing anything else";
"discovery.card.sunnah_bukhari_168.source" = "Sahih al-Bukhari 168";

"discovery.card.sunnah_bukhari_170.title" = "Sahih al-Bukhari 170";
"discovery.card.sunnah_bukhari_170.meaning" = "Narrated Ibn Seereen:I said to `Abida, \"I have some of the hair of the Prophet (ﷺ) which I got from Anas or from his family.\" `Abida replied. \"No doubt if I had a single hair of that it would have been dearer to me than the whole world and whatever is in it";
"discovery.card.sunnah_bukhari_170.source" = "Sahih al-Bukhari 170";

"discovery.card.sunnah_bukhari_171.title" = "Sahih al-Bukhari 171";
"discovery.card.sunnah_bukhari_171.meaning" = "Narrated Anas:When Allah's Messenger (ﷺ) got his head shaved, Abu- Talha was the first to take some of his hair";
"discovery.card.sunnah_bukhari_171.source" = "Sahih al-Bukhari 171";

"discovery.card.sunnah_bukhari_172.title" = "Sahih al-Bukhari 172";
"discovery.card.sunnah_bukhari_172.meaning" = "Narrated Abu Huraira:Allah's Messenger (ﷺ) said, \"If a dog drinks from the utensil of anyone of you it is essential to wash it seven times";
"discovery.card.sunnah_bukhari_172.source" = "Sahih al-Bukhari 172";

"discovery.card.sunnah_bukhari_174.title" = "Sahih al-Bukhari 174";
"discovery.card.sunnah_bukhari_174.meaning" = "And narrated Hamza bin 'Abdullah:My father said. \"During the lifetime of Allah's Apostle, the dogs used to urinate, and pass through the mosques (come and go), nevertheless they never used to sprinkle water on it (urine of the dog)";
"discovery.card.sunnah_bukhari_174.source" = "Sahih al-Bukhari 174";

"discovery.card.sunnah_bukhari_177.title" = "Sahih al-Bukhari 177";
"discovery.card.sunnah_bukhari_177.meaning" = "Narrated `Abbad bin Tamim:My uncle said: The Prophet (ﷺ) said, \"One should not leave his prayer unless he hears sound or smells something";
"discovery.card.sunnah_bukhari_177.source" = "Sahih al-Bukhari 177";

"discovery.card.sunnah_bukhari_178.title" = "Sahih al-Bukhari 178";
"discovery.card.sunnah_bukhari_178.meaning" = "Narrated `Ali:I used to get emotional urethral discharges frequently and felt shy to ask Allah's Messenger (ﷺ) about it. So I requested Al-Miqdad bin Al-Aswad to ask (the Prophet (ﷺ) ) about it. Al-Miqdad asked him and he replied, \"One has to perform ablution (after it)";
"discovery.card.sunnah_bukhari_178.source" = "Sahih al-Bukhari 178";

"discovery.card.sunnah_bukhari_188.title" = "Sahih al-Bukhari 188";
"discovery.card.sunnah_bukhari_188.meaning" = "Abu Musa said:The Prophet asked for a tumbler containing water and washed both his hands and face in it and then threw a mouthful of water in the tumbler and said to both of us (Abu Musa and Bilal), \"Drink from the tumbler and pour some of its water on your faces and chests";
"discovery.card.sunnah_bukhari_188.source" = "Sahih al-Bukhari 188";

"discovery.card.sunnah_bukhari_193.title" = "Sahih al-Bukhari 193";
"discovery.card.sunnah_bukhari_193.meaning" = "Narrated 'Abdullah bin 'Umar:\"During the lifetime of Allah's Messenger (ﷺ) men and women used to perform ablution together";
"discovery.card.sunnah_bukhari_193.source" = "Sahih al-Bukhari 193";

"discovery.card.sunnah_bukhari_196.title" = "Sahih al-Bukhari 196";
"discovery.card.sunnah_bukhari_196.meaning" = "Narrated Abu Musa:Once the Prophet (ﷺ) asked for a tumbler containing water. He washed his hands and face in it and also threw a mouthful of water in it";
"discovery.card.sunnah_bukhari_196.source" = "Sahih al-Bukhari 196";

"discovery.card.sunnah_bukhari_201.title" = "Sahih al-Bukhari 201";
"discovery.card.sunnah_bukhari_201.meaning" = "Narrated Anas:The Prophet (ﷺ) used to take a bath with one Sa` up to five Mudds (1 Sa` = [??] Mudds) of water and used to perform ablution with one Mudd of water";
"discovery.card.sunnah_bukhari_201.source" = "Sahih al-Bukhari 201";

"discovery.card.sunnah_bukhari_204.title" = "Sahih al-Bukhari 204";
"discovery.card.sunnah_bukhari_204.meaning" = "Narrated Ja`far bin `Amr bin Umaiya Ad-Damri:My father said, \"I saw the Prophet (ﷺ) passing wet hands over his Khuffs (socks made from thick fabric or leather)";
"discovery.card.sunnah_bukhari_204.source" = "Sahih al-Bukhari 204";

"discovery.card.sunnah_bukhari_205.title" = "Sahih al-Bukhari 205";
"discovery.card.sunnah_bukhari_205.meaning" = "Narrated Ja`far bin `Amr:My father said, \"I saw the Prophet (ﷺ) passing wet hands over his turban and Khuffs (socks made from thick fabric or leather)";
"discovery.card.sunnah_bukhari_205.source" = "Sahih al-Bukhari 205";

"discovery.card.sunnah_bukhari_207.title" = "Sahih al-Bukhari 207";
"discovery.card.sunnah_bukhari_207.meaning" = "Narrated `Abdullah bin `Abbas:Allah's Messenger (ﷺ) ate a piece of cooked mutton from the shoulder region and prayed without repeating ablution";
"discovery.card.sunnah_bukhari_207.source" = "Sahih al-Bukhari 207";

"discovery.card.sunnah_bukhari_208.title" = "Sahih al-Bukhari 208";
"discovery.card.sunnah_bukhari_208.meaning" = "Narrated Ja`far bin `Amr bin Umaiya:My father said, \"I saw Allah's Messenger (ﷺ) taking a piece of (cooked) mutton from the shoulder region and then he was called for prayer. He put his knife down and prayed without repeating ablution";
"discovery.card.sunnah_bukhari_208.source" = "Sahih al-Bukhari 208";

"discovery.card.sunnah_bukhari_210.title" = "Sahih al-Bukhari 210";
"discovery.card.sunnah_bukhari_210.meaning" = "Narrated Maimuna:The Prophet (ﷺ) ate (a piece of) mutton from the shoulder region and then prayed without repeating the ablution";
"discovery.card.sunnah_bukhari_210.source" = "Sahih al-Bukhari 210";

"discovery.card.sunnah_bukhari_211.title" = "Sahih al-Bukhari 211";
"discovery.card.sunnah_bukhari_211.meaning" = "Narrated Ibn `Abbas:Allah's Messenger (ﷺ) drank milk, rinsed his mouth and said, \"It has fat";
"discovery.card.sunnah_bukhari_211.source" = "Sahih al-Bukhari 211";

"discovery.card.sunnah_bukhari_212.title" = "Sahih al-Bukhari 212";
"discovery.card.sunnah_bukhari_212.meaning" = "Narrated `Aisha:Allah's Messenger (ﷺ) said, \"If anyone of you feels drowsy while praying he should go to bed (sleep) till his slumber is over because in praying while drowsy one does not know whether one is asking for forgiveness or for a bad thing for oneself";
"discovery.card.sunnah_bukhari_212.source" = "Sahih al-Bukhari 212";

"discovery.card.sunnah_bukhari_213.title" = "Sahih al-Bukhari 213";
"discovery.card.sunnah_bukhari_213.meaning" = "Narrated Anas:The Prophet (ﷺ) said, \"If anyone of you feels drowsy while praying, he should sleep till he understands what he is saying (reciting)";
"discovery.card.sunnah_bukhari_213.source" = "Sahih al-Bukhari 213";

"discovery.card.sunnah_bukhari_214.title" = "Sahih al-Bukhari 214";
"discovery.card.sunnah_bukhari_214.meaning" = "Narrated `Amr bin `Amir:Anas said, \"The Prophet (ﷺ) used to perform ablution for every prayer.\" I asked Anas, \"What did you used to do?' Anas replied, \"We used to pray with the same ablution until we break it with Hadath";
"discovery.card.sunnah_bukhari_214.source" = "Sahih al-Bukhari 214";

"discovery.card.sunnah_bukhari_217.title" = "Sahih al-Bukhari 217";
"discovery.card.sunnah_bukhari_217.meaning" = "Narrated Anas bin Malik:Whenever the Prophet (ﷺ) went to answer the call of nature, I used to bring water with which he used to clean his private parts";
"discovery.card.sunnah_bukhari_217.source" = "Sahih al-Bukhari 217";

"discovery.card.sunnah_bukhari_219.title" = "Sahih al-Bukhari 219";
"discovery.card.sunnah_bukhari_219.meaning" = "Narrated Anas bin Malik:The Prophet (ﷺ) saw a Bedouin making water in the mosque and told the people not to disturb him. When he finished, the Prophet (ﷺ) asked for some water and poured it over (the urine)";
"discovery.card.sunnah_bukhari_219.source" = "Sahih al-Bukhari 219";

"discovery.card.sunnah_bukhari_221.title" = "Sahih al-Bukhari 221";
"discovery.card.sunnah_bukhari_221.meaning" = "Narrated Anas bin Malik:The Prophet (ﷺ) said as above";
"discovery.card.sunnah_bukhari_221.source" = "Sahih al-Bukhari 221";

"discovery.card.sunnah_bukhari_222.title" = "Sahih al-Bukhari 222";
"discovery.card.sunnah_bukhari_222.meaning" = "Narrated `Aisha:(the mother of faithful believers) A child was brought to Allah's Messenger (ﷺ) and it urinated on the garment of the Prophet. The Prophet (ﷺ) asked for water and poured it over the soiled place";
"discovery.card.sunnah_bukhari_222.source" = "Sahih al-Bukhari 222";

"discovery.card.sunnah_bukhari_224.title" = "Sahih al-Bukhari 224";
"discovery.card.sunnah_bukhari_224.meaning" = "Narrated Hudhaifa:Once the Prophet (ﷺ) went to the dumps of some people and passed urine while standing. He then asked for water and so I brought it to him and he performed ablution";
"discovery.card.sunnah_bukhari_224.source" = "Sahih al-Bukhari 224";

"discovery.card.sunnah_bukhari_225.title" = "Sahih al-Bukhari 225";
"discovery.card.sunnah_bukhari_225.meaning" = "Narrated Hudhaifa':The Prophet (ﷺ) and I walked till we reached the dumps of some people. He stood, as any one of you stands, behind a wall and urinated. I went away, but he beckoned me to come. So I approached him and stood near his back till he finished";
"discovery.card.sunnah_bukhari_225.source" = "Sahih al-Bukhari 225";

"discovery.card.sunnah_bukhari_229.title" = "Sahih al-Bukhari 229";
"discovery.card.sunnah_bukhari_229.meaning" = "Narrated `Aisha:I used to wash the traces of Janaba (semen) from the clothes of the Prophet (ﷺ) and he used to go for prayers while traces of water were still on it (water spots were still visible)";
"discovery.card.sunnah_bukhari_229.source" = "Sahih al-Bukhari 229";

"discovery.card.sunnah_bukhari_230.title" = "Sahih al-Bukhari 230";
"discovery.card.sunnah_bukhari_230.meaning" = "Narrated Sulaiman bin Yasar:I asked `Aisha about the clothes soiled with semen. She replied, \"I used to wash it off the clothes of Allah's Messenger (ﷺ) and he would go for the prayer while water spots were still visible";
"discovery.card.sunnah_bukhari_230.source" = "Sahih al-Bukhari 230";

"discovery.card.sunnah_bukhari_231.title" = "Sahih al-Bukhari 231";
"discovery.card.sunnah_bukhari_231.meaning" = "Narrated `Amr bin Maimun:I heard Sulaiman bin Yasar talking about the clothes soiled with semen. He said that `Aisha had said, \"I used to wash it off the clothes of Allah's Messenger (ﷺ) and he would go for the prayers while water spots were still visible on them";
"discovery.card.sunnah_bukhari_231.source" = "Sahih al-Bukhari 231";

"discovery.card.sunnah_bukhari_232.title" = "Sahih al-Bukhari 232";
"discovery.card.sunnah_bukhari_232.meaning" = "Narrated `Aishah:I used to wash the semen off the clothes of the Prophet (ﷺ) and even then I used to notice one or more spots on them";
"discovery.card.sunnah_bukhari_232.source" = "Sahih al-Bukhari 232";

"discovery.card.sunnah_bukhari_234.title" = "Sahih al-Bukhari 234";
"discovery.card.sunnah_bukhari_234.meaning" = "Narrated Anas:Prior to the construction of the mosque, the Prophet (ﷺ) offered the prayers at sheep-folds";
"discovery.card.sunnah_bukhari_234.source" = "Sahih al-Bukhari 234";

"discovery.card.sunnah_bukhari_235.title" = "Sahih al-Bukhari 235";
"discovery.card.sunnah_bukhari_235.meaning" = "Narrated Maimuna:Allah's Messenger (ﷺ) was asked regarding ghee (cooking butter) in which a mouse had fallen. He said, \"Take out the mouse and throw away the ghee around it and use the rest";
"discovery.card.sunnah_bukhari_235.source" = "Sahih al-Bukhari 235";

"discovery.card.sunnah_bukhari_236.title" = "Sahih al-Bukhari 236";
"discovery.card.sunnah_bukhari_236.meaning" = "Narrated Maimuna:The Prophet (ﷺ) was asked regarding ghee in which a mouse had fallen. He said, \"Take out the mouse and throw away the ghee around it (and use the rest)";
"discovery.card.sunnah_bukhari_236.source" = "Sahih al-Bukhari 236";

"discovery.card.sunnah_bukhari_237.title" = "Sahih al-Bukhari 237";
"discovery.card.sunnah_bukhari_237.meaning" = "Narrated Abu Huraira:The Prophet (ﷺ) said, \"A wound which a Muslim receives in Allah's cause will appear on the Day of Resurrection as it was at the time of infliction; blood will be flowing from the wound and its color will be that of the blood but will smell like musk";
"discovery.card.sunnah_bukhari_237.source" = "Sahih al-Bukhari 237";

"discovery.card.sunnah_bukhari_238.title" = "Sahih al-Bukhari 238";
"discovery.card.sunnah_bukhari_238.meaning" = "Narrated Abu Huraira:Allah's Messenger (ﷺ) said, \"We (Muslims) are the last (people to come in the world) but (will be) the foremost (on the Day of Resurrection)";
"discovery.card.sunnah_bukhari_238.source" = "Sahih al-Bukhari 238";

"discovery.card.sunnah_bukhari_239.title" = "Sahih al-Bukhari 239";
"discovery.card.sunnah_bukhari_239.meaning" = "The same narrator said that the Prophet (ﷺ) had said: \"You should not pass urine in stagnant water which is not flowing then (you may need to) wash in it";
"discovery.card.sunnah_bukhari_239.source" = "Sahih al-Bukhari 239";

"discovery.card.sunnah_bukhari_241.title" = "Sahih al-Bukhari 241";
"discovery.card.sunnah_bukhari_241.meaning" = "Narrated Anas:The Prophet (ﷺ) once spat in his clothes";
"discovery.card.sunnah_bukhari_241.source" = "Sahih al-Bukhari 241";

"discovery.card.sunnah_bukhari_242.title" = "Sahih al-Bukhari 242";
"discovery.card.sunnah_bukhari_242.meaning" = "Narrated Aisha:The Prophet (ﷺ) said, \"All drinks that produce intoxication are Haram (forbidden to drink)";
"discovery.card.sunnah_bukhari_242.source" = "Sahih al-Bukhari 242";

"discovery.card.sunnah_bukhari_250.title" = "Sahih al-Bukhari 250";
"discovery.card.sunnah_bukhari_250.meaning" = "Narrated `Aisha:The Prophet (ﷺ) and I used to take a bath from a single pot called 'Faraq";
"discovery.card.sunnah_bukhari_250.source" = "Sahih al-Bukhari 250";

"discovery.card.sunnah_bukhari_251.title" = "Sahih al-Bukhari 251";
"discovery.card.sunnah_bukhari_251.meaning" = "Narrated Abu Salama:`Aisha's brother and I went to `Aisha and he asked her about the bath of the Prophet. She brought a pot containing about a Sa` of water and took a bath and poured it over her head and at that time there was a screen between her and us";
"discovery.card.sunnah_bukhari_251.source" = "Sahih al-Bukhari 251";

"discovery.card.sunnah_bukhari_253.title" = "Sahih al-Bukhari 253";
"discovery.card.sunnah_bukhari_253.meaning" = "Narrated Ibn `Abbas:The Prophet (ﷺ) and Maimuna used to take a bath from a single pot";
"discovery.card.sunnah_bukhari_253.source" = "Sahih al-Bukhari 253";

"discovery.card.sunnah_bukhari_254.title" = "Sahih al-Bukhari 254";
"discovery.card.sunnah_bukhari_254.meaning" = "Narrated Jubair bin Mut`im:Allah's Messenger (ﷺ) said, \"As for me, I pour water three times on my head.\" And he pointed with both his hands";
"discovery.card.sunnah_bukhari_254.source" = "Sahih al-Bukhari 254";

"discovery.card.sunnah_bukhari_255.title" = "Sahih al-Bukhari 255";
"discovery.card.sunnah_bukhari_255.meaning" = "Narrated Jabir bin `Abdullah:The Prophet (ﷺ) used to pour water three times on his head";
"discovery.card.sunnah_bukhari_255.source" = "Sahih al-Bukhari 255";

"discovery.card.sunnah_bukhari_261.title" = "Sahih al-Bukhari 261";
"discovery.card.sunnah_bukhari_261.meaning" = "Narrated Aisha:The Prophet (ﷺ) and I used to take a bath from a single pot of water and our hands used to go in the pot after each other in turn";
"discovery.card.sunnah_bukhari_261.source" = "Sahih al-Bukhari 261";

"discovery.card.sunnah_bukhari_262.title" = "Sahih al-Bukhari 262";
"discovery.card.sunnah_bukhari_262.meaning" = "Narrated `Aisha:Whenever Allah's Messenger (ﷺ) took a bath of Janaba, he washed his hands first";
"discovery.card.sunnah_bukhari_262.source" = "Sahih al-Bukhari 262";

"discovery.card.sunnah_bukhari_263.title" = "Sahih al-Bukhari 263";
"discovery.card.sunnah_bukhari_263.meaning" = "Narrated `Aisha:The Prophet (ﷺ) and I used to take a bath from a single pot of water after Janaba";
"discovery.card.sunnah_bukhari_263.source" = "Sahih al-Bukhari 263";

"discovery.card.sunnah_bukhari_264.title" = "Sahih al-Bukhari 264";
"discovery.card.sunnah_bukhari_264.meaning" = "Narrated Anas bin Malik:The Prophet (ﷺ) and one of his wives used to take a bath from a single pot of water. (Shu`ba added to Anas' Statement \"After the Janaba)";
"discovery.card.sunnah_bukhari_264.source" = "Sahih al-Bukhari 264";

"discovery.card.sunnah_bukhari_269.title" = "Sahih al-Bukhari 269";
"discovery.card.sunnah_bukhari_269.meaning" = "Narrated `Ali:I used to get emotional urethral discharge frequently. Being the son-in-law of the Prophet (ﷺ) I requested a man to ask him about it. So the man asked the Prophet (ﷺ) about it. The Prophet (ﷺ) replied, \"Perform ablution after washing your organ (penis)";
"discovery.card.sunnah_bukhari_269.source" = "Sahih al-Bukhari 269";

"discovery.card.sunnah_bukhari_271.title" = "Sahih al-Bukhari 271";
"discovery.card.sunnah_bukhari_271.meaning" = "Narrated `Aisha:It is as if I am just looking at the glitter of scent in the parting of the Prophet's head hair while he was a Muhrim";
"discovery.card.sunnah_bukhari_271.source" = "Sahih al-Bukhari 271";

"discovery.card.sunnah_bukhari_277.title" = "Sahih al-Bukhari 277";
"discovery.card.sunnah_bukhari_277.meaning" = "Narrated Aisha:Whenever any one of us was Junub, she poured water over her head thrice with both her hands and then rubbed the right side of her head with one hand and rubbed the left side of the head with the other hand";
"discovery.card.sunnah_bukhari_277.source" = "Sahih al-Bukhari 277";

"discovery.card.sunnah_bukhari_280.title" = "Sahih al-Bukhari 280";
"discovery.card.sunnah_bukhari_280.meaning" = "Narrated Um Hani bint Abi Talib:I went to Allah's Messenger (ﷺ) in the year of the conquest of Mecca and found him taking a bath while Fatima was screening him. The Prophet (ﷺ) asked, \"Who is it?\" I replied, \"I am Um-Hani";
"discovery.card.sunnah_bukhari_280.source" = "Sahih al-Bukhari 280";

"discovery.card.sunnah_bukhari_284.title" = "Sahih al-Bukhari 284";
"discovery.card.sunnah_bukhari_284.meaning" = "Narrated Anas bin Malik:The Prophet (ﷺ) used to visit all his wives in one night and he had nine wives at that time";
"discovery.card.sunnah_bukhari_284.source" = "Sahih al-Bukhari 284";

"discovery.card.sunnah_bukhari_286.title" = "Sahih al-Bukhari 286";
"discovery.card.sunnah_bukhari_286.meaning" = "Narrated Abu Salama:I asked `Aisha \"Did the Prophet (ﷺ) use to sleep while he was Junub?\" She replied, \"Yes, but he used to perform ablution (before going to bed)";
"discovery.card.sunnah_bukhari_286.source" = "Sahih al-Bukhari 286";

"discovery.card.sunnah_bukhari_287.title" = "Sahih al-Bukhari 287";
"discovery.card.sunnah_bukhari_287.meaning" = "Narrated `Umar bin Al-Khattab:I asked Allah's Messenger (ﷺ) \"Can any one of us sleep while he is Junub?\" He replied, \"Yes, if he performs ablution, he can sleep while he is Junub";
"discovery.card.sunnah_bukhari_287.source" = "Sahih al-Bukhari 287";

"discovery.card.sunnah_bukhari_288.title" = "Sahih al-Bukhari 288";
"discovery.card.sunnah_bukhari_288.meaning" = "Narrated `Aisha:Whenever the Prophet (ﷺ) intended to sleep while he was Junub, he used to wash his private parts and perform ablution like that for the prayer";
"discovery.card.sunnah_bukhari_288.source" = "Sahih al-Bukhari 288";

"discovery.card.sunnah_bukhari_289.title" = "Sahih al-Bukhari 289";
"discovery.card.sunnah_bukhari_289.meaning" = "Narrated `Abdullah:`Umar asked the Prophet (ﷺ) \"Can anyone of us sleep while he is Junub?\" He replied, \"Yes, if he performs ablution";
"discovery.card.sunnah_bukhari_289.source" = "Sahih al-Bukhari 289";

"discovery.card.sunnah_bukhari_290.title" = "Sahih al-Bukhari 290";
"discovery.card.sunnah_bukhari_290.meaning" = "Narrated `Abdullah bin `Umar:`Umar bin Al-Khattab told Allah's Messenger (ﷺ), \"I became Junub at night.\" Allah's Messenger (ﷺ) replied, \"Perform ablution after washing your private parts and then sleep";
"discovery.card.sunnah_bukhari_290.source" = "Sahih al-Bukhari 290";

"discovery.card.sunnah_bukhari_291.title" = "Sahih al-Bukhari 291";
"discovery.card.sunnah_bukhari_291.meaning" = "Narrated Hisham:as the following Hadith 290. Narrated Abu Huraira: The Prophet (ﷺ) said, \"When a man sits in between the four parts of a woman and did the sexual intercourse with her, bath becomes compulsory";
"discovery.card.sunnah_bukhari_291.source" = "Sahih al-Bukhari 291";

"discovery.card.sunnah_bukhari_295.title" = "Sahih al-Bukhari 295";
"discovery.card.sunnah_bukhari_295.meaning" = "Narrated `Aisha:While in menses, I used to comb the hair of Allah's Messenger (ﷺ)";
"discovery.card.sunnah_bukhari_295.source" = "Sahih al-Bukhari 295";

"discovery.card.sunnah_bukhari_297.title" = "Sahih al-Bukhari 297";
"discovery.card.sunnah_bukhari_297.meaning" = "Narrated `Aisha:The Prophet (ﷺ) used to lean on my lap and recite Qur'an while I was in menses";
"discovery.card.sunnah_bukhari_297.source" = "Sahih al-Bukhari 297";

"discovery.card.sunnah_bukhari_298.title" = "Sahih al-Bukhari 298";
"discovery.card.sunnah_bukhari_298.meaning" = "Narrated Um Salama:While I was laying with the Prophet (ﷺ) under a single woolen sheet, I got the menses. I slipped away and put on the clothes for menses. He said, \"Have you got \"Nifas\" (menses)?\" I replied, \"Yes.\" He then called me and made me lie with him under the same sheet";
"discovery.card.sunnah_bukhari_298.source" = "Sahih al-Bukhari 298";

"discovery.card.sunnah_bukhari_303.title" = "Sahih al-Bukhari 303";
"discovery.card.sunnah_bukhari_303.meaning" = "Narrated Maimuna:When ever Allah's Messenger (ﷺ) wanted to fondle any of his wives during the periods (menses), he used to ask her to wear an Izar";
"discovery.card.sunnah_bukhari_303.source" = "Sahih al-Bukhari 303";

"discovery.card.sunnah_bukhari_310.title" = "Sahih al-Bukhari 310";
"discovery.card.sunnah_bukhari_310.meaning" = "Narrated `Aisha:\"One of the wives of Allah's Messenger (ﷺ) joined him in I`tikaf and she noticed blood and yellowish discharge (from her private parts) and put a dish under her when she prayed";
"discovery.card.sunnah_bukhari_310.source" = "Sahih al-Bukhari 310";

"discovery.card.sunnah_bukhari_311.title" = "Sahih al-Bukhari 311";
"discovery.card.sunnah_bukhari_311.meaning" = "Narrated `Aisha:One of the mothers of the faithful believers (i.e. the wives of the Prophet (ﷺ) ) did I`tikaf while she was having bleeding in between her periods";
"discovery.card.sunnah_bukhari_311.source" = "Sahih al-Bukhari 311";

"discovery.card.sunnah_bukhari_312.title" = "Sahih al-Bukhari 312";
"discovery.card.sunnah_bukhari_312.meaning" = "Narrated `Aisha:None of us had more than a single garment and we used to have our menses while wearing it. Whenever it got soiled with blood of menses we used to apply saliva to the blood spot and rub off the blood with our nails";
"discovery.card.sunnah_bukhari_312.source" = "Sahih al-Bukhari 312";

"discovery.card.sunnah_bukhari_323.title" = "Sahih al-Bukhari 323";
"discovery.card.sunnah_bukhari_323.meaning" = "Narrated Um Salama:While I was lying with the Prophet (ﷺ) under a woolen sheet, I got my menses. I slipped away and put on the clothes for menses. The Prophet (ﷺ) said, \"Have you got your menses?\" I replied, \"Yes.\" He called me and I slept with him under the woolen sheet";
"discovery.card.sunnah_bukhari_323.source" = "Sahih al-Bukhari 323";

"discovery.card.sunnah_bukhari_326.title" = "Sahih al-Bukhari 326";
"discovery.card.sunnah_bukhari_326.meaning" = "Narrated Um `Atiya:We never considered yellowish discharge as a thing of importance (as menses)";
"discovery.card.sunnah_bukhari_326.source" = "Sahih al-Bukhari 326";

"discovery.card.sunnah_bukhari_328.title" = "Sahih al-Bukhari 328";
"discovery.card.sunnah_bukhari_328.meaning" = "Narrated `Aisha:(the wife of the Prophet) I told Allah's Messenger (ﷺ) that Safiya bint Huyai had got her menses. He said, \"She will probably delay us. Did she perform Tawaf (Al-Ifada) with you?\" We replied, \"Yes.\" On that the Prophet (ﷺ) told her to depart";
"discovery.card.sunnah_bukhari_328.source" = "Sahih al-Bukhari 328";

"discovery.card.sunnah_bukhari_331.title" = "Sahih al-Bukhari 331";
"discovery.card.sunnah_bukhari_331.meaning" = "Narrated `Aisha:The Prophet (ﷺ) said to me, \"Give up the prayer when your menses begin and when it has finished, wash the blood off your body (take a bath) and start praying";
"discovery.card.sunnah_bukhari_331.source" = "Sahih al-Bukhari 331";

"discovery.card.sunnah_bukhari_332.title" = "Sahih al-Bukhari 332";
"discovery.card.sunnah_bukhari_332.meaning" = "Narrated Samura bin Jundub:The Prophet (ﷺ) offered the funeral prayer for the dead body of a woman who died during delivery (i.e. childbirth) and he stood by the middle of her body";
"discovery.card.sunnah_bukhari_332.source" = "Sahih al-Bukhari 332";

"discovery.card.sunnah_bukhari_333.title" = "Sahih al-Bukhari 333";
"discovery.card.sunnah_bukhari_333.meaning" = "Narrated Maimuna:(the wife of the Prophet) During my menses, I never prayed, but used to sit on the mat beside the mosque of Allah's Messenger (ﷺ). He used to offer the prayer on his sheet and in prostration some of his clothes used to touch me";
"discovery.card.sunnah_bukhari_333.source" = "Sahih al-Bukhari 333";

"discovery.card.sunnah_bukhari_340.title" = "Sahih al-Bukhari 340";
"discovery.card.sunnah_bukhari_340.meaning" = "Narrated `Abdur Rahman bin Abza:that while he was in the company of `Umar, `Ammar said to `Umar, \"We were in a detachment and became Junub and I blew the dust off my hands (performed the rolling over the earth and prayed)";
"discovery.card.sunnah_bukhari_340.source" = "Sahih al-Bukhari 340";

"discovery.card.sunnah_bukhari_341.title" = "Sahih al-Bukhari 341";
"discovery.card.sunnah_bukhari_341.meaning" = "Narrated `Abdur Rahman bin Abza:`Ammar said to `Umar \"I rolled myself in the dust and came to the Prophet (ﷺ) who said, 'Passing dusted hands over the face and the backs of the hands is sufficient for you";
"discovery.card.sunnah_bukhari_341.source" = "Sahih al-Bukhari 341";

"discovery.card.sunnah_bukhari_343.title" = "Sahih al-Bukhari 343";
"discovery.card.sunnah_bukhari_343.meaning" = "Narrated `Ammar:The Prophet (ﷺ) stroked the earth with his hands and then passed them over his face and the backs of his hands (while demonstrating Tayammum)";
"discovery.card.sunnah_bukhari_343.source" = "Sahih al-Bukhari 343";

"discovery.card.sunnah_bukhari_353.title" = "Sahih al-Bukhari 353";
"discovery.card.sunnah_bukhari_353.meaning" = "Narrated Muhammad bin Al Munkadir:I saw Jabir bin `Abdullah praying in a single garment and he said that he had seen the Prophet (ﷺ) praying in a single garment";
"discovery.card.sunnah_bukhari_353.source" = "Sahih al-Bukhari 353";

"discovery.card.sunnah_bukhari_354.title" = "Sahih al-Bukhari 354";
"discovery.card.sunnah_bukhari_354.meaning" = "Narrated `Umar bin Abi Salama:The Prophet (ﷺ) prayed in one garment and crossed its ends";
"discovery.card.sunnah_bukhari_354.source" = "Sahih al-Bukhari 354";

"discovery.card.sunnah_bukhari_355.title" = "Sahih al-Bukhari 355";
"discovery.card.sunnah_bukhari_355.meaning" = "Narrated `Umar bin Abi Salama:I saw the Prophet (ﷺ) offering prayers in a single garment in the house of Um-Salama and he had crossed its ends around his shoulders";
"discovery.card.sunnah_bukhari_355.source" = "Sahih al-Bukhari 355";

"discovery.card.sunnah_bukhari_356.title" = "Sahih al-Bukhari 356";
"discovery.card.sunnah_bukhari_356.meaning" = "Narrated `Umar bin Abi Salama:In the house of Um-Salama I saw Allah's Messenger (ﷺ) offering prayers, wrapped in a single garment around his body with its ends crossed round his shoulders";
"discovery.card.sunnah_bukhari_356.source" = "Sahih al-Bukhari 356";

"discovery.card.sunnah_bukhari_358.title" = "Sahih al-Bukhari 358";
"discovery.card.sunnah_bukhari_358.meaning" = "Narrated Abu Huraira:A person asked Allah's Messenger (ﷺ) about the offering of the prayer in a single garment. Allah's Messenger (ﷺ) replied, \"Has every one of you got two garments?";
"discovery.card.sunnah_bukhari_358.source" = "Sahih al-Bukhari 358";

"discovery.card.sunnah_bukhari_359.title" = "Sahih al-Bukhari 359";
"discovery.card.sunnah_bukhari_359.meaning" = "Narrated Abu Huraira:The Prophet (ﷺ) said, \"None of you should offer prayer in a single garment that does not cover the shoulders";
"discovery.card.sunnah_bukhari_359.source" = "Sahih al-Bukhari 359";

"discovery.card.sunnah_bukhari_360.title" = "Sahih al-Bukhari 360";
"discovery.card.sunnah_bukhari_360.meaning" = "Narrated Abu Huraira:Allah's Messenger (ﷺ) said, \"Whoever prays in a single garment must cross its ends (over the shoulders)";
"discovery.card.sunnah_bukhari_360.source" = "Sahih al-Bukhari 360";

"discovery.card.sunnah_bukhari_362.title" = "Sahih al-Bukhari 362";
"discovery.card.sunnah_bukhari_362.meaning" = "Narrated Sahl:The men used to pray with the Prophet (ﷺ) with their Izars tied around their necks as boys used to do; therefore the Prophet (ﷺ) told the women not to raise their heads till the men sat down straight (while praying)";
"discovery.card.sunnah_bukhari_362.source" = "Sahih al-Bukhari 362";

"discovery.card.sunnah_bukhari_372.title" = "Sahih al-Bukhari 372";
"discovery.card.sunnah_bukhari_372.meaning" = "Narrated `Aisha:Allah's Messenger (ﷺ) used to offer the Fajr prayer and some believing women covered with their veiling sheets used to attend the Fajr prayer with him and then they would return to their homes unrecognized";
"discovery.card.sunnah_bukhari_372.source" = "Sahih al-Bukhari 372";

"discovery.card.sunnah_bukhari_375.title" = "Sahih al-Bukhari 375";
"discovery.card.sunnah_bukhari_375.meaning" = "Narrated `Uqba bin 'Amir:The Prophet (ﷺ) was given a silken Farruj [??] as a present. He wore it while praying. When he had finished his prayer, he took it off violently as if with a strong aversion to it and said, \"It is not the dress of Allah-fearing pious people";
"discovery.card.sunnah_bukhari_375.source" = "Sahih al-Bukhari 375";

"discovery.card.sunnah_bukhari_381.title" = "Sahih al-Bukhari 381";
"discovery.card.sunnah_bukhari_381.meaning" = "Narrated Maimuna:Allah's Messenger (ﷺ) used to pray on Khumra";
"discovery.card.sunnah_bukhari_381.source" = "Sahih al-Bukhari 381";

"discovery.card.sunnah_bukhari_383.title" = "Sahih al-Bukhari 383";
"discovery.card.sunnah_bukhari_383.meaning" = "Narrated `Aisha:Allah's Apostle prayed while I was lying like a dead body on his family bed between him and his Qibla";
"discovery.card.sunnah_bukhari_383.source" = "Sahih al-Bukhari 383";

"discovery.card.sunnah_bukhari_384.title" = "Sahih al-Bukhari 384";
"discovery.card.sunnah_bukhari_384.meaning" = "Narrated `Urwa:The Prophet (ﷺ) prayed while `Aisha was lying between him and his Qibla on the bed on which they used to sleep";
"discovery.card.sunnah_bukhari_384.source" = "Sahih al-Bukhari 384";

"discovery.card.sunnah_bukhari_385.title" = "Sahih al-Bukhari 385";
"discovery.card.sunnah_bukhari_385.meaning" = "Narrated Anas bin Malik:We used to pray with the Prophet (ﷺ) and some of us used to place the ends of their clothes at the place of prostration because of scorching heat";
"discovery.card.sunnah_bukhari_385.source" = "Sahih al-Bukhari 385";

"discovery.card.sunnah_bukhari_386.title" = "Sahih al-Bukhari 386";
"discovery.card.sunnah_bukhari_386.meaning" = "Narrated Abu Maslama:Sa`id bin Yazid Al-Azdi: I asked Anas bin Malik whether the Prophet (ﷺ) had ever, prayed with his shoes on. He replied \"Yes";
"discovery.card.sunnah_bukhari_386.source" = "Sahih al-Bukhari 386";

"discovery.card.sunnah_bukhari_388.title" = "Sahih al-Bukhari 388";
"discovery.card.sunnah_bukhari_388.meaning" = "Narrated Al-Mughira bin Shu'ba: I helped the Prophet (ﷺ) in performing ablution and he passed his wet hands over his Khuffs and prayed";
"discovery.card.sunnah_bukhari_388.source" = "Sahih al-Bukhari 388";

"discovery.card.sunnah_bukhari_390.title" = "Sahih al-Bukhari 390";
"discovery.card.sunnah_bukhari_390.meaning" = "Narrated 'Abdullah bin Malik: Ibn Buhaina, \"When the Prophet (ﷺ) prayed, he used to separate his arms from his body so widely that the whiteness of his armpits was visible";
"discovery.card.sunnah_bukhari_390.source" = "Sahih al-Bukhari 390";

"discovery.card.sunnah_bukhari_391.title" = "Sahih al-Bukhari 391";
"discovery.card.sunnah_bukhari_391.meaning" = "Narrated Anas bin Malik:Allah's Messenger (ﷺ) said, \"Whoever prays like us and faces our Qibla and eats our slaughtered animals is a Muslim and is under Allah's and His Apostle's protection. So do not betray Allah by betraying those who are in His protection";
"discovery.card.sunnah_bukhari_391.source" = "Sahih al-Bukhari 391";

"discovery.card.sunnah_bukhari_398.title" = "Sahih al-Bukhari 398";
"discovery.card.sunnah_bukhari_398.meaning" = "Narrated Ibn `Abbas:When the Prophet (ﷺ) entered the Ka`ba, he invoked Allah in each and every side of it and did not pray till he came out of it, and offered a two-rak`at prayer facing the Ka`ba and said, \"This is the Qibla";
"discovery.card.sunnah_bukhari_398.source" = "Sahih al-Bukhari 398";

"discovery.card.sunnah_bukhari_400.title" = "Sahih al-Bukhari 400";
"discovery.card.sunnah_bukhari_400.meaning" = "Narrated Jabir:Allah's Messenger (ﷺ) used to pray (optional, non-obligatory prayer) while riding on his mount (Rahila) wherever it turned, and whenever he wanted to pray the compulsory prayer he dismounted and prayed facing the Qibla";
"discovery.card.sunnah_bukhari_400.source" = "Sahih al-Bukhari 400";

"discovery.card.sunnah_bukhari_404.title" = "Sahih al-Bukhari 404";
"discovery.card.sunnah_bukhari_404.meaning" = "Narrated `Abdullah:\"Once the Prophet (ﷺ) offered five rak`at in Zuhr prayer. He was asked, \"Is there an increase in the prayer?\" The Prophet (ﷺ) said, \"And what is it?\" They said, \"You have prayed five rak`at.' So he bent his legs and performed two prostrations (of Sahu)";
"discovery.card.sunnah_bukhari_404.source" = "Sahih al-Bukhari 404";

"discovery.card.sunnah_bukhari_407.title" = "Sahih al-Bukhari 407";
"discovery.card.sunnah_bukhari_407.meaning" = "Narrated `Aisha:(the mother of faithful believers) Allah's Messenger (ﷺ) saw some nasal secretions, expectoration or sputum on the wall of the mosque in the direction of the Qibla and scraped it off";
"discovery.card.sunnah_bukhari_407.source" = "Sahih al-Bukhari 407";

"discovery.card.sunnah_bukhari_412.title" = "Sahih al-Bukhari 412";
"discovery.card.sunnah_bukhari_412.meaning" = "Narrated Anas:The Prophet (ﷺ) said, \"None of you should spit in front or on his right but he could spit either on his left or under his foot";
"discovery.card.sunnah_bukhari_412.source" = "Sahih al-Bukhari 412";

"discovery.card.sunnah_bukhari_413.title" = "Sahih al-Bukhari 413";
"discovery.card.sunnah_bukhari_413.meaning" = "Narrated Anas bin Malik:The Prophet (ﷺ) said, \"A faithful believer while in prayer is speaking in private to his Lord, so he should neither spit in front of him nor to his right side but he could spit either on his left or under his foot";
"discovery.card.sunnah_bukhari_413.source" = "Sahih al-Bukhari 413";

"discovery.card.sunnah_bukhari_414.title" = "Sahih al-Bukhari 414";
"discovery.card.sunnah_bukhari_414.meaning" = "Narrated Abu Sa`id:The Prophet (ﷺ) saw sputum on (the wall of) the mosque in the direction of the Qibla and scraped it off with gravel. Then he forbade Spitting in front or on the right, but allowed it on one's left or under one's left foot";
"discovery.card.sunnah_bukhari_414.source" = "Sahih al-Bukhari 414";

"discovery.card.sunnah_bukhari_415.title" = "Sahih al-Bukhari 415";
"discovery.card.sunnah_bukhari_415.meaning" = "Narrated Anas bin Malik:The Prophet (ﷺ) said, \"Spitting in the mosque is a sin and its expiation is to bury it";
"discovery.card.sunnah_bukhari_415.source" = "Sahih al-Bukhari 415";

"discovery.card.sunnah_bukhari_418.title" = "Sahih al-Bukhari 418";
"discovery.card.sunnah_bukhari_418.meaning" = "Narrated Abu Huraira:Allah's Messenger (ﷺ) said, \"Do you consider or see that my face is towards the Qibla? By Allah, neither your submissiveness nor your bowing is hidden from me, surely I see you from my back";
"discovery.card.sunnah_bukhari_418.source" = "Sahih al-Bukhari 418";

"discovery.card.sunnah_bukhari_419.title" = "Sahih al-Bukhari 419";
"discovery.card.sunnah_bukhari_419.meaning" = "Narrated Anas bin Malik:The Prophet (ﷺ) led us in a prayer and then got up on the pulpit and said, \"In your prayer and bowing, I certainly see you from my back as I see you (while looking at you)";
"discovery.card.sunnah_bukhari_419.source" = "Sahih al-Bukhari 419";

"discovery.card.sunnah_bukhari_422.title" = "Sahih al-Bukhari 422";
"discovery.card.sunnah_bukhari_422.meaning" = "Narrated Anas:I found the Prophet (ﷺ) in the mosque along with some people. He said to me, \"Did Abu Talha send you?\" I said, \"Yes\". He said, \"For a meal?\" I said, \"Yes.\" Then he said to his companions, \"Get up.\" They set out and I was ahead of them";
"discovery.card.sunnah_bukhari_422.source" = "Sahih al-Bukhari 422";

"discovery.card.sunnah_bukhari_424.title" = "Sahih al-Bukhari 424";
"discovery.card.sunnah_bukhari_424.meaning" = "Narrated `Itban bin Malik:The Prophet (ﷺ) came to my house and said, \"Where do you like me to pray?\" I pointed to a place. The Prophet then said, \"Allahu Akbar\", and we aligned behind him and he offered a two-rak`at prayer";
"discovery.card.sunnah_bukhari_424.source" = "Sahih al-Bukhari 424";

"discovery.card.sunnah_bukhari_426.title" = "Sahih al-Bukhari 426";
"discovery.card.sunnah_bukhari_426.meaning" = "Narrated `Aisha:The Prophet (ﷺ) used to start every thing from the right (for good things) whenever it was possible in all his affairs; for example: in washing, combing or wearing shoes";
"discovery.card.sunnah_bukhari_426.source" = "Sahih al-Bukhari 426";

"discovery.card.sunnah_bukhari_429.title" = "Sahih al-Bukhari 429";
"discovery.card.sunnah_bukhari_429.meaning" = "Narrated Abu Al-Taiyah [??]:Anas said, \"The Prophet (ﷺ) prayed in the sheep fold.\" Later on I heard him saying, \"He prayed in the sheep folds before the construction of the, mosque";
"discovery.card.sunnah_bukhari_429.source" = "Sahih al-Bukhari 429";

"discovery.card.sunnah_bukhari_430.title" = "Sahih al-Bukhari 430";
"discovery.card.sunnah_bukhari_430.meaning" = "Narrated Nafi`:\"I saw Ibn `Umar praying while taking his camel as a Sutra in front of him and he said, \"I saw the Prophet doing the same";
"discovery.card.sunnah_bukhari_430.source" = "Sahih al-Bukhari 430";

"discovery.card.sunnah_bukhari_431.title" = "Sahih al-Bukhari 431";
"discovery.card.sunnah_bukhari_431.meaning" = "Narrated `Abdullah bin `Abbas:The sun eclipsed and Allah's Messenger (ﷺ) offered the eclipse prayer and said, \"I have been shown the Hellfire (now) and I never saw a worse and horrible sight than the sight I have seen today";
"discovery.card.sunnah_bukhari_431.source" = "Sahih al-Bukhari 431";

"discovery.card.sunnah_bukhari_432.title" = "Sahih al-Bukhari 432";
"discovery.card.sunnah_bukhari_432.meaning" = "Narrated Ibn `Umar:The Prophet (ﷺ) had said, \"Offer some of your prayers (Nawafil) at home, and do not take your houses as graves";
"discovery.card.sunnah_bukhari_432.source" = "Sahih al-Bukhari 432";

"discovery.card.sunnah_bukhari_437.title" = "Sahih al-Bukhari 437";
"discovery.card.sunnah_bukhari_437.meaning" = "Narrated Abu Huraira:Allah's Messenger (ﷺ) said, \"May Allah's curse be on the Jews for they built the places of worship at the graves of their Prophets";
"discovery.card.sunnah_bukhari_437.source" = "Sahih al-Bukhari 437";

"discovery.card.sunnah_bukhari_440.title" = "Sahih al-Bukhari 440";
"discovery.card.sunnah_bukhari_440.meaning" = "Narrated Nafi`:`Abdullah bin `Umar said: I used to sleep in the mosque of the Prophet (ﷺ) while I was young and unmarried";
"discovery.card.sunnah_bukhari_440.source" = "Sahih al-Bukhari 440";

"discovery.card.sunnah_bukhari_443.title" = "Sahih al-Bukhari 443";
"discovery.card.sunnah_bukhari_443.meaning" = "Narrated Jabir bin `Abdullah:I went to the Prophet (ﷺ) in the mosque (the sub-narrator Mis`ar thought that Jabir had said, \"In the forenoon.\") He ordered me to pray two rak`at. He owed me some money and he repaid it to me and gave more than what was due to me";
"discovery.card.sunnah_bukhari_443.source" = "Sahih al-Bukhari 443";

"discovery.card.sunnah_bukhari_444.title" = "Sahih al-Bukhari 444";
"discovery.card.sunnah_bukhari_444.meaning" = "Narrated Abu Qatada Al-Aslami:Allah's Messenger (ﷺ) said, \"If anyone of you enters a mosque, he should pray two rak`at before sitting";
"discovery.card.sunnah_bukhari_444.source" = "Sahih al-Bukhari 444";

"discovery.card.sunnah_bukhari_445.title" = "Sahih al-Bukhari 445";
"discovery.card.sunnah_bukhari_445.meaning" = "Narrated Abu Huraira:Allah's Messenger (ﷺ) said, \"The angels keep on asking Allah's forgiveness for anyone of you, as long as he is at his Musalla (praying place) and he does not pass wind (Hadath). They say, 'O Allah! Forgive him, O Allah! be Merciful to him";
"discovery.card.sunnah_bukhari_445.source" = "Sahih al-Bukhari 445";

"discovery.card.sunnah_bukhari_448.title" = "Sahih al-Bukhari 448";
"discovery.card.sunnah_bukhari_448.meaning" = "Narrated Sahl:Allah's Messenger (ﷺ) sent someone to a woman telling her to \"Order her slave, carpenter, to prepare a wooden pulpit for him to sit on";
"discovery.card.sunnah_bukhari_448.source" = "Sahih al-Bukhari 448";

"discovery.card.sunnah_bukhari_449.title" = "Sahih al-Bukhari 449";
"discovery.card.sunnah_bukhari_449.meaning" = "Narrated Jabir:A woman said, \"O Allah's Messenger (ﷺ)! Shall I get something constructed for you to sit on as I have a slave who is a carpenter?\" He replied, \"Yes, if you like.\" So she had that pulpit constructed";
"discovery.card.sunnah_bukhari_449.source" = "Sahih al-Bukhari 449";

"discovery.card.sunnah_bukhari_451.title" = "Sahih al-Bukhari 451";
"discovery.card.sunnah_bukhari_451.meaning" = "Narrated `Amr:I heard Jabir bin `Abdullah saying, \"A man passed through the mosque carrying arrows. Allah's Apostle said to him, 'Hold them by their heads";
"discovery.card.sunnah_bukhari_451.source" = "Sahih al-Bukhari 451";

"discovery.card.sunnah_bukhari_452.title" = "Sahih al-Bukhari 452";
"discovery.card.sunnah_bukhari_452.meaning" = "Narrated Abu Burda bin `Abdullah:(on the authority of his father) The Prophet (ﷺ) said, \"Whoever passes through our mosques or markets with arrows should hold them by their heads lest he should injure a Muslim";
"discovery.card.sunnah_bukhari_452.source" = "Sahih al-Bukhari 452";

"discovery.card.sunnah_bukhari_453.title" = "Sahih al-Bukhari 453";
"discovery.card.sunnah_bukhari_453.meaning" = "Narrated Hassan bin Thabit Al-Ansari:I asked Abu Huraira \"By Allah! Tell me the truth whether you heard the Prophet (ﷺ) saying, 'O Hassan! Reply on behalf of Allah's Messenger (ﷺ). O Allah! Help him with the Holy Spirit.\" Abu Huraira said, \"Yes";
"discovery.card.sunnah_bukhari_453.source" = "Sahih al-Bukhari 453";

"discovery.card.sunnah_bukhari_459.title" = "Sahih al-Bukhari 459";
"discovery.card.sunnah_bukhari_459.meaning" = "Narrated `Aisha:When the verses of Surat \"Al-Baqara\"' about the usury Riba were revealed, the Prophet (ﷺ) went to the mosque and recited them in front of the people and then banned the trade of alcohol";
"discovery.card.sunnah_bukhari_459.source" = "Sahih al-Bukhari 459";

"discovery.card.sunnah_bukhari_460.title" = "Sahih al-Bukhari 460";
"discovery.card.sunnah_bukhari_460.meaning" = "Narrated Abu Rafi: Abu Huraira said, \"A man or a woman used to clean the mosque.\" (A sub-narrator said, 'Most probably a woman..') Then he narrated the Hadith of the Prophet";
"discovery.card.sunnah_bukhari_460.source" = "Sahih al-Bukhari 460";

"discovery.card.sunnah_bukhari_464.title" = "Sahih al-Bukhari 464";
"discovery.card.sunnah_bukhari_464.meaning" = "Narrated Um Salama:I complained to Allah's Messenger (ﷺ) that I was sick. He told me to perform the Tawaf behind the people while riding. So I did so and Allah's Messenger (ﷺ) was praying beside the Ka`ba and reciting the Sura starting with \"Wat-tur wa kitabin mastur";
"discovery.card.sunnah_bukhari_464.source" = "Sahih al-Bukhari 464";

"discovery.card.sunnah_bukhari_469.title" = "Sahih al-Bukhari 469";
"discovery.card.sunnah_bukhari_469.meaning" = "Narrated Abu Huraira:Allah's Messenger (ﷺ) sent some horse men to Najd and they brought a man called Thumama bin Uthal from Bani Hanifa. They fastened him to one of the pillars of the mosque";
"discovery.card.sunnah_bukhari_469.source" = "Sahih al-Bukhari 469";

"discovery.card.sunnah_bukhari_475.title" = "Sahih al-Bukhari 475";
"discovery.card.sunnah_bukhari_475.meaning" = "Narrated `Abbad bin Tamim:that his uncle said, \"I saw Allah's Messenger (ﷺ) lying flat (on his back) in the mosque with one leg on the other.\" Narrated Sa`id bin Al-Musaiyab that `Umar and `Uthman used to do the same";
"discovery.card.sunnah_bukhari_475.source" = "Sahih al-Bukhari 475";

"discovery.card.sunnah_bukhari_478.title" = "Sahih al-Bukhari 478";
"discovery.card.sunnah_bukhari_478.meaning" = "Narrated Ibn `Umar or Ibn `Amr:The Prophet (ﷺ) clasped his hands, by interlacing his fingers";
"discovery.card.sunnah_bukhari_478.source" = "Sahih al-Bukhari 478";

"discovery.card.sunnah_bukhari_480.title" = "Sahih al-Bukhari 480";
"discovery.card.sunnah_bukhari_480.meaning" = "Narrated `Abdullah:That Allah's Messenger (ﷺ) said, \"O `Abdullah bin `Amr! What will be your condition when you will be left with the sediments of (worst) people?\" (They will be in conflict with each other)";
"discovery.card.sunnah_bukhari_480.source" = "Sahih al-Bukhari 480";

"discovery.card.sunnah_bukhari_481.title" = "Sahih al-Bukhari 481";
"discovery.card.sunnah_bukhari_481.meaning" = "Narrated Abu Musa:The Prophet (ﷺ) said, \"A faithful believer to a faithful believer is like the bricks of a wall, enforcing each other.\" While (saying that) the Prophet (ﷺ) clasped his hands, by interlacing his fingers";
"discovery.card.sunnah_bukhari_481.source" = "Sahih al-Bukhari 481";

"discovery.card.sunnah_bukhari_484.title" = "Sahih al-Bukhari 484";
"discovery.card.sunnah_bukhari_484.meaning" = "The narrated Hadith is about the various places on the way from Medina to Mecca where the Prophet (ﷺ) prayed and is not translated";
"discovery.card.sunnah_bukhari_484.source" = "Sahih al-Bukhari 484";

"discovery.card.sunnah_bukhari_496.title" = "Sahih al-Bukhari 496";
"discovery.card.sunnah_bukhari_496.meaning" = "Narrated Sahl (bin Sa`d):The distance between the Musalla of Allah's Messenger (ﷺ) and the wall was just sufficient for a sheep to pass through";
"discovery.card.sunnah_bukhari_496.source" = "Sahih al-Bukhari 496";

"discovery.card.sunnah_bukhari_497.title" = "Sahih al-Bukhari 497";
"discovery.card.sunnah_bukhari_497.meaning" = "Narrated Salama:The distance between the wall of the mosque and the pulpit was hardly enough for a sheep to pass through";
"discovery.card.sunnah_bukhari_497.source" = "Sahih al-Bukhari 497";

"discovery.card.sunnah_bukhari_498.title" = "Sahih al-Bukhari 498";
"discovery.card.sunnah_bukhari_498.meaning" = "Narrated `Abdullah:The Prophet (ﷺ) used to get a Harba planted in front of him (as a Sutra) and pray behind it";
"discovery.card.sunnah_bukhari_498.source" = "Sahih al-Bukhari 498";

"discovery.card.sunnah_bukhari_503.title" = "Sahih al-Bukhari 503";
"discovery.card.sunnah_bukhari_503.meaning" = "Narrated Anas:I saw the most famous people amongst the companions of the Prophet (ﷺ) hurrying towards the pillars at the Maghrib prayer before the Prophet (ﷺ) came for the prayer";
"discovery.card.sunnah_bukhari_503.source" = "Sahih al-Bukhari 503";

"discovery.card.sunnah_bukhari_512.title" = "Sahih al-Bukhari 512";
"discovery.card.sunnah_bukhari_512.meaning" = "Narrated `Aisha:The Prophet (ﷺ) used to pray while I was sleeping across in his bed in front of him. Whenever he wanted to pray witr, he would wake me up and I would pray witr";
"discovery.card.sunnah_bukhari_512.source" = "Sahih al-Bukhari 512";

"discovery.card.sunnah_bukhari_515.title" = "Sahih al-Bukhari 515";
"discovery.card.sunnah_bukhari_515.meaning" = "Narrated `Aisha:(the wife of the Prophet) Allah's Messenger (ﷺ) used to get up at night and pray while I used to lie across between him and the Qibla on his family's bed";
"discovery.card.sunnah_bukhari_515.source" = "Sahih al-Bukhari 515";

"discovery.card.sunnah_bukhari_517.title" = "Sahih al-Bukhari 517";
"discovery.card.sunnah_bukhari_517.meaning" = "Narrated Maimuna bint Al-Harith:My bed was beside the praying place (Musalla) of the Prophet (ﷺ) and sometimes his garment fell on me while I used to lie in my bed";
"discovery.card.sunnah_bukhari_517.source" = "Sahih al-Bukhari 517";

"discovery.card.sunnah_bukhari_518.title" = "Sahih al-Bukhari 518";
"discovery.card.sunnah_bukhari_518.meaning" = "Narrated Maimuna:The Prophet (ﷺ) used to pray while I used to sleep beside him during my periods (menses) and in prostration his garment used to touch me";
"discovery.card.sunnah_bukhari_518.source" = "Sahih al-Bukhari 518";

"discovery.card.sunnah_bukhari_519.title" = "Sahih al-Bukhari 519";
"discovery.card.sunnah_bukhari_519.meaning" = "Narrated `Aisha:It is not good that you people have made us (women) equal to dogs and donkeys. No doubt I saw Allah's Messenger (ﷺ) praying while I used to lie between him and the Qibla and when he wanted to prostrate, he pushed my legs and I withdrew them";
"discovery.card.sunnah_bukhari_519.source" = "Sahih al-Bukhari 519";

"discovery.card.sunnah_bukhari_524.title" = "Sahih al-Bukhari 524";
"discovery.card.sunnah_bukhari_524.meaning" = "Narrated Jarir bin `Abdullah:I gave the pledge of allegiance to Allah's Messenger (ﷺ) for to offer prayers perfectly, to pay Zakat regularly, and to give good advice to every Muslim";
"discovery.card.sunnah_bukhari_524.source" = "Sahih al-Bukhari 524";

"discovery.card.sunnah_bukhari_529.title" = "Sahih al-Bukhari 529";
"discovery.card.sunnah_bukhari_529.meaning" = "Narrated Ghailan: Anas said, \"I do not find (now-a-days) things as they were (practiced) at the time of the Prophet.\" Somebody said \"The prayer (is as it was.)\" Anas said, \"Have you not done in the prayer what you have done?";
"discovery.card.sunnah_bukhari_529.source" = "Sahih al-Bukhari 529";

"discovery.card.sunnah_bukhari_532.title" = "Sahih al-Bukhari 532";
"discovery.card.sunnah_bukhari_532.meaning" = "Narrated Anas:The Prophet (ﷺ) said, \"Do the prostration properly and do not put your forearms flat with elbows touching the ground like a dog. And if you want to spit, do not spit in front, nor to the right for the person in prayer is speaking in private to his Lord";
"discovery.card.sunnah_bukhari_532.source" = "Sahih al-Bukhari 532";

"discovery.card.sunnah_bukhari_533.title" = "Sahih al-Bukhari 533";
"discovery.card.sunnah_bukhari_533.meaning" = "Narrated Abu Huraira and `Abdullah bin `Umar:Allah's Messenger (ﷺ) said, \"If it is very hot, then pray the Zuhr prayer when it becomes (a bit) cooler, as the severity of the heat is from the raging of the Hell-fire";
"discovery.card.sunnah_bukhari_533.source" = "Sahih al-Bukhari 533";

"discovery.card.sunnah_bukhari_538.title" = "Sahih al-Bukhari 538";
"discovery.card.sunnah_bukhari_538.meaning" = "Narrated Abu Sa`id:that Allah's Messenger (ﷺ) said, \"Pray Zuhr prayer when it becomes (a bit) cooler as the severity of heat is from the raging of the Hell-fire";
"discovery.card.sunnah_bukhari_538.source" = "Sahih al-Bukhari 538";

"discovery.card.sunnah_bukhari_542.title" = "Sahih al-Bukhari 542";
"discovery.card.sunnah_bukhari_542.meaning" = "Narrated Anas bin Malik:When we offered the Zuhr prayers behind Allah's Messenger (ﷺ) we used to prostrate on our clothes to protect ourselves from the heat";
"discovery.card.sunnah_bukhari_542.source" = "Sahih al-Bukhari 542";

"discovery.card.sunnah_bukhari_543.title" = "Sahih al-Bukhari 543";
"discovery.card.sunnah_bukhari_543.meaning" = "Narrated Ibn `Abbas:\"The Prophet (ﷺ) prayed eight rak`at for the Zuhr and `Asr, and seven for the Maghrib and `Isha prayers in Medina.\" Aiyub said, \"Perhaps those were rainy nights.\" Anas said, \"May be";
"discovery.card.sunnah_bukhari_543.source" = "Sahih al-Bukhari 543";

"discovery.card.sunnah_bukhari_544.title" = "Sahih al-Bukhari 544";
"discovery.card.sunnah_bukhari_544.meaning" = "Narrated Aisha:Allah's Messenger (ﷺ) used to offer the `Asr prayer when the sunshine had not disappeared from my chamber";
"discovery.card.sunnah_bukhari_544.source" = "Sahih al-Bukhari 544";

"discovery.card.sunnah_bukhari_545.title" = "Sahih al-Bukhari 545";
"discovery.card.sunnah_bukhari_545.meaning" = "Narrated `Aisha:Allah's Messenger (ﷺ) used to offer the `Asr prayers at a time when the sunshine was still inside my chamber and no shadow had yet appeared in it";
"discovery.card.sunnah_bukhari_545.source" = "Sahih al-Bukhari 545";

"discovery.card.sunnah_bukhari_546.title" = "Sahih al-Bukhari 546";
"discovery.card.sunnah_bukhari_546.meaning" = "Narrated Aisha:The Prophet (ﷺ) used to pray the `Asr prayers at a time when the sunshine was still inside my chamber and no shadow had yet appeared in it";
"discovery.card.sunnah_bukhari_546.source" = "Sahih al-Bukhari 546";

"discovery.card.sunnah_bukhari_548.title" = "Sahih al-Bukhari 548";
"discovery.card.sunnah_bukhari_548.meaning" = "Narrated Anas bin Malik:We used to pray the `Asr prayer and after that if someone happened to go to the tribe of Bani `Amr bin `Auf, he would find them still praying the `Asr (prayer)";
"discovery.card.sunnah_bukhari_548.source" = "Sahih al-Bukhari 548";

"discovery.card.sunnah_bukhari_551.title" = "Sahih al-Bukhari 551";
"discovery.card.sunnah_bukhari_551.meaning" = "Narrated Anas bin Malik:We used to pray the `Asr and after that if one of us went to Quba' he would arrive there while the sun was still high";
"discovery.card.sunnah_bukhari_551.source" = "Sahih al-Bukhari 551";

"discovery.card.sunnah_bukhari_552.title" = "Sahih al-Bukhari 552";
"discovery.card.sunnah_bukhari_552.meaning" = "Narrated Ibn `Umar:Allah's Messenger (ﷺ) said, \"Whoever misses the `Asr prayer (intentionally) then it is as if he lost his family and property";
"discovery.card.sunnah_bukhari_552.source" = "Sahih al-Bukhari 552";

"discovery.card.sunnah_bukhari_553.title" = "Sahih al-Bukhari 553";
"discovery.card.sunnah_bukhari_553.meaning" = "Narrated Abu Al-Malih [??]:We were with Buraida in a battle on a cloudy day and he said, \"Offer the `Asr prayer early as the Prophet said, \"Whoever leaves the `Asr prayer, all his (good) deeds will be annulled";
"discovery.card.sunnah_bukhari_553.source" = "Sahih al-Bukhari 553";

"discovery.card.sunnah_bukhari_556.title" = "Sahih al-Bukhari 556";
"discovery.card.sunnah_bukhari_556.meaning" = "Narrated Abu Huraira:Allah's Messenger (ﷺ) said, \"If anyone of you can get one rak`a of the `Asr prayer before sunset, he should complete his prayer. If any of you can get one rak`a of the Fajr prayer before sunrise, he should complete his prayer";
"discovery.card.sunnah_bukhari_556.source" = "Sahih al-Bukhari 556";

"discovery.card.sunnah_bukhari_559.title" = "Sahih al-Bukhari 559";
"discovery.card.sunnah_bukhari_559.meaning" = "Narrated Rafi` bin Khadij:We used to offer the Maghrib prayer with the Prophet (ﷺ) and after finishing the prayer one of us may go away and could still see as far as the spots where one's arrow might reach when shot by a bow";
"discovery.card.sunnah_bukhari_559.source" = "Sahih al-Bukhari 559";

"discovery.card.sunnah_bukhari_561.title" = "Sahih al-Bukhari 561";
"discovery.card.sunnah_bukhari_561.meaning" = "Narrated Salama:We used to pray the Maghrib prayer with the Prophet (ﷺ) when the sun disappeared from the horizon";
"discovery.card.sunnah_bukhari_561.source" = "Sahih al-Bukhari 561";

"discovery.card.sunnah_bukhari_562.title" = "Sahih al-Bukhari 562";
"discovery.card.sunnah_bukhari_562.meaning" = "Narrated Ibn `Abbas:The Prophet (ﷺ) prayed seven rak`at together and eight rak`at together";
"discovery.card.sunnah_bukhari_562.source" = "Sahih al-Bukhari 562";

"discovery.card.sunnah_bukhari_563.title" = "Sahih al-Bukhari 563";
"discovery.card.sunnah_bukhari_563.meaning" = "Narrated `Abdullah Al-Muzani:The Prophet (ﷺ) said, \"Do not be influenced by bedouins regarding the name of your Maghrib prayer which is called `Isha' by them";
"discovery.card.sunnah_bukhari_563.source" = "Sahih al-Bukhari 563";

"discovery.card.sunnah_bukhari_568.title" = "Sahih al-Bukhari 568";
"discovery.card.sunnah_bukhari_568.meaning" = "Narrated Abu Barza:Allah's Messenger (ﷺ) disliked to sleep before the `Isha' prayer and to talk after it";
"discovery.card.sunnah_bukhari_568.source" = "Sahih al-Bukhari 568";

"discovery.card.sunnah_bukhari_574.title" = "Sahih al-Bukhari 574";
"discovery.card.sunnah_bukhari_574.meaning" = "Narrated Abu Bakr bin Abi Musa:My father said, \"Allah's Messenger (ﷺ) said, 'Whoever prays the two cool prayers (`Asr and Fajr) will go to Paradise";
"discovery.card.sunnah_bukhari_574.source" = "Sahih al-Bukhari 574";

"discovery.card.sunnah_bukhari_577.title" = "Sahih al-Bukhari 577";
"discovery.card.sunnah_bukhari_577.meaning" = "Narrated Sahl bin Sa`d:I used to take the \"Suhur\" meal with my family and hasten so as to catch the Fajr (morning prayer) with Allah's Messenger (ﷺ)";
"discovery.card.sunnah_bukhari_577.source" = "Sahih al-Bukhari 577";

"discovery.card.sunnah_bukhari_578.title" = "Sahih al-Bukhari 578";
"discovery.card.sunnah_bukhari_578.meaning" = "Narrated `Aisha:The believing women covered with their veiling sheets used to attend the Fajr prayer with Allah's Apostle, and after finishing the prayer they would return to their home and nobody could recognize them because of darkness";
"discovery.card.sunnah_bukhari_578.source" = "Sahih al-Bukhari 578";

"discovery.card.sunnah_bukhari_579.title" = "Sahih al-Bukhari 579";
"discovery.card.sunnah_bukhari_579.meaning" = "Narrated Abu Huraira:Allah's Messenger (ﷺ) said, \"Whoever could get one rak`a (of the Fajr prayer) before sunrise, he has got the (morning) prayer and whoever could get one rak`a of the `Asr prayer before sunset, he has got the (`Asr) prayer";
"discovery.card.sunnah_bukhari_579.source" = "Sahih al-Bukhari 579";

"discovery.card.sunnah_bukhari_580.title" = "Sahih al-Bukhari 580";
"discovery.card.sunnah_bukhari_580.meaning" = "Narrated Abu Huraira:Allah's Messenger (ﷺ) said, \"Whoever could get one rak`a of a prayer, (in its proper time) he has got the prayer";
"discovery.card.sunnah_bukhari_580.source" = "Sahih al-Bukhari 580";

"discovery.card.sunnah_bukhari_581.title" = "Sahih al-Bukhari 581";
"discovery.card.sunnah_bukhari_581.meaning" = "Narrated `Umar:\"The Prophet (ﷺ) forbade praying after the Fajr prayer till the sun rises and after the `Asr prayer till the sun sets.\" Narrated Ibn `Abbas: Some people told me the same narration (as above)";
"discovery.card.sunnah_bukhari_581.source" = "Sahih al-Bukhari 581";

"discovery.card.sunnah_bukhari_585.title" = "Sahih al-Bukhari 585";
"discovery.card.sunnah_bukhari_585.meaning" = "Narrated Ibn `Umar:Allah's Messenger (ﷺ) said, \"None of you should try to pray at sunrise or sunset";
"discovery.card.sunnah_bukhari_585.source" = "Sahih al-Bukhari 585";

"discovery.card.sunnah_bukhari_586.title" = "Sahih al-Bukhari 586";
"discovery.card.sunnah_bukhari_586.meaning" = "Narrated Abu Sa`id Al-Khudri:I heard Allah's Messenger (ﷺ) saying, \"There is no prayer after the morning prayer till the sun rises, and there is no prayer after the `Asr prayer till the sun sets";
"discovery.card.sunnah_bukhari_586.source" = "Sahih al-Bukhari 586";

"discovery.card.sunnah_bukhari_587.title" = "Sahih al-Bukhari 587";
"discovery.card.sunnah_bukhari_587.meaning" = "Narrated Muawiya:You offer a prayer which I did not see being offered by Allah's Messenger (ﷺ) when we were in his company and he certainly had forbidden it (i.e. two rak`at after the `Asr prayer)";
"discovery.card.sunnah_bukhari_587.source" = "Sahih al-Bukhari 587";

"discovery.card.sunnah_bukhari_588.title" = "Sahih al-Bukhari 588";
"discovery.card.sunnah_bukhari_588.meaning" = "Narrated Abu Huraira:Allah's Messenger (ﷺ) forbade the offering of two prayers: -1. after the morning prayer till the sunrises. -2. after the `Asr prayer till the sun sets";
"discovery.card.sunnah_bukhari_588.source" = "Sahih al-Bukhari 588";

"discovery.card.sunnah_bukhari_589.title" = "Sahih al-Bukhari 589";
"discovery.card.sunnah_bukhari_589.meaning" = "Narrated Ibn `Umar:I pray as I saw my companions praying. I do not forbid praying at any time during the day or night except at sunset and sunrise";
"discovery.card.sunnah_bukhari_589.source" = "Sahih al-Bukhari 589";

"discovery.card.sunnah_bukhari_591.title" = "Sahih al-Bukhari 591";
"discovery.card.sunnah_bukhari_591.meaning" = "Narrated Hisham's father:`Aisha (addressing me) said, \"O son of my sister! The Prophet (ﷺ) never missed two prostrations (i.e. rak`at) after the `Asr prayer in my house";
"discovery.card.sunnah_bukhari_591.source" = "Sahih al-Bukhari 591";

"discovery.card.sunnah_bukhari_592.title" = "Sahih al-Bukhari 592";
"discovery.card.sunnah_bukhari_592.meaning" = "Narrated `Aisha:Allah's Messenger (ﷺ) never missed two rak`at before the Fajr prayer and after the `Asr prayer openly and secretly";
"discovery.card.sunnah_bukhari_592.source" = "Sahih al-Bukhari 592";

"discovery.card.sunnah_bukhari_593.title" = "Sahih al-Bukhari 593";
"discovery.card.sunnah_bukhari_593.meaning" = "Narrated `Aisha:Whenever the Prophet (ﷺ) come to me after the `Asr prayer, he always prayed two rak`at";
"discovery.card.sunnah_bukhari_593.source" = "Sahih al-Bukhari 593";

