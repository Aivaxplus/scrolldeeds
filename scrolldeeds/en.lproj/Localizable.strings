"notification.spiritual.quran1.title" = "Remember Me, I will remember you";
"notification.spiritual.quran1.body" = "“So remember Me; I will remember you.” — Qur’an 2:152";
"notification.spiritual.sunnah1.title" = "The most beloved deeds";
"notification.spiritual.sunnah1.body" = "“The most beloved of deeds to Allah are those that are most consistent, even if they are small.” — Sahih al-Bukhari 6465; Sahih Muslim 783";
"notification.spiritual.reminder1.title" = "Allah sees you";
"notification.spiritual.reminder1.body" = "What you do now returns on the Day of Judgment. Choose what you want to show Him.";
"notification.spiritual.quran2.title" = "With hardship comes ease";
"notification.spiritual.quran2.body" = "“Indeed, with hardship comes ease.” — Qur’an 94:6";
"notification.spiritual.sunnah2.title" = "Speak good, or remain silent";
"notification.spiritual.sunnah2.body" = "“Whoever believes in Allah and the Last Day, let him speak good or remain silent.” — Sahih al-Bukhari 6018; Sahih Muslim 47";
"notification.spiritual.reminder2.title" = "The akhirah is waiting";
"notification.spiritual.reminder2.body" = "This minute counts. A dhikr is lighter to carry than an hour of scrolling.";
"notification.spiritual.quran3.title" = "So remind";
"notification.spiritual.quran3.body" = "“So remind, if the reminder benefits.” — Qur’an 87:9";
"notification.spiritual.sunnah3.title" = "Actions are by intentions";
"notification.spiritual.sunnah3.body" = "“Actions are according to intentions, and every person will have what he intended.” — Sahih al-Bukhari 1; Sahih Muslim 1907";
"notification.spiritual.reminder3.title" = "Where will you stand?";
"notification.spiritual.reminder3.body" = "Be in this world as a traveler. The feed is not your home.";
"notification.spiritual.quran4.title" = "Allah is with the patient";
"notification.spiritual.quran4.body" = "“O you who believe, seek help through patience and prayer. Indeed, Allah is with the patient.” — Qur’an 2:153";
"notification.spiritual.sunnah4.title" = "The strong one";
"notification.spiritual.sunnah4.body" = "“The strong is not the one who overcomes people by his strength, but the one who controls himself while in anger.” — Sahih al-Bukhari 6114; Sahih Muslim 2609";
"notification.spiritual.reminder4.title" = "One breath is a chance";
"notification.spiritual.reminder4.body" = "Allah gave you another breath. Use it for istighfar, not the next video.";
"notification.spiritual.quran5.title" = "Hearts find rest";
"notification.spiritual.quran5.body" = "“Unquestionably, by the remembrance of Allah hearts are assured.” — Qur’an 13:28";
"notification.spiritual.sunnah5.title" = "Make things easy";
"notification.spiritual.sunnah5.body" = "“Make things easy and do not make them difficult; give glad tidings and do not drive people away.” — Sahih al-Bukhari 69; Sahih Muslim 1734";
"notification.spiritual.reminder5.title" = "The grave will ask";
"notification.spiritual.reminder5.body" = "What do you take with you: a streak of clips, or a word Allah loves?";
"notification.spiritual.quran6.title" = "Establish the prayer";
"notification.spiritual.quran6.body" = "“And establish prayer and give zakah and bow with those who bow.” — Qur’an 2:43";
"notification.spiritual.sunnah6.title" = "Learn and teach the Quran";
"notification.spiritual.sunnah6.body" = "“The best of you are those who learn the Quran and teach it.” — Sahih al-Bukhari 5027";
"notification.spiritual.reminder6.title" = "He is near";
"notification.spiritual.reminder6.body" = "When My servants ask you about Me, I am near. Call on Him now.";
"notification.spiritual.quran7.title" = "Your Lord has not forsaken you";
"notification.spiritual.quran7.body" = "“Your Lord has not forsaken you, nor has He detested you.” — Qur’an 93:3";
"notification.spiritual.sunnah7.title" = "Purity is half of faith";
"notification.spiritual.sunnah7.body" = "“Purity is half of faith.” — Sahih Muslim 223";
"notification.spiritual.reminder7.title" = "The Scale";
"notification.spiritual.reminder7.body" = "One Subhanallah can weigh more than everything you scrolled today.";
"notification.spiritual.quran8.title" = "He found you lost and guided";
"notification.spiritual.quran8.body" = "“And He found you lost and guided you.” — Qur’an 93:7";
"notification.spiritual.sunnah8.title" = "Be in this world as a traveler";
"notification.spiritual.sunnah8.body" = "“Be in this world as if you were a stranger or a traveler.” — Sahih al-Bukhari 6416";
"notification.spiritual.reminder8.title" = "Do not forget the return";
"notification.spiritual.reminder8.body" = "Every soul will taste death. Live this hour as something you must answer for.";
"notification.spiritual.quran9.title" = "Do not forget your share";
"notification.spiritual.quran9.body" = "“And do not forget your share of the world. And do good as Allah has done good to you.” — Qur’an 28:77";
"notification.spiritual.sunnah9.title" = "Love for your brother";
"notification.spiritual.sunnah9.body" = "“None of you [truly] believes until he loves for his brother what he loves for himself.” — Sahih al-Bukhari 13; Sahih Muslim 45";
"notification.spiritual.reminder9.title" = "Allah is enough";
"notification.spiritual.reminder9.body" = "What you look for in the feed cannot fill what only Allah fills.";
"notification.spiritual.quran10.title" = "Remember Him standing and sitting";
"notification.spiritual.quran10.body" = "“Those who remember Allah while standing or sitting or [lying] on their sides.” — Qur’an 3:191";
"notification.spiritual.sunnah10.title" = "Safe from the tongue and the hand";
"notification.spiritual.sunnah10.body" = "“A Muslim is the one from whose tongue and hand the Muslims are safe.” — Sahih al-Bukhari 10; Sahih Muslim 40";
"notification.spiritual.reminder10.title" = "A word for Him";
"notification.spiritual.reminder10.body" = "Say Astaghfirullah. It erases. Scrolling only adds what you do not want to carry.";
"notification.spiritual.quran11.title" = "Prayer restrains indecency";
"notification.spiritual.quran11.body" = "“Indeed, prayer prohibits immorality and wrongdoing, and the remembrance of Allah is greater.” — Qur’an 29:45";
"notification.spiritual.sunnah11.title" = "Two words, heavy on the scale";
"notification.spiritual.sunnah11.body" = "“Two words are light on the tongue, heavy on the Scale, and beloved to the Most Merciful: Subhanallahi wa bihamdihi, Subhanallahil-Azeem.” — Sahih al-Bukhari 6406; Sahih Muslim 2694";
"notification.spiritual.reminder11.title" = "The Day is coming";
"notification.spiritual.reminder11.body" = "No one will be wronged. What feels small now will stand on your record.";
"notification.spiritual.quran12.title" = "Has the time not come?";
"notification.spiritual.quran12.body" = "“Has the time not come for those who have believed that their hearts should become humbly submissive to the remembrance of Allah?” — Qur’an 57:16";
"notification.spiritual.sunnah12.title" = "Do not get angry";
"notification.spiritual.sunnah12.body" = "A man said, “Advise me.” He ﷺ said: “Do not get angry.” He repeated it, and he ﷺ kept saying: “Do not get angry.” — Sahih al-Bukhari 6116";
"notification.spiritual.reminder12.title" = "Turn your heart";
"notification.spiritual.reminder12.body" = "In the remembrance of Allah hearts find rest.";
"notification.spiritual.quran13.title" = "Seek help through patience";
"notification.spiritual.quran13.body" = "“And seek help through patience and prayer, and indeed, it is difficult except for the humbly submissive.” — Qur’an 2:45";
"notification.spiritual.sunnah13.title" = "No mercy for the unmerciful";
"notification.spiritual.sunnah13.body" = "“Allah will not be merciful to those who are not merciful to people.” — Sahih al-Bukhari 5997; Sahih Muslim 2319";
"notification.spiritual.reminder13.title" = "For your Lord";
"notification.spiritual.reminder13.body" = "Salah, dhikr, an ayah. That remains. The timeline disappears.";
"notification.spiritual.quran14.title" = "I am near";
"notification.spiritual.quran14.body" = "“And when My servants ask you concerning Me, indeed I am near. I respond to the invocation of the supplicant when he calls upon Me.” — Qur’an 2:186";
"notification.spiritual.sunnah14.title" = "Every good deed is charity";
"notification.spiritual.sunnah14.body" = "“Every good deed is charity.” — Sahih al-Bukhari 6022; Sahih Muslim 1005";
"notification.spiritual.reminder14.title" = "Two minutes with Allah";
"notification.spiritual.reminder14.body" = "Put the phone down. Say Subhanallah, Alhamdulillah, Allahu akbar.";
"notification.spiritual.quran15.title" = "No soul is burdened beyond its scope";
"notification.spiritual.quran15.body" = "“Allah does not charge a soul except [with that within] its capacity.” — Qur’an 2:286";
"notification.spiritual.sunnah15.title" = "Remove harm from the road";
"notification.spiritual.sunnah15.body" = "“Removing a harmful thing from the road is charity.” — Sahih al-Bukhari 2989; Sahih Muslim 1009";
"notification.spiritual.reminder15.title" = "Who do you hope to meet?";
"notification.spiritual.reminder15.body" = "Meeting Allah is real. Prepare one good deed for today.";
"notification.spiritual.quran16.title" = "Do not weaken and do not grieve";
"notification.spiritual.quran16.body" = "“So do not weaken and do not grieve, and you will be superior if you are [true] believers.” — Qur’an 3:139";
"notification.spiritual.sunnah16.title" = "Modesty is part of faith";
"notification.spiritual.sunnah16.body" = "“Modesty (haya) is a branch of faith.” — Sahih al-Bukhari 24; Sahih Muslim 36";
"notification.spiritual.reminder16.title" = "This world is short";
"notification.spiritual.reminder16.body" = "What you delay for Allah will feel longer, then, than this whole feed.";
"notification.spiritual.quran17.title" = "Be patient and remain stationed";
"notification.spiritual.quran17.body" = "“O you who have believed, persevere and endure and remain stationed and fear Allah that you may be successful.” — Qur’an 3:200";
"notification.spiritual.sunnah17.title" = "Religion is sincerity";
"notification.spiritual.sunnah17.body" = "“The religion is naseehah (sincere counsel).” We said, “To whom?” He said, “To Allah, His Book, His Messenger, the leaders of the Muslims, and their common folk.” — Sahih Muslim 55";
"notification.spiritual.reminder17.title" = "Ask forgiveness";
"notification.spiritual.reminder17.body" = "Allah loves that you return. One sincere tawbah outweighs a perfect scroll.";
"notification.spiritual.quran18.title" = "Prayer at fixed times";
"notification.spiritual.quran18.body" = "“Indeed, prayer has been decreed upon the believers a decree of specified times.” — Qur’an 4:103";
"notification.spiritual.sunnah18.title" = "Honor your guest";
"notification.spiritual.sunnah18.body" = "“Whoever believes in Allah and the Last Day, let him honor his guest.” — Sahih al-Bukhari 6018; Sahih Muslim 47";
"notification.spiritual.reminder18.title" = "Your record";
"notification.spiritual.reminder18.body" = "The angels are writing. Let this moment be a hasanah, not heedlessness.";
"notification.spiritual.quran19.title" = "Remember your Lord inwardly";
"notification.spiritual.quran19.body" = "“And remember your Lord within yourself in humility and in fear without being apparent in speech, in the mornings and the evenings.” — Qur’an 7:205";
"notification.spiritual.sunnah19.title" = "Believers support one another";
"notification.spiritual.sunnah19.body" = "“The believer to another believer is like a building, each part supporting the other.” — Sahih al-Bukhari 481; Sahih Muslim 2585";
"notification.spiritual.reminder19.title" = "The next life is closer";
"notification.spiritual.reminder19.body" = "You do not know which breath is the last. Remember Allah before you scroll on.";
"notification.spiritual.quran20.title" = "Allah will not change a people";
"notification.spiritual.quran20.body" = "“Indeed, Allah will not change the condition of a people until they change what is in themselves.” — Qur’an 13:11";
"notification.spiritual.sunnah20.title" = "Love the Messenger ﷺ";
"notification.spiritual.sunnah20.body" = "“None of you [truly] believes until I am more beloved to him than his father, his child, and all people.” — Sahih al-Bukhari 15; Sahih Muslim 44";
"notification.spiritual.reminder20.title" = "An ayah to hold onto";
"notification.spiritual.reminder20.body" = "Whoever fears Allah, He will make a way out for him.";
"notification.spiritual.quran21.title" = "A good life for the righteous";
"notification.spiritual.quran21.body" = "“Whoever does righteousness, whether male or female, while being a believer — We will surely cause him to live a good life.” — Qur’an 16:97";
"notification.spiritual.sunnah21.title" = "Allah looks at the hearts";
"notification.spiritual.sunnah21.body" = "“Allah does not look at your appearance or wealth, but He looks at your hearts and your deeds.” — Sahih Muslim 2564";
"notification.spiritual.reminder21.title" = "After death";
"notification.spiritual.reminder21.body" = "Three things remain: ongoing charity, beneficial knowledge, and a child who makes du'a. The rest stays here.";
"notification.spiritual.quran22.title" = "Call upon Me";
"notification.spiritual.quran22.body" = "“And your Lord says: Call upon Me; I will respond to you.” — Qur’an 40:60";
"notification.spiritual.sunnah22.title" = "The upper hand";
"notification.spiritual.sunnah22.body" = "“The upper hand is better than the lower hand. The upper hand is the one that gives, and the lower is the one that takes.” — Sahih al-Bukhari 1429; Sahih Muslim 1033";
"notification.spiritual.reminder22.title" = "Return to Allah";
"notification.spiritual.reminder22.body" = "If you forget Him, He leaves you to that. Come back with one La ilaha illallah.";
"notification.spiritual.quran23.title" = "Do not despair of mercy";
"notification.spiritual.quran23.body" = "“Say: O My servants who have transgressed against themselves, do not despair of the mercy of Allah. Indeed, Allah forgives all sins.” — Qur’an 39:53";
"notification.spiritual.sunnah23.title" = "Pleased with Allah as Lord";
"notification.spiritual.sunnah23.body" = "“Whoever is pleased with Allah as his Lord, Islam as his religion, and Muhammad ﷺ as his Messenger, has tasted the flavor of faith.” — Sahih Muslim 34";
"notification.spiritual.reminder23.title" = "The last part of the night";
"notification.spiritual.reminder23.body" = "That hour is a meeting with Allah. Protect it from the late feed.";
"notification.spiritual.quran24.title" = "Let every soul look to tomorrow";
"notification.spiritual.quran24.body" = "“O you who have believed, fear Allah. And let every soul look to what it has put forth for tomorrow.” — Qur’an 59:18";
"notification.spiritual.sunnah24.title" = "Guard the five prayers";
"notification.spiritual.sunnah24.body" = "Islam is built on five: the testimony of faith, prayer, zakah, Hajj, and fasting Ramadan. — Sahih al-Bukhari 8; Sahih Muslim 16";
"notification.spiritual.reminder24.title" = "Pause and ask";
"notification.spiritual.reminder24.body" = "If you died now, would you be content with where your heart was?";
