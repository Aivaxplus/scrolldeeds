"knowledge.card.miswak.arabic" = "";
"knowledge.card.miswak.body" = "The siwak purifies the mouth and pleases the Lord. A small stick, a beloved sunnah.";
"knowledge.card.miswak.source" = "Sahih al-Bukhari 1934";

"knowledge.card.anger_sit.title" = "When anger rises, sit";
"knowledge.card.anger_sit.arabic" = "";
"knowledge.card.anger_sit.body" = "If you are standing, sit. If you are sitting, lie down. Anger is from Shaytan — change your posture before it owns you.";
"knowledge.card.anger_sit.source" = "Sunan Abi Dawud 4782";

"knowledge.card.even_date.title" = "Even half a date";
"knowledge.card.even_date.arabic" = "";
"knowledge.card.even_date.body" = "Protect yourself from the Fire even with half a date in charity. No gift is too small when it is sincere.";
"knowledge.card.even_date.source" = "Sahih al-Bukhari 1417";

"knowledge.card.ayatul_kursi.title" = "Ayat al-Kursi";
