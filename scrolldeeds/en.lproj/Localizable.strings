"discovery.explain.allah_name.title" = "%@, a name of Allah";
"discovery.explain.allah_name.body" = "%@ is one of the names of Allah. This title of mercy belongs to Him alone.";
"discovery.explain.muqattaat.body" = "%@ are letters with which Allah opened this surah. Their exact meaning is with Allah.";

"discovery.card.smile.title" = "A smile is charity";
"discovery.card.smile.meaning" = "The Prophet ﷺ said: “Your smile in the face of your brother is charity.”";
"discovery.card.smile.source" = "Jami‘ at-Tirmidhi 1956 (hasan)";

"discovery.card.salam.title" = "Spread the salam";
"discovery.card.salam.meaning" = "A man asked which Islam is best. The Prophet ﷺ said: to feed people, and to greet with salam those you know and those you do not. He also said: spread the greeting of peace among yourselves.";
"discovery.card.salam.source" = "Sahih al-Bukhari 28 · Sahih Muslim 54";

"discovery.card.right_hand.title" = "Eat with your right hand";
"discovery.card.right_hand.meaning" = "The Prophet ﷺ said: “When one of you eats, let him eat with his right hand, and when he drinks, let him drink with his right hand, for the Shaytan eats with his left hand and drinks with his left hand.”";
"discovery.card.right_hand.source" = "Sahih Muslim 2020";

"discovery.card.bismillah_eat.title" = "Begin with Bismillah";
"discovery.card.bismillah_eat.meaning" = "The Prophet ﷺ said: when one of you eats, let him mention the name of Allah. If he forgets at the beginning, let him say: “In the name of Allah at its beginning and its end.”";
"discovery.card.bismillah_eat.source" = "Sunan Abi Dawud 3767 · Jami‘ at-Tirmidhi 1858";

"discovery.card.right_shoe.title" = "Start with the right sandal";
"discovery.card.right_shoe.meaning" = "The Prophet ﷺ said: “If one of you puts on sandals, let him start with the right; and when he takes them off, let him start with the left.”";
"discovery.card.right_shoe.source" = "Sahih al-Bukhari 5855";

"discovery.card.siwak.title" = "The siwak";
"discovery.card.siwak.meaning" = "The Prophet ﷺ said: “If I did not fear hardship for my ummah, I would have ordered them to use the siwak at every prayer.”";
"discovery.card.siwak.source" = "Sahih al-Bukhari 887 · Sahih Muslim 252";

"discovery.card.anger.title" = "Strength is self-control";
"discovery.card.anger.meaning" = "The Prophet ﷺ said: “The strong is not the one who overcomes people by force; the strong is the one who controls himself when angry.”";
"discovery.card.anger.source" = "Sahih al-Bukhari 6114 · Sahih Muslim 2609";

"discovery.card.visit_sick.title" = "Visit the sick";
"discovery.card.visit_sick.meaning" = "The Prophet ﷺ said: “The rights of a Muslim upon a Muslim are five: returning the greeting, visiting the sick, following the funeral, accepting an invitation, and saying ‘yarhamuk Allah’ to one who sneezes.”";
"discovery.card.visit_sick.source" = "Sahih al-Bukhari 1240 · Sahih Muslim 2162";

"discovery.card.two_words.title" = "Two words, heavy on the Scale";
"discovery.card.two_words.meaning" = "The Prophet ﷺ said: “There are two words that are light on the tongue, heavy on the Scale, and beloved to the Most Merciful: Glory be to Allah and praise be to Him; Glory be to Allah, the Magnificent.”";
"discovery.card.two_words.source" = "Sahih al-Bukhari 6406 · Sahih Muslim 2694";

"discovery.card.ease.title" = "With hardship comes ease";
"discovery.card.ease.meaning" = "Allah says: “Indeed, with hardship comes ease.” Relief is promised with the difficulty — not only after it.";
"discovery.card.ease.source" = "Qur’an 94:5–6";

"discovery.card.neighbor.title" = "Honor your neighbor";
"discovery.card.neighbor.meaning" = "The Prophet ﷺ said: “Jibril kept advising me about the neighbor until I thought he would give him a share of inheritance.”";
"discovery.card.neighbor.source" = "Sahih al-Bukhari 6014 · Sahih Muslim 2624";

"discovery.card.knowledge.title" = "My Lord, increase me in knowledge";
"discovery.card.knowledge.meaning" = "Allah taught His Messenger ﷺ this dua: “My Lord, increase me in knowledge.”";
"discovery.card.knowledge.source" = "Qur’an 20:114";

"discovery.card.intention.title" = "Actions are by intentions";
"discovery.card.intention.meaning" = "The Prophet ﷺ said: “Actions are only by intentions, and every person will have what he intended.”";
"discovery.card.intention.source" = "Sahih al-Bukhari 1 · Sahih Muslim 1907";

"discovery.card.half_date.title" = "Even half a date";
"discovery.card.half_date.meaning" = "The Prophet ﷺ said: “Protect yourselves from the Fire, even with half a date in charity.”";
"discovery.card.half_date.source" = "Sahih al-Bukhari 1417 · Sahih Muslim 1016";

"discovery.card.remove_harm.title" = "Remove harm from the road";
"discovery.card.remove_harm.meaning" = "The Prophet ﷺ said: “Faith has over seventy branches. The most excellent is saying there is no god but Allah, and the lowest is removing something harmful from the road.”";
"discovery.card.remove_harm.source" = "Sahih Muslim 35";

"discovery.card.ikhlas.title" = "Surah al-Ikhlas";
"discovery.card.ikhlas.meaning" = "The Prophet ﷺ said that “Say: He is Allah, One” is equal to a third of the Qur’an.";
"discovery.card.ikhlas.source" = "Qur’an 112 · Sahih al-Bukhari 5013";

"discovery.card.kursi.title" = "Ayat al-Kursi";
"discovery.card.kursi.meaning" = "“Allah — there is no god except Him, the Ever-Living, the Sustainer of all.” In a sahih report, a reciter of this verse at night was told he would be guarded until morning, and the Prophet ﷺ confirmed it.";
"discovery.card.kursi.source" = "Qur’an 2:255 · Sahih al-Bukhari 2311";

"discovery.card.mercy.title" = "Be merciful";
"discovery.card.mercy.meaning" = "The Prophet ﷺ said: “Allah will not show mercy to those who do not show mercy to people.”";
"discovery.card.mercy.source" = "Sahih al-Bukhari 7376 · Sahih Muslim 2319";

"discovery.card.parents.title" = "Do not even say ‘uff’";
"discovery.card.parents.meaning" = "Allah says: “Your Lord has decreed that you worship none but Him, and that you be dutiful to parents. If one or both of them reach old age with you, do not say to them ‘uff,’ and do not repel them, but speak to them a noble word.”";
"discovery.card.parents.source" = "Qur’an 17:23";

"discovery.card.backbite.title" = "Do not backbite";
"discovery.card.backbite.meaning" = "Allah says: “Do not spy and do not backbite one another. Would one of you like to eat the flesh of his dead brother? You would detest it.”";
"discovery.card.backbite.source" = "Qur’an 49:12";

"discovery.card.inshaallah.title" = "Say in sha Allah";
"discovery.card.inshaallah.meaning" = "Allah says: “And never say of anything, ‘I will do that tomorrow,’ except [while adding], ‘If Allah wills.’”";
"discovery.card.inshaallah.source" = "Qur’an 18:23–24";

"discovery.card.purification.title" = "Purification is half of faith";
"discovery.card.purification.meaning" = "The Prophet ﷺ said: “Purification is half of faith.”";
"discovery.card.purification.source" = "Sahih Muslim 223";

"discovery.card.conceal.title" = "Conceal a fault";
"discovery.card.conceal.meaning" = "The Prophet ﷺ said: “Whoever conceals [the fault of] a Muslim, Allah will conceal him on the Day of Resurrection.”";
"discovery.card.conceal.source" = "Sahih al-Bukhari 2442 · Sahih Muslim 2580";

"discovery.card.night_prayer.title" = "The night prayer";
"discovery.card.night_prayer.meaning" = "The Prophet ﷺ said: “The best prayer after the obligatory prayers is the night prayer.”";
"discovery.card.night_prayer.source" = "Sahih Muslim 1163";

"discovery.card.return_salam.title" = "Return the greeting";
"discovery.card.return_salam.meaning" = "Allah says: “When you are greeted with a greeting, greet with one better than it, or return it. Indeed, Allah takes account of all things.”";
"discovery.card.return_salam.source" = "Qur’an 4:86";

"discovery.card.patience.title" = "Seek help in patience and prayer";
"discovery.card.patience.meaning" = "Allah says: “O you who believe, seek help through patience and prayer. Indeed, Allah is with the patient.”";
"discovery.card.patience.source" = "Qur’an 2:153";

"discovery.card.tawakkul.title" = "Allah is sufficient";
"discovery.card.tawakkul.meaning" = "Allah says: “And whoever puts his trust in Allah — then He is sufficient for him. Indeed, Allah will accomplish His purpose.”";
"discovery.card.tawakkul.source" = "Qur’an 65:3";

"discovery.card.istighfar.title" = "Seek forgiveness often";
"discovery.card.istighfar.meaning" = "The Prophet ﷺ said: “By Allah, I seek forgiveness from Allah and turn to Him in repentance more than seventy times a day.”";
"discovery.card.istighfar.source" = "Sahih al-Bukhari 6307";

"discovery.card.wudu_sleep.title" = "Sleep with wudu";
"discovery.card.wudu_sleep.meaning" = "The Prophet ﷺ said: “When you go to your bed, perform wudu as you would for prayer, then lie on your right side.”";
"discovery.card.wudu_sleep.source" = "Sahih al-Bukhari 247 · Sahih Muslim 2710";

"discovery.card.enter_home.title" = "Mention Allah when you enter";
"discovery.card.enter_home.meaning" = "The Prophet ﷺ said: when a man enters his house and mentions Allah upon entering and upon eating, the Shaytan says: “You have no lodging and no dinner.”";
"discovery.card.enter_home.source" = "Sahih Muslim 2018";

"discovery.card.lower_gaze.title" = "Lower your gaze";
"discovery.card.lower_gaze.meaning" = "Allah says: “Tell the believing men to lower their gaze and guard their chastity. That is purer for them. Indeed, Allah is All-Aware of what they do.”";
"discovery.card.lower_gaze.source" = "Qur’an 24:30";

"discovery.card.upper_hand.title" = "The upper hand";
"discovery.card.upper_hand.meaning" = "The Prophet ﷺ said: “The upper hand is better than the lower hand. The upper hand is the giving one, and the lower hand is the asking one.”";
"discovery.card.upper_hand.source" = "Sahih al-Bukhari 1427 · Sahih Muslim 1033";

"discovery.card.fatiha.title" = "The Opening";
"discovery.card.fatiha.meaning" = "The Prophet ﷺ said that Allah says: I have divided the prayer between Myself and My servant in two halves. When he says, “Praise be to Allah, Lord of the worlds,” Allah says: My servant has praised Me.";
"discovery.card.fatiha.source" = "Qur’an 1 · Sahih Muslim 395";

"discovery.card.honor_guest.title" = "Honor the guest";
"discovery.card.honor_guest.meaning" = "The Prophet ﷺ said: “Whoever believes in Allah and the Last Day, let him honor his guest.”";
"discovery.card.honor_guest.source" = "Sahih al-Bukhari 6018 · Sahih Muslim 47";

"discovery.card.love_brother.title" = "Love for your brother";
"discovery.card.love_brother.meaning" = "The Prophet ﷺ said: “None of you [truly] believes until he loves for his brother what he loves for himself.”";
"discovery.card.love_brother.source" = "Sahih al-Bukhari 13 · Sahih Muslim 45";

"discovery.card.remember_me.title" = "Remember Me, I will remember you";
"discovery.card.remember_me.meaning" = "Allah says: “So remember Me; I will remember you. And be grateful to Me and do not deny Me.”";
"discovery.card.remember_me.source" = "Qur’an 2:152";

"discovery.card.no_envy.title" = "Do not envy";
"discovery.card.no_envy.meaning" = "The Prophet ﷺ said: “Do not envy one another, do not hate one another, do not turn away from one another, and be, O servants of Allah, brothers.”";
"discovery.card.no_envy.source" = "Sahih al-Bukhari 6065 · Sahih Muslim 2563";

"discovery.card.truthfulness.title" = "Truthfulness leads to Paradise";
"discovery.card.truthfulness.meaning" = "The Prophet ﷺ said: “Truthfulness leads to righteousness, and righteousness leads to Paradise. A man keeps being truthful until he is recorded with Allah as a siddiq.”";
"discovery.card.truthfulness.source" = "Sahih al-Bukhari 6094 · Sahih Muslim 2607";

"discovery.card.ghusl_friday.title" = "Ghusl on Friday";
"discovery.card.ghusl_friday.meaning" = "The Prophet ﷺ said: “Ghusl on Friday is obligatory upon every adult.”";
"discovery.card.ghusl_friday.source" = "Sahih al-Bukhari 879 · Sahih Muslim 846";

"discovery.card.speak_good.title" = "Speak good or remain silent";
"discovery.card.speak_good.meaning" = "The Prophet ﷺ said: “Whoever believes in Allah and the Last Day, let him speak good or remain silent.”";
"discovery.card.speak_good.source" = "Sahih al-Bukhari 6018 · Sahih Muslim 47";

"discovery.card.fajr_sunnah.title" = "The two rak‘ahs of Fajr";
"discovery.card.fajr_sunnah.meaning" = "The Prophet ﷺ said: “The two rak‘ahs of Fajr are better than this world and all that is in it.”";
"discovery.card.fajr_sunnah.source" = "Sahih Muslim 725";

"discovery.card.haya.title" = "Modesty is from faith";
"discovery.card.haya.meaning" = "The Prophet ﷺ said: “Modesty is a branch of faith.”";
"discovery.card.haya.source" = "Sahih al-Bukhari 9 · Sahih Muslim 35";

"discovery.card.no_burden.title" = "Allah does not burden a soul";
"discovery.card.no_burden.meaning" = "Allah says: “Allah does not burden a soul beyond its capacity.”";
"discovery.card.no_burden.source" = "Qur’an 2:286";

"discovery.card.mankind.title" = "The most noble is the most God-fearing";
"discovery.card.mankind.meaning" = "Allah says: “O mankind, We created you from a male and a female and made you peoples and tribes so that you may know one another. The most noble of you with Allah is the most God-fearing.”";
"discovery.card.mankind.source" = "Qur’an 49:13";

