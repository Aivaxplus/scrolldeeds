/* Discovery feed expansion */
"discovery.card.shukr.title" = "Если будете благодарны — Я умножу";
"discovery.card.shukr.meaning" = "Аллах говорит: «Если вы будете благодарны, Я непременно умножу вам; а если будете неблагодарны, то мучение Моё сурово».";
"discovery.card.shukr.source" = "Коран 14:7";

"discovery.card.dua_near.title" = "Я близок";
"discovery.card.dua_near.meaning" = "Аллах говорит: «Когда спрашивают тебя рабы Мои обо Мне, то ведь Я близок. Я отвечаю на зов зовущего, когда он взывает ко Мне».";
"discovery.card.dua_near.source" = "Коран 2:186";

"discovery.card.no_despair.title" = "Не отчаивайтесь в милости Аллаха";
"discovery.card.no_despair.meaning" = "Аллах говорит: «Скажи: О рабы Мои, которые преступили против самих себя, не отчаивайтесь в милости Аллаха. Поистине, Аллах прощает все грехи».";
"discovery.card.no_despair.source" = "Коран 39:53";

"discovery.card.qadr.title" = "Ночь предопределения";
"discovery.card.qadr.meaning" = "Аллах говорит: «Ночь предопределения лучше тысячи месяцев».";
"discovery.card.qadr.source" = "Коран 97:3";

"discovery.card.duha_care.title" = "Господь твой не оставил тебя";
"discovery.card.duha_care.meaning" = "Аллах говорит: «Не покинул тебя Господь твой и не возненавидел. Последнее лучше для тебя, чем первое. Господь твой дарует тебе, и ты будешь доволен».";
"discovery.card.duha_care.source" = "Коран 93:3–5";

"discovery.card.asr.title" = "Клянусь временем: человек в убытке";
"discovery.card.asr.meaning" = "Аллах говорит: «Клянусь временем! Поистине, человек в убытке — кроме тех, которые уверовали, совершали праведные дела и заповедали друг другу истину и терпение».";
"discovery.card.asr.source" = "Коран 103:1–3";

"discovery.card.kawthar.title" = "Мы даровали тебе аль-Кавсар";
"discovery.card.kawthar.meaning" = "Аллах говорит: «Поистине, Мы даровали тебе Изобилие. Так молись Господу твоему и закалывай».";
"discovery.card.kawthar.source" = "Коран 108:1–2";

"discovery.card.no_compulsion.title" = "Нет принуждения в религии";
"discovery.card.no_compulsion.meaning" = "Аллах говорит: «Нет принуждения в религии. Прямой путь уже отличился от заблуждения».";
"discovery.card.no_compulsion.source" = "Коран 2:256";

"discovery.card.with_you.title" = "Он с вами, где бы вы ни были";
"discovery.card.with_you.meaning" = "Аллах говорит: «Он с вами, где бы вы ни были. Аллах видит то, что вы совершаете».";
"discovery.card.with_you.source" = "Коран 57:4";

"discovery.card.closer.title" = "Ближе яремной вены";
"discovery.card.closer.meaning" = "Аллах говорит: «Мы создали человека и знаем, что нашептывает ему душа, и Мы ближе к нему, чем яремная вена».";
"discovery.card.closer.source" = "Коран 50:16";

"discovery.card.spouses.title" = "Любовь и милость между вами";
"discovery.card.spouses.meaning" = "Аллах говорит: «Он создал вам из вас самих супруг, чтобы вы находили в них покой, и установил между вами любовь и милость».";
"discovery.card.spouses.source" = "Коран 30:21";

"discovery.card.blessings_count.title" = "Милости Аллаха не исчислить";
"discovery.card.blessings_count.meaning" = "Аллах говорит: «Если вы будете считать милость Аллаха, то не исчислите её. Поистине, Аллах — Прощающий, Милосердный».";
"discovery.card.blessings_count.source" = "Коран 16:18";

"discovery.card.fasting_prescribed.title" = "Вам предписан пост";
"discovery.card.fasting_prescribed.meaning" = "Аллах говорит: «О те, которые уверовали! Вам предписан пост, подобно тому как он был предписан тем, кто был до вас, — быть может, вы станете богобоязненны».";
"discovery.card.fasting_prescribed.source" = "Коран 2:183";

"discovery.card.yunus_dua.title" = "Нет бога, кроме Тебя";
"discovery.card.yunus_dua.meaning" = "Аллах говорит, что Юнус воззвал во мраке: «Нет бога, кроме Тебя! Пречист Ты! Воистину, я был одним из беззаконников».";
"discovery.card.yunus_dua.source" = "Коран 21:87";

"discovery.card.hasbuna.title" = "Довольно нам Аллаха";
"discovery.card.hasbuna.meaning" = "Аллах говорит, что те, чья вера усилилась, сказали: «Довольно нам Аллаха, и прекрасный Он Покровитель».";
"discovery.card.hasbuna.source" = "Коран 3:173";

"discovery.card.rabbana_atina.title" = "Благо в этом мире и в Последней жизни";
"discovery.card.rabbana_atina.meaning" = "Аллах говорит: «Господь наш! Даруй нам добро в этом мире и добро в Последней жизни и защити нас от мучений Огня».";
"discovery.card.rabbana_atina.source" = "Коран 2:201";

"discovery.card.be_and_it_is.title" = "Будь! — и оно бывает";
"discovery.card.be_and_it_is.meaning" = "Аллах говорит: «Его повеление, когда Он желает чего-либо, — только сказать ему: “Будь!” — и оно бывает».";
"discovery.card.be_and_it_is.source" = "Коран 36:82";

"discovery.card.which_favors.title" = "Какие блага Господа вы сочтёте ложью?";
"discovery.card.which_favors.meaning" = "Аллах говорит: «Какие же из милостей Господа вашего вы сочтёте ложью?»";
"discovery.card.which_favors.source" = "Коран 55:13";

"discovery.card.calamity.title" = "Беда — лишь с дозволения Аллаха";
"discovery.card.calamity.meaning" = "Аллах говорит: «Не постигает никакая беда, кроме как с дозволения Аллаха. Кто уверовал в Аллаха, того Он ведёт прямым путём».";
"discovery.card.calamity.source" = "Коран 64:11";

"discovery.card.death_life.title" = "Он создал смерть и жизнь";
"discovery.card.death_life.meaning" = "Аллах говорит: «Который создал смерть и жизнь, чтобы испытать вас, кто из вас лучше по деяниям. Он — Могущественный, Прощающий».";
"discovery.card.death_life.source" = "Коран 67:2";

"discovery.card.kafirun.title" = "Вам — ваша религия, мне — моя";
"discovery.card.kafirun.meaning" = "Аллах говорит: «Вам — ваша религия, а мне — моя религия».";
"discovery.card.kafirun.source" = "Коран 109:6";

"discovery.card.nas.title" = "Ищу защиты у Господа людей";
"discovery.card.nas.meaning" = "Аллах говорит: «Скажи: “Прибегаю к защите Господа людей, Царя людей, Бога людей”».";
"discovery.card.nas.source" = "Коран 114:1–3";

"discovery.card.falaq.title" = "Ищу защиты у Господа рассвета";
"discovery.card.falaq.meaning" = "Аллах говорит: «Скажи: “Прибегаю к защите Господа рассвета от зла того, что Он сотворил”».";
"discovery.card.falaq.source" = "Коран 113:1–2";

"discovery.card.orphans_duha.title" = "Не притесняй сироту";
"discovery.card.orphans_duha.meaning" = "Аллах говорит: «А сироту не притесняй. А просящего не отгоняй. А о милости Господа твоего возвещай».";
"discovery.card.orphans_duha.source" = "Коран 93:9–11";

"discovery.card.justice.title" = "Будьте стойки в справедливости";
"discovery.card.justice.meaning" = "Аллах говорит: «О те, которые уверовали! Будьте стойки в справедливости, свидетелями перед Аллахом, даже если против вас самих, родителей и родственников».";
"discovery.card.justice.source" = "Коран 4:135";

"discovery.card.amanah.title" = "Возвращайте вверенное хозяевам";
"discovery.card.amanah.meaning" = "Аллах говорит: «Аллах велит вам возвращать вверенное имущество его владельцам и, когда вы судите между людьми, судить по справедливости».";
"discovery.card.amanah.source" = "Коран 4:58";

"discovery.card.luqman_salah.title" = "Выстаивай молитву, сын мой";
"discovery.card.luqman_salah.meaning" = "Лукман сказал: «О сын мой! Выстаивай молитву, побуждай к одобряемому, удерживай от предосудительного и терпи то, что тебя постигает».";
"discovery.card.luqman_salah.source" = "Коран 31:17";

"discovery.card.infaq_grain.title" = "Притча о расходовании";
"discovery.card.infaq_grain.meaning" = "Аллах говорит: «Притча о тех, кто расходует своё имущество на пути Аллаха, — как зерно, из которого выросло семь колосьев, а в каждом колосе — сто зёрен. Аллах удваивает, кому пожелает».";
"discovery.card.infaq_grain.source" = "Коран 2:261";

"discovery.card.rabbana_forgive.title" = "Не взыщи с нас, если мы позабыли";
"discovery.card.rabbana_forgive.meaning" = "Аллах говорит: «Господь наш! Не наказывай нас, если мы позабыли или ошиблись. Господь наш! Не возлагай на нас бремя, которое Ты возложил на тех, кто был до нас».";
"discovery.card.rabbana_forgive.source" = "Коран 2:286";

"discovery.card.establish_salah.title" = "Выстаивайте молитву и выплачивайте закят";
"discovery.card.establish_salah.meaning" = "Аллах говорит: «Выстаивайте молитву, выплачивайте закят и кланяйтесь вместе с кланяющимися».";
"discovery.card.establish_salah.source" = "Коран 2:43";

"discovery.card.way_out.title" = "Кто богобоязнен — Аллах даст выход";
"discovery.card.way_out.meaning" = "Аллах говорит: «Кто боится Аллаха, тому Он даст выход и наделит его удел оттуда, откуда он не ожидает».";
"discovery.card.way_out.source" = "Коран 65:2–3";

"discovery.card.sincere_deen.title" = "Поклоняться Аллаху, искренне исповедуя религию";
"discovery.card.sincere_deen.meaning" = "Аллах говорит: «А ведь им было велено лишь поклоняться Аллаху, искренне исповедуя религию, как ханифы, выстаивать молитву и выплачивать закят».";
"discovery.card.sincere_deen.source" = "Коран 98:5";

"discovery.card.allah_light.title" = "Аллах — Свет небес и земли";
"discovery.card.allah_light.meaning" = "Аллах говорит: «Аллах — Свет небес и земли».";
"discovery.card.allah_light.source" = "Коран 24:35";

"discovery.card.expand_chest.title" = "Разве Мы не раскрыли тебе грудь?";
"discovery.card.expand_chest.meaning" = "Аллах говорит: «Разве Мы не раскрыли для тебя твою грудь и не сняли с тебя твою ношу, которая отягощала твою спину, и не возвысили упоминание о тебе?»";
"discovery.card.expand_chest.source" = "Коран 94:1–4";

"discovery.card.hikmah.title" = "Он дарует мудрость, кому пожелает";
"discovery.card.hikmah.meaning" = "Аллах говорит: «Он дарует мудрость, кому пожелает, а кому дарована мудрость, тому даровано великое благо».";
"discovery.card.hikmah.source" = "Коран 2:269";

"discovery.card.five_pillars.title" = "Ислам построен на пяти";
"discovery.card.five_pillars.meaning" = "Пророк ﷺ сказал: «Ислам построен на пяти: свидетельстве, что нет бога, кроме Аллаха, и что Мухаммад — Посланник Аллаха, выстаивании молитвы, выплате закята, хадже и посте в Рамадан».";
"discovery.card.five_pillars.source" = "Sahih al-Bukhari 8 · Sahih Muslim 16";

"discovery.card.muslim_tongue.title" = "В безопасности от его языка и руки";
"discovery.card.muslim_tongue.meaning" = "Пророк ﷺ сказал: «Мусульманин — тот, от языка и руки которого мусульмане находятся в безопасности».";
"discovery.card.muslim_tongue.source" = "Sahih al-Bukhari 10 · Sahih Muslim 41";

"discovery.card.deen_nasihah.title" = "Религия — это искренний совет";
"discovery.card.deen_nasihah.meaning" = "Пророк ﷺ сказал: «Религия — это насиха (искренний совет)». Спросили: Кому? Он сказал: «Аллаху, Его Книге, Его Посланнику, предводителям мусульман и их простым людям».";
"discovery.card.deen_nasihah.source" = "Sahih Muslim 55";

"discovery.card.best_quran.title" = "Лучшие из вас учат Коран и обучают ему";
"discovery.card.best_quran.meaning" = "Пророк ﷺ сказал: «Лучшие из вас — те, кто изучает Коран и обучает ему».";
"discovery.card.best_quran.source" = "Sahih al-Bukhari 5027";

"discovery.card.mother_first.title" = "Твоя мать, потом снова мать";
"discovery.card.mother_first.meaning" = "Человек спросил: Кто более всего достоин моего хорошего общения? Пророк ﷺ сказал: «Твоя мать». Он сказал: Потом кто? Он сказал: «Твоя мать». Он сказал: Потом кто? Он сказал: «Твоя мать». Он сказал: Потом кто? Он сказал: «Твой отец».";
"discovery.card.mother_first.source" = "Sahih al-Bukhari 5971 · Sahih Muslim 2548";

"discovery.card.plant_tree.title" = "Посаженное дерево — это садака";
"discovery.card.plant_tree.meaning" = "Пророк ﷺ сказал: «Не бывает так, чтобы мусульманин посадил дерево или посеял посев, и птица, человек или животное поели от этого, кроме как это станет для него садакой».";
"discovery.card.plant_tree.source" = "Sahih Muslim 1553";

"discovery.card.seven_shade.title" = "Семеро в тени Аллаха";
"discovery.card.seven_shade.meaning" = "Пророк ﷺ сказал: «Семерых укроет Аллах Своей тенью в День, когда не будет иной тени, кроме Его: справедливый правитель; юноша, выросший в поклонении Аллаху; человек, чьё сердце привязано к мечети; двое, любящие друг друга ради Аллаха; человек, которого позвала женщина знатная и красивая, а он сказал: “Я боюсь Аллаха”; тот, кто даёт садаку так тайно, что левая рука не знает, что тратит правая; и тот, кто поминает Аллаха наедине, и глаза его наполняются слезами».";
"discovery.card.seven_shade.source" = "Sahih al-Bukhari 1423 · Sahih Muslim 1031";

"discovery.card.tasbih_salah.title" = "После молитвы: 33, 33, 34";
"discovery.card.tasbih_salah.meaning" = "Пророк ﷺ научил после намаза: Субхан Аллах тридцать три раза, аль-хамду ли-Ллях тридцать три, и Аллаху акбар тридцать четыре.";
"discovery.card.tasbih_salah.source" = "Sahih Muslim 596";

"discovery.card.hundred_tasbih.title" = "Сто раз в день";
"discovery.card.hundred_tasbih.meaning" = "Пророк ﷺ сказал: «Кто скажет “Пречист Аллах и хвала Ему” сто раз в день, тому простятся грехи, даже если они подобны пене моря».";
"discovery.card.hundred_tasbih.source" = "Sahih al-Bukhari 6405 · Sahih Muslim 2691";

"discovery.card.enter_masjid.title" = "Когда входишь в мечеть";
"discovery.card.enter_masjid.meaning" = "Пророк ﷺ сказал: когда кто-то из вас входит в мечеть, пусть скажет: «О Аллах, открой мне врата Твоей милости».";
"discovery.card.enter_masjid.source" = "Sahih Muslim 713";

"discovery.card.do_not_anger.title" = "Не гневайся";
"discovery.card.do_not_anger.meaning" = "Человек сказал Пророку ﷺ: Посоветуй мне. Он сказал: «Не гневайся». Тот повторил просьбу несколько раз, и он сказал: «Не гневайся».";
"discovery.card.do_not_anger.source" = "Sahih al-Bukhari 6116";

"discovery.card.make_easy.title" = "Облегчайте, а не затрудняйте";
"discovery.card.make_easy.meaning" = "Пророк ﷺ сказал: «Облегчайте и не затрудняйте. Радуйте и не отталкивайте».";
"discovery.card.make_easy.source" = "Sahih al-Bukhari 69";

"discovery.card.religion_ease.title" = "Религия — лёгкость";
"discovery.card.religion_ease.meaning" = "Пророк ﷺ сказал: «Поистине, религия легка. И никто не будет чрезмерен в религии, кроме как она одолеет его. Так будьте умеренны, старайтесь, радуйтесь и обращайтесь за помощью утром, после полудня и немного ночью».";
"discovery.card.religion_ease.source" = "Sahih al-Bukhari 39";

"discovery.card.feed_hungry.title" = "Кормите голодного";
"discovery.card.feed_hungry.meaning" = "Пророк ﷺ сказал: «Кормите голодного, навещайте больного и освобождайте пленника».";
"discovery.card.feed_hungry.source" = "Sahih al-Bukhari 5373";

"discovery.card.good_word.title" = "Доброе слово — это садака";
"discovery.card.good_word.meaning" = "Пророк ﷺ сказал: «Доброе слово — это садака».";
"discovery.card.good_word.source" = "Sahih al-Bukhari 2989 · Sahih Muslim 1009";

"discovery.card.no_cheating.title" = "Кто обманывает — не из нас";
"discovery.card.no_cheating.meaning" = "Пророк ﷺ сказал: «Кто обманывает нас, тот не из нас».";
"discovery.card.no_cheating.source" = "Sahih Muslim 102";

"discovery.card.sleep_muawwidhat.title" = "Читай последние три суры перед сном";
"discovery.card.sleep_muawwidhat.meaning" = "Аиша передала, что когда Пророк ﷺ ложился спать, он складывал ладони, дул в них, читал суры «аль-Ихлас», «аль-Фаляк» и «ан-Нас», затем проводил руками по телу.";
"discovery.card.sleep_muawwidhat.source" = "Sahih al-Bukhari 5017";

"discovery.card.treat_women.title" = "Бойтесь Аллаха относительно женщин";
"discovery.card.treat_women.meaning" = "Пророк ﷺ сказал в Прощальной хутбе: «Бойтесь Аллаха относительно женщин, ибо вы взяли их как доверенное от Аллаха, и близость с ними стала дозволенной вам словом Аллаха».";
"discovery.card.treat_women.source" = "Sahih Muslim 1218";

"discovery.card.wudu_sins.title" = "Омовение смывает грехи";
"discovery.card.wudu_sins.meaning" = "Пророк ﷺ сказал: когда мусульманин — или верующий — совершает омовение и моет лицо, с водой уходит всякий грех, на который он смотрел глазами, или с последней каплей; когда моет руки — уходят грехи рук; когда моет ноги — уходят грехи, к которым ходили его ноги, — пока он не выйдет очищенным от греха.";
"discovery.card.wudu_sins.source" = "Sahih Muslim 244";

/* BEGIN DISCOVERY EXPANSION */
"discovery.card.ayah_1_1.title" = "Al-Faatiha 1";
"discovery.card.ayah_1_1.meaning" = "Во имя Аллаха, Милостивого, Милосердного!";
"discovery.card.ayah_1_1.source" = "Qur’an 1:1";

"discovery.card.ayah_1_4.title" = "Al-Faatiha 4";
"discovery.card.ayah_1_4.meaning" = "Властелину Дня воздаяния!";
"discovery.card.ayah_1_4.source" = "Qur’an 1:4";

"discovery.card.ayah_1_5.title" = "Al-Faatiha 5";
"discovery.card.ayah_1_5.meaning" = "Тебе одному мы поклоняемся и Тебя одного молим о помощи.";
"discovery.card.ayah_1_5.source" = "Qur’an 1:5";

"discovery.card.ayah_1_6.title" = "Al-Faatiha 6";
"discovery.card.ayah_1_6.meaning" = "Веди нас прямым путем,";
"discovery.card.ayah_1_6.source" = "Qur’an 1:6";

"discovery.card.ayah_1_7.title" = "Al-Faatiha 7";
"discovery.card.ayah_1_7.meaning" = "путем тех, кого Ты облагодетельствовал, не тех, на кого пал гнев, и не заблудших.";
"discovery.card.ayah_1_7.source" = "Qur’an 1:7";

"discovery.card.ayah_2_2.title" = "Al-Baqara 2";
"discovery.card.ayah_2_2.meaning" = "Это Писание, в котором нет сомнения, является верным руководством для богобоязненных,";
"discovery.card.ayah_2_2.source" = "Qur’an 2:2";

"discovery.card.ayah_2_21.title" = "Al-Baqara 21";
"discovery.card.ayah_2_21.meaning" = "О люди! Поклоняйтесь вашему Господу, Который сотворил вас и тех, кто был до вас, - быть может, вы устрашитесь.";
"discovery.card.ayah_2_21.source" = "Qur’an 2:21";

"discovery.card.ayah_2_45.title" = "Al-Baqara 45";
"discovery.card.ayah_2_45.meaning" = "Обратитесь за помощью к терпению и намазу. Воистину, намаз является тяжким бременем для всех, кроме смиренных,";
"discovery.card.ayah_2_45.source" = "Qur’an 2:45";

"discovery.card.ayah_2_155.title" = "Al-Baqara 155";
"discovery.card.ayah_2_155.meaning" = "Мы непременно испытаем вас незначительным страхом, голодом, потерей имущества, людей и плодов. Обрадуй же терпеливых,";
"discovery.card.ayah_2_155.source" = "Qur’an 2:155";

"discovery.card.ayah_2_165.title" = "Al-Baqara 165";
"discovery.card.ayah_2_165.meaning" = "Среди людей есть такие, которые приобщают к Аллаху равных и любят их так же, как любят Аллаха. Но те, которые уверовали, любят Аллаха сильнее. Если бы беззаконники, узрев мучения, увидели, что могущество целиком принадлежит Аллаху и что Аллах причиняет тяжкие мучения.";
"discovery.card.ayah_2_165.source" = "Qur’an 2:165";

"discovery.card.ayah_2_177.title" = "Al-Baqara 177";
"discovery.card.ayah_2_177.meaning" = "Благочестие состоит не в том, чтобы вы обращали ваши лица на восток и запад. Но благочестив тот, кто уверовал в Аллаха, в Последний день, в ангелов, в Писание, в пророков, кто раздавал имущество, несмотря на свою любовь к нему, родственникам, сиротам, бедным, путникам и просящим, расходовал его на освобождение рабов, совершал намаз, выплачивал закят, соблюдал договора после их заключения, проявлял терпение в нужде, при болезни и во время сражения. Таковы те, которые правдивы. Таковы богобоязненные.";
"discovery.card.ayah_2_177.source" = "Qur’an 2:177";

"discovery.card.ayah_2_185.title" = "Al-Baqara 185";
"discovery.card.ayah_2_185.meaning" = "В месяц рамадан был ниспослан Коран - верное руководство для людей, ясные доказательства из верного руководства и различение. Тот из вас, кого застанет этот месяц, должен поститься. А если кто болен или находится в пути, то пусть постится столько же дней в другое время. Аллах желает вам облегчения и не желает вам затруднения. Он желает, чтобы вы довели до конца определенное число дней и возвеличили Аллаха за то, что Он наставил вас на прямой путь. Быть может, вы будете благодарны.";
"discovery.card.ayah_2_185.source" = "Qur’an 2:185";

"discovery.card.ayah_2_197.title" = "Al-Baqara 197";
"discovery.card.ayah_2_197.meaning" = "Хадж совершается в известные месяцы. Кто намеревается совершить хадж в эти месяцы, тот не должен вступать в половую близость, совершать грехи и вступать в споры во время хаджа. Что бы вы ни сделали доброго, Аллах знает об этом. Берите с собой припасы, но лучшим припасом является богобоязненность. Бойтесь же Меня, о обладающие разумом!";
"discovery.card.ayah_2_197.source" = "Qur’an 2:197";

"discovery.card.ayah_2_208.title" = "Al-Baqara 208";
"discovery.card.ayah_2_208.meaning" = "О те, которые уверовали! Принимайте ислам целиком и не следуйте по стопам дьявола. Воистину, он для вас - явный враг.";
"discovery.card.ayah_2_208.source" = "Qur’an 2:208";

"discovery.card.ayah_2_216.title" = "Al-Baqara 216";
"discovery.card.ayah_2_216.meaning" = "Вам предписано сражаться, хотя это вам неприятно. Быть может, вам неприятно то, что является благом для вас. И быть может, вы любите то, что является злом для вас. Аллах знает, а вы не знаете.";
"discovery.card.ayah_2_216.source" = "Qur’an 2:216";

"discovery.card.ayah_2_245.title" = "Al-Baqara 245";
"discovery.card.ayah_2_245.meaning" = "Если кто-либо одолжит Аллаху прекрасный заем, то Он увеличит его многократно. Аллах удерживает и щедро одаряет, и к Нему вы будете возвращены.";
"discovery.card.ayah_2_245.source" = "Qur’an 2:245";

"discovery.card.ayah_2_254.title" = "Al-Baqara 254";
"discovery.card.ayah_2_254.meaning" = "О те, которые уверовали! Делайте пожертвования из того, чем Мы наделили вас, до наступления дня, когда не будет ни торговли, ни дружбы, ни заступничества. А неверующие являются беззаконниками.";
"discovery.card.ayah_2_254.source" = "Qur’an 2:254";

"discovery.card.ayah_2_267.title" = "Al-Baqara 267";
"discovery.card.ayah_2_267.meaning" = "О те, которые уверовали! Делайте пожертвования из приобретенных вами благ и того, что Мы взрастили для вас на земле, и не стремитесь раздать в качестве пожертвования дурное, чего бы вы сами не взяли, пока не зажмурили глаза. И знайте, что Аллах - Богатый, Достохвальный.";
"discovery.card.ayah_2_267.source" = "Qur’an 2:267";

"discovery.card.ayah_2_285.title" = "Al-Baqara 285";
"discovery.card.ayah_2_285.meaning" = "Посланник и верующие уверовали в то, что ниспослано ему от Господа. Все они уверовали в Аллаха, Его ангелов, Его Писания и Его посланников. Они говорят: «Мы не делаем различий между Его посланниками». Они говорят: «Слушаем и повинуемся! Твоего прощения мы просим, Господь наш, и к Тебе предстоит прибытие».";
"discovery.card.ayah_2_285.source" = "Qur’an 2:285";

"discovery.card.ayah_3_8.title" = "Aal-i-Imraan 8";
"discovery.card.ayah_3_8.meaning" = "Господь наш! Не уклоняй наши сердца в сторону после того, как Ты наставил нас на прямой путь, и даруй нам милость от Себя, ведь Ты - Дарующий!";
"discovery.card.ayah_3_8.source" = "Qur’an 3:8";

"discovery.card.ayah_3_26.title" = "Aal-i-Imraan 26";
"discovery.card.ayah_3_26.meaning" = "Скажи: «О Аллах, Владыка царства! Ты даруешь власть, кому пожелаешь, и отнимаешь власть, у кого пожелаешь. Ты возвеличиваешь, кого пожелаешь, и унижаешь, кого пожелаешь. Все благо - в Твоей Руке. Воистину, Ты способен на всякую вещь.";
"discovery.card.ayah_3_26.source" = "Qur’an 3:26";

"discovery.card.ayah_3_31.title" = "Aal-i-Imraan 31";
"discovery.card.ayah_3_31.meaning" = "Скажи: «Если вы любите Аллаха, то следуйте за мной, и тогда Аллах возлюбит вас и простит вам ваши грехи, ведь Аллах - Прощающий, Милосердный».";
"discovery.card.ayah_3_31.source" = "Qur’an 3:31";

"discovery.card.ayah_3_92.title" = "Aal-i-Imraan 92";
"discovery.card.ayah_3_92.meaning" = "Вы не обретете благочестия, пока не будете расходовать из того, что вы любите, и что бы вы ни расходовали, Аллах ведает об этом.";
"discovery.card.ayah_3_92.source" = "Qur’an 3:92";

"discovery.card.ayah_3_102.title" = "Aal-i-Imraan 102";
"discovery.card.ayah_3_102.meaning" = "О те, которые уверовали! Бойтесь Аллаха должным образом и умирайте не иначе, как будучи мусульманами!";
"discovery.card.ayah_3_102.source" = "Qur’an 3:102";

"discovery.card.ayah_3_103.title" = "Aal-i-Imraan 103";
"discovery.card.ayah_3_103.meaning" = "Крепко держитесь за вервь Аллаха все вместе и не разделяйтесь. Помните о милости, которую Аллах оказал вам, когда вы были врагами, а Он сплотил ваши сердца, и по Его милости вы стали братьями. Вы были на краю Огненной пропасти, и Он спас вас от нее. Так Аллах разъясняет вам Свои знамения, - быть может, вы последуете прямым путем.";
"discovery.card.ayah_3_103.source" = "Qur’an 3:103";

"discovery.card.ayah_3_110.title" = "Aal-i-Imraan 110";
"discovery.card.ayah_3_110.meaning" = "Вы являетесь лучшей из общин, появившейся на благо человечества, повелевая совершать одобряемое, удерживая от предосудительного и веруя в Аллаха. Если бы люди Писания уверовали, то это было бы лучше для них. Среди них есть верующие, но большинство из них - нечестивцы.";
"discovery.card.ayah_3_110.source" = "Qur’an 3:110";

"discovery.card.ayah_3_133.title" = "Aal-i-Imraan 133";
"discovery.card.ayah_3_133.meaning" = "Стремитесь к прощению вашего Господа и Раю, ширина которого равна небесам и земле, уготованному для богобоязненных,";
"discovery.card.ayah_3_133.source" = "Qur’an 3:133";

"discovery.card.ayah_3_139.title" = "Aal-i-Imraan 139";
"discovery.card.ayah_3_139.meaning" = "Не слабейте и не печальтесь, в то время как вы будете на высоте, если вы действительно являетесь верующими.";
"discovery.card.ayah_3_139.source" = "Qur’an 3:139";

"discovery.card.ayah_3_159.title" = "Aal-i-Imraan 159";
"discovery.card.ayah_3_159.meaning" = "По милости Аллаха ты был мягок по отношению к ним. А ведь если бы ты был грубым и жестокосердным, то они непременно покинули бы тебя. Прости же их, попроси для них прощения и советуйся с ними о делах. Когда же ты примешь решение, то уповай на Аллаха, ведь Аллах любит уповающих.";
"discovery.card.ayah_3_159.source" = "Qur’an 3:159";

"discovery.card.ayah_3_185.title" = "Aal-i-Imraan 185";
"discovery.card.ayah_3_185.meaning" = "Каждая душа вкусит смерть, но только в День воскресения вы получите вашу плату сполна. Кто будет удален от Огня и введен в Рай, тот обретет успех, а земная жизнь - всего лишь наслаждение обольщением.";
"discovery.card.ayah_3_185.source" = "Qur’an 3:185";

"discovery.card.ayah_3_190.title" = "Aal-i-Imraan 190";
"discovery.card.ayah_3_190.meaning" = "Воистину, в сотворении небес и земли, а также в смене ночи и дня заключены знамения для обладающих разумом,";
"discovery.card.ayah_3_190.source" = "Qur’an 3:190";

"discovery.card.ayah_3_200.title" = "Aal-i-Imraan 200";
"discovery.card.ayah_3_200.meaning" = "О те, которые уверовали! Будьте терпеливы, запасайтесь терпением, несите службу на заставах и бойтесь Аллаха, - быть может, вы преуспеете.";
"discovery.card.ayah_3_200.source" = "Qur’an 3:200";

"discovery.card.ayah_4_1.title" = "An-Nisaa 1";
"discovery.card.ayah_4_1.meaning" = "О люди! Бойтесь вашего Господа, Который сотворил вас из одного человека, сотворил из него пару ему и расселил много мужчин и женщин, произошедших от них обоих. Бойтесь Аллаха, именем Которого вы просите друг друга, и бойтесь разрывать родственные связи. Воистину, Аллах наблюдает за вами.";
"discovery.card.ayah_4_1.source" = "Qur’an 4:1";

"discovery.card.ayah_4_29.title" = "An-Nisaa 29";
"discovery.card.ayah_4_29.meaning" = "О те, которые уверовали! Не пожирайте своего имущества между собой незаконно, а только путем торговли по обоюдному вашему согласию. Не убивайте самих себя (друг друга), ведь Аллах милостив к вам.";
"discovery.card.ayah_4_29.source" = "Qur’an 4:29";

"discovery.card.ayah_4_36.title" = "An-Nisaa 36";
"discovery.card.ayah_4_36.meaning" = "Поклоняйтесь Аллаху и не приобщайте к Нему сотоварищей. Делайте добро родителям, родственникам, сиротам, беднякам, соседям из числа ваших родственников и соседям, которые не являются вашими родственниками, находящимся рядом спутникам, странникам и невольникам, которыми овладели ваши десницы. Воистину, Аллах не любит гордецов и бахвалов,";
"discovery.card.ayah_4_36.source" = "Qur’an 4:36";

"discovery.card.ayah_4_40.title" = "An-Nisaa 40";
"discovery.card.ayah_4_40.meaning" = "Аллах не совершает несправедливости даже весом в мельчайшую частицу, а если поступок окажется благим, то Он приумножит его и одарит от Себя великой наградой.";
"discovery.card.ayah_4_40.source" = "Qur’an 4:40";

"discovery.card.ayah_4_59.title" = "An-Nisaa 59";
"discovery.card.ayah_4_59.meaning" = "О те, которые уверовали! Повинуйтесь Аллаху, повинуйтесь Посланнику и обладающим влиянием среди вас. Если же вы станете препираться о чем-нибудь, то обратитесь с этим к Аллаху и Посланнику, если вы веруете в Аллаха и Последний день. Так будет лучше и прекраснее по значению (или по исходу; или по вознаграждению)!";
"discovery.card.ayah_4_59.source" = "Qur’an 4:59";

"discovery.card.ayah_4_69.title" = "An-Nisaa 69";
"discovery.card.ayah_4_69.meaning" = "Те, которые повинуются Аллаху и Посланнику, окажутся вместе с пророками, правдивыми мужами, павшими мучениками и праведниками, которых облагодетельствовал Аллах. Как же прекрасны эти спутники!";
"discovery.card.ayah_4_69.source" = "Qur’an 4:69";

"discovery.card.ayah_4_86.title" = "An-Nisaa 86";
"discovery.card.ayah_4_86.meaning" = "Когда вас приветствуют, отвечайте еще лучшим приветствием или тем же самым. Воистину, Аллах подсчитывает всякую вещь.";
"discovery.card.ayah_4_86.source" = "Qur’an 4:86";

"discovery.card.ayah_4_103.title" = "An-Nisaa 103";
"discovery.card.ayah_4_103.meaning" = "Когда вы завершите намаз, то поминайте Аллаха стоя, сидя или лежа на боках. Когда же вы окажетесь в безопасности, то совершайте намаз. Воистину, намаз предписан верующим в определенное время.";
"discovery.card.ayah_4_103.source" = "Qur’an 4:103";

"discovery.card.ayah_4_174.title" = "An-Nisaa 174";
"discovery.card.ayah_4_174.meaning" = "О люди! К вам уже явилось доказательство от вашего Господа, и Мы ниспослали вам ясный свет.";
"discovery.card.ayah_4_174.source" = "Qur’an 4:174";

"discovery.card.ayah_5_2.title" = "Al-Maaida 2";
"discovery.card.ayah_5_2.meaning" = "О те, которые уверовали! Не нарушайте святость обрядовых знамений Аллаха и запретного месяца. Не считайте дозволенным покушаться на жертвенных животных, или животных (или людей) с ожерельями, или людей, которые приходят к Заповедному дому, стремясь к милости и довольству своего Господа. Когда же вы освободитесь от ихрама, то можете охотиться. И пусть ненависть людей, которые помешали вам пройти к Заповедной мечети, не подтолкнет вас на преступление. Помогайте друг другу в благочестии и богобоязненности, но не помогайте друг другу в грехе и посягательстве. Бойтесь Аллаха, ведь Аллах суров в наказании.";
"discovery.card.ayah_5_2.source" = "Qur’an 5:2";

"discovery.card.ayah_5_3.title" = "Al-Maaida 3";
"discovery.card.ayah_5_3.meaning" = "Вам запрещены мертвечина, кровь, мясо свиньи и то, над чем не было произнесено имя Аллаха (или что было зарезано не ради Аллаха), или было задушено, или забито до смерти, или подохло при падении, или заколото рогами или задрано хищником, если только вы не успеете зарезать его, и то, что зарезано на каменных жертвенниках (или для идолов), а также гадание по стрелам. Все это есть нечестие. Сегодня неверующие отчаялись в вашей религии. Не бойтесь же их, а бойтесь Меня. Сегодня Я ради вас усовершенствовал вашу религию, довел до конца Мою милость к вам и одобрил для вас в качестве религии ислам. Если же кто-либо будет вынужден пойти на это (на употребление запрещенных продуктов) от голода, а не из склонности к греху, то ведь Аллах - Прощающий, Милосердный.";
"discovery.card.ayah_5_3.source" = "Qur’an 5:3";

"discovery.card.ayah_5_6.title" = "Al-Maaida 6";
"discovery.card.ayah_5_6.meaning" = "О те, которые уверовали! Когда вы встаете на намаз, то умойте ваши лица и ваши руки до локтей, оботрите ваши головы и умойте ваши ноги до щиколоток. А если вы находитесь в половом осквернении, то очиститесь. Если же вы больны или находитесь в путешествии, если кто-либо из вас пришел из уборной или если вы имели близость с женщинами, и вы не нашли воды, то направьтесь к чистой земле и оботрите ею ваши лица и руки. Аллах не хочет создавать для вас трудности, а хочет очистить вас и довести до конца Свою милость по отношению к вам, - быть может, вы будете благодарны.";
"discovery.card.ayah_5_6.source" = "Qur’an 5:6";

"discovery.card.ayah_5_8.title" = "Al-Maaida 8";
"discovery.card.ayah_5_8.meaning" = "О те, которые уверовали! Будьте стойки ради Аллаха, свидетельствуя беспристрастно, и пусть ненависть людей не подтолкнет вас к несправедливости. Будьте справедливы, ибо это ближе к богобоязненности. Бойтесь Аллаха, ведь Аллах ведает о том, что вы совершаете.";
"discovery.card.ayah_5_8.source" = "Qur’an 5:8";

"discovery.card.ayah_5_32.title" = "Al-Maaida 32";
"discovery.card.ayah_5_32.meaning" = "По этой причине Мы предписали сынам Исраила (Израиля): кто убьет человека не за убийство или распространение нечестия на земле, тот словно убил всех людей, а кто сохранит жизнь человеку, тот словно сохранит жизнь всем людям. Наши посланники уже явились к ним с ясными знамениями, но многие из них после этого излишествуют на земле.";
"discovery.card.ayah_5_32.source" = "Qur’an 5:32";

"discovery.card.ayah_5_35.title" = "Al-Maaida 35";
"discovery.card.ayah_5_35.meaning" = "О те, которые уверовали! Бойтесь Аллаха, ищите близости к Нему и сражайтесь на Его пути, - быть может, вы преуспеете.";
"discovery.card.ayah_5_35.source" = "Qur’an 5:35";

"discovery.card.ayah_5_54.title" = "Al-Maaida 54";
"discovery.card.ayah_5_54.meaning" = "О те, которые уверовали! Если кто-нибудь из вас отступит от своей религии, то Аллах приведет других людей, которых Он будет любить и которые будут любить Его. Они будут смиренны перед верующими и непреклонны перед неверующими, будут сражаться на пути Аллаха и не будут бояться порицания порицающих. Такова милость Аллаха, которую Он дарует, кому пожелает. Аллах - Объемлющий, Знающий.";
"discovery.card.ayah_5_54.source" = "Qur’an 5:54";

"discovery.card.ayah_5_119.title" = "Al-Maaida 119";
"discovery.card.ayah_5_119.meaning" = "Аллах сказал: «Это - день, когда правдивым людям принесет пользу их правдивость. Им уготованы Райские сады, в которых текут реки. Они пребудут там вечно». Аллах доволен ими, и они довольны Им. Это - великое преуспеяние!";
"discovery.card.ayah_5_119.source" = "Qur’an 5:119";

"discovery.card.ayah_6_17.title" = "Al-An'aam 17";
"discovery.card.ayah_6_17.meaning" = "Если Аллах коснется тебя бедой, то никто не сможет избавить от нее, кроме Него. Если же Он коснется тебя благом, то ведь Он способен на всякую вещь.";
"discovery.card.ayah_6_17.source" = "Qur’an 6:17";

"discovery.card.ayah_6_54.title" = "Al-An'aam 54";
"discovery.card.ayah_6_54.meaning" = "Когда к тебе приходят те, которые уверовали в Наши знамения, говори им: «Мир вам! Ваш Господь предписал себе быть Милосердным, и если кто из вас сотворит зло по своему невежеству, а затем раскается и станет совершать праведные деяния, то ведь Он - Прощающий, Милосердный».";
"discovery.card.ayah_6_54.source" = "Qur’an 6:54";

"discovery.card.ayah_6_125.title" = "Al-An'aam 125";
"discovery.card.ayah_6_125.meaning" = "Кого Аллах желает наставить на прямой путь, тому Он раскрывает грудь для ислама, а кого Он желает ввести в заблуждение, тому Он сдавливает и сжимает грудь, словно тот забирается на небо. Так Аллах насылает скверну (или наказание) на тех, кто не верует.";
"discovery.card.ayah_6_125.source" = "Qur’an 6:125";

"discovery.card.ayah_6_151.title" = "Al-An'aam 151";
"discovery.card.ayah_6_151.meaning" = "Скажи: «Придите, и я прочту то, что запретил вам ваш Господь». Никого не приобщайте к Нему в сотоварищи и делайте добро родителям. И не убивайте своих детей, опасаясь нищеты, ведь Мы обеспечиваем пропитанием вас вместе с ними. И не приближайтесь к мерзким поступкам, явным или сокрытым. Не убивайте душу, которую Аллах запретил убивать, если только у вас нет на это права. Это заповедал вам Аллах, - быть может, вы уразумеете.";
"discovery.card.ayah_6_151.source" = "Qur’an 6:151";

"discovery.card.ayah_6_162.title" = "Al-An'aam 162";
"discovery.card.ayah_6_162.meaning" = "Скажи: «Воистину, мой намаз и мое жертвоприношение (или поклонение), моя жизнь и моя смерть посвящены Аллаху, Господу миров.";
"discovery.card.ayah_6_162.source" = "Qur’an 6:162";

"discovery.card.ayah_7_23.title" = "Al-A'raaf 23";
"discovery.card.ayah_7_23.meaning" = "Они сказали: «Господь наш! Мы поступили несправедливо по отношению к себе, и если Ты не простишь нас и не смилостивишься над нами, то мы непременно окажемся одними из потерпевших урон».";
"discovery.card.ayah_7_23.source" = "Qur’an 7:23";

"discovery.card.ayah_7_31.title" = "Al-A'raaf 31";
"discovery.card.ayah_7_31.meaning" = "О сыны Адама! Облекайтесь в свои украшения при каждой мечети. Ешьте и пейте, но не излишествуйте, ибо Он не любит тех, кто излишествует.";
"discovery.card.ayah_7_31.source" = "Qur’an 7:31";

"discovery.card.ayah_7_56.title" = "Al-A'raaf 56";
"discovery.card.ayah_7_56.meaning" = "Не распространяйте нечестия на земле после того, как она приведена в порядок. Взывайте к Нему со страхом и надеждой. Воистину, милость Аллаха близка к творящим добро.";
"discovery.card.ayah_7_56.source" = "Qur’an 7:56";

"discovery.card.ayah_7_128.title" = "Al-A'raaf 128";
"discovery.card.ayah_7_128.meaning" = "Муса (Моисей) сказал своему народу: «Просите помощи у Аллаха и терпите. Воистину, земля принадлежит Аллаху. Он дарует ее в наследие тому из Своих рабов, кому пожелает, и благой конец уготован богобоязненным».";
"discovery.card.ayah_7_128.source" = "Qur’an 7:128";

"discovery.card.ayah_7_199.title" = "Al-A'raaf 199";
"discovery.card.ayah_7_199.meaning" = "Будь снисходителен (или отдавай излишек; или принимай пожертвования, которые приносят тебе), вели творить добро и отвернись от невежд.";
"discovery.card.ayah_7_199.source" = "Qur’an 7:199";

"discovery.card.ayah_7_204.title" = "Al-A'raaf 204";
"discovery.card.ayah_7_204.meaning" = "Когда читается Коран, то слушайте его и храните молчание, - быть может, вас помилуют.";
"discovery.card.ayah_7_204.source" = "Qur’an 7:204";

"discovery.card.ayah_8_2.title" = "Al-Anfaal 2";
"discovery.card.ayah_8_2.meaning" = "Верующими являются только те, сердца которых испытывают страх при упоминании Аллаха, вера которых усиливается, когда им читают Его аяты, которые уповают на своего Господа,";
"discovery.card.ayah_8_2.source" = "Qur’an 8:2";

"discovery.card.ayah_8_29.title" = "Al-Anfaal 29";
"discovery.card.ayah_8_29.meaning" = "О те, которые уверовали! Если вы будете бояться Аллаха, то Он одарит вас способностью различать истину и ложь, отпустит вам ваши прегрешения и простит вас. Воистину, Аллах обладает великой милостью.";
"discovery.card.ayah_8_29.source" = "Qur’an 8:29";

"discovery.card.ayah_8_46.title" = "Al-Anfaal 46";
"discovery.card.ayah_8_46.meaning" = "Повинуйтесь Аллаху и Его Посланнику и не препирайтесь, а не то вы падете духом и лишитесь сил. Будьте терпеливы, ибо Аллах - с терпеливыми.";
"discovery.card.ayah_8_46.source" = "Qur’an 8:46";

"discovery.card.ayah_8_61.title" = "Al-Anfaal 61";
"discovery.card.ayah_8_61.meaning" = "Если они склоняются к миру, ты тоже склоняйся к миру и уповай на Аллаха. Воистину, Он - Слышащий, Знающий.";
"discovery.card.ayah_8_61.source" = "Qur’an 8:61";

"discovery.card.ayah_9_18.title" = "At-Tawba 18";
"discovery.card.ayah_9_18.meaning" = "Только тот оживляет мечети Аллаха, кто уверовал в Аллаха и в Последний день, кто совершает намаз, выплачивает закят и не боится никого, кроме Аллаха. Возможно, они окажутся на верном пути.";
"discovery.card.ayah_9_18.source" = "Qur’an 9:18";

"discovery.card.ayah_9_40.title" = "At-Tawba 40";
"discovery.card.ayah_9_40.meaning" = "Если вы не окажете ему (Мухаммаду) поддержки, то ведь Аллах уже оказал ему поддержку, когда неверующие изгнали его. Он был одним из тех двоих, которые находились в пещере, и сказал своему спутнику (Абу Бакру): «Не скорби, ибо Аллах - с нами». Тогда Аллах ниспослал ему спокойствие и поддержал его воинами, которых вы не видели. Аллах сделал слово неверующих нижайшим, тогда как Слово Аллаха превыше всего. Аллах - Могущественный, Мудрый.";
"discovery.card.ayah_9_40.source" = "Qur’an 9:40";

"discovery.card.ayah_9_51.title" = "At-Tawba 51";
"discovery.card.ayah_9_51.meaning" = "Скажи: «Нас постигнет только то, что предписано нам Аллахом. Он - наш Покровитель. И пусть верующие уповают на одного Аллаха».";
"discovery.card.ayah_9_51.source" = "Qur’an 9:51";

"discovery.card.ayah_9_71.title" = "At-Tawba 71";
"discovery.card.ayah_9_71.meaning" = "Верующие мужчины и женщины являются помощниками и друзьями друг другу. Они велят совершать одобряемое и запрещают предосудительное, совершают намаз, выплачивают закят, повинуются Аллаху и Его Посланнику. Аллах смилостивится над ними. Воистину, Аллах - Могущественный, Мудрый.";
"discovery.card.ayah_9_71.source" = "Qur’an 9:71";

"discovery.card.ayah_9_103.title" = "At-Tawba 103";
"discovery.card.ayah_9_103.meaning" = "Бери из их имущества пожертвования, чтобы ими очистить и возвысить их. Молись за них, ибо твои молитвы - успокоение для них. Воистину, Аллах - Слышащий, Знающий.";
"discovery.card.ayah_9_103.source" = "Qur’an 9:103";

"discovery.card.ayah_9_128.title" = "At-Tawba 128";
"discovery.card.ayah_9_128.meaning" = "К вам явился Посланник из вашей среды. Тяжко для него то, что вы страдаете. Он старается для вас. Он сострадателен и милосерден к верующим.";
"discovery.card.ayah_9_128.source" = "Qur’an 9:128";

"discovery.card.ayah_10_25.title" = "Yunus 25";
"discovery.card.ayah_10_25.meaning" = "Аллах призывает к Обители мира и благополучия и наставляет на прямой путь тех, кого пожелает.";
"discovery.card.ayah_10_25.source" = "Qur’an 10:25";

"discovery.card.ayah_10_57.title" = "Yunus 57";
"discovery.card.ayah_10_57.meaning" = "О люди! К вам от вашего Господа явилось увещевание, исцеление для того, что в груди, верное руководство и милость для верующих.";
"discovery.card.ayah_10_57.source" = "Qur’an 10:57";

"discovery.card.ayah_10_62.title" = "Yunus 62";
"discovery.card.ayah_10_62.meaning" = "Воистину, угодники Аллаха не познают страха и не будут опечалены.";
"discovery.card.ayah_10_62.source" = "Qur’an 10:62";

"discovery.card.ayah_10_107.title" = "Yunus 107";
"discovery.card.ayah_10_107.meaning" = "Если Аллах коснется тебя вредом, то никто, кроме Него, не избавит тебя от него. Если Он пожелает одарить тебя добром, то никто не отвратит Его милости. Он одаряет ею того из Своих рабов, кого пожелает. Он - Прощающий, Милосердный.";
"discovery.card.ayah_10_107.source" = "Qur’an 10:107";

"discovery.card.ayah_11_88.title" = "Hud 88";
"discovery.card.ayah_11_88.meaning" = "Он сказал: «О мой народ! А что, если я опираюсь на доказательство от моего Господа, и Он даровал мне прекрасную долю? Я не хочу отличаться от вас и совершать то, что я запрещаю совершать вам, а хочу лишь исправить то, что в моих силах. Помогает мне только Аллах. На Него одного я уповаю, к Нему одному обращаюсь.";
"discovery.card.ayah_11_88.source" = "Qur’an 11:88";

"discovery.card.ayah_11_114.title" = "Hud 114";
"discovery.card.ayah_11_114.meaning" = "Совершай намаз в начале и конце дня и в некоторые часы ночи. Воистину, добрые деяния удаляют злодеяния. Это - Напоминание для поминающих.";
"discovery.card.ayah_11_114.source" = "Qur’an 11:114";

"discovery.card.ayah_12_21.title" = "Yusuf 21";
"discovery.card.ayah_12_21.meaning" = "Тот житель Египта, который купил Йусуфа (Иосифа), сказал своей жене: «Относись к нему хорошо. Быть может, он принесет нам пользу, или же мы усыновим его». Так Мы утвердили Йусуфа (Иосифа) на земле и научили его толкованию снов. Аллах властен вершить Свои дела, однако большинство людей не ведает об этом.";
"discovery.card.ayah_12_21.source" = "Qur’an 12:21";

"discovery.card.ayah_12_87.title" = "Yusuf 87";
"discovery.card.ayah_12_87.meaning" = "О сыновья мои! Ступайте и разыщите Йусуфа (Иосифа) и его брата и не теряйте надежды на милость Аллаха, ибо отчаиваются в милости Аллаха только люди неверующие».";
"discovery.card.ayah_12_87.source" = "Qur’an 12:87";

"discovery.card.ayah_12_90.title" = "Yusuf 90";
"discovery.card.ayah_12_90.meaning" = "Они сказали: «Неужели ты - Йусуф (Иосиф)?». Он сказал: «Я - Йусуф, а это - мой брат. Аллах облагодетельствовал нас. Воистину, если кто богобоязнен и терпелив, то ведь Аллах не теряет вознаграждения творящих добро».";
"discovery.card.ayah_12_90.source" = "Qur’an 12:90";

"discovery.card.ayah_13_11.title" = "Ar-Ra'd 11";
"discovery.card.ayah_13_11.meaning" = "Есть у него (человека) ангелы, следующие впереди него и позади него и охраняющие его по повелению Аллаха. Воистину, Аллах не меняет положения людей, пока они не изменят самих себя. Если же Аллах пожелает людям зла, то ничто не предотвратит этого. Нет у них властелина, кроме Него.";
"discovery.card.ayah_13_11.source" = "Qur’an 13:11";

"discovery.card.ayah_13_28.title" = "Ar-Ra'd 28";
"discovery.card.ayah_13_28.meaning" = "Они уверовали, и их сердца утешаются поминанием Аллаха. Разве не поминанием Аллаха утешаются сердца?";
"discovery.card.ayah_13_28.source" = "Qur’an 13:28";

"discovery.card.ayah_14_24.title" = "Ibrahim 24";
"discovery.card.ayah_14_24.meaning" = "Разве ты не видишь, как Аллах приводит притчи? Прекрасное слово подобно прекрасному дереву, корни которого прочны, а ветви восходят к небу.";
"discovery.card.ayah_14_24.source" = "Qur’an 14:24";

"discovery.card.ayah_15_9.title" = "Al-Hijr 9";
"discovery.card.ayah_15_9.meaning" = "Воистину, Мы ниспослали Напоминание, и Мы оберегаем его.";
"discovery.card.ayah_15_9.source" = "Qur’an 15:9";

"discovery.card.ayah_15_49.title" = "Al-Hijr 49";
"discovery.card.ayah_15_49.meaning" = "Сообщи Моим рабам, что Я - Прощающий, Милосердный,";
"discovery.card.ayah_15_49.source" = "Qur’an 15:49";

"discovery.card.ayah_16_90.title" = "An-Nahl 90";
"discovery.card.ayah_16_90.meaning" = "Воистину, Аллах повелевает блюсти справедливость, делать добро и одаривать родственников. Он запрещает мерзости, предосудительные деяния и бесчинства. Он увещевает вас, - быть может, вы помяните назидание.";
"discovery.card.ayah_16_90.source" = "Qur’an 16:90";

"discovery.card.ayah_16_97.title" = "An-Nahl 97";
"discovery.card.ayah_16_97.meaning" = "Верующих мужчин и женщин, которые поступали праведно, Мы непременно одарим прекрасной жизнью и вознаградим за лучшее из того, что они совершали.";
"discovery.card.ayah_16_97.source" = "Qur’an 16:97";

"discovery.card.ayah_16_125.title" = "An-Nahl 125";
"discovery.card.ayah_16_125.meaning" = "Призывай на путь Господа мудростью и добрым увещеванием и веди спор с ними наилучшим образом. Воистину, твой Господь лучше знает тех, кто сошел с Его пути, и лучше знает тех, кто следует прямым путем.";
"discovery.card.ayah_16_125.source" = "Qur’an 16:125";

"discovery.card.ayah_17_9.title" = "Al-Israa 9";
"discovery.card.ayah_17_9.meaning" = "Воистину, этот Коран указывает на самый правильный путь и возвещает верующим, которые совершают праведные деяния, благую весть о том, что им уготована великая награда.";
"discovery.card.ayah_17_9.source" = "Qur’an 17:9";

"discovery.card.ayah_17_24.title" = "Al-Israa 24";
"discovery.card.ayah_17_24.meaning" = "Склони пред ними крыло смирения по милосердию своему и говори: «Господи! Помилуй их, ведь они растили меня ребенком».";
"discovery.card.ayah_17_24.source" = "Qur’an 17:24";

"discovery.card.ayah_17_26.title" = "Al-Israa 26";
"discovery.card.ayah_17_26.meaning" = "Отдавай должное родственнику, бедняку и путнику, но не расточай чрезмерно.";
"discovery.card.ayah_17_26.source" = "Qur’an 17:26";

"discovery.card.ayah_17_32.title" = "Al-Israa 32";
"discovery.card.ayah_17_32.meaning" = "Не приближайтесь к прелюбодеянию, ибо оно является мерзостью и скверным путем.";
"discovery.card.ayah_17_32.source" = "Qur’an 17:32";

"discovery.card.ayah_17_53.title" = "Al-Israa 53";
"discovery.card.ayah_17_53.meaning" = "Скажи Моим рабам, чтобы они говорили наилучшие слова, ибо дьявол вносит между ними раздор. Воистину, дьявол для человека - явный враг.";
"discovery.card.ayah_17_53.source" = "Qur’an 17:53";

"discovery.card.ayah_17_70.title" = "Al-Israa 70";
"discovery.card.ayah_17_70.meaning" = "Мы почтили сынов Адама и позволяем им передвигаться по суше и морю. Мы наделили их благами и даровали им явное превосходство над многими другими тварями.";
"discovery.card.ayah_17_70.source" = "Qur’an 17:70";

"discovery.card.ayah_17_80.title" = "Al-Israa 80";
"discovery.card.ayah_17_80.meaning" = "Скажи: «Господи! Пусть мое пришествие будет правдивым, и пусть мой уход будет правдивым! Даруй мне от Тебя знамение в помощь».";
"discovery.card.ayah_17_80.source" = "Qur’an 17:80";

"discovery.card.ayah_17_110.title" = "Al-Israa 110";
"discovery.card.ayah_17_110.meaning" = "Скажи: «Призывайте Аллаха или призывайте Милостивого! Как бы вы ни призывали Его, у Него - самые прекрасные имена». Не совершай свой намаз громко и не совершай его шепотом, а выбери среднее между этим.";
"discovery.card.ayah_17_110.source" = "Qur’an 17:110";

"discovery.card.ayah_18_10.title" = "Al-Kahf 10";
"discovery.card.ayah_18_10.meaning" = "Вот юноши укрылись в пещере и сказали: «Господь наш! Даруй нам от Себя милость и устрой наше дело наилучшим образом».";
"discovery.card.ayah_18_10.source" = "Qur’an 18:10";

"discovery.card.ayah_18_24.title" = "Al-Kahf 24";
"discovery.card.ayah_18_24.meaning" = "Если только этого не пожелает Аллах! Если же ты забыл, то помяни своего Господа и скажи: «Быть может, Господь мой поведет меня более правильным путем».";
"discovery.card.ayah_18_24.source" = "Qur’an 18:24";

"discovery.card.ayah_18_46.title" = "Al-Kahf 46";
"discovery.card.ayah_18_46.meaning" = "Богатство и сыновья - украшение мирской жизни, однако нетленные благодеяния лучше по вознаграждению перед твоим Господом, и на них лучше возлагать надежды.";
"discovery.card.ayah_18_46.source" = "Qur’an 18:46";

"discovery.card.ayah_18_110.title" = "Al-Kahf 110";
"discovery.card.ayah_18_110.meaning" = "Скажи: «Воистину, я - такой же человек, как и вы. Мне внушено откровение о том, что ваш Бог - Бог Единственный. Тот, кто надеется на встречу со своим Господом, пусть совершает праведные деяния и никому не поклоняется наряду со своим Господом».";
"discovery.card.ayah_18_110.source" = "Qur’an 18:110";

"discovery.card.ayah_19_4.title" = "Maryam 4";
"discovery.card.ayah_19_4.meaning" = "и сказал: «Господи! Воистину, кости мои ослабели, а седина уже распространилась по моей голове. А ведь раньше благодаря молитвам к Тебе, Господи, я не был несчастен.";
"discovery.card.ayah_19_4.source" = "Qur’an 19:4";

"discovery.card.ayah_19_96.title" = "Maryam 96";
"discovery.card.ayah_19_96.meaning" = "Тех, которые уверовали и совершали праведные деяния, Милостивый одарит любовью.";
"discovery.card.ayah_19_96.source" = "Qur’an 19:96";

"discovery.card.ayah_20_8.title" = "Taa-Haa 8";
"discovery.card.ayah_20_8.meaning" = "Аллах - Тот, кроме Которого нет иного божества и у Которого самые прекрасные имена.";
"discovery.card.ayah_20_8.source" = "Qur’an 20:8";

"discovery.card.ayah_20_25.title" = "Taa-Haa 25";
"discovery.card.ayah_20_25.meaning" = "Муса (Моисей) сказал: «Господи! Раскрой для меня мою грудь!";
"discovery.card.ayah_20_25.source" = "Qur’an 20:25";

"discovery.card.ayah_20_46.title" = "Taa-Haa 46";
"discovery.card.ayah_20_46.meaning" = "Аллах сказал: «Не бойтесь, ибо Я - с вами. Я слышу и вижу.";
"discovery.card.ayah_20_46.source" = "Qur’an 20:46";

"discovery.card.ayah_20_82.title" = "Taa-Haa 82";
"discovery.card.ayah_20_82.meaning" = "Воистину, Я прощаю тех, кто раскаялся, уверовал, стал поступать праведно, а потом последовал прямым путем.";
"discovery.card.ayah_20_82.source" = "Qur’an 20:82";

"discovery.card.ayah_21_47.title" = "Al-Anbiyaa 47";
"discovery.card.ayah_21_47.meaning" = "В День воскресения Мы установим справедливые Весы, и ни с кем не поступят несправедливо. Если найдется нечто весом с горчичное зернышко, Мы принесем его. Довольно того, что Мы ведем счет!";
"discovery.card.ayah_21_47.source" = "Qur’an 21:47";

"discovery.card.ayah_21_73.title" = "Al-Anbiyaa 73";
"discovery.card.ayah_21_73.meaning" = "Мы сделали их вождями, которые по Нашему велению указывали на прямой путь. Мы внушили им вершить добрые дела, совершать намаз и выплачивать закят, и они поклонялись Нам.";
"discovery.card.ayah_21_73.source" = "Qur’an 21:73";

"discovery.card.ayah_21_92.title" = "Al-Anbiyaa 92";
"discovery.card.ayah_21_92.meaning" = "Воистину, эта ваша религия - религия единая. Я же - ваш Господь. Поклоняйтесь же Мне!";
"discovery.card.ayah_21_92.source" = "Qur’an 21:92";

"discovery.card.ayah_22_77.title" = "Al-Hajj 77";
"discovery.card.ayah_22_77.meaning" = "О те, которые уверовали! Кланяйтесь, падайте ниц, поклоняйтесь вашему Господу и творите добро, - быть может, вы преуспеете.";
"discovery.card.ayah_22_77.source" = "Qur’an 22:77";

"discovery.card.ayah_22_78.title" = "Al-Hajj 78";
"discovery.card.ayah_22_78.meaning" = "Усердствуйте на пути Аллаха надлежащим образом. Он избрал вас и не сделал для вас никакого затруднения в религии. Такова вера отца вашего Ибрахима (Авраама). Аллах нарек вас мусульманами до этого и здесь (в Коране), чтобы Посланник был свидетелем о вас, а вы были свидетелями о людях. Совершайте намаз, выплачивайте закят и крепко держитесь за Аллаха. Он - ваш Покровитель. Как же прекрасен этот Покровитель! Как же прекрасен этот Помощник!";
"discovery.card.ayah_22_78.source" = "Qur’an 22:78";

"discovery.card.ayah_23_1.title" = "Al-Muminoon 1";
"discovery.card.ayah_23_1.meaning" = "Воистину, преуспели верующие,";
"discovery.card.ayah_23_1.source" = "Qur’an 23:1";

"discovery.card.ayah_23_51.title" = "Al-Muminoon 51";
"discovery.card.ayah_23_51.meaning" = "О посланники! Вкушайте блага и поступайте праведно. Воистину, Мне известно о том, что вы совершаете.";
"discovery.card.ayah_23_51.source" = "Qur’an 23:51";

"discovery.card.ayah_23_97.title" = "Al-Muminoon 97";
"discovery.card.ayah_23_97.meaning" = "Скажи: «Господи! Я прибегаю к Тебе от наваждений дьяволов.";
"discovery.card.ayah_23_97.source" = "Qur’an 23:97";

"discovery.card.ayah_24_22.title" = "An-Noor 22";
"discovery.card.ayah_24_22.meaning" = "Пусть обладающие достоинствами и достатком среди вас не клянутся, что не будут помогать родственникам, беднякам и переселенцам на пути Аллаха. Пусть они простят и будут великодушны. Разве вы не желаете, чтобы Аллах простил вас? Аллах - Прощающий, Милосердный.";
"discovery.card.ayah_24_22.source" = "Qur’an 24:22";

"discovery.card.ayah_24_31.title" = "An-Noor 31";
"discovery.card.ayah_24_31.meaning" = "Скажи верующим женщинам, чтобы они опускали свои взоры и оберегали свои половые органы. Пусть они не выставляют напоказ своих прикрас, за исключением тех, которые видны, и пусть прикрывают своими покрывалами вырез на груди и не показывают своей красы никому, кроме своих мужей, или своих отцов, или своих свекров, или своих сыновей, или сыновей своих мужей, или своих братьев, или сыновей своих братьев, или сыновей своих сестер, или своих женщин, или невольников, которыми овладели их десницы, или слуг из числа мужчин, лишенных вожделения, или детей, которые не постигли наготы женщин; и пусть они не стучат своими ногами, давая знать об украшениях, которые они скрывают. О верующие! Обращайтесь к Аллаху с покаянием все вместе, - быть может, вы преуспеете.";
"discovery.card.ayah_24_31.source" = "Qur’an 24:31";

"discovery.card.ayah_24_37.title" = "An-Noor 37";
"discovery.card.ayah_24_37.meaning" = "мужи, которых ни торговля, ни купля-продажа не отвлекают от поминания Аллаха, совершения намаза и выплаты закята. Они боятся дня, когда перевернутся сердца и взоры,";
"discovery.card.ayah_24_37.source" = "Qur’an 24:37";

"discovery.card.ayah_25_63.title" = "Al-Furqaan 63";
"discovery.card.ayah_25_63.meaning" = "А рабами Милостивого являются те, которые ступают по земле смиренно, а когда невежды обращаются к ним, они говорят: «Мир!»";
"discovery.card.ayah_25_63.source" = "Qur’an 25:63";

"discovery.card.ayah_25_74.title" = "Al-Furqaan 74";
"discovery.card.ayah_25_74.meaning" = "Они говорят: «Господь наш! Даруй нам отраду глаз в наших супругах и потомках и сделай нас образцом для богобоязненных».";
"discovery.card.ayah_25_74.source" = "Qur’an 25:74";

"discovery.card.ayah_26_80.title" = "Ash-Shu'araa 80";
"discovery.card.ayah_26_80.meaning" = "Который исцеляет меня, когда я заболеваю,";
"discovery.card.ayah_26_80.source" = "Qur’an 26:80";

"discovery.card.ayah_26_89.title" = "Ash-Shu'araa 89";
"discovery.card.ayah_26_89.meaning" = "кроме тех, которые предстанут перед Аллахом с непорочным сердцем».";
"discovery.card.ayah_26_89.source" = "Qur’an 26:89";

"discovery.card.ayah_27_19.title" = "An-Naml 19";
"discovery.card.ayah_27_19.meaning" = "Он улыбнулся, рассмеявшись от ее слов. Он сказал: «Господи! Внуши мне быть благодарным за Твою милость, которую Ты оказал мне и моим родителям, и совершать праведные деяния, которыми Ты будешь доволен. Введи меня по Своей милости в число Своих праведных рабов».";
"discovery.card.ayah_27_19.source" = "Qur’an 27:19";

"discovery.card.ayah_27_62.title" = "An-Naml 62";
"discovery.card.ayah_27_62.meaning" = "Кто отвечает на мольбу нуждающегося, когда он взывает к Нему, устраняет зло и делает вас наследниками земли? Есть ли бог, кроме Аллаха? Мало же вы поминаете назидания!";
"discovery.card.ayah_27_62.source" = "Qur’an 27:62";

"discovery.card.ayah_28_56.title" = "Al-Qasas 56";
"discovery.card.ayah_28_56.meaning" = "Воистину, ты не сможешь наставить на прямой путь тех, кого возлюбил. Только Аллах наставляет на прямой путь тех, кого пожелает. Он лучше знает тех, кто следует прямым путем.";
"discovery.card.ayah_28_56.source" = "Qur’an 28:56";

"discovery.card.ayah_28_77.title" = "Al-Qasas 77";
"discovery.card.ayah_28_77.meaning" = "А посредством того, что Аллах даровал тебе, стремись к Последней обители, но не забывай о своей доле в этом мире! Твори добро, подобно тому, как Аллах сотворил добро для тебя, и не стремись распространять нечестие на земле, ведь Аллах не любит распространяющих нечестие».";
"discovery.card.ayah_28_77.source" = "Qur’an 28:77";

"discovery.card.ayah_29_45.title" = "Al-Ankaboot 45";
"discovery.card.ayah_29_45.meaning" = "Читай то, что внушено тебе из Писания, и совершай намаз. Воистину, намаз оберегает от мерзости и предосудительного. Но поминание Аллаха - гораздо важнее, и Аллах знает о том, что вы творите.";
"discovery.card.ayah_29_45.source" = "Qur’an 29:45";

"discovery.card.ayah_29_69.title" = "Al-Ankaboot 69";
"discovery.card.ayah_29_69.meaning" = "А тех, которые сражаются ради Нас, Мы непременно поведем Нашими путями. Воистину, Аллах - с творящими добро!";
"discovery.card.ayah_29_69.source" = "Qur’an 29:69";

"discovery.card.ayah_31_12.title" = "Luqman 12";
"discovery.card.ayah_31_12.meaning" = "Мы даровали Лукману мудрость: «Благодари Аллаха! Тот, кто благодарит, поступает только во благо себе. А если кто неблагодарен, то ведь Аллах - Богатый, Достохвальный».";
"discovery.card.ayah_31_12.source" = "Qur’an 31:12";

"discovery.card.ayah_31_13.title" = "Luqman 13";
"discovery.card.ayah_31_13.meaning" = "Вот Лукман сказал своему сыну, наставляя его: «О сын мой! Не приобщай к Аллаху сотоварищей, ибо многобожие является великой несправедливостью».";
"discovery.card.ayah_31_13.source" = "Qur’an 31:13";

"discovery.card.ayah_31_18.title" = "Luqman 18";
"discovery.card.ayah_31_18.meaning" = "Не отворачивай своего лица от людей из высокомерия и не шествуй по земле кичливо. Воистину, Аллах не любит всяких гордецов и бахвалов.";
"discovery.card.ayah_31_18.source" = "Qur’an 31:18";

"discovery.card.ayah_31_19.title" = "Luqman 19";
"discovery.card.ayah_31_19.meaning" = "Ступай размеренной поступью и понижай свой голос, ибо самый неприятный голос - это рев осла.";
"discovery.card.ayah_31_19.source" = "Qur’an 31:19";

"discovery.card.ayah_32_16.title" = "As-Sajda 16";
"discovery.card.ayah_32_16.meaning" = "Они отрывают свои бока от постелей, взывая к своему Господу со страхом и надеждой, и расходуют из того, чем Мы их наделили.";
"discovery.card.ayah_32_16.source" = "Qur’an 32:16";

"discovery.card.ayah_32_17.title" = "As-Sajda 17";
"discovery.card.ayah_32_17.meaning" = "Ни один человек не знает, какие услады для глаз сокрыты для них в воздаяние за то, что они совершали.";
"discovery.card.ayah_32_17.source" = "Qur’an 32:17";

"discovery.card.ayah_33_21.title" = "Al-Ahzaab 21";
"discovery.card.ayah_33_21.meaning" = "В Посланнике Аллаха был прекрасный пример для вас, для тех, кто надеется на Аллаха и Последний день и премного поминает Аллаха.";
"discovery.card.ayah_33_21.source" = "Qur’an 33:21";

"discovery.card.ayah_33_35.title" = "Al-Ahzaab 35";
"discovery.card.ayah_33_35.meaning" = "Воистину, для мусульман и мусульманок, верующих мужчин и верующих женщин, покорных мужчин и покорных женщин, правдивых мужчин и правдивых женщин, терпеливых мужчин и терпеливых женщин, смиренных мужчин и смиренных женщин, подающих милостыню мужчин и подающих милостыню женщин, постящихся мужчин и постящихся женщин, хранящих целомудрие мужчин и хранящих целомудрие женщин и часто поминающих Аллаха мужчин и женщин, Аллах уготовил прощение и великую награду.";
"discovery.card.ayah_33_35.source" = "Qur’an 33:35";

"discovery.card.ayah_33_41.title" = "Al-Ahzaab 41";
"discovery.card.ayah_33_41.meaning" = "О те, которые уверовали! Поминайте Аллаха многократно";
"discovery.card.ayah_33_41.source" = "Qur’an 33:41";

"discovery.card.ayah_33_56.title" = "Al-Ahzaab 56";
"discovery.card.ayah_33_56.meaning" = "Воистину, Аллах и Его ангелы благословляют Пророка. О те, которые уверовали! Благословляйте его и приветствуйте миром.";
"discovery.card.ayah_33_56.source" = "Qur’an 33:56";

"discovery.card.ayah_33_70.title" = "Al-Ahzaab 70";
"discovery.card.ayah_33_70.meaning" = "О те, которые уверовали! Бойтесь Аллаха и говорите правое слово.";
"discovery.card.ayah_33_70.source" = "Qur’an 33:70";

"discovery.card.ayah_35_10.title" = "Faatir 10";
"discovery.card.ayah_35_10.meaning" = "Если кто жаждет могущества, то ведь могущество целиком принадлежит Аллаху. К Нему восходит прекрасное слово, и Он возносит праведное деяние (или праведное деяние возносит прекрасное слово; или праведное деяние возносит человека). А тем, которые замышляют злодеяния, уготованы тяжкие мучения, и их замыслы окажутся безуспешными.";
"discovery.card.ayah_35_10.source" = "Qur’an 35:10";

"discovery.card.ayah_35_28.title" = "Faatir 28";
"discovery.card.ayah_35_28.meaning" = "Люди, животные и скот также бывают различных цветов. Боятся Аллаха среди Его рабов только обладающие знанием. Воистину, Аллах - Могущественный, Прощающий.";
"discovery.card.ayah_35_28.source" = "Qur’an 35:28";

"discovery.card.ayah_36_1.title" = "Yaseen 1";
"discovery.card.ayah_36_1.meaning" = "Йа. Син.";
"discovery.card.ayah_36_1.source" = "Qur’an 36:1";

"discovery.card.ayah_36_22.title" = "Yaseen 22";
"discovery.card.ayah_36_22.meaning" = "И почему бы мне не поклоняться Тому, Кто сотворил меня и к Кому вы будете возвращены?";
"discovery.card.ayah_36_22.source" = "Qur’an 36:22";

"discovery.card.ayah_36_58.title" = "Yaseen 58";
"discovery.card.ayah_36_58.meaning" = "Милосердный Господь приветствует их словом: «Мир!».";
"discovery.card.ayah_36_58.source" = "Qur’an 36:58";

"discovery.card.ayah_37_96.title" = "As-Saaffaat 96";
"discovery.card.ayah_37_96.meaning" = "Аллах сотворил вас и то, что вы делаете (или Аллах сотворил вас, и сами вы ничего не делаете; или Аллах сотворил вас. Что же вы делаете?)».";
"discovery.card.ayah_37_96.source" = "Qur’an 37:96";

"discovery.card.ayah_38_29.title" = "Saad 29";
"discovery.card.ayah_38_29.meaning" = "Это - благословенное Писание, которое Мы ниспослали тебе, дабы они размышляли над его аятами и дабы обладающие разумом помянули назидание.";
"discovery.card.ayah_38_29.source" = "Qur’an 38:29";

"discovery.card.ayah_39_9.title" = "Az-Zumar 9";
"discovery.card.ayah_39_9.meaning" = "Неужели тот, кто смиренно проводит ночные часы, падая ниц и стоя, страшась Последней жизни и надеясь на милость своего Господа, равен неверующему? Скажи: «Неужели равны те, которые знают, и те, которые не знают?». Воистину, поминают назидание только обладающие разумом.";
"discovery.card.ayah_39_9.source" = "Qur’an 39:9";

"discovery.card.ayah_39_10.title" = "Az-Zumar 10";
"discovery.card.ayah_39_10.meaning" = "Скажи Моим рабам, которые уверовали: «Бойтесь вашего Господа! Тем, которые совершили добро в этом мире, уготовано добро. Земля Аллаха обширна. Воистину, терпеливым их награда воздастся полностью без счета».";
"discovery.card.ayah_39_10.source" = "Qur’an 39:10";

"discovery.card.ayah_39_36.title" = "Az-Zumar 36";
"discovery.card.ayah_39_36.meaning" = "Разве Аллаха не достаточно для Его раба? Они устрашают тебя теми, которые ниже Него. А кого Аллах введет в заблуждение, тому не будет наставника.";
"discovery.card.ayah_39_36.source" = "Qur’an 39:36";

"discovery.card.ayah_40_60.title" = "Ghafir 60";
"discovery.card.ayah_40_60.meaning" = "Ваш Господь сказал: «Взывайте ко Мне, и Я отвечу вам. Воистину, те, которые превозносятся над поклонением Мне, войдут в Геенну униженными».";
"discovery.card.ayah_40_60.source" = "Qur’an 40:60";

"discovery.card.ayah_40_65.title" = "Ghafir 65";
"discovery.card.ayah_40_65.meaning" = "Он - Живой, и нет божества, кроме Него. Взывайте же к Нему, очищая перед Ним веру. Хвала Аллаху, Господу миров!";
"discovery.card.ayah_40_65.source" = "Qur’an 40:65";

"discovery.card.ayah_41_30.title" = "Fussilat 30";
"discovery.card.ayah_41_30.meaning" = "Воистину, к тем, которые сказали: «Наш Господь - Аллах», - а потом были стойки, нисходят ангелы: «Не бойтесь и не печальтесь, а возрадуйтесь Раю, который был обещан вам.";
"discovery.card.ayah_41_30.source" = "Qur’an 41:30";

"discovery.card.ayah_41_33.title" = "Fussilat 33";
"discovery.card.ayah_41_33.meaning" = "Чья речь прекраснее, чем речь того, кто призывает к Аллаху, поступает праведно и говорит: «Воистину, я - один из мусульман»?";
"discovery.card.ayah_41_33.source" = "Qur’an 41:33";

"discovery.card.ayah_41_34.title" = "Fussilat 34";
"discovery.card.ayah_41_34.meaning" = "Не равны добро и зло. Оттолкни зло тем, что лучше, и тогда тот, с кем ты враждуешь, станет для тебя словно близкий любящий родственник.";
"discovery.card.ayah_41_34.source" = "Qur’an 41:34";

"discovery.card.ayah_42_13.title" = "Ash-Shura 13";
"discovery.card.ayah_42_13.meaning" = "Он узаконил для вас в религии то, что заповедал Нуху (Ною), и то, что Мы внушили тебе в откровении, и то, что Мы заповедали Ибрахиму (Аврааму), Мусе (Моисею) и Исе (Иисусу): «Исповедуйте религию и не расходитесь во мнениях относительно нее». Тяжко для многобожников то, к чему ты их призываешь. Аллах избирает для Себя того, кого пожелает, и направляет к Себе того, кто обращается к Нему.";
"discovery.card.ayah_42_13.source" = "Qur’an 42:13";

"discovery.card.ayah_42_19.title" = "Ash-Shura 19";
"discovery.card.ayah_42_19.meaning" = "Аллах добр к Своим рабам и наделяет уделом, кого пожелает. Он - Всесильный, Могущественный.";
"discovery.card.ayah_42_19.source" = "Qur’an 42:19";

"discovery.card.ayah_42_36.title" = "Ash-Shura 36";
"discovery.card.ayah_42_36.meaning" = "Все, что даровано вам, является преходящим благом мирской жизни. А то, что есть у Аллаха, будет лучше и долговечнее для тех, которые уверовали и уповают на своего Господа,";
"discovery.card.ayah_42_36.source" = "Qur’an 42:36";

"discovery.card.ayah_43_36.title" = "Az-Zukhruf 36";
"discovery.card.ayah_43_36.meaning" = "К тем, кто отвращается от поминания Милостивого (или кто слеп к Нему), Мы приставим дьявола, и он станет его товарищем.";
"discovery.card.ayah_43_36.source" = "Qur’an 43:36";

"discovery.card.ayah_44_3.title" = "Ad-Dukhaan 3";
"discovery.card.ayah_44_3.meaning" = "Мы ниспослали его в благословенную ночь, и Мы предостерегаем.";
"discovery.card.ayah_44_3.source" = "Qur’an 44:3";

"discovery.card.ayah_45_15.title" = "Al-Jaathiya 15";
"discovery.card.ayah_45_15.meaning" = "Кто поступает праведно, тот поступает во благо себе. А кто творит зло, тот поступает во вред себе. А затем вы будете возвращены к вашему Господу.";
"discovery.card.ayah_45_15.source" = "Qur’an 45:15";

"discovery.card.ayah_46_13.title" = "Al-Ahqaf 13";
"discovery.card.ayah_46_13.meaning" = "Воистину, те, которые сказали: «Наш Господь - Аллах», - и последовали прямым путем, не познают страха и не будут опечалены.";
"discovery.card.ayah_46_13.source" = "Qur’an 46:13";

"discovery.card.ayah_46_15.title" = "Al-Ahqaf 15";
"discovery.card.ayah_46_15.meaning" = "Мы заповедали человеку делать добро его родителям. Матери тяжело носить его и рожать его, а беременность и кормление до отнятия его от груди продолжаются тридцать месяцев. Когда же он достигает зрелого возраста и достигает сорока лет, то говорит: «Господи! Внуши мне благодарность за милость, которой Ты облагодетельствовал меня и моих родителей, и помоги мне совершать праведные деяния, которыми Ты доволен. Сделай для меня моих потомков праведниками. Я раскаиваюсь перед Тобой. Воистину, я - один из мусульман».";
"discovery.card.ayah_46_15.source" = "Qur’an 46:15";

"discovery.card.ayah_47_7.title" = "Muhammad 7";
"discovery.card.ayah_47_7.meaning" = "О те, которые уверовали! Если вы поможете Аллаху, то и Он поможет вам и утвердит ваши стопы.";
"discovery.card.ayah_47_7.source" = "Qur’an 47:7";

"discovery.card.ayah_47_19.title" = "Muhammad 19";
"discovery.card.ayah_47_19.meaning" = "Знай же, что нет божества, кроме Аллаха, и проси прощения за свой грех и за верующих мужчин и верующих женщин. Аллах знает о ваших передвижениях и вашей обители.";
"discovery.card.ayah_47_19.source" = "Qur’an 47:19";

"discovery.card.ayah_48_1.title" = "Al-Fath 1";
"discovery.card.ayah_48_1.meaning" = "Воистину, Мы даровали тебе явную победу,";
"discovery.card.ayah_48_1.source" = "Qur’an 48:1";

"discovery.card.ayah_48_29.title" = "Al-Fath 29";
"discovery.card.ayah_48_29.meaning" = "Мухаммад - Посланник Аллаха. Те, которые вместе с ним, суровы к неверующим и милостивы между собой. Ты видишь, как они кланяются и падают ниц, стремясь к милости от Аллаха и довольству. Их признаком являются следы от земных поклонов на их лицах. Так они представлены в Таурате (Торе). В Инджиле (Евангелии) же они представлены посевом, на котором вырос росток. Он укрепил его, и тот стал толстым и выпрямился на своем стебле, восхищая сеятелей. Аллах привел эту притчу для того, чтобы привести ими в ярость неверующих. Аллах обещал тем из них, которые уверовали и совершали праведные деяния, прощение и великую награду.";
"discovery.card.ayah_48_29.source" = "Qur’an 48:29";

"discovery.card.ayah_49_10.title" = "Al-Hujuraat 10";
"discovery.card.ayah_49_10.meaning" = "Воистину, верующие - братья. Посему примиряйте братьев и бойтесь Аллаха, - быть может, вы будете помилованы.";
"discovery.card.ayah_49_10.source" = "Qur’an 49:10";

"discovery.card.ayah_49_11.title" = "Al-Hujuraat 11";
"discovery.card.ayah_49_11.meaning" = "О те, которые уверовали! Пусть одни люди не насмехаются над другими, ведь может быть, что те лучше них. И пусть одни женщины не насмехаются над другими женщинами, ведь может быть, что те лучше них. Не обижайте самих себя (друг друга) и не называйте друг друга оскорбительными прозвищами. Скверно называться нечестивцем после того, как уверовал. А те, которые не раскаются, окажутся беззаконниками.";
"discovery.card.ayah_49_11.source" = "Qur’an 49:11";

"discovery.card.ayah_51_19.title" = "Adh-Dhaariyat 19";
"discovery.card.ayah_51_19.meaning" = "Они выделяли известную долю своего имущества для просящих и обездоленных.";
"discovery.card.ayah_51_19.source" = "Qur’an 51:19";

"discovery.card.ayah_51_56.title" = "Adh-Dhaariyat 56";
"discovery.card.ayah_51_56.meaning" = "Я сотворил джиннов и людей только для того, чтобы они поклонялись Мне.";
"discovery.card.ayah_51_56.source" = "Qur’an 51:56";

"discovery.card.ayah_52_21.title" = "At-Tur 21";
"discovery.card.ayah_52_21.meaning" = "Мы воссоединим верующих с их потомками, которые последовали за ними в вере, и нисколько не умалим их деяний. Каждый человек является заложником того, что он приобрел.";
"discovery.card.ayah_52_21.source" = "Qur’an 52:21";

"discovery.card.ayah_53_32.title" = "An-Najm 32";
"discovery.card.ayah_53_32.meaning" = "Они избегают великих грехов и мерзостей, кроме мелких и немногочисленных проступков. Воистину, твой Господь обладает необъятным прощением. Ему было лучше знать о вас, когда Он сотворил вас из земли и когда вы были зародышами в утробах ваших матерей. Не восхваляйте самих себя, ибо Ему лучше знать тех, кто богобоязнен.";
"discovery.card.ayah_53_32.source" = "Qur’an 53:32";

"discovery.card.ayah_53_39.title" = "An-Najm 39";
"discovery.card.ayah_53_39.meaning" = "Человек получит только то, к чему он стремился.";
"discovery.card.ayah_53_39.source" = "Qur’an 53:39";

"discovery.card.ayah_54_17.title" = "Al-Qamar 17";
"discovery.card.ayah_54_17.meaning" = "Мы облегчили Коран для поминания. Но есть ли среди вас вспоминающие?";
"discovery.card.ayah_54_17.source" = "Qur’an 54:17";

"discovery.card.ayah_55_1.title" = "Ar-Rahmaan 1";
"discovery.card.ayah_55_1.meaning" = "Милостивый";
"discovery.card.ayah_55_1.source" = "Qur’an 55:1";

"discovery.card.ayah_55_46.title" = "Ar-Rahmaan 46";
"discovery.card.ayah_55_46.meaning" = "Тем же, которые боялись предстать перед своим Господом, уготовано два сада.";
"discovery.card.ayah_55_46.source" = "Qur’an 55:46";

"discovery.card.ayah_56_10.title" = "Al-Waaqia 10";
"discovery.card.ayah_56_10.meaning" = "И будут опередившие их всех в добре, которые опередят их и в Раю.";
"discovery.card.ayah_56_10.source" = "Qur’an 56:10";

"discovery.card.ayah_57_16.title" = "Al-Hadid 16";
"discovery.card.ayah_57_16.meaning" = "Разве не пришло время для того, чтобы сердца верующих смирились при упоминании Аллаха и того, что ниспослано из истины, и чтобы не уподоблялись они тем, которым Писание было даровано прежде, чьи сердца почерствели по прошествии долгого времени и многие из которых являются нечестивцами?";
"discovery.card.ayah_57_16.source" = "Qur’an 57:16";

"discovery.card.ayah_57_20.title" = "Al-Hadid 20";
"discovery.card.ayah_57_20.meaning" = "Знайте, что мирская жизнь - всего лишь игра и потеха, украшение и похвальба между вами, а также стремление обрести побольше богатства и детей. Она подобна дождю, растения после которого восхищают земледельцев, но потом они высыхают, и ты видишь их пожелтевшими, после чего они превращаются в труху. А в Последней жизни есть тяжкие мучения и прощение от Аллаха и довольство. Мирская жизнь - всего лишь предмет обольщения.";
"discovery.card.ayah_57_20.source" = "Qur’an 57:20";

"discovery.card.ayah_57_21.title" = "Al-Hadid 21";
"discovery.card.ayah_57_21.meaning" = "Стремитесь же к прощению от вашего Господа и Раю, ширина которого подобна ширине неба и земли. Он уготован для тех, которые уверовали в Аллаха и Его посланников. Такова милость Аллаха, которую Он дарует тем, кому пожелает. Аллах обладает великой милостью.";
"discovery.card.ayah_57_21.source" = "Qur’an 57:21";

"discovery.card.ayah_58_11.title" = "Al-Mujaadila 11";
"discovery.card.ayah_58_11.meaning" = "О те, которые уверовали! Когда вас просят на собраниях сесть пошире, то садитесь пошире, и Аллах одарит вас местом просторным. Когда же вам велят подняться, то поднимайтесь. Аллах возвышает по степеням тех из вас, кто уверовал, и тех, кому даровано знание. Аллах ведает о том, что вы совершаете.";
"discovery.card.ayah_58_11.source" = "Qur’an 58:11";

"discovery.card.ayah_59_9.title" = "Al-Hashr 9";
"discovery.card.ayah_59_9.meaning" = "А те, которые жили в доме (Медине) и обрели веру до них, любят переселившихся к ним и не ощущают никакой нужды к тому, что даровано им. Они отдают им предпочтение перед собой, даже если они сами нуждаются. А те, кто уберегся от собственной скупости, являются преуспевшими.";
"discovery.card.ayah_59_9.source" = "Qur’an 59:9";

"discovery.card.ayah_59_18.title" = "Al-Hashr 18";
"discovery.card.ayah_59_18.meaning" = "О те, которые уверовали! Бойтесь Аллаха, и пусть душа посмотрит, что она приготовила на завтрашний день. Бойтесь Аллаха, ведь Аллах ведает о том, что вы совершаете.";
"discovery.card.ayah_59_18.source" = "Qur’an 59:18";

"discovery.card.ayah_59_22.title" = "Al-Hashr 22";
"discovery.card.ayah_59_22.meaning" = "Он - Аллах, и нет божества, кроме Него, Ведающего сокровенное и явное. Он - Милостивый, Милосердный.";
"discovery.card.ayah_59_22.source" = "Qur’an 59:22";

"discovery.card.ayah_61_2.title" = "As-Saff 2";
"discovery.card.ayah_61_2.meaning" = "О те, которые уверовали! Почему вы говорите то, чего не делаете?";
"discovery.card.ayah_61_2.source" = "Qur’an 61:2";

"discovery.card.ayah_61_10.title" = "As-Saff 10";
"discovery.card.ayah_61_10.meaning" = "О те, которые уверовали! Указать ли вам на торговлю, которая спасет вас от мучительных страданий?";
"discovery.card.ayah_61_10.source" = "Qur’an 61:10";

"discovery.card.ayah_61_13.title" = "As-Saff 13";
"discovery.card.ayah_61_13.meaning" = "Будет еще то, что вы любите: помощь от Аллаха и близкая победа. Сообщи же благую весть верующим!";
"discovery.card.ayah_61_13.source" = "Qur’an 61:13";

"discovery.card.ayah_62_9.title" = "Al-Jumu'a 9";
"discovery.card.ayah_62_9.meaning" = "О те, которые уверовали! Когда призывают на намаз в пятничный день, то устремляйтесь к поминанию Аллаха и оставьте торговлю. Так будет лучше для вас, если бы вы только знали.";
"discovery.card.ayah_62_9.source" = "Qur’an 62:9";

"discovery.card.ayah_62_10.title" = "Al-Jumu'a 10";
"discovery.card.ayah_62_10.meaning" = "Когда же намаз завершится, то разойдитесь по земле, ищите милость Аллаха и часто поминайте Его, - быть может, вы преуспеете.";
"discovery.card.ayah_62_10.source" = "Qur’an 62:10";

"discovery.card.ayah_63_9.title" = "Al-Munaafiqoon 9";
"discovery.card.ayah_63_9.meaning" = "О те, которые уверовали! Пусть ваше имущество и ваши дети не отвлекают вас от поминания Аллаха. А те, которые поступают таким образом, окажутся потерпевшими убыток.";
"discovery.card.ayah_63_9.source" = "Qur’an 63:9";

"discovery.card.ayah_64_16.title" = "At-Taghaabun 16";
"discovery.card.ayah_64_16.meaning" = "Бойтесь Аллаха по мере своих возможностей, слушайте, повинуйтесь и расходуйте во благо самим себе. А те, кто уберегся от собственной скупости, являются преуспевшими.";
"discovery.card.ayah_64_16.source" = "Qur’an 64:16";

"discovery.card.ayah_65_4.title" = "At-Talaaq 4";
"discovery.card.ayah_65_4.meaning" = "Для тех из ваших женщин, у которых прекратились менструации, если вы сомневаетесь, установленный для развода срок равен трем месяцам, как и для тех, у которых не было менструаций. Для беременных срок установлен до тех пор, пока они не разрешатся от бремени. Тому, кто боится Аллаха, Он облегчает дела.";
"discovery.card.ayah_65_4.source" = "Qur’an 65:4";

"discovery.card.ayah_66_8.title" = "At-Tahrim 8";
"discovery.card.ayah_66_8.meaning" = "О те, которые уверовали! Раскаивайтесь перед Аллахом искренне! Может быть, ваш Господь простит ваши злодеяния и введет вас в Райские сады, в которых текут реки, в тот день, когда Аллах не опозорит Пророка и тех, кто уверовал вместе с ним. Их свет будет сиять перед ними и справа. Они скажут: «Господь наш! Дай нам света сполна и прости нас. Воистину, Ты способен на всякую вещь».";
"discovery.card.ayah_66_8.source" = "Qur’an 66:8";

"discovery.card.ayah_67_1.title" = "Al-Mulk 1";
"discovery.card.ayah_67_1.meaning" = "Благословен Тот, в Чьей Руке власть, Кто способен на всякую вещь,";
"discovery.card.ayah_67_1.source" = "Qur’an 67:1";

"discovery.card.ayah_67_14.title" = "Al-Mulk 14";
"discovery.card.ayah_67_14.meaning" = "Неужели этого не будет знать Тот, Кто сотворил, если Он - Проницательный (или Добрый), Ведающий?";
"discovery.card.ayah_67_14.source" = "Qur’an 67:14";

"discovery.card.ayah_67_15.title" = "Al-Mulk 15";
"discovery.card.ayah_67_15.meaning" = "Он - Тот, Кто сделал для вас землю покорной. Ступайте же по свету и вкушайте из Его удела, и к Нему вы явитесь после воскрешения.";
"discovery.card.ayah_67_15.source" = "Qur’an 67:15";

"discovery.card.ayah_68_4.title" = "Al-Qalam 4";
"discovery.card.ayah_68_4.meaning" = "Воистину, твой нрав превосходен.";
"discovery.card.ayah_68_4.source" = "Qur’an 68:4";

"discovery.card.ayah_70_19.title" = "Al-Ma'aarij 19";
"discovery.card.ayah_70_19.meaning" = "Воистину, человек создан нетерпеливым,";
"discovery.card.ayah_70_19.source" = "Qur’an 70:19";

"discovery.card.ayah_73_20.title" = "Al-Muzzammil 20";
"discovery.card.ayah_73_20.meaning" = "Воистину, твой Господь знает, что ты и часть тех, кто с тобой, простаиваете менее двух третей ночи, или половину ее, или треть ее. Аллах определяет меру дня и ночи. Он знает, что вам не сосчитать этого, и принимает ваши покаяния. Читайте же из Корана то, что необременительно для вас. Он знает, что среди вас будут больные, что одни странствуют по земле в поисках милости Аллаха, а другие сражаются на пути Аллаха. Читайте же из него то, что необременительно для вас, совершайте намаз, раздавайте закят и одолжите Аллаху прекрасный заем. Какое бы добро вы ни приготовили для себя заранее, вы найдете его у Аллаха в виде лучшего и большего вознаграждения. Просите же у Аллаха прощения, ведь Аллах - Прощающий, Милосердный.";
"discovery.card.ayah_73_20.source" = "Qur’an 73:20";

"discovery.card.ayah_74_3.title" = "Al-Muddaththir 3";
"discovery.card.ayah_74_3.meaning" = "Господа своего величай!";
"discovery.card.ayah_74_3.source" = "Qur’an 74:3";

"discovery.card.ayah_76_8.title" = "Al-Insaan 8";
"discovery.card.ayah_76_8.meaning" = "Они дают пищу беднякам, сиротам и пленникам, несмотря на то, что она желанна и для них самих.";
"discovery.card.ayah_76_8.source" = "Qur’an 76:8";

"discovery.card.ayah_76_9.title" = "Al-Insaan 9";
"discovery.card.ayah_76_9.meaning" = "Они говорят: «Мы кормим вас лишь ради Лика Аллаха и не хотим от вас ни награды, ни благодарности!";
"discovery.card.ayah_76_9.source" = "Qur’an 76:9";

"discovery.card.ayah_87_1.title" = "Al-A'laa 1";
"discovery.card.ayah_87_1.meaning" = "Славь имя Господа твоего Всевышнего,";
"discovery.card.ayah_87_1.source" = "Qur’an 87:1";

"discovery.card.ayah_87_14.title" = "Al-A'laa 14";
"discovery.card.ayah_87_14.meaning" = "Преуспел тот, кто очистился,";
"discovery.card.ayah_87_14.source" = "Qur’an 87:14";

"discovery.card.ayah_89_27.title" = "Al-Fajr 27";
"discovery.card.ayah_89_27.meaning" = "О обретшая покой душа!";
"discovery.card.ayah_89_27.source" = "Qur’an 89:27";

"discovery.card.ayah_89_28.title" = "Al-Fajr 28";
"discovery.card.ayah_89_28.meaning" = "Вернись к своему Господу удовлетворенной и снискавшей довольство!";
"discovery.card.ayah_89_28.source" = "Qur’an 89:28";

"discovery.card.ayah_90_12.title" = "Al-Balad 12";
"discovery.card.ayah_90_12.meaning" = "Откуда ты мог знать, что такое крутая тропа?";
"discovery.card.ayah_90_12.source" = "Qur’an 90:12";

"discovery.card.ayah_90_13.title" = "Al-Balad 13";
"discovery.card.ayah_90_13.meaning" = "Это - освобождение раба";
"discovery.card.ayah_90_13.source" = "Qur’an 90:13";

"discovery.card.ayah_91_9.title" = "Ash-Shams 9";
"discovery.card.ayah_91_9.meaning" = "Преуспел тот, кто очистил ее,";
"discovery.card.ayah_91_9.source" = "Qur’an 91:9";

"discovery.card.ayah_92_5.title" = "Al-Lail 5";
"discovery.card.ayah_92_5.meaning" = "Тому, кто отдавал должное (или раздавал милостыню) и был богобоязнен,";
"discovery.card.ayah_92_5.source" = "Qur’an 92:5";

"discovery.card.ayah_92_18.title" = "Al-Lail 18";
"discovery.card.ayah_92_18.meaning" = "который раздает свое имущество, очищаясь,";
"discovery.card.ayah_92_18.source" = "Qur’an 92:18";

"discovery.card.ayah_93_5.title" = "Ad-Dhuhaa 5";
"discovery.card.ayah_93_5.meaning" = "Господь твой непременно одарит тебя, и ты будешь удовлетворен.";
"discovery.card.ayah_93_5.source" = "Qur’an 93:5";

"discovery.card.ayah_93_6.title" = "Ad-Dhuhaa 6";
"discovery.card.ayah_93_6.meaning" = "Разве Он не нашел тебя сиротой и не дал тебе приют?";
"discovery.card.ayah_93_6.source" = "Qur’an 93:6";

"discovery.card.ayah_93_7.title" = "Ad-Dhuhaa 7";
"discovery.card.ayah_93_7.meaning" = "Он нашел тебя заблудшим и повел прямым путем.";
"discovery.card.ayah_93_7.source" = "Qur’an 93:7";

"discovery.card.ayah_93_8.title" = "Ad-Dhuhaa 8";
"discovery.card.ayah_93_8.meaning" = "Он нашел тебя бедным и обогатил.";
"discovery.card.ayah_93_8.source" = "Qur’an 93:8";

"discovery.card.ayah_93_10.title" = "Ad-Dhuhaa 10";
"discovery.card.ayah_93_10.meaning" = "И не гони просящего!";
"discovery.card.ayah_93_10.source" = "Qur’an 93:10";

"discovery.card.ayah_93_11.title" = "Ad-Dhuhaa 11";
"discovery.card.ayah_93_11.meaning" = "И возвещай о милости своего Господа.";
"discovery.card.ayah_93_11.source" = "Qur’an 93:11";

"discovery.card.ayah_94_6.title" = "Ash-Sharh 6";
"discovery.card.ayah_94_6.meaning" = "За каждой тягостью наступает облегчение.";
"discovery.card.ayah_94_6.source" = "Qur’an 94:6";

"discovery.card.ayah_94_7.title" = "Ash-Sharh 7";
"discovery.card.ayah_94_7.meaning" = "Посему, как только освободишься, будь деятелен (как только освободишься от мирских дел, усердно поклоняйся Аллаху, или как только завершишь намаз, усердно взывай к Аллаху с молитвами)";
"discovery.card.ayah_94_7.source" = "Qur’an 94:7";

"discovery.card.ayah_94_8.title" = "Ash-Sharh 8";
"discovery.card.ayah_94_8.meaning" = "и устремись к своему Господу.";
"discovery.card.ayah_94_8.source" = "Qur’an 94:8";

"discovery.card.ayah_95_4.title" = "At-Tin 4";
"discovery.card.ayah_95_4.meaning" = "Мы сотворили человека в прекраснейшем облике.";
"discovery.card.ayah_95_4.source" = "Qur’an 95:4";

"discovery.card.ayah_96_1.title" = "Al-Alaq 1";
"discovery.card.ayah_96_1.meaning" = "Читай во имя твоего Господа, Который сотворил все сущее,";
"discovery.card.ayah_96_1.source" = "Qur’an 96:1";

"discovery.card.ayah_96_5.title" = "Al-Alaq 5";
"discovery.card.ayah_96_5.meaning" = "научил человека тому, чего тот не знал.";
"discovery.card.ayah_96_5.source" = "Qur’an 96:5";

"discovery.card.ayah_97_1.title" = "Al-Qadr 1";
"discovery.card.ayah_97_1.meaning" = "Воистину, Мы ниспослали его (Коран) в ночь предопределения (или величия).";
"discovery.card.ayah_97_1.source" = "Qur’an 97:1";

"discovery.card.ayah_97_5.title" = "Al-Qadr 5";
"discovery.card.ayah_97_5.meaning" = "Она благополучна вплоть до наступления зари.";
"discovery.card.ayah_97_5.source" = "Qur’an 97:5";

"discovery.card.ayah_99_7.title" = "Az-Zalzala 7";
"discovery.card.ayah_99_7.meaning" = "Тот, кто сделал добро весом в мельчайшую частицу, увидит его.";
"discovery.card.ayah_99_7.source" = "Qur’an 99:7";

"discovery.card.ayah_99_8.title" = "Az-Zalzala 8";
"discovery.card.ayah_99_8.meaning" = "И тот, кто сделал зло весом в мельчайшую частицу, увидит его.";
"discovery.card.ayah_99_8.source" = "Qur’an 99:8";

"discovery.card.ayah_102_1.title" = "At-Takaathur 1";
"discovery.card.ayah_102_1.meaning" = "Страсть к приумножению (похвальба богатством и детьми) увлекает вас";
"discovery.card.ayah_102_1.source" = "Qur’an 102:1";

"discovery.card.ayah_102_8.title" = "At-Takaathur 8";
"discovery.card.ayah_102_8.meaning" = "В тот день вы будете спрошены о благах.";
"discovery.card.ayah_102_8.source" = "Qur’an 102:8";

"discovery.card.ayah_103_3.title" = "Al-Asr 3";
"discovery.card.ayah_103_3.meaning" = "кроме тех, которые уверовали, совершали праведные деяния, заповедали друг другу истину и заповедали друг другу терпение!";
"discovery.card.ayah_103_3.source" = "Qur’an 103:3";

"discovery.card.ayah_107_1.title" = "Al-Maa'un 1";
"discovery.card.ayah_107_1.meaning" = "Видел ли ты того, кто считает ложью воздаяние?";
"discovery.card.ayah_107_1.source" = "Qur’an 107:1";

"discovery.card.ayah_107_4.title" = "Al-Maa'un 4";
"discovery.card.ayah_107_4.meaning" = "Горе молящимся,";
"discovery.card.ayah_107_4.source" = "Qur’an 107:4";

"discovery.card.ayah_110_1.title" = "An-Nasr 1";
"discovery.card.ayah_110_1.meaning" = "Когда придет помощь Аллаха и настанет победа,";
"discovery.card.ayah_110_1.source" = "Qur’an 110:1";

"discovery.card.ayah_110_3.title" = "An-Nasr 3";
"discovery.card.ayah_110_3.meaning" = "восславь же хвалой Господа своего и попроси у Него прощения. Воистину, Он - Принимающий покаяния.";
"discovery.card.ayah_110_3.source" = "Qur’an 110:3";

"discovery.card.ayah_112_2.title" = "Al-Ikhlaas 2";
"discovery.card.ayah_112_2.meaning" = "Аллах Самодостаточный.";
"discovery.card.ayah_112_2.source" = "Qur’an 112:2";

"discovery.card.ayah_112_3.title" = "Al-Ikhlaas 3";
"discovery.card.ayah_112_3.meaning" = "Он не родил и не был рожден,";
"discovery.card.ayah_112_3.source" = "Qur’an 112:3";

"discovery.card.ayah_112_4.title" = "Al-Ikhlaas 4";
"discovery.card.ayah_112_4.meaning" = "и нет никого равного Ему».";
"discovery.card.ayah_112_4.source" = "Qur’an 112:4";

"discovery.card.sunnah_bukhari_10.title" = "Сахих аль-Бухари 10";
"discovery.card.sunnah_bukhari_10.meaning" = "Нам рассказал Адам ибн Абу Ияас, сказавший: Нам рассказал Шу‘ба, от ‘Абдуллаха ибн Абу ас-Сафара и Исма‘иля ибн Абу Халида от Аш-Ша‘би, от ‘Абдуллаха ибн ‘Амра, да будет доволен Аллах ими обоими, что Пророк ﷺ сказал: «Мусульманин — это тот, кто не причиняет (другим) мусульманам вреда своим языком и своими руками, мухаджиром же является тот, кто прекратил (совершать) запрещённое Аллахом»";
"discovery.card.sunnah_bukhari_10.source" = "Sahih al-Bukhari 10";

"discovery.card.sunnah_bukhari_11.title" = "Сахих аль-Бухари 11";
"discovery.card.sunnah_bukhari_11.meaning" = "Нам рассказал Са‘ид ибн Яхья ибн Са‘ид аль-Кураший, сказавший: Нам рассказал мой отец, сказавший: Нам рассказал Абу Бурда ибн ‘Абдулла ибн Абу Бурда от Абу Бурды, от Абу Мусы, да будет доволен им Аллах, что он сказал: «(Однажды люди) спросили: “О Посланник Аллаха, чей Ислам является наилучшим?” Он ответил: “(Ислам) того, кто не причиняет (другим) мусульманам вреда своим языком и своими руками”»";
"discovery.card.sunnah_bukhari_11.source" = "Sahih al-Bukhari 11";

"discovery.card.sunnah_bukhari_12.title" = "Сахих аль-Бухари 12";
"discovery.card.sunnah_bukhari_12.meaning" = "Нам рассказал ‘Амр ибн Халид, сказавший: Нам рассказал Аль-Лейс, от Язида, от Абу аль-Хайра от ‘Абдуллаха ибн ‘Амра, да будет доволен Аллах ими обоими, о том что: «Один человек спросил Пророка ﷺ: “Какое проявление Ислама является наилучшим?” Он ответил: “(Лучшее состоит в том, чтобы) ты кормил (людей) и приветствовал тех, кого знаешь и кого не знаешь”»";
"discovery.card.sunnah_bukhari_12.source" = "Sahih al-Bukhari 12";

"discovery.card.sunnah_bukhari_13.title" = "Сахих аль-Бухари 13";
"discovery.card.sunnah_bukhari_13.meaning" = "Нам рассказал Мусаддад, сказавший: Нам рассказал Яхья, от Шу‘бы, от Катады, от Анаса, да будет доволен им Аллах, от Пророка ﷺ о том что он сказал: «Не уверует никто из вас до тех пор, пока не станет желать своему брату (в Исламе) того же, чего желает самому себе»";
"discovery.card.sunnah_bukhari_13.source" = "Sahih al-Bukhari 13";

"discovery.card.sunnah_bukhari_14.title" = "Сахих аль-Бухари 14";
"discovery.card.sunnah_bukhari_14.meaning" = "Передают со слов Абу Хурайры, да будет доволен им Аллах, что Посланник Аллаха ﷺ сказал: «Клянусь Тем, в Чьей длани душа моя, не уверует никто из вас, пока не станет любить меня больше, чем любит своего отца и своих детей»";
"discovery.card.sunnah_bukhari_14.source" = "Sahih al-Bukhari 14";

"discovery.card.sunnah_bukhari_15.title" = "Сахих аль-Бухари 15";
"discovery.card.sunnah_bukhari_15.meaning" = "Сообщается, что Анас, да будет доволен им Аллах, сказал: «Пророк ﷺ сказал: “Не уверует никто из вас, пока не станет любить меня больше, чем любит своего отца, и своих детей, и всех людей вообще”»";
"discovery.card.sunnah_bukhari_15.source" = "Sahih al-Bukhari 15";

"discovery.card.sunnah_bukhari_17.title" = "Сахих аль-Бухари 17";
"discovery.card.sunnah_bukhari_17.meaning" = "Передают со слов Анаса, да будет доволен им Аллах, что Пророк ﷺ сказал: «Признаком веры является любовь к ансарам, а признаком лицемерия — ненависть (по отношению к ним)»";
"discovery.card.sunnah_bukhari_17.source" = "Sahih al-Bukhari 17";

"discovery.card.sunnah_bukhari_19.title" = "Сахих аль-Бухари 19";
"discovery.card.sunnah_bukhari_19.meaning" = "Сообщается, что Абу Са‘ид аль-Худри, да будет доволен им Аллах, сказал:\\n«Посланник Аллаха ﷺ сказал: “Скоро наступит время, когда лучшим имуществом мусульманина окажутся овцы, с которыми он будет скитаться по горным вершинам и тем местам, где выпадают дожди, убегая от искушений со своей религией”»";
"discovery.card.sunnah_bukhari_19.source" = "Sahih al-Bukhari 19";

"discovery.card.sunnah_bukhari_24.title" = "Сахих аль-Бухари 24";
"discovery.card.sunnah_bukhari_24.meaning" = "Передают со слов Салима ибн ‘Абдуллаха, передавшего со слов своего отца (Ибн ‘Умара, да будет доволен Аллах ими обоими.) о том, что (как-то раз), проходя мимо одного из ансаров, который давал своему брату наставления относительно стыдливости, Посланник Аллаха ﷺ сказал ему: «Оставь его, ибо, поистине, стыдливость — от веры!»";
"discovery.card.sunnah_bukhari_24.source" = "Sahih al-Bukhari 24";

"discovery.card.sunnah_bukhari_28.title" = "Сахих аль-Бухари 28";
"discovery.card.sunnah_bukhari_28.meaning" = "Сообщается, что ‘Абдуллах ибн ‘Амр, да будет доволен Аллах ими обоими, сказал: «Один человек спросил Посланника Аллаха ﷺ: “Какое проявление Ислама является наилучшим?” Он ответил: “(Лучшее состоит в том, чтобы) ты кормил (людей) и приветствовал тех, кого знаешь и кого не знаешь”»";
"discovery.card.sunnah_bukhari_28.source" = "Sahih al-Bukhari 28";

"discovery.card.sunnah_bukhari_35.title" = "Сахих аль-Бухари 35";
"discovery.card.sunnah_bukhari_35.meaning" = "Сообщается, что Абу Хурайра, да будет доволен им Аллах, сказал: «Посланник Аллаха ﷺ сказал: “Тому, кто проведёт в молитве ночь предопределения с верой и надеждой на награду Аллаха, простятся его прежние грехи”»";
"discovery.card.sunnah_bukhari_35.source" = "Sahih al-Bukhari 35";

"discovery.card.sunnah_bukhari_37.title" = "Сахих аль-Бухари 37";
"discovery.card.sunnah_bukhari_37.meaning" = "Передают со слов Абу Хурайры, да будет доволен им Аллах, что Посланник Аллаха ﷺ сказал: «Тому, кто во время рамадана будет молиться по ночам с верой и надеждой на награду Аллаха, простятся его прежние грехи»";
"discovery.card.sunnah_bukhari_37.source" = "Sahih al-Bukhari 37";

"discovery.card.sunnah_bukhari_38.title" = "Сахих аль-Бухари 38";
"discovery.card.sunnah_bukhari_38.meaning" = "Сообщается, что Абу Хурайра, да будет доволен им Аллах, сказал: «Посланник Аллаха ﷺ сказал: “Тому, кто во время рамадана будет поститься с верой и надеждой на награду Аллаха, простятся его прежние грехи”»";
"discovery.card.sunnah_bukhari_38.source" = "Sahih al-Bukhari 38";

"discovery.card.sunnah_bukhari_42.title" = "Сахих аль-Бухари 42";
"discovery.card.sunnah_bukhari_42.meaning" = "Сообщается, что Абу Хурайра, да будет доволен им Аллах, сказал: «Если кто-то из вас будет исповедовать Ислам хорошо, то за каждое благое дело, которое он совершит, ему запишут от десяти до семиста подобных (дел). А за каждое дурное дело, которое он совершит, ему запишут подобное этому (дурному делу)»";
"discovery.card.sunnah_bukhari_42.source" = "Sahih al-Bukhari 42";

"discovery.card.sunnah_bukhari_48.title" = "Сахих аль-Бухари 48";
"discovery.card.sunnah_bukhari_48.meaning" = "Передают со слов ‘Абдуллаха ибн Маc‘уда, да будет доволен им Аллах, что Пророк ﷺ сказал: «Поношение мусульманина есть (проявление) нечестия, а сражение с ним — (свидетельство) неверия»";
"discovery.card.sunnah_bukhari_48.source" = "Sahih al-Bukhari 48";

"discovery.card.sunnah_bukhari_55.title" = "Сахих аль-Бухари 55";
"discovery.card.sunnah_bukhari_55.meaning" = "Передают со слов Абу Мас‘уда, да будет доволен им Аллах, что Пророк ﷺ сказал: «Если человек расходует (средства) на свою семью, надеясь только на награду Аллаха, это становится для него садакой»";
"discovery.card.sunnah_bukhari_55.source" = "Sahih al-Bukhari 55";

"discovery.card.sunnah_bukhari_56.title" = "Сахих аль-Бухари 56";
"discovery.card.sunnah_bukhari_56.meaning" = "Передают со слов Са‘да ибн Абу Ваккъаса о том, что Посланник Аллаха ﷺ сказал: «Поистине, ты обязательно получишь награду за всё то, что потратишь ради лика Аллаха, и даже за то, что положишь в рот своей жене»";
"discovery.card.sunnah_bukhari_56.source" = "Sahih al-Bukhari 56";

"discovery.card.sunnah_bukhari_57.title" = "Сахих аль-Бухари 57";
"discovery.card.sunnah_bukhari_57.meaning" = "Сообщается, что Джарир ибн ‘Абдуллах, да будет доволен им Аллах, сказал: «Я поклялся Пророку ﷺ в том, что буду совершать молитвы, выплачивать закят и сердечно относиться к каждому мусульманину»";
"discovery.card.sunnah_bukhari_57.source" = "Sahih al-Bukhari 57";

"discovery.card.sunnah_bukhari_68.title" = "Сахих аль-Бухари 68";
"discovery.card.sunnah_bukhari_68.meaning" = "Сообщается, что Ибн Мас‘уд, да будет доволен им Аллах, сказал: «Пророк ﷺ проявлял о нас заботу и обращался к нам с увещеваниями (лишь в отдельные) дни, не желая, чтобы (его слова) вызывали в нас скуку»";
"discovery.card.sunnah_bukhari_68.source" = "Sahih al-Bukhari 68";

"discovery.card.sunnah_bukhari_69.title" = "Сахих аль-Бухари 69";
"discovery.card.sunnah_bukhari_69.meaning" = "Передают со слов Анаса, да будет доволен им Аллах, что Пророк ﷺ сказал: «Облегчайте, а не создавайте затруднения, радуйте (людей) добрыми вестями, а не внушайте отвращение (к Исламу)»";
"discovery.card.sunnah_bukhari_69.source" = "Sahih al-Bukhari 69";

"discovery.card.sunnah_bukhari_75.title" = "Сахих аль-Бухари 75";
"discovery.card.sunnah_bukhari_75.meaning" = "Передают со слов ‘Икримы о том, что Ибн ‘Аббас, да будет доволен им Аллах, сказал: «(Однажды) Посланник Аллаха ﷺ обнял меня и сказал: “О Аллах, научи его Книге!”»";
"discovery.card.sunnah_bukhari_75.source" = "Sahih al-Bukhari 75";

"discovery.card.sunnah_bukhari_77.title" = "Сахих аль-Бухари 77";
"discovery.card.sunnah_bukhari_77.meaning" = "Сообщается, что Махмуд ибн ар-Раби‘, да будет доволен им Аллах, сказал: «Я запомнил, что (однажды), когда мне было пять лет, Пророк ﷺ брызнул мне в лицо водой, набрав её ртом из ведра»";
"discovery.card.sunnah_bukhari_77.source" = "Sahih al-Bukhari 77";

"discovery.card.sunnah_bukhari_94.title" = "Сахих аль-Бухари 94";
"discovery.card.sunnah_bukhari_94.meaning" = "Передают со слов Анаса, да будет доволен им Аллах: «Когда Пророк ﷺ обращался (к кому-либо) с салямом, то делал это три раза, а когда говорил что-нибудь (людям), он обычно повторял сказанное трижды»";
"discovery.card.sunnah_bukhari_94.source" = "Sahih al-Bukhari 94";

"discovery.card.sunnah_bukhari_95.title" = "Сахих аль-Бухари 95";
"discovery.card.sunnah_bukhari_95.meaning" = "Передают со слов Анаса, да будет доволен им Аллах: «Когда Пророк ﷺ говорил что-нибудь (людям), он обычно повторял сказанное трижды, чтобы его (правильно) понимали, а когда приходил к кому-нибудь, то приветствовал (хозяев дома тоже) три раза»";
"discovery.card.sunnah_bukhari_95.source" = "Sahih al-Bukhari 95";

"discovery.card.sunnah_bukhari_102.title" = "Сахих аль-Бухари 102";
"discovery.card.sunnah_bukhari_102.meaning" = "В другой версии этого хадиса, передаваемой со слов Абу Хурайры, да будет доволен им Аллах, сообщается, что Посланник Аллаха ﷺ сказал: «…трое детей, не достигших совершеннолетия…»";
"discovery.card.sunnah_bukhari_102.source" = "Sahih al-Bukhari 102";

"discovery.card.sunnah_bukhari_106.title" = "Сахих аль-Бухари 106";
"discovery.card.sunnah_bukhari_106.meaning" = "Сообщается, что ‘Али, да будет доволен им Аллах, сказал: «Пророк ﷺ сказал: “Не возводите на меня ложь, ибо, поистине, тот, кто возведёт на меня ложь, непременно попадёт в Огонь!”»";
"discovery.card.sunnah_bukhari_106.source" = "Sahih al-Bukhari 106";

"discovery.card.sunnah_bukhari_108.title" = "Сахих аль-Бухари 108";
"discovery.card.sunnah_bukhari_108.meaning" = "Сообщается, что Анас сказал: «Поистине, рассказывать вам множество хадисов мне мешает (лишь то), что Пророк ﷺ сказал: “Тот, кто возведет на меня ложь, непременно займёт своё место в огне!”»";
"discovery.card.sunnah_bukhari_108.source" = "Sahih al-Bukhari 108";

"discovery.card.sunnah_bukhari_109.title" = "Сахих аль-Бухари 109";
"discovery.card.sunnah_bukhari_109.meaning" = "Сообщается, что Саляма (ибн аль-Акъва‘, да будет доволен им Аллах,) сказал: «Я слышал, как Пророк ﷺ сказал: “Пусть займёт своё место в Огне тот, который станет приписывать мне то, чего я не говорил!”»";
"discovery.card.sunnah_bukhari_109.source" = "Sahih al-Bukhari 109";

"discovery.card.sunnah_bukhari_113.title" = "Сахих аль-Бухари 113";
"discovery.card.sunnah_bukhari_113.meaning" = "Сообщается, что Абу Хурайра, да будет доволен им Аллах, сказал: «Ни один из сподвижников Пророка ﷺ не запомнил от него столько хадисов, сколько запомнил я, если не считать ‘Абудуллы ибн ‘Амра, ибо, поистине, он записывал (их), а я не делал этого»";
"discovery.card.sunnah_bukhari_113.source" = "Sahih al-Bukhari 113";

"discovery.card.sunnah_bukhari_120.title" = "Сахих аль-Бухари 120";
"discovery.card.sunnah_bukhari_120.meaning" = "Сообщается, что Абу Хурайра, да будет доволен им Аллах, сказал: «Из (сказанного) Посланником Аллаха ﷺ я запомнил (то, что относится к) двум видам знания. Что касается первого, то я распространил его (среди людей), что же касается второго, то, если бы я распространил и его, (мне) обязательно перерезали бы горло!»";
"discovery.card.sunnah_bukhari_120.source" = "Sahih al-Bukhari 120";

"discovery.card.sunnah_bukhari_121.title" = "Сахих аль-Бухари 121";
"discovery.card.sunnah_bukhari_121.meaning" = "Передают со слов Джарира (ибн ‘Абдуллах), да будет доволен им Аллах, что во время прощального паломничества Пророк ﷺ велел ему: «Скажи людям, чтобы они молчали и слушали!», – после чего он сказал: «Не становитесь после меня неверными, которые рубят друг другу головы!»";
"discovery.card.sunnah_bukhari_121.source" = "Sahih al-Bukhari 121";

"discovery.card.sunnah_bukhari_127.title" = "Сахих аль-Бухари 127";
"discovery.card.sunnah_bukhari_127.meaning" = "Сообщается, что ‘Али, да будет доволен им Аллах, сказал: «Говорите с людьми о том, что им будет понятно. Неужели хотите вы, чтобы на Аллаха и Его посланника ﷺ стали возводить ложь?!»";
"discovery.card.sunnah_bukhari_127.source" = "Sahih al-Bukhari 127";

"discovery.card.sunnah_bukhari_132.title" = "Сахих аль-Бухари 132";
"discovery.card.sunnah_bukhari_132.meaning" = "Сообщается, что ‘Али, да будет доволен им Аллах, сказал:«Обычно у меня выделялась жидкость, и (однажды) я велел аль-Микъдаду спросить (об этом) Пророка ﷺ. (Аль-Микъдад) задал ему этот вопрос, и (Пророк ﷺ) сказал: “(В этом случае следует) совершить омовение /вудуъ/”»";
"discovery.card.sunnah_bukhari_132.source" = "Sahih al-Bukhari 132";

"discovery.card.sunnah_bukhari_137.title" = "Сахих аль-Бухари 137";
"discovery.card.sunnah_bukhari_137.meaning" = "Передают со слов ‘Аббада ибн Тамима, что его дядя по отцовской линии (‘Абдуллах ибн Зейд аль-Ансари, да будет доволен им Аллах, однажды) спросил Посланника Аллаха ﷺ о том (, что следует делать) человеку, которому показалось, что во время намаза он осквернился? (Пророк ﷺ) сказал: «Пусть не бросает /или: не прекращает/ (намаз), пока не услышит звук или не почувствует запах»";
"discovery.card.sunnah_bukhari_137.source" = "Sahih al-Bukhari 137";

"discovery.card.sunnah_bukhari_142.title" = "Сахих аль-Бухари 142";
"discovery.card.sunnah_bukhari_142.meaning" = "Сообщается, что ‘Абдуль-‘Азиз ибн Сухайб сказал:\\n– Я слышал, как Анас, да будет доволен им Аллах, говорил: «Собираясь зайти в отхожее место, Пророк ﷺ обычно говорил: “О Аллах, поистине, я прибегаю к Тебе от порочности и дурных поступков /Аллахумма, ин-ни а‘узу бика миналь-хубуси валь-хабаис/”». \\nГъундар сказал: «От аш-Шу‘бы: “Когда он приходил в отхожее место …”».\\nМуса сказал: «От Хаммада: “Когда он заходил …”».\\nСа‘ид ибн Зейд сказал: «Рассказал нам ‘Абдуль-‘Азиз: “Когда он собирался зайти …”»";
"discovery.card.sunnah_bukhari_142.source" = "Sahih al-Bukhari 142";

"discovery.card.sunnah_bukhari_143.title" = "Сахих аль-Бухари 143";
"discovery.card.sunnah_bukhari_143.meaning" = "Передают со слов Ибн ‘Аббаса, да будет доволен Аллах ими обоими, что (однажды,) когда Пророк ﷺ зашёл в отхожее место, он принёс ему воду для омовения. (Потом Пророк ﷺ) спросил: «Кто поставил (здесь) это?» Ему сообщили, (что это сделал я,) и тогда он сказал: «О Аллах, наставь его в религии!»";
"discovery.card.sunnah_bukhari_143.source" = "Sahih al-Bukhari 143";

"discovery.card.sunnah_bukhari_144.title" = "Сахих аль-Бухари 144";
"discovery.card.sunnah_bukhari_144.meaning" = "Сообщается, что Абу Аййюб аль-Ансари, да будет доволен им Аллах, сказал: «Посланник Аллаха ﷺ сказал: “Если кто-нибудь из вас станет справлять большую нужду (на открытом пространстве), пусть не обращается к кибле лицом и не поворачивается к ней спиной. Поворачивайтесь (лицом) к востоку или к западу”»";
"discovery.card.sunnah_bukhari_144.source" = "Sahih al-Bukhari 144";

"discovery.card.sunnah_bukhari_147.title" = "Сахих аль-Бухари 147";
"discovery.card.sunnah_bukhari_147.meaning" = "Передают со слов ‘Аиши о том, что Пророк ﷺ сказал: «Вам уже дозволено выходить по своей нужде». \\n(Один из передатчиков этого хадиса) Хишам сказал: «То есть для справления большой нужды»";
"discovery.card.sunnah_bukhari_147.source" = "Sahih al-Bukhari 147";

"discovery.card.sunnah_bukhari_148.title" = "Сахих аль-Бухари 148";
"discovery.card.sunnah_bukhari_148.meaning" = "Сообщается, что ‘Абдуллах ибн ‘Умар сказал: «(Однажды) я поднялся на крышу дома Хафсы по какому-то своему делу и увидел, как Посланник Аллаха ﷺ справлял нужду, повернувшись спиной в сторону киблы и лицом в сторону Шама»";
"discovery.card.sunnah_bukhari_148.source" = "Sahih al-Bukhari 148";

"discovery.card.sunnah_bukhari_149.title" = "Сахих аль-Бухари 149";
"discovery.card.sunnah_bukhari_149.meaning" = "Сообщается, что ‘Абдуллах ибн ‘Умар, да будет доволен Аллах ими обоими, сказал: «Однажды я забрался на крышу нашего дома и увидел Посланника Аллаха ﷺ присевшего по своей нужде на два необожжённых кирпича и повернувшегося в сторону Иерусалима»";
"discovery.card.sunnah_bukhari_149.source" = "Sahih al-Bukhari 149";

"discovery.card.sunnah_bukhari_150.title" = "Сахих аль-Бухари 150";
"discovery.card.sunnah_bukhari_150.meaning" = "Сообщается, что Абу Му‘аз, которого звали ‘Атаъ ибн Абу Маймуна сказал: «Я слышал, как Анас ибн Малик, да будет доволен им Аллах, говорил: “Когда Пророк ﷺ выходил по нужде, мы вместе с одним мальчиком несли за ним маленький кожаный бурдюк с водой”, имея ввиду, что он подмывался этой (водой)»";
"discovery.card.sunnah_bukhari_150.source" = "Sahih al-Bukhari 150";

"discovery.card.sunnah_bukhari_151.title" = "Сахих аль-Бухари 151";
"discovery.card.sunnah_bukhari_151.meaning" = "Сообщается, что Абу Му‘аз, которого звали ‘Атаъ ибн Абу Маймуна сказал: «Я слышал, как Анас ибн Малик, да будет доволен им Аллах, говорил: “Когда Посланник Аллаха ﷺ выходил по своей нужде, мы вместе с одним мальчиком следовали за ним, (неся) с собой маленький кожаный бурдюк с водой”»";
"discovery.card.sunnah_bukhari_151.source" = "Sahih al-Bukhari 151";

"discovery.card.sunnah_bukhari_153.title" = "Сахих аль-Бухари 153";
"discovery.card.sunnah_bukhari_153.meaning" = "Сообщается, что Абу Къатада, да будет доволен им Аллах, сказал: «Посланник Аллаха ﷺ сказал: “Когда кто-нибудь из вас будет пить, пусть не дышит в сосуд, если же зайдёт в отхожее место, пусть не дотрагивается до своего полового органа правой рукой и не подмывается правой рукой”»";
"discovery.card.sunnah_bukhari_153.source" = "Sahih al-Bukhari 153";

"discovery.card.sunnah_bukhari_154.title" = "Сахих аль-Бухари 154";
"discovery.card.sunnah_bukhari_154.meaning" = "Передают со слов Абу Къатады, да будет доволен им Аллах, что Пророк ﷺ сказал: «Когда кто-нибудь из вас будет мочиться, пусть ни в коем случае не берется за свой половой орган правой рукой, и пусть не подмывается правой рукой и пусть не дышит в сосуд (, когда будет пить)»";
"discovery.card.sunnah_bukhari_154.source" = "Sahih al-Bukhari 154";

"discovery.card.sunnah_bukhari_157.title" = "Сахих аль-Бухари 157";
"discovery.card.sunnah_bukhari_157.meaning" = "Сообщается, что Ибн ‘Аббас, да будет доволен Аллах ими обоими, сказал: «Пророк ﷺ омывал (каждую часть своего тела) по одному разу»";
"discovery.card.sunnah_bukhari_157.source" = "Sahih al-Bukhari 157";

"discovery.card.sunnah_bukhari_158.title" = "Сахих аль-Бухари 158";
"discovery.card.sunnah_bukhari_158.meaning" = "Передают со слов ‘Абдуллаха ибн Зейда аль-Ансари, да будет доволен им Аллах, о том, что Пророк ﷺ омывал (каждую часть своего тела) по два раза";
"discovery.card.sunnah_bukhari_158.source" = "Sahih al-Bukhari 158";

"discovery.card.sunnah_bukhari_161.title" = "Сахих аль-Бухари 161";
"discovery.card.sunnah_bukhari_161.meaning" = "Передают со слов Абу Хурайры, да будет доволен им Аллах, что Пророк ﷺ сказал: «Пусть тот, кто станет совершать омовение, промывает нос, и пусть тот, кто станет очищаться с помощью камней, делает это нечётное число раз»";
"discovery.card.sunnah_bukhari_161.source" = "Sahih al-Bukhari 161";

"discovery.card.sunnah_bukhari_165.title" = "Сахих аль-Бухари 165";
"discovery.card.sunnah_bukhari_165.meaning" = "Мухаммад ибн Зияд сказал: \\n— Я слышал, как Абу Хурайра, проходя мимо совершающих омовение людей, сказал: «Тщательно совершайте омовение, поистине, Абу аль-Касим ﷺ сказал: “Горе пяткам от (мук) огня!”»";
"discovery.card.sunnah_bukhari_165.source" = "Sahih al-Bukhari 165";

"discovery.card.sunnah_bukhari_167.title" = "Сахих аль-Бухари 167";
"discovery.card.sunnah_bukhari_167.meaning" = "Сообщается, что Умм ‘Атыййа, да будет доволен ею Аллах, сказала: «Когда они обмывали тело его дочери, да будет доволен ею Аллах, Пророк ﷺ сказал им: “Начинайте (обмывать тело) с правой стороны и с тех его частей, которые необходимо омывать при омовении /вудуъ/”»";
"discovery.card.sunnah_bukhari_167.source" = "Sahih al-Bukhari 167";

"discovery.card.sunnah_bukhari_168.title" = "Сахих аль-Бухари 168";
"discovery.card.sunnah_bukhari_168.meaning" = "Сообщается, что ‘Аиша, да будет доволен ею Аллах, сказала: «Пророку ﷺ нравилось надевать обувь, начиная с правой ноги, расчёсывать и умащать благовониями волосы и бороду, начиная справа, и совершать омовение, начиная с правой стороны тела, и поступать так же во всех остальных своих делах»";
"discovery.card.sunnah_bukhari_168.source" = "Sahih al-Bukhari 168";

"discovery.card.sunnah_bukhari_170.title" = "Сахих аль-Бухари 170";
"discovery.card.sunnah_bukhari_170.meaning" = "Сообщается, что Ибн Сирин сказал: «Однажды я сказал ‘Абиде: “У нас есть кое-что из волос Пророка ﷺ которые мы получили от Анаса или от его семьи”. Тогда он сказал: “Иметь у себя его волосы любимее для меня, чем этот мир и всё что в нём есть!”»";
"discovery.card.sunnah_bukhari_170.source" = "Sahih al-Bukhari 170";

"discovery.card.sunnah_bukhari_171.title" = "Сахих аль-Бухари 171";
"discovery.card.sunnah_bukhari_171.meaning" = "Передают со слов Анаса, да будет доволен им Аллах, что Абу Тальха был первым человеком, взявшим себе часть волос Посланника Аллаха ﷺ после того, как он (однажды) обрил себе голову";
"discovery.card.sunnah_bukhari_171.source" = "Sahih al-Bukhari 171";

"discovery.card.sunnah_bukhari_172.title" = "Сахих аль-Бухари 172";
"discovery.card.sunnah_bukhari_172.meaning" = "Сообщается, что Абу Хурайра, да будет доволен им Аллах, сказал: «Посланник Аллаха ﷺ сказал: “Если собака попьёт воды из сосуда кого-либо из вас, пусть он вымоет его семь раз”»";
"discovery.card.sunnah_bukhari_172.source" = "Sahih al-Bukhari 172";

"discovery.card.sunnah_bukhari_174.title" = "Сахих аль-Бухари 174";
"discovery.card.sunnah_bukhari_174.meaning" = "Сообщается, что Ибн Шихаб сказал: «Мне сообщил Хамза ибн ‘Абдуллах (ибн ‘Умар) со слов своего отца, который сказал: “При жизни Посланника Аллаха ﷺ собаки мочились (около мечети) и могли беспрепятственно заходить и входить в неё, и люди не поливали водой (те места, где они мочились)”»";
"discovery.card.sunnah_bukhari_174.source" = "Sahih al-Bukhari 174";

"discovery.card.sunnah_bukhari_177.title" = "Сахих аль-Бухари 177";
"discovery.card.sunnah_bukhari_177.meaning" = "Передают со слов ‘Аббада ибн Тамима о том, что его дядя по отцовской линии (‘Абдуллах ибн Зейд аль-Ансари, да будет доволен им Аллах,) передал, что однажды Пророк ﷺ сказал: «Пусть не не прекращает (молитву), пока не услышит звук или не почувствует запах»";
"discovery.card.sunnah_bukhari_177.source" = "Sahih al-Bukhari 177";

"discovery.card.sunnah_bukhari_178.title" = "Сахих аль-Бухари 178";
"discovery.card.sunnah_bukhari_178.meaning" = "Сообщается, что ‘Али, да будет доволен им Аллах, сказал: «Обычно у меня выделялась жидкость, но я стеснялся спросить Посланника Аллаха ﷺ. (Однажды) я велел аль-Микъдаду ибн аль-Асваду (спросить об этом Пророка ﷺ. И аль-Микъдад) задал ему этот вопрос, и (Пророк ﷺ) сказал: “(В этом случае следует) совершить омовение /вудуъ/”»";
"discovery.card.sunnah_bukhari_178.source" = "Sahih al-Bukhari 178";

"discovery.card.sunnah_bukhari_188.title" = "Сахих аль-Бухари 188";
"discovery.card.sunnah_bukhari_188.meaning" = "Сообщается, что Абу Муса, да будет доволен им Аллах, сказал: «Однажды Пророк ﷺ велел принести себе сосуд с водой, вымыл в нём руки и лицо, а затем сплюнул в него (воду), после чего сказал им: “Выпейте из него и налейте себе на лица и шеи”»";
"discovery.card.sunnah_bukhari_188.source" = "Sahih al-Bukhari 188";

"discovery.card.sunnah_bukhari_193.title" = "Сахих аль-Бухари 193";
"discovery.card.sunnah_bukhari_193.meaning" = "Сообщается, что ‘Абдуллах ибн ‘Умар, да будет доволен Аллах ими обоими, сказал: «При жизни Посланника Аллаха ﷺ мужчины и женщины совершали омовение совместно»";
"discovery.card.sunnah_bukhari_193.source" = "Sahih al-Bukhari 193";

"discovery.card.sunnah_bukhari_196.title" = "Сахих аль-Бухари 196";
"discovery.card.sunnah_bukhari_196.meaning" = "Передают со слов Абу Мусы, да будет доволен им Аллах, что однажды Пророк ﷺ велел принести себе сосуд с водой, вымыл в нём руки и лицо, а затем сплюнул в него воду, которой он полоскал себе рот";
"discovery.card.sunnah_bukhari_196.source" = "Sahih al-Bukhari 196";

"discovery.card.sunnah_bukhari_201.title" = "Сахих аль-Бухари 201";
"discovery.card.sunnah_bukhari_201.meaning" = "Сообщается, что Анас, да будет доволен им Аллах, сказал: «Обычно Пророк ﷺ купался (или: совершал полное омовение), расходуя на это от одного са‘ до пяти муддов (воды), на частичное же омовение он обычно расходовал (один) мудд (воды)»";
"discovery.card.sunnah_bukhari_201.source" = "Sahih al-Bukhari 201";

"discovery.card.sunnah_bukhari_204.title" = "Сахих аль-Бухари 204";
"discovery.card.sunnah_bukhari_204.meaning" = "Передают со слов Джа‘фара ибн ‘Амра ибн Умаййа ад-Дамри о том, что его отец, да будет доволен им Аллах, рассказывал ему, что он видел, как Пророк ﷺ протирал (влажными руками) кожаные носки(, завершая своё омовение)";
"discovery.card.sunnah_bukhari_204.source" = "Sahih al-Bukhari 204";

"discovery.card.sunnah_bukhari_205.title" = "Сахих аль-Бухари 205";
"discovery.card.sunnah_bukhari_205.meaning" = "Передают, что Джа‘фар ибн ‘Амр, со слов своего отца, да будет доволен им Аллах, рассказывал:«Я видел, как Пророк ﷺ протирал свою чалму и кожаные носки /хуфф/»";
"discovery.card.sunnah_bukhari_205.source" = "Sahih al-Bukhari 205";

"discovery.card.sunnah_bukhari_207.title" = "Сахих аль-Бухари 207";
"discovery.card.sunnah_bukhari_207.meaning" = "Передают со слов Абдуллаха ибн ‘Аббаса: «Посланник Аллаха ﷺ поел (мяса) от овечьей лопатки, а затем совершил молитву, не совершая омовение»";
"discovery.card.sunnah_bukhari_207.source" = "Sahih al-Bukhari 207";

"discovery.card.sunnah_bukhari_208.title" = "Сахих аль-Бухари 208";
"discovery.card.sunnah_bukhari_208.meaning" = "Передают со слов Джа‘фара ибн ‘Амра ибн Умаййи о том, что его отец, да будет доволен им Аллах, рассказывал ему, что однажды он видел, как Посланник Аллаха ﷺ отрезал себе кусок мяса от бараньей лопатки. В это время прозвучал призыв к молитве, и он бросил нож и стал молиться, не совершив омовения";
"discovery.card.sunnah_bukhari_208.source" = "Sahih al-Bukhari 208";

"discovery.card.sunnah_bukhari_210.title" = "Сахих аль-Бухари 210";
"discovery.card.sunnah_bukhari_210.meaning" = "Передают со слов Маймуны, да будет доволен ею Аллах, что (однажды) Пророк ﷺ съел у неё (в доме) баранью лопатку, а потом помолился, не совершив омовения";
"discovery.card.sunnah_bukhari_210.source" = "Sahih al-Bukhari 210";

"discovery.card.sunnah_bukhari_211.title" = "Сахих аль-Бухари 211";
"discovery.card.sunnah_bukhari_211.meaning" = "Передают со слов Ибн ‘Аббаса, да будет доволен Аллах ими обоими, что (однажды) Посланник Аллаха ﷺ выпил молока, а потом прополоскал рот и сказал: «Ведь оно содержит жир»";
"discovery.card.sunnah_bukhari_211.source" = "Sahih al-Bukhari 211";

"discovery.card.sunnah_bukhari_212.title" = "Сахих аль-Бухари 212";
"discovery.card.sunnah_bukhari_212.meaning" = "Передают со слов ‘Аиши, да будет доволен ею Аллах, что Посланник Аллаха ﷺ сказал:«Когда кого-нибудь из вас во время молитвы станет одолевать дремота, пусть поспит, пока сон его не пройдёт, ибо, поистине, если кто-нибудь из вас станет молиться, засыпая, он не будет знать(, что говорит), и может случиться так, что(, желая) попросить прощения у Аллаха, он (вместо этого) станет поносить самого себя»";
"discovery.card.sunnah_bukhari_212.source" = "Sahih al-Bukhari 212";

"discovery.card.sunnah_bukhari_213.title" = "Сахих аль-Бухари 213";
"discovery.card.sunnah_bukhari_213.meaning" = "Передают со слов Анаса, да будет доволен им Аллах, что Пророк ﷺ сказал:«Если кто-нибудь из вас станет дремать во время молитвы, пусть поспит, пока (сон его не пройдёт) и он не будет понимать, что читает»";
"discovery.card.sunnah_bukhari_213.source" = "Sahih al-Bukhari 213";

"discovery.card.sunnah_bukhari_214.title" = "Сахих аль-Бухари 214";
"discovery.card.sunnah_bukhari_214.meaning" = "Сообщается, что Суфйан (ас-Саури) сказал: «Рассказал мне ‘Амр ибн ‘Амир со слов Анаса, да будет доволен им Аллах, который сказал: “Обычно Пророк ﷺ совершал омовение перед каждой молитвой”».\\nЯ (‘Амр ибн ‘Амир) спросил: «А как поступали вы?» Он ответил: «Мы же довольствовались одним омовением, если не осквернялись»";
"discovery.card.sunnah_bukhari_214.source" = "Sahih al-Bukhari 214";

"discovery.card.sunnah_bukhari_217.title" = "Сахих аль-Бухари 217";
"discovery.card.sunnah_bukhari_217.meaning" = "Сообщается, что Анас ибн Малик, да будет доволен им Аллах, сказал: «Когда Пророк ﷺ выходил (из дома) по нужде, я приносил ему воду, которую он использовал для подмывания»";
"discovery.card.sunnah_bukhari_217.source" = "Sahih al-Bukhari 217";

"discovery.card.sunnah_bukhari_219.title" = "Сахих аль-Бухари 219";
"discovery.card.sunnah_bukhari_219.meaning" = "Передают со слов Анаса ибн Малика, да будет доволен им Аллах, о том, что однажды Пророк ﷺ увидев, что один бедуин мочится в мечети, сказал: «Оставьте его». Когда он закончил, (Пророк ﷺ) велел принести воды и вылить на это место";
"discovery.card.sunnah_bukhari_219.source" = "Sahih al-Bukhari 219";

"discovery.card.sunnah_bukhari_221.title" = "Сахих аль-Бухари 221";
"discovery.card.sunnah_bukhari_221.meaning" = "Рассказал нам Абдан, который сказал: Сообщил нам Абдуллах (ибн аль-Мубарак) который сказал: Сообщил нам Яхйа ибн Саид (аль-Ансари,) который сказал: «Я слышал, как Анас ибн Малик (рассказывал) от Пророка ﷺ»";
"discovery.card.sunnah_bukhari_221.source" = "Sahih al-Bukhari 221";

"discovery.card.sunnah_bukhari_222.title" = "Сахих аль-Бухари 222";
"discovery.card.sunnah_bukhari_222.meaning" = "Сообщается, что мать правоверных Аиша, да будет доволен ею Аллах, сказала: «Однажды Посланнику Аллаха ﷺ принесли мальчика, который помочился на его одежду. Тогда он попросил принести воды и полил на следы этой (мочи)»";
"discovery.card.sunnah_bukhari_222.source" = "Sahih al-Bukhari 222";

"discovery.card.sunnah_bukhari_224.title" = "Сахих аль-Бухари 224";
"discovery.card.sunnah_bukhari_224.meaning" = "Сообщается, что Хузайфа, да будет доволен им Аллах, сказал: «Однажды Пророк ﷺ подошёл к тому месту, куда люди сбрасывали мусор, и помочился стоя. Потом он велел принести воды, и когда я сделал это, он совершил омовение»";
"discovery.card.sunnah_bukhari_224.source" = "Sahih al-Bukhari 224";

"discovery.card.sunnah_bukhari_225.title" = "Сахих аль-Бухари 225";
"discovery.card.sunnah_bukhari_225.meaning" = "Сообщается, что Хузайфа, да будет доволен им Аллах, сказал: «Однажды, когда мы шли вместе с Пророком ﷺ я увидел, что он зашёл за стену в том месте, куда люди сбрасывали мусор, и стал так, как становится любой из вас, и помочился, а я удалился от него, но он подал мне знак, и тогда я встал сзади(, загораживая его,) и стоял так, пока он не закончил»";
"discovery.card.sunnah_bukhari_225.source" = "Sahih al-Bukhari 225";

"discovery.card.sunnah_bukhari_229.title" = "Сахих аль-Бухари 229";
"discovery.card.sunnah_bukhari_229.meaning" = "Сообщается, что ‘Аиша, да будет доволен ею Аллах, сказала: «(Обычно) я смывала (следы) осквернения /джанаба/ с одежды Пророка ﷺ после чего он выходил на молитву, (даже если) его одежда не просыхала полностью»";
"discovery.card.sunnah_bukhari_229.source" = "Sahih al-Bukhari 229";

"discovery.card.sunnah_bukhari_230.title" = "Сахих аль-Бухари 230";
"discovery.card.sunnah_bukhari_230.meaning" = "Сообщается, что Сулейман ибн Ясар сказал: «Однажды я спросил у ‘Аиши о семени, попавшей на одежду и она сказала: “(Обычно) я смывала её с одежды Посланника Аллаха ﷺ и он выходил на молитву, а на его одежде всё ещё были видны следы мытья”»";
"discovery.card.sunnah_bukhari_230.source" = "Sahih al-Bukhari 230";

"discovery.card.sunnah_bukhari_231.title" = "Сахих аль-Бухари 231";
"discovery.card.sunnah_bukhari_231.meaning" = "Сообщается, что ‘Амр ибн Маймун сказал:\\n— Я спросил Сулеймана ибн Ясара об одежде, которую постигает осквернение и он сказал: «‘Аиша сказала: “(Обычно) я смывала его с одежды Посланника Аллаха ﷺ после чего он выходил на молитву, а на его одежде всё ещё были видны следы мытья”»";
"discovery.card.sunnah_bukhari_231.source" = "Sahih al-Bukhari 231";

"discovery.card.sunnah_bukhari_232.title" = "Сахих аль-Бухари 232";
"discovery.card.sunnah_bukhari_232.meaning" = "Передают со слов ‘Аиши о том, что (обычно) она смывала семя с одежды Пророка ﷺ после чего она видела на ней пятно";
"discovery.card.sunnah_bukhari_232.source" = "Sahih al-Bukhari 232";

"discovery.card.sunnah_bukhari_234.title" = "Сахих аль-Бухари 234";
"discovery.card.sunnah_bukhari_234.meaning" = "Сообщается, что Анас, да будет доволен им Аллах, сказал: «До того, как была построена мечеть, Пророк ﷺ часто молился в загонах для овец»";
"discovery.card.sunnah_bukhari_234.source" = "Sahih al-Bukhari 234";

"discovery.card.sunnah_bukhari_235.title" = "Сахих аль-Бухари 235";
"discovery.card.sunnah_bukhari_235.meaning" = "‘Абдуллах ибн ‘Аббас передал со слов Маймуны, да будет доволен ею Аллах, что однажды Посланника Аллаха ﷺ спросили о (том, что следует делать с) маслом, в которое попала мышь, и он сказал: «Достаньте и выбросьте мышь со всем тем, что вокруг неё есть, а (остальное) своё масло (можете) употребить в пищу»";
"discovery.card.sunnah_bukhari_235.source" = "Sahih al-Bukhari 235";

"discovery.card.sunnah_bukhari_236.title" = "Сахих аль-Бухари 236";
"discovery.card.sunnah_bukhari_236.meaning" = "‘Абдуллах ибн ‘Аббас передал со слов Маймуны, да будет доволен ею Аллах, что однажды Пророка ﷺ спросили о (том, что следует делать с) маслом, в которое попала мышь, и он сказал: «Достаньте и выбросьте (мышь) со всем тем, что вокруг неё есть»";
"discovery.card.sunnah_bukhari_236.source" = "Sahih al-Bukhari 236";

"discovery.card.sunnah_bukhari_237.title" = "Сахих аль-Бухари 237";
"discovery.card.sunnah_bukhari_237.meaning" = "Передают со слов Абу Хурайры, да будет доволен им Аллах, что Пророк ﷺ сказал: «В День воскресения каждая рана, полученная мусульманином на пути Аллаха, предстанет (перед взорами) в том виде, какой она была, когда её нанесли (ему). Кровь из (этой раны) будет бить ключом, и цвет её будет цветом крови, но запах её будет запахом мускуса»";
"discovery.card.sunnah_bukhari_237.source" = "Sahih al-Bukhari 237";

"discovery.card.sunnah_bukhari_238.title" = "Сахих аль-Бухари 238";
"discovery.card.sunnah_bukhari_238.meaning" = "Абу Хурайра, да будет доволен им Аллах, передал, что он слышал, как Посланник Аллаха ﷺ сказал: «Мы − последние, (но в День воскрешения мы станем) первыми»";
"discovery.card.sunnah_bukhari_238.source" = "Sahih al-Bukhari 238";

"discovery.card.sunnah_bukhari_239.title" = "Сахих аль-Бухари 239";
"discovery.card.sunnah_bukhari_239.meaning" = "Передают со слов Абу Хурайры, да будет доволен им Аллах, о том, что Пророк ﷺ сказал: «Пусть никто из вас ни в коем случае не мочится в стоячую непроточную воду, ибо потом эта вода (может понадобиться) ему для полного омовения»";
"discovery.card.sunnah_bukhari_239.source" = "Sahih al-Bukhari 239";

"discovery.card.sunnah_bukhari_241.title" = "Сахих аль-Бухари 241";
"discovery.card.sunnah_bukhari_241.meaning" = "Сообщается, что Анас, да будет доволен им Аллах, сказал: «(Однажды я видел, как) Пророк ﷺ сплюнул в (полу) своей одежды»";
"discovery.card.sunnah_bukhari_241.source" = "Sahih al-Bukhari 241";

"discovery.card.sunnah_bukhari_242.title" = "Сахих аль-Бухари 242";
"discovery.card.sunnah_bukhari_242.meaning" = "Передают со слов ‘Аиши о том, что Пророк ﷺ сказал: «Любой напиток, который опьяняет, является запретным /харам/»";
"discovery.card.sunnah_bukhari_242.source" = "Sahih al-Bukhari 242";

"discovery.card.sunnah_bukhari_250.title" = "Сахих аль-Бухари 250";
"discovery.card.sunnah_bukhari_250.meaning" = "Сообщается, что ‘Аиша, да будет доволен ею Аллах, сказала: «Обычно я совершала полное омовение вместе с Пророком ﷺ (и мы брали воду) из одного и того же сосуда, именуемого “фаракъ”»";
"discovery.card.sunnah_bukhari_250.source" = "Sahih al-Bukhari 250";

"discovery.card.sunnah_bukhari_251.title" = "Сахих аль-Бухари 251";
"discovery.card.sunnah_bukhari_251.meaning" = "Сообщается, что Абу Саляма, да помилует его Аллах Всевышний, сказал: «(Однажды) я зашёл к ‘Аише, да будет доволен ею Аллах, вместе с её братом, который спросил её о том, как совершал полное омовение Пророк ﷺ. Она велела принести сосуд, вмещавший около одного са‘ (воды), совершила большое омовение и вылила (оставшуюся воду) себе на голову, и в это время она была отделена от нас завесой»";
"discovery.card.sunnah_bukhari_251.source" = "Sahih al-Bukhari 251";

"discovery.card.sunnah_bukhari_253.title" = "Сахих аль-Бухари 253";
"discovery.card.sunnah_bukhari_253.meaning" = "Передают со слов Ибн ‘Аббаса о том, что Пророк ﷺ и Маймуна совершали большое омовение из одного и того же сосуда";
"discovery.card.sunnah_bukhari_253.source" = "Sahih al-Bukhari 253";

"discovery.card.sunnah_bukhari_254.title" = "Сахих аль-Бухари 254";
"discovery.card.sunnah_bukhari_254.meaning" = "Сообщается, что Джубайр ибн Мут‘им, да будет доволен им Аллах, сказал: «(Однажды) Посланник Аллаха ﷺ сказал: “Что касается меня, то я обливаю голову трижды”, показав (, как он делает это,) обеими руками»";
"discovery.card.sunnah_bukhari_254.source" = "Sahih al-Bukhari 254";

"discovery.card.sunnah_bukhari_255.title" = "Сахих аль-Бухари 255";
"discovery.card.sunnah_bukhari_255.meaning" = "Сообщается, что Джабир ибн ‘Абдуллах, да будет доволен им Аллах, сказал: «Обычно, (при совершении полного омовения,) Пророк ﷺ наливал себе на голову три (пригоршни воды)»";
"discovery.card.sunnah_bukhari_255.source" = "Sahih al-Bukhari 255";

"discovery.card.sunnah_bukhari_261.title" = "Сахих аль-Бухари 261";
"discovery.card.sunnah_bukhari_261.meaning" = "Сообщается, что ‘Аиша, да будет доволен ею Аллах, сказала: «Обычно, когда я купалась вместе с Пророком ﷺ мы набирали воду из одного и того же сосуда, по очереди погружая в него руки»";
"discovery.card.sunnah_bukhari_261.source" = "Sahih al-Bukhari 261";

"discovery.card.sunnah_bukhari_262.title" = "Сахих аль-Бухари 262";
"discovery.card.sunnah_bukhari_262.meaning" = "Сообщается, что ‘Аиша сказала: «Когда Посланник Аллаха ﷺ купался из-за полового осквернения, он мыл свою руку»";
"discovery.card.sunnah_bukhari_262.source" = "Sahih al-Bukhari 262";

"discovery.card.sunnah_bukhari_263.title" = "Сахих аль-Бухари 263";
"discovery.card.sunnah_bukhari_263.meaning" = "Сообщается, что ‘Аиша, да будет доволен ею Аллах, сказала: «Обычно я купалась из-за полового осквернения вместе с Пророком ﷺ (набирая воду) из одного и того же сосуда»";
"discovery.card.sunnah_bukhari_263.source" = "Sahih al-Bukhari 263";

"discovery.card.sunnah_bukhari_264.title" = "Сахих аль-Бухари 264";
"discovery.card.sunnah_bukhari_264.meaning" = "Рассказал нам Абуль-Валид, который сказал: Рассказал нам Шу‘ба от ‘Абдуллаха ибн ‘Абдуллах ибн Джабр, который сказал:\\n— Я слышал, как Анас ибн Малик говорил: «Обычно Пророк ﷺ и женщина из числа его жён, купались (набирая воду) из одного и того же сосуда».\\nМуслим и Вахб привели от Шу‘бы дополнение: «… из-за полового осквернения»";
"discovery.card.sunnah_bukhari_264.source" = "Sahih al-Bukhari 264";

"discovery.card.sunnah_bukhari_269.title" = "Сахих аль-Бухари 269";
"discovery.card.sunnah_bukhari_269.meaning" = "Сообщается, что ‘Али, да будет доволен им Аллах, сказал: «Обычно у меня выделялась жидкость, и поэтому (однажды) я велел одному человеку спросить об этом Пророка ﷺ из-за положения, которое занимала его дочь при мне. И когда он спросил (об этом Пророка ﷺ) он сказал: “Соверши омовение и помой свой половой орган”»";
"discovery.card.sunnah_bukhari_269.source" = "Sahih al-Bukhari 269";

"discovery.card.sunnah_bukhari_271.title" = "Сахих аль-Бухари 271";
"discovery.card.sunnah_bukhari_271.meaning" = "Сообщается, что ‘Аиша, да будет доволен ею Аллах, сказала: «У меня до сих пор стоит перед глазами блеск благовоний на проборе Пророка ﷺ надевшего ихрам»";
"discovery.card.sunnah_bukhari_271.source" = "Sahih al-Bukhari 271";

"discovery.card.sunnah_bukhari_277.title" = "Сахих аль-Бухари 277";
"discovery.card.sunnah_bukhari_277.meaning" = "Сообщается, что ‘Аиша сказала: «Когда одну из нас постигало половое осквернение /джанаба/, то она набирала (воду) руками (и наливала) на голову три раза. Затем набрав одной рукой, она наливала на правую сторону (головы), а другой рукой — на левую сторону»";
"discovery.card.sunnah_bukhari_277.source" = "Sahih al-Bukhari 277";

"discovery.card.sunnah_bukhari_280.title" = "Сахих аль-Бухари 280";
"discovery.card.sunnah_bukhari_280.meaning" = "Сообщается, что Умм Хàниъ бинт Абу Талиб, да будет доволен ею Аллах, сказала: «(Однажды) в год завоевания Мекки я отправилась к Посланнику Аллаха ﷺ (и вошла) к нему в то время, когда он совершал большое омовение, а Фатима прикрывала его. Он спросил: “Кто эта (женщина)?” − а я отозвалась: “Я, Умм Хàниъ”»";
"discovery.card.sunnah_bukhari_280.source" = "Sahih al-Bukhari 280";

"discovery.card.sunnah_bukhari_284.title" = "Сахих аль-Бухари 284";
"discovery.card.sunnah_bukhari_284.meaning" = "Передают со слов Къатады о том, что Анас ибн Малик рассказывал им, что Пророк ﷺ обходил своих жён за одну ночь, и в то время у него было девять жён";
"discovery.card.sunnah_bukhari_284.source" = "Sahih al-Bukhari 284";

"discovery.card.sunnah_bukhari_286.title" = "Сахих аль-Бухари 286";
"discovery.card.sunnah_bukhari_286.meaning" = "Сообщается, что Абу Саляма сказал: «(Однажды) я спросил у ‘Аиши: “Укладывался ли спать Пророк ﷺ в состоянии полового осквернения?” Она ответила: “Да, и он совершал омовение”»";
"discovery.card.sunnah_bukhari_286.source" = "Sahih al-Bukhari 286";

"discovery.card.sunnah_bukhari_287.title" = "Сахих аль-Бухари 287";
"discovery.card.sunnah_bukhari_287.meaning" = "Передают со слов Ибн ‘Умара, да будет доволен Аллах ими обоими, о том, что однажды ‘Умар ибн аль-Хаттаб, да будет доволен им Аллах, спросил Посланника Аллаха ﷺ: «Можно ли кому-нибудь из нас засыпать в состоянии полового осквернения?» Он ответил: «Да, если любой из вас совершит малое омовение, он может лечь спать в состоянии полового осквернения»";
"discovery.card.sunnah_bukhari_287.source" = "Sahih al-Bukhari 287";

"discovery.card.sunnah_bukhari_288.title" = "Сахих аль-Бухари 288";
"discovery.card.sunnah_bukhari_288.meaning" = "Сообщается, что ‘Аиша сказала: «Когда Пророк ﷺ хотел лечь спать в состоянии полового осквернения, он мыл свои половые органы и совершал омовение (которое обычно совершал) для молитвы»";
"discovery.card.sunnah_bukhari_288.source" = "Sahih al-Bukhari 288";

"discovery.card.sunnah_bukhari_289.title" = "Сахих аль-Бухари 289";
"discovery.card.sunnah_bukhari_289.meaning" = "Сообщается, что Абдуллах (ибн ‘Умар, да будет доволен Аллах ими обоими,) сказал:«(Однажды) ‘Умар (ибн аль-Хаттаб, да будет доволен им Аллах,) обратился к Пророку ﷺ с просьбой вынести заключение: “Можно ли кому-нибудь из нас засыпать в состоянии полового осквернения?” Он ответил: “Да, если совершит малое омовение”»";
"discovery.card.sunnah_bukhari_289.source" = "Sahih al-Bukhari 289";

"discovery.card.sunnah_bukhari_290.title" = "Сахих аль-Бухари 290";
"discovery.card.sunnah_bukhari_290.meaning" = "Сообщается, что ‘Абдуллах ибн ‘Умар сказал:«Однажды ‘Умар ибн аль-Хаттаб рассказал Посланнику Аллаха ﷺ о том, что ночью его постигло осквернение/джанаба/, и Посланник Аллаха ﷺ сказал ему: “Соверши омовение, помой свой половой орган, и затем ложись спать”»";
"discovery.card.sunnah_bukhari_290.source" = "Sahih al-Bukhari 290";

"discovery.card.sunnah_bukhari_291.title" = "Сахих аль-Бухари 291";
"discovery.card.sunnah_bukhari_291.meaning" = "Передают со слов Абу Хурайры о том, что Пророк ﷺ сказал: «Если (мужчина) усядется меж четырёх частей (тела женщины) и совершит с ней половое сношение, то полное омовение становится обязательным»";
"discovery.card.sunnah_bukhari_291.source" = "Sahih al-Bukhari 291";

"discovery.card.sunnah_bukhari_295.title" = "Сахих аль-Бухари 295";
"discovery.card.sunnah_bukhari_295.meaning" = "Сообщается, что ‘Аиша, да будет доволен ею Аллах, сказала:«Не раз случалось так, что, когда у меня были месячные, я причёсывала Посланника Аллаха ﷺ»";
"discovery.card.sunnah_bukhari_295.source" = "Sahih al-Bukhari 295";

"discovery.card.sunnah_bukhari_297.title" = "Сахих аль-Бухари 297";
"discovery.card.sunnah_bukhari_297.meaning" = "Передают со слов Мансура ибн Сафиййа о том, что его мать сообщила ему, что ‘Аиша рассказывала ей:«Когда у меня были месячные, Пророк ﷺ не раз ложился головой мне на колени и затем начинал читать Коран»";
"discovery.card.sunnah_bukhari_297.source" = "Sahih al-Bukhari 297";

"discovery.card.sunnah_bukhari_298.title" = "Сахих аль-Бухари 298";
"discovery.card.sunnah_bukhari_298.meaning" = "Сообщается, что Умм Саляма, да будет доволен ею Аллах, сказала:«(Однажды,) когда мы лежали вместе с Пророком ﷺ накрывшись куском плотной ткани, у меня начались месячные. Я потихоньку покинула (его), взяв с собой одежду, предназначенную для подобных случаев, (а когда вернулась,) он спросил: “У тебя начались месячные?” Я ответила: “Да”. Тогда он подозвал меня, и я (снова) легла с ним(, укрывшись) той же тканью»";
"discovery.card.sunnah_bukhari_298.source" = "Sahih al-Bukhari 298";

"discovery.card.sunnah_bukhari_303.title" = "Сахих аль-Бухари 303";
"discovery.card.sunnah_bukhari_303.meaning" = "Сообщается, что ‘Абдуллах ибн Шаддад сказал:«Я слышал, (как) Маймуна (рассказывала): “Обычно, когда Посланник Аллаха ﷺ желал прикасаться к одной из своих жён в то время, когда у неё были месячные, он повелевал ей (надеть изар) и она надевала его”»";
"discovery.card.sunnah_bukhari_303.source" = "Sahih al-Bukhari 303";

"discovery.card.sunnah_bukhari_310.title" = "Сахих аль-Бухари 310";
"discovery.card.sunnah_bukhari_310.meaning" = "Сообщается, что ‘Аиша сказала: «Одна из жён Посланника Аллаха ﷺ совершала с ним затворничество в мечети /и‘тикаф/ и она видела кровь и желтизну и под ней таз, и она совершала молитву»";
"discovery.card.sunnah_bukhari_310.source" = "Sahih al-Bukhari 310";

"discovery.card.sunnah_bukhari_311.title" = "Сахих аль-Бухари 311";
"discovery.card.sunnah_bukhari_311.meaning" = "Передают со слов ‘Аиши, да будет доволен ею Аллах: «Некоторые из матерей правоверных совершали затворничество в мечети /и‘тикаф/ в то время, когда у них было хроническое кровотечение»";
"discovery.card.sunnah_bukhari_311.source" = "Sahih al-Bukhari 311";

"discovery.card.sunnah_bukhari_312.title" = "Сахих аль-Бухари 312";
"discovery.card.sunnah_bukhari_312.meaning" = "Сообщается, что Муджахид сказал:\\n— ‘Аиша сказала: «Ни у одной из нас не было одежды, кроме как одной, которую она носила во время месячных. И если на неё попадало что-то из крови, она соскабливала с неё (кровь) ногтями»";
"discovery.card.sunnah_bukhari_312.source" = "Sahih al-Bukhari 312";

"discovery.card.sunnah_bukhari_323.title" = "Сахих аль-Бухари 323";
"discovery.card.sunnah_bukhari_323.meaning" = "Сообщается, что Умм Саляма, да будет доволен ею Аллах, сказала: «(Однажды,) когда мы лежали вместе с Пророком ﷺ накрывшись хамилей, у меня начались месячные. Я потихоньку покинула (его), взяв с собой одежду, предназначенную для подобных случаев, (а когда вернулась,) он спросил: “У тебя начались месячные?” Я ответила: “Да”. Тогда он подозвал меня, и я (снова) легла с ним(, укрывшись) той же хамилей»";
"discovery.card.sunnah_bukhari_323.source" = "Sahih al-Bukhari 323";

"discovery.card.sunnah_bukhari_326.title" = "Сахих аль-Бухари 326";
"discovery.card.sunnah_bukhari_326.meaning" = "Сообщается, что Умм ‘Атыййа, да будет доволен ею Аллах, сказала: «Мы не придавали никакого значения тусклым и жёлтым выделениям»";
"discovery.card.sunnah_bukhari_326.source" = "Sahih al-Bukhari 326";

"discovery.card.sunnah_bukhari_328.title" = "Сахих аль-Бухари 328";
"discovery.card.sunnah_bukhari_328.meaning" = "Сообщается, что жена Пророка ﷺ ‘Аиша, да будет доволен ею Аллах, сказала Посланнику Аллаха ﷺ: «О Посланник Аллаха, у Сафиййи бинт Хуйайй начались месячные». Посланник Аллаха ﷺ сказал: «Она может задержать нас. Разве она не совершила обход вместе с вами?» (Люди) ответили: «Да», а он сказал: «Тогда уезжай»";
"discovery.card.sunnah_bukhari_328.source" = "Sahih al-Bukhari 328";

"discovery.card.sunnah_bukhari_331.title" = "Сахих аль-Бухари 331";
"discovery.card.sunnah_bukhari_331.meaning" = "Сообщается, что ‘Аиша сказала: «Посланник Аллаха ﷺ сказал: “Когда приблизится время месячных, оставь молитву, а когда они завершатся, смой с себя кровь и совершай молитву”»";
"discovery.card.sunnah_bukhari_331.source" = "Sahih al-Bukhari 331";

"discovery.card.sunnah_bukhari_332.title" = "Сахих аль-Бухари 332";
"discovery.card.sunnah_bukhari_332.meaning" = "Передают со слов Самуры бин Джундуба, да будет доволен им Аллах, что после смерти одной женщины во время родов, Пророк ﷺ совершил по ней заупокойную молитву, встав напротив середины её тела";
"discovery.card.sunnah_bukhari_332.source" = "Sahih al-Bukhari 332";

"discovery.card.sunnah_bukhari_333.title" = "Сахих аль-Бухари 333";
"discovery.card.sunnah_bukhari_333.meaning" = "Сообщается, что Абдуллах ибн Шаддад сказал: «Я слышал, что моя тетя Маймуна — жена Пророка ﷺ (рассказывала о том, что) она не молилась, когда у неё были месячные, а сидела рядом с тем местом, где совершал молитвы Пророк ﷺ. Он же обычно молился на своей подстилке /хумра/, и во время совершения земных поклонов (края) его одежды касались меня»";
"discovery.card.sunnah_bukhari_333.source" = "Sahih al-Bukhari 333";

"discovery.card.sunnah_bukhari_340.title" = "Сахих аль-Бухари 340";
"discovery.card.sunnah_bukhari_340.meaning" = "Ибн ‘Абду-р-Рахман ибн Абза передал со слов своего отца о том, что он был свидетелем того, как ‘Аммар сказал ‘Умару: «Мы были в походе и осквернились …», и он сказал: «Поплевал на них»";
"discovery.card.sunnah_bukhari_340.source" = "Sahih al-Bukhari 340";

"discovery.card.sunnah_bukhari_341.title" = "Сахих аль-Бухари 341";
"discovery.card.sunnah_bukhari_341.meaning" = "Сообщается, что ‘Абду-р-Рахман (ибн Абза) сказал:\\n— ‘Аммар сказал ‘Умару: «Я катался по песку, после пришёл к Пророку ﷺ и он сказал: “Тебе достаточно было (протереть себе) лицо и кисти рук”»";
"discovery.card.sunnah_bukhari_341.source" = "Sahih al-Bukhari 341";

"discovery.card.sunnah_bukhari_343.title" = "Сахих аль-Бухари 343";
"discovery.card.sunnah_bukhari_343.meaning" = "Ибн ‘Абду-р-Рахман ибн Абза передал со слов своего отца (‘Абду-р-Рахмана) о том, что он сказал: «‘Аммар сказал: “И Пророк ﷺ (легко) ударил ладонью о землю и протёр себе лицо и кисти рук”»";
"discovery.card.sunnah_bukhari_343.source" = "Sahih al-Bukhari 343";

"discovery.card.sunnah_bukhari_353.title" = "Сахих аль-Бухари 353";
"discovery.card.sunnah_bukhari_353.meaning" = "Сообщается, что Мухаммад ибн аль-Мункадир сказал: «Я видел, как Джабир ибн ‘Абдуллах совершал молитву в одной одежде и он сказал: “Я видел, как (в одной) одежде совершал молитву Пророк ﷺ”»";
"discovery.card.sunnah_bukhari_353.source" = "Sahih al-Bukhari 353";

"discovery.card.sunnah_bukhari_354.title" = "Сахих аль-Бухари 354";
"discovery.card.sunnah_bukhari_354.meaning" = "Передают со слов ‘Умара ибн Абу Салямы, да будет доволен им Аллах, о том, что (иногда) Пророк ﷺ молился в одной одежде, краями которой он покрывал себе плечи, накидывая их друг на друга";
"discovery.card.sunnah_bukhari_354.source" = "Sahih al-Bukhari 354";

"discovery.card.sunnah_bukhari_355.title" = "Сахих аль-Бухари 355";
"discovery.card.sunnah_bukhari_355.meaning" = "Передают со слов ‘Умара ибн Абу Салямы, да будет доволен им Аллах, о том, что он видел, как Пророк ﷺ молился в одной одежде в доме Умм Салямы, накинув её края себе на плечи";
"discovery.card.sunnah_bukhari_355.source" = "Sahih al-Bukhari 355";

"discovery.card.sunnah_bukhari_356.title" = "Сахих аль-Бухари 356";
"discovery.card.sunnah_bukhari_356.meaning" = "Сообщается, что ‘Умар ибн Абу Саляма, да будет доволен им Аллах, сказал: «Я видел, как Посланник Аллаха ﷺ молился в доме Умм Салямы в одной одежде, завернувшись в неё, накинув её края себе на плечи»";
"discovery.card.sunnah_bukhari_356.source" = "Sahih al-Bukhari 356";

"discovery.card.sunnah_bukhari_358.title" = "Сахих аль-Бухари 358";
"discovery.card.sunnah_bukhari_358.meaning" = "Передают со слов Абу Хурайры, да будет доволен им Аллах, о том, что (однажды) какой-то человек задал Посланнику Аллаха ﷺ вопрос о (допустимости) совершения молитвы в одной одежде, (и в ответ ему) Посланник Аллаха ﷺ сказал: «А разве каждый из вас имеет по две одежды?»";
"discovery.card.sunnah_bukhari_358.source" = "Sahih al-Bukhari 358";

"discovery.card.sunnah_bukhari_359.title" = "Сахих аль-Бухари 359";
"discovery.card.sunnah_bukhari_359.meaning" = "Сообщается, что Абу Хурайра сказал: «Пророк ﷺ сказал: “Пусть никто из вас не молится в одной одежде с непокрытыми плечами”»";
"discovery.card.sunnah_bukhari_359.source" = "Sahih al-Bukhari 359";

"discovery.card.sunnah_bukhari_360.title" = "Сахих аль-Бухари 360";
"discovery.card.sunnah_bukhari_360.meaning" = "Сообщается, что Абу Хурайра, да будет доволен им Аллах, сказал: «Свидетельствую, что я слышал, как Посланник Аллаха ﷺ говорил: “Пусть тот, кто станет молиться в одной одежде, покрывает себе плечи её краями, накидывая их друг на друга”»";
"discovery.card.sunnah_bukhari_360.source" = "Sahih al-Bukhari 360";

"discovery.card.sunnah_bukhari_362.title" = "Сахих аль-Бухари 362";
"discovery.card.sunnah_bukhari_362.meaning" = "Сообщается, что Сахль, да будет доволен им Аллах, сказал: «Обычно (некоторые) мужчины молились вместе с Пророком ﷺ завязывая (края) своих изаров на шеях подобно тому, как это делают мальчики, и поэтому (Пророк ﷺ) говорил женщинам: “Не поднимайте голов до тех пор, пока мужчины не усядутся и не выпрямятся”»";
"discovery.card.sunnah_bukhari_362.source" = "Sahih al-Bukhari 362";

"discovery.card.sunnah_bukhari_372.title" = "Сахих аль-Бухари 372";
"discovery.card.sunnah_bukhari_372.meaning" = "Сообщается, что аз-Зухри сказал: «Сообщил мне ‘Урва о том, что ‘Аиша, да будет доволен ею Аллах, сказала: “Когда Посланник Аллаха ﷺ совершал утреннюю молитву (в мечети), с ним часто молились и верующие женщины, которые заворачивались в свои плащи. Затем они возвращались к себе домой и никто не мог узнать их”»";
"discovery.card.sunnah_bukhari_372.source" = "Sahih al-Bukhari 372";

"discovery.card.sunnah_bukhari_375.title" = "Сахих аль-Бухари 375";
"discovery.card.sunnah_bukhari_375.meaning" = "Сообщается, что ‘Укъба ибн ‘Амир, да будет доволен им Аллах, сказал: «(Однажды) Пророку ﷺ подарили шёлковую одежду с разрезом сзади. Он надел её и совершил в ней молитву, закончив же (молиться), быстро скинул её с себя как нечто ненавистное ему и воскликнул: “Не следует богобоязненным (носить) это!”»";
"discovery.card.sunnah_bukhari_375.source" = "Sahih al-Bukhari 375";

"discovery.card.sunnah_bukhari_381.title" = "Сахих аль-Бухари 381";
"discovery.card.sunnah_bukhari_381.meaning" = "Сообщается от ‘Абдуллаха ибн Шаддада от Маймуны (, что она) рассказывала: «Пророк ﷺ обычно молился на своей подстилке /хумра/»";
"discovery.card.sunnah_bukhari_381.source" = "Sahih al-Bukhari 381";

"discovery.card.sunnah_bukhari_383.title" = "Сахих аль-Бухари 383";
"discovery.card.sunnah_bukhari_383.meaning" = "Сообщается, что Ибн Шихаб (аз-Зухри) сказал: «Сообщил мне ‘Урва о том, что ‘Аиша, да будет доволен ею Аллах, рассказывала ему, что когда Посланник Аллаха ﷺ молился, она, подобно покойнице, нередко лежала на постели меж ним и киблой»";
"discovery.card.sunnah_bukhari_383.source" = "Sahih al-Bukhari 383";

"discovery.card.sunnah_bukhari_384.title" = "Сахих аль-Бухари 384";
"discovery.card.sunnah_bukhari_384.meaning" = "Передают со слов ‘Урвы о том, что Пророк ﷺ молился, а ‘Аиша, да будет доволен ею Аллах, нередко лежала меж ним и киблой, на постели, на которой они спали";
"discovery.card.sunnah_bukhari_384.source" = "Sahih al-Bukhari 384";

"discovery.card.sunnah_bukhari_385.title" = "Сахих аль-Бухари 385";
"discovery.card.sunnah_bukhari_385.meaning" = "Сообщается, что Анас ибн Малик, да будет доволен им Аллах, сказал: «Обычно, когда мы молились вместе с Пророком ﷺ некоторые из нас из-за сильной жары расстилали края своей одежды на месте совершения земных поклонов»";
"discovery.card.sunnah_bukhari_385.source" = "Sahih al-Bukhari 385";

"discovery.card.sunnah_bukhari_386.title" = "Сахих аль-Бухари 386";
"discovery.card.sunnah_bukhari_386.meaning" = "Сообщается, что Абу Масляма Са‘ид ибн Язид аль-Азди сказал: «(Однажды) я спросил Анаса ибн Малика, да будет доволен им Аллах: “Молился ли Пророк ﷺ в своих сандалиях?” — и он сказал: “Да”»";
"discovery.card.sunnah_bukhari_386.source" = "Sahih al-Bukhari 386";

"discovery.card.sunnah_bukhari_388.title" = "Сахих аль-Бухари 388";
"discovery.card.sunnah_bukhari_388.meaning" = "Передается от Мугъира ибн Шу‘ба, что он сказал: «Я помог совершить омовение Пророку ﷺ и он протер свои кожаные носки и совершил молитву»";
"discovery.card.sunnah_bukhari_388.source" = "Sahih al-Bukhari 388";

"discovery.card.sunnah_bukhari_390.title" = "Сахих аль-Бухари 390";
"discovery.card.sunnah_bukhari_390.meaning" = "Передают со слов ‘Абдуллаха ибн Малика ибн Бухайны, да будет доволен им Аллах, о том, что во время молитвы Пророк ﷺ расставлял руки настолько, что становилась видна белизна его подмышек";
"discovery.card.sunnah_bukhari_390.source" = "Sahih al-Bukhari 390";

"discovery.card.sunnah_bukhari_391.title" = "Сахих аль-Бухари 391";
"discovery.card.sunnah_bukhari_391.meaning" = "Сообщается, что Анас ибн Малик, да будет доволен им Аллах, сказал: «Посланник Аллаха ﷺ сказал: “Тот, кто совершает молитву так же, как и мы, и обращается к нашей кибле, и ест то, что мы приносим в жертву, является мусульманином, который находится под защитой Аллаха и под защитой Его посланника. Не предавайте же Аллаха, (предавая тех, кто находится) под Его защитой!”»";
"discovery.card.sunnah_bukhari_391.source" = "Sahih al-Bukhari 391";

"discovery.card.sunnah_bukhari_398.title" = "Сахих аль-Бухари 398";
"discovery.card.sunnah_bukhari_398.meaning" = "Сообщается, что Ибн ‘Аббас, да будет доволен Аллах ими обоими, сказал: «Когда Пророк ﷺ вошёл в дом (Аллаха) и воззвал к Аллаху, повернувшись ко всем сторонам света, он не совершил намаз, пока не вышел из (Каабы). Когда же он вышел (оттуда), то совершил (намаз в) два рак‘ата, обратившись лицом к Каабе, и сказал: “Это — кибла”»";
"discovery.card.sunnah_bukhari_398.source" = "Sahih al-Bukhari 398";

"discovery.card.sunnah_bukhari_400.title" = "Сахих аль-Бухари 400";
"discovery.card.sunnah_bukhari_400.meaning" = "Сообщается, что Джабир, да будет доволен им Аллах, сказал: «Обычно, когда Посланник Аллаха ﷺ сидевший верхом на своей верблюдице, (приступал к молитве,) он продолжал молиться, куда бы она ни поворачивалась, но если он хотел совершить обязательную молитву, то спешивался и поворачивался лицом к кибле»";
"discovery.card.sunnah_bukhari_400.source" = "Sahih al-Bukhari 400";

"discovery.card.sunnah_bukhari_404.title" = "Сахих аль-Бухари 404";
"discovery.card.sunnah_bukhari_404.meaning" = "Сообщается, что ‘Абдуллах (ибн Мас‘уд) сказал: «Однажды во время полуденной молитвы Посланник Аллаха ﷺ совершил пять (рак‘атов вместо положенных четырёх). Кто-то спросил: “Разве молитва была увеличена?” (Пророк ﷺ в свою очередь) спросил: “А в чём дело?” (Люди) сказали: “Ты совершил пять (рак‘атов)”. И тогда (Пророк ﷺ), согнул ноги и совершил ещё два земных поклона»";
"discovery.card.sunnah_bukhari_404.source" = "Sahih al-Bukhari 404";

"discovery.card.sunnah_bukhari_407.title" = "Сахих аль-Бухари 407";
"discovery.card.sunnah_bukhari_407.meaning" = "Передают со слов матери правоверных ‘Аиши, да будет доволен ею Аллах, о том, что однажды Посланник Аллаха ﷺ увидел на стене мечети, направленной в сторону киблы слизь (или: … плевок; или: … мокроту), и соскоблил его (собственноручно)";
"discovery.card.sunnah_bukhari_407.source" = "Sahih al-Bukhari 407";

"discovery.card.sunnah_bukhari_412.title" = "Сахих аль-Бухари 412";
"discovery.card.sunnah_bukhari_412.meaning" = "Сообщается, что Анас, да будет доволен им Аллах, сказал: «Пророк ﷺ сказал: “Пусть никто из вас не плюёт ни перед собой, ни направо, однако, пусть (сплёвывает) слева от себя или себе под ногу”»";
"discovery.card.sunnah_bukhari_412.source" = "Sahih al-Bukhari 412";

"discovery.card.sunnah_bukhari_413.title" = "Сахих аль-Бухари 413";
"discovery.card.sunnah_bukhari_413.meaning" = "Сообщается, что Катада сказал:\\n— Я слышал, как Анас ибн Малик сказал: «Пророк ﷺ сказал: “Поистине, когда верующий/муъмин/ совершает молитву, он ведёт тайную беседу со своим Господом, и посему, пусть ни в коем случае не плюёт ни перед собой, ни направо, а влево от себя или себе под ногу”»";
"discovery.card.sunnah_bukhari_413.source" = "Sahih al-Bukhari 413";

"discovery.card.sunnah_bukhari_414.title" = "Сахих аль-Бухари 414";
"discovery.card.sunnah_bukhari_414.meaning" = "Хумайд ибн ‘Абду-р-Рахман передал от Абу Са‘ида (аль-Худри), да будет доволен им Аллах, о том, что однажды Посланник Аллаха ﷺ увидел в мечети, в направлении къиблы, плевок и соскоблил его камешком, после чего запретил человеку плевать перед собой или справа от себя, и (что это следует делать) только налево или под свою левую ногу";
"discovery.card.sunnah_bukhari_414.source" = "Sahih al-Bukhari 414";

"discovery.card.sunnah_bukhari_415.title" = "Сахих аль-Бухари 415";
"discovery.card.sunnah_bukhari_415.meaning" = "Сообщается, что Катада сказал:\\n— Я слышал, как Анас ибн Малик сказал: «Пророк ﷺ сказал: “Плевать в мечети грешно, а искупление этого прегрешения состоит в том, чтобы закопать плевок”»";
"discovery.card.sunnah_bukhari_415.source" = "Sahih al-Bukhari 415";

"discovery.card.sunnah_bukhari_418.title" = "Сахих аль-Бухари 418";
"discovery.card.sunnah_bukhari_418.meaning" = "Передают со слов Абу Хурайры, да будет доволен им Аллах, что (однажды) Посланник Аллаха ﷺ сказал: «Неужели вы считаете, что моя кибла находится (только) здесь? Клянусь Аллахом, не останется скрытой от меня ни (степень) вашего смирения, ни (то, как вы) кланяетесь, ибо, поистине, я вижу, что вы (делаете, находясь) у меня за спиной!»";
"discovery.card.sunnah_bukhari_418.source" = "Sahih al-Bukhari 418";

"discovery.card.sunnah_bukhari_419.title" = "Сахих аль-Бухари 419";
"discovery.card.sunnah_bukhari_419.meaning" = "Сообщается, что Анас ибн Малик сказал: «(Однажды) Пророк ﷺ совершил с нами какую-то молитву, после чего поднялся на минбар и сказал относительно молитвы и поясного поклона: “Поистине, я вижу вас за своей спиной так же, как вижу вас (сейчас перед собой)”»";
"discovery.card.sunnah_bukhari_419.source" = "Sahih al-Bukhari 419";

"discovery.card.sunnah_bukhari_422.title" = "Сахих аль-Бухари 422";
"discovery.card.sunnah_bukhari_422.meaning" = "Передают со слов Исхака ибн ‘Абдуллах о том, что он слышал, как Анас ибн Малик сказал: «(Однажды) я нашёл Пророка ﷺ в мечети и с ним были люди. Я подошёл (к ним), а он сказал мне: “Тебя прислал Абу Тальха?” Я ответил: “Да”. Он спросил: “Для (того, чтобы пригласить поесть) еды?” Я сказал: “Да”. Тогда он сказал тем, кто находился вокруг него: “Вставайте!” И он отправился (к Абу Тальхе), а я пошёл впереди них»";
"discovery.card.sunnah_bukhari_422.source" = "Sahih al-Bukhari 422";

"discovery.card.sunnah_bukhari_424.title" = "Сахих аль-Бухари 424";
"discovery.card.sunnah_bukhari_424.meaning" = "Передают со слов ‘Итбана ибн Малика о том, что (как-то) Пророк ﷺ пришёл к нему домой и сказал: «Где ты хочешь, чтобы я в твоём доме помолился для тебя?» (‘Итбан) сказал: «И я указал ему на место и Пророк ﷺ произнёс такбир, а мы стали за ним в ряд и он совершил намаз в два ракаата»";
"discovery.card.sunnah_bukhari_424.source" = "Sahih al-Bukhari 424";

"discovery.card.sunnah_bukhari_426.title" = "Сахих аль-Бухари 426";
"discovery.card.sunnah_bukhari_426.meaning" = "Сообщается, что ‘Аиша, да будет доволен ею Аллах, сказала: «Пророку ﷺ нравилось отдавать предпочтение правой стороне во всём, по мере возможности (, что бы он ни делал: при совершении) омовения, (когда) причёсывался или надевал обувь»";
"discovery.card.sunnah_bukhari_426.source" = "Sahih al-Bukhari 426";

"discovery.card.sunnah_bukhari_429.title" = "Сахих аль-Бухари 429";
"discovery.card.sunnah_bukhari_429.meaning" = "Передают со слов Абу ат-Таяха о том, что Анас, да будет доволен им Аллах, сказал: «Пророк ﷺ часто молился в загонах для овец». \\n(Абу ат-Таях сказал:) «Затем я слышал, как после этого он говорил: “Он молился в загонах для овец до того, как построили мечеть”»";
"discovery.card.sunnah_bukhari_429.source" = "Sahih al-Bukhari 429";

"discovery.card.sunnah_bukhari_430.title" = "Сахих аль-Бухари 430";
"discovery.card.sunnah_bukhari_430.meaning" = "Сообщается, что Нафи‘ сказал: «(Однажды) я видел, как Ибн ‘Умар, да будет доволен Аллах ими обоими, помолился, повернувшись лицом в сторону своего верблюда, и сказал: “Я видел, что так поступал Пророк ﷺ”»";
"discovery.card.sunnah_bukhari_430.source" = "Sahih al-Bukhari 430";

"discovery.card.sunnah_bukhari_431.title" = "Сахих аль-Бухари 431";
"discovery.card.sunnah_bukhari_431.meaning" = "Сообщается, что ‘Абдуллах ибн ‘Аббас, да будет доволен ими обоими Аллах, сказал: «(Однажды) произошло затмение солнца и Посланник Аллаха ﷺ совершил молитву и сказал: “Мне было показано пламя (ада), но я никогда не видел более ужасного зрелища, какое (видел) сегодня!”»";
"discovery.card.sunnah_bukhari_431.source" = "Sahih al-Bukhari 431";

"discovery.card.sunnah_bukhari_432.title" = "Сахих аль-Бухари 432";
"discovery.card.sunnah_bukhari_432.meaning" = "Передают со слов Ибн ‘Умара, да будет доволен Аллах ими обоими, о том, что Пророк ﷺ сказал: «Совершайте часть намазов в своих домах и не превращайте их в могилы»";
"discovery.card.sunnah_bukhari_432.source" = "Sahih al-Bukhari 432";

"discovery.card.sunnah_bukhari_437.title" = "Сахих аль-Бухари 437";
"discovery.card.sunnah_bukhari_437.meaning" = "Передают со слов Абу Хурайры, да будет доволен им Аллах, о том, что Посланник Аллаха ﷺ сказал: «Да погубит Аллах иудеев, которые превратили могилы своих пророков в мечети!»";
"discovery.card.sunnah_bukhari_437.source" = "Sahih al-Bukhari 437";

"discovery.card.sunnah_bukhari_440.title" = "Сахих аль-Бухари 440";
"discovery.card.sunnah_bukhari_440.meaning" = "Сообщается, что Нафи‘ сказал: «‘Абдуллах (ибн ‘Умар, да будет доволен Аллах ими обоими,) рассказывал мне о том, что (при жизни Посланника Аллаха ﷺ) когда он ещё был неженатым юношей, не имевшим семьи, он часто оставался спать в мечети Пророка ﷺ»";
"discovery.card.sunnah_bukhari_440.source" = "Sahih al-Bukhari 440";

"discovery.card.sunnah_bukhari_443.title" = "Сахих аль-Бухари 443";
"discovery.card.sunnah_bukhari_443.meaning" = "Сообщается, что Джабир, да будет доволен им Аллах, сказал: «Однажды утром я пришёл к Пророку ﷺ который находился в мечети, и он сказал (мне): “Соверши молитву в два ракаата”. А он был должен мне, и после этого (Пророк ﷺ не только) рассчитался со мной, но и прибавил»";
"discovery.card.sunnah_bukhari_443.source" = "Sahih al-Bukhari 443";

"discovery.card.sunnah_bukhari_444.title" = "Сахих аль-Бухари 444";
"discovery.card.sunnah_bukhari_444.meaning" = "Передают со слов Абу Катады ас-Сулями, да будет доволен им Аллах, о том, что Посланник Аллаха ﷺ сказал: «Если кто-нибудь из вас зайдёт в мечеть, пусть совершит намаз в два ракаата, прежде чем садиться»";
"discovery.card.sunnah_bukhari_444.source" = "Sahih al-Bukhari 444";

"discovery.card.sunnah_bukhari_445.title" = "Сахих аль-Бухари 445";
"discovery.card.sunnah_bukhari_445.meaning" = "Передают со слов Абу Хурайры о том, что Посланник Аллаха ﷺ сказал: «Ангелы будут молиться за того из вас, который остаётся на том месте, где он совершил молитву, пока он не осквернится. Они говорят: “О Аллах, прости его (грехи), о Аллах, помилуй его!”»";
"discovery.card.sunnah_bukhari_445.source" = "Sahih al-Bukhari 445";

"discovery.card.sunnah_bukhari_448.title" = "Сахих аль-Бухари 448";
"discovery.card.sunnah_bukhari_448.meaning" = "Сообщается, что Сахль (ибн Са‘д), да будет доволен им Аллах, сказал: «Посланник Аллаха ﷺ отправил человека к одной женщине (с поручением): “Вели своему рабу-плотнику, чтобы он сделал для меня (возвышение) из дерева, на котором я буду сидеть, (когда стану обращаться к людям)”»";
"discovery.card.sunnah_bukhari_448.source" = "Sahih al-Bukhari 448";

"discovery.card.sunnah_bukhari_449.title" = "Сахих аль-Бухари 449";
"discovery.card.sunnah_bukhari_449.meaning" = "Передают со слов Джабира (ибн ‘Абдуллах) о том, что (однажды) какая-то женщина сказала: «О Посланник Аллаха, не сделать ли мне для тебя кое-что, на чём будешь сидеть, ведь у меня есть раб-плотник?» (Пророк ﷺ) сказал: «Если хочешь!» И (по её велению) был изготовлен минбар";
"discovery.card.sunnah_bukhari_449.source" = "Sahih al-Bukhari 449";

"discovery.card.sunnah_bukhari_451.title" = "Сахих аль-Бухари 451";
"discovery.card.sunnah_bukhari_451.meaning" = "Сообщается, что Суфйан (ибн ‘Уйейна) сказал:\\n— (Однажды) я сказал ‘Амру (ибн Динару):\\n— Слышал ли ты, как Джабир ибн ‘Абдуллах, да будет доволен Аллах ими обоими, говорил: «(Как-то раз, когда) один человек, нёсший с собой стрелы, проходил по мечети, Посланник Аллаха ﷺ сказал ему: “Возьмись за их острия!”?»";
"discovery.card.sunnah_bukhari_451.source" = "Sahih al-Bukhari 451";

"discovery.card.sunnah_bukhari_452.title" = "Сахих аль-Бухари 452";
"discovery.card.sunnah_bukhari_452.meaning" = "Передают со слов Абу Мусы аль-Аш‘ари, да будет доволен им Аллах, что Пророк ﷺ сказал: «Пусть тот, кто проходит по нашим мечетям или рынкам со стрелами, берётся (рукой) за их острия, чтобы не поранить кого-нибудь из мусульман»";
"discovery.card.sunnah_bukhari_452.source" = "Sahih al-Bukhari 452";

"discovery.card.sunnah_bukhari_453.title" = "Сахих аль-Бухари 453";
"discovery.card.sunnah_bukhari_453.meaning" = "Сообщается аз-Зухри сказал: \\n— Сообщил мне Абу Саляма ибн ‘Абду-р-Рахман ибн ‘Ауф о том, что он слышал, как (однажды) Хассан ибн Сабит аль-Ансари, да будет доволен им Аллах, попросил Абу Хурайру, да будет доволен им Аллах: «Заклинаю тебя Аллахом, (скажи мне,) слышал ли ты, как Пророк ﷺ сказал: “О Хассан, ответь (неверным) за Посланника Аллаха! О Аллах, поддержи его духом святым!”?» — и Абу Хурайра сказал: «Да»";
"discovery.card.sunnah_bukhari_453.source" = "Sahih al-Bukhari 453";

"discovery.card.sunnah_bukhari_459.title" = "Сахих аль-Бухари 459";
"discovery.card.sunnah_bukhari_459.meaning" = "Сообщается, что ‘Аиша, да будет доволен ею Аллах, сказала: «После того как были ниспосланы аяты о ростовщичестве из суры “аль-Бакъара”, Пророк ﷺ вышел (из дома) в мечеть и прочёл их людям, после чего запретил торговать вином»";
"discovery.card.sunnah_bukhari_459.source" = "Sahih al-Bukhari 459";

"discovery.card.sunnah_bukhari_460.title" = "Сахих аль-Бухари 460";
"discovery.card.sunnah_bukhari_460.meaning" = "Передают со слов Абу Хурайры, да будет доволен им Аллах, о том, что (в своё время) негр /или: негритянка/, подметавший полы в мечети … (Один из передатчиков этого хадиса сказал: «И я думаю, что это точно была женщина». И затем он привёл хадис о том, что Пророк ﷺ совершил над ним (заупокойную) молитву";
"discovery.card.sunnah_bukhari_460.source" = "Sahih al-Bukhari 460";

"discovery.card.sunnah_bukhari_464.title" = "Сахих аль-Бухари 464";
"discovery.card.sunnah_bukhari_464.meaning" = "Сообщается, что Умм Саляма, да будет доволен ею Аллах, сказала: «(Во время хаджжа) я пожаловалась Посланнику Аллаха ﷺ на болезнь, и он сказал: “Соверши обход позади (всех остальных) людей, сидя верхом”. Я так и сделала, а в это время Посланник Аллаха ﷺ молился рядом с Каабой, читая (суру, начинающуюся словами): “Клянусь горой, клянусь начертанным Писанием…”»";
"discovery.card.sunnah_bukhari_464.source" = "Sahih al-Bukhari 464";

"discovery.card.sunnah_bukhari_469.title" = "Сахих аль-Бухари 469";
"discovery.card.sunnah_bukhari_469.meaning" = "Сообщается, что Абу Хурайра, да будет доволен им Аллах, сказал: «(В своё время) Посланник Аллаха ﷺ отправил в сторону Неджда (отряд) всадников, которые привезли с собой человека по имени Сумама ибн Усаль из (племени) бану ханифа и привязали его к одному из столбов мечети»";
"discovery.card.sunnah_bukhari_469.source" = "Sahih al-Bukhari 469";

"discovery.card.sunnah_bukhari_475.title" = "Сахих аль-Бухари 475";
"discovery.card.sunnah_bukhari_475.meaning" = "Передают со слов ‘Абдуллаха ибн Зейда аль-Ансари, да будет доволен им Аллах, о том, что он видел, как Посланник Аллаха ﷺ лежал в мечети на спине, положив ногу на ногу. Передают со слов Ибн Шихаба о том, что Са‘ид ибн аль-Мусаййиб сказал: «‘Умар и ‘Усман тоже поступали так»";
"discovery.card.sunnah_bukhari_475.source" = "Sahih al-Bukhari 475";

"discovery.card.sunnah_bukhari_478.title" = "Сахих аль-Бухари 478";
"discovery.card.sunnah_bukhari_478.meaning" = "Вакыд (ибн Мухаммад ибн Зейд) передал от своего отца, который со слов Ибн ‘Умара или Ибн ‘Амра рассказывал: «(Однажды) Пророк ﷺ переплёл свои пальцы»";
"discovery.card.sunnah_bukhari_478.source" = "Sahih al-Bukhari 478";

"discovery.card.sunnah_bukhari_480.title" = "Сахих аль-Бухари 480";
"discovery.card.sunnah_bukhari_480.meaning" = "Сообщается, что ‘Абдуллах (ибн ‘Амр) сказал: «(Однажды) Посланник Аллаха ﷺ сказал (мне): “О ‘Абдуллах ибн ‘Амр, каково будет тебе, когда из людей останутся те, в ком нет блага?!”» (И он передал) этот же (хадис, где сказано, что он переплёл пальцы)";
"discovery.card.sunnah_bukhari_480.source" = "Sahih al-Bukhari 480";

"discovery.card.sunnah_bukhari_481.title" = "Сахих аль-Бухари 481";
"discovery.card.sunnah_bukhari_481.meaning" = "Передают со слов Абу Мусы, да будет доволен им Аллах, о том, что (однажды) Пророк ﷺ сказал: «Поистине, (в отношениях) друг с другом верующие подобны строению, отдельные части которого укрепляют друг друга», и (,сказав это,) он переплёл между собой пальцы (своих рук)";
"discovery.card.sunnah_bukhari_481.source" = "Sahih al-Bukhari 481";

"discovery.card.sunnah_bukhari_484.title" = "Сахих аль-Бухари 484";
"discovery.card.sunnah_bukhari_484.meaning" = "Нафи‘, да помилует его Аллах Всевышний, передавал со слов ‘Абдуллаха ибн ‘Умара, да будет доволен Аллах ими обоими, что во время совершения ‘умры и хаджжа Посланник Аллаха ﷺ останавливался в Зуль-Хулейфе под деревом на том месте, где потом была построена мечеть. И когда он возвращался по этой дороге после военного похода или совершения хаджжа или ‘умры, то проходил по внутренней части вади, а когда выбирался оттуда наверх, опускал свою верблюдицу на колени на открытом каменистом месте, расположенном на его восточном краю, и останавливался там на отдых до утра, но располагался не возле построенной там впоследствии мечети и не на том холме, где находится эта мечеть. ‘Абдуллах молился возле одного из ответвлений этого вади, на дне которого были песчаные дюны, где раньше совершал молитвы и Посланник Аллаха ﷺ . Впоследствии потоки воды сровняли с землёй то место, на котором молился ‘Абдуллах ибн ‘Умар";
"discovery.card.sunnah_bukhari_484.source" = "Sahih al-Bukhari 484";

"discovery.card.sunnah_bukhari_496.title" = "Сахих аль-Бухари 496";
"discovery.card.sunnah_bukhari_496.meaning" = "Сообщается, что Сахль, да будет доволен им Аллах, сказал: «Между тем местом, на котором во время молитвы находился Посланник Аллаха ﷺ и стеной оставалось (расстояние, достаточное для того, чтобы там могла) пройти овца»";
"discovery.card.sunnah_bukhari_496.source" = "Sahih al-Bukhari 496";

"discovery.card.sunnah_bukhari_497.title" = "Сахих аль-Бухари 497";
"discovery.card.sunnah_bukhari_497.meaning" = "Сообщается, что Саляма (ибн Аква‘)сказал: «Стена мечети возле минбара (была на таком расстоянии), что там могла пройти овца»";
"discovery.card.sunnah_bukhari_497.source" = "Sahih al-Bukhari 497";

"discovery.card.sunnah_bukhari_498.title" = "Сахих аль-Бухари 498";
"discovery.card.sunnah_bukhari_498.meaning" = "Передают со слов ‘Абдуллаха (ибн ‘Умара) о том, что Пророк ﷺ нередко втыкал в землю копьё, в сторону которого обращался во время молитвы";
"discovery.card.sunnah_bukhari_498.source" = "Sahih al-Bukhari 498";

"discovery.card.sunnah_bukhari_503.title" = "Сахих аль-Бухари 503";
"discovery.card.sunnah_bukhari_503.meaning" = "Сообщается, что Анас, да будет доволен им Аллах, сказал: «Я видел, как с наступлением времени закатной молитвы, виднейшие сподвижники Посланника Аллаха ﷺ спешили к столбам, опережая друга».\\nШу‘ба привёл дополнение от ‘Амра, передавшего от Анаса: «До тех пор, пока не выходил (на молитву) Пророк ﷺ»";
"discovery.card.sunnah_bukhari_503.source" = "Sahih al-Bukhari 503";

"discovery.card.sunnah_bukhari_512.title" = "Сахих аль-Бухари 512";
"discovery.card.sunnah_bukhari_512.meaning" = "Сообщается, что ‘Аиша, да будет доволен ею Аллах, сказала: «Обычно Пророк ﷺ совершал молитву, когда я лежала и спала на его ложе, и когда он хотел совершить (молитву) витр, он будил меня и я (тоже) совершала эту молитву»";
"discovery.card.sunnah_bukhari_512.source" = "Sahih al-Bukhari 512";

"discovery.card.sunnah_bukhari_515.title" = "Сахих аль-Бухари 515";
"discovery.card.sunnah_bukhari_515.meaning" = "Сообщается, что Ибн Шихаб спросил своего дядю со стороны отца о том, что прерывает молитву и тот сказал: «Ничто не может прервать её, поскольку, ‘Урва ибн аз-Зубайр рассказывал мне, что ‘Аиша, жена Пророка ﷺ сказала: “Бывало, что когда Посланник Аллаха ﷺ стоял и совершал ночную молитву, я лежала поперёк между ним и киблой на кровати его жены»";
"discovery.card.sunnah_bukhari_515.source" = "Sahih al-Bukhari 515";

"discovery.card.sunnah_bukhari_517.title" = "Сахих аль-Бухари 517";
"discovery.card.sunnah_bukhari_517.meaning" = "Сообщается, что ‘Абдуллах ибн Шаддад ибн аль-Хади сказал: «Сообщила мне моя тетя со стороны матери Маймуна бинт аль-Харис, которая сказала: “Моя постель находилась напротив места молитвы Пророка ﷺ и иногда, (края) его одежды касались меня, когда я (лежала) на своей постели”»";
"discovery.card.sunnah_bukhari_517.source" = "Sahih al-Bukhari 517";

"discovery.card.sunnah_bukhari_518.title" = "Сахих аль-Бухари 518";
"discovery.card.sunnah_bukhari_518.meaning" = "Сообщается, что ‘Абдуллах ибн Шаддад сказал: «Я слышал, как Маймуна говорила: “Пророк ﷺ часто совершал молитву, когда я спала сбоку от него. Когда он совершал земные поклоны, (края) его одежды касались меня, и в это время у меня были месячные”»";
"discovery.card.sunnah_bukhari_518.source" = "Sahih al-Bukhari 518";

"discovery.card.sunnah_bukhari_519.title" = "Сахих аль-Бухари 519";
"discovery.card.sunnah_bukhari_519.meaning" = "Сообщается, что ‘Аиша, да будет доволен ею Аллах, сказала: «Плохо то, что вы приравниваете нас (женщин) к ослам и собакам, ибо, когда Посланник Аллаха ﷺ совершал молитву, меня видели лежащей между ним и киблой. И когда он хотел совершить земной поклон, он касался моих ног, и я прибирала их»";
"discovery.card.sunnah_bukhari_519.source" = "Sahih al-Bukhari 519";

"discovery.card.sunnah_bukhari_524.title" = "Сахих аль-Бухари 524";
"discovery.card.sunnah_bukhari_524.meaning" = "Сообщается, что Джарир ибн ‘Абдуллах, да будет доволен им Аллах, сказал: «Я поклялся Посланнику Аллаха ﷺ в том, что буду совершать молитву, выплачивать закят и сердечно относиться к каждому мусульманину»";
"discovery.card.sunnah_bukhari_524.source" = "Sahih al-Bukhari 524";

"discovery.card.sunnah_bukhari_529.title" = "Сахих аль-Бухари 529";
"discovery.card.sunnah_bukhari_529.meaning" = "Сообщается, что (однажды) Анас (ибн Малик) сказал: «Не узнаю я ничего из того, что было во времена Пророка ﷺ». (Ему) сказали: «А молитва?!» Он сказал: «А разве вы не делаете в ней упущения?!»";
"discovery.card.sunnah_bukhari_529.source" = "Sahih al-Bukhari 529";

"discovery.card.sunnah_bukhari_532.title" = "Сахих аль-Бухари 532";
"discovery.card.sunnah_bukhari_532.meaning" = "Передают со слов Анаса, да будет доволен им Аллах, что Пророк ﷺ сказал: «Придерживайтесь умеренности, совершая земные поклоны, и пусть (молящийся) не касается локтями земли подобно (лежащей) собаке, а если он (захочет) сплюнуть, то пусть никогда не плюёт ни перед собой, ни направо, ибо, поистине, (во время молитвы) он ведёт тайную беседу со своим Господом!»";
"discovery.card.sunnah_bukhari_532.source" = "Sahih al-Bukhari 532";

"discovery.card.sunnah_bukhari_533.title" = "Сахих аль-Бухари 533";
"discovery.card.sunnah_bukhari_533.meaning" = "Передают со слов Абу Хурайры и ‘Абдуллаха ибн ‘Умара, да будет доволен ими Аллах, о том, что Посланник Аллаха ﷺ сказал: «Если жара будет (слишком) сильной, отложите молитву, пока не станет прохладнее, ибо, поистине, жара усиливается от расширения ада»";
"discovery.card.sunnah_bukhari_533.source" = "Sahih al-Bukhari 533";

"discovery.card.sunnah_bukhari_538.title" = "Сахих аль-Бухари 538";
"discovery.card.sunnah_bukhari_538.meaning" = "Сообщается, что Абу Са‘ид сказал: «Посланник Аллаха ﷺ сказал: “Откладывайте полуденную молитву /зухр/, ибо, поистине, жара усиливается от расширения ада”»";
"discovery.card.sunnah_bukhari_538.source" = "Sahih al-Bukhari 538";

"discovery.card.sunnah_bukhari_542.title" = "Сахих аль-Бухари 542";
"discovery.card.sunnah_bukhari_542.meaning" = "Сообщается, что Анас ибн Малик, да будет доволен им Аллах, сказал: «Обычно, когда мы молились за посланником Аллаха ﷺ во время полуденной молитвы мы совершали земные поклоны (расстилив края своей) одежды (на месте земных поклонов) из-за сильной жары»";
"discovery.card.sunnah_bukhari_542.source" = "Sahih al-Bukhari 542";

"discovery.card.sunnah_bukhari_543.title" = "Сахих аль-Бухари 543";
"discovery.card.sunnah_bukhari_543.meaning" = "Передают со слов Ибн ‘Аббаса, да будет доволен Аллах ими обоими, что (иногда) в Медине Пророк ﷺ совершал молитвы в семь и восемь рак‘атов (, объединяя) полуденную молитву с послеполуденной, а закатную — с вечерней.\\nАюб (ас-Сахтияни) спросил: «Возможно это было во время (сильного) дождя?» (Джабир ибн Зейд, который передал этот хадис от Ибн ‘Аббаса) ответил: «Возможно»";
"discovery.card.sunnah_bukhari_543.source" = "Sahih al-Bukhari 543";

"discovery.card.sunnah_bukhari_544.title" = "Сахих аль-Бухари 544";
"discovery.card.sunnah_bukhari_544.meaning" = "Передают со слов Хишама, передавшего от своего (‘Урвы ибн аз-Зубайра) о том, что ‘Аиша сказала: «Когда Посланник Аллаха ﷺ совершал послеполуденную молитву, солнечный (свет) всё ещё попадал в её комнату».\\nАбу Усама сказал: «От Хишама: “В глубь её комнаты”»";
"discovery.card.sunnah_bukhari_544.source" = "Sahih al-Bukhari 544";

"discovery.card.sunnah_bukhari_545.title" = "Сахих аль-Бухари 545";
"discovery.card.sunnah_bukhari_545.meaning" = "Narrated `Aisha:Allah's Messenger (ﷺ) used to offer the `Asr prayers at a time when the sunshine was still inside my chamber and no shadow had yet appeared in it";
"discovery.card.sunnah_bukhari_545.source" = "Sahih al-Bukhari 545";

"discovery.card.sunnah_bukhari_546.title" = "Сахих аль-Бухари 546";
"discovery.card.sunnah_bukhari_546.meaning" = "Narrated Aisha:The Prophet (ﷺ) used to pray the `Asr prayers at a time when the sunshine was still inside my chamber and no shadow had yet appeared in it";
"discovery.card.sunnah_bukhari_546.source" = "Sahih al-Bukhari 546";

"discovery.card.sunnah_bukhari_548.title" = "Сахих аль-Бухари 548";
"discovery.card.sunnah_bukhari_548.meaning" = "Сообщается, что Анас ибн Малик, да будет доволен им Аллах, сказал: «После того как мы заканчивали послеполуденную молитву, человек мог добраться до (домов людей из племени) бану ‘Амр ибн ‘Ауф и застать их за совершением этой молитвы»";
"discovery.card.sunnah_bukhari_548.source" = "Sahih al-Bukhari 548";

"discovery.card.sunnah_bukhari_551.title" = "Сахих аль-Бухари 551";
"discovery.card.sunnah_bukhari_551.meaning" = "Сообщается, что Анас ибн Малик сказал: «Мы совершали послеполуденную молитву, и (если после этого) кто-нибудь отправлялся в Кубаъ, то он добирался туда, когда солнце ещё стояло высоко»";
"discovery.card.sunnah_bukhari_551.source" = "Sahih al-Bukhari 551";

"discovery.card.sunnah_bukhari_552.title" = "Сахих аль-Бухари 552";
"discovery.card.sunnah_bukhari_552.meaning" = "Передают со слов Ибн ‘Умара, да будет доволен Аллах ими обоими, о том, что Посланник Аллаха ﷺ сказал: «(Тот человек,) который пропускает послеполуденную молитву, подобен лишившемуся своей семьи и имущества»";
"discovery.card.sunnah_bukhari_552.source" = "Sahih al-Bukhari 552";

"discovery.card.sunnah_bukhari_553.title" = "Сахих аль-Бухари 553";
"discovery.card.sunnah_bukhari_553.meaning" = "Сообщается, что Абуль-Малих сказал:\\n— Как-то в пасмурный день мы были с Бурайдой в военном походе, и Бурайда, да будет доволен им Аллах, сказал: «Совершайте послеполуденную молитву пораньше, ибо, поистине, Пророк ﷺ сказал: “Тщетными окажутся дела того, кто не совершает послеполуденную молитву”»";
"discovery.card.sunnah_bukhari_553.source" = "Sahih al-Bukhari 553";

"discovery.card.sunnah_bukhari_556.title" = "Сахих аль-Бухари 556";
"discovery.card.sunnah_bukhari_556.meaning" = "Сообщается, что Абу Хурайра, да будет доволен им Аллах, сказал: «Посланник Аллаха ﷺ сказал: “Если кто-нибудь из вас успеет совершить (хотя бы) один рак‘ат послеполуденной молитвы до захода солнца, пусть доведёт свою молитву до конца, и если успеет он совершить (хотя бы) один рак‘ат утренней молитвы до восхода солнца, пусть доведёт свою молитву до конца”»";
"discovery.card.sunnah_bukhari_556.source" = "Sahih al-Bukhari 556";

"discovery.card.sunnah_bukhari_559.title" = "Сахих аль-Бухари 559";
"discovery.card.sunnah_bukhari_559.meaning" = "Сообщается, что Рафи‘ ибн Хадидж, да будет доволен им Аллах, сказал: «Обычно после того, как мы совершали закатную молитву вместе с Пророком ﷺ и любой из нас удалялся, он ещё мог рассмотреть то место, куда упала бы стрела (, пущенная им из лука)»";
"discovery.card.sunnah_bukhari_559.source" = "Sahih al-Bukhari 559";

"discovery.card.sunnah_bukhari_561.title" = "Сахих аль-Бухари 561";
"discovery.card.sunnah_bukhari_561.meaning" = "Сообщается, что Саляма, да будет доволен им Аллах, сказал: «Мы всегда совершали закатную молитву вместе с Пророком ﷺ после того, как (солнце) скрывалось за (горизонтом)»";
"discovery.card.sunnah_bukhari_561.source" = "Sahih al-Bukhari 561";

"discovery.card.sunnah_bukhari_562.title" = "Сахих аль-Бухари 562";
"discovery.card.sunnah_bukhari_562.meaning" = "Сообщается, что Ибн ‘Аббас, да будет доволен им Аллах, сказал: «Пророк ﷺ совершил молитвы в семь и восемь рак‘атов, объединяя их»";
"discovery.card.sunnah_bukhari_562.source" = "Sahih al-Bukhari 562";

"discovery.card.sunnah_bukhari_563.title" = "Сахих аль-Бухари 563";
"discovery.card.sunnah_bukhari_563.meaning" = "Сообщается, что ‘Абдуллах ибн Бурайда сказал: «Рассказал мне ‘Абдуллах аль-Музани, да будет доволен им Аллах, о том, что Пророк ﷺ сказал: “Ни в коем случае не поддавайтесь (влиянию) бедуинов в том, что касается названия вашей закатной /магъриб/ молитвы”».\\n(‘Абдуллах аль-Музани) сказал: «Бедуины говорят: “Это вечерняя молитва /‘ишаъ/”»";
"discovery.card.sunnah_bukhari_563.source" = "Sahih al-Bukhari 563";

"discovery.card.sunnah_bukhari_568.title" = "Сахих аль-Бухари 568";
"discovery.card.sunnah_bukhari_568.meaning" = "Сообщается, что Абу Барза, да будет доволен им Аллах, сказал: «Посланник Аллаха ﷺ не любил спать до вечерней молитвы /‘иша/ и вести разговоры после неё»";
"discovery.card.sunnah_bukhari_568.source" = "Sahih al-Bukhari 568";

"discovery.card.sunnah_bukhari_574.title" = "Сахих аль-Бухари 574";
"discovery.card.sunnah_bukhari_574.meaning" = "Передают со слов Абу Мусы, да будет доволен им Аллах, о том, что Посланник Аллаха ﷺ сказал: «Вошёл в Рай тот, кто совершал две молитвы в прохладное время»";
"discovery.card.sunnah_bukhari_574.source" = "Sahih al-Bukhari 574";

"discovery.card.sunnah_bukhari_577.title" = "Сахих аль-Бухари 577";
"discovery.card.sunnah_bukhari_577.meaning" = "Передают со слов Абу Хазима о том, что он слышал, как Сахль ибн Са‘д, да будет доволен им Аллах, говорил: «Обычно во время поста я ел перед рассветом в кругу семьи, а потом мне приходилось спешить, чтобы успеть совершить утреннюю молитву с Посланником Аллаха ﷺ»";
"discovery.card.sunnah_bukhari_577.source" = "Sahih al-Bukhari 577";

"discovery.card.sunnah_bukhari_578.title" = "Сахих аль-Бухари 578";
"discovery.card.sunnah_bukhari_578.meaning" = "Сообщается, что Ибн Шихаб сказал: «Мне сообщил ‘Урва о том, что ‘Аиша рассказывала ему: “Жёны верующих присутствовали с Посланником Аллаха ﷺ на утренней молитве, покрытые плащами, а затем после окончания молитвы они возвращались к себе домой, и в рассветной темноте никто не мог их узнавать”»";
"discovery.card.sunnah_bukhari_578.source" = "Sahih al-Bukhari 578";

"discovery.card.sunnah_bukhari_579.title" = "Сахих аль-Бухари 579";
"discovery.card.sunnah_bukhari_579.meaning" = "Передают со слов Абу Хурайры о том, что Посланник Аллаха ﷺ сказал: «Тот, кто успел совершить (хотя бы) один рак‘ат утренней молитвы до восхода солнца, уже успел на утреннюю молитву, и тот, кто успел совершить (хотя бы) один рак‘ат послеполуденной молитвы до захода солнца, уже успел на послеполуденную молитву»";
"discovery.card.sunnah_bukhari_579.source" = "Sahih al-Bukhari 579";

"discovery.card.sunnah_bukhari_580.title" = "Сахих аль-Бухари 580";
"discovery.card.sunnah_bukhari_580.meaning" = "Передают со слов Абу Хурайры о том, что Посланник Аллаха ﷺ сказал: «Тот, кто застал один рак‘ат молитвы, тот застал эту молитву полностью»";
"discovery.card.sunnah_bukhari_580.source" = "Sahih al-Bukhari 580";

"discovery.card.sunnah_bukhari_581.title" = "Сахих аль-Бухари 581";
"discovery.card.sunnah_bukhari_581.meaning" = "Сообщается, что Ибн ‘Аббас, да будет доволен Аллах ими обоими, сказал: «(Многие) достойные люди, достойнейшим из которых я считал ‘Умара, говорили при мне, что Пророк ﷺ запрещал молиться после (обязательной) утренней молитвы, пока солнце не поднимется (достаточно высоко), а также после совершения послеполуденной молитвы и до (полного) захода солнца»";
"discovery.card.sunnah_bukhari_581.source" = "Sahih al-Bukhari 581";

"discovery.card.sunnah_bukhari_585.title" = "Сахих аль-Бухари 585";
"discovery.card.sunnah_bukhari_585.meaning" = "Передают со слов Ибн ‘Умара, да будет доволен Аллах ими обоими, о том, что Посланник Аллаха ﷺ сказал: «Пусть никто из вас не стремится совершать молитву ни во время восхода солнца, ни во время его захода”»";
"discovery.card.sunnah_bukhari_585.source" = "Sahih al-Bukhari 585";

"discovery.card.sunnah_bukhari_586.title" = "Сахих аль-Бухари 586";
"discovery.card.sunnah_bukhari_586.meaning" = "Сообщается, что Ибн Шихаб сказал:\\n— Рассказал мне ‘Атаъ ибн Язид о том, что он слышал, как Абу Са‘ид аль-Худри, да будет доволен им Аллах, говорил, что он слышал, как Посланник Аллаха ﷺ сказал: «Не (следует совершать никаких) молитв после утренней (обязательной) молитвы до тех пор, пока не взойдёт солнце, и после (обязательной) послеполуденной молитвы до тех пор, пока не закатится солнце»";
"discovery.card.sunnah_bukhari_586.source" = "Sahih al-Bukhari 586";

"discovery.card.sunnah_bukhari_587.title" = "Сахих аль-Бухари 587";
"discovery.card.sunnah_bukhari_587.meaning" = "Сообщается, что (как-то раз) Му‘авийа, да будет доволен им Аллах, сказал (людям): «Поистине, вы совершаете одну молитву, однако мы не видели, чтобы совершал её (в такое время) Посланник Аллаха ﷺ, в обществе которого мы находились, ибо он запретил (такие молитвы)!» — имея в виду совершение молитвы в два рак‘ата после послеполуденной молитвы";
"discovery.card.sunnah_bukhari_587.source" = "Sahih al-Bukhari 587";

"discovery.card.sunnah_bukhari_588.title" = "Сахих аль-Бухари 588";
"discovery.card.sunnah_bukhari_588.meaning" = "Сообщается, что Абу Хурайра, да будет доволен им Аллах, сказал: «Пророк ﷺ запретил (совершать) две молитвы: после утренней молитвы, пока солнце не взойдёт (на высоту копья), и после послеполуденногй молитвы /‘аср/, пока солнце не исчезнет (за горизонтом)»";
"discovery.card.sunnah_bukhari_588.source" = "Sahih al-Bukhari 588";

"discovery.card.sunnah_bukhari_589.title" = "Сахих аль-Бухари 589";
"discovery.card.sunnah_bukhari_589.meaning" = "Сообщается, что Ибн ‘Умар сказал: «Я совершаю молитву так, как видел, каким образом совершали её сподвижники. И я не запрещаю никому совершать по ночам и дням молитву, сколько он пожелает, если только он не стремится совершать её во время восхода и захода солнца»";
"discovery.card.sunnah_bukhari_589.source" = "Sahih al-Bukhari 589";

"discovery.card.sunnah_bukhari_591.title" = "Сахих аль-Бухари 591";
"discovery.card.sunnah_bukhari_591.meaning" = "Сообщается, что Хишам (ибн ‘Урва ибн аз-Зубайр) сказал: «Мой отец сообщил мне о том, что ‘Аиша, да будет доволен ею Аллах, сказала: “О племянник, находясь у меня Пророк ﷺ никогда не оставлял молитву в два рак‘ата после послеполуденной /‘аср/ молитвы”»";
"discovery.card.sunnah_bukhari_591.source" = "Sahih al-Bukhari 591";

"discovery.card.sunnah_bukhari_592.title" = "Сахих аль-Бухари 592";
"discovery.card.sunnah_bukhari_592.meaning" = "Сообщается, что ‘Аиша, да будет доволен ею Аллах, сказала: «Посланник Аллаха ﷺ никогда не забывал совершать два рак‘ата ни тайно, ни открыто: два рак‘ата перед утренней молитвой и два рак‘ата после послеполуденной молитвы»";
"discovery.card.sunnah_bukhari_592.source" = "Sahih al-Bukhari 592";

"discovery.card.sunnah_bukhari_593.title" = "Сахих аль-Бухари 593";
"discovery.card.sunnah_bukhari_593.meaning" = "Сообщается, что Абу Исхакъ сказал: «Я видел, как аль-Асвад и Масрукъ свидетельствовали о том, что ‘Аиша, да будет доволен ею Аллах, сказала: “Когда Пророк ﷺ приходил ко мне днём после послеполуденной молитвы, он всегда совершал молитву в два рак‘ата”»";
"discovery.card.sunnah_bukhari_593.source" = "Sahih al-Bukhari 593";

