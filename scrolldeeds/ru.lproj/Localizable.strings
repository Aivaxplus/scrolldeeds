"discovery.card.fact_five_prayers.title" = "Пять молитв в день";
"discovery.card.fact_five_prayers.meaning" = "Ислам стоит на пяти: свидетельство, намаз, закят, хадж и пост в Рамадан. Намаз — пять раз каждый день.";
"discovery.card.fact_five_prayers.source" = "Sahih al-Bukhari 8 · Sahih Muslim 16";

"discovery.card.fact_night_qadr.title" = "Лучше тысячи месяцев";
"discovery.card.fact_night_qadr.meaning" = "Ночь предопределения лучше тысячи месяцев. Она в Рамадан; точная ночь в Коране не названа.";
"discovery.card.fact_night_qadr.source" = "Qur’an 97:3";

"discovery.card.fact_hijrah.title" = "Хиджра";
"discovery.card.fact_hijrah.meaning" = "Пророк ﷺ переселился из Мекки в Медину. Коран упоминает помощь Аллаха ему в пещере в том пути.";
"discovery.card.fact_hijrah.source" = "Qur’an 9:40 · seerah of the Hijrah";

"discovery.card.fact_seal_prophets.title" = "Печать пророков";
"discovery.card.fact_seal_prophets.meaning" = "Коран называет Мухаммада ﷺ Посланником Аллаха и печатью пророков.";
"discovery.card.fact_seal_prophets.source" = "Qur’an 33:40";

"discovery.card.fact_two_testimonies.title" = "Нет бога, кроме Аллаха";
"discovery.card.fact_two_testimonies.meaning" = "Первая опора — засвидетельствовать, что нет бога, кроме Аллаха, и что Мухаммад ﷺ — Его посланник.";
"discovery.card.fact_two_testimonies.source" = "Qur’an 47:19 · Sahih al-Bukhari 8";

"discovery.card.fact_zakat_pillar.title" = "Закят — опора";
"discovery.card.fact_zakat_pillar.meaning" = "Коран соединяет намаз и закят. Положенный закят — одна из пяти опор ислама.";
"discovery.card.fact_zakat_pillar.source" = "Qur’an 2:43 · Sahih al-Bukhari 8";

"discovery.card.fact_hajj_pillar.title" = "Хадж к Дому";
"discovery.card.fact_hajj_pillar.meaning" = "Хадж к Каабе обязателен для того, кто найдёт к нему путь. Это одна из пяти опор.";
"discovery.card.fact_hajj_pillar.source" = "Qur’an 3:97 · Sahih al-Bukhari 8";

"discovery.card.fact_fast_ramadan.title" = "Пост предписан";
"discovery.card.fact_fast_ramadan.meaning" = "Вам предписан пост, как тем, кто был до вас, чтобы вы обрели такуа.";
"discovery.card.fact_fast_ramadan.source" = "Qur’an 2:183 · Sahih al-Bukhari 8";

"discovery.card.fact_fatiha_every_salah.title" = "Нет намаза без «Аль-Фатиха»";
"discovery.card.fact_fatiha_every_salah.meaning" = "Пророк ﷺ сказал, что нет намаза у того, кто не читает Открывающую Книгу.";
"discovery.card.fact_fatiha_every_salah.source" = "Sahih al-Bukhari 756 · Sahih Muslim 394";

"discovery.card.fact_quran_preserved.title" = "Мы его охраним";
"discovery.card.fact_quran_preserved.meaning" = "Аллах сказал о Напоминании: «Воистину, Мы ниспослали Напоминание, и Мы его охраняем».";
"discovery.card.fact_quran_preserved.source" = "Qur’an 15:9";

"discovery.card.fact_ramadan_reveal.title" = "Ниспослан в Рамадан";
"discovery.card.fact_ramadan_reveal.meaning" = "Коран был ниспослан в месяц Рамадан — как руководство для людей и ясные знамения различения.";
"discovery.card.fact_ramadan_reveal.source" = "Qur’an 2:185";

"discovery.card.fact_surah_count.title" = "114 сур";
"discovery.card.fact_surah_count.meaning" = "Коран в османском мусхафе состоит из 114 сур — от «Аль-Фатиха» до «Ан-Нас».";
"discovery.card.fact_surah_count.source" = "Uthmani mushaf";

"discovery.card.fact_juz_count.title" = "30 джузов";
"discovery.card.fact_juz_count.meaning" = "Для чтения Коран делят на 30 джузов — часто по одному за ночь в Рамадан.";
"discovery.card.fact_juz_count.source" = "Uthmani mushaf";

"discovery.card.fact_iqra_first.title" = "Первое слово: Икра";
"discovery.card.fact_iqra_first.meaning" = "Первое откровение Пророку ﷺ в пещере Хира началось словами: «Читай во имя Господа твоего, Который сотворил».";
"discovery.card.fact_iqra_first.source" = "Qur’an 96:1 · Sahih al-Bukhari 3";

"discovery.card.fact_longest_surah.title" = "Самая длинная сура";
"discovery.card.fact_longest_surah.meaning" = "«Аль-Бакара» — самая длинная сура Корана, 286 аятов. Она ниспослана в Медине.";
"discovery.card.fact_longest_surah.source" = "Uthmani mushaf · Qur’an 2";

"discovery.card.fact_shortest_surah.title" = "Самая короткая сура";
"discovery.card.fact_shortest_surah.meaning" = "«Аль-Каусар» — самая короткая сура, три аята.";
"discovery.card.fact_shortest_surah.source" = "Uthmani mushaf · Qur’an 108";

"discovery.card.fact_first_house.title" = "Первый Дом";
"discovery.card.fact_first_house.meaning" = "Коран говорит, что первый Дом, установленный для людей, — тот, что в Бакке (Мекке): благословенный и руководство для миров.";
"discovery.card.fact_first_house.source" = "Qur’an 3:96";

"discovery.card.fact_qiblah_change.title" = "Киблу повернули";
"discovery.card.fact_qiblah_change.meaning" = "Аллах повелел Пророку ﷺ обратить лицо к Заповедной мечети. Так стала кибла мусульман.";
"discovery.card.fact_qiblah_change.source" = "Qur’an 2:144";

"discovery.card.fact_arabic_quran.title" = "Арабский Коран";
"discovery.card.fact_arabic_quran.meaning" = "Коран ниспослан как арабское чтение, чтобы первые слушатели поняли его.";
"discovery.card.fact_arabic_quran.source" = "Qur’an 12:2";

"discovery.card.fact_in_stages.title" = "Ниспослан постепенно";
"discovery.card.fact_in_stages.meaning" = "Коран не был ниспослан сразу целиком. Его читали этапами в годы пророческой миссии ﷺ.";
"discovery.card.fact_in_stages.source" = "Qur’an 17:106";

"discovery.card.fact_isra.title" = "Ночное путешествие";
"discovery.card.fact_isra.meaning" = "Хвала Тому, Кто перенёс Своего раба ночью от Заповедной мечети до Отдалённейшей, окрестности которой Мы благословили.";
"discovery.card.fact_isra.source" = "Qur’an 17:1";

"discovery.card.fact_mercy_to_worlds.title" = "Милость для миров";
"discovery.card.fact_mercy_to_worlds.meaning" = "Коран говорит, что Пророк ﷺ послан только как милость для миров.";
"discovery.card.fact_mercy_to_worlds.source" = "Qur’an 21:107";

"discovery.card.fact_uswa_hasana.title" = "Прекрасный пример";
"discovery.card.fact_uswa_hasana.meaning" = "В Посланнике Аллаха ﷺ вам прекрасный пример для того, кто надеется на Аллаха и Последний день.";
"discovery.card.fact_uswa_hasana.source" = "Qur’an 33:21";

"discovery.card.fact_great_character.title" = "Великий нрав";
"discovery.card.fact_great_character.meaning" = "Аллах сказал о Пророке ﷺ: «Воистину, ты — нрава великого».";
"discovery.card.fact_great_character.source" = "Qur’an 68:4";

"discovery.card.fact_salawat.title" = "Аллах благословляет его";
"discovery.card.fact_salawat.meaning" = "Аллах и Его ангелы благословляют Пророка ﷺ. Верующим велено также благословлять его и приветствовать.";
"discovery.card.fact_salawat.source" = "Qur’an 33:56";

"discovery.card.fact_jumuah.title" = "Когда зовут на пятницу";
"discovery.card.fact_jumuah.meaning" = "Когда зовут на пятничную молитву, оставьте торговлю и спешите к поминанию Аллаха.";
"discovery.card.fact_jumuah.source" = "Qur’an 62:9";

"discovery.card.fact_wudu_ayah.title" = "Омовение в Коране";
"discovery.card.fact_wudu_ayah.meaning" = "Коран называет омовение: умывайте лица и руки до локтей, протирайте головы и мойте ноги до щиколоток.";
"discovery.card.fact_wudu_ayah.source" = "Qur’an 5:6";

"discovery.card.fact_no_compulsion.title" = "Нет принуждения в религии";
"discovery.card.fact_no_compulsion.meaning" = "Нет принуждения в религии. Прямой путь уже отличился от заблуждения.";
"discovery.card.fact_no_compulsion.source" = "Qur’an 2:256";

"discovery.card.fact_quran_easy_remember.title" = "Облегчён для поминания";
"discovery.card.fact_quran_easy_remember.meaning" = "Аллах сказал: «Воистину, Мы облегчили Коран для поминания. Есть ли поминающий?» Эти слова повторяются в суре «Аль-Камар».";
"discovery.card.fact_quran_easy_remember.source" = "Qur’an 54:17";

"discovery.card.fact_bismillah_tawbah.title" = "Без басмалы перед «Ат-Тауба»";
"discovery.card.fact_bismillah_tawbah.meaning" = "В османском мусхафе каждая сура начинается с басмалы, кроме «Ат-Тауба» (сура 9).";
"discovery.card.fact_bismillah_tawbah.source" = "Uthmani mushaf · Qur’an 9";

"discovery.card.fact_fatiha_seven.title" = "Семь повторяемых";
"discovery.card.fact_fatiha_seven.meaning" = "В «Аль-Фатиха» семь аятов. Многие учёные относят «семь повторяемых» (15:87) к ней — её читают в каждом намазе.";
"discovery.card.fact_fatiha_seven.source" = "Qur’an 15:87 · Qur’an 1";

"discovery.card.fact_ikhlas_third.title" = "«Аль-Ихлас» — треть Корана";
"discovery.card.fact_ikhlas_third.meaning" = "Пророк ﷺ сказал, что «Куль хува Аллаху ахад» («Аль-Ихлас») равна трети Корана.";
"discovery.card.fact_ikhlas_third.source" = "Sahih al-Bukhari 5015";

"discovery.card.fact_kursi_greatest.title" = "Величайший аят";
"discovery.card.fact_kursi_greatest.meaning" = "Пророк ﷺ спросил Убайя ибн Ка‘ба, какой аят в Книге Аллаха величайший. Он назвал аят аль-Курси, и Пророк ﷺ подтвердил.";
"discovery.card.fact_kursi_greatest.source" = "Sahih Muslim 810";

"discovery.card.fact_muawwidhatayn.title" = "Две защищающие суры";
"discovery.card.fact_muawwidhatayn.meaning" = "«Аль-Фалак» и «Ан-Нас» — му‘аввизатан. Пророк ﷺ читал их для защиты и учил им.";
"discovery.card.fact_muawwidhatayn.source" = "Sahih al-Bukhari 5016";

"discovery.card.fact_iman_six.title" = "Шесть столпов имана";
"discovery.card.fact_iman_six.meaning" = "Иман — вера в Аллаха, Его ангелов, Его писания, Его посланников, Последний день и предопределение — его добро и тягость.";
"discovery.card.fact_iman_six.source" = "Sahih Muslim 8 · Qur’an 4:136";

"discovery.card.fact_revealed_books.title" = "Писания, названные в Коране";
"discovery.card.fact_revealed_books.meaning" = "Помимо Корана Книга называет Тауру, Инджиль и Забур — писания, данные прежним посланникам.";
"discovery.card.fact_revealed_books.source" = "Qur’an 3:3 · Qur’an 4:163 · Qur’an 5:46";

"discovery.card.fact_twelve_months.title" = "Двенадцать месяцев у Аллаха";
"discovery.card.fact_twelve_months.meaning" = "Число месяцев у Аллаха — двенадцать, в Книге Аллаха с того дня, как Он сотворил небеса и землю; четыре из них священны.";
"discovery.card.fact_twelve_months.source" = "Qur’an 9:36";

"discovery.card.fact_maqam_ibrahim.title" = "Стоянка Ибрахима";
"discovery.card.fact_maqam_ibrahim.meaning" = "Сделайте стоянку Ибрахима местом молитвы. Коран связывает её с Домом, который Ибрахим и Исмаил должны были очищать.";
"discovery.card.fact_maqam_ibrahim.source" = "Qur’an 2:125";

"discovery.card.fact_named_prophets.title" = "25 названных пророков";
"discovery.card.fact_named_prophets.meaning" = "Коран называет двадцать пять пророков — от Адама до Мухаммада ﷺ. Другие посланники упомянуты без имён.";
"discovery.card.fact_named_prophets.source" = "Qur’an · 25 named prophets";

"discovery.card.fact_ninety_nine_names.title" = "Девяносто девять имён";
"discovery.card.fact_ninety_nine_names.meaning" = "Пророк ﷺ сказал, что у Аллаха девяносто девять имён — сто без одного; кто их перечислит, войдёт в Рай.";
"discovery.card.fact_ninety_nine_names.source" = "Sahih al-Bukhari 2736 · Sahih Muslim 2677";

"discovery.card.fact_seven_mathani.title" = "Семь повторяемых";
"discovery.card.fact_seven_mathani.meaning" = "Аллах говорит, что дал Пророку ﷺ семь повторяемых и Великий Коран. Многие учёные относят это к «Аль-Фатиха».";
"discovery.card.fact_seven_mathani.source" = "Qur’an 15:87";

"discovery.card.fact_safa_marwa.title" = "Сафа и Марва";
"discovery.card.fact_safa_marwa.meaning" = "Сафа и Марва — из обрядов Аллаха. Кто совершает хадж или умру к Дому, нет греха ходить между ними.";
"discovery.card.fact_safa_marwa.source" = "Qur’an 2:158";

"discovery.card.fact_four_sacred_named.title" = "Четыре священных месяца";
"discovery.card.fact_four_sacred_named.meaning" = "Из двенадцати месяцев четыре священны: зу-ль-када, зу-ль-хиджа, мухаррам и раджаб — тот, что между джумада и шаабаном.";
"discovery.card.fact_four_sacred_named.source" = "Qur’an 9:36 · Sahih al-Bukhari 3197";

"discovery.card.fact_three_mosques.title" = "Три мечети для путешествия";
"discovery.card.fact_three_mosques.meaning" = "Пророк ﷺ сказал: не отправляйтесь в путь к мечети, кроме трёх: Заповедной, этой моей мечети и Аль-Акса.";
"discovery.card.fact_three_mosques.source" = "Sahih al-Bukhari 1189 · Sahih Muslim 1397";

"discovery.card.fact_last_two_baqarah.title" = "Последние два аята «Аль-Бакара»";
"discovery.card.fact_last_two_baqarah.meaning" = "Пророк ﷺ сказал: кто прочтёт ночью последние два аята «Аль-Бакара», они ему достаточны.";
"discovery.card.fact_last_two_baqarah.source" = "Sahih al-Bukhari 5009 · Sahih Muslim 808";

"discovery.card.fact_best_days_dhulhijjah.title" = "Лучшие дни года";
"discovery.card.fact_best_days_dhulhijjah.meaning" = "Пророк ﷺ сказал, что нет дней, в которые праведные дела любимее Аллаху, чем эти десять — первые десять зу-ль-хиджи.";
"discovery.card.fact_best_days_dhulhijjah.source" = "Sahih al-Bukhari 969";

"discovery.card.fact_ayah_total.title" = "6236 аятов";
"discovery.card.fact_ayah_total.meaning" = "В обычном османском мусхафе Хафса 6236 аятов в 114 сурах.";
"discovery.card.fact_ayah_total.source" = "Uthmani Hafs mushaf count";

"discovery.card.fact_bismillah_openings.title" = "113 сур начинаются с «Бисмиллях»";
"discovery.card.fact_bismillah_openings.meaning" = "113 сур открываются «Бисмиллях». «Ат-Тауба» — нет. Ещё одно «Бисмиллях» в письме Сулеймана (27:30).";
"discovery.card.fact_bismillah_openings.source" = "Uthmani mushaf · Qur’an 27:30";

"discovery.card.fact_word_allah.title" = "«Аллах» написано 2265 раз";
"discovery.card.fact_word_allah.meaning" = "В османском тексте Хафса имя Аллах (الله) встречается 2265 раз как написанное слово — без «Аллахумма».";
"discovery.card.fact_word_allah.source" = "Uthmani Hafs mushaf count";

"discovery.card.fact_word_rahman.title" = "«Ар-Рахман» 157 раз";
