"knowledge.card.bismillah_food.title" = "Начинай с Бисмиллях";
"knowledge.card.bismillah_food.arabic" = "بِسْمِ اللَّهِ";
"knowledge.card.bismillah_food.body" = "Начинай есть и пить с имени Аллаха. Если забыл в начале, скажи Бисмиллях в начале и в конце.";
"knowledge.card.bismillah_food.source" = "Sunan Abi Dawud 3767";

"knowledge.card.right_hand.title" = "Ешь правой рукой";
"knowledge.card.right_hand.arabic" = "";
"knowledge.card.right_hand.body" = "Пророк ﷺ учил есть и пить правой рукой. Тихая сунна за каждой трапезой.";
"knowledge.card.right_hand.source" = "Sahih Muslim 2020";

"knowledge.card.remove_harm.title" = "Убери вред с дороги";
"knowledge.card.remove_harm.arabic" = "";
"knowledge.card.remove_harm.body" = "Убрать что-то вредное с дороги — ветвь веры. Иман включает дела, которые можно делать на ходу.";
"knowledge.card.remove_harm.source" = "Sahih Muslim 35";

"knowledge.card.greet_salam.title" = "Распространяй салам";
"knowledge.card.greet_salam.arabic" = "السَّلَامُ عَلَيْكُمْ";
"knowledge.card.greet_salam.body" = "Приветствуй тех, кого знаешь, и тех, кого не знаешь. Распространять салам — из ислама.";
"knowledge.card.greet_salam.source" = "Sahih al-Bukhari 28 · Sahih Muslim 39";

"knowledge.card.miswak.title" = "Сивак";
"knowledge.card.miswak.arabic" = "";
"knowledge.card.miswak.body" = "Сивак очищает рот и угождает Господу. Маленькая палочка, любимая сунна.";
"knowledge.card.miswak.source" = "Sahih al-Bukhari 1934";

"knowledge.card.anger_sit.title" = "Когда поднимается гнев — сядь";
"knowledge.card.anger_sit.arabic" = "";
"knowledge.card.anger_sit.body" = "Если стоишь — сядь. Если сидишь — ляг. Гнев от шайтана: смени позу, пока он не сменил тебя.";
"knowledge.card.anger_sit.source" = "Sunan Abi Dawud 4782";

"knowledge.card.even_date.title" = "Даже половина финика";
"knowledge.card.even_date.arabic" = "";
"knowledge.card.even_date.body" = "Защити себя от Огня хотя бы половиной финика в качестве садаки. Нет слишком малого дара, если он искренен.";
"knowledge.card.even_date.source" = "Sahih al-Bukhari 1417";

"knowledge.card.ayatul_kursi.title" = "Аят аль-Курси";
"knowledge.card.ayatul_kursi.arabic" = "اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ";
"knowledge.card.ayatul_kursi.body" = "Читай его после каждой молитвы и перед сном. Аят защиты, ночь под заботой Аллаха.";
"knowledge.card.ayatul_kursi.source" = "Коран 2:255 · Sahih al-Bukhari 2311";

"knowledge.card.ikhlas.title" = "Сура аль-Ихляс";
"knowledge.card.ikhlas.arabic" = "قُلْ هُوَ اللَّهُ أَحَدٌ";
"knowledge.card.ikhlas.body" = "Равна трети Корана по награде. Несколько строк на языке — большой вес у Аллаха.";
"knowledge.card.ikhlas.source" = "Sahih al-Bukhari 5013";

"knowledge.card.wudu_sleep.title" = "Спи с вуду";
"knowledge.card.wudu_sleep.arabic" = "";
"knowledge.card.wudu_sleep.body" = "Пророк ﷺ советовал ложиться спать в состоянии вуду. Заверши день так же, как начал: чистым для Аллаха.";
"knowledge.card.wudu_sleep.source" = "Sahih al-Bukhari 247";

"knowledge.card.visit_sick.title" = "Навести больного";
"knowledge.card.visit_sick.arabic" = "";
"knowledge.card.visit_sick.body" = "Навещать больного — право мусульманина на мусульманина. Присутствие — это дело, не только слова.";
"knowledge.card.visit_sick.source" = "Sahih Muslim 2162";

