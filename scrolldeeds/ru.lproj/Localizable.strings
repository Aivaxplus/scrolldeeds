"discovery.explain.allah_name.title" = "%@ — имя Аллаха";
"discovery.explain.allah_name.body" = "%@ — одно из имён Аллаха. Это имя милости принадлежит только Ему.";
"discovery.explain.muqattaat.body" = "%@ — буквы, которыми Аллах открыл эту суру. Их точный смысл известен Аллаху.";

"discovery.card.smile.title" = "Улыбка — это садака";
"discovery.card.smile.meaning" = "Пророк ﷺ сказал: «Твоя улыбка в лицо брату — это садака».";
"discovery.card.smile.source" = "Jami‘ at-Tirmidhi 1956 (hasan)";

"discovery.card.salam.title" = "Распространяй салям";
"discovery.card.salam.meaning" = "Спросили, какой ислам лучше. Пророк ﷺ сказал: кормить людей и приветствовать салямом тех, кого знаешь, и тех, кого не знаешь. Он также сказал: распространяйте приветствие мира между собой.";
"discovery.card.salam.source" = "Sahih al-Bukhari 28 · Sahih Muslim 54";

"discovery.card.right_hand.title" = "Ешь правой рукой";
"discovery.card.right_hand.meaning" = "Пророк ﷺ сказал: «Когда кто-то из вас ест, пусть ест правой рукой, и когда пьёт — пусть пьёт правой, ибо шайтан ест и пьёт левой».";
"discovery.card.right_hand.source" = "Sahih Muslim 2020";

"discovery.card.bismillah_eat.title" = "Начинай с Бисмиллях";
"discovery.card.bismillah_eat.meaning" = "Пророк ﷺ сказал: когда кто-то из вас ест, пусть помянет имя Аллаха. Если забудет в начале, пусть скажет: «С именем Аллаха в её начале и в её конце».";
"discovery.card.bismillah_eat.source" = "Sunan Abi Dawud 3767 · Jami‘ at-Tirmidhi 1858";

"discovery.card.right_shoe.title" = "Начинай с правой сандалии";
"discovery.card.right_shoe.meaning" = "Пророк ﷺ сказал: «Если кто-то из вас надевает сандалии, пусть начнёт с правой; а когда снимает — с левой».";
"discovery.card.right_shoe.source" = "Sahih al-Bukhari 5855";

"discovery.card.siwak.title" = "Сивак";
"discovery.card.siwak.meaning" = "Пророк ﷺ сказал: «Если бы я не боялся затруднить свою умму, то повелел бы им пользоваться сиваком при каждой молитве».";
"discovery.card.siwak.source" = "Sahih al-Bukhari 887 · Sahih Muslim 252";

"discovery.card.anger.title" = "Сила — в сдерживании гнева";
"discovery.card.anger.meaning" = "Пророк ﷺ сказал: «Сильный не тот, кто побеждает людей силой; сильный тот, кто владеет собой в гневе».";
"discovery.card.anger.source" = "Sahih al-Bukhari 6114 · Sahih Muslim 2609";

"discovery.card.visit_sick.title" = "Навещай больного";
"discovery.card.visit_sick.meaning" = "Пророк ﷺ сказал: «Права мусульманина на мусульманина — пять: ответить на приветствие, навестить больного, проводить похороны, принять приглашение и сказать чихнувшему “ярхамука-Ллах”».";
"discovery.card.visit_sick.source" = "Sahih al-Bukhari 1240 · Sahih Muslim 2162";

"discovery.card.two_words.title" = "Два слова, тяжёлые на Весах";
"discovery.card.two_words.meaning" = "Пророк ﷺ сказал: «Есть два слова, лёгкие на языке, тяжёлые на Весах и любимые Милостивым: Пречист Аллах и хвала Ему; пречист Аллах Великий».";
"discovery.card.two_words.source" = "Sahih al-Bukhari 6406 · Sahih Muslim 2694";

"discovery.card.ease.title" = "С тягостью — облегчение";
"discovery.card.ease.meaning" = "Аллах говорит: «Поистине, с тягостью приходит облегчение». Облегчение обещано вместе с трудностью — не только после неё.";
"discovery.card.ease.source" = "Коран 94:5–6";

"discovery.card.neighbor.title" = "Почитай соседа";
"discovery.card.neighbor.meaning" = "Пророк ﷺ сказал: «Джибриль всё советовал мне о соседе, пока я не подумал, что он сделает его наследником».";
"discovery.card.neighbor.source" = "Sahih al-Bukhari 6014 · Sahih Muslim 2624";

"discovery.card.knowledge.title" = "Господи, увеличь мне знание";
"discovery.card.knowledge.meaning" = "Аллах научил Своего Посланника ﷺ этой мольбе: «Господи, увеличь мне знание».";
"discovery.card.knowledge.source" = "Коран 20:114";

"discovery.card.intention.title" = "Дела — по намерениям";
"discovery.card.intention.meaning" = "Пророк ﷺ сказал: «Поистине, дела — только по намерениям, и каждому человеку — то, что он намеревался».";
"discovery.card.intention.source" = "Sahih al-Bukhari 1 · Sahih Muslim 1907";

"discovery.card.half_date.title" = "Хотя бы половина финика";
"discovery.card.half_date.meaning" = "Пророк ﷺ сказал: «Защитите себя от Огня, хотя бы половинкой финика в качестве садаки».";
"discovery.card.half_date.source" = "Sahih al-Bukhari 1417 · Sahih Muslim 1016";

"discovery.card.remove_harm.title" = "Убери вред с дороги";
"discovery.card.remove_harm.meaning" = "Пророк ﷺ сказал: «Вера состоит более чем из семидесяти ветвей. Наивысшая — слова “нет бога, кроме Аллаха”, а низшая — убрать с дороги то, что вредит».";
"discovery.card.remove_harm.source" = "Sahih Muslim 35";

"discovery.card.ikhlas.title" = "Сура «аль-Ихлас»";
"discovery.card.ikhlas.meaning" = "Пророк ﷺ сказал, что «Скажи: Он — Аллах, Единый» равна трети Корана.";
"discovery.card.ikhlas.source" = "Коран 112 · Sahih al-Bukhari 5013";

"discovery.card.kursi.title" = "Аят аль-Курси";
"discovery.card.kursi.meaning" = "«Аллах — нет бога, кроме Него, Живого, Поддерживающего всё сущее». В достоверном сообщении тому, кто прочитал этот аят ночью, сказали, что его будут охранять до утра, и Пророк ﷺ подтвердил это.";
"discovery.card.kursi.source" = "Коран 2:255 · Sahih al-Bukhari 2311";

"discovery.card.mercy.title" = "Будь милостив";
"discovery.card.mercy.meaning" = "Пророк ﷺ сказал: «Аллах не помилует тех, кто не милует людей».";
"discovery.card.mercy.source" = "Sahih al-Bukhari 7376 · Sahih Muslim 2319";

"discovery.card.parents.title" = "Не говори даже «уфф»";
"discovery.card.parents.meaning" = "Аллах говорит: «Твой Господь повелел, чтобы вы не поклонялись никому, кроме Него, и чтобы вы относились к родителям благородно. Если один из них или оба достигнут старости при тебе, не говори им “уфф” и не отталкивай их, а говори им благородное слово».";
"discovery.card.parents.source" = "Коран 17:23";

"discovery.card.backbite.title" = "Не злословьте";
"discovery.card.backbite.meaning" = "Аллах говорит: «Не следите друг за другом и не злословьте. Разве кто-то из вас захотел бы есть мясо своего мёртвого брата? Вы бы возненавидели это».";
"discovery.card.backbite.source" = "Коран 49:12";

"discovery.card.inshaallah.title" = "Говори ин ша Аллах";
"discovery.card.inshaallah.meaning" = "Аллах говорит: «И никогда не говори о чём-либо: “Я сделаю это завтра”, не добавив: “Если пожелает Аллах”».";
"discovery.card.inshaallah.source" = "Коран 18:23–24";

"discovery.card.purification.title" = "Очищение — половина веры";
"discovery.card.purification.meaning" = "Пророк ﷺ сказал: «Очищение — половина веры».";
"discovery.card.purification.source" = "Sahih Muslim 223";

"discovery.card.conceal.title" = "Покрой чужой недостаток";
"discovery.card.conceal.meaning" = "Пророк ﷺ сказал: «Кто покроет [недостаток] мусульманина, того Аллах покроет в День воскресения».";
"discovery.card.conceal.source" = "Sahih al-Bukhari 2442 · Sahih Muslim 2580";

"discovery.card.night_prayer.title" = "Ночная молитва";
"discovery.card.night_prayer.meaning" = "Пророк ﷺ сказал: «Лучшая молитва после обязательных — молитва ночью».";
"discovery.card.night_prayer.source" = "Sahih Muslim 1163";

"discovery.card.return_salam.title" = "Ответь на приветствие";
"discovery.card.return_salam.meaning" = "Аллах говорит: «Когда вас приветствуют, отвечайте ещё лучшим приветствием или тем же. Поистине, Аллах ведёт счёт всякой вещи».";
"discovery.card.return_salam.source" = "Коран 4:86";

"discovery.card.patience.title" = "Ищите помощи в терпении и молитве";
"discovery.card.patience.meaning" = "Аллах говорит: «О те, которые уверовали! Ищите помощи в терпении и молитве. Поистине, Аллах — с терпеливыми».";
"discovery.card.patience.source" = "Коран 2:153";

"discovery.card.tawakkul.title" = "Аллаха достаточно";
"discovery.card.tawakkul.meaning" = "Аллах говорит: «И кто уповает на Аллаха — тому Он достаточен. Поистине, Аллах доводит Своё дело до конца».";
"discovery.card.tawakkul.source" = "Коран 65:3";

"discovery.card.istighfar.title" = "Проси прощения часто";
"discovery.card.istighfar.meaning" = "Пророк ﷺ сказал: «Клянусь Аллахом, я прошу у Аллаха прощения и каюсь перед Ним более семидесяти раз в день».";
"discovery.card.istighfar.source" = "Sahih al-Bukhari 6307";

"discovery.card.wudu_sleep.title" = "Спи с омовением";
"discovery.card.wudu_sleep.meaning" = "Пророк ﷺ сказал: «Когда ты ложишься спать, соверши омовение, как для молитвы, затем ляг на правый бок».";
"discovery.card.wudu_sleep.source" = "Sahih al-Bukhari 247 · Sahih Muslim 2710";

"discovery.card.enter_home.title" = "Поминай Аллаха, входя в дом";
"discovery.card.enter_home.meaning" = "Пророк ﷺ сказал: когда человек входит в свой дом и поминает Аллаха при входе и при еде, шайтан говорит: «Нет вам ни ночлега, ни ужина».";
"discovery.card.enter_home.source" = "Sahih Muslim 2018";

"discovery.card.lower_gaze.title" = "Опускай взгляд";
"discovery.card.lower_gaze.meaning" = "Аллах говорит: «Скажи верующим мужчинам, чтобы они опускали свои взоры и оберегали целомудрие. Это чище для них. Поистине, Аллах ведает о том, что они делают».";
"discovery.card.lower_gaze.source" = "Коран 24:30";

"discovery.card.upper_hand.title" = "Верхняя рука";
"discovery.card.upper_hand.meaning" = "Пророк ﷺ сказал: «Верхняя рука лучше нижней. Верхняя — дающая, а нижняя — просящая».";
"discovery.card.upper_hand.source" = "Sahih al-Bukhari 1427 · Sahih Muslim 1033";

"discovery.card.fatiha.title" = "Открывающая";
"discovery.card.fatiha.meaning" = "Пророк ﷺ сказал, что Аллах говорит: Я разделил молитву между Собой и Моим рабом пополам. Когда он говорит: «Хвала Аллаху, Господу миров», Аллах говорит: Мой раб воздал Мне хвалу.";
"discovery.card.fatiha.source" = "Коран 1 · Sahih Muslim 395";

"discovery.card.honor_guest.title" = "Почитай гостя";
"discovery.card.honor_guest.meaning" = "Пророк ﷺ сказал: «Кто верует в Аллаха и в Последний день, пусть почитает своего гостя».";
"discovery.card.honor_guest.source" = "Sahih al-Bukhari 6018 · Sahih Muslim 47";

"discovery.card.love_brother.title" = "Желай брату того же";
"discovery.card.love_brother.meaning" = "Пророк ﷺ сказал: «Не уверует никто из вас [по-настоящему], пока не полюбит для своего брата того, что любит для себя».";
"discovery.card.love_brother.source" = "Sahih al-Bukhari 13 · Sahih Muslim 45";

"discovery.card.remember_me.title" = "Поминайте Меня — Я помяну вас";
"discovery.card.remember_me.meaning" = "Аллах говорит: «Так поминайте Меня — Я помяну вас. И благодарите Меня и не отрицайте Меня».";
"discovery.card.remember_me.source" = "Коран 2:152";

"discovery.card.no_envy.title" = "Не завидуйте";
"discovery.card.no_envy.meaning" = "Пророк ﷺ сказал: «Не завидуйте друг другу, не ненавидьте друг друга, не отворачивайтесь друг от друга и будьте, о рабы Аллаха, братьями».";
"discovery.card.no_envy.source" = "Sahih al-Bukhari 6065 · Sahih Muslim 2563";

"discovery.card.truthfulness.title" = "Правдивость ведёт в Рай";
"discovery.card.truthfulness.meaning" = "Пророк ﷺ сказал: «Правдивость ведёт к благочестию, а благочестие ведёт в Рай. Человек продолжает быть правдивым, пока не будет записан у Аллаха как сыддик».";
"discovery.card.truthfulness.source" = "Sahih al-Bukhari 6094 · Sahih Muslim 2607";

"discovery.card.ghusl_friday.title" = "Гусль в пятницу";
"discovery.card.ghusl_friday.meaning" = "Пророк ﷺ сказал: «Полное омовение в пятницу обязательно для каждого взрослого».";
"discovery.card.ghusl_friday.source" = "Sahih al-Bukhari 879 · Sahih Muslim 846";

"discovery.card.speak_good.title" = "Говори благое или молчи";
"discovery.card.speak_good.meaning" = "Пророк ﷺ сказал: «Кто верует в Аллаха и в Последний день, пусть говорит благое или молчит».";
"discovery.card.speak_good.source" = "Sahih al-Bukhari 6018 · Sahih Muslim 47";

"discovery.card.fajr_sunnah.title" = "Два ракаата Фаджра";
"discovery.card.fajr_sunnah.meaning" = "Пророк ﷺ сказал: «Два ракаата Фаджра лучше этого мира и всего, что в нём».";
"discovery.card.fajr_sunnah.source" = "Sahih Muslim 725";

"discovery.card.haya.title" = "Стыдливость — от веры";
"discovery.card.haya.meaning" = "Пророк ﷺ сказал: «Стыдливость — ветвь веры».";
"discovery.card.haya.source" = "Sahih al-Bukhari 9 · Sahih Muslim 35";

"discovery.card.no_burden.title" = "Аллах не возлагает сверх сил";
"discovery.card.no_burden.meaning" = "Аллах говорит: «Аллах не возлагает на душу ничего, кроме того, что ей по силам».";
"discovery.card.no_burden.source" = "Коран 2:286";

"discovery.card.mankind.title" = "Знатность — в богобоязненности";
"discovery.card.mankind.meaning" = "Аллах говорит: «О люди! Мы создали вас из мужчины и женщины и сделали вас народами и племенами, чтобы вы узнавали друг друга. Самый почтенный из вас пред Аллахом — самый богобоязненный».";
"discovery.card.mankind.source" = "Коран 49:13";

