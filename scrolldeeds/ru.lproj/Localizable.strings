"discovery.card.fact_rahman_refrain.title" = "Какую из милостей — 31 раз";
"discovery.card.fact_rahman_refrain.meaning" = "Аят «Какую же из милостей Господа вашего вы сочтёте ложью?» написан 31 раз в суре «Ар-Рахман».";
"discovery.card.fact_rahman_refrain.source" = "Qur’an 55";

"discovery.card.fact_mursalat_refrain.title" = "Горе в тот день — 10 раз";
