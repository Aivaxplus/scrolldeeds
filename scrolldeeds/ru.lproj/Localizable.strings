"discovery.card.fact_qamar_easy_repeat.title" = "Облегчён для поминания — 4 раза";
"discovery.card.fact_qamar_easy_repeat.meaning" = "Слова «Мы облегчили Коран для поминания. Но есть ли поминающие?» встречаются 4 раза в суре «Аль-Камар».";
"discovery.card.fact_qamar_easy_repeat.source" = "Qur’an 54:17 · 54:22 · 54:32 · 54:40";

"discovery.card.fact_word_salah.title" = "«Ас-салят» 58 раз";
"discovery.card.fact_word_salah.meaning" = "В османском тексте Хафса слово «ас-салят» (молитва) встречается 58 раз.";
"discovery.card.fact_word_salah.source" = "Uthmani Hafs mushaf count";

