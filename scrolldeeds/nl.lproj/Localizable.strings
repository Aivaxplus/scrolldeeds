"discovery.card.fact_prophet_salih.source" = "Qur’an 11:61";

"discovery.card.fact_prophet_ibrahim.title" = "Profeet Ibrahim";
"discovery.card.fact_prophet_ibrahim.meaning" = "De Koran noemt de profeet Ibrahim. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_ibrahim.source" = "Qur’an 2:124";

"discovery.card.fact_prophet_lut.title" = "Profeet Lut";
"discovery.card.fact_prophet_lut.meaning" = "De Koran noemt de profeet Lut. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_lut.source" = "Qur’an 21:74";

"discovery.card.fact_prophet_ismail.title" = "Profeet Ismail";
"discovery.card.fact_prophet_ismail.meaning" = "De Koran noemt de profeet Ismail. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_ismail.source" = "Qur’an 2:125";

"discovery.card.fact_prophet_ishaq.title" = "Profeet Ishaq";
"discovery.card.fact_prophet_ishaq.meaning" = "De Koran noemt de profeet Ishaq. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_ishaq.source" = "Qur’an 11:71";

"discovery.card.fact_prophet_yaqub.title" = "Profeet Yaqub";
"discovery.card.fact_prophet_yaqub.meaning" = "De Koran noemt de profeet Yaqub. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_yaqub.source" = "Qur’an 2:132";

"discovery.card.fact_prophet_yusuf.title" = "Profeet Yusuf";
"discovery.card.fact_prophet_yusuf.meaning" = "De Koran noemt de profeet Yusuf. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_yusuf.source" = "Qur’an 12:4";

"discovery.card.fact_prophet_ayyub.title" = "Profeet Ayyub";
"discovery.card.fact_prophet_ayyub.meaning" = "De Koran noemt de profeet Ayyub. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_ayyub.source" = "Qur’an 21:83";

"discovery.card.fact_prophet_shuayb.title" = "Profeet Shuayb";
"discovery.card.fact_prophet_shuayb.meaning" = "De Koran noemt de profeet Shuayb. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_shuayb.source" = "Qur’an 11:84";

"discovery.card.fact_prophet_musa.title" = "Profeet Musa";
"discovery.card.fact_prophet_musa.meaning" = "De Koran noemt de profeet Musa. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_musa.source" = "Qur’an 20:9";

"discovery.card.fact_prophet_harun.title" = "Profeet Harun";
"discovery.card.fact_prophet_harun.meaning" = "De Koran noemt de profeet Harun. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_harun.source" = "Qur’an 20:30";

"discovery.card.fact_prophet_dhulkifl.title" = "Profeet Dhul-Kifl";
"discovery.card.fact_prophet_dhulkifl.meaning" = "De Koran noemt de profeet Dhul-Kifl. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_dhulkifl.source" = "Qur’an 21:85";

"discovery.card.fact_prophet_dawud.title" = "Profeet Dawud";
"discovery.card.fact_prophet_dawud.meaning" = "De Koran noemt de profeet Dawud. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_dawud.source" = "Qur’an 38:17";

"discovery.card.fact_prophet_sulayman.title" = "Profeet Sulayman";
"discovery.card.fact_prophet_sulayman.meaning" = "De Koran noemt de profeet Sulayman. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_sulayman.source" = "Qur’an 27:16";

"discovery.card.fact_prophet_ilyas.title" = "Profeet Ilyas";
"discovery.card.fact_prophet_ilyas.meaning" = "De Koran noemt de profeet Ilyas. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_ilyas.source" = "Qur’an 37:123";

"discovery.card.fact_prophet_alyasa.title" = "Profeet Al-Yasa";
"discovery.card.fact_prophet_alyasa.meaning" = "De Koran noemt de profeet Al-Yasa. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_alyasa.source" = "Qur’an 6:86";

"discovery.card.fact_prophet_yunus.title" = "Profeet Yunus";
"discovery.card.fact_prophet_yunus.meaning" = "De Koran noemt de profeet Yunus. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_yunus.source" = "Qur’an 37:139";

"discovery.card.fact_prophet_zakariyya.title" = "Profeet Zakariyya";
"discovery.card.fact_prophet_zakariyya.meaning" = "De Koran noemt de profeet Zakariyya. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_zakariyya.source" = "Qur’an 19:2";

"discovery.card.fact_prophet_yahya.title" = "Profeet Yahya";
"discovery.card.fact_prophet_yahya.meaning" = "De Koran noemt de profeet Yahya. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_yahya.source" = "Qur’an 19:7";

"discovery.card.fact_prophet_isa.title" = "Profeet Isa";
"discovery.card.fact_prophet_isa.meaning" = "De Koran noemt de profeet Isa. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_isa.source" = "Qur’an 3:45";

"discovery.card.fact_prophet_muhammad.title" = "Profeet Muhammad ﷺ";
"discovery.card.fact_prophet_muhammad.meaning" = "De Koran noemt de profeet Muhammad ﷺ. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_muhammad.source" = "Qur’an 33:40";

"discovery.card.fact_five_prayers.title" = "Vijf dagelijkse gebeden";
"discovery.card.fact_five_prayers.meaning" = "De islam rust op vijf: de geloofsgetuigenis, salah, zakat, hadj en vasten in Ramadan. Salah is vijf keer per dag.";
"discovery.card.fact_five_prayers.source" = "Sahih al-Bukhari 8 · Sahih Muslim 16";

"discovery.card.fact_night_qadr.title" = "Beter dan duizend maanden";
"discovery.card.fact_night_qadr.meaning" = "Laylat al-Qadr is beter dan duizend maanden. Ze valt in Ramadan; de exacte nacht staat niet in de Koran vast.";
"discovery.card.fact_night_qadr.source" = "Qur’an 97:3";

"discovery.card.fact_hijrah.title" = "De hidjra";
"discovery.card.fact_hijrah.meaning" = "De Profeet ﷺ emigreerde van Mekka naar Medina. De Koran noemt Allahs hulp aan hem in de grot op die reis.";
"discovery.card.fact_hijrah.source" = "Qur’an 9:40 · seerah of the Hijrah";

"discovery.card.fact_seal_prophets.title" = "Het zegel der profeten";
"discovery.card.fact_seal_prophets.meaning" = "De Koran noemt Mohammed ﷺ de Boodschapper van Allah en het zegel van de profeten.";
"discovery.card.fact_seal_prophets.source" = "Qur’an 33:40";

"discovery.card.fact_two_testimonies.title" = "Er is geen god dan Allah";
"discovery.card.fact_two_testimonies.meaning" = "De eerste pilaar is getuigen dat er geen god is dan Allah, en dat Mohammed ﷺ Zijn boodschapper is.";
"discovery.card.fact_two_testimonies.source" = "Qur’an 47:19 · Sahih al-Bukhari 8";

"discovery.card.fact_zakat_pillar.title" = "Zakat is een pilaar";
"discovery.card.fact_zakat_pillar.meaning" = "De Koran koppelt salah aan zakat. De verplichte aalmoes is een van de vijf pilaren van de islam.";
"discovery.card.fact_zakat_pillar.source" = "Qur’an 2:43 · Sahih al-Bukhari 8";

"discovery.card.fact_hajj_pillar.title" = "Hadj naar het Huis";
"discovery.card.fact_hajj_pillar.meaning" = "De hadj naar de Kaaba is een plicht voor wie er een weg naartoe vindt. Het is een van de vijf pilaren.";
"discovery.card.fact_hajj_pillar.source" = "Qur’an 3:97 · Sahih al-Bukhari 8";

"discovery.card.fact_fast_ramadan.title" = "Vasten is voorgeschreven";
"discovery.card.fact_fast_ramadan.meaning" = "Vasten is jullie voorgeschreven zoals het hen vóór jullie was voorgeschreven, opdat jullie taqwa zouden krijgen.";
"discovery.card.fact_fast_ramadan.source" = "Qur’an 2:183 · Sahih al-Bukhari 8";

"discovery.card.fact_fatiha_every_salah.title" = "Geen salah zonder Al-Fatiha";
"discovery.card.fact_fatiha_every_salah.meaning" = "De Profeet ﷺ zei dat er geen salah is voor wie de Opening van het Boek niet reciteert.";
"discovery.card.fact_fatiha_every_salah.source" = "Sahih al-Bukhari 756 · Sahih Muslim 394";

"discovery.card.fact_quran_preserved.title" = "Wij zullen hem bewaren";
"discovery.card.fact_quran_preserved.meaning" = "Allah zei over de Vermaning: “Voorwaar, Wij hebben de Vermaning neergezonden, en Wij zullen haar waarlijk bewaren.”";
"discovery.card.fact_quran_preserved.source" = "Qur’an 15:9";

"discovery.card.fact_ramadan_reveal.title" = "Neergezonden in Ramadan";
"discovery.card.fact_ramadan_reveal.meaning" = "De Koran is neergezonden in de maand Ramadan, als leiding voor de mensen en duidelijke bewijzen van het onderscheid.";
"discovery.card.fact_ramadan_reveal.source" = "Qur’an 2:185";

"discovery.card.fact_surah_count.title" = "114 soera’s";
"discovery.card.fact_surah_count.meaning" = "De Koran in de Oethmaanse mushaf telt 114 soera’s, van Al-Fatiha tot An-Nas.";
"discovery.card.fact_surah_count.source" = "Uthmani mushaf";

"discovery.card.fact_juz_count.title" = "30 djoez";
"discovery.card.fact_juz_count.meaning" = "Voor recitatie is de Koran verdeeld in 30 djoez — vaak één per nacht bij een khatm in Ramadan.";
"discovery.card.fact_juz_count.source" = "Uthmani mushaf";

"discovery.card.fact_iqra_first.title" = "Het eerste woord: Iqra";
"discovery.card.fact_iqra_first.meaning" = "De eerste openbaring aan de Profeet ﷺ in de grot van Hira begon met: “Lees, in de naam van jouw Heer die schiep.”";
"discovery.card.fact_iqra_first.source" = "Qur’an 96:1 · Sahih al-Bukhari 3";

"discovery.card.fact_longest_surah.title" = "De langste soera";
"discovery.card.fact_longest_surah.meaning" = "Al-Baqarah is de langste soera in de Koran, met 286 verzen. Ze is in Medina neergezonden.";
"discovery.card.fact_longest_surah.source" = "Uthmani mushaf · Qur’an 2";

"discovery.card.fact_shortest_surah.title" = "De kortste soera";
"discovery.card.fact_shortest_surah.meaning" = "Al-Kawthar is de kortste soera, met drie verzen.";
"discovery.card.fact_shortest_surah.source" = "Uthmani mushaf · Qur’an 108";

"discovery.card.fact_first_house.title" = "Het eerste Huis";
"discovery.card.fact_first_house.meaning" = "De Koran zegt dat het eerste Huis dat voor de mensen is ingesteld, dat in Bakka (Mekka) is: gezegend en leiding voor de werelden.";
"discovery.card.fact_first_house.source" = "Qur’an 3:96";

"discovery.card.fact_qiblah_change.title" = "De qibla werd gedraaid";
"discovery.card.fact_qiblah_change.meaning" = "Allah gebood de Profeet ﷺ zijn gezicht naar de Heilige Moskee te keren. Dat werd de qibla van de moslims.";
"discovery.card.fact_qiblah_change.source" = "Qur’an 2:144";

"discovery.card.fact_arabic_quran.title" = "Een Arabische Koran";
"discovery.card.fact_arabic_quran.meaning" = "De Koran is neergezonden als een Arabische recitatie, zodat de eerste hoorders hem konden begrijpen.";
"discovery.card.fact_arabic_quran.source" = "Qur’an 12:2";

"discovery.card.fact_in_stages.title" = "Neergezonden in etappes";
"discovery.card.fact_in_stages.meaning" = "De Koran is niet in één keer neergezonden. Hij werd in etappes gereciteerd tijdens de zending van de Profeet ﷺ.";
"discovery.card.fact_in_stages.source" = "Qur’an 17:106";

"discovery.card.fact_isra.title" = "De nachtreis";
"discovery.card.fact_isra.meaning" = "Heilig is Hij die Zijn dienaar bij nacht voerde van de Heilige Moskee naar de Verste Moskee, waarvan Wij de omgeving hebben gezegend.";
"discovery.card.fact_isra.source" = "Qur’an 17:1";

"discovery.card.fact_mercy_to_worlds.title" = "Een genade voor de werelden";
"discovery.card.fact_mercy_to_worlds.meaning" = "De Koran zegt dat de Profeet ﷺ alleen is gezonden als een genade voor de werelden.";
"discovery.card.fact_mercy_to_worlds.source" = "Qur’an 21:107";

"discovery.card.fact_uswa_hasana.title" = "Een mooi voorbeeld";
"discovery.card.fact_uswa_hasana.meaning" = "In de Boodschapper van Allah ﷺ hebben jullie een mooi voorbeeld, voor wie hoopt op Allah en de Laatste Dag.";
"discovery.card.fact_uswa_hasana.source" = "Qur’an 33:21";

"discovery.card.fact_great_character.title" = "Een geweldig karakter";
"discovery.card.fact_great_character.meaning" = "Allah zei over de Profeet ﷺ: “En jij bent waarlijk van een geweldig karakter.”";
"discovery.card.fact_great_character.source" = "Qur’an 68:4";

"discovery.card.fact_salawat.title" = "Allah zendt salah over hem";
"discovery.card.fact_salawat.meaning" = "Allah en Zijn engelen zenden salah over de Profeet ﷺ. Gelovigen wordt geboden ook salah en groet over hem te zenden.";
"discovery.card.fact_salawat.source" = "Qur’an 33:56";

"discovery.card.fact_jumuah.title" = "Als de vrijdag wordt omgeroepen";
"discovery.card.fact_jumuah.meaning" = "Als de oproep tot het vrijdaggebed klinkt, laat handel achterwege en haast je naar de gedachtenis van Allah.";
"discovery.card.fact_jumuah.source" = "Qur’an 62:9";

"discovery.card.fact_wudu_ayah.title" = "Hoe wudu in de Koran staat";
"discovery.card.fact_wudu_ayah.meaning" = "De Koran noemt de wudu: wast de gezichten en de armen tot de ellebogen, veegt over de hoofden en wast de voeten tot de enkels.";
"discovery.card.fact_wudu_ayah.source" = "Qur’an 5:6";

"discovery.card.fact_no_compulsion.title" = "Geen dwang in de religie";
"discovery.card.fact_no_compulsion.meaning" = "Er is geen dwang in de religie. Het juiste pad is duidelijk geworden, onderscheiden van dwaling.";
"discovery.card.fact_no_compulsion.source" = "Qur’an 2:256";

"discovery.card.fact_quran_easy_remember.title" = "Makkelijk gemaakt om te onthouden";
"discovery.card.fact_quran_easy_remember.meaning" = "Allah zei: “Voorwaar, Wij hebben de Koran makkelijk gemaakt om te onthouden. Is er dan iemand die zich laat vermanen?” Deze formulering keert terug in soera Al-Qamar.";
"discovery.card.fact_quran_easy_remember.source" = "Qur’an 54:17";

"discovery.card.fact_bismillah_tawbah.title" = "Geen Bismillah voor At-Tawbah";
"discovery.card.fact_bismillah_tawbah.meaning" = "In de Oethmaanse mushaf begint elke soera met de Bismillah, behalve At-Tawbah (soera 9).";
"discovery.card.fact_bismillah_tawbah.source" = "Uthmani mushaf · Qur’an 9";

"discovery.card.fact_fatiha_seven.title" = "Zeven vaak herhaalde";
"discovery.card.fact_fatiha_seven.meaning" = "Al-Fatiha telt zeven verzen. Veel geleerden zien in “de zeven vaak herhaalde” (15:87) deze soera — in elke salah gereciteerd.";
"discovery.card.fact_fatiha_seven.source" = "Qur’an 15:87 · Qur’an 1";

"discovery.card.fact_ikhlas_third.title" = "Ikhlas is een derde van de Koran";
"discovery.card.fact_ikhlas_third.meaning" = "De Profeet ﷺ zei dat “Qul Huwa Allahu Ahad” (Al-Ikhlas) gelijk is aan een derde van de Koran.";
"discovery.card.fact_ikhlas_third.source" = "Sahih al-Bukhari 5015";

"discovery.card.fact_kursi_greatest.title" = "Het grootste vers";
"discovery.card.fact_kursi_greatest.meaning" = "De Profeet ﷺ vroeg Ubayy ibn Ka‘b welk vers in het Boek van Allah het grootst is. Hij antwoordde Ayat al-Kursi, en de Profeet ﷺ bevestigde dat.";
"discovery.card.fact_kursi_greatest.source" = "Sahih Muslim 810";

"discovery.card.fact_muawwidhatayn.title" = "De twee beschermende soera’s";
"discovery.card.fact_muawwidhatayn.meaning" = "Al-Falaq en An-Nas heten de Mu‘awwidhatayn. De Profeet ﷺ gebruikte ze ter bescherming en onderwees ze.";
"discovery.card.fact_muawwidhatayn.source" = "Sahih al-Bukhari 5016";

"discovery.card.fact_iman_six.title" = "Zes zuilen van iman";
"discovery.card.fact_iman_six.meaning" = "Iman is geloven in Allah, Zijn engelen, Zijn boeken, Zijn boodschappers, de Laatste Dag en de goddelijke beschikking — het goede en het zware.";
"discovery.card.fact_iman_six.source" = "Sahih Muslim 8 · Qur’an 4:136";

"discovery.card.fact_revealed_books.title" = "Boeken die de Koran noemt";
"discovery.card.fact_revealed_books.meaning" = "Naast de Koran noemt het Boek de Tawrah, het Indjil en de Zabur — schriften die eerdere boodschappers ontvingen.";
"discovery.card.fact_revealed_books.source" = "Qur’an 3:3 · Qur’an 4:163 · Qur’an 5:46";

"discovery.card.fact_twelve_months.title" = "Twaalf maanden bij Allah";
"discovery.card.fact_twelve_months.meaning" = "Het aantal maanden bij Allah is twaalf, in het Boek van Allah, sinds Hij de hemelen en de aarde schiep — waarvan vier heilig.";
"discovery.card.fact_twelve_months.source" = "Qur’an 9:36";

"discovery.card.fact_maqam_ibrahim.title" = "De standplaats van Ibrahim";
"discovery.card.fact_maqam_ibrahim.meaning" = "Neem de standplaats van Ibrahim tot gebedsplaats. De Koran verbindt die met het Huis dat Ibrahim en Ismail moesten reinigen.";
"discovery.card.fact_maqam_ibrahim.source" = "Qur’an 2:125";

"discovery.card.fact_named_prophets.title" = "25 profeten bij naam";
"discovery.card.fact_named_prophets.meaning" = "De Koran noemt vijfentwintig profeten, van Adam tot Mohammed ﷺ. Andere boodschappers worden genoemd zonder naam.";
"discovery.card.fact_named_prophets.source" = "Qur’an · 25 named prophets";

"discovery.card.fact_ninety_nine_names.title" = "Negenennegentig namen";
"discovery.card.fact_ninety_nine_names.meaning" = "De Profeet ﷺ zei dat Allah negenennegentig namen heeft, honderd min één; wie ze opsomt, gaat het paradijs binnen.";
"discovery.card.fact_ninety_nine_names.source" = "Sahih al-Bukhari 2736 · Sahih Muslim 2677";

"discovery.card.fact_seven_mathani.title" = "Zeven vaak herhaalde";
"discovery.card.fact_seven_mathani.meaning" = "Allah zegt dat Hij de Profeet ﷺ zeven van de vaak herhaalde gaf, en de Grote Koran. Veel geleerden nemen dit als Al-Fatiha.";
"discovery.card.fact_seven_mathani.source" = "Qur’an 15:87";

"discovery.card.fact_safa_marwa.title" = "Safa en Marwa";
"discovery.card.fact_safa_marwa.meaning" = "Safa en Marwa behoren tot de riten van Allah. Wie hadj of oemra naar het Huis verricht, daar is geen blaam in het lopen tussen beide.";
"discovery.card.fact_safa_marwa.source" = "Qur’an 2:158";

"discovery.card.fact_four_sacred_named.title" = "Vier heilige maanden";
"discovery.card.fact_four_sacred_named.meaning" = "Van de twaalf maanden zijn er vier heilig: Dhoel-Qa’da, Dhoel-Hidjdja, Muharram en Radjab — die tussen Djoemada en Sja’ban valt.";
"discovery.card.fact_four_sacred_named.source" = "Qur’an 9:36 · Sahih al-Bukhari 3197";

"discovery.card.fact_three_mosques.title" = "Drie moskeeën voor een reis";
"discovery.card.fact_three_mosques.meaning" = "De Profeet ﷺ zei: onderneem geen reis naar een moskee behalve drie: de Heilige Moskee, deze moskee van mij, en Al-Aqsa.";
"discovery.card.fact_three_mosques.source" = "Sahih al-Bukhari 1189 · Sahih Muslim 1397";

"discovery.card.fact_last_two_baqarah.title" = "De laatste twee verzen van Al-Baqarah";
"discovery.card.fact_last_two_baqarah.meaning" = "De Profeet ﷺ zei dat wie de laatste twee verzen van Al-Baqarah ’s nachts reciteert, die hem zullen volstaan.";
"discovery.card.fact_last_two_baqarah.source" = "Sahih al-Bukhari 5009 · Sahih Muslim 808";

"discovery.card.fact_best_days_dhulhijjah.title" = "De beste dagen van het jaar";
"discovery.card.fact_best_days_dhulhijjah.meaning" = "De Profeet ﷺ zei dat er geen dagen zijn waarop rechtvaardige daden Allah meer bemind zijn dan deze tien — de eerste tien van Dhoel-Hidjdja.";
"discovery.card.fact_best_days_dhulhijjah.source" = "Sahih al-Bukhari 969";

"discovery.card.fact_ayah_total.title" = "6236 verzen";
"discovery.card.fact_ayah_total.meaning" = "De gebruikelijke Oethmaanse Hafs-mushaf telt 6236 verzen, verdeeld over 114 soera’s.";
"discovery.card.fact_ayah_total.source" = "Uthmani Hafs mushaf count";

"discovery.card.fact_bismillah_openings.title" = "113 soera’s beginnen met Bismillah";
"discovery.card.fact_bismillah_openings.meaning" = "113 soera’s openen met Bismillah. At-Tawbah niet. Een extra Bismillah staat in de brief van Soelayman (27:30).";
"discovery.card.fact_bismillah_openings.source" = "Uthmani mushaf · Qur’an 27:30";

"discovery.card.fact_word_allah.title" = "Allah staat 2265 keer geschreven";
"discovery.card.fact_word_allah.meaning" = "In de Oethmaanse Hafs-tekst komt de naam Allah (الله) 2265 keer voor als geschreven woord — zonder Allahumma.";
"discovery.card.fact_word_allah.source" = "Uthmani Hafs mushaf count";

"discovery.card.fact_word_rahman.title" = "Ar-Rahman 157 keer";
"discovery.card.fact_word_rahman.meaning" = "In de Oethmaanse Hafs-tekst komt het woord Ar-Rahman (الرحمن) 157 keer geschreven voor.";
"discovery.card.fact_word_rahman.source" = "Uthmani Hafs mushaf count";

"discovery.card.fact_word_rahim.title" = "Ar-Rahiem 146 keer";
"discovery.card.fact_word_rahim.meaning" = "In de Oethmaanse Hafs-tekst komt het woord Ar-Rahiem (الرحيم) 146 keer geschreven voor.";
"discovery.card.fact_word_rahim.source" = "Uthmani Hafs mushaf count";

"discovery.card.fact_word_muhammad.title" = "Mohammed wordt 4 keer genoemd";
"discovery.card.fact_word_muhammad.meaning" = "De naam Mohammed ﷺ staat 4 keer in de Koran. In 61:6 wordt hij ook Ahmad genoemd.";
"discovery.card.fact_word_muhammad.source" = "Uthmani Hafs mushaf count · Qur’an 3:144 · 33:40 · 47:2 · 48:29";

"discovery.card.fact_word_jannah.title" = "Al-djannah 56 keer";
"discovery.card.fact_word_jannah.meaning" = "In de Oethmaanse Hafs-tekst komt het woord al-djannah (الجنة, de Tuin) 56 keer geschreven voor.";
"discovery.card.fact_word_jannah.source" = "Uthmani Hafs mushaf count";

"discovery.card.fact_word_nar.title" = "An-naar 102 keer";
"discovery.card.fact_word_nar.meaning" = "In de Oethmaanse Hafs-tekst komt het woord an-naar (النار, het Vuur) 102 keer geschreven voor.";
"discovery.card.fact_word_nar.source" = "Uthmani Hafs mushaf count";

"discovery.card.fact_rahman_refrain.title" = "Welke gunsten — 31 keer";
"discovery.card.fact_rahman_refrain.meaning" = "Het vers “Welke van de gunsten van jullie Heer loochenen jullie beiden dan?” staat 31 keer in soera Ar-Rahman.";
"discovery.card.fact_rahman_refrain.source" = "Qur’an 55";

"discovery.card.fact_mursalat_refrain.title" = "Wee die Dag — 10 keer";
