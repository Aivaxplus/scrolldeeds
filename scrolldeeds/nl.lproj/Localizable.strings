"knowledge.card.smile_sadaqah.title" = "Een glimlach is sadaqah";
"knowledge.card.smile_sadaqah.arabic" = "تَبَسُّمُكَ فِي وَجْهِ أَخِيكَ صَدَقَةٌ";
"knowledge.card.smile_sadaqah.body" = "De Profeet ﷺ zei dat jouw glimlach naar je broeder sadaqah is. Een klein gezicht, een echte daad.";
"knowledge.card.smile_sadaqah.source" = "Jami' at-Tirmidhi 1956";

"knowledge.card.bismillah_food.title" = "Begin met Bismillah";
"knowledge.card.bismillah_food.arabic" = "بِسْمِ اللَّهِ";
"knowledge.card.bismillah_food.body" = "Begin met eten en drinken in Allahs naam. Vergeet je het, zeg dan Bismillah aan het begin en het einde.";
"knowledge.card.bismillah_food.source" = "Sunan Abi Dawud 3767";

"knowledge.card.right_hand.title" = "Eet met je rechterhand";
"knowledge.card.right_hand.arabic" = "";
"knowledge.card.right_hand.body" = "De Profeet ﷺ leerde ons met de rechterhand te eten en te drinken. Een stille soennah bij elke maaltijd.";
"knowledge.card.right_hand.source" = "Sahih Muslim 2020";

"knowledge.card.remove_harm.title" = "Haal iets schadelijks van de weg";
"knowledge.card.remove_harm.arabic" = "";
"knowledge.card.remove_harm.body" = "Iets schadelijks van de weg halen is een tak van het geloof. Iman heeft daden die je al lopend kunt doen.";
"knowledge.card.remove_harm.source" = "Sahih Muslim 35";

"knowledge.card.greet_salam.title" = "Verspreid de salam";
"knowledge.card.greet_salam.arabic" = "السَّلَامُ عَلَيْكُمْ";
"knowledge.card.greet_salam.body" = "Begroet wie je kent en wie je niet kent. De salam verspreiden hoort bij de islam.";
"knowledge.card.greet_salam.source" = "Sahih al-Bukhari 28 · Sahih Muslim 39";

"knowledge.card.miswak.title" = "De siwak";
"knowledge.card.miswak.arabic" = "";
"knowledge.card.miswak.body" = "De siwak reinigt de mond en behaagt de Heer. Een klein stokje, een geliefde soennah.";
"knowledge.card.miswak.source" = "Sahih al-Bukhari 1934";

"knowledge.card.anger_sit.title" = "Als woede opkomt, ga zitten";
"knowledge.card.anger_sit.arabic" = "";
"knowledge.card.anger_sit.body" = "Sta je, ga zitten. Zit je, ga liggen. Woede komt van shaytan — verander je houding voordat hij jou verandert.";
"knowledge.card.anger_sit.source" = "Sunan Abi Dawud 4782";

"knowledge.card.even_date.title" = "Zelfs een halve dadel";
"knowledge.card.even_date.arabic" = "";
"knowledge.card.even_date.body" = "Bescherm jezelf tegen het Vuur, al is het met een halve dadel aan sadaqah. Geen gift is te klein als hij oprecht is.";
"knowledge.card.even_date.source" = "Sahih al-Bukhari 1417";

"knowledge.card.ayatul_kursi.title" = "Ayat al-Kursi";
"knowledge.card.ayatul_kursi.arabic" = "اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ";
"knowledge.card.ayatul_kursi.body" = "Reciteer hem na elke salah en voor het slapen. Een vers van bescherming, een nacht onder Allahs zorg.";
"knowledge.card.ayatul_kursi.source" = "Koran 2:255 · Sahih al-Bukhari 2311";

"knowledge.card.ikhlas.title" = "Soera al-Ikhlas";
"knowledge.card.ikhlas.arabic" = "قُلْ هُوَ اللَّهُ أَحَدٌ";
"knowledge.card.ikhlas.body" = "Gelijk aan een derde van de Koran in beloning. Een paar regels op de tong, een groot gewicht bij Allah.";
"knowledge.card.ikhlas.source" = "Sahih al-Bukhari 5013";

"knowledge.card.wudu_sleep.title" = "Slaap met wudu";
"knowledge.card.wudu_sleep.arabic" = "";
"knowledge.card.wudu_sleep.body" = "De Profeet ﷺ raadde aan om met wudu te gaan slapen. Sluit de dag zoals je hem begon: rein voor Allah.";
"knowledge.card.wudu_sleep.source" = "Sahih al-Bukhari 247";

"knowledge.card.visit_sick.title" = "Bezoek de zieke";
"knowledge.card.visit_sick.arabic" = "";
"knowledge.card.visit_sick.body" = "De zieke bezoeken is een recht van de moslim op de moslim. Aanwezigheid is een daad, niet alleen woorden.";
"knowledge.card.visit_sick.source" = "Sahih Muslim 2162";

