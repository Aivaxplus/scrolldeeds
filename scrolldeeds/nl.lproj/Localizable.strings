// MARK: - Dua volledige vertalingen
"dua.ayat_al_kursi.translation" = "Allah — er is geen god dan Hij, de Eeuwig Levende, de Zelfstandige. Sluimering noch slaap overmant Hem. Aan Hem behoort alles wat in de hemelen en op de aarde is. Wie kan bij Hem voorspreken zonder Zijn toestemming? Hij weet wat voor hen ligt en wat achter hen is, en zij omvatten niets van Zijn kennis behalve wat Hij wil. Zijn Kursie omvat de hemelen en de aarde, en hun bewaring vermoeit Hem niet. En Hij is de Verhevene, de Geweldige. (Koran 2:255)";
"dua.istighfar.translation" = "O Allah, U bent mijn Heer. Er is geen god dan U. U schiep mij en ik ben Uw dienaar. Ik leef naar mijn verbond en belofte aan U zo goed als ik kan. Ik zoek toevlucht bij U tegen het kwaad van wat ik heb gedaan. Ik erken Uw gunst jegens mij en ik beken mijn zonden. Vergeef mij dan, want niemand vergeeft zonden behalve U. (Sayyid al-Istighfar)";
"dua.dua_parents.translation" = "Mijn Heer, ontferm U over hen beiden, zoals zij mij opvoedden toen ik klein was. (Koran 17:24)";
"dua.dua_ummah.translation" = "O Allah, verbeter de Ummah van Mohammed. O Allah, verlicht het lijden van de Ummah van Mohammed. O Allah, heb genade met de Ummah van Mohammed.";
"dua.dua_loved_one.translation" = "O Allah, zegen hem/haar in wat U hem/haar heeft gegeven. Vergeef hem/haar, heb genade met hem/haar, schenk hem/haar gezondheid en vergeef hem/haar.";
"dua.verse_reflection.translation" = "Waarlijk, in de schepping van de hemelen en de aarde en in de afwisseling van nacht en dag zijn tekenen voor mensen met verstand. (Koran 3:190)";
"dua.dua_knowledge.translation" = "Mijn Heer, vermeerder mij in kennis. (Koran 20:114)";
"dua.dua_relief.translation" = "O Allah, ik zoek mijn toevlucht bij U tegen zorgen en verdriet.";
"dua.dua_morning.translation" = "Wij zijn de ochtend ingegaan en het koninkrijk behoort aan Allah, en alle lof is voor Allah.";
"dua.dua_evening.translation" = "Wij zijn de avond ingegaan en het koninkrijk behoort aan Allah, en alle lof is voor Allah.";
"dua.dua_dunya.translation" = "Onze Heer, geef ons het goede in deze wereld en het goede in het Hiernamaals, en behoed ons voor de bestraffing van het Vuur. (Koran 2:201)";
"dua.dua_heart.translation" = "Onze Heer, laat onze harten niet afwijken nadat U ons heeft geleid, en schenk ons van Uzelf barmhartigheid. Voorwaar, U bent de Schenker. (Koran 3:8)";
"dua.dua_hasbi.translation" = "Allah is mij genoeg. Er is geen god dan Hij. Op Hem vertrouw ik, en Hij is de Heer van de Geweldige Troon. (Koran 9:129)";
"dua.dua_jannah.translation" = "O Allah, ik vraag U om het Paradijs en ik zoek mijn toevlucht bij U tegen het Vuur.";

// MARK: - Surah full translations (for recitation tasks)
"surah.ikhlas.translation" = "In de naam van Allah, de Erbarmer, de Meest Barmhartige.\nZeg: \"Hij is Allah, de Ene. Allah, de Zelfstandige. Hij heeft niet verwekt en is niet verwekt. En niemand is aan Hem gelijk.\"";
"surah.falaq.translation" = "In de naam van Allah, de Erbarmer, de Meest Barmhartige.\nZeg: \"Ik zoek mijn toevlucht bij de Heer van de dageraad, tegen het kwaad van wat Hij heeft geschapen, en tegen het kwaad van de duisternis wanneer die invalt, en tegen het kwaad van de blazers in de knopen, en tegen het kwaad van de afgunstige wanneer hij afgunst koestert.\"";
"surah.nas.translation" = "In de naam van Allah, de Erbarmer, de Meest Barmhartige.\nZeg: \"Ik zoek mijn toevlucht bij de Heer van de mensen, de Koning van de mensen, de God van de mensen, tegen het kwaad van de fluisteraar die zich terugtrekt, die in de harten van de mensen fluistert, onder de djinn en de mensen.\"";
"surah.fatiha.translation" = "In de naam van Allah, de Erbarmer, de Meest Barmhartige. Alle lof behoort aan Allah, Heer der werelden, de Erbarmer, de Meest Barmhartige, Heerser van de Dag des Oordeels. U alleen aanbidden wij en U alleen vragen wij om hulp. Leid ons op het rechte pad — het pad van hen aan wie U gunst hebt geschonken, niet van hen op wie toorn is nedergedaald noch van de dwalenden.";
"surah.kafirun.translation" = "In de naam van Allah, de Erbarmer, de Meest Barmhartige. Zeg: O ongelovigen, ik aanbid niet wat jullie aanbidden. Noch zijn jullie aanbidders van wat ik aanbid. Noch zal ik een aanbidder zijn van wat jullie aanbidden. Noch zullen jullie aanbidders zijn van wat ik aanbid. Voor jullie is jullie godsdienst en voor mij is mijn godsdienst.";
"surah.kawthar.translation" = "In de naam van Allah, de Erbarmer, de Meest Barmhartige.
Voorwaar, Wij hebben jou Al-Kawthar gegeven. Bid daarom tot je Heer en offer. Voorwaar, jouw hater is degene die afgesneden is.";
"surah.asr.translation" = "In de naam van Allah, de Erbarmer, de Meest Barmhartige.
Bij de tijd. Voorwaar, de mens is in verlies, behalve zij die geloven, goede daden verrichten, elkaar de waarheid aanbevelen en elkaar geduld aanbevelen.";

