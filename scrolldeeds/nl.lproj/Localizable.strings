"notification.spiritual.quran1.title" = "Gedenk Mij, dan gedenk Ik jullie";
"notification.spiritual.quran1.body" = "“Gedenk Mij, dan gedenk Ik jullie.” — Quran 2:152";
"notification.spiritual.sunnah1.title" = "De meest geliefde daden";
"notification.spiritual.sunnah1.body" = "“De meest geliefde daden bij Allah zijn de meest consistente, ook als ze klein zijn.” — Sahih al-Bukhari 6465; Sahih Muslim 783";
"notification.spiritual.reminder1.title" = "Allah ziet je";
"notification.spiritual.reminder1.body" = "Wat je nu doet, komt terug op de Dag des Oordeels. Kies wat je Hem wilt tonen.";
"notification.spiritual.quran2.title" = "Met de moeilijkheid komt verlichting";
"notification.spiritual.quran2.body" = "“Voorzeker, met de moeilijkheid komt verlichting.” — Quran 94:6";
"notification.spiritual.sunnah2.title" = "Spreek goed, of zwijg";
"notification.spiritual.sunnah2.body" = "“Wie in Allah en de Laatste Dag gelooft, laat hem goed spreken of zwijgen.” — Sahih al-Bukhari 6018; Sahih Muslim 47";
"notification.spiritual.reminder2.title" = "De akhirah wacht";
"notification.spiritual.reminder2.body" = "Deze minuut telt. Een dhikr is lichter om te dragen dan een uur scrollen.";
"notification.spiritual.quran3.title" = "Herinner, als het baat";
"notification.spiritual.quran3.body" = "“Herinner dus, als de herinnering tot nut is.” — Quran 87:9";
"notification.spiritual.sunnah3.title" = "Daden zijn naar intenties";
"notification.spiritual.sunnah3.body" = "“Daden zijn naar intenties, en ieder krijgt wat hij bedoeld heeft.” — Sahih al-Bukhari 1; Sahih Muslim 1907";
"notification.spiritual.reminder3.title" = "Waar sta je straks?";
"notification.spiritual.reminder3.body" = "Wees in deze wereld als een reiziger. De feed is niet je thuis.";
"notification.spiritual.quran4.title" = "Allah is met de geduldigen";
"notification.spiritual.quran4.body" = "“O jullie die geloven, zoek hulp door geduld en gebed. Allah is met de geduldigen.” — Quran 2:153";
"notification.spiritual.sunnah4.title" = "De sterke";
"notification.spiritual.sunnah4.body" = "“De sterke is niet wie anderen neerwerpt, maar wie zichzelf beheerst in woede.” — Sahih al-Bukhari 6114; Sahih Muslim 2609";
"notification.spiritual.reminder4.title" = "Eén adem is een kans";
"notification.spiritual.reminder4.body" = "Allah gaf je nog een adem. Gebruik hem voor istighfar, niet voor de volgende video.";
"notification.spiritual.quran5.title" = "Harten vinden rust";
"notification.spiritual.quran5.body" = "“Weet: in het gedenken van Allah vinden de harten rust.” — Quran 13:28";
"notification.spiritual.sunnah5.title" = "Maak het makkelijk";
"notification.spiritual.sunnah5.body" = "“Maak het makkelijk en maak het niet moeilijk; breng goed nieuws en stoot niet af.” — Sahih al-Bukhari 69; Sahih Muslim 1734";
"notification.spiritual.reminder5.title" = "Het graf vraagt";
"notification.spiritual.reminder5.body" = "Wat neem je mee: een reeks clips, of een woord dat Allah liefheeft?";
"notification.spiritual.quran6.title" = "Onderhoud het gebed";
"notification.spiritual.quran6.body" = "“En onderhoud het gebed en geef de zakat en buig met wie buigen.” — Quran 2:43";
"notification.spiritual.sunnah6.title" = "Leer de Quran en onderwijzen";
"notification.spiritual.sunnah6.body" = "“De besten van jullie zijn wie de Quran leren en onderwijzen.” — Sahih al-Bukhari 5027";
"notification.spiritual.reminder6.title" = "Hij is dichtbij";
"notification.spiritual.reminder6.body" = "Als Mijn dienaren jou over Mij vragen: Ik ben nabij. Roep Hem aan, nu.";
"notification.spiritual.quran7.title" = "Je Heer heeft je niet verlaten";
"notification.spiritual.quran7.body" = "“Je Heer heeft je niet verlaten en Hij is je niet gaan haten.” — Quran 93:3";
"notification.spiritual.sunnah7.title" = "Reinheid is de helft van het geloof";
"notification.spiritual.sunnah7.body" = "“Reinheid is de helft van het geloof.” — Sahih Muslim 223";
"notification.spiritual.reminder7.title" = "De weegschaal";
"notification.spiritual.reminder7.body" = "Eén Subhanallah kan zwaarder wegen dan alles wat je vandaag hebt gescrold.";
"notification.spiritual.quran8.title" = "Hij vond je verdwaald en leidde je";
"notification.spiritual.quran8.body" = "“En Hij vond je verdwaald en leidde je.” — Quran 93:7";
"notification.spiritual.sunnah8.title" = "Wees in deze wereld als een reiziger";
"notification.spiritual.sunnah8.body" = "“Wees in deze wereld alsof je een vreemdeling bent of een reiziger.” — Sahih al-Bukhari 6416";
"notification.spiritual.reminder8.title" = "Vergeet de terugkeer niet";
"notification.spiritual.reminder8.body" = "Elke ziel proeft de dood. Leef dit uur alsof je het moet verantwoorden.";
"notification.spiritual.quran9.title" = "Vergeet je aandeel niet";
"notification.spiritual.quran9.body" = "“En vergeet je aandeel van de wereld niet. En doe goed zoals Allah jou goed heeft gedaan.” — Quran 28:77";
"notification.spiritual.sunnah9.title" = "Houd van voor je broeder";
"notification.spiritual.sunnah9.body" = "“Geen van jullie gelooft werkelijk tot hij voor zijn broeder graag heeft wat hij voor zichzelf graag heeft.” — Sahih al-Bukhari 13; Sahih Muslim 45";
"notification.spiritual.reminder9.title" = "Allah is genoeg";
"notification.spiritual.reminder9.body" = "Wat je zoekt in de feed, vult niet wat alleen Allah vult.";
"notification.spiritual.quran10.title" = "Gedenk Hem staand en zittend";
"notification.spiritual.quran10.body" = "“Zij die Allah gedenken staand, zittend of op hun zij.” — Quran 3:191";
"notification.spiritual.sunnah10.title" = "Veilig voor tong en hand";
"notification.spiritual.sunnah10.body" = "“Een moslim is wie van wiens tong en hand de moslims veilig zijn.” — Sahih al-Bukhari 10; Sahih Muslim 40";
"notification.spiritual.reminder10.title" = "Een woord voor Hem";
"notification.spiritual.reminder10.body" = "Zeg Astaghfirullah. Het wist. Scrollen voegt alleen toe wat je niet wilt dragen.";
"notification.spiritual.quran11.title" = "Het gebed weerhoudt van het schandelijke";
"notification.spiritual.quran11.body" = "“Voorzeker, het gebed weerhoudt van het schandelijke en het verwerpelijke, en het gedenken van Allah is groter.” — Quran 29:45";
"notification.spiritual.sunnah11.title" = "Twee woorden, zwaar op de weegschaal";
"notification.spiritual.sunnah11.body" = "“Twee woorden zijn licht op de tong, zwaar op de weegschaal, en geliefd bij de Barmhartige: Subhanallahi wa bihamdihi, Subhanallahil-Azeem.” — Sahih al-Bukhari 6406; Sahih Muslim 2694";
"notification.spiritual.reminder11.title" = "De Dag komt";
"notification.spiritual.reminder11.body" = "Niemand wordt onrecht aangedaan. Wat nu klein lijkt, staat straks op je blad.";
"notification.spiritual.quran12.title" = "Is de tijd niet gekomen?";
"notification.spiritual.quran12.body" = "“Is de tijd niet gekomen voor wie geloven dat hun harten nederig worden voor het gedenken van Allah?” — Quran 57:16";
"notification.spiritual.sunnah12.title" = "Word niet boos";
"notification.spiritual.sunnah12.body" = "Iemand zei: “Geef mij advies.” Hij ﷺ zei: “Word niet boos.” Hij herhaalde het, en hij ﷺ bleef zeggen: “Word niet boos.” — Sahih al-Bukhari 6116";
"notification.spiritual.reminder12.title" = "Richt je hart";
"notification.spiritual.reminder12.body" = "In het gedenken van Allah vinden de harten rust.";
"notification.spiritual.quran13.title" = "Zoek hulp door geduld";
"notification.spiritual.quran13.body" = "“En zoek hulp door geduld en gebed. En het is zwaar, behalve voor de nederigen.” — Quran 2:45";
"notification.spiritual.sunnah13.title" = "Geen barmhartigheid zonder barmhartigheid";
"notification.spiritual.sunnah13.body" = "“Allah is niet barmhartig voor wie niet barmhartig is voor de mensen.” — Sahih al-Bukhari 5997; Sahih Muslim 2319";
"notification.spiritual.reminder13.title" = "Voor je Heer";
"notification.spiritual.reminder13.body" = "Salah, dhikr, een ayah. Dat blijft. De tijdlijn verdwijnt.";
"notification.spiritual.quran14.title" = "Ik ben nabij";
"notification.spiritual.quran14.body" = "“En wanneer Mijn dienaren je over Mij vragen: Ik ben nabij. Ik verhoor de smeekbede van de bidder wanneer hij Mij aanroept.” — Quran 2:186";
"notification.spiritual.sunnah14.title" = "Elke goede daad is sadaqah";
"notification.spiritual.sunnah14.body" = "“Elke goede daad is sadaqah.” — Sahih al-Bukhari 6022; Sahih Muslim 1005";
"notification.spiritual.reminder14.title" = "Twee minuten met Allah";
"notification.spiritual.reminder14.body" = "Leg de telefoon weg. Zeg Subhanallah, Alhamdulillah, Allahu akbar.";
"notification.spiritual.quran15.title" = "Geen ziel wordt overbelast";
"notification.spiritual.quran15.body" = "“Allah belast geen ziel behalve naar haar vermogen.” — Quran 2:286";
"notification.spiritual.sunnah15.title" = "Haal schade van de weg";
"notification.spiritual.sunnah15.body" = "“Iets schadelijks van de weg halen is sadaqah.” — Sahih al-Bukhari 2989; Sahih Muslim 1009";
"notification.spiritual.reminder15.title" = "Wie hoop je te ontmoeten?";
"notification.spiritual.reminder15.body" = "De ontmoeting met Allah is echt. Bereid vandaag één goede daad voor.";
"notification.spiritual.quran16.title" = "Verzwak niet en treur niet";
"notification.spiritual.quran16.body" = "“Verzwak dus niet en treur niet, jullie zullen de bovenhand hebben als jullie gelovigen zijn.” — Quran 3:139";
"notification.spiritual.sunnah16.title" = "Haya hoort bij het geloof";
"notification.spiritual.sunnah16.body" = "“Haya (kuisheid/schaamte) is een tak van het geloof.” — Sahih al-Bukhari 24; Sahih Muslim 36";
"notification.spiritual.reminder16.title" = "De wereld is kort";
"notification.spiritual.reminder16.body" = "Wat je nu uitstelt voor Allah, voelt straks langer dan deze hele feed.";
"notification.spiritual.quran17.title" = "Wees geduldig en houd stand";
"notification.spiritual.quran17.body" = "“O jullie die geloven, wees geduldig, volhard, houd stand en vrees Allah, opdat jullie slagen.” — Quran 3:200";
"notification.spiritual.sunnah17.title" = "De religie is oprechte raad";
"notification.spiritual.sunnah17.body" = "“De religie is naseehah.” Wij zeiden: “Aan wie?” Hij zei: “Aan Allah, Zijn Boek, Zijn Boodschapper, de leiders van de moslims en hun gewone volk.” — Sahih Muslim 55";
"notification.spiritual.reminder17.title" = "Vraag vergeving";
"notification.spiritual.reminder17.body" = "Allah houdt ervan dat je terugkeert. Eén oprechte tawba weegt zwaarder dan perfect scrollen.";
"notification.spiritual.quran18.title" = "Gebed op vaste tijden";
"notification.spiritual.quran18.body" = "“Voorzeker, het gebed is de gelovigen voorgeschreven op vastgestelde tijden.” — Quran 4:103";
"notification.spiritual.sunnah18.title" = "Eer je gast";
"notification.spiritual.sunnah18.body" = "“Wie in Allah en de Laatste Dag gelooft, laat hem zijn gast eren.” — Sahih al-Bukhari 6018; Sahih Muslim 47";
"notification.spiritual.reminder18.title" = "Jouw rekening";
"notification.spiritual.reminder18.body" = "De engelen schrijven mee. Laat dit moment een hasanah zijn, geen ghaflah.";
"notification.spiritual.quran19.title" = "Gedenk je Heer in jezelf";
"notification.spiritual.quran19.body" = "“En gedenk je Heer in jezelf, in nederigheid en vrees, niet luid, in de ochtenden en de avonden.” — Quran 7:205";
"notification.spiritual.sunnah19.title" = "Gelovigen steunen elkaar";
"notification.spiritual.sunnah19.body" = "“De gelovige is voor de gelovige als een gebouw: elk deel steunt het andere.” — Sahih al-Bukhari 481; Sahih Muslim 2585";
"notification.spiritual.reminder19.title" = "Het hiernamaals is dichter";
"notification.spiritual.reminder19.body" = "Je weet niet welke adem de laatste is. Gedenk Allah voordat je verder scrolt.";
"notification.spiritual.quran20.title" = "Allah verandert een volk niet";
"notification.spiritual.quran20.body" = "“Allah verandert de toestand van een volk niet totdat zij veranderen wat in henzelf is.” — Quran 13:11";
"notification.spiritual.sunnah20.title" = "Houd van de Boodschapper ﷺ";
"notification.spiritual.sunnah20.body" = "“Geen van jullie gelooft werkelijk tot ik hem dierbaarder ben dan zijn vader, zijn kind en alle mensen.” — Sahih al-Bukhari 15; Sahih Muslim 44";
"notification.spiritual.reminder20.title" = "Een ayah om vast te houden";
"notification.spiritual.reminder20.body" = "Wie Allah vreest, voor hem maakt Hij een uitweg.";
"notification.spiritual.quran21.title" = "Een goed leven voor wie het goede doet";
"notification.spiritual.quran21.body" = "“Wie het goede doet, man of vrouw, terwijl hij gelovig is — Wij zullen hem een goed leven geven.” — Quran 16:97";
"notification.spiritual.sunnah21.title" = "Allah kijkt naar de harten";
"notification.spiritual.sunnah21.body" = "“Allah kijkt niet naar jullie uiterlijk of rijkdom, maar naar jullie harten en daden.” — Sahih Muslim 2564";
"notification.spiritual.reminder21.title" = "Na de dood";
"notification.spiritual.reminder21.body" = "Drie dingen blijven: blijvende liefdadigheid, nuttige kennis, en een kind dat du'a voor je doet. De rest blijft hier.";
"notification.spiritual.quran22.title" = "Roep Mij aan";
"notification.spiritual.quran22.body" = "“En jullie Heer zegt: Roep Mij aan; Ik zal jullie verhoren.” — Quran 40:60";
"notification.spiritual.sunnah22.title" = "De bovenste hand";
"notification.spiritual.sunnah22.body" = "“De bovenste hand is beter dan de onderste. De bovenste geeft, de onderste neemt.” — Sahih al-Bukhari 1429; Sahih Muslim 1033";
"notification.spiritual.reminder22.title" = "Keer terug naar Allah";
"notification.spiritual.reminder22.body" = "Als jij Hem vergeet, laat Hij je daarmee. Kom terug met één La ilaha illallah.";
"notification.spiritual.quran23.title" = "Wanhopig niet van Zijn barmhartigheid";
"notification.spiritual.quran23.body" = "“Zeg: O Mijn dienaren die zichzelf tekortdeden, wanhopig niet van de barmhartigheid van Allah. Allah vergeeft alle zonden.” — Quran 39:53";
"notification.spiritual.sunnah23.title" = "Tevreden met Allah als Heer";
"notification.spiritual.sunnah23.body" = "“Wie tevreden is met Allah als Heer, de islam als religie en Mohammed ﷺ als boodschapper, heeft de smaak van het geloof geproefd.” — Sahih Muslim 34";
"notification.spiritual.reminder23.title" = "Het laatste deel van de nacht";
"notification.spiritual.reminder23.body" = "Dat uur is een ontmoeting met Allah. Bescherm het tegen de late feed.";
"notification.spiritual.quran24.title" = "Laat iedere ziel kijken naar morgen";
"notification.spiritual.quran24.body" = "“O jullie die geloven, vrees Allah. En laat iedere ziel kijken naar wat zij voor morgen heeft voorbereid.” — Quran 59:18";
"notification.spiritual.sunnah24.title" = "Bewaak de vijf pijlers";
"notification.spiritual.sunnah24.body" = "De islam is gebouwd op vijf: de getuigenis, het gebed, de zakat, de hadj en het vasten in Ramadan. — Sahih al-Bukhari 8; Sahih Muslim 16";
"notification.spiritual.reminder24.title" = "Sta even stil";
"notification.spiritual.reminder24.body" = "Als je nu zou sterven, ben je dan tevreden met waar je hart was?";
