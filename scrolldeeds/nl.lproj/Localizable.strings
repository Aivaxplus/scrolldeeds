"conv_paywall.close.subtitle" = "Insha’Allah als je je commitment volhoudt, voelt je leven getransformeerd tegen";
"conv_paywall.faq.header" = "Meest gestelde vragen";
"conv_paywall.faq.q1" = "Werkt dit echt?";
"conv_paywall.faq.a1" = "Ja. Echte iOS-vergrendeling dwingt de pauze af. Een goede daad levert munten op, en een hart opent je apps. Die lus verandert de gewoonte, insha’Allah.";
"conv_paywall.faq.q2" = "Waarom is Nafsi gemaakt?";
"conv_paywall.faq.a2" = "Omdat doomscrollen aanbidding, focus en rust steelt. Wij bouwden één gericht systeem: vergrendel apps tot je een goede daad doet.";
"conv_paywall.faq.q3" = "Blijft de app verbeteren?";
"conv_paywall.faq.a3" = "Ja. We updaten regelmatig en blijven gefocust op blijvende gewoontes voor moslims.";
"conv_paywall.faq.q4" = "Wie heeft Nafsi gemaakt?";
"conv_paywall.faq.a4" = "Assalamu alaikum — ik ben Sabri, de founder. Ik bouwde Nafsi eerst voor mezelf, daarna voor elke moslim in dezelfde strijd.";
"conv_paywall.faq.q5" = "Hoe is Nafsi anders?";
"conv_paywall.faq.a5" = "We tracken niet alleen schermtijd. We zetten afleiding om in daden — met echte iOS app-shielding en spirituele ontgrendelingen.";
"conv_paywall.sticky_cta" = "Bismillah, Zet de Stap";
"conv_paywall.team.header" = "Vergrendel de telefoon. Sta op voor Fajr. Beheers je nafs.";
"conv_paywall.team.body" = "Nafsi vergrendelt je apps tot een goede daad, en wekt je voor Fajr tot je het voorwerp fotografeert dat jij koos. Zo neem je controle over je nafs — niet later, nu.\n\nLock. Daad. Fajr. Updates die het systeem eerlijk houden.";
"conv_paywall.team.body_named" = "%@, Nafsi vergrendelt je apps tot een goede daad, en wekt je voor Fajr tot je het voorwerp fotografeert dat jij koos. Zo neem je controle over je nafs — niet later, nu.\n\nLock. Daad. Fajr. Updates die het systeem eerlijk houden.";
