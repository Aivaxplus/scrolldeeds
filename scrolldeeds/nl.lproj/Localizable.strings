/* Discovery feed expansion */
"discovery.card.shukr.title" = "Als jullie dankbaar zijn, vermeerder Ik jullie";
"discovery.card.shukr.meaning" = "Allah zegt: “Als jullie dankbaar zijn, zal Ik jullie zeker vermeerderen; maar als jullie ontkennen, is Mijn straf streng.”";
"discovery.card.shukr.source" = "Koran 14:7";

"discovery.card.dua_near.title" = "Ik ben nabij";
"discovery.card.dua_near.meaning" = "Allah zegt: “Als Mijn dienaren jou over Mij vragen: voorwaar, Ik ben nabij. Ik verhoor de smeekbede van de smekeling als hij Mij aanroept.”";
"discovery.card.dua_near.source" = "Koran 2:186";

"discovery.card.no_despair.title" = "Wanhoop niet aan Allahs barmhartigheid";
"discovery.card.no_despair.meaning" = "Allah zegt: “Zeg: O Mijn dienaren die zichzelf onrecht hebben aangedaan, wanhoop niet aan de barmhartigheid van Allah. Voorwaar, Allah vergeeft alle zonden.”";
"discovery.card.no_despair.source" = "Koran 39:53";

"discovery.card.qadr.title" = "Laylat al-Qadr";
"discovery.card.qadr.meaning" = "Allah zegt: “De Nacht van de Beschikking is beter dan duizend maanden.”";
"discovery.card.qadr.source" = "Koran 97:3";

"discovery.card.duha_care.title" = "Jouw Heer heeft jou niet verlaten";
"discovery.card.duha_care.meaning" = "Allah zegt: “Jouw Heer heeft jou niet verlaten en is niet ontevreden. Het Laatste is beter voor jou dan het Eerste. Jouw Heer zal jou geven, en jij zult tevreden zijn.”";
"discovery.card.duha_care.source" = "Koran 93:3–5";

"discovery.card.asr.title" = "Bij de tijd, de mens is in verlies";
"discovery.card.asr.meaning" = "Allah zegt: “Bij de tijd, voorwaar, de mens is in verlies — behalve wie geloven, goede daden doen, en elkaar tot de waarheid en tot geduld aansporen.”";
"discovery.card.asr.source" = "Koran 103:1–3";

"discovery.card.kawthar.title" = "Wij hebben jou al-Kawthar gegeven";
"discovery.card.kawthar.meaning" = "Allah zegt: “Voorwaar, Wij hebben jou al-Kawthar gegeven. Bid daarom tot jouw Heer en offer.”";
"discovery.card.kawthar.source" = "Koran 108:1–2";

"discovery.card.no_compulsion.title" = "Geen dwang in de religie";
"discovery.card.no_compulsion.meaning" = "Allah zegt: “Er is geen dwang in de religie. Het rechte pad is duidelijk onderscheiden van de dwaling.”";
"discovery.card.no_compulsion.source" = "Koran 2:256";

"discovery.card.with_you.title" = "Hij is met jullie waar jullie ook zijn";
"discovery.card.with_you.meaning" = "Allah zegt: “Hij is met jullie waar jullie ook zijn. En Allah ziet wat jullie doen.”";
"discovery.card.with_you.source" = "Koran 57:4";

"discovery.card.closer.title" = "Dichterbij dan de halsader";
"discovery.card.closer.meaning" = "Allah zegt: “Wij hebben de mens geschapen en Wij weten wat zijn ziel hem influistert, en Wij zijn dichter bij hem dan zijn halsader.”";
"discovery.card.closer.source" = "Koran 50:16";

"discovery.card.spouses.title" = "Genegenheid en barmhartigheid tussen jullie";
"discovery.card.spouses.meaning" = "Allah zegt: “Hij schiep voor jullie uit julliezelf echtgenoten, opdat jullie tot rust komen bij hen, en Hij plaatste tussen jullie genegenheid en barmhartigheid.”";
"discovery.card.spouses.source" = "Koran 30:21";

"discovery.card.blessings_count.title" = "Jullie kunnen Allahs gunsten niet tellen";
"discovery.card.blessings_count.meaning" = "Allah zegt: “Als jullie de gunst van Allah zouden willen tellen, zouden jullie haar niet kunnen opsommen. Voorwaar, Allah is Vergevend, Barmhartig.”";
"discovery.card.blessings_count.source" = "Koran 16:18";

"discovery.card.fasting_prescribed.title" = "Het vasten is jullie voorgeschreven";
"discovery.card.fasting_prescribed.meaning" = "Allah zegt: “O jullie die geloven, het vasten is jullie voorgeschreven zoals het hen vóór jullie was voorgeschreven, opdat jullie taqwa zouden krijgen.”";
"discovery.card.fasting_prescribed.source" = "Koran 2:183";

"discovery.card.yunus_dua.title" = "Er is geen god dan Jij";
"discovery.card.yunus_dua.meaning" = "Allah zegt dat Yunus in de duisternis riep: “Er is geen god dan Jij. Verheven bent Jij. Voorwaar, ik behoorde tot de onrechtplegers.”";
"discovery.card.yunus_dua.source" = "Koran 21:87";

"discovery.card.hasbuna.title" = "Allah is ons genoeg";
"discovery.card.hasbuna.meaning" = "Allah zegt dat wie in geloof toenam zei: “Allah is ons genoeg, en Hij is de beste Beschikker.”";
"discovery.card.hasbuna.source" = "Koran 3:173";

"discovery.card.rabbana_atina.title" = "Goed in deze wereld en de volgende";
"discovery.card.rabbana_atina.meaning" = "Allah zegt: “Onze Heer, geef ons het goede in deze wereld en het goede in het Hiernamaals, en bescherm ons tegen de straf van het Vuur.”";
"discovery.card.rabbana_atina.source" = "Koran 2:201";

"discovery.card.be_and_it_is.title" = "Wees, en het is";
"discovery.card.be_and_it_is.meaning" = "Allah zegt: “Zijn bevel, als Hij iets wil, is slechts dat Hij ertegen zegt: ‘Wees,’ en het is.”";
"discovery.card.be_and_it_is.source" = "Koran 36:82";

"discovery.card.which_favors.title" = "Welke gunsten van jullie Heer?";
"discovery.card.which_favors.meaning" = "Allah zegt: “Welke van de gunsten van jullie Heer zullen jullie beiden dan loochenen?”";
"discovery.card.which_favors.source" = "Koran 55:13";

"discovery.card.calamity.title" = "Geen ramp behalve met Allahs toestemming";
"discovery.card.calamity.meaning" = "Allah zegt: “Geen ramp treft [iemand] behalve met toestemming van Allah. En wie in Allah gelooft — Hij leidt zijn hart.”";
"discovery.card.calamity.source" = "Koran 64:11";

"discovery.card.death_life.title" = "Hij schiep de dood en het leven";
"discovery.card.death_life.meaning" = "Allah zegt: “Die de dood en het leven schiep om jullie te beproeven wie van jullie het beste handelt — en Hij is de Machtige, de Vergevende.”";
"discovery.card.death_life.source" = "Koran 67:2";

"discovery.card.kafirun.title" = "Voor jullie jullie religie, voor mij de mijne";
"discovery.card.kafirun.meaning" = "Allah zegt: “Voor jullie jullie religie, en voor mij de mijne.”";
"discovery.card.kafirun.source" = "Koran 109:6";

"discovery.card.nas.title" = "Ik zoek bescherming bij de Heer van de mensen";
"discovery.card.nas.meaning" = "Allah zegt: “Zeg: Ik zoek bescherming bij de Heer van de mensen, de Koning van de mensen, de God van de mensen.”";
"discovery.card.nas.source" = "Koran 114:1–3";

"discovery.card.falaq.title" = "Ik zoek bescherming bij de Heer van het daggloren";
"discovery.card.falaq.meaning" = "Allah zegt: “Zeg: Ik zoek bescherming bij de Heer van het daggloren, tegen het kwaad van wat Hij heeft geschapen.”";
"discovery.card.falaq.source" = "Koran 113:1–2";

"discovery.card.orphans_duha.title" = "Onderdruk de wees niet";
"discovery.card.orphans_duha.meaning" = "Allah zegt: “Wat de wees betreft, onderdruk hem niet. En wat de vragende betreft, wijs hem niet af. En wat de gunst van jouw Heer betreft, verkondig die.”";
"discovery.card.orphans_duha.source" = "Koran 93:9–11";

"discovery.card.justice.title" = "Sta vast voor rechtvaardigheid";
"discovery.card.justice.meaning" = "Allah zegt: “O jullie die geloven, wees standvastig in rechtvaardigheid, getuigen voor Allah, al is het tegen julliezelf of tegen ouders en verwanten.”";
"discovery.card.justice.source" = "Koran 4:135";

"discovery.card.amanah.title" = "Geef toevertrouwde zaken terug";
"discovery.card.amanah.meaning" = "Allah zegt: “Allah gebiedt jullie de toevertrouwde zaken aan hun rechthebbenden terug te geven, en als jullie tussen mensen oordelen, dat jullie met rechtvaardigheid oordelen.”";
"discovery.card.amanah.source" = "Koran 4:58";

"discovery.card.luqman_salah.title" = "Verricht het gebed, mijn zoon";
"discovery.card.luqman_salah.meaning" = "Luqman zei: “O mijn zoon, verricht het gebed, gebied het goede, verbied het verwerpelijke, en wees geduldig bij wat jou treft.”";
"discovery.card.luqman_salah.source" = "Koran 31:17";

"discovery.card.infaq_grain.title" = "De gelijkenis van uitgeven";
"discovery.card.infaq_grain.meaning" = "Allah zegt: “Het voorbeeld van wie hun bezit uitgeven op de weg van Allah is als een korrel die zeven aren voortbrengt, in elke aar honderd korrels. Allah vermenigvuldigt voor wie Hij wil.”";
"discovery.card.infaq_grain.source" = "Koran 2:261";

"discovery.card.rabbana_forgive.title" = "Neem ons niet ter verantwoording als wij vergeten";
"discovery.card.rabbana_forgive.meaning" = "Allah zegt: “Onze Heer, neem ons niet ter verantwoording als wij vergeten of ons vergissen. Onze Heer, leg ons geen last op zoals U die oplegde aan wie vóór ons waren.”";
"discovery.card.rabbana_forgive.source" = "Koran 2:286";

"discovery.card.establish_salah.title" = "Verricht het gebed en geef de zakat";
"discovery.card.establish_salah.meaning" = "Allah zegt: “Verricht het gebed en geef de zakat en buig met wie buigen.”";
"discovery.card.establish_salah.source" = "Koran 2:43";

"discovery.card.way_out.title" = "Wie taqwa heeft, Allah maakt een uitweg";
"discovery.card.way_out.meaning" = "Allah zegt: “Wie taqwa van Allah heeft — Hij maakt voor hem een uitweg, en Hij voorziet hem van waar hij het niet verwacht.”";
"discovery.card.way_out.source" = "Koran 65:2–3";

"discovery.card.sincere_deen.title" = "Dien Allah, met oprechte religie";
"discovery.card.sincere_deen.meaning" = "Allah zegt: “Zij werden slechts bevolen Allah te dienen, Hem de religie zuiver toewijdend, tot de waarheid neigend, en het gebed te verrichten en de zakat te geven.”";
"discovery.card.sincere_deen.source" = "Koran 98:5";

"discovery.card.allah_light.title" = "Allah is het Licht van de hemelen en de aarde";
"discovery.card.allah_light.meaning" = "Allah zegt: “Allah is het Licht van de hemelen en de aarde.”";
"discovery.card.allah_light.source" = "Koran 24:35";

"discovery.card.expand_chest.title" = "Hebben Wij jouw borst niet verruimd?";
"discovery.card.expand_chest.meaning" = "Allah zegt: “Hebben Wij jouw borst niet voor jou verruimd, en van jou jouw last weggenomen die op jouw rug drukte, en jouw gedachtenis verheven?”";
"discovery.card.expand_chest.source" = "Koran 94:1–4";

"discovery.card.hikmah.title" = "Hij schenkt wijsheid aan wie Hij wil";
"discovery.card.hikmah.meaning" = "Allah zegt: “Hij schenkt wijsheid aan wie Hij wil, en wie wijsheid is gegeven, hem is waarlijk veel goeds gegeven.”";
"discovery.card.hikmah.source" = "Koran 2:269";

"discovery.card.five_pillars.title" = "De islam is gebouwd op vijf";
"discovery.card.five_pillars.meaning" = "De Profeet ﷺ zei: “De islam is gebouwd op vijf: de getuigenis dat er geen god is dan Allah en dat Mohammed de Boodschapper van Allah is, het gebed verrichten, de zakat geven, de hadj, en het vasten in Ramadan.”";
"discovery.card.five_pillars.source" = "Sahih al-Bukhari 8 · Sahih Muslim 16";

"discovery.card.muslim_tongue.title" = "Veilig voor zijn tong en hand";
"discovery.card.muslim_tongue.meaning" = "De Profeet ﷺ zei: “De moslim is degene voor wiens tong en hand de moslims veilig zijn.”";
"discovery.card.muslim_tongue.source" = "Sahih al-Bukhari 10 · Sahih Muslim 41";

"discovery.card.deen_nasihah.title" = "De religie is oprechte raad";
"discovery.card.deen_nasihah.meaning" = "De Profeet ﷺ zei: “De religie is nasihah (oprechte raad).” Zij zeiden: Aan wie? Hij zei: “Aan Allah, Zijn Boek, Zijn Boodschapper, de leiders van de moslims en hun gewone volk.”";
"discovery.card.deen_nasihah.source" = "Sahih Muslim 55";

"discovery.card.best_quran.title" = "De besten van jullie leren de Koran en onderwijzen hem";
"discovery.card.best_quran.meaning" = "De Profeet ﷺ zei: “De besten van jullie zijn wie de Koran leren en hem onderwijzen.”";
"discovery.card.best_quran.source" = "Sahih al-Bukhari 5027";

"discovery.card.mother_first.title" = "Jouw moeder, dan jouw moeder";
"discovery.card.mother_first.meaning" = "Iemand vroeg: Wie verdient het meest mijn goede omgang? De Profeet ﷺ zei: “Jouw moeder.” Hij zei: Daarna wie? Hij zei: “Jouw moeder.” Hij zei: Daarna wie? Hij zei: “Jouw moeder.” Hij zei: Daarna wie? Hij zei: “Jouw vader.”";
"discovery.card.mother_first.source" = "Sahih al-Bukhari 5971 · Sahih Muslim 2548";

"discovery.card.plant_tree.title" = "Een geplant gewas is sadaqah";
"discovery.card.plant_tree.meaning" = "De Profeet ﷺ zei: “Nooit plant een moslim een boom of zaait hij een gewas, en eet een vogel, een mens of een dier daarvan, of het is sadaqah voor hem.”";
"discovery.card.plant_tree.source" = "Sahih Muslim 1553";

"discovery.card.seven_shade.title" = "Zeven in Allahs schaduw";
"discovery.card.seven_shade.meaning" = "De Profeet ﷺ zei: “Zeven zullen door Allah beschaduwd worden op de Dag waarop er geen schaduw is dan de Zijne: een rechtvaardige heerser; een jongere die opgroeide in de aanbidding van Allah; iemand wiens hart aan de moskee hangt; twee die elkaar liefhebben om Allah; iemand die door een vrouw van stand en schoonheid wordt uitgenodigd en zegt: ‘Ik vrees Allah’; wie sadaqah zo verborgen geeft dat zijn linkerhand niet weet wat zijn rechter uitgeeft; en wie Allah in het verborgene gedenkt en wiens ogen overstromen.”";
"discovery.card.seven_shade.source" = "Sahih al-Bukhari 1423 · Sahih Muslim 1031";

"discovery.card.tasbih_salah.title" = "Na het gebed: 33, 33, 34";
"discovery.card.tasbih_salah.meaning" = "De Profeet ﷺ leerde na de salah: Subhan Allah drieëndertig keer, al-hamdu lillah drieëndertig keer, en Allahu akbar vierendertig keer.";
"discovery.card.tasbih_salah.source" = "Sahih Muslim 596";

"discovery.card.hundred_tasbih.title" = "Honderd keer per dag";
"discovery.card.hundred_tasbih.meaning" = "De Profeet ﷺ zei: “Wie ‘Verheven is Allah en Hem komt de lof toe’ honderd keer per dag zegt, zijn zonden worden vergeven, al zijn ze als het schuim van de zee.”";
"discovery.card.hundred_tasbih.source" = "Sahih al-Bukhari 6405 · Sahih Muslim 2691";

"discovery.card.enter_masjid.title" = "Als je de moskee binnengaat";
"discovery.card.enter_masjid.meaning" = "De Profeet ﷺ zei: als een van jullie de moskee binnengaat, laat hem zeggen: “O Allah, open voor mij de deuren van Jouw barmhartigheid.”";
"discovery.card.enter_masjid.source" = "Sahih Muslim 713";

"discovery.card.do_not_anger.title" = "Word niet boos";
"discovery.card.do_not_anger.meaning" = "Iemand zei tegen de Profeet ﷺ: Adviseer mij. Hij zei: “Word niet boos.” De man herhaalde zijn verzoek meerdere keren, en hij zei: “Word niet boos.”";
"discovery.card.do_not_anger.source" = "Sahih al-Bukhari 6116";

"discovery.card.make_easy.title" = "Maak het makkelijk";
"discovery.card.make_easy.meaning" = "De Profeet ﷺ zei: “Maak het makkelijk en maak het niet moeilijk. Breng goed nieuws en stoot mensen niet af.”";
"discovery.card.make_easy.source" = "Sahih al-Bukhari 69";

"discovery.card.religion_ease.title" = "De religie is gemak";
"discovery.card.religion_ease.meaning" = "De Profeet ﷺ zei: “De religie is gemak. Niemand maakt de religie hard voor zichzelf of zij overwint hem. Wees daarom gematigd, doe je best, wees blij, en zoek hulp in de ochtend, de namiddag en een beetje in de nacht.”";
"discovery.card.religion_ease.source" = "Sahih al-Bukhari 39";

"discovery.card.feed_hungry.title" = "Voed de hongerige";
"discovery.card.feed_hungry.meaning" = "De Profeet ﷺ zei: “Voed de hongerige, bezoek de zieke, en bevrijd de gevangene.”";
"discovery.card.feed_hungry.source" = "Sahih al-Bukhari 5373";

"discovery.card.good_word.title" = "Een goed woord is sadaqah";
"discovery.card.good_word.meaning" = "De Profeet ﷺ zei: “Een goed woord is sadaqah.”";
"discovery.card.good_word.source" = "Sahih al-Bukhari 2989 · Sahih Muslim 1009";

"discovery.card.no_cheating.title" = "Wie bedriegt, hoort niet bij ons";
"discovery.card.no_cheating.meaning" = "De Profeet ﷺ zei: “Wie ons bedriegt, hoort niet bij ons.”";
"discovery.card.no_cheating.source" = "Sahih Muslim 102";

"discovery.card.sleep_muawwidhat.title" = "Reciteer de laatste drie soera’s voor het slapen";
"discovery.card.sleep_muawwidhat.meaning" = "Aisha berichtte dat de Profeet ﷺ, als hij naar bed ging, zijn handen samenbracht, erin blies, soera al-Ikhlas, al-Falaq en an-Nas reciteerde, en daarna over zijn lichaam streek.";
"discovery.card.sleep_muawwidhat.source" = "Sahih al-Bukhari 5017";

"discovery.card.treat_women.title" = "Vrees Allah met betrekking tot vrouwen";
"discovery.card.treat_women.meaning" = "De Profeet ﷺ zei in de Afscheidspreek: “Vrees Allah met betrekking tot vrouwen, want jullie hebben hen als een toevertrouwd goed van Allah genomen, en omgang met hen is jullie toegestaan door het woord van Allah.”";
"discovery.card.treat_women.source" = "Sahih Muslim 1218";

"discovery.card.wudu_sins.title" = "Wudu wast zonden weg";
"discovery.card.wudu_sins.meaning" = "De Profeet ﷺ zei: als een moslim — of een gelovige — wudu verricht en zijn gezicht wast, gaat elke zonde die hij met zijn ogen bekeek weg met het water, of met de laatste druppel; als hij zijn handen wast, gaan de zonden van zijn handen weg; als hij zijn voeten wast, gaan de zonden waarheen zijn voeten liepen weg — totdat hij gereinigd van zonde naar buiten komt.";
"discovery.card.wudu_sins.source" = "Sahih Muslim 244";

/* BEGIN DISCOVERY EXPANSION */
"discovery.card.ayah_1_1.title" = "Al-Faatiha 1";
"discovery.card.ayah_1_1.meaning" = "In de naam van Allah, de erbarmer, de barmhartige.";
"discovery.card.ayah_1_1.source" = "Qur’an 1:1";

"discovery.card.ayah_1_4.title" = "Al-Faatiha 4";
"discovery.card.ayah_1_4.meaning" = "de heerser op de oordeelsdag.";
"discovery.card.ayah_1_4.source" = "Qur’an 1:4";

"discovery.card.ayah_1_5.title" = "Al-Faatiha 5";
"discovery.card.ayah_1_5.meaning" = "U dienen wij en U vragen wij om hulp.";
"discovery.card.ayah_1_5.source" = "Qur’an 1:5";

"discovery.card.ayah_1_6.title" = "Al-Faatiha 6";
"discovery.card.ayah_1_6.meaning" = "Leid ons op de juiste weg,";
"discovery.card.ayah_1_6.source" = "Qur’an 1:6";

"discovery.card.ayah_1_7.title" = "Al-Faatiha 7";
"discovery.card.ayah_1_7.meaning" = "de weg van hen aan wie U genade geschonken hebt, op wie geen toorn rust en die niet dwalen.";
"discovery.card.ayah_1_7.source" = "Qur’an 1:7";

"discovery.card.ayah_2_2.title" = "Al-Baqara 2";
"discovery.card.ayah_2_2.meaning" = "Dat is het boek, waaraan geen twijfel is, een leidraad voor de godvrezenden,";
"discovery.card.ayah_2_2.source" = "Qur’an 2:2";

"discovery.card.ayah_2_21.title" = "Al-Baqara 21";
"discovery.card.ayah_2_21.meaning" = "O mensen, dient jullie Heer die jullie en hen die er voor jullie waren geschapen heeft -- misschien zullen jullie godvrezend worden --";
"discovery.card.ayah_2_21.source" = "Qur’an 2:21";

"discovery.card.ayah_2_45.title" = "Al-Baqara 45";
"discovery.card.ayah_2_45.meaning" = "Neemt jullie toevlucht tot geduld en de salaat. Dat is veel, maar niet voor de deemoedigen,";
"discovery.card.ayah_2_45.source" = "Qur’an 2:45";

"discovery.card.ayah_2_155.title" = "Al-Baqara 155";
"discovery.card.ayah_2_155.meaning" = "Wij zullen jullie op de proef stellen met iets van vrees, honger en tekort aan bezittingen, levens en vruchten, maar verkondig het goede nieuws aan hen die geduldig volharden,";
"discovery.card.ayah_2_155.source" = "Qur’an 2:155";

"discovery.card.ayah_2_165.title" = "Al-Baqara 165";
"discovery.card.ayah_2_165.meaning" = "Er zijn mensen die aannemen dat er naast Allah nog gelijken zijn die zij even liefhebben als Allah, maar zij die geloven hebben Allah meer lief. Als zij die onrecht plegen maar zouden zien, wanneer zij de bestraffing bemerken, dat de kracht geheel aan Allah toebehoort en dat Allah streng is in de bestraffing.";
"discovery.card.ayah_2_165.source" = "Qur’an 2:165";

"discovery.card.ayah_2_177.title" = "Al-Baqara 177";
"discovery.card.ayah_2_177.meaning" = "Vroomheid is niet dat jullie je gezichten naar het oosten en het westen wendt, maar vroom is wie gelooft in Allah, in de laatste dag, in de engelen, in het boek en in de profeten en wie zijn bezit, hoe lief hij dat ook heeft, geeft aan de verwanten, de wezen, de behoeftigen, aan hem die onderweg is, aan de bedelaars en voor [de vrijkoop van] de slaven, en wie de salaat verricht en de zakaat geeft en wie hun verbintenis nakomen, als zij een verbintenis zijn aangegaan en wie volhardend zijn in tegenspoed en rampspoed en ten tijde van strijd. Zij zijn het die oprecht zijn en dat zijn de godvrezenden.";
"discovery.card.ayah_2_177.source" = "Qur’an 2:177";

"discovery.card.ayah_2_185.title" = "Al-Baqara 185";
"discovery.card.ayah_2_185.meaning" = "De maand Ramadaan is het waarin de Koran werd neergezonden als een leidraad voor de mensen en als duidelijke bewijzen van de leidraad en het reddend onderscheidingsmiddel. Wie van jullie aanwezig is in de maand die moet erin vasten en als iemand ziek is of op reis, dan een aantal andere dagen. Allah wenst het jullie gemakkelijk te maken en niet moeilijk. Maakt het aantal dus vol en verheerlijkt Allah. Misschien zullen jullie dank betuigen.";
"discovery.card.ayah_2_185.source" = "Qur’an 2:185";

"discovery.card.ayah_2_197.title" = "Al-Baqara 197";
"discovery.card.ayah_2_197.meaning" = "De bedevaart is in de bekende maanden. Wie zich daarin de verplichting van de bedevaart oplegt, moet zich tijdens de bedevaart van geslachtsverkeer, schandelijkheid en twist onthouden. Wat voor goeds jullie doen dat weet Allah. En neemt proviand mee, maar de beste proviand is godvrezendheid. Vreest Mij, o verstandigen.";
"discovery.card.ayah_2_197.source" = "Qur’an 2:197";

"discovery.card.ayah_2_208.title" = "Al-Baqara 208";
"discovery.card.ayah_2_208.meaning" = "Jullie die geloven! Treedt allen tezamen toe tot de overgave [aan Allah] en volgt de voetstappen van de satan niet, want hij is een verklaarde vijand van jullie.";
"discovery.card.ayah_2_208.source" = "Qur’an 2:208";

"discovery.card.ayah_2_216.title" = "Al-Baqara 216";
"discovery.card.ayah_2_216.meaning" = "Aan jullie is voorgeschreven te strijden, hoezeer het jullie ook tegenstaat. Maar misschien staat jullie iets tegen wat toch goed voor jullie is en misschien hebben jullie iets lief wat toch slecht is voor jullie. Allah weet en jullie weten niet.";
"discovery.card.ayah_2_216.source" = "Qur’an 2:216";

"discovery.card.ayah_2_245.title" = "Al-Baqara 245";
"discovery.card.ayah_2_245.meaning" = "Wie is het die aan Allah een goede lening geeft? Hij zal het voor hem dan veelvoudig verdubbelen. Allah schenkt weinig en ook ruimschoots en tot Hem worden jullie teruggebracht.";
"discovery.card.ayah_2_245.source" = "Qur’an 2:245";

"discovery.card.ayah_2_254.title" = "Al-Baqara 254";
"discovery.card.ayah_2_254.meaning" = "Jullie die geloven! Geeft ook bijdragen van wat Wij jullie voor jullie levensonderhoud gegeven hebben voordat er een dag komt waarop er geen handel, geen vriendschap en geen voorspraak is. De ongelovigen zijn de onrechtplegers.";
"discovery.card.ayah_2_254.source" = "Qur’an 2:254";

"discovery.card.ayah_2_267.title" = "Al-Baqara 267";
"discovery.card.ayah_2_267.meaning" = "Jullie die geloven! Geeft ook bijdragen van de goede dingen die jullie verworven hebben en ook van wat Wij voor jullie uit de aarde hebben voortgebracht. Weest er niet op uit om wat er slecht van is als bijdrage te geven; jullie zouden het zelf alleen maar nemen als jullie de ogen ervoor zouden sluiten. En weet dat Allah behoefteloos is en lofwaardig.";
"discovery.card.ayah_2_267.source" = "Qur’an 2:267";

"discovery.card.ayah_2_285.title" = "Al-Baqara 285";
"discovery.card.ayah_2_285.meaning" = "De gezant gelooft in wat van zijn Heer vandaan naar hem is neergezonden en de gelovigen ook; allen geloven in Allah, in Zijn engelen, in Zijn boeken en in Zijn gezanten. Wij maken geen enkel onderscheid tussen Zijn gezanten. Zij zeggen: \"Wij horen en gehoorzamen. Schenk ons Uw vergeving, onze Heer. Bij U is de bestemming.\"";
"discovery.card.ayah_2_285.source" = "Qur’an 2:285";

"discovery.card.ayah_3_8.title" = "Aal-i-Imraan 8";
"discovery.card.ayah_3_8.meaning" = "Onze Heer, laat onze harten niet naar het verkeerde neigen, nadat U ons de goede richting hebt gewezen en schenk ons van Uw kant barmhartigheid. U bent de vrijgevige.";
"discovery.card.ayah_3_8.source" = "Qur’an 3:8";

"discovery.card.ayah_3_26.title" = "Aal-i-Imraan 26";
"discovery.card.ayah_3_26.meaning" = "Zeg: \"O Allah, heerser over het koningschap, U geeft het koningschap aan wie U wilt en U ontneemt het koningschap aan wie U wilt. U maakt machtig wie U wilt en U vernedert wie U wilt. Het goede is in Uw hand. U bent almachtig.";
"discovery.card.ayah_3_26.source" = "Qur’an 3:26";

"discovery.card.ayah_3_31.title" = "Aal-i-Imraan 31";
"discovery.card.ayah_3_31.meaning" = "Zeg: \"Als jullie Allah liefhebben, volgt mij dan en Allah zal jullie liefhebben en jullie je zonden vergeven.\" Allah is vergevend en barmhartig.";
"discovery.card.ayah_3_31.source" = "Qur’an 3:31";

"discovery.card.ayah_3_92.title" = "Aal-i-Imraan 92";
"discovery.card.ayah_3_92.meaning" = "Jullie zullen de vroomheid niet bereiken totdat jullie van wat jullie liefhebben bijdragen geven. En wat jullie ook aan bijdragen geven, Allah weet ervan. *";
"discovery.card.ayah_3_92.source" = "Qur’an 3:92";

"discovery.card.ayah_3_102.title" = "Aal-i-Imraan 102";
"discovery.card.ayah_3_102.meaning" = "Jullie die geloven! Vreest Allah zoals het Hem toekomt; jullie mogen dus alleen maar sterven als [mensen] die zich [aan Allah] hebben overgegeven.";
"discovery.card.ayah_3_102.source" = "Qur’an 3:102";

"discovery.card.ayah_3_103.title" = "Aal-i-Imraan 103";
"discovery.card.ayah_3_103.meaning" = "En houdt samen vast aan Allahs band en splitst jullie niet op in groepen. Denkt aan Allahs genade aan jullie toen jullie vijanden waren en Hij jullie harten tot elkaar bracht en jullie door Zijn genade broeders werden; toen jullie op de rand van de groeve van het vuur waren en Hij jullie ervan redde. Zo maakt Allah voor jullie Zijn tekenen duidelijk. Misschien zullen jullie je de goede richting laten wijzen.";
"discovery.card.ayah_3_103.source" = "Qur’an 3:103";

"discovery.card.ayah_3_110.title" = "Aal-i-Imraan 110";
"discovery.card.ayah_3_110.meaning" = "Jullie zijn de beste gemeenschap die er voor de mensen is voortgebracht; jullie gebieden het behoorlijke, verbieden het verwerpelijke en geloven in Allah. Als de mensen van het boek zouden geloven dan was dat beter voor hen. Onder hen zijn er gelovigen, maar de meesten van hen zijn de verdorvenen.";
"discovery.card.ayah_3_110.source" = "Qur’an 3:110";

"discovery.card.ayah_3_133.title" = "Aal-i-Imraan 133";
"discovery.card.ayah_3_133.meaning" = "Streeft naar vergeving van jullie Heer en naar een tuin zo breed als de hemelen en de aarde die klaargemaakt is voor de godvrezenden,";
"discovery.card.ayah_3_133.source" = "Qur’an 3:133";

"discovery.card.ayah_3_139.title" = "Aal-i-Imraan 139";
"discovery.card.ayah_3_139.meaning" = "Versaagt niet en treurt niet. Jullie hebben de overhand als jullie gelovig zijn.";
"discovery.card.ayah_3_139.source" = "Qur’an 3:139";

"discovery.card.ayah_3_159.title" = "Aal-i-Imraan 159";
"discovery.card.ayah_3_159.meaning" = "Vanwege barmhartigheid van Allah was jij soepel voor hen, maar als jij streng en hardvochtig was geweest dan waren zij rondom jou uiteengegaan. Reken het hun dus maar niet aan en vraag vergeving voor hen en raadpleeg hen over het beleid. Wanneer je dan een besluit genomen hebt vertrouw dan op Allah. Allah bemint hen die vertrouwen hebben.";
"discovery.card.ayah_3_159.source" = "Qur’an 3:159";

"discovery.card.ayah_3_185.title" = "Aal-i-Imraan 185";
"discovery.card.ayah_3_185.meaning" = "Ieder zal de dood proeven, maar jullie volle loon zal jullie op de opstandingsdag gegeven worden. Wie dan van het vuur gevrijwaard wordt en in de tuin binnengebracht, die heeft gezegevierd. Het tegenwoordige leven is slechts het genot van de begoocheling. *";
"discovery.card.ayah_3_185.source" = "Qur’an 3:185";

"discovery.card.ayah_3_190.title" = "Aal-i-Imraan 190";
"discovery.card.ayah_3_190.meaning" = "In de schepping van de hemelen en de aarde en het verschil van nacht en dag zijn tekenen voor mensen die verstand hebben,";
"discovery.card.ayah_3_190.source" = "Qur’an 3:190";

"discovery.card.ayah_3_200.title" = "Aal-i-Imraan 200";
"discovery.card.ayah_3_200.meaning" = "Jullie die geloven! Weest geduldig, volhardend, standvastig en vreest Allah. Misschien zal het jullie welgaan.";
"discovery.card.ayah_3_200.source" = "Qur’an 3:200";

"discovery.card.ayah_4_1.title" = "An-Nisaa 1";
"discovery.card.ayah_4_1.meaning" = "O mensen, vreest jullie Heer die jullie uit één wezen geschapen heeft, die uit hem zijn echtgenote schiep en die uit hen beiden vele mannen en vrouwen heeft voortgebracht en [over de aarde] verspreid. Vreest Allah uit wiens naam jullie elkaar iets vragen en respecteert de verwantschapsbanden. Allah is opziener over jullie.";
"discovery.card.ayah_4_1.source" = "Qur’an 4:1";

"discovery.card.ayah_4_29.title" = "An-Nisaa 29";
"discovery.card.ayah_4_29.meaning" = "Jullie die geloven! Verteert niet onderling elkaars bezittingen door bedrog, behalve als het om handel met wederzijdse instemming gaat, en doodt elkaar niet. Allah is voor jullie barmhartig.";
"discovery.card.ayah_4_29.source" = "Qur’an 4:29";

"discovery.card.ayah_4_36.title" = "An-Nisaa 36";
"discovery.card.ayah_4_36.meaning" = "Dient Allah en voegt aan Hem niets als metgezel toe. En weest goed voor de ouders en ook voor de verwant, de wezen, de behoeftigen, de verwante buur, de niet-verwante buur, de niet-verwante medeburger, hij die onderweg is en slaven waarover jullie beschikken. Allah bemint niet wie ingebeeld en verwaand zijn,";
"discovery.card.ayah_4_36.source" = "Qur’an 4:36";

"discovery.card.ayah_4_40.title" = "An-Nisaa 40";
"discovery.card.ayah_4_40.meaning" = "Allah doet geen greintje onrecht aan en als het een goede daad is zal Hij die verdubbelen en van Zijn kant een geweldig loon geven.";
"discovery.card.ayah_4_40.source" = "Qur’an 4:40";

"discovery.card.ayah_4_59.title" = "An-Nisaa 59";
"discovery.card.ayah_4_59.meaning" = "Jullie die geloven! Gehoorzaamt Allah en gehoorzaamt de gezant en de gezagdragers uit jullie midden. Als jullie met elkaar twisten, legt het dan voor aan Allah en de gezant, als jullie in Allah en de laatste dag geloven; dat is beter voor jullie en een mooiere afsluiting.";
"discovery.card.ayah_4_59.source" = "Qur’an 4:59";

"discovery.card.ayah_4_69.title" = "An-Nisaa 69";
"discovery.card.ayah_4_69.meaning" = "Wie Allah en de gezant gehoorzamen, dat zijn zij die bij hen behoren aan wie Allah genade geschonken heeft: de profeten, de oprechten, de [geloofs]getuigen en de rechtschapenen. Dat zijn goede kameraden!";
"discovery.card.ayah_4_69.source" = "Qur’an 4:69";

"discovery.card.ayah_4_86.title" = "An-Nisaa 86";
"discovery.card.ayah_4_86.meaning" = "En wanneer men jullie met een groet begroet, groet dan op een betere manier terug of beantwoordt de groet. Allah rekent over alles af.";
"discovery.card.ayah_4_86.source" = "Qur’an 4:86";

"discovery.card.ayah_4_103.title" = "An-Nisaa 103";
"discovery.card.ayah_4_103.meaning" = "En wanneer jullie de salaat beëindigd hebben, gedenkt dan Allah staand, zittend en op jullie zij liggend. Wanneer jullie dan weer rust hebben verricht dan de salaat. De salaat is voor de gelovigen een voorschrift voor bepaalde tijden.";
"discovery.card.ayah_4_103.source" = "Qur’an 4:103";

"discovery.card.ayah_4_174.title" = "An-Nisaa 174";
"discovery.card.ayah_4_174.meaning" = "O mensen! Een bewijs van jullie Heer is tot jullie gekomen en Wij hebben een duidelijk licht naar jullie neergezonden.";
"discovery.card.ayah_4_174.source" = "Qur’an 4:174";

"discovery.card.ayah_5_2.title" = "Al-Maaida 2";
"discovery.card.ayah_5_2.meaning" = "Jullie die geloven! Ontwijdt Allahs gewijde symbolen niet, noch de heilige maand, noch de offergave, noch de halsomhangsels, noch hen die zich naar het heilige huis begeven om naar goedgunstigheid van hun Heer en welgevallen te streven. Wanneer jullie niet [meer] in gewijde staat zijn, dan mogen jullie op jacht gaan. En laat de afkeer van bepaalde mensen, omdat zij jullie de weg naar de heilige moskee versperren, jullie er niet toe brengen overtredingen te begaan, maar staat elkaar bij in vroomheid en godvrezendheid en staat elkaar niet bij in zonde en overtreding, maar vreest Allah. Allah is streng in de afstraffing.";
"discovery.card.ayah_5_2.source" = "Qur’an 5:2";

"discovery.card.ayah_5_3.title" = "Al-Maaida 3";
"discovery.card.ayah_5_3.meaning" = "Verboden is voor jullie wat vanzelf is doodgegaan, bloed, varkensvlees, vlees van iets waarover iets anders dan Allah is aangeroepen, het verstikte, het doodgeslagene, het doodgevallene, het doodgestotene, wat wilde dieren hebben aangevreten -- behalve wat jullie geslacht hebben -- en wat geofferd is op de offerstenen en ook dat jullie met pijlen verloten. Dat is een schande. Heden wanhopen zij die aan jullie godsdienst geen geloof hechten. Vreest hen niet, maar vreest Mij. Heden heb Ik jullie godsdienst voor jullie voltooid, Mijn genade aan jullie volledig bewezen en de Islaam [de overgave aan Allah] als godsdienst voor jullie goedgevonden. Maar als iemand door honger gedwongen wordt zonder tot zonde geneigd te zijn, dan is Allah vergevend en barmhartig.";
"discovery.card.ayah_5_3.source" = "Qur’an 5:3";

"discovery.card.ayah_5_6.title" = "Al-Maaida 6";
"discovery.card.ayah_5_6.meaning" = "Jullie die geloven! Wanneer jullie je voor de salaat opstellen, wast dan jullie gezichten en jullie handen tot aan de ellebogen en wrijft over jullie hoofden en [wast] jullie voeten tot de enkels. En als jullie onrein zijn, reinigt jullie dan. En als jullie ziek zijn of op reis of als iemand van het toilet komt of met vrouwen omgang heeft gehad en jullie vinden geen water, zoekt dan goede kale grond en wrijft jullie gezichten en handen ermee. Allah wenst jullie niet iets hinderlijks op te leggen, maar Hij wenst jullie slechts rein te maken en Zijn genade aan jullie volledig te bewijzen. Misschien zullen jullie dank betuigen.";
"discovery.card.ayah_5_6.source" = "Qur’an 5:6";

"discovery.card.ayah_5_8.title" = "Al-Maaida 8";
"discovery.card.ayah_5_8.meaning" = "Jullie die geloven! Weest standvastig voor Allah als getuigen van de rechtvaardigheid. En laat de afkeer van bepaalde mensen jullie er niet toe brengen niet rechtvaardig te zijn. Weest rechtvaardig, dat is dichter bij godvrezendheid. En vreest Allah. Allah is welingelicht over wat jullie doen.";
"discovery.card.ayah_5_8.source" = "Qur’an 5:8";

"discovery.card.ayah_5_32.title" = "Al-Maaida 32";
"discovery.card.ayah_5_32.meaning" = "Derhalve hebben Wij aan de Israëlieten voorgeschreven dat wie iemand doodt, anders dan voor doodslag of wegens verderf zaaien op de aarde, is alsof hij de mensen gezamenlijk heeft gedood en dat wie iemand laat leven is alsof hij de mensen gezamenlijk heeft laten leven. Onze gezanten zijn tot hen met de duidelijke bewijzen gekomen, maar velen van hen waren daarna op de aarde toch onmatig.";
"discovery.card.ayah_5_32.source" = "Qur’an 5:32";

"discovery.card.ayah_5_35.title" = "Al-Maaida 35";
"discovery.card.ayah_5_35.meaning" = "Jullie die geloven! Vreest Allah en zoekt naar het middel om nader tot Hem te komen en zet jullie in op Zijn weg. Misschien dat het jullie welgaat.";
"discovery.card.ayah_5_35.source" = "Qur’an 5:35";

"discovery.card.ayah_5_54.title" = "Al-Maaida 54";
"discovery.card.ayah_5_54.meaning" = "Jullie die geloven! Als iemand van jullie zich van zijn godsdienst afkeert, dan zal Allah wel met mensen komen die Hij bemint en die Hem beminnen, die inschikkelijk zijn voor de gelovigen en streng tegen de ongelovigen, die zich inspannen op Allahs weg en die niemands verwijt vrezen. Dat is Allahs goedgunstigheid die Hij geeft aan wie Hij wil. Allah is alomvattend en wetend.";
"discovery.card.ayah_5_54.source" = "Qur’an 5:54";

"discovery.card.ayah_5_119.title" = "Al-Maaida 119";
"discovery.card.ayah_5_119.meaning" = "Allah zei: \"Dit is de dag waarop de oprechten baat hebben van hun oprechtheid. Voor hen zijn er tuinen, waar de rivieren onderdoor stromen, daarin zullen zij voor immer en altijd blijven.\" Allah is met hen ingenomen en zij zijn met Hem ingenomen. Dat is de geweldige triomf!";
"discovery.card.ayah_5_119.source" = "Qur’an 5:119";

"discovery.card.ayah_6_17.title" = "Al-An'aam 17";
"discovery.card.ayah_6_17.meaning" = "En als Allah je met tegenspoed treft dan is er niemand die dat kan wegnemen, behalve Hij. En als Hij je met iets goeds treft, Hij is almachtig.";
"discovery.card.ayah_6_17.source" = "Qur’an 6:17";

"discovery.card.ayah_6_54.title" = "Al-An'aam 54";
"discovery.card.ayah_6_54.meaning" = "En wanneer zij die in Onze tekenen geloven tot jou komen, zeg dan: \"Vrede zij met jullie, jullie Heer heeft Zichzelf barmhartigheid voorgeschreven: als iemand van jullie uit onwetendheid het verkeerde doet en dan later berouw toont en het weer goedmaakt, dan is Hij vergevend en barmhartig.\"";
"discovery.card.ayah_6_54.source" = "Qur’an 6:54";

"discovery.card.ayah_6_125.title" = "Al-An'aam 125";
"discovery.card.ayah_6_125.meaning" = "Maar als Allah iemand op het goede pad wenst te brengen dan stelt Hij diens hart open voor de overgave [aan Allah] en als Hij iemand tot dwaling wil brengen dan maakt Hij diens borst zo nauw en beklemd dat het is alsof hij moeizaam naar de hemel opklimt. Zo legt Allah de gruwelijke straf op aan hen die niet geloven.";
"discovery.card.ayah_6_125.source" = "Qur’an 6:125";

"discovery.card.ayah_6_151.title" = "Al-An'aam 151";
"discovery.card.ayah_6_151.meaning" = "Zeg: \"Komt, dan zal ik jullie voorlezen wat jullie Heer jullie verboden heeft: Dat jullie aan Hem niets als metgezel mogen toevoegen, -- en om goed te zijn voor de ouders -- dat jullie je kinderen niet mogen doden uit vrees voor armoe,\" -- Wij voorzien in jullie en hun levensonderhoud -- \"dat jullie geen gruwelijkheden mogen benaderen, noch uiterlijk noch innerlijk en dat jullie niemand mogen doden -- wat Allah verboden heeft -- behalve volgens het recht. Dat draagt Hij jullie op; misschien zullen jullie verstandig worden.";
"discovery.card.ayah_6_151.source" = "Qur’an 6:151";

"discovery.card.ayah_6_162.title" = "Al-An'aam 162";
"discovery.card.ayah_6_162.meaning" = "Zeg: \"Mijn salaat en mijn godsdienstoefening, mijn leven en mijn sterven behoren Allah toe, de Heer van de wereldbewoners.";
"discovery.card.ayah_6_162.source" = "Qur’an 6:162";

"discovery.card.ayah_7_23.title" = "Al-A'raaf 23";
"discovery.card.ayah_7_23.meaning" = "Zij zeiden: \"Onze Heer, wij hebben onszelf onrecht aangedaan en als U ons niet vergeeft en erbarmen met ons hebt dan behoren wij bij de verliezers.\"";
"discovery.card.ayah_7_23.source" = "Qur’an 7:23";

"discovery.card.ayah_7_31.title" = "Al-A'raaf 31";
"discovery.card.ayah_7_31.meaning" = "Kinderen van Adam! Doe jullie mooie kleding aan bij elke moskee en eet en drinkt, maar weest niet verkwistend; Hij bemint de verkwisters niet.";
"discovery.card.ayah_7_31.source" = "Qur’an 7:31";

"discovery.card.ayah_7_56.title" = "Al-A'raaf 56";
"discovery.card.ayah_7_56.meaning" = "Brengt geen verderf op de aarde, nadat zij in orde gemaakt is en roept Hem aan in vrees en begeerte. Allahs barmhartigheid is dicht bij hen die goed doen.";
"discovery.card.ayah_7_56.source" = "Qur’an 7:56";

"discovery.card.ayah_7_128.title" = "Al-A'raaf 128";
"discovery.card.ayah_7_128.meaning" = "Moesa zei tot zijn volk: \"Vraagt Allah om hulp en weest geduldig. De aarde behoort Allah toe; Hij laat haar beërven door wie van Zijn dienaren Hij wil en het [goede] uiteinde komt de godvrezenden toe.\"";
"discovery.card.ayah_7_128.source" = "Qur’an 7:128";

"discovery.card.ayah_7_199.title" = "Al-A'raaf 199";
"discovery.card.ayah_7_199.meaning" = "Neem wat gemakkelijk gegeven kan worden, beveel het behoorlijke en wend je af van de dommen.";
"discovery.card.ayah_7_199.source" = "Qur’an 7:199";

"discovery.card.ayah_7_204.title" = "Al-A'raaf 204";
"discovery.card.ayah_7_204.meaning" = "En wanneer de Koran wordt voorgelezen, luistert er dan naar en let in stilte op; misschien zal aan jullie barmhartigheid worden bewezen.";
"discovery.card.ayah_7_204.source" = "Qur’an 7:204";

"discovery.card.ayah_8_2.title" = "Al-Anfaal 2";
"discovery.card.ayah_8_2.meaning" = "De gelovigen dat zijn slechts zij van wie de harten vol ontzag zijn wanneer Allahs naam vermeld wordt en die, wanneer Zijn tekenen aan hen worden voorgelezen, erdoor in geloof toenemen en die op hun Heer hun vertrouwen stellen,";
"discovery.card.ayah_8_2.source" = "Qur’an 8:2";

"discovery.card.ayah_8_29.title" = "Al-Anfaal 29";
"discovery.card.ayah_8_29.meaning" = "Jullie die geloven! Als jullie Allah vrezen zal Hij voor jullie een reddend onderscheidingsmiddel brengen en jullie je slechte daden kwijtschelden en jullie vergeven; Allah is vol van geweldige goedgunstigheid.";
"discovery.card.ayah_8_29.source" = "Qur’an 8:29";

"discovery.card.ayah_8_46.title" = "Al-Anfaal 46";
"discovery.card.ayah_8_46.meaning" = "Gehoorzaamt Allah en Zijn gezant en twist niet met elkaar zodat jullie opgeven en het jullie niet voor de wind gaat. En volhardt geduldig; Allah is met de geduldig volhardenden.";
"discovery.card.ayah_8_46.source" = "Qur’an 8:46";

"discovery.card.ayah_8_61.title" = "Al-Anfaal 61";
"discovery.card.ayah_8_61.meaning" = "En als zij geneigd zijn tot vrede, wees daar dan ook toe geneigd en stel je vertrouwen op Allah; Hij is de horende, de wetende.";
"discovery.card.ayah_8_61.source" = "Qur’an 8:61";

"discovery.card.ayah_9_18.title" = "At-Tawba 18";
"discovery.card.ayah_9_18.meaning" = "Dienst doen in Allahs moskeeën mogen slechts zij die in Allah en de laatste dag geloven en die de salaat verrichten en de zakaat geven en die alleen Allah vrezen; misschien zijn zij het die het goede pad volgen. *";
"discovery.card.ayah_9_18.source" = "Qur’an 9:18";

"discovery.card.ayah_9_40.title" = "At-Tawba 40";
"discovery.card.ayah_9_40.meaning" = "Als jullie hem niet helpen? Allah heeft hem reeds geholpen toen zij die ongelovig zijn hem samen met een tweede verdreven, toen zij beiden in de grot waren. Toen zei hij tot zijn metgezel: \"Wees niet bedroefd, Allah is met ons.\" Toen liet Allah Zijn kalmte op hem neerdalen en sterkte hem met troepen die jullie niet kunnen zien. En Hij gaf het woord van hen die ongelovig zijn de laagste en het woord van Allah de hoogste plaats. En Allah is machtig en wijs.";
"discovery.card.ayah_9_40.source" = "Qur’an 9:40";

"discovery.card.ayah_9_51.title" = "At-Tawba 51";
"discovery.card.ayah_9_51.meaning" = "Zeg: \"Ons zal alleen maar treffen wat Allah voor ons te boek gesteld heeft. Hij is onze beschermheer. Op Allah moeten de gelovigen hun vertrouwen stellen.\"";
"discovery.card.ayah_9_51.source" = "Qur’an 9:51";

"discovery.card.ayah_9_71.title" = "At-Tawba 71";
"discovery.card.ayah_9_71.meaning" = "Maar de gelovige mannen en vrouwen zijn elkaars medestanders, zij gebieden het behoorlijke, verbieden het verwerpelijke, verrichten de salaat, geven de zakaat en gehoorzamen Allah en Zijn gezant. Zij zijn het met wie Allah erbarmen zal hebben; Allah is machtig en wijs.";
"discovery.card.ayah_9_71.source" = "Qur’an 9:71";

"discovery.card.ayah_9_103.title" = "At-Tawba 103";
"discovery.card.ayah_9_103.meaning" = "Neem van hun bezittingen een aalmoes waarmee jij hen zult reinigen en louteren en bid de salaat voor hen; jouw gebeden zijn een geruststelling voor hen en Allah is horend en wetend.";
"discovery.card.ayah_9_103.source" = "Qur’an 9:103";

"discovery.card.ayah_9_128.title" = "At-Tawba 128";
"discovery.card.ayah_9_128.meaning" = "Tot jullie is een gezant uit jullie eigen midden gekomen. Iemand die het zwaar valt als jullie het moeilijk hebben, die met jullie begaan is, en jegens de gelovigen vol mededogen en barmhartig.";
"discovery.card.ayah_9_128.source" = "Qur’an 9:128";

"discovery.card.ayah_10_25.title" = "Yunus 25";
"discovery.card.ayah_10_25.meaning" = "En Allah roept op tot de woning van de vrede en Hij voert wie Hij wil op een juiste weg.";
"discovery.card.ayah_10_25.source" = "Qur’an 10:25";

"discovery.card.ayah_10_57.title" = "Yunus 57";
"discovery.card.ayah_10_57.meaning" = "O mensen, tot jullie is een aansporing van jullie Heer gekomen en een genezing voor wat er in de harten is en een leidraad en barmhartigheid voor de gelovigen.";
"discovery.card.ayah_10_57.source" = "Qur’an 10:57";

"discovery.card.ayah_10_62.title" = "Yunus 62";
"discovery.card.ayah_10_62.meaning" = "Zeker, Allahs helpers hebben niets te vrezen, noch zullen zij bedroefd zijn,";
"discovery.card.ayah_10_62.source" = "Qur’an 10:62";

"discovery.card.ayah_10_107.title" = "Yunus 107";
"discovery.card.ayah_10_107.meaning" = "En als Allah je met tegenspoed treft dan is er niemand die dat kan wegnemen behalve Hij. En als Hij voor jou iets goeds wenst dan is er niemand die Zijn goedgunstigheid kan tegenhouden. Hij treft ermee wie van Zijn dienaren Hij wil. Hij is de vergevende, de barmhartige.";
"discovery.card.ayah_10_107.source" = "Qur’an 10:107";

"discovery.card.ayah_11_88.title" = "Hud 88";
"discovery.card.ayah_11_88.meaning" = "Hij zei: \"Mijn volk! Hoe zien jullie het? Als ik op een duidelijk bewijs van mijn Heer steun en Hij van Zijn kant goed in mijn levensonderhoud voorziet? Ik wil jullie ook niet tegenspreken over wat ik jullie verbied. Ik wens alleen maar zo goed als ik kan orde op zaken te stellen. Mijn welslagen hangt alleen van Allah af; op Hem stel ik mijn vertrouwen en tot Hem wend ik mij schuldbewust.";
"discovery.card.ayah_11_88.source" = "Qur’an 11:88";

"discovery.card.ayah_11_114.title" = "Hud 114";
"discovery.card.ayah_11_114.meaning" = "En verricht de salaat op de beide uiteinden van de dag en in de vroege uren van de nacht. De goede daden verdrijven de slechte. Dat is een vermaning voor hen die gedenken.";
"discovery.card.ayah_11_114.source" = "Qur’an 11:114";

"discovery.card.ayah_12_21.title" = "Yusuf 21";
"discovery.card.ayah_12_21.meaning" = "Hij die hem gekocht had -- uit Egypte was hij -- zei tot zijn vrouw: \"Zorg dat hij goed wordt ondergebracht. Misschien dat hij ons tot nut is of dat wij hem als kind aannemen.\" Zo gaven Wij Joesoef een vaste positie in het land; ook om hem de uitleg van droomverhalen te onderwijzen. En Allah is meester van Zijn beschikking, maar de meeste mensen weten het niet.";
"discovery.card.ayah_12_21.source" = "Qur’an 12:21";

"discovery.card.ayah_12_87.title" = "Yusuf 87";
"discovery.card.ayah_12_87.meaning" = "Mijn zonen, gaat heen om inlichtingen over Joesoef en zijn broer in te winnen. Aan Allahs bemoediging wanhopen slechts de ongelovige mensen.\"";
"discovery.card.ayah_12_87.source" = "Qur’an 12:87";

"discovery.card.ayah_12_90.title" = "Yusuf 90";
"discovery.card.ayah_12_90.meaning" = "Zij zeiden: \"Ben jij werkelijk Joesoef?\" Hij zei: \"Ik ben Joesoef en dit is mijn broer. Allah heeft ons een gunst bewezen. Als iemand godvrezend is en geduldig volhardt dan laat Allah het loon van hen die goed doen niet verloren gaan.\"";
"discovery.card.ayah_12_90.source" = "Qur’an 12:90";

"discovery.card.ayah_13_11.title" = "Ar-Ra'd 11";
"discovery.card.ayah_13_11.meaning" = "Hij heeft een gevolg voor en achter zich die hem op Allahs bevel bewaken. Allah verandert niet wat er in mensen is zolang zij niet veranderen wat er in henzelf is en wanneer Allah het met mensen slecht voor heeft dan is dat onafwendbaar en zij hebben buiten Allah niemand die hen beschermt.";
"discovery.card.ayah_13_11.source" = "Qur’an 13:11";

"discovery.card.ayah_13_28.title" = "Ar-Ra'd 28";
"discovery.card.ayah_13_28.meaning" = "Zij die geloven en wier harten gerustgesteld worden doordat zij Allah gedenken -- zeker, door Allah te gedenken worden de harten gerustgesteld --,";
"discovery.card.ayah_13_28.source" = "Qur’an 13:28";

"discovery.card.ayah_14_24.title" = "Ibrahim 24";
"discovery.card.ayah_14_24.meaning" = "Heb jij niet gezien hoe Allah een goed woord vergelijkt met een goede boom waarvan de wortel stevig staat en de takken in de hemel reiken?";
"discovery.card.ayah_14_24.source" = "Qur’an 14:24";

"discovery.card.ayah_15_9.title" = "Al-Hijr 9";
"discovery.card.ayah_15_9.meaning" = "Wij hebben de vermaning neergezonden en Wij waken erover.";
"discovery.card.ayah_15_9.source" = "Qur’an 15:9";

"discovery.card.ayah_15_49.title" = "Al-Hijr 49";
"discovery.card.ayah_15_49.meaning" = "Deel Mijn dienaren mee dat Ik de vergevende, de barmhartige ben.";
"discovery.card.ayah_15_49.source" = "Qur’an 15:49";

"discovery.card.ayah_16_90.title" = "An-Nahl 90";
"discovery.card.ayah_16_90.meaning" = "Allah gebiedt rechtvaardig te handelen, goed te doen en aan de verwanten giften te geven en Hij verbiedt wat gruwelijk, verwerpelijk en gewelddadig is. Hij spoort jullie aan; misschien laten jullie je vermanen.";
"discovery.card.ayah_16_90.source" = "Qur’an 16:90";

"discovery.card.ayah_16_97.title" = "An-Nahl 97";
"discovery.card.ayah_16_97.meaning" = "Wie -- hetzij man of vrouw -- deugdelijk handelt als gelovige, die zullen Wij een goed leven laten leiden en Wij zullen hen met hun loon belonen voor het beste dat zij deden.";
"discovery.card.ayah_16_97.source" = "Qur’an 16:97";

"discovery.card.ayah_16_125.title" = "An-Nahl 125";
"discovery.card.ayah_16_125.meaning" = "Roep op tot de weg van jouw Heer met wijsheid en goede aansporing en twist met hen op de beste manier. Jouw Heer kent wie van Zijn weg afdwaalt het best en Hij kent hen die het goede pad volgen het best.";
"discovery.card.ayah_16_125.source" = "Qur’an 16:125";

"discovery.card.ayah_17_9.title" = "Al-Israa 9";
"discovery.card.ayah_17_9.meaning" = "Deze Koran leidt tot dat wat juister is en verkondigt aan de gelovigen die de deugdelijke daden doen dat er voor hen een groot loon is";
"discovery.card.ayah_17_9.source" = "Qur’an 17:9";

"discovery.card.ayah_17_24.title" = "Al-Israa 24";
"discovery.card.ayah_17_24.meaning" = "En wees uit barmhartigheid voor hen nederig en ontvankelijk en zeg: \"Mijn Heer, erbarm U over hen, zoals zij mij grootbrachten toen ik klein was.\"";
"discovery.card.ayah_17_24.source" = "Qur’an 17:24";

"discovery.card.ayah_17_26.title" = "Al-Israa 26";
"discovery.card.ayah_17_26.meaning" = "En geef de verwant wat hem toekomt en ook de behoeftige en wie onderweg is en wees niet verspillend.";
"discovery.card.ayah_17_26.source" = "Qur’an 17:26";

"discovery.card.ayah_17_32.title" = "Al-Israa 32";
"discovery.card.ayah_17_32.meaning" = "En jullie mogen geen ontucht benaderen. Dat is iets gruwelijks en een slechte manier van doen.";
"discovery.card.ayah_17_32.source" = "Qur’an 17:32";

"discovery.card.ayah_17_53.title" = "Al-Israa 53";
"discovery.card.ayah_17_53.meaning" = "En zeg aan Mijn dienaren dat te zeggen wat het beste is, want de satan hitst op tot tweedracht onder hen; de satan is een verklaarde vijand van de mens.";
"discovery.card.ayah_17_53.source" = "Qur’an 17:53";

"discovery.card.ayah_17_70.title" = "Al-Israa 70";
"discovery.card.ayah_17_70.meaning" = "Wij hebben de kinderen van Adam geëerd en Wij hebben hen op het vasteland en de zee gedragen en Wij hebben met goede dingen in hun onderhoud voorzien en Wij hebben hen duidelijk verkozen boven velen van hen die Wij geschapen hebben.";
"discovery.card.ayah_17_70.source" = "Qur’an 17:70";

"discovery.card.ayah_17_80.title" = "Al-Israa 80";
"discovery.card.ayah_17_80.meaning" = "En zeg: \"Mijn Heer, laat mij op een waarachtige manier binnengaan en laat mij op een waarachtige manier naar buiten gaan en verschaf mij van Uw kant een machtiging die helpt.\"";
"discovery.card.ayah_17_80.source" = "Qur’an 17:80";

"discovery.card.ayah_17_110.title" = "Al-Israa 110";
"discovery.card.ayah_17_110.meaning" = "Zeg: \"Roept Allah of roept de Erbarmer aan. Waarmee jullie ook aanroepen, Hij heeft de mooiste namen. En spreek niet luid bij je salaat en fluister daarbij ook niet, maar zoek naar een manier ertussenin.\"";
"discovery.card.ayah_17_110.source" = "Qur’an 17:110";

"discovery.card.ayah_18_10.title" = "Al-Kahf 10";
"discovery.card.ayah_18_10.meaning" = "Toen de jonge mannen in de grot een onderkomen zochten en zeiden: \"Onze Heer, geef ons van Uw kant barmhartigheid en bereid ons uit onze toestand een goede uitweg.\"";
"discovery.card.ayah_18_10.source" = "Qur’an 18:10";

"discovery.card.ayah_18_24.title" = "Al-Kahf 24";
"discovery.card.ayah_18_24.meaning" = "zonder: \"als Allah wil.\" En gedenk jouw Heer wanneer je het vergeten hebt en zeg: \"Misschien dat mijn Heer mij op het goede pad zal brengen, dat dichter bij de rechtschapenheid is dan dit\"";
"discovery.card.ayah_18_24.source" = "Qur’an 18:24";

"discovery.card.ayah_18_46.title" = "Al-Kahf 46";
"discovery.card.ayah_18_46.meaning" = "Bezit en zonen zijn de pracht van het tegenwoordige leven, maar de deugdelijke daden, die duurzaam zijn, hebben bij jouw Heer een betere beloning en een betere verwachting.";
"discovery.card.ayah_18_46.source" = "Qur’an 18:46";

"discovery.card.ayah_18_110.title" = "Al-Kahf 110";
"discovery.card.ayah_18_110.meaning" = "Zeg: \"Ik ben slechts een mens als jullie; aan mij wordt geopenbaard dat jullie god één god is. Wie dan hoopt op de ontmoeting met zijn Heer, die moet deugdelijk handelen en in de eredienst van zijn Heer niet een als metgezel [aan Hem] toevoegen.\"";
"discovery.card.ayah_18_110.source" = "Qur’an 18:110";

"discovery.card.ayah_19_4.title" = "Maryam 4";
"discovery.card.ayah_19_4.meaning" = "zei hij: \"Mijn Heer, mijn gebeente is zwak geworden in mij en mijn hoofd grijs van ouderdom. Bij het aanroepen van U, mijn Heer, ben ik nooit ongelukkig geweest.";
"discovery.card.ayah_19_4.source" = "Qur’an 19:4";

"discovery.card.ayah_19_96.title" = "Maryam 96";
"discovery.card.ayah_19_96.meaning" = "Zij die geloven en de deugdelijke daden doen, aan hen zal de Erbarmer liefde doen toekomen.";
"discovery.card.ayah_19_96.source" = "Qur’an 19:96";

"discovery.card.ayah_20_8.title" = "Taa-Haa 8";
"discovery.card.ayah_20_8.meaning" = "Allah, er is geen god dan Hij, Hem komen de mooiste namen toe.";
"discovery.card.ayah_20_8.source" = "Qur’an 20:8";

"discovery.card.ayah_20_25.title" = "Taa-Haa 25";
"discovery.card.ayah_20_25.meaning" = "Hij zei: \"Mijn Heer, stel bij mij mijn hart open,";
"discovery.card.ayah_20_25.source" = "Qur’an 20:25";

"discovery.card.ayah_20_46.title" = "Taa-Haa 46";
"discovery.card.ayah_20_46.meaning" = "Hij zei: \"Weest niet bang, Ik ben met jullie; Ik hoor en zie!";
"discovery.card.ayah_20_46.source" = "Qur’an 20:46";

"discovery.card.ayah_20_82.title" = "Taa-Haa 82";
"discovery.card.ayah_20_82.meaning" = "Maar Ik ben een vergever voor wie berouw toont, gelooft en deugdelijk handelt en zich dan op het goede pad laat brengen.";
"discovery.card.ayah_20_82.source" = "Qur’an 20:82";

"discovery.card.ayah_21_47.title" = "Al-Anbiyaa 47";
"discovery.card.ayah_21_47.meaning" = "En Wij zullen voor de opstandingsdag de eerlijke weegschalen opstellen en niemand zal in iets onrecht worden aangedaan. Al gaat het om het gewicht van een mosterdzaadje, Wij zullen het brengen; Wij zijn als afrekenaar goed genoeg.";
"discovery.card.ayah_21_47.source" = "Qur’an 21:47";

"discovery.card.ayah_21_73.title" = "Al-Anbiyaa 73";
"discovery.card.ayah_21_73.meaning" = "En Wij hebben hen tot voorgangers gemaakt die op Ons bevel de goede richting wezen en Wij hebben aan hen geopenbaard de goede daden te doen, de salaat te verrichten en de zakaat te geven. En zij dienden Ons.";
"discovery.card.ayah_21_73.source" = "Qur’an 21:73";

"discovery.card.ayah_21_92.title" = "Al-Anbiyaa 92";
"discovery.card.ayah_21_92.meaning" = "\"Deze gemeenschap van jullie is één gemeenschap en Ik ben jullie Heer; dient Mij dus.\"";
"discovery.card.ayah_21_92.source" = "Qur’an 21:92";

"discovery.card.ayah_22_77.title" = "Al-Hajj 77";
"discovery.card.ayah_22_77.meaning" = "Jullie die geloven! Buigt en buigt jullie eerbiedig neer en dient jullie Heer en doet het goede; misschien zal het jullie goed gaan. --";
"discovery.card.ayah_22_77.source" = "Qur’an 22:77";

"discovery.card.ayah_22_78.title" = "Al-Hajj 78";
"discovery.card.ayah_22_78.meaning" = "En zet jullie voor Allah in met de inzet die Hem toekomt. Hij heeft jullie verkozen en Hij heeft jullie in de godsdienst niets hinderlijks opgelegd: het geloof van jullie vader Ibrahiem. Hij heeft jullie vroeger al [mensen] die zich [aan Allah] overgegeven hebben genoemd en [nu] ook hierin, opdat de gezant getuige voor jullie zou zijn en opdat jullie getuigen voor de mensen zouden zijn. Verricht dus de salaat en geeft de zakaat en houdt jullie aan Allah vast. Hij is jullie beschermheer; een voortreffelijke beschermheer en een voortreffelijke helper.";
"discovery.card.ayah_22_78.source" = "Qur’an 22:78";

"discovery.card.ayah_23_1.title" = "Al-Muminoon 1";
"discovery.card.ayah_23_1.meaning" = "Het zal de gelovigen welgaan,";
"discovery.card.ayah_23_1.source" = "Qur’an 23:1";

"discovery.card.ayah_23_51.title" = "Al-Muminoon 51";
"discovery.card.ayah_23_51.meaning" = "\"Jullie gezanten! Eet van de goede dingen en handelt deugdelijk. Ik weet wat jullie doen.";
"discovery.card.ayah_23_51.source" = "Qur’an 23:51";

"discovery.card.ayah_23_97.title" = "Al-Muminoon 97";
"discovery.card.ayah_23_97.meaning" = "En zeg: \"Mijn Heer, ik zoek bij U bescherming tegen de ophitsingen van de satans,";
"discovery.card.ayah_23_97.source" = "Qur’an 23:97";

"discovery.card.ayah_24_22.title" = "An-Noor 22";
"discovery.card.ayah_24_22.meaning" = "Zij onder jullie die het goed en ruim hebben mogen niet zweren dat zij de verwanten, de behoeftigen en de uitgewekenen op Allahs weg niets zullen geven. Zij moeten juist vergiffenis schenken en kwijtschelden. Willen jullie ook niet graag dat Allah jullie vergeeft? Allah is vergevend en barmhartig.";
"discovery.card.ayah_24_22.source" = "Qur’an 24:22";

"discovery.card.ayah_24_31.title" = "An-Noor 31";
"discovery.card.ayah_24_31.meaning" = "En zeg tot de gelovige vrouwen dat zij hun ogen neerslaan en hun schaamstreek kuis bewaren en dat zij hun sieraad niet openlijk tonen, behalve wat gewoon al zichtbaar is. En zij moeten sluiers over hun boezem dragen en hun sieraad niet openlijk tonen, behalve aan hun echtgenoten of hun vaders of de vaders van hun echtgenoten of hun zonen of de zonen van hun echtgenoten of hun broers of de zonen van hun broers of de zonen van hun zusters of hun vrouwen of slavinnen over wie zij beschikken of mannelijke volgelingen die geen geslachtsdrift meer hebben of de kinderen die nog niet op de schaamdelen van de vrouwen letten. En zij moeten niet met hun voeten stampen zodat men weet wat zij voor verborgen sieraad dragen. En wendt jullie berouwvol tot Allah, o gelovigen; misschien zal het jullie welgaan.";
"discovery.card.ayah_24_31.source" = "Qur’an 24:31";

"discovery.card.ayah_24_37.title" = "An-Noor 37";
"discovery.card.ayah_24_37.meaning" = "mannen, die niet door koopwaar en handel afgeleid worden van het gedenken Allahs, het verrichten van de salaat en het geven van de zakaat en die een dag vrezen waarop de harten en de ogen zich omdraaien,";
"discovery.card.ayah_24_37.source" = "Qur’an 24:37";

"discovery.card.ayah_25_63.title" = "Al-Furqaan 63";
"discovery.card.ayah_25_63.meaning" = "En de dienaren van de Erbarmer zijn zij die bescheiden op de aarde rondwandelen en wanneer de onwetenden hen toespreken zeggen: \"Vrede\".";
"discovery.card.ayah_25_63.source" = "Qur’an 25:63";

"discovery.card.ayah_25_74.title" = "Al-Furqaan 74";
"discovery.card.ayah_25_74.meaning" = "En zij die zeggen: \"Onze Heer, schenk ons dat wij aan onze echtgenotes en nakomelingen vreugde beleven en maak ons tot een voorbeeld voor de godvrezenden.\"";
"discovery.card.ayah_25_74.source" = "Qur’an 25:74";

"discovery.card.ayah_26_80.title" = "Ash-Shu'araa 80";
"discovery.card.ayah_26_80.meaning" = "en wanneer ik ziek ben, dan geneest Hij mij";
"discovery.card.ayah_26_80.source" = "Qur’an 26:80";

"discovery.card.ayah_26_89.title" = "Ash-Shu'araa 89";
"discovery.card.ayah_26_89.meaning" = "Behalve wie tot Allah komt met een zuiver hart.\"";
"discovery.card.ayah_26_89.source" = "Qur’an 26:89";

"discovery.card.ayah_27_19.title" = "An-Naml 19";
"discovery.card.ayah_27_19.meaning" = "Toen glimlachte hij omdat hij om haar woorden moest lachen en zei: \"Mijn Heer, spoor mij aan dat ik voor Uw genade die U mij en mijn ouders geschonken hebt dank betuig en dat ik iets deugdelijks doe dat U bevalt en laat mij met Uw rechtschapen dienaren in Uw barmhartigheid binnengaan.\"";
"discovery.card.ayah_27_19.source" = "Qur’an 27:19";

"discovery.card.ayah_27_62.title" = "An-Naml 62";
"discovery.card.ayah_27_62.meaning" = "Of wie verhoort de in nood gezetene, als hij tot Hem bidt en neemt het kwade weg en maakt jullie tot opvolgers op de aarde. Is er naast Allah nog een god? Hoe weinig laten jullie je vermanen!";
"discovery.card.ayah_27_62.source" = "Qur’an 27:62";

"discovery.card.ayah_28_56.title" = "Al-Qasas 56";
"discovery.card.ayah_28_56.meaning" = "Jij kunt wie jij lief hebt niet op het goede pad brengen, maar Allah brengt wie Hij wil op het goede pad en Hij kent hen die het goede pad volgen het best.";
"discovery.card.ayah_28_56.source" = "Qur’an 28:56";

"discovery.card.ayah_28_77.title" = "Al-Qasas 77";
"discovery.card.ayah_28_77.meaning" = "En streef met wat Allah jou gegeven heeft naar de laatste woning en vergeet jouw aandeel aan de tegenwoordige wereld niet. Doe goed zoals Allah aan jou goed heeft gedaan en streef niet naar verderf op de aarde. Allah bemint de verderfzaaiers niet.\"";
"discovery.card.ayah_28_77.source" = "Qur’an 28:77";

"discovery.card.ayah_29_45.title" = "Al-Ankaboot 45";
"discovery.card.ayah_29_45.meaning" = "Lees voor wat aan jou van het boek is geopenbaard en verricht de salaat; de salaat verbiedt wat gruwelijk en verwerpelijk is. Maar het gedenken Allahs is geweldiger. En Allah weet wat jullie doen. *";
"discovery.card.ayah_29_45.source" = "Qur’an 29:45";

"discovery.card.ayah_29_69.title" = "Al-Ankaboot 69";
"discovery.card.ayah_29_69.meaning" = "En hen die zich voor Ons inzetten zullen Wij op Onze wegen leiden. Allah is met hen die goed doen.";
"discovery.card.ayah_29_69.source" = "Qur’an 29:69";

"discovery.card.ayah_31_12.title" = "Luqman 12";
"discovery.card.ayah_31_12.meaning" = "Wij hadden aan Loekmaan de wijsheid gegeven, dat hij aan Allah dank moest betuigen. En wie dank betuigt doet dat slechts in zijn eigen voordeel en wie ondankbaar is, Allah is behoefteloos en lofwaardig.";
"discovery.card.ayah_31_12.source" = "Qur’an 31:12";

"discovery.card.ayah_31_13.title" = "Luqman 13";
"discovery.card.ayah_31_13.meaning" = "Toen Loekmaan zijn zoon vermanend toesprak: \"Mijn zoon, bedrijf geen veelgodendienst, want veelgodendienst is een geweldig misdrijf.\"";
"discovery.card.ayah_31_13.source" = "Qur’an 31:13";

"discovery.card.ayah_31_18.title" = "Luqman 18";
"discovery.card.ayah_31_18.meaning" = "Wend je wang niet hoogmoedig van de mensen af en loop niet verwaand op de aarde rond. Allah bemint geen enkele ingebeelde en verwaande.";
"discovery.card.ayah_31_18.source" = "Qur’an 31:18";

"discovery.card.ayah_31_19.title" = "Luqman 19";
"discovery.card.ayah_31_19.meaning" = "En wees gematigd in je lopen en spreek met zachte stem. De afschuwelijkste stem is immers de stem van ezels.\"";
"discovery.card.ayah_31_19.source" = "Qur’an 31:19";

"discovery.card.ayah_32_16.title" = "As-Sajda 16";
"discovery.card.ayah_32_16.meaning" = "Zij houden zich er verre van op hun zijden op hun rustplaatsen te liggen, maar roepen hun Heer aan in vrees en begeerte en geven bijdragen van wat Wij hun voor hun levensonderhoud geven.";
"discovery.card.ayah_32_16.source" = "Qur’an 32:16";

"discovery.card.ayah_32_17.title" = "As-Sajda 17";
"discovery.card.ayah_32_17.meaning" = "En niemand weet wat voor vreugde voor hem verborgen is als beloning voor wat zij gedaan hebben.";
"discovery.card.ayah_32_17.source" = "Qur’an 32:17";

"discovery.card.ayah_33_21.title" = "Al-Ahzaab 21";
"discovery.card.ayah_33_21.meaning" = "Jullie hebben toch in Allahs gezant een goed voorbeeld voor wie op Allah en de laatste dag hopen en Allah veel gedenken.";
"discovery.card.ayah_33_21.source" = "Qur’an 33:21";

"discovery.card.ayah_33_35.title" = "Al-Ahzaab 35";
"discovery.card.ayah_33_35.meaning" = "De mannen en vrouwen die zich [aan Allah] hebben overgegeven, de gelovige mannen en vrouwen, de onderdanige mannen en vrouwen, de oprechte mannen en vrouwen, de geduldig volhardende mannen en vrouwen, de deemoedige mannen en vrouwen, de mannen en vrouwen die aalmoezen geven, de mannen en vrouwen die vasten, de mannen en vrouwen die hun schaamstreek kuis bewaren, de mannen en vrouwen die Allah veel gedenken, voor hen heeft Allah vergeving en een geweldig loon klaargemaakt.";
"discovery.card.ayah_33_35.source" = "Qur’an 33:35";

"discovery.card.ayah_33_41.title" = "Al-Ahzaab 41";
"discovery.card.ayah_33_41.meaning" = "Jullie die geloven! Gedenkt Allah veelvuldig";
"discovery.card.ayah_33_41.source" = "Qur’an 33:41";

"discovery.card.ayah_33_56.title" = "Al-Ahzaab 56";
"discovery.card.ayah_33_56.meaning" = "Allah en Zijn engelen zegenen de profeet. Jullie die geloven! Zegent hem en groet hem door hem vrede toe te wensen.";
"discovery.card.ayah_33_56.source" = "Qur’an 33:56";

"discovery.card.ayah_33_70.title" = "Al-Ahzaab 70";
"discovery.card.ayah_33_70.meaning" = "Jullie die geloven! Vreest Allah en spreekt passende woorden,";
"discovery.card.ayah_33_70.source" = "Qur’an 33:70";

"discovery.card.ayah_35_10.title" = "Faatir 10";
"discovery.card.ayah_35_10.meaning" = "Als iemand de macht wenst? welnu de macht behoort Allah geheel toe. Tot Hem stijgen de goede woorden op en Hij verheft de deugdzame daad. Maar voor hen die de slechte daden beramen is er een strenge bestraffing; de list van hen gaat verloren.";
"discovery.card.ayah_35_10.source" = "Qur’an 35:10";

"discovery.card.ayah_35_28.title" = "Faatir 28";
"discovery.card.ayah_35_28.meaning" = "Ook bij de mensen en bij de dieren en het vee zijn er zo verschillende kleuren en soorten. Allah wordt slechts gevreesd door de geleerden onder Zijn dienaren. Allah is machtig en vergevend.";
"discovery.card.ayah_35_28.source" = "Qur’an 35:28";

"discovery.card.ayah_36_1.title" = "Yaseen 1";
"discovery.card.ayah_36_1.meaning" = "J[aa?] S[ien].";
"discovery.card.ayah_36_1.source" = "Qur’an 36:1";

"discovery.card.ayah_36_22.title" = "Yaseen 22";
"discovery.card.ayah_36_22.meaning" = "En waarom zou ik niet Hem dienen die mij geschapen heeft en tot wie jullie teruggebracht zullen worden?";
"discovery.card.ayah_36_22.source" = "Qur’an 36:22";

"discovery.card.ayah_36_58.title" = "Yaseen 58";
"discovery.card.ayah_36_58.meaning" = "\"Vrede!\"is [voor hen] een [welkomst]woord dat van een barmhartige Heer komt.";
"discovery.card.ayah_36_58.source" = "Qur’an 36:58";

"discovery.card.ayah_37_96.title" = "As-Saaffaat 96";
"discovery.card.ayah_37_96.meaning" = "Maar Allah heeft jullie en wat jullie maken geschapen.\"";
"discovery.card.ayah_37_96.source" = "Qur’an 37:96";

"discovery.card.ayah_38_29.title" = "Saad 29";
"discovery.card.ayah_38_29.meaning" = "[De Koran] is een gezegend boek dat Wij naar jou hebben neergezonden, opdat zij de verzen ervan overdenken en opdat de verstandigen zich laten vermanen.";
"discovery.card.ayah_38_29.source" = "Qur’an 38:29";

"discovery.card.ayah_39_9.title" = "Az-Zumar 9";
"discovery.card.ayah_39_9.meaning" = "Is iemand die gedurende de nacht onderdanigheid toont, terwijl hij zich eerbiedig neerbuigt en opstaat, op zijn hoede is voor het hiernamaals en op de barmhartigheid van Zijn Heer hoopt?? Zeg: \"Zijn zij die weten en zij die niet weten gelijk? Slechts de verstandigen laten zich vermanen.\"";
"discovery.card.ayah_39_9.source" = "Qur’an 39:9";

"discovery.card.ayah_39_10.title" = "Az-Zumar 10";
"discovery.card.ayah_39_10.meaning" = "Zeg: \"Mijn dienaren, die gelovig zijn! Vreest jullie Heer. Voor hen die in dit tegenwoordige leven goed doen is er iets goeds en Allahs aarde is wijd. Maar aan hen die geduldig volharden zal hun volle loon gegeven worden, zonder afrekening.\"";
"discovery.card.ayah_39_10.source" = "Qur’an 39:10";

"discovery.card.ayah_39_36.title" = "Az-Zumar 36";
"discovery.card.ayah_39_36.meaning" = "Is Allah niet goed genoeg voor Zijn dienaar? En zij willen jou bang maken met hen die er in plaats van Hem zouden zijn. En als Allah iemand tot dwaling brengt, dan is er voor hem niemand die de goede richting wijst.";
"discovery.card.ayah_39_36.source" = "Qur’an 39:36";

"discovery.card.ayah_40_60.title" = "Ghafir 60";
"discovery.card.ayah_40_60.meaning" = "En jullie Heer zegt: \"Roept Mij aan, dan zal Ik jullie verhoren. Zij die te hoogmoedig zijn om Mij te dienen zullen onderdanig de hel binnengaan.\"";
"discovery.card.ayah_40_60.source" = "Qur’an 40:60";

"discovery.card.ayah_40_65.title" = "Ghafir 65";
"discovery.card.ayah_40_65.meaning" = "Hij is de levende, er is geen god dan Hij. Roept Hem dus aan terwijl jullie de godsdienst geheel aan Hem wijden. Lof zij Allah, de Heer van de wereldbewoners. *";
"discovery.card.ayah_40_65.source" = "Qur’an 40:65";

"discovery.card.ayah_41_30.title" = "Fussilat 30";
"discovery.card.ayah_41_30.meaning" = "Maarzij die zeggen: \"Onze Heer is Allah\" en die dan correct handelen, tot hen komen de engelen neer: \"Vreest niet en weest niet bedroefd, maar verheugt jullie in de tuin die jullie is toegezegd.";
"discovery.card.ayah_41_30.source" = "Qur’an 41:30";

"discovery.card.ayah_41_33.title" = "Fussilat 33";
"discovery.card.ayah_41_33.meaning" = "En wie spreekt er beter dan wie tot Allah oproept, deugdelijk handelt en zegt: \"Ik behoor tot hen die zich [aan Allah] overgeven.\"";
"discovery.card.ayah_41_33.source" = "Qur’an 41:33";

"discovery.card.ayah_41_34.title" = "Fussilat 34";
"discovery.card.ayah_41_34.meaning" = "En de goede daad en de slechte daad zijn niet gelijk; weer die af met iets wat beter is. Dan zal hij, tussen wie en jou vijandschap was, zijn als een boezemvriend.";
"discovery.card.ayah_41_34.source" = "Qur’an 41:34";

"discovery.card.ayah_42_13.title" = "Ash-Shura 13";
"discovery.card.ayah_42_13.meaning" = "Hij verordineert voor jullie van de godsdienst wat Hij aan Noeh had opgedragen en wat Wij aan jou geopenbaard hebben en wat Wij aan Ibrahiem, Moesa en 'Isa hadden opgedragen: Houdt de godsdienst in stand en splitst jullie daarin niet op in groepen. De veelgodendienaars vinden het erg waartoe jij hen oproept. Allah verkiest daartoe wie Hij wil en wijst wie schuldbewust is er de goede richting heen.";
"discovery.card.ayah_42_13.source" = "Qur’an 42:13";

"discovery.card.ayah_42_19.title" = "Ash-Shura 19";
"discovery.card.ayah_42_19.meaning" = "Allah is zachtmoedig voor Zijn dienaren, Hij voorziet wie Hij wil, en Hij is de sterke, de almachtige.";
"discovery.card.ayah_42_19.source" = "Qur’an 42:19";

"discovery.card.ayah_42_36.title" = "Ash-Shura 36";
"discovery.card.ayah_42_36.meaning" = "Wat jullie ook gegeven is, het is het genot van het tegenwoordige leven, maar wat van Allah komt is beter en onvergankelijker voor hen die geloven en hun vertrouwen op hun Heer stellen";
"discovery.card.ayah_42_36.source" = "Qur’an 42:36";

"discovery.card.ayah_43_36.title" = "Az-Zukhruf 36";
"discovery.card.ayah_43_36.meaning" = "En wie zich voor de vermaning van de Erbarmer blind houdt, voor hem maken Wij een satan die dan een kameraad voor hem is --";
"discovery.card.ayah_43_36.source" = "Qur’an 43:36";

"discovery.card.ayah_44_3.title" = "Ad-Dukhaan 3";
"discovery.card.ayah_44_3.meaning" = "Wij hebben het in een gezegende nacht neergezonden -- Wij hebben steeds gewaarschuwd --";
"discovery.card.ayah_44_3.source" = "Qur’an 44:3";

"discovery.card.ayah_45_15.title" = "Al-Jaathiya 15";
"discovery.card.ayah_45_15.meaning" = "Als iemand deugdelijk handelt is het in zijn eigen voordeel, maar als iemand verkeerd doet dan is het in zijn nadeel. Voorts zullen jullie tot jullie Heer worden teruggebracht.";
"discovery.card.ayah_45_15.source" = "Qur’an 45:15";

"discovery.card.ayah_46_13.title" = "Al-Ahqaf 13";
"discovery.card.ayah_46_13.meaning" = "Zij die zeggen: \"Onze Heer is Allah\" en die dan correct handelen hebben niets te vrezen noch zullen zij bedroefd zijn.";
"discovery.card.ayah_46_13.source" = "Qur’an 46:13";

"discovery.card.ayah_46_15.title" = "Al-Ahqaf 15";
"discovery.card.ayah_46_15.meaning" = "En Wij hebben de mens opgedragen zijn ouders goed te behandelen -- zijn moeder heeft hem immers moeizaam gedragen en moeizaam gebaard. De zwangerschap en [de tijd erna] totdat hij gespeend wordt is dertig maanden. En wanneer hij dan volgroeid is en veertig jaar wordt zegt hij: \"Mijn Heer, spoor mij aan dat ik voor Uw genade, die U mij en mijn ouders geschonken hebt, dank betuig en dat ik iets deugdelijks doe wat U bevalt. En maak voor mij dat mijn nageslacht deugdzaam is. Ik wend mij berouwvol tot U en ik behoor bij hen die zich [aan Allah] overgeven.\"";
"discovery.card.ayah_46_15.source" = "Qur’an 46:15";

"discovery.card.ayah_47_7.title" = "Muhammad 7";
"discovery.card.ayah_47_7.meaning" = "Jullie die geloven! Als jullie Allah helpen dan zal Hij jullie helpen en jullie voeten stevig maken.";
"discovery.card.ayah_47_7.source" = "Qur’an 47:7";

"discovery.card.ayah_47_19.title" = "Muhammad 19";
"discovery.card.ayah_47_19.meaning" = "Weet dan dat er geen god is dan Allah en vraag om vergeving voor jouw zonden en voor de gelovige mannen en vrouwen. En Allah kent jullie rondtrekken en jullie verblijfplaats.";
"discovery.card.ayah_47_19.source" = "Qur’an 47:19";

"discovery.card.ayah_48_1.title" = "Al-Fath 1";
"discovery.card.ayah_48_1.meaning" = "Wij hebben jou een duidelijk succes laten behalen,";
"discovery.card.ayah_48_1.source" = "Qur’an 48:1";

"discovery.card.ayah_48_29.title" = "Al-Fath 29";
"discovery.card.ayah_48_29.meaning" = "Mohammed is de gezant van Allah. En zij die met hem zijn zijn streng tegen de ongelovigen, maar onderling barmhartig. Jij ziet hen buigen en zich eerbiedig neerbuigen in hun streven naar goedgunstigheid van Allah en welgevallen. Hun kenteken is op hun gezicht als gevolg van het zich eerbiedig neerbuigen. Zo worden zij gekenschetst in de Taura en in de Indjiel worden zij gekenschetst als zaad dat zijn loten laat ontspruiten en dan sterker laat worden. Dan worden zij dikker en staan stevig op hun stengels zodat zij de zaaiers bevallen. Zo wil Hij door hen de ongelovigen woedend maken. Allah heeft degenen onder hen die geloven en de deugdelijke daden doen vergeving toegezegd en een geweldig loon.";
"discovery.card.ayah_48_29.source" = "Qur’an 48:29";

"discovery.card.ayah_49_10.title" = "Al-Hujuraat 10";
"discovery.card.ayah_49_10.meaning" = "De gelovigen zijn immers broeders. Sticht dus vrede tussen jullie beide broeders en vreest Allah; misschien zal aan jullie barmhartigheid bewezen worden.";
"discovery.card.ayah_49_10.source" = "Qur’an 49:10";

"discovery.card.ayah_49_11.title" = "Al-Hujuraat 11";
"discovery.card.ayah_49_11.meaning" = "Jullie die geloven! Mensen moeten elkaar niet belachelijk maken. Misschien zijn zij juist beter dan zij! En ook vrouwen moeten dat niet doen. Misschien zijn zij juist beter dan zij! En maakt geen aanmerkingen op elkaar en geeft elkaar geen scheldnamen. Schandelijkheid, dat is pas een slechte naam, nadat het geloof is aangenomen. En wie geen berouw tonen, dat zijn dan de onrechtplegers.";
"discovery.card.ayah_49_11.source" = "Qur’an 49:11";

"discovery.card.ayah_51_19.title" = "Adh-Dhaariyat 19";
"discovery.card.ayah_51_19.meaning" = "en een rechtmatig aandeel in hun bezittingen was voor de bedelaar en de onbemiddelde.";
"discovery.card.ayah_51_19.source" = "Qur’an 51:19";

"discovery.card.ayah_51_56.title" = "Adh-Dhaariyat 56";
"discovery.card.ayah_51_56.meaning" = "Ik heb de mensen en de djinn slechts geschapen om Mij te dienen.";
"discovery.card.ayah_51_56.source" = "Qur’an 51:56";

"discovery.card.ayah_52_21.title" = "At-Tur 21";
"discovery.card.ayah_52_21.meaning" = "En het nageslacht van hen die geloven en die in hun geloof door hun nageslacht gevolgd worden hebben Wij bij hen gevoegd. En Wij laten hen voor wat zij gedaan hebben in niets tekortkomen. Elke man is aansprakelijk voor wat hij begaan heeft.";
"discovery.card.ayah_52_21.source" = "Qur’an 52:21";

"discovery.card.ayah_53_32.title" = "An-Najm 32";
"discovery.card.ayah_53_32.meaning" = "die de grote zonden en gruwelijkheden vermijden, afgezien dan van kleine overtredingen; jouw Heer is alomvattend in Zijn vergeving. Hij kent jullie het best; toen Hij jullie uit de aarde liet ontstaan en toen jullie nog ongeboren in de buik van jullie moeders waren. Zeg dan niet van jullie zelf dat jullie gelouterd zijn; Hij weet het best wie godvrezend is.";
"discovery.card.ayah_53_32.source" = "Qur’an 53:32";

"discovery.card.ayah_53_39.title" = "An-Najm 39";
"discovery.card.ayah_53_39.meaning" = "Dat de mens slechts krijgt wat hij heeft nagejaagd.";
"discovery.card.ayah_53_39.source" = "Qur’an 53:39";

"discovery.card.ayah_54_17.title" = "Al-Qamar 17";
"discovery.card.ayah_54_17.meaning" = "Wij hebben de Koran toch gemakkelijk gemaakt om erdoor vermaand te worden; maar is er dan iemand die zich laat vermanen?";
"discovery.card.ayah_54_17.source" = "Qur’an 54:17";

"discovery.card.ayah_55_1.title" = "Ar-Rahmaan 1";
"discovery.card.ayah_55_1.meaning" = "De Erbarmer,";
"discovery.card.ayah_55_1.source" = "Qur’an 55:1";

"discovery.card.ayah_55_46.title" = "Ar-Rahmaan 46";
"discovery.card.ayah_55_46.meaning" = "Maar voor wie vreest om voor zijn Heer te staan zijn er twee tuinen.";
"discovery.card.ayah_55_46.source" = "Qur’an 55:46";

"discovery.card.ayah_56_10.title" = "Al-Waaqia 10";
"discovery.card.ayah_56_10.meaning" = "Maar de eerstgekomenen zijn het eerst gekomen;";
"discovery.card.ayah_56_10.source" = "Qur’an 56:10";

"discovery.card.ayah_57_16.title" = "Al-Hadid 16";
"discovery.card.ayah_57_16.meaning" = "Is het voor hen die geloven niet tijd dat hun harten zich verootmoedigen voor Allahs vermaning en wat Hij van de waarheid heeft neergezonden? En weest niet zoals zij aan wie het boek vroeger al gegeven was. De tijd duurde hun toen te lang, hun harten verhardden zich en velen van hen werden verdorven.";
"discovery.card.ayah_57_16.source" = "Qur’an 57:16";

"discovery.card.ayah_57_20.title" = "Al-Hadid 20";
"discovery.card.ayah_57_20.meaning" = "Weet dat het tegenwoordige leven slechts spel en tijdverdrijf, pracht en onderling gepraal en streven naar meer bezittingen en kinderen is. Het is bijvoorbeeld als met regen; de plantengroei die ervan komt bevalt de ongelovigen. Dan verdort het en jij ziet het geel worden en dan wordt het tot gruis. En in het hiernamaals is er een strenge bestraffing en barmhartigheid van Allah en welbehagen. Het tegenwoordige leven is slechts begoochelend genot.";
"discovery.card.ayah_57_20.source" = "Qur’an 57:20";

"discovery.card.ayah_57_21.title" = "Al-Hadid 21";
"discovery.card.ayah_57_21.meaning" = "Spoedt dus voort naar vergeving van jullie Heer en naar een tuin zo breed als de breedte van de hemel en de aarde, die klaargemaakt is voor hen die in Allah en Zijn gezanten geloven. Dat is Allahs goedgunstigheid die Hij geeft aan wie Hij wil. Allah is vol van geweldige goedgunstigheid.";
"discovery.card.ayah_57_21.source" = "Qur’an 57:21";

"discovery.card.ayah_58_11.title" = "Al-Mujaadila 11";
"discovery.card.ayah_58_11.meaning" = "Jullie die geloven! Wanneer men tot jullie zegt: \"Maakt plaats bij de samenkomsten\" maakt dan plaats opdat Allah voor jullie plaats maakt. En wanneer men tot jullie zegt: \"Staat op\" staat dan op, opdat Allah aan hen die uit jullie midden geloven en aan wie de kennis is gegeven hogere rangen geeft. Allah is welingelicht over wat jullie doen.";
"discovery.card.ayah_58_11.source" = "Qur’an 58:11";

"discovery.card.ayah_59_9.title" = "Al-Hashr 9";
"discovery.card.ayah_59_9.meaning" = "En zij die al eerder dan zij in de woning gevestigd en in het geloof bevestigd waren beminnen hen die naar hen uitgeweken zijn; zij ondervinden in hun binnenste geen behoefte aan wat hun gegeven wordt en zij verkiezen hen boven zichzelf ook al hebben zij zelf gebrek. En wie voor de eigen hebzucht behoed worden, zij zijn het die het welgaat.";
"discovery.card.ayah_59_9.source" = "Qur’an 59:9";

"discovery.card.ayah_59_18.title" = "Al-Hashr 18";
"discovery.card.ayah_59_18.meaning" = "Jullie die geloven! Vreest Allah en ieder moet bekijken wat hij voor de dag van morgen voorbereidt. En vreest Allah, want Allah is welingelicht over wat jullie doen.";
"discovery.card.ayah_59_18.source" = "Qur’an 59:18";

"discovery.card.ayah_59_22.title" = "Al-Hashr 22";
"discovery.card.ayah_59_22.meaning" = "Hij is Allah; er is geen god dan Hij, de kenner van het verborgene en het waarneembare, de erbarmer, de barmhartige.";
"discovery.card.ayah_59_22.source" = "Qur’an 59:22";

"discovery.card.ayah_61_2.title" = "As-Saff 2";
"discovery.card.ayah_61_2.meaning" = "Jullie die geloven! Waarom zeggen jullie wat jullie niet doen.";
"discovery.card.ayah_61_2.source" = "Qur’an 61:2";

"discovery.card.ayah_61_10.title" = "As-Saff 10";
"discovery.card.ayah_61_10.meaning" = "Jullie die geloven! Zal ik jullie op een handel wijzen die jullie van een pijnlijke bestraffing redt?";
"discovery.card.ayah_61_10.source" = "Qur’an 61:10";

"discovery.card.ayah_61_13.title" = "As-Saff 13";
"discovery.card.ayah_61_13.meaning" = "En nog iets anders wat jullie graag willen: hulp van Allah en een spoedig succes. Verkondig het goede nieuws aan de gelovigen.";
"discovery.card.ayah_61_13.source" = "Qur’an 61:13";

"discovery.card.ayah_62_9.title" = "Al-Jumu'a 9";
"discovery.card.ayah_62_9.meaning" = "Jullie die geloven! Wanneer jullie tot de salaat op de vrijdag [als de dag van de samenkomst] worden opgeroepen, haast jullie dan om Allah te gedenken en laat het zakendoen. Dat is beter voor jullie, als jullie dat maar wisten.";
"discovery.card.ayah_62_9.source" = "Qur’an 62:9";

"discovery.card.ayah_62_10.title" = "Al-Jumu'a 10";
"discovery.card.ayah_62_10.meaning" = "En wanneer de salaat beëindigd is, gaat dan weer uit elkaar het land in, streeft naar Allahs gunst en gedenk Allah veel; misschien zal het jullie welgaan.";
"discovery.card.ayah_62_10.source" = "Qur’an 62:10";

"discovery.card.ayah_63_9.title" = "Al-Munaafiqoon 9";
"discovery.card.ayah_63_9.meaning" = "Jullie die geloven! Jullie bezittingen en jullie kinderen moeten jullie er niet van afleiden Allah te gedenken. Wie dat doen, dat zijn dus de verliezers.";
"discovery.card.ayah_63_9.source" = "Qur’an 63:9";

"discovery.card.ayah_64_16.title" = "At-Taghaabun 16";
"discovery.card.ayah_64_16.meaning" = "Vreest dus Allah zo goed als jullie kunnen en luistert, gehoorzaamt en geeft bijdragen; dat is beter voor jullie zelf. En wie voor de eigen hebzucht behoed worden, dat zijn zij die het welgaat.";
"discovery.card.ayah_64_16.source" = "Qur’an 64:16";

"discovery.card.ayah_65_4.title" = "At-Talaaq 4";
"discovery.card.ayah_65_4.meaning" = "En die vrouwen van jullie die niet meer op de menstruatie hopen hebben, als jullie twijfelen, een wachttijd van drie maanden en ook zij die nog niet gemenstrueerd hebben. En voor de zwangeren is haar termijn dat zij baren waarvan zij zwanger zijn. En voor hem die Allah vreest zal Hij de omstandigheden gemakkelijker maken.";
"discovery.card.ayah_65_4.source" = "Qur’an 65:4";

"discovery.card.ayah_66_8.title" = "At-Tahrim 8";
"discovery.card.ayah_66_8.meaning" = "Jullie die geloven! Wendt jullie met oprecht berouw tot Allah, misschien dat jullie Heer jullie slechte daden zal verzoenen en jullie tuinen zal laten binnengaan waar de rivieren onderdoor stromen, op de dag dat Allah de profeet en hen die met hem geloven niet te schande zal maken; hun licht schijnt voor hen en rechts van hen, terwijl zij zeggen: \"Onze Heer vervolmaak ons licht voor ons en schenk ons vergeving. U bent almachtig.\"";
"discovery.card.ayah_66_8.source" = "Qur’an 66:8";

"discovery.card.ayah_67_1.title" = "Al-Mulk 1";
"discovery.card.ayah_67_1.meaning" = "Gezegend zij Hij in wiens hand de heerschappij is en Hij is almachtig.";
"discovery.card.ayah_67_1.source" = "Qur’an 67:1";

"discovery.card.ayah_67_14.title" = "Al-Mulk 14";
"discovery.card.ayah_67_14.meaning" = "Zou Hij hen die Hij geschapen heeft niet kennen; Hij is de welwillende, de welingelichte.";
"discovery.card.ayah_67_14.source" = "Qur’an 67:14";

"discovery.card.ayah_67_15.title" = "Al-Mulk 15";
"discovery.card.ayah_67_15.meaning" = "Hij is het die de aarde voor jullie handelbaar gemaakt heeft. Wandelt dus over haar rug en eet van het levensonderhoud dat Hij geeft. En de herrijzenis voert naar Hem.";
"discovery.card.ayah_67_15.source" = "Qur’an 67:15";

"discovery.card.ayah_68_4.title" = "Al-Qalam 4";
"discovery.card.ayah_68_4.meaning" = "en jij bent hoogstaand van karakter.";
"discovery.card.ayah_68_4.source" = "Qur’an 68:4";

"discovery.card.ayah_70_19.title" = "Al-Ma'aarij 19";
"discovery.card.ayah_70_19.meaning" = "De mens is vreesachtig geschapen.";
"discovery.card.ayah_70_19.source" = "Qur’an 70:19";

"discovery.card.ayah_73_20.title" = "Al-Muzzammil 20";
"discovery.card.ayah_73_20.meaning" = "Jouw Heer weet dat jij bijna tweederde van de nacht opblijft, of de helft, of een derde, samen met een groep van hen die bij jou horen. Allah bepaalt de maat van de nacht en de dag. Hij weet dat jullie het niet kunnen en heeft zich genadig tot jullie gewend. Leest dus uit de Koran een gemakkelijk gedeelte voor. Hij weet dat er onder jullie zieken zullen zijn en anderen die op de aarde rondtrekken om naar Allahs gunst te streven en anderen die op Allahs weg strijden. Leest er dus een gemakkelijk gedeelte uit voor, verricht de salaat, geeft de zakaat en geeft aan Allah een goede lening. En wat jullie eerder aan goeds gedaan hebben voor jullie zelf, dat zullen jullie bij Allah als nog beter en geweldiger beloond vinden. En vraagt Allah om vergeving; Allah is vergevend en barmhartig.";
"discovery.card.ayah_73_20.source" = "Qur’an 73:20";

"discovery.card.ayah_74_3.title" = "Al-Muddaththir 3";
"discovery.card.ayah_74_3.meaning" = "Jouw Heer, verheerlijk Hem.";
"discovery.card.ayah_74_3.source" = "Qur’an 74:3";

"discovery.card.ayah_76_8.title" = "Al-Insaan 8";
"discovery.card.ayah_76_8.meaning" = "En zij geven, hoe lief zij het ook hebben, voedsel aan behoeftige, wees en gevangene.";
"discovery.card.ayah_76_8.source" = "Qur’an 76:8";

"discovery.card.ayah_76_9.title" = "Al-Insaan 9";
"discovery.card.ayah_76_9.meaning" = "\"Wij geven jullie voedsel ter wille van Allah; Wij wensen van jullie geen loon of dank.";
"discovery.card.ayah_76_9.source" = "Qur’an 76:9";

"discovery.card.ayah_87_1.title" = "Al-A'laa 1";
"discovery.card.ayah_87_1.meaning" = "Prijs de naam van jouw Heer, de hoogste,";
"discovery.card.ayah_87_1.source" = "Qur’an 87:1";

"discovery.card.ayah_87_14.title" = "Al-A'laa 14";
"discovery.card.ayah_87_14.meaning" = "Maar welgaan zal het wie zich loutert,";
"discovery.card.ayah_87_14.source" = "Qur’an 87:14";

"discovery.card.ayah_89_27.title" = "Al-Fajr 27";
"discovery.card.ayah_89_27.meaning" = "\"O ziel die rust gevonden heeft,";
"discovery.card.ayah_89_27.source" = "Qur’an 89:27";

"discovery.card.ayah_89_28.title" = "Al-Fajr 28";
"discovery.card.ayah_89_28.meaning" = "keer tevreden en met welgevallen aanvaard terug naar jouw Heer.";
"discovery.card.ayah_89_28.source" = "Qur’an 89:28";

"discovery.card.ayah_90_12.title" = "Al-Balad 12";
"discovery.card.ayah_90_12.meaning" = "En hoe kom jij te weten wat de steile weg is?";
"discovery.card.ayah_90_12.source" = "Qur’an 90:12";

"discovery.card.ayah_90_13.title" = "Al-Balad 13";
"discovery.card.ayah_90_13.meaning" = "Vrijlating van een slaaf";
"discovery.card.ayah_90_13.source" = "Qur’an 90:13";

"discovery.card.ayah_91_9.title" = "Ash-Shams 9";
"discovery.card.ayah_91_9.meaning" = "Wel gaat het wie haar loutert.";
"discovery.card.ayah_91_9.source" = "Qur’an 91:9";

"discovery.card.ayah_92_5.title" = "Al-Lail 5";
"discovery.card.ayah_92_5.meaning" = "Hij dan die geeft en godvrezend is";
"discovery.card.ayah_92_5.source" = "Qur’an 92:5";

"discovery.card.ayah_92_18.title" = "Al-Lail 18";
"discovery.card.ayah_92_18.meaning" = "hij die zijn bezit gegeven heeft om zich te louteren";
"discovery.card.ayah_92_18.source" = "Qur’an 92:18";

"discovery.card.ayah_93_5.title" = "Ad-Dhuhaa 5";
"discovery.card.ayah_93_5.meaning" = "Jouw Heer zal jou zeker geven en dan ben jij voldaan.";
"discovery.card.ayah_93_5.source" = "Qur’an 93:5";

"discovery.card.ayah_93_6.title" = "Ad-Dhuhaa 6";
"discovery.card.ayah_93_6.meaning" = "Heeft Hij jou niet als wees gevonden en onderdak gegeven?";
"discovery.card.ayah_93_6.source" = "Qur’an 93:6";

"discovery.card.ayah_93_7.title" = "Ad-Dhuhaa 7";
"discovery.card.ayah_93_7.meaning" = "Jou dwalend gevonden en jou de weg gewezen?";
"discovery.card.ayah_93_7.source" = "Qur’an 93:7";

"discovery.card.ayah_93_8.title" = "Ad-Dhuhaa 8";
"discovery.card.ayah_93_8.meaning" = "Jou behoeftig gevonden en rijk gemaakt?";
"discovery.card.ayah_93_8.source" = "Qur’an 93:8";

"discovery.card.ayah_93_10.title" = "Ad-Dhuhaa 10";
"discovery.card.ayah_93_10.meaning" = "De bedelaar, verjaag hem niet.";
"discovery.card.ayah_93_10.source" = "Qur’an 93:10";

"discovery.card.ayah_93_11.title" = "Ad-Dhuhaa 11";
"discovery.card.ayah_93_11.meaning" = "En de genade van jouw Heer, vertel daarvan!";
"discovery.card.ayah_93_11.source" = "Qur’an 93:11";

"discovery.card.ayah_94_6.title" = "Ash-Sharh 6";
"discovery.card.ayah_94_6.meaning" = "Ja, met het moeilijke hangt het gemakkelijke samen!";
"discovery.card.ayah_94_6.source" = "Qur’an 94:6";

"discovery.card.ayah_94_7.title" = "Ash-Sharh 7";
"discovery.card.ayah_94_7.meaning" = "En wanneer je klaar bent span je dan in";
"discovery.card.ayah_94_7.source" = "Qur’an 94:7";

"discovery.card.ayah_94_8.title" = "Ash-Sharh 8";
"discovery.card.ayah_94_8.meaning" = "en richt je verlangen tot jouw Heer.";
"discovery.card.ayah_94_8.source" = "Qur’an 94:8";

"discovery.card.ayah_95_4.title" = "At-Tin 4";
"discovery.card.ayah_95_4.meaning" = "Wij hebben de mens in de mooiste gestalte geschapen.";
"discovery.card.ayah_95_4.source" = "Qur’an 95:4";

"discovery.card.ayah_96_1.title" = "Al-Alaq 1";
"discovery.card.ayah_96_1.meaning" = "Lees voor in de naam van jouw Heer die heeft geschapen.";
"discovery.card.ayah_96_1.source" = "Qur’an 96:1";

"discovery.card.ayah_96_5.title" = "Al-Alaq 5";
"discovery.card.ayah_96_5.meaning" = "Hij heeft de mens onderwezen wat hij niet wist.";
"discovery.card.ayah_96_5.source" = "Qur’an 96:5";

"discovery.card.ayah_97_1.title" = "Al-Qadr 1";
"discovery.card.ayah_97_1.meaning" = "Wij hebben hem neergezonden in de nacht van de beslissing.";
"discovery.card.ayah_97_1.source" = "Qur’an 97:1";

"discovery.card.ayah_97_5.title" = "Al-Qadr 5";
"discovery.card.ayah_97_5.meaning" = "Vol vrede is hij tot aan de opkomst van de dageraad.";
"discovery.card.ayah_97_5.source" = "Qur’an 97:5";

"discovery.card.ayah_99_7.title" = "Az-Zalzala 7";
"discovery.card.ayah_99_7.meaning" = "En wie ook maar een greintje goeds heeft gedaan die zal het zien.";
"discovery.card.ayah_99_7.source" = "Qur’an 99:7";

"discovery.card.ayah_99_8.title" = "Az-Zalzala 8";
"discovery.card.ayah_99_8.meaning" = "En wie ook maar een greintje kwaads heeft gedaan die zal het zien.";
"discovery.card.ayah_99_8.source" = "Qur’an 99:8";

"discovery.card.ayah_102_1.title" = "At-Takaathur 1";
"discovery.card.ayah_102_1.meaning" = "De wens naar meer houdt jullie zozeer bezig,";
"discovery.card.ayah_102_1.source" = "Qur’an 102:1";

"discovery.card.ayah_102_8.title" = "At-Takaathur 8";
"discovery.card.ayah_102_8.meaning" = "Dan zullen jullie op die dag ondervraagd worden over het geluk.";
"discovery.card.ayah_102_8.source" = "Qur’an 102:8";

"discovery.card.ayah_103_3.title" = "Al-Asr 3";
"discovery.card.ayah_103_3.meaning" = "Alleen niet zij die geloven en de deugdelijke daden doen, die elkaar aanmanen tot de waarheid en die elkaar aanmanen tot volharding.";
"discovery.card.ayah_103_3.source" = "Qur’an 103:3";

"discovery.card.ayah_107_1.title" = "Al-Maa'un 1";
"discovery.card.ayah_107_1.meaning" = "Heb jij hem gezien die de godsdienst loochent?";
"discovery.card.ayah_107_1.source" = "Qur’an 107:1";

"discovery.card.ayah_107_4.title" = "Al-Maa'un 4";
"discovery.card.ayah_107_4.meaning" = "En wee hen die de salaat bidden";
"discovery.card.ayah_107_4.source" = "Qur’an 107:4";

"discovery.card.ayah_110_1.title" = "An-Nasr 1";
"discovery.card.ayah_110_1.meaning" = "Wanneer Allahs hulp komt en het succes";
"discovery.card.ayah_110_1.source" = "Qur’an 110:1";

"discovery.card.ayah_110_3.title" = "An-Nasr 3";
"discovery.card.ayah_110_3.meaning" = "prijs dan de lof van jouw Heer en vraag Hem om vergeving; Hij is een genadegever.";
"discovery.card.ayah_110_3.source" = "Qur’an 110:3";

"discovery.card.ayah_112_2.title" = "Al-Ikhlaas 2";
"discovery.card.ayah_112_2.meaning" = "Allah de bestendige.";
"discovery.card.ayah_112_2.source" = "Qur’an 112:2";

"discovery.card.ayah_112_3.title" = "Al-Ikhlaas 3";
"discovery.card.ayah_112_3.meaning" = "Hij heeft niet verwekt en is niet verwekt";
"discovery.card.ayah_112_3.source" = "Qur’an 112:3";

"discovery.card.ayah_112_4.title" = "Al-Ikhlaas 4";
"discovery.card.ayah_112_4.meaning" = "en niet één is er aan Hem gelijkwaardig.\"";
"discovery.card.ayah_112_4.source" = "Qur’an 112:4";

"discovery.card.sunnah_bukhari_10.title" = "Sahih al-Boekhari 10";
"discovery.card.sunnah_bukhari_10.meaning" = "Overgeleverd door 'Abdullah bin 'Amr: De Profeet (ﷺ) zei: \"Een moslim is degene die vermijdt moslims kwaad te doen met zijn tong en handen. En een Muhajir (emigrant) is degene die alles opgeeft (achterlaat) wat Allah heeft verboden.\"";
"discovery.card.sunnah_bukhari_10.source" = "Sahih al-Bukhari 10";

"discovery.card.sunnah_bukhari_11.title" = "Sahih al-Boekhari 11";
"discovery.card.sunnah_bukhari_11.meaning" = "Overgeleverd door Abu Musa: Sommige mensen vroegen de Boodschapper van Allah (ﷺ): \"Wiens islam is het beste? Dat wil zeggen: (Wie is een zeer goede moslim)?\" Hij antwoordde: \"Degene die vermijdt de moslims kwaad te doen met zijn tong en handen.\"";
"discovery.card.sunnah_bukhari_11.source" = "Sahih al-Bukhari 11";

"discovery.card.sunnah_bukhari_12.title" = "Sahih al-Boekhari 12";
"discovery.card.sunnah_bukhari_12.meaning" = "Overgeleverd door 'Abdullah bin 'Amr: Een man vroeg de Profeet (ﷺ): \"Welke soort daden of (welke eigenschappen van) de islam zijn goed?\" De Profeet (ﷺ) antwoordde: \"De (armen) te eten geven en groeten wie je kent en wie je niet kent.\"";
"discovery.card.sunnah_bukhari_12.source" = "Sahih al-Bukhari 12";

"discovery.card.sunnah_bukhari_13.title" = "Sahih al-Boekhari 13";
"discovery.card.sunnah_bukhari_13.meaning" = "Overgeleverd door Anas: De Profeet (ﷺ) zei: \"Geen van jullie zal geloof hebben totdat hij voor zijn (moslim)broeder wenst wat hij voor zichzelf graag heeft.\"";
"discovery.card.sunnah_bukhari_13.source" = "Sahih al-Bukhari 13";

"discovery.card.sunnah_bukhari_14.title" = "Sahih al-Boekhari 14";
"discovery.card.sunnah_bukhari_14.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) zei: \"Bij Hem in Wiens Handen mijn leven is, geen van jullie zal geloof hebben totdat hij van mij meer houdt dan van zijn vader en zijn kinderen.\"";
"discovery.card.sunnah_bukhari_14.source" = "Sahih al-Bukhari 14";

"discovery.card.sunnah_bukhari_15.title" = "Sahih al-Boekhari 15";
"discovery.card.sunnah_bukhari_15.meaning" = "Overgeleverd door Anas: De Profeet (ﷺ) zei: \"Geen van jullie zal geloof hebben totdat hij van mij meer houdt dan van zijn vader, zijn kinderen en de hele mensheid.\"";
"discovery.card.sunnah_bukhari_15.source" = "Sahih al-Bukhari 15";

"discovery.card.sunnah_bukhari_17.title" = "Sahih al-Boekhari 17";
"discovery.card.sunnah_bukhari_17.meaning" = "Overgeleverd door Anas: De Profeet (ﷺ) zei: \"Liefde voor de Ansar is een teken van geloof en haat jegens de Ansar is een teken van hypocrisie.\"";
"discovery.card.sunnah_bukhari_17.source" = "Sahih al-Bukhari 17";

"discovery.card.sunnah_bukhari_19.title" = "Sahih al-Boekhari 19";
"discovery.card.sunnah_bukhari_19.meaning" = "Overgeleverd door Abu Said Al-Khudri: De Boodschapper van Allah (ﷺ) zei: \"Er zal spoedig een tijd komen waarin het beste bezit van een moslim schapen zullen zijn die hij mee naar de toppen van bergen en naar de regenplaatsen (dalen) neemt, om met zijn religie te vluchten voor beproevingen.\"";
"discovery.card.sunnah_bukhari_19.source" = "Sahih al-Bukhari 19";

"discovery.card.sunnah_bukhari_24.title" = "Sahih al-Boekhari 24";
"discovery.card.sunnah_bukhari_24.meaning" = "Overgeleverd door 'Abdullah (bin 'Umar): Eens ging de Boodschapper van Allah (ﷺ) voorbij een Ansari (man) die zijn broeder berispte over Haya'. Daarop zei de Boodschapper van Allah (ﷺ): \"Laat hem, want Haya' is een deel van het geloof.\"";
"discovery.card.sunnah_bukhari_24.source" = "Sahih al-Bukhari 24";

"discovery.card.sunnah_bukhari_28.title" = "Sahih al-Boekhari 28";
"discovery.card.sunnah_bukhari_28.meaning" = "Overgeleverd door 'Abdullah bin 'Amr: Iemand vroeg de Boodschapper van Allah (ﷺ): \"Welke (soort) daden in of (welke eigenschappen van) de islam zijn goed?\" Hij antwoordde: \"De (armen) te eten geven en groeten wie je kent en wie je niet kent.\"";
"discovery.card.sunnah_bukhari_28.source" = "Sahih al-Bukhari 28";

"discovery.card.sunnah_bukhari_35.title" = "Sahih al-Boekhari 35";
"discovery.card.sunnah_bukhari_35.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) zei: \"Wie de gebeden verricht in de nacht van Qadr uit oprecht geloof en in de hoop Allahs beloning te verkrijgen (niet om zich te vertonen), diens vroegere zonden zullen worden vergeven.\"";
"discovery.card.sunnah_bukhari_35.source" = "Sahih al-Bukhari 35";

"discovery.card.sunnah_bukhari_37.title" = "Sahih al-Boekhari 37";
"discovery.card.sunnah_bukhari_37.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) zei: \"Wie de gebeden tijdens de nachten van Ramadan oprecht verricht uit oprecht geloof en in de hoop Allahs beloning te verkrijgen (niet om zich te vertonen), diens vroegere zonden zullen worden vergeven.\"";
"discovery.card.sunnah_bukhari_37.source" = "Sahih al-Bukhari 37";

"discovery.card.sunnah_bukhari_38.title" = "Sahih al-Boekhari 38";
"discovery.card.sunnah_bukhari_38.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) zei: \"Wie vast tijdens de maand Ramadan uit oprecht geloof en in de hoop Allahs beloning te verkrijgen, diens vroegere zonden zullen worden vergeven.\"";
"discovery.card.sunnah_bukhari_38.source" = "Sahih al-Bukhari 38";

"discovery.card.sunnah_bukhari_42.title" = "Sahih al-Boekhari 42";
"discovery.card.sunnah_bukhari_42.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) zei: \"Als iemand van jullie zijn islamitische religie verbetert (streng volgt), dan zullen zijn goede daden tien tot zevenhonderd keer worden beloond voor elke goede daad, en een slechte daad zal worden opgetekend zoals ze is.\"";
"discovery.card.sunnah_bukhari_42.source" = "Sahih al-Bukhari 42";

"discovery.card.sunnah_bukhari_48.title" = "Sahih al-Boekhari 48";
"discovery.card.sunnah_bukhari_48.meaning" = "Overgeleverd door 'Abdullah: De Profeet (ﷺ) zei: \"Een moslim uitschelden is Fusuq (een slechte daad) en hem doden is Kufr (ongeloof).\"";
"discovery.card.sunnah_bukhari_48.source" = "Sahih al-Bukhari 48";

"discovery.card.sunnah_bukhari_55.title" = "Sahih al-Boekhari 55";
"discovery.card.sunnah_bukhari_55.meaning" = "Overgeleverd door Abu Mas'ud: De Profeet (ﷺ) zei: \"Als een man voor zijn gezin uitgeeft (met de bedoeling een beloning van Allah te krijgen) oprecht omwille van Allah, dan is dat (een soort) aalmoes als beloning voor hem.\"";
"discovery.card.sunnah_bukhari_55.source" = "Sahih al-Bukhari 55";

"discovery.card.sunnah_bukhari_56.title" = "Sahih al-Boekhari 56";
"discovery.card.sunnah_bukhari_56.meaning" = "Overgeleverd door Sa'd bin Abi Waqqas: De Boodschapper van Allah (ﷺ) zei: \"Je zult beloond worden voor alles wat je uitgeeft omwille van Allah, zelfs als het een hapje is dat je in de mond van je vrouw legt.\"";
"discovery.card.sunnah_bukhari_56.source" = "Sahih al-Bukhari 56";

"discovery.card.sunnah_bukhari_57.title" = "Sahih al-Boekhari 57";
"discovery.card.sunnah_bukhari_57.meaning" = "Overgeleverd door Jarir bin Abdullah: Ik gaf de eed van trouw aan de Boodschapper van Allah (ﷺ) voor het volgende: 1. de gebeden volmaakt verrichten 2. de Zakat (verplichte aalmoes) betalen 3. en oprecht en trouw zijn jegens iedere moslim.";
"discovery.card.sunnah_bukhari_57.source" = "Sahih al-Bukhari 57";

"discovery.card.sunnah_bukhari_68.title" = "Sahih al-Boekhari 68";
"discovery.card.sunnah_bukhari_68.meaning" = "Overgeleverd door Ibn Mas`ud: De Profeet (ﷺ) zorgde ervoor ons te onderwijzen door een geschikt moment te kiezen, zodat wij niet verveeld zouden raken. (Hij onthield zich ervan ons voortdurend te belasten met preken en kennis.)";
"discovery.card.sunnah_bukhari_68.source" = "Sahih al-Bukhari 68";

"discovery.card.sunnah_bukhari_69.title" = "Sahih al-Boekhari 69";
"discovery.card.sunnah_bukhari_69.meaning" = "Overgeleverd door Anas bin Malik: De Profeet (ﷺ) zei: \"Maak de dingen makkelijk voor de mensen (wat religieuze zaken betreft), en maak het hun niet moeilijk, en verkondig hun goede tijdingen en jaag hen niet weg (van de islam).\"";
"discovery.card.sunnah_bukhari_69.source" = "Sahih al-Bukhari 69";

"discovery.card.sunnah_bukhari_75.title" = "Sahih al-Boekhari 75";
"discovery.card.sunnah_bukhari_75.meaning" = "Overgeleverd door Ibn `Abbas: Eens omhelsde de Profeet (ﷺ) mij en zei: \"O Allah! Schenk hem de kennis van het Boek (de Koran).\"";
"discovery.card.sunnah_bukhari_75.source" = "Sahih al-Bukhari 75";

"discovery.card.sunnah_bukhari_77.title" = "Sahih al-Boekhari 77";
"discovery.card.sunnah_bukhari_77.meaning" = "Overgeleverd door Mahmud bin Rabi`a: Toen ik een jongen van vijf was, herinner ik me dat de Profeet (ﷺ) water uit een emmer (gebruikt om water uit een put te halen) met zijn mond nam en het op mijn gezicht gooide.";
"discovery.card.sunnah_bukhari_77.source" = "Sahih al-Bukhari 77";

"discovery.card.sunnah_bukhari_94.title" = "Sahih al-Boekhari 94";
"discovery.card.sunnah_bukhari_94.meaning" = "Overgeleverd door Anas: Telkens wanneer de Profeet (ﷺ) toestemming vroeg om binnen te gaan, klopte hij driemaal op de deur met groet, en telkens wanneer hij een zin sprak (iets zei) placht hij die driemaal te herhalen.";
"discovery.card.sunnah_bukhari_94.source" = "Sahih al-Bukhari 94";

"discovery.card.sunnah_bukhari_95.title" = "Sahih al-Boekhari 95";
"discovery.card.sunnah_bukhari_95.meaning" = "Overgeleverd door Anas: Telkens wanneer de Profeet (ﷺ) een zin sprak (iets zei), placht hij die driemaal te herhalen zodat de mensen die goed van hem konden begrijpen, en telkens wanneer hij toestemming vroeg om binnen te gaan, (klopte hij) driemaal op de deur met groet.";
"discovery.card.sunnah_bukhari_95.source" = "Sahih al-Bukhari 95";

"discovery.card.sunnah_bukhari_102.title" = "Sahih al-Boekhari 102";
"discovery.card.sunnah_bukhari_102.meaning" = "Overgeleverd door Abu Sa`id Al-Khudri: zoals hierboven (de verdere overleveraars zijn anders). Abu Huraira preciseerde dat de drie kinderen waarnaar in het bovengenoemde hadith wordt verwezen de leeftijd waarop men zonden begaat (d.w.z. de leeftijd van de puberteit) nog niet hadden bereikt.";
"discovery.card.sunnah_bukhari_102.source" = "Sahih al-Bukhari 102";

"discovery.card.sunnah_bukhari_106.title" = "Sahih al-Boekhari 106";
"discovery.card.sunnah_bukhari_106.meaning" = "Overgeleverd door `Ali: De Profeet (ﷺ) zei: \"Vertel geen leugen over mij, want wie (opzettelijk) een leugen over mij vertelt, zal voorzeker het Hellevuur binnengaan.\"";
"discovery.card.sunnah_bukhari_106.source" = "Sahih al-Bukhari 106";

"discovery.card.sunnah_bukhari_108.title" = "Sahih al-Boekhari 108";
"discovery.card.sunnah_bukhari_108.meaning" = "Overgeleverd door Anas: Wat mij ervan weerhoudt u een groot aantal hadiths te overleveren, is dat de Profeet (ﷺ) zei: \"Wie opzettelijk een leugen over mij vertelt, laat hem (voorzeker) zijn plaats in het Hellevuur innemen.\"";
"discovery.card.sunnah_bukhari_108.source" = "Sahih al-Bukhari 108";

"discovery.card.sunnah_bukhari_109.title" = "Sahih al-Boekhari 109";
"discovery.card.sunnah_bukhari_109.meaning" = "Overgeleverd door Salama: Ik hoorde de Profeet (ﷺ) zeggen: \"Wie (opzettelijk) aan mij toeschrijft wat ik niet heb gezegd, laat hem (voorzeker) zijn plaats in het Hellevuur innemen.\"";
"discovery.card.sunnah_bukhari_109.source" = "Sahih al-Bukhari 109";

"discovery.card.sunnah_bukhari_113.title" = "Sahih al-Boekhari 113";
"discovery.card.sunnah_bukhari_113.meaning" = "Overgeleverd door Abu Huraira: Onder de metgezellen van de Profeet (ﷺ) is er niemand die meer hadiths heeft overgeleverd dan ik, behalve `Abdullah bin `Amr (bin Al-`As), die ze placht op te schrijven, en ik deed dat nooit.";
"discovery.card.sunnah_bukhari_113.source" = "Sahih al-Bukhari 113";

"discovery.card.sunnah_bukhari_120.title" = "Sahih al-Boekhari 120";
"discovery.card.sunnah_bukhari_120.meaning" = "Overgeleverd door Abu Huraira: Ik heb twee soorten kennis van de Boodschapper van Allah (ﷺ) onthouden. Ik heb er één aan jullie doorgegeven, en als ik de tweede zou doorgeven, zou mijn keelholte (keel) worden doorgesneden (d.w.z. ik zou worden gedood).";
"discovery.card.sunnah_bukhari_120.source" = "Sahih al-Bukhari 120";

"discovery.card.sunnah_bukhari_121.title" = "Sahih al-Boekhari 121";
"discovery.card.sunnah_bukhari_121.meaning" = "Overgeleverd door Jarir: De Profeet (ﷺ) zei tijdens Hajjat-al-Wida` tegen mij: Laat de mensen stil zijn en luisteren. Daarna zei hij (tot de mensen): \"Wordt na mij geen ongelovigen (door terug te vallen in ongeloof) door elkaar de nekken af te slaan (elkaar de kelen door te snijden) (elkaar te doden).\"";
"discovery.card.sunnah_bukhari_121.source" = "Sahih al-Bukhari 121";

"discovery.card.sunnah_bukhari_127.title" = "Sahih al-Boekhari 127";
"discovery.card.sunnah_bukhari_127.meaning" = "Overgeleverd door Abu at-Tufail: De hierboven vermelde uitspraak van `Ali.";
"discovery.card.sunnah_bukhari_127.source" = "Sahih al-Bukhari 127";

"discovery.card.sunnah_bukhari_132.title" = "Sahih al-Boekhari 132";
"discovery.card.sunnah_bukhari_132.meaning" = "Overgeleverd door `Ali: Ik had vaak onvrijwillige urethrale afscheiding, dus vroeg ik Al-Miqdad de Profeet (ﷺ) ernaar te vragen. Al-Miqdad vroeg het hem en hij antwoordde: \"Men moet (erna) de wassing verrichten.\"";
"discovery.card.sunnah_bukhari_132.source" = "Sahih al-Bukhari 132";

"discovery.card.sunnah_bukhari_137.title" = "Sahih al-Boekhari 137";
"discovery.card.sunnah_bukhari_137.meaning" = "Overgeleverd door `Abbad bin Tamim: Mijn oom vroeg de Boodschapper van Allah (ﷺ) over iemand die denkt wind te hebben gelaten tijdens het gebed. De Boodschapper van Allah antwoordde: \"Hij mag zijn gebed niet verlaten tenzij hij een geluid hoort of iets ruikt.\"";
"discovery.card.sunnah_bukhari_137.source" = "Sahih al-Bukhari 137";

"discovery.card.sunnah_bukhari_142.title" = "Sahih al-Boekhari 142";
"discovery.card.sunnah_bukhari_142.meaning" = "Overgeleverd door Anas: Telkens wanneer de Profeet (ﷺ) zijn behoefte ging doen, zei hij: \"Allah-umma inni a`udhu bika minal khubuthi wal khaba'ith\", dat wil zeggen: \"O Allah, ik zoek toevlucht bij U tegen alle aanstootgevende en slechte dingen (slechte daden en slechte geesten).\"";
"discovery.card.sunnah_bukhari_142.source" = "Sahih al-Bukhari 142";

"discovery.card.sunnah_bukhari_143.title" = "Sahih al-Boekhari 143";
"discovery.card.sunnah_bukhari_143.meaning" = "Overgeleverd door Ibn `Abbas: Eens ging de Profeet (ﷺ) een toilet binnen en ik zette water klaar voor zijn wassing. Hij vroeg: \"Wie heeft het neergezet?\" Hij werd daarvan op de hoogte gebracht en zei toen: \"O Allah! Maak van hem (Ibn `Abbas) een geleerde in de religie (islam).\"";
"discovery.card.sunnah_bukhari_143.source" = "Sahih al-Bukhari 143";

"discovery.card.sunnah_bukhari_144.title" = "Sahih al-Boekhari 144";
"discovery.card.sunnah_bukhari_144.meaning" = "Overgeleverd door Abu Aiyub Al-Ansari: De Boodschapper van Allah (ﷺ) zei: \"Als iemand van jullie naar een open plek gaat om zijn behoefte te doen, mag hij noch naar de Qibla kijken noch er de rug naartoe keren; hij moet zich naar het oosten of naar het westen richten.\"";
"discovery.card.sunnah_bukhari_144.source" = "Sahih al-Bukhari 144";

"discovery.card.sunnah_bukhari_147.title" = "Sahih al-Boekhari 147";
"discovery.card.sunnah_bukhari_147.meaning" = "Overgeleverd door `Aisha: De Profeet (ﷺ) zei tegen zijn vrouwen: \"Jullie mogen naar buiten gaan om jullie behoefte te doen.\"";
"discovery.card.sunnah_bukhari_147.source" = "Sahih al-Bukhari 147";

"discovery.card.sunnah_bukhari_148.title" = "Sahih al-Boekhari 148";
"discovery.card.sunnah_bukhari_148.meaning" = "Overgeleverd door `Abdullah bin `Umar: Ik ging voor een taak naar het dak van het huis van Hafsa en zag de Boodschapper van Allah (ﷺ) zijn behoefte doen, gericht naar Sham (Syrië, Jordanië, Palestina en Libanon beschouwd als één land) met zijn rug naar de Qibla.";
"discovery.card.sunnah_bukhari_148.source" = "Sahih al-Bukhari 148";

"discovery.card.sunnah_bukhari_149.title" = "Sahih al-Boekhari 149";
"discovery.card.sunnah_bukhari_149.meaning" = "Overgeleverd door `Abdullah bin `Umar: Eens ging ik naar het dak van ons huis en zag de Boodschapper van Allah (ﷺ) zijn behoefte doen terwijl hij op twee bakstenen zat, gericht naar Baitul-Maqdis (Jeruzalem).";
"discovery.card.sunnah_bukhari_149.source" = "Sahih al-Bukhari 149";

"discovery.card.sunnah_bukhari_150.title" = "Sahih al-Boekhari 150";
"discovery.card.sunnah_bukhari_150.meaning" = "Overgeleverd door Anas bin Malik: Telkens wanneer de Boodschapper van Allah (ﷺ) zijn behoefte ging doen, begeleidde ik hem samen met een andere jongen met een beker vol water. (Hisham merkte op: \"Zodat hij zich daarmee zijn schaamdelen kon wassen.\")";
"discovery.card.sunnah_bukhari_150.source" = "Sahih al-Bukhari 150";

"discovery.card.sunnah_bukhari_151.title" = "Sahih al-Boekhari 151";
"discovery.card.sunnah_bukhari_151.meaning" = "Overgeleverd door Anas: Telkens wanneer de Boodschapper van Allah (ﷺ) zijn behoefte ging doen, gingen een andere jongen van ons en ik achter hem aan met een beker vol water.";
"discovery.card.sunnah_bukhari_151.source" = "Sahih al-Bukhari 151";

"discovery.card.sunnah_bukhari_153.title" = "Sahih al-Boekhari 153";
"discovery.card.sunnah_bukhari_153.meaning" = "Overgeleverd door Abu Qatada: De Boodschapper van Allah (ﷺ) zei: \"Telkens wanneer iemand van jullie water drinkt, mag hij niet ademen in het drinkgerei, en telkens wanneer iemand van jullie naar het toilet gaat, mag hij noch zijn penis aanraken noch zijn schaamdelen met zijn rechterhand reinigen.\"";
"discovery.card.sunnah_bukhari_153.source" = "Sahih al-Bukhari 153";

"discovery.card.sunnah_bukhari_154.title" = "Sahih al-Boekhari 154";
"discovery.card.sunnah_bukhari_154.meaning" = "Overgeleverd door Abu Qatada: De Profeet (ﷺ) zei: \"Telkens wanneer iemand van jullie urineert, mag hij zijn penis niet vasthouden noch zijn schaamdelen met zijn rechterhand reinigen. (En tijdens het drinken) mag men niet ademen in het drinkgerei.\"";
"discovery.card.sunnah_bukhari_154.source" = "Sahih al-Bukhari 154";

"discovery.card.sunnah_bukhari_157.title" = "Sahih al-Boekhari 157";
"discovery.card.sunnah_bukhari_157.meaning" = "Overgeleverd door Ibn `Abbas: De Profeet (ﷺ) verrichtte de wassing door de lichaamsdelen slechts één keer te wassen.";
"discovery.card.sunnah_bukhari_157.source" = "Sahih al-Bukhari 157";

"discovery.card.sunnah_bukhari_158.title" = "Sahih al-Boekhari 158";
"discovery.card.sunnah_bukhari_158.meaning" = "Overgeleverd door `Abdullah bin Zaid: De Profeet (ﷺ) verrichtte de wassing door de lichaamsdelen twee keer te wassen.";
"discovery.card.sunnah_bukhari_158.source" = "Sahih al-Bukhari 158";

"discovery.card.sunnah_bukhari_161.title" = "Sahih al-Boekhari 161";
"discovery.card.sunnah_bukhari_161.meaning" = "Overgeleverd door Abu Huraira: De Profeet (ﷺ) zei: \"Wie de wassing verricht, moet zijn neus met water reinigen door er water in te doen en het er daarna uit te blazen, en wie zijn schaamdelen met stenen reinigt, moet dat met een oneven aantal stenen doen.\"";
"discovery.card.sunnah_bukhari_161.source" = "Sahih al-Bukhari 161";

"discovery.card.sunnah_bukhari_165.title" = "Sahih al-Boekhari 165";
"discovery.card.sunnah_bukhari_165.meaning" = "Overgeleverd door Muhammad Ibn Ziyad: Ik hoorde Abu Huraira zeggen, toen hij langs ons liep terwijl de mensen de wassing verrichtten uit een vat met water: \"Verricht de wassing volmaakt en grondig, want Abul-Qasim (de Profeet) zei: 'Behoed jullie hielen voor het Hellevuur.'\"";
"discovery.card.sunnah_bukhari_165.source" = "Sahih al-Bukhari 165";

"discovery.card.sunnah_bukhari_167.title" = "Sahih al-Boekhari 167";
"discovery.card.sunnah_bukhari_167.meaning" = "Overgeleverd door Um-`Atiya: Dat de Profeet (ﷺ) hen ten tijde van het wassen van zijn overleden dochter zei: \"Begin aan de rechterkant, te beginnen met die delen die bij de wassing worden gewassen.\"";
"discovery.card.sunnah_bukhari_167.source" = "Sahih al-Bukhari 167";

"discovery.card.sunnah_bukhari_168.title" = "Sahih al-Boekhari 168";
"discovery.card.sunnah_bukhari_168.meaning" = "Overgeleverd door `Aisha: De Profeet (ﷺ) hield ervan aan de rechterkant te beginnen bij het aantrekken van schoenen, het kammen van zijn haar, het reinigen of wassen van zichzelf en bij al het andere.";
"discovery.card.sunnah_bukhari_168.source" = "Sahih al-Bukhari 168";

"discovery.card.sunnah_bukhari_170.title" = "Sahih al-Boekhari 170";
"discovery.card.sunnah_bukhari_170.meaning" = "Overgeleverd door Ibn Seereen: Ik zei tegen `Abida: \"Ik heb wat haar van de Profeet (ﷺ) dat ik van Anas of van zijn familie heb gekregen.\" `Abida antwoordde: \"Zonder twijfel, als ik een enkele haar daarvan had, zou die mij dierbaarder zijn geweest dan de hele wereld en wat daarin is.\"";
"discovery.card.sunnah_bukhari_170.source" = "Sahih al-Bukhari 170";

"discovery.card.sunnah_bukhari_171.title" = "Sahih al-Boekhari 171";
"discovery.card.sunnah_bukhari_171.meaning" = "Overgeleverd door Anas: Toen de Boodschapper van Allah (ﷺ) zijn hoofd liet scheren, was Abu Talha de eerste die wat van zijn haar nam.";
"discovery.card.sunnah_bukhari_171.source" = "Sahih al-Bukhari 171";

"discovery.card.sunnah_bukhari_172.title" = "Sahih al-Boekhari 172";
"discovery.card.sunnah_bukhari_172.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) zei: \"Als een hond drinkt uit het vat van iemand van jullie, is het noodzakelijk het zeven keer te wassen.\"";
"discovery.card.sunnah_bukhari_172.source" = "Sahih al-Bukhari 172";

"discovery.card.sunnah_bukhari_174.title" = "Sahih al-Boekhari 174";
"discovery.card.sunnah_bukhari_174.meaning" = "En overgeleverd door Hamza bin 'Abdullah: Mijn vader zei: \"Tijdens het leven van de Boodschapper van Allah plachten de honden te urineren en door de moskeeën te lopen (komen en gaan); desondanks placht men er geen water over te sprenkelen (over de urine van de hond).\"";
"discovery.card.sunnah_bukhari_174.source" = "Sahih al-Bukhari 174";

"discovery.card.sunnah_bukhari_177.title" = "Sahih al-Boekhari 177";
"discovery.card.sunnah_bukhari_177.meaning" = "Overgeleverd door `Abbad bin Tamim: Mijn oom zei: De Profeet (ﷺ) zei: \"Men mag zijn gebed niet verlaten tenzij men een geluid hoort of iets ruikt.\"";
"discovery.card.sunnah_bukhari_177.source" = "Sahih al-Bukhari 177";

"discovery.card.sunnah_bukhari_178.title" = "Sahih al-Boekhari 178";
"discovery.card.sunnah_bukhari_178.meaning" = "Overgeleverd door `Ali: Ik had vaak onvrijwillige urethrale afscheidingen en schaamde me om de Boodschapper van Allah (ﷺ) ernaar te vragen. Daarom vroeg ik Al-Miqdad bin Al-Aswad om (de Profeet (ﷺ) ) ernaar te vragen. Al-Miqdad vroeg het hem en hij antwoordde: \"Men moet (daarna) de wassing verrichten.\"";
"discovery.card.sunnah_bukhari_178.source" = "Sahih al-Bukhari 178";

"discovery.card.sunnah_bukhari_188.title" = "Sahih al-Boekhari 188";
"discovery.card.sunnah_bukhari_188.meaning" = "Abu Musa zei: De Profeet vroeg om een beker met water, waste daarin zijn beide handen en zijn gezicht, spuwde toen een slok water in de beker terug en zei tegen ons beiden (Abu Musa en Bilal): \"Drink uit de beker en giet wat van het water op jullie gezichten en borsten.\"";
"discovery.card.sunnah_bukhari_188.source" = "Sahih al-Bukhari 188";

"discovery.card.sunnah_bukhari_193.title" = "Sahih al-Boekhari 193";
"discovery.card.sunnah_bukhari_193.meaning" = "Overgeleverd door 'Abdullah bin 'Umar: \"Tijdens het leven van de Boodschapper van Allah (ﷺ) verrichtten mannen en vrouwen samen de wassing.\"";
"discovery.card.sunnah_bukhari_193.source" = "Sahih al-Bukhari 193";

"discovery.card.sunnah_bukhari_196.title" = "Sahih al-Boekhari 196";
"discovery.card.sunnah_bukhari_196.meaning" = "Overgeleverd door Abu Musa: Eens vroeg de Profeet (ﷺ) om een beker met water. Hij waste erin zijn handen en gezicht en spuwde er ook een slok water in.";
"discovery.card.sunnah_bukhari_196.source" = "Sahih al-Bukhari 196";

"discovery.card.sunnah_bukhari_201.title" = "Sahih al-Boekhari 201";
"discovery.card.sunnah_bukhari_201.meaning" = "Overgeleverd door Anas: De Profeet (ﷺ) nam een ritueel bad met één Sa` tot vijf Mudds (1 Sa` = [??] Mudds) water en verrichtte de wassing met één Mudd water.";
"discovery.card.sunnah_bukhari_201.source" = "Sahih al-Bukhari 201";

"discovery.card.sunnah_bukhari_204.title" = "Sahih al-Boekhari 204";
"discovery.card.sunnah_bukhari_204.meaning" = "Overgeleverd door Ja`far bin `Amr bin Umaiya Ad-Damri: Mijn vader zei: \"Ik zag de Profeet (ﷺ) met natte handen over zijn khuffs (sokken van dikke stof of leer) wrijven.\"";
"discovery.card.sunnah_bukhari_204.source" = "Sahih al-Bukhari 204";

"discovery.card.sunnah_bukhari_205.title" = "Sahih al-Boekhari 205";
"discovery.card.sunnah_bukhari_205.meaning" = "Overgeleverd door Ja`far bin `Amr: Mijn vader zei: \"Ik zag de Profeet (ﷺ) met natte handen over zijn tulband en zijn khuffs (sokken van dikke stof of leer) wrijven.\"";
"discovery.card.sunnah_bukhari_205.source" = "Sahih al-Bukhari 205";

"discovery.card.sunnah_bukhari_207.title" = "Sahih al-Boekhari 207";
"discovery.card.sunnah_bukhari_207.meaning" = "Overgeleverd door `Abdullah bin `Abbas: De Boodschapper van Allah (ﷺ) at een stuk gekookt schapenvlees van de schouderstreek en bad zonder de wassing te herhalen.";
"discovery.card.sunnah_bukhari_207.source" = "Sahih al-Bukhari 207";

"discovery.card.sunnah_bukhari_208.title" = "Sahih al-Boekhari 208";
"discovery.card.sunnah_bukhari_208.meaning" = "Overgeleverd door Ja`far bin `Amr bin Umaiya: Mijn vader zei: \"Ik zag de Boodschapper van Allah (ﷺ) een stuk (gekookt) schapenvlees van de schouderstreek nemen, waarna hij tot het gebed werd geroepen. Hij legde zijn mes neer en bad zonder de wassing te herhalen.\"";
"discovery.card.sunnah_bukhari_208.source" = "Sahih al-Bukhari 208";

"discovery.card.sunnah_bukhari_210.title" = "Sahih al-Boekhari 210";
"discovery.card.sunnah_bukhari_210.meaning" = "Overgeleverd door Maimuna: De Profeet (ﷺ) at (een stuk) schapenvlees van de schouderstreek en bad daarna zonder de wassing te herhalen.";
"discovery.card.sunnah_bukhari_210.source" = "Sahih al-Bukhari 210";

"discovery.card.sunnah_bukhari_211.title" = "Sahih al-Boekhari 211";
"discovery.card.sunnah_bukhari_211.meaning" = "Overgeleverd door Ibn `Abbas: De Boodschapper van Allah (ﷺ) dronk melk, spoelde zijn mond en zei: \"Het bevat vet.\"";
"discovery.card.sunnah_bukhari_211.source" = "Sahih al-Bukhari 211";

"discovery.card.sunnah_bukhari_212.title" = "Sahih al-Boekhari 212";
"discovery.card.sunnah_bukhari_212.meaning" = "Overgeleverd door `Aisha: De Boodschapper van Allah (ﷺ) zei: \"Als iemand van jullie slaperig wordt tijdens het gebed, moet hij naar bed gaan (slapen) tot de slaperigheid voorbij is, want wie slaperig bidt, weet niet of hij om vergeving vraagt of om iets slechts voor zichzelf.\"";
"discovery.card.sunnah_bukhari_212.source" = "Sahih al-Bukhari 212";

"discovery.card.sunnah_bukhari_213.title" = "Sahih al-Boekhari 213";
"discovery.card.sunnah_bukhari_213.meaning" = "Overgeleverd door Anas: De Profeet (ﷺ) zei: \"Als iemand van jullie slaperig wordt tijdens het gebed, moet hij slapen tot hij begrijpt wat hij zegt (reciteert).\"";
"discovery.card.sunnah_bukhari_213.source" = "Sahih al-Bukhari 213";

"discovery.card.sunnah_bukhari_214.title" = "Sahih al-Boekhari 214";
"discovery.card.sunnah_bukhari_214.meaning" = "Overgeleverd door `Amr bin `Amir: Anas zei: \"De Profeet (ﷺ) verrichtte voor elk gebed de wassing.\" Ik vroeg Anas: \"Wat deden jullie?\" Anas antwoordde: \"Wij baden met dezelfde wassing tot we die verbraken door een hadath.\"";
"discovery.card.sunnah_bukhari_214.source" = "Sahih al-Bukhari 214";

"discovery.card.sunnah_bukhari_217.title" = "Sahih al-Boekhari 217";
"discovery.card.sunnah_bukhari_217.meaning" = "Overgeleverd door Anas bin Malik: Telkens wanneer de Profeet (ﷺ) naar het toilet ging, bracht ik water mee waarmee hij zijn schaamdelen reinigde.";
"discovery.card.sunnah_bukhari_217.source" = "Sahih al-Bukhari 217";

"discovery.card.sunnah_bukhari_219.title" = "Sahih al-Boekhari 219";
"discovery.card.sunnah_bukhari_219.meaning" = "Overgeleverd door Anas bin Malik: De Profeet (ﷺ) zag een bedoeïen in de moskee urineren en zei tegen de mensen hem niet te storen. Toen hij klaar was, vroeg de Profeet (ﷺ) om wat water en goot het erover (over de urine).";
"discovery.card.sunnah_bukhari_219.source" = "Sahih al-Bukhari 219";

"discovery.card.sunnah_bukhari_221.title" = "Sahih al-Boekhari 221";
"discovery.card.sunnah_bukhari_221.meaning" = "Overgeleverd door Anas bin Malik: De Profeet (ﷺ) zei hetzelfde als hierboven.";
"discovery.card.sunnah_bukhari_221.source" = "Sahih al-Bukhari 221";

"discovery.card.sunnah_bukhari_222.title" = "Sahih al-Boekhari 222";
"discovery.card.sunnah_bukhari_222.meaning" = "Overgeleverd door `Aisha: (de moeder van de gelovigen) Een kind werd naar de Boodschapper van Allah (ﷺ) gebracht en het urineerde op het gewaad van de Profeet. De Profeet (ﷺ) vroeg om water en goot het over de bevlekte plek.";
"discovery.card.sunnah_bukhari_222.source" = "Sahih al-Bukhari 222";

"discovery.card.sunnah_bukhari_224.title" = "Sahih al-Boekhari 224";
"discovery.card.sunnah_bukhari_224.meaning" = "Overgeleverd door Hudhaifa: Eens ging de Profeet (ﷺ) naar de vuilnishopen van sommige mensen en urineerde staande. Daarna vroeg hij om water, ik bracht het hem en hij verrichtte de wassing.";
"discovery.card.sunnah_bukhari_224.source" = "Sahih al-Bukhari 224";

"discovery.card.sunnah_bukhari_225.title" = "Sahih al-Boekhari 225";
"discovery.card.sunnah_bukhari_225.meaning" = "Overgeleverd door Hudhaifa': De Profeet (ﷺ) en ik liepen tot we bij de vuilnishopen van sommige mensen kwamen. Hij ging staan, zoals ieder van jullie staat, achter een muur en urineerde. Ik ging weg, maar hij wenkte me om te komen. Dus naderde ik hem en bleef achter zijn rug staan tot hij klaar was.";
"discovery.card.sunnah_bukhari_225.source" = "Sahih al-Bukhari 225";

"discovery.card.sunnah_bukhari_229.title" = "Sahih al-Boekhari 229";
"discovery.card.sunnah_bukhari_229.meaning" = "Overgeleverd door `Aisha: Ik waste de sporen van Janaba (zaad) van de kleren van de Profeet (ﷺ) en hij ging bidden terwijl er nog sporen van water op zaten (watervlekken waren nog zichtbaar).";
"discovery.card.sunnah_bukhari_229.source" = "Sahih al-Bukhari 229";

"discovery.card.sunnah_bukhari_230.title" = "Sahih al-Boekhari 230";
"discovery.card.sunnah_bukhari_230.meaning" = "Overgeleverd door Sulaiman bin Yasar: Ik vroeg `Aisha over kleren die met zaad bevlekt waren. Zij antwoordde: \"Ik waste het van de kleren van de Boodschapper van Allah (ﷺ) en hij ging naar het gebed terwijl watervlekken nog zichtbaar waren.\"";
"discovery.card.sunnah_bukhari_230.source" = "Sahih al-Bukhari 230";

"discovery.card.sunnah_bukhari_231.title" = "Sahih al-Boekhari 231";
"discovery.card.sunnah_bukhari_231.meaning" = "Overgeleverd door `Amr bin Maimun: Ik hoorde Sulaiman bin Yasar spreken over kleren die met zaad bevlekt waren. Hij zei dat `Aisha had gezegd: \"Ik waste het van de kleren van de Boodschapper van Allah (ﷺ) en hij ging naar de gebeden terwijl watervlekken er nog op zichtbaar waren.\"";
"discovery.card.sunnah_bukhari_231.source" = "Sahih al-Bukhari 231";

"discovery.card.sunnah_bukhari_232.title" = "Sahih al-Boekhari 232";
"discovery.card.sunnah_bukhari_232.meaning" = "Overgeleverd door `Aishah: Ik waste het zaad van de kleren van de Profeet (ﷺ) en zag desondanks nog één of meer vlekken erop.";
"discovery.card.sunnah_bukhari_232.source" = "Sahih al-Bukhari 232";

"discovery.card.sunnah_bukhari_234.title" = "Sahih al-Boekhari 234";
"discovery.card.sunnah_bukhari_234.meaning" = "Overgeleverd door Anas: Voordat de moskee werd gebouwd, bad de Profeet (ﷺ) in schapenstallen.";
"discovery.card.sunnah_bukhari_234.source" = "Sahih al-Bukhari 234";

"discovery.card.sunnah_bukhari_235.title" = "Sahih al-Boekhari 235";
"discovery.card.sunnah_bukhari_235.meaning" = "Overgeleverd door Maimuna: Aan de Boodschapper van Allah (ﷺ) werd gevraagd over ghee (kookboter) waarin een muis was gevallen. Hij zei: \"Haal de muis eruit, gooi de ghee eromheen weg en gebruik de rest.\"";
"discovery.card.sunnah_bukhari_235.source" = "Sahih al-Bukhari 235";

"discovery.card.sunnah_bukhari_236.title" = "Sahih al-Boekhari 236";
"discovery.card.sunnah_bukhari_236.meaning" = "Overgeleverd door Maimuna: Aan de Profeet (ﷺ) werd gevraagd over ghee waarin een muis was gevallen. Hij zei: \"Haal de muis eruit en gooi de ghee eromheen weg (en gebruik de rest).\"";
"discovery.card.sunnah_bukhari_236.source" = "Sahih al-Bukhari 236";

"discovery.card.sunnah_bukhari_237.title" = "Sahih al-Boekhari 237";
"discovery.card.sunnah_bukhari_237.meaning" = "Overgeleverd door Abu Huraira: De Profeet (ﷺ) zei: \"Een wond die een moslim oploopt op de weg van Allah zal op de Dag der Opstanding verschijnen zoals zij was op het moment van de verwonding; er zal bloed uit de wond stromen, de kleur zal die van bloed zijn, maar de geur zal als musk zijn.\"";
"discovery.card.sunnah_bukhari_237.source" = "Sahih al-Bukhari 237";

"discovery.card.sunnah_bukhari_238.title" = "Sahih al-Boekhari 238";
"discovery.card.sunnah_bukhari_238.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) zei: \"Wij (moslims) zijn de laatsten (die in de wereld komen) maar (zullen) de voorsten (zijn op de Dag der Opstanding).\"";
"discovery.card.sunnah_bukhari_238.source" = "Sahih al-Bukhari 238";

"discovery.card.sunnah_bukhari_239.title" = "Sahih al-Boekhari 239";
"discovery.card.sunnah_bukhari_239.meaning" = "Dezelfde overleveraar zei dat de Profeet (ﷺ) had gezegd: \"Jullie mogen niet urineren in stilstaand water dat niet stroomt, om je daarna (eventueel) daarin te wassen.\"";
"discovery.card.sunnah_bukhari_239.source" = "Sahih al-Bukhari 239";

"discovery.card.sunnah_bukhari_241.title" = "Sahih al-Boekhari 241";
"discovery.card.sunnah_bukhari_241.meaning" = "Overgeleverd door Anas: De Profeet (ﷺ) spuugde eens in zijn kleren.";
"discovery.card.sunnah_bukhari_241.source" = "Sahih al-Bukhari 241";

"discovery.card.sunnah_bukhari_242.title" = "Sahih al-Boekhari 242";
"discovery.card.sunnah_bukhari_242.meaning" = "Overgeleverd door Aisha: De Profeet (ﷺ) zei: \"Alle dranken die bedwelming veroorzaken zijn haram (verboden te drinken).\"";
"discovery.card.sunnah_bukhari_242.source" = "Sahih al-Bukhari 242";

"discovery.card.sunnah_bukhari_250.title" = "Sahih al-Boekhari 250";
"discovery.card.sunnah_bukhari_250.meaning" = "Overgeleverd door `Aisha: De Profeet (ﷺ) en ik namen een ritueel bad uit één vat, Faraq genoemd.";
"discovery.card.sunnah_bukhari_250.source" = "Sahih al-Bukhari 250";

"discovery.card.sunnah_bukhari_251.title" = "Sahih al-Boekhari 251";
"discovery.card.sunnah_bukhari_251.meaning" = "Overgeleverd door Abu Salama: De broer van `Aisha en ik gingen naar `Aisha en hij vroeg haar naar het bad van de Profeet. Zij bracht een vat met ongeveer een Sa` water, nam een bad en goot het over haar hoofd, en op dat moment was er een scherm tussen haar en ons.";
"discovery.card.sunnah_bukhari_251.source" = "Sahih al-Bukhari 251";

"discovery.card.sunnah_bukhari_253.title" = "Sahih al-Boekhari 253";
"discovery.card.sunnah_bukhari_253.meaning" = "Overgeleverd door Ibn `Abbas: De Profeet (ﷺ) en Maimuna namen een ritueel bad uit één vat.";
"discovery.card.sunnah_bukhari_253.source" = "Sahih al-Bukhari 253";

"discovery.card.sunnah_bukhari_254.title" = "Sahih al-Boekhari 254";
"discovery.card.sunnah_bukhari_254.meaning" = "Overgeleverd door Jubair bin Mut`im: De Boodschapper van Allah (ﷺ) zei: \"Wat mij betreft, ik giet driemaal water over mijn hoofd.\" En hij wees met beide handen.";
"discovery.card.sunnah_bukhari_254.source" = "Sahih al-Bukhari 254";

"discovery.card.sunnah_bukhari_255.title" = "Sahih al-Boekhari 255";
"discovery.card.sunnah_bukhari_255.meaning" = "Overgeleverd door Jabir bin `Abdullah: De Profeet (ﷺ) goot driemaal water over zijn hoofd.";
"discovery.card.sunnah_bukhari_255.source" = "Sahih al-Bukhari 255";

"discovery.card.sunnah_bukhari_261.title" = "Sahih al-Boekhari 261";
"discovery.card.sunnah_bukhari_261.meaning" = "Overgeleverd door Aisha: De Profeet (ﷺ) en ik namen een ritueel bad uit één vat water en onze handen gingen om beurten achter elkaar in het vat.";
"discovery.card.sunnah_bukhari_261.source" = "Sahih al-Bukhari 261";

"discovery.card.sunnah_bukhari_262.title" = "Sahih al-Boekhari 262";
"discovery.card.sunnah_bukhari_262.meaning" = "Overgeleverd door `Aisha: Telkens wanneer de Boodschapper van Allah (ﷺ) een bad van Janaba nam, waste hij eerst zijn handen.";
"discovery.card.sunnah_bukhari_262.source" = "Sahih al-Bukhari 262";

"discovery.card.sunnah_bukhari_263.title" = "Sahih al-Boekhari 263";
"discovery.card.sunnah_bukhari_263.meaning" = "Overgeleverd door `Aisha: De Profeet (ﷺ) en ik namen een ritueel bad uit één vat water na Janaba.";
"discovery.card.sunnah_bukhari_263.source" = "Sahih al-Bukhari 263";

"discovery.card.sunnah_bukhari_264.title" = "Sahih al-Boekhari 264";
"discovery.card.sunnah_bukhari_264.meaning" = "Overgeleverd door Anas bin Malik: De Profeet (ﷺ) en één van zijn vrouwen namen een ritueel bad uit één vat water. (Shu`ba voegde toe aan de uitspraak van Anas: \"Na de Janaba.\")";
"discovery.card.sunnah_bukhari_264.source" = "Sahih al-Bukhari 264";

"discovery.card.sunnah_bukhari_269.title" = "Sahih al-Boekhari 269";
"discovery.card.sunnah_bukhari_269.meaning" = "Overgeleverd door `Ali: Ik had vaak onvrijwillige urethrale afscheiding. Omdat ik de schoonzoon van de Profeet (ﷺ) was, vroeg ik een man om hem ernaar te vragen. De man vroeg de Profeet (ﷺ) ernaar. De Profeet (ﷺ) antwoordde: \"Verricht de wassing nadat je je orgaan (penis) hebt gewassen.\"";
"discovery.card.sunnah_bukhari_269.source" = "Sahih al-Bukhari 269";

"discovery.card.sunnah_bukhari_271.title" = "Sahih al-Boekhari 271";
"discovery.card.sunnah_bukhari_271.meaning" = "Overgeleverd door `Aisha: Het is alsof ik nog de glans van geur in de scheiding van het haar van de Profeet zie terwijl hij Muhrim was.";
"discovery.card.sunnah_bukhari_271.source" = "Sahih al-Bukhari 271";

"discovery.card.sunnah_bukhari_277.title" = "Sahih al-Boekhari 277";
"discovery.card.sunnah_bukhari_277.meaning" = "Overgeleverd door Aisha: Telkens wanneer één van ons Junub was, goot zij driemaal water over haar hoofd met beide handen en wreef toen de rechterkant van haar hoofd met één hand en de linkerkant van het hoofd met de andere hand.";
"discovery.card.sunnah_bukhari_277.source" = "Sahih al-Bukhari 277";

"discovery.card.sunnah_bukhari_280.title" = "Sahih al-Boekhari 280";
"discovery.card.sunnah_bukhari_280.meaning" = "Overgeleverd door Um Hani bint Abi Talib: Ik ging naar de Boodschapper van Allah (ﷺ) in het jaar van de verovering van Mekka en vond hem terwijl hij een bad nam en Fatima hem afschermde. De Profeet (ﷺ) vroeg: \"Wie is daar?\" Ik antwoordde: \"Ik ben Um-Hani.\"";
"discovery.card.sunnah_bukhari_280.source" = "Sahih al-Bukhari 280";

"discovery.card.sunnah_bukhari_284.title" = "Sahih al-Boekhari 284";
"discovery.card.sunnah_bukhari_284.meaning" = "Overgeleverd door Anas bin Malik: De Profeet (ﷺ) bezocht al zijn vrouwen in één nacht en hij had toen negen vrouwen.";
"discovery.card.sunnah_bukhari_284.source" = "Sahih al-Bukhari 284";

"discovery.card.sunnah_bukhari_286.title" = "Sahih al-Boekhari 286";
"discovery.card.sunnah_bukhari_286.meaning" = "Overgeleverd door Abu Salama: Ik vroeg `Aisha: \"Ging de Profeet (ﷺ) slapen terwijl hij Junub was?\" Zij antwoordde: \"Ja, maar hij verrichtte de wassing (voordat hij naar bed ging).\"";
"discovery.card.sunnah_bukhari_286.source" = "Sahih al-Bukhari 286";

"discovery.card.sunnah_bukhari_287.title" = "Sahih al-Boekhari 287";
"discovery.card.sunnah_bukhari_287.meaning" = "Overgeleverd door `Umar bin Al-Khattab: Ik vroeg de Boodschapper van Allah (ﷺ): \"Kan iemand van ons slapen terwijl hij Junub is?\" Hij antwoordde: \"Ja, als hij de wassing verricht, kan hij slapen terwijl hij Junub is.\"";
"discovery.card.sunnah_bukhari_287.source" = "Sahih al-Bukhari 287";

"discovery.card.sunnah_bukhari_288.title" = "Sahih al-Boekhari 288";
"discovery.card.sunnah_bukhari_288.meaning" = "Overgeleverd door `Aisha: Telkens wanneer de Profeet (ﷺ) wilde slapen terwijl hij Junub was, waste hij zijn schaamdelen en verrichtte de wassing zoals voor het gebed.";
"discovery.card.sunnah_bukhari_288.source" = "Sahih al-Bukhari 288";

"discovery.card.sunnah_bukhari_289.title" = "Sahih al-Boekhari 289";
"discovery.card.sunnah_bukhari_289.meaning" = "Overgeleverd door `Abdullah: `Umar vroeg de Profeet (ﷺ): \"Kan iemand van ons slapen terwijl hij Junub is?\" Hij antwoordde: \"Ja, als hij de wassing verricht.\"";
"discovery.card.sunnah_bukhari_289.source" = "Sahih al-Bukhari 289";

"discovery.card.sunnah_bukhari_290.title" = "Sahih al-Boekhari 290";
"discovery.card.sunnah_bukhari_290.meaning" = "Overgeleverd door `Abdullah bin `Umar: `Umar bin Al-Khattab zei tegen de Boodschapper van Allah (ﷺ): \"Ik werd 's nachts Junub.\" De Boodschapper van Allah (ﷺ) antwoordde: \"Verricht de wassing nadat je je schaamdelen hebt gewassen en slaap dan.\"";
"discovery.card.sunnah_bukhari_290.source" = "Sahih al-Bukhari 290";

"discovery.card.sunnah_bukhari_291.title" = "Sahih al-Boekhari 291";
"discovery.card.sunnah_bukhari_291.meaning" = "Overgeleverd door Hisham: zoals de volgende hadith 290. Overgeleverd door Abu Huraira: De Profeet (ﷺ) zei: \"Wanneer een man tussen de vier ledematen van een vrouw zit en de geslachtsgemeenschap met haar voltrekt, wordt het rituele bad verplicht.\"";
"discovery.card.sunnah_bukhari_291.source" = "Sahih al-Bukhari 291";

"discovery.card.sunnah_bukhari_295.title" = "Sahih al-Boekhari 295";
"discovery.card.sunnah_bukhari_295.meaning" = "Overgeleverd door `Aisha: Tijdens de menstruatie kamde ik het haar van de Boodschapper van Allah (ﷺ).";
"discovery.card.sunnah_bukhari_295.source" = "Sahih al-Bukhari 295";

"discovery.card.sunnah_bukhari_297.title" = "Sahih al-Boekhari 297";
"discovery.card.sunnah_bukhari_297.meaning" = "Overgeleverd door `Aisha: De Profeet (ﷺ) leunde op mijn schoot en reciteerde de Koran terwijl ik ongesteld was.";
"discovery.card.sunnah_bukhari_297.source" = "Sahih al-Bukhari 297";

"discovery.card.sunnah_bukhari_298.title" = "Sahih al-Boekhari 298";
"discovery.card.sunnah_bukhari_298.meaning" = "Overgeleverd door Um Salama: Terwijl ik bij de Profeet (ﷺ) onder één wollen deken lag, kreeg ik de menstruatie. Ik glipte weg en trok de kleren voor de menstruatie aan. Hij zei: \"Heb je 'Nifas' (menstruatie) gekregen?\" Ik antwoordde: \"Ja.\" Hij riep me toen en liet me bij hem onder dezelfde deken liggen.";
"discovery.card.sunnah_bukhari_298.source" = "Sahih al-Bukhari 298";

"discovery.card.sunnah_bukhari_303.title" = "Sahih al-Boekhari 303";
"discovery.card.sunnah_bukhari_303.meaning" = "Overgeleverd door Maimuna: Telkens wanneer de Boodschapper van Allah (ﷺ) een van zijn vrouwen tijdens de menstruatie wilde strelen, vroeg hij haar een Izar te dragen.";
"discovery.card.sunnah_bukhari_303.source" = "Sahih al-Bukhari 303";

"discovery.card.sunnah_bukhari_310.title" = "Sahih al-Boekhari 310";
"discovery.card.sunnah_bukhari_310.meaning" = "Overgeleverd door `Aisha: Een van de vrouwen van de Boodschapper van Allah (ﷺ) voegde zich bij hem in I`tikaf en zij merkte bloed en geelachtige afscheiding (uit haar schaamdelen) op en zette een schaal onder zich wanneer zij bad.";
"discovery.card.sunnah_bukhari_310.source" = "Sahih al-Bukhari 310";

"discovery.card.sunnah_bukhari_311.title" = "Sahih al-Boekhari 311";
"discovery.card.sunnah_bukhari_311.meaning" = "Overgeleverd door `Aisha: Een van de moeders van de gelovigen (dat wil zeggen de vrouwen van de Profeet (ﷺ)) verrichtte I`tikaf terwijl zij bloedingen had tussen twee menstruaties.";
"discovery.card.sunnah_bukhari_311.source" = "Sahih al-Bukhari 311";

"discovery.card.sunnah_bukhari_312.title" = "Sahih al-Boekhari 312";
"discovery.card.sunnah_bukhari_312.meaning" = "Overgeleverd door `Aisha: Geen van ons had meer dan één kledingstuk en wij droegen het tijdens onze menstruatie. Wanneer het bevlekt raakte met menstruatiebloed, brachten wij speeksel op de bloedvlek aan en wreven het bloed met onze nagels weg.";
"discovery.card.sunnah_bukhari_312.source" = "Sahih al-Bukhari 312";

"discovery.card.sunnah_bukhari_323.title" = "Sahih al-Boekhari 323";
"discovery.card.sunnah_bukhari_323.meaning" = "Overgeleverd door Um Salama: Terwijl ik met de Profeet (ﷺ) onder een wollen deken lag, kreeg ik mijn menstruatie. Ik glipte weg en trok de kleding voor de menstruatie aan. De Profeet (ﷺ) zei: \"Heb je je menstruatie gekregen?\" Ik antwoordde: \"Ja.\" Hij riep me en ik sliep bij hem onder de wollen deken.";
"discovery.card.sunnah_bukhari_323.source" = "Sahih al-Bukhari 323";

"discovery.card.sunnah_bukhari_326.title" = "Sahih al-Boekhari 326";
"discovery.card.sunnah_bukhari_326.meaning" = "Overgeleverd door Um `Atiya: Wij beschouwden geelachtige afscheiding nooit als iets van belang (als menstruatie).";
"discovery.card.sunnah_bukhari_326.source" = "Sahih al-Bukhari 326";

"discovery.card.sunnah_bukhari_328.title" = "Sahih al-Boekhari 328";
"discovery.card.sunnah_bukhari_328.meaning" = "Overgeleverd door `Aisha: (de vrouw van de Profeet) Ik zei tegen de Boodschapper van Allah (ﷺ) dat Safiya bint Huyai haar menstruatie had gekregen. Hij zei: \"Zij zal ons waarschijnlijk ophouden. Heeft zij Tawaf (Al-Ifada) met jullie verricht?\" Wij antwoordden: \"Ja.\" Daarop zei de Profeet (ﷺ) haar te vertrekken.";
"discovery.card.sunnah_bukhari_328.source" = "Sahih al-Bukhari 328";

"discovery.card.sunnah_bukhari_331.title" = "Sahih al-Boekhari 331";
"discovery.card.sunnah_bukhari_331.meaning" = "Overgeleverd door `Aisha: De Profeet (ﷺ) zei tegen mij: \"Laat het gebed na wanneer je menstruatie begint, en wanneer zij voorbij is, was het bloed van je lichaam (neem een bad) en begin weer te bidden.\"";
"discovery.card.sunnah_bukhari_331.source" = "Sahih al-Bukhari 331";

"discovery.card.sunnah_bukhari_332.title" = "Sahih al-Boekhari 332";
"discovery.card.sunnah_bukhari_332.meaning" = "Overgeleverd door Samura bin Jundub: De Profeet (ﷺ) verrichtte het begrafenisgebed voor het lichaam van een vrouw die tijdens de bevalling was overleden, en hij stond bij het midden van haar lichaam.";
"discovery.card.sunnah_bukhari_332.source" = "Sahih al-Bukhari 332";

"discovery.card.sunnah_bukhari_333.title" = "Sahih al-Boekhari 333";
"discovery.card.sunnah_bukhari_333.meaning" = "Overgeleverd door Maimuna: (de vrouw van de Profeet) Tijdens mijn menstruatie bad ik nooit, maar ik zat op de mat naast de moskee van de Boodschapper van Allah (ﷺ). Hij verrichtte het gebed op zijn laken en bij de nederwerping raakten sommige van zijn kleren mij.";
"discovery.card.sunnah_bukhari_333.source" = "Sahih al-Bukhari 333";

"discovery.card.sunnah_bukhari_340.title" = "Sahih al-Boekhari 340";
"discovery.card.sunnah_bukhari_340.meaning" = "Overgeleverd door `Abdur Rahman bin Abza: dat terwijl hij in het gezelschap van `Umar was, `Ammar tegen `Umar zei: \"Wij waren in een detachement en werden Junub, en ik blies het stof van mijn handen (ik rolde mij over de aarde en bad).\"";
"discovery.card.sunnah_bukhari_340.source" = "Sahih al-Bukhari 340";

"discovery.card.sunnah_bukhari_341.title" = "Sahih al-Boekhari 341";
"discovery.card.sunnah_bukhari_341.meaning" = "Overgeleverd door `Abdur Rahman bin Abza: `Ammar zei tegen `Umar: \"Ik rolde mij in het stof en ging naar de Profeet (ﷺ), die zei: 'Stoffige handen over het gezicht en de ruggen van de handen strijken is voldoende voor jou.'\"";
"discovery.card.sunnah_bukhari_341.source" = "Sahih al-Bukhari 341";

"discovery.card.sunnah_bukhari_343.title" = "Sahih al-Boekhari 343";
"discovery.card.sunnah_bukhari_343.meaning" = "Overgeleverd door `Ammar: De Profeet (ﷺ) tikte met zijn handen op de aarde en streek ze vervolgens over zijn gezicht en de ruggen van zijn handen (terwijl hij Tayammum demonstreerde).";
"discovery.card.sunnah_bukhari_343.source" = "Sahih al-Bukhari 343";

"discovery.card.sunnah_bukhari_353.title" = "Sahih al-Boekhari 353";
"discovery.card.sunnah_bukhari_353.meaning" = "Overgeleverd door Muhammad bin Al Munkadir: Ik zag Jabir bin `Abdullah bidden in één kledingstuk, en hij zei dat hij de Profeet (ﷺ) in één kledingstuk had zien bidden.";
"discovery.card.sunnah_bukhari_353.source" = "Sahih al-Bukhari 353";

"discovery.card.sunnah_bukhari_354.title" = "Sahih al-Boekhari 354";
"discovery.card.sunnah_bukhari_354.meaning" = "Overgeleverd door `Umar bin Abi Salama: De Profeet (ﷺ) bad in één kledingstuk en kruiste de uiteinden ervan.";
"discovery.card.sunnah_bukhari_354.source" = "Sahih al-Bukhari 354";

"discovery.card.sunnah_bukhari_355.title" = "Sahih al-Boekhari 355";
"discovery.card.sunnah_bukhari_355.meaning" = "Overgeleverd door `Umar bin Abi Salama: Ik zag de Profeet (ﷺ) in het huis van Um-Salama bidden in één kledingstuk, en hij had de uiteinden ervan over zijn schouders gekruist.";
"discovery.card.sunnah_bukhari_355.source" = "Sahih al-Bukhari 355";

"discovery.card.sunnah_bukhari_356.title" = "Sahih al-Boekhari 356";
"discovery.card.sunnah_bukhari_356.meaning" = "Overgeleverd door `Umar bin Abi Salama: In het huis van Um-Salama zag ik de Boodschapper van Allah (ﷺ) bidden, gehuld in één kledingstuk om zijn lichaam, met de uiteinden over zijn schouders gekruist.";
"discovery.card.sunnah_bukhari_356.source" = "Sahih al-Bukhari 356";

"discovery.card.sunnah_bukhari_358.title" = "Sahih al-Boekhari 358";
"discovery.card.sunnah_bukhari_358.meaning" = "Overgeleverd door Abu Huraira: Iemand vroeg de Boodschapper van Allah (ﷺ) naar het verrichten van het gebed in één kledingstuk. De Boodschapper van Allah (ﷺ) antwoordde: \"Heeft ieder van jullie twee kledingstukken?\"";
"discovery.card.sunnah_bukhari_358.source" = "Sahih al-Bukhari 358";

"discovery.card.sunnah_bukhari_359.title" = "Sahih al-Boekhari 359";
"discovery.card.sunnah_bukhari_359.meaning" = "Overgeleverd door Abu Huraira: De Profeet (ﷺ) zei: \"Niemand van jullie mag het gebed verrichten in één kledingstuk dat de schouders niet bedekt.\"";
"discovery.card.sunnah_bukhari_359.source" = "Sahih al-Bukhari 359";

"discovery.card.sunnah_bukhari_360.title" = "Sahih al-Boekhari 360";
"discovery.card.sunnah_bukhari_360.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) zei: \"Wie in één kledingstuk bidt, moet de uiteinden ervan kruisen (over de schouders).\"";
"discovery.card.sunnah_bukhari_360.source" = "Sahih al-Bukhari 360";

"discovery.card.sunnah_bukhari_362.title" = "Sahih al-Boekhari 362";
"discovery.card.sunnah_bukhari_362.meaning" = "Overgeleverd door Sahl: De mannen baden met de Profeet (ﷺ) met hun Izars om hun nek gebonden, zoals jongens dat deden; daarom zei de Profeet (ﷺ) tegen de vrouwen dat zij hun hoofden niet mochten opheffen tot de mannen rechtop zaten (tijdens het gebed).";
"discovery.card.sunnah_bukhari_362.source" = "Sahih al-Bukhari 362";

"discovery.card.sunnah_bukhari_372.title" = "Sahih al-Boekhari 372";
"discovery.card.sunnah_bukhari_372.meaning" = "Overgeleverd door `Aisha: De Boodschapper van Allah (ﷺ) verrichtte het Fajr-gebed, en sommige gelovige vrouwen, bedekt met hun sluierdoeken, woonden het Fajr-gebed met hem bij en keerden daarna onherkend naar hun huizen terug.";
"discovery.card.sunnah_bukhari_372.source" = "Sahih al-Bukhari 372";

"discovery.card.sunnah_bukhari_375.title" = "Sahih al-Boekhari 375";
"discovery.card.sunnah_bukhari_375.meaning" = "Overgeleverd door `Uqba bin 'Amir: De Profeet (ﷺ) kreeg een zijden Farruj als geschenk. Hij droeg het tijdens het gebed. Toen hij zijn gebed had beëindigd, trok hij het heftig uit, alsof hij er een sterke afkeer van had, en zei: \"Dit is niet de kleding van vrome mensen die Allah vrezen.\"";
"discovery.card.sunnah_bukhari_375.source" = "Sahih al-Bukhari 375";

"discovery.card.sunnah_bukhari_381.title" = "Sahih al-Boekhari 381";
"discovery.card.sunnah_bukhari_381.meaning" = "Overgeleverd door Maimuna: De Boodschapper van Allah (ﷺ) placht op een Khumra te bidden.";
"discovery.card.sunnah_bukhari_381.source" = "Sahih al-Bukhari 381";

"discovery.card.sunnah_bukhari_383.title" = "Sahih al-Boekhari 383";
"discovery.card.sunnah_bukhari_383.meaning" = "Overgeleverd door `Aisha: De Boodschapper van Allah bad terwijl ik als een dood lichaam op het familiebed lag tussen hem en zijn Qibla.";
"discovery.card.sunnah_bukhari_383.source" = "Sahih al-Bukhari 383";

"discovery.card.sunnah_bukhari_384.title" = "Sahih al-Boekhari 384";
"discovery.card.sunnah_bukhari_384.meaning" = "Overgeleverd door `Urwa: De Profeet (ﷺ) bad terwijl `Aisha tussen hem en zijn Qibla lag op het bed waarop zij plachten te slapen.";
"discovery.card.sunnah_bukhari_384.source" = "Sahih al-Bukhari 384";

"discovery.card.sunnah_bukhari_385.title" = "Sahih al-Boekhari 385";
"discovery.card.sunnah_bukhari_385.meaning" = "Overgeleverd door Anas bin Malik: Wij plachten met de Profeet (ﷺ) te bidden, en sommigen van ons legden de uiteinden van hun kleding op de plaats van de nederwerping vanwege de verzengende hitte.";
"discovery.card.sunnah_bukhari_385.source" = "Sahih al-Bukhari 385";

"discovery.card.sunnah_bukhari_386.title" = "Sahih al-Boekhari 386";
"discovery.card.sunnah_bukhari_386.meaning" = "Overgeleverd door Abu Maslama: Sa`id bin Yazid Al-Azdi: Ik vroeg Anas bin Malik of de Profeet (ﷺ) ooit met zijn schoenen aan had gebeden. Hij antwoordde: \"Ja.\"";
"discovery.card.sunnah_bukhari_386.source" = "Sahih al-Bukhari 386";

"discovery.card.sunnah_bukhari_388.title" = "Sahih al-Boekhari 388";
"discovery.card.sunnah_bukhari_388.meaning" = "Overgeleverd door Al-Mughira bin Shu'ba: Ik hielp de Profeet (ﷺ) bij het verrichten van de wassing en hij streek met zijn natte handen over zijn Khuffs en bad.";
"discovery.card.sunnah_bukhari_388.source" = "Sahih al-Bukhari 388";

"discovery.card.sunnah_bukhari_390.title" = "Sahih al-Boekhari 390";
"discovery.card.sunnah_bukhari_390.meaning" = "Overgeleverd door 'Abdullah bin Malik: Ibn Buhaina, \"Wanneer de Profeet (ﷺ) bad, spreidde hij zijn armen zo wijd van zijn lichaam dat het wit van zijn oksels zichtbaar was.\"";
"discovery.card.sunnah_bukhari_390.source" = "Sahih al-Bukhari 390";

"discovery.card.sunnah_bukhari_391.title" = "Sahih al-Boekhari 391";
"discovery.card.sunnah_bukhari_391.meaning" = "Overgeleverd door Anas bin Malik: De Boodschapper van Allah (ﷺ) zei: \"Wie bidt zoals wij, zich naar onze Qibla keert en van onze geslachte dieren eet, is een moslim en staat onder de bescherming van Allah en Zijn Boodschapper. Verraad Allah dus niet door hen te verraden die onder Zijn bescherming staan.\"";
"discovery.card.sunnah_bukhari_391.source" = "Sahih al-Bukhari 391";

"discovery.card.sunnah_bukhari_398.title" = "Sahih al-Boekhari 398";
"discovery.card.sunnah_bukhari_398.meaning" = "Overgeleverd door Ibn `Abbas: Toen de Profeet (ﷺ) de Ka`ba binnenging, riep hij Allah aan aan elke zijde ervan en bad hij niet tot hij naar buiten kwam; daarna verrichtte hij een gebed van twee rak`at gericht naar de Ka`ba en zei: \"Dit is de Qibla.\"";
"discovery.card.sunnah_bukhari_398.source" = "Sahih al-Bukhari 398";

"discovery.card.sunnah_bukhari_400.title" = "Sahih al-Boekhari 400";
"discovery.card.sunnah_bukhari_400.meaning" = "Overgeleverd door Jabir: De Boodschapper van Allah (ﷺ) placht (vrijwillige, niet-verplichte gebeden) te bidden terwijl hij op zijn rijdier (Rahila) zat, waarheen het zich ook wendde, en wanneer hij het verplichte gebed wilde verrichten, steeg hij af en bad hij gericht naar de Qibla.";
"discovery.card.sunnah_bukhari_400.source" = "Sahih al-Bukhari 400";

"discovery.card.sunnah_bukhari_404.title" = "Sahih al-Boekhari 404";
"discovery.card.sunnah_bukhari_404.meaning" = "Overgeleverd door `Abdullah: Eens verrichtte de Profeet (ﷺ) vijf rak`at in het Zuhr-gebed. Hem werd gevraagd: \"Is er een vermeerdering in het gebed?\" De Profeet (ﷺ) zei: \"En wat is dat?\" Zij zeiden: \"U hebt vijf rak`at gebeden.\" Toen boog hij zijn benen en verrichtte twee nederwerpingen (van Sahu).";
"discovery.card.sunnah_bukhari_404.source" = "Sahih al-Bukhari 404";

"discovery.card.sunnah_bukhari_407.title" = "Sahih al-Boekhari 407";
"discovery.card.sunnah_bukhari_407.meaning" = "Overgeleverd door `Aisha: (de moeder van de gelovigen) De Boodschapper van Allah (ﷺ) zag neusafscheiding, speeksel of slijm op de muur van de moskee in de richting van de Qibla en schraapte het weg.";
"discovery.card.sunnah_bukhari_407.source" = "Sahih al-Bukhari 407";

"discovery.card.sunnah_bukhari_412.title" = "Sahih al-Boekhari 412";
"discovery.card.sunnah_bukhari_412.meaning" = "Overgeleverd door Anas: De Profeet (ﷺ) zei: \"Niemand van jullie mag vóór zich of naar rechts spugen, maar hij mag naar links of onder zijn voet spugen.\"";
"discovery.card.sunnah_bukhari_412.source" = "Sahih al-Bukhari 412";

"discovery.card.sunnah_bukhari_413.title" = "Sahih al-Boekhari 413";
"discovery.card.sunnah_bukhari_413.meaning" = "Overgeleverd door Anas bin Malik: De Profeet (ﷺ) zei: \"Een gelovige spreekt tijdens het gebed in het bijzonder tot zijn Heer, dus hij mag noch vóór zich noch naar rechts spugen, maar hij mag naar links of onder zijn voet spugen.\"";
"discovery.card.sunnah_bukhari_413.source" = "Sahih al-Bukhari 413";

"discovery.card.sunnah_bukhari_414.title" = "Sahih al-Boekhari 414";
"discovery.card.sunnah_bukhari_414.meaning" = "Overgeleverd door Abu Sa`id: De Profeet (ﷺ) zag slijm op (de muur van) de moskee in de richting van de Qibla en schraapte het weg met grind. Daarna verbood hij het spugen naar voren of naar rechts, maar stond het toe naar links of onder de linker voet.";
"discovery.card.sunnah_bukhari_414.source" = "Sahih al-Bukhari 414";

"discovery.card.sunnah_bukhari_415.title" = "Sahih al-Boekhari 415";
"discovery.card.sunnah_bukhari_415.meaning" = "Overgeleverd door Anas bin Malik: De Profeet (ﷺ) zei: \"Spugen in de moskee is een zonde, en de verzoening ervan is het te begraven.\"";
"discovery.card.sunnah_bukhari_415.source" = "Sahih al-Bukhari 415";

"discovery.card.sunnah_bukhari_418.title" = "Sahih al-Boekhari 418";
"discovery.card.sunnah_bukhari_418.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) zei: \"Denken jullie of zien jullie dat mijn gezicht naar de Qibla is gekeerd? Bij Allah, noch jullie nederigheid noch jullie buiging is voor mij verborgen; voorzeker, ik zie jullie vanaf mijn rug.\"";
"discovery.card.sunnah_bukhari_418.source" = "Sahih al-Bukhari 418";

"discovery.card.sunnah_bukhari_419.title" = "Sahih al-Boekhari 419";
"discovery.card.sunnah_bukhari_419.meaning" = "Overgeleverd door Anas bin Malik: De Profeet (ﷺ) ging ons voor in een gebed en ging daarna op de preekstoel staan en zei: \"In jullie gebed en buiging zie ik jullie zeker vanaf mijn rug, zoals ik jullie zie (terwijl ik naar jullie kijk).\"";
"discovery.card.sunnah_bukhari_419.source" = "Sahih al-Bukhari 419";

"discovery.card.sunnah_bukhari_422.title" = "Sahih al-Boekhari 422";
"discovery.card.sunnah_bukhari_422.meaning" = "Overgeleverd door Anas: Ik vond de Profeet (ﷺ) in de moskee samen met enkele mensen. Hij zei tegen mij: \"Heeft Abu Talha jou gestuurd?\" Ik zei: \"Ja.\" Hij zei: \"Voor een maaltijd?\" Ik zei: \"Ja.\" Toen zei hij tegen zijn metgezellen: \"Sta op.\" Zij vertrokken en ik liep voor hen uit.";
"discovery.card.sunnah_bukhari_422.source" = "Sahih al-Bukhari 422";

"discovery.card.sunnah_bukhari_424.title" = "Sahih al-Boekhari 424";
"discovery.card.sunnah_bukhari_424.meaning" = "Overgeleverd door `Itban bin Malik: De Profeet (ﷺ) kwam bij mij thuis en zei: \"Waar wil je dat ik bid?\" Ik wees naar een plaats. De Profeet zei toen: \"Allahu Akbar\", en wij stelden ons achter hem op en hij verrichtte een gebed van twee rak`at.";
"discovery.card.sunnah_bukhari_424.source" = "Sahih al-Bukhari 424";

"discovery.card.sunnah_bukhari_426.title" = "Sahih al-Boekhari 426";
"discovery.card.sunnah_bukhari_426.meaning" = "Overgeleverd door `Aisha: De Profeet (ﷺ) placht alles van rechts te beginnen (voor goede dingen) wanneer dat mogelijk was in al zijn aangelegenheden; bijvoorbeeld: bij het wassen, kammen of het aantrekken van schoenen.";
"discovery.card.sunnah_bukhari_426.source" = "Sahih al-Bukhari 426";

"discovery.card.sunnah_bukhari_429.title" = "Sahih al-Boekhari 429";
"discovery.card.sunnah_bukhari_429.meaning" = "Overgeleverd door Abu Al-Taiyah: Anas zei: \"De Profeet (ﷺ) bad in de schapenstal.\" Later hoorde ik hem zeggen: \"Hij bad in de schapenstallen vóór de bouw van de moskee.\"";
"discovery.card.sunnah_bukhari_429.source" = "Sahih al-Bukhari 429";

"discovery.card.sunnah_bukhari_430.title" = "Sahih al-Boekhari 430";
"discovery.card.sunnah_bukhari_430.meaning" = "Overgeleverd door Nafi`: Ik zag Ibn `Umar bidden terwijl hij zijn kameel als Sutra vóór zich nam, en hij zei: \"Ik zag de Profeet hetzelfde doen.\"";
"discovery.card.sunnah_bukhari_430.source" = "Sahih al-Bukhari 430";

"discovery.card.sunnah_bukhari_431.title" = "Sahih al-Boekhari 431";
"discovery.card.sunnah_bukhari_431.meaning" = "Overgeleverd door `Abdullah bin `Abbas: De zon werd verduisterd en de Boodschapper van Allah (ﷺ) verrichtte het gebed van de zonsverduistering en zei: \"Het Hellevuur is mij (nu) getoond, en ik heb nooit een erger en verschrikkelijker gezicht gezien dan wat ik vandaag heb gezien.\"";
"discovery.card.sunnah_bukhari_431.source" = "Sahih al-Bukhari 431";

"discovery.card.sunnah_bukhari_432.title" = "Sahih al-Boekhari 432";
"discovery.card.sunnah_bukhari_432.meaning" = "Overgeleverd door Ibn `Umar: De Profeet (ﷺ) had gezegd: \"Verricht een deel van jullie gebeden (Nawafil) thuis, en maak van jullie huizen geen graven.\"";
"discovery.card.sunnah_bukhari_432.source" = "Sahih al-Bukhari 432";

"discovery.card.sunnah_bukhari_437.title" = "Sahih al-Boekhari 437";
"discovery.card.sunnah_bukhari_437.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) zei: \"Moge de vloek van Allah op de joden rusten, want zij bouwden de plaatsen van aanbidding op de graven van hun Profeten.\"";
"discovery.card.sunnah_bukhari_437.source" = "Sahih al-Bukhari 437";

"discovery.card.sunnah_bukhari_440.title" = "Sahih al-Boekhari 440";
"discovery.card.sunnah_bukhari_440.meaning" = "Overgeleverd door Nafi`: `Abdullah bin `Umar zei: Ik placht in de moskee van de Profeet (ﷺ) te slapen toen ik jong en ongehuwd was.";
"discovery.card.sunnah_bukhari_440.source" = "Sahih al-Bukhari 440";

"discovery.card.sunnah_bukhari_443.title" = "Sahih al-Boekhari 443";
"discovery.card.sunnah_bukhari_443.meaning" = "Overgeleverd door Jabir bin `Abdullah: Ik ging naar de Profeet (ﷺ) in de moskee (de onderverteller Mis`ar meende dat Jabir had gezegd: \"In de voormiddag.\") Hij beval mij twee rak`at te bidden. Hij was mij wat geld schuldig, betaalde het mij terug en gaf meer dan wat mij toekwam.";
"discovery.card.sunnah_bukhari_443.source" = "Sahih al-Bukhari 443";

"discovery.card.sunnah_bukhari_444.title" = "Sahih al-Boekhari 444";
"discovery.card.sunnah_bukhari_444.meaning" = "Overgeleverd door Abu Qatada Al-Aslami: De Boodschapper van Allah (ﷺ) zei: \"Als iemand van jullie een moskee binnengaat, moet hij twee rak`at bidden voordat hij gaat zitten.\"";
"discovery.card.sunnah_bukhari_444.source" = "Sahih al-Bukhari 444";

"discovery.card.sunnah_bukhari_445.title" = "Sahih al-Boekhari 445";
"discovery.card.sunnah_bukhari_445.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) zei: \"De engelen blijven voor ieder van jullie Allah om vergeving vragen, zolang hij op zijn Musalla (gebedsplaats) is en geen wind laat (Hadath). Zij zeggen: 'O Allah! Vergeef hem, o Allah! Wees hem barmhartig.'\"";
"discovery.card.sunnah_bukhari_445.source" = "Sahih al-Bukhari 445";

"discovery.card.sunnah_bukhari_448.title" = "Sahih al-Boekhari 448";
"discovery.card.sunnah_bukhari_448.meaning" = "Overgeleverd door Sahl: De Boodschapper van Allah (ﷺ) stuurde iemand naar een vrouw om haar te zeggen: \"Beveel haar slaaf, een timmerman, een houten preekstoel voor hem klaar te maken om op te zitten.\"";
"discovery.card.sunnah_bukhari_448.source" = "Sahih al-Bukhari 448";

"discovery.card.sunnah_bukhari_449.title" = "Sahih al-Boekhari 449";
"discovery.card.sunnah_bukhari_449.meaning" = "Overgeleverd door Jabir: Een vrouw zei: \"O Boodschapper van Allah (ﷺ)! Zal ik iets voor u laten maken om op te zitten, want ik heb een slaaf die timmerman is?\" Hij antwoordde: \"Ja, als je wilt.\" Dus liet zij die preekstoel maken.";
"discovery.card.sunnah_bukhari_449.source" = "Sahih al-Bukhari 449";

"discovery.card.sunnah_bukhari_451.title" = "Sahih al-Boekhari 451";
"discovery.card.sunnah_bukhari_451.meaning" = "Overgeleverd door `Amr: Ik hoorde Jabir bin `Abdullah zeggen: \"Een man liep door de moskee met pijlen. De Boodschapper van Allah ﷺ zei tegen hem: 'Houd ze bij hun punten vast.'\"";
"discovery.card.sunnah_bukhari_451.source" = "Sahih al-Bukhari 451";

"discovery.card.sunnah_bukhari_452.title" = "Sahih al-Boekhari 452";
"discovery.card.sunnah_bukhari_452.meaning" = "Overgeleverd door Abu Burda bin `Abdullah: (op gezag van zijn vader) De Profeet (ﷺ) zei: \"Wie met pijlen door onze moskeeën of markten gaat, moet ze bij de punten vasthouden, opdat hij geen moslim verwondt.\"";
"discovery.card.sunnah_bukhari_452.source" = "Sahih al-Bukhari 452";

"discovery.card.sunnah_bukhari_453.title" = "Sahih al-Boekhari 453";
"discovery.card.sunnah_bukhari_453.meaning" = "Overgeleverd door Hassan bin Thabit Al-Ansari: Ik vroeg Abu Huraira: \"Bij Allah! Zeg me de waarheid: heb je de Profeet (ﷺ) horen zeggen: 'O Hassan! Antwoord namens de Boodschapper van Allah (ﷺ). O Allah! Help hem met de Heilige Geest.'\" Abu Huraira zei: \"Ja.\"";
"discovery.card.sunnah_bukhari_453.source" = "Sahih al-Bukhari 453";

"discovery.card.sunnah_bukhari_459.title" = "Sahih al-Boekhari 459";
"discovery.card.sunnah_bukhari_459.meaning" = "Overgeleverd door `Aisha: Toen de verzen van soera \"Al-Baqara\" over woeker (Riba) werden geopenbaard, ging de Profeet (ﷺ) naar de moskee, reciteerde ze voor de mensen en verbood daarna de handel in alcohol.";
"discovery.card.sunnah_bukhari_459.source" = "Sahih al-Bukhari 459";

"discovery.card.sunnah_bukhari_460.title" = "Sahih al-Boekhari 460";
"discovery.card.sunnah_bukhari_460.meaning" = "Overgeleverd door Abu Rafi: Abu Huraira zei: \"Een man of een vrouw placht de moskee schoon te maken.\" (Een onderrapporteur zei: 'Hoogstwaarschijnlijk een vrouw.') Daarna vertelde hij de hadith van de Profeet.";
"discovery.card.sunnah_bukhari_460.source" = "Sahih al-Bukhari 460";

"discovery.card.sunnah_bukhari_464.title" = "Sahih al-Boekhari 464";
"discovery.card.sunnah_bukhari_464.meaning" = "Overgeleverd door Um Salama: Ik klaagde bij de Boodschapper van Allah (ﷺ) dat ik ziek was. Hij zei dat ik de Tawaf achter de mensen moest verrichten terwijl ik reed. Dat deed ik, en de Boodschapper van Allah (ﷺ) bad naast de Ka`ba en reciteerde de soera die begint met \"Wat-tur wa kitabin mastur\".";
"discovery.card.sunnah_bukhari_464.source" = "Sahih al-Bukhari 464";

"discovery.card.sunnah_bukhari_469.title" = "Sahih al-Boekhari 469";
"discovery.card.sunnah_bukhari_469.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) stuurde ruiters naar Najd en zij brachten een man mee genaamd Thumama bin Uthal van Bani Hanifa. Zij bonden hem vast aan een van de pilaren van de moskee.";
"discovery.card.sunnah_bukhari_469.source" = "Sahih al-Bukhari 469";

"discovery.card.sunnah_bukhari_475.title" = "Sahih al-Boekhari 475";
"discovery.card.sunnah_bukhari_475.meaning" = "Overgeleverd door `Abbad bin Tamim: dat zijn oom zei: \"Ik zag de Boodschapper van Allah (ﷺ) plat op zijn rug in de moskee liggen, met het ene been over het andere.\" Overgeleverd door Sa`id bin Al-Musaiyab dat `Umar en `Uthman hetzelfde plachten te doen.";
"discovery.card.sunnah_bukhari_475.source" = "Sahih al-Bukhari 475";

"discovery.card.sunnah_bukhari_478.title" = "Sahih al-Boekhari 478";
"discovery.card.sunnah_bukhari_478.meaning" = "Overgeleverd door Ibn `Umar of Ibn `Amr: De Profeet (ﷺ) vouwde zijn handen ineen door zijn vingers te vlechten.";
"discovery.card.sunnah_bukhari_478.source" = "Sahih al-Bukhari 478";

"discovery.card.sunnah_bukhari_480.title" = "Sahih al-Boekhari 480";
"discovery.card.sunnah_bukhari_480.meaning" = "Overgeleverd door `Abdullah: Dat de Boodschapper van Allah (ﷺ) zei: \"O `Abdullah bin `Amr! Hoe zal jouw toestand zijn wanneer je achterblijft met het schuim (de slechtsten) van de mensen?\" (Zij zullen met elkaar in conflict zijn.)";
"discovery.card.sunnah_bukhari_480.source" = "Sahih al-Bukhari 480";

"discovery.card.sunnah_bukhari_481.title" = "Sahih al-Boekhari 481";
"discovery.card.sunnah_bukhari_481.meaning" = "Overgeleverd door Abu Musa: De Profeet (ﷺ) zei: \"Een gelovige is voor een gelovige als de stenen van een muur, die elkaar versterken.\" Terwijl hij dat zei, vouwde de Profeet (ﷺ) zijn handen ineen door zijn vingers te vlechten.";
"discovery.card.sunnah_bukhari_481.source" = "Sahih al-Bukhari 481";

"discovery.card.sunnah_bukhari_484.title" = "Sahih al-Boekhari 484";
"discovery.card.sunnah_bukhari_484.meaning" = "De overgeleverde hadith gaat over de verschillende plaatsen op de weg van Medina naar Mekka waar de Profeet (ﷺ) bad en is niet vertaald.";
"discovery.card.sunnah_bukhari_484.source" = "Sahih al-Bukhari 484";

"discovery.card.sunnah_bukhari_496.title" = "Sahih al-Boekhari 496";
"discovery.card.sunnah_bukhari_496.meaning" = "Overgeleverd door Sahl (bin Sa`d): De afstand tussen de Musalla van de Boodschapper van Allah (ﷺ) en de muur was net genoeg voor een schaap om erdoor te gaan.";
"discovery.card.sunnah_bukhari_496.source" = "Sahih al-Bukhari 496";

"discovery.card.sunnah_bukhari_497.title" = "Sahih al-Boekhari 497";
"discovery.card.sunnah_bukhari_497.meaning" = "Overgeleverd door Salama: De afstand tussen de muur van de moskee en de preekstoel was nauwelijks genoeg voor een schaap om erdoor te gaan.";
"discovery.card.sunnah_bukhari_497.source" = "Sahih al-Bukhari 497";

"discovery.card.sunnah_bukhari_498.title" = "Sahih al-Boekhari 498";
"discovery.card.sunnah_bukhari_498.meaning" = "Overgeleverd door `Abdullah: De Profeet (ﷺ) liet een Harba voor zich planten (als Sutra) en bad erachter.";
"discovery.card.sunnah_bukhari_498.source" = "Sahih al-Bukhari 498";

"discovery.card.sunnah_bukhari_503.title" = "Sahih al-Boekhari 503";
"discovery.card.sunnah_bukhari_503.meaning" = "Overgeleverd door Anas: Ik zag de bekendste mensen onder de metgezellen van de Profeet (ﷺ) zich haasten naar de pilaren bij het Maghrib-gebed voordat de Profeet (ﷺ) voor het gebed kwam.";
"discovery.card.sunnah_bukhari_503.source" = "Sahih al-Bukhari 503";

"discovery.card.sunnah_bukhari_512.title" = "Sahih al-Boekhari 512";
"discovery.card.sunnah_bukhari_512.meaning" = "Overgeleverd door `Aisha: De Profeet (ﷺ) placht te bidden terwijl ik dwars in zijn bed voor hem sliep. Wanneer hij de witr wilde bidden, wekte hij mij en bad ik de witr.";
"discovery.card.sunnah_bukhari_512.source" = "Sahih al-Bukhari 512";

"discovery.card.sunnah_bukhari_515.title" = "Sahih al-Boekhari 515";
"discovery.card.sunnah_bukhari_515.meaning" = "Overgeleverd door `Aisha: (de vrouw van de Profeet) De Boodschapper van Allah (ﷺ) placht 's nachts op te staan en te bidden terwijl ik dwars tussen hem en de Qibla lag op het bed van zijn gezin.";
"discovery.card.sunnah_bukhari_515.source" = "Sahih al-Bukhari 515";

"discovery.card.sunnah_bukhari_517.title" = "Sahih al-Boekhari 517";
"discovery.card.sunnah_bukhari_517.meaning" = "Overgeleverd door Maimuna bint Al-Harith: Mijn bed stond naast de gebedsplaats (Musalla) van de Profeet (ﷺ) en soms viel zijn kledingstuk op mij terwijl ik in mijn bed lag.";
"discovery.card.sunnah_bukhari_517.source" = "Sahih al-Bukhari 517";

"discovery.card.sunnah_bukhari_518.title" = "Sahih al-Boekhari 518";
"discovery.card.sunnah_bukhari_518.meaning" = "Overgeleverd door Maimuna: De Profeet (ﷺ) placht te bidden terwijl ik naast hem sliep tijdens mijn menstruatie, en bij de sujud raakte zijn kledingstuk mij.";
"discovery.card.sunnah_bukhari_518.source" = "Sahih al-Bukhari 518";

"discovery.card.sunnah_bukhari_519.title" = "Sahih al-Boekhari 519";
"discovery.card.sunnah_bukhari_519.meaning" = "Overgeleverd door `Aisha: Het is niet goed dat jullie ons (vrouwen) gelijk hebben gemaakt aan honden en ezels. Ongetwijfeld zag ik de Boodschapper van Allah (ﷺ) bidden terwijl ik tussen hem en de Qibla lag, en wanneer hij zich wilde neerwerpen, duwde hij mijn benen en trok ik ze in.";
"discovery.card.sunnah_bukhari_519.source" = "Sahih al-Bukhari 519";

"discovery.card.sunnah_bukhari_524.title" = "Sahih al-Boekhari 524";
"discovery.card.sunnah_bukhari_524.meaning" = "Overgeleverd door Jarir bin `Abdullah: Ik gaf de eed van trouw aan de Boodschapper van Allah (ﷺ) om de gebeden volmaakt te verrichten, de Zakat regelmatig te geven en elke moslim goed advies te geven.";
"discovery.card.sunnah_bukhari_524.source" = "Sahih al-Bukhari 524";

"discovery.card.sunnah_bukhari_529.title" = "Sahih al-Boekhari 529";
"discovery.card.sunnah_bukhari_529.meaning" = "Overgeleverd door Ghailan: Anas zei: \"Ik vind (tegenwoordig) de dingen niet meer zoals ze waren in de tijd van de Profeet.\" Iemand zei: \"Het gebed (is zoals het was).\" Anas zei: \"Hebben jullie in het gebed niet gedaan wat jullie hebben gedaan?\"";
"discovery.card.sunnah_bukhari_529.source" = "Sahih al-Bukhari 529";

"discovery.card.sunnah_bukhari_532.title" = "Sahih al-Boekhari 532";
"discovery.card.sunnah_bukhari_532.meaning" = "Overgeleverd door Anas: De Profeet (ﷺ) zei: \"Verricht de sujud naar behoren en leg jullie onderarmen niet plat neer met de ellebogen op de grond, zoals een hond. En als je wilt spugen, spuug dan niet naar voren noch naar rechts, want wie in gebed is, spreekt in beslotenheid tot zijn Heer.\"";
"discovery.card.sunnah_bukhari_532.source" = "Sahih al-Bukhari 532";

"discovery.card.sunnah_bukhari_533.title" = "Sahih al-Boekhari 533";
"discovery.card.sunnah_bukhari_533.meaning" = "Overgeleverd door Abu Huraira en `Abdullah bin `Umar: De Boodschapper van Allah (ﷺ) zei: \"Als het erg heet is, bid dan het Zuhr-gebed wanneer het (iets) koeler wordt, want de hevigheid van de hitte komt van het oplaaien van het hellevuur.\"";
"discovery.card.sunnah_bukhari_533.source" = "Sahih al-Bukhari 533";

"discovery.card.sunnah_bukhari_538.title" = "Sahih al-Boekhari 538";
"discovery.card.sunnah_bukhari_538.meaning" = "Overgeleverd door Abu Sa`id: dat de Boodschapper van Allah (ﷺ) zei: \"Bid het Zuhr-gebed wanneer het (iets) koeler wordt, want de hevigheid van de hitte komt van het oplaaien van het hellevuur.\"";
"discovery.card.sunnah_bukhari_538.source" = "Sahih al-Bukhari 538";

"discovery.card.sunnah_bukhari_542.title" = "Sahih al-Boekhari 542";
"discovery.card.sunnah_bukhari_542.meaning" = "Overgeleverd door Anas bin Malik: Wanneer wij het Zuhr-gebed achter de Boodschapper van Allah (ﷺ) verrichtten, plachten wij ons neer te werpen op onze kleren om ons tegen de hitte te beschermen.";
"discovery.card.sunnah_bukhari_542.source" = "Sahih al-Bukhari 542";

"discovery.card.sunnah_bukhari_543.title" = "Sahih al-Boekhari 543";
"discovery.card.sunnah_bukhari_543.meaning" = "Overgeleverd door Ibn `Abbas: \"De Profeet (ﷺ) bad acht rak`at voor de Zuhr en de `Asr, en zeven voor de Maghrib en de `Isha in Medina.\" Aiyub zei: \"Misschien waren dat regenachtige nachten.\" Anas zei: \"Misschien.\"";
"discovery.card.sunnah_bukhari_543.source" = "Sahih al-Bukhari 543";

"discovery.card.sunnah_bukhari_544.title" = "Sahih al-Boekhari 544";
"discovery.card.sunnah_bukhari_544.meaning" = "Overgeleverd door Aisha: De Boodschapper van Allah (ﷺ) placht het `Asr-gebed te verrichten wanneer het zonlicht nog niet uit mijn kamer was verdwenen.";
"discovery.card.sunnah_bukhari_544.source" = "Sahih al-Bukhari 544";

"discovery.card.sunnah_bukhari_545.title" = "Sahih al-Boekhari 545";
"discovery.card.sunnah_bukhari_545.meaning" = "Overgeleverd door `Aisha: De Boodschapper van Allah (ﷺ) placht het `Asr-gebed te verrichten op een moment waarop het zonlicht nog in mijn kamer was en er nog geen schaduw in verschenen was.";
"discovery.card.sunnah_bukhari_545.source" = "Sahih al-Bukhari 545";

"discovery.card.sunnah_bukhari_546.title" = "Sahih al-Boekhari 546";
"discovery.card.sunnah_bukhari_546.meaning" = "Overgeleverd door Aisha: De Profeet (ﷺ) placht het `Asr-gebed te bidden op een moment waarop het zonlicht nog in mijn kamer was en er nog geen schaduw in verschenen was.";
"discovery.card.sunnah_bukhari_546.source" = "Sahih al-Bukhari 546";

"discovery.card.sunnah_bukhari_548.title" = "Sahih al-Boekhari 548";
"discovery.card.sunnah_bukhari_548.meaning" = "Overgeleverd door Anas bin Malik: Wij plachten het `Asr-gebed te bidden en daarna, als iemand naar de stam van Bani `Amr bin `Auf ging, vond hij hen nog steeds het `Asr-gebed aan het verrichten.";
"discovery.card.sunnah_bukhari_548.source" = "Sahih al-Bukhari 548";

"discovery.card.sunnah_bukhari_551.title" = "Sahih al-Boekhari 551";
"discovery.card.sunnah_bukhari_551.meaning" = "Overgeleverd door Anas bin Malik: Wij plachten het `Asr te bidden en daarna, als een van ons naar Quba' ging, kwam hij daar aan terwijl de zon nog hoog stond.";
"discovery.card.sunnah_bukhari_551.source" = "Sahih al-Bukhari 551";

"discovery.card.sunnah_bukhari_552.title" = "Sahih al-Boekhari 552";
"discovery.card.sunnah_bukhari_552.meaning" = "Overgeleverd door Ibn `Umar: De Boodschapper van Allah (ﷺ) zei: \"Wie het `Asr-gebed (opzettelijk) mist, het is alsof hij zijn familie en bezit heeft verloren.\"";
"discovery.card.sunnah_bukhari_552.source" = "Sahih al-Bukhari 552";

"discovery.card.sunnah_bukhari_553.title" = "Sahih al-Boekhari 553";
"discovery.card.sunnah_bukhari_553.meaning" = "Overgeleverd door Abu Al-Malih: Wij waren met Buraida in een gevecht op een bewolkte dag en hij zei: \"Verricht het `Asr-gebed vroeg, want de Profeet zei: 'Wie het `Asr-gebed nalaat, al zijn (goede) daden zullen tenietgedaan worden.'\"";
"discovery.card.sunnah_bukhari_553.source" = "Sahih al-Bukhari 553";

"discovery.card.sunnah_bukhari_556.title" = "Sahih al-Boekhari 556";
"discovery.card.sunnah_bukhari_556.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) zei: \"Als iemand van jullie één rak`a van het `Asr-gebed kan halen vóór zonsondergang, moet hij zijn gebed voltooien. Als iemand van jullie één rak`a van het Fajr-gebed kan halen vóór zonsopgang, moet hij zijn gebed voltooien.\"";
"discovery.card.sunnah_bukhari_556.source" = "Sahih al-Bukhari 556";

"discovery.card.sunnah_bukhari_559.title" = "Sahih al-Boekhari 559";
"discovery.card.sunnah_bukhari_559.meaning" = "Overgeleverd door Rafi` bin Khadij: Wij plachten het Maghrib-gebed met de Profeet (ﷺ) te verrichten en na het beëindigen van het gebed kon een van ons weggaan en nog zo ver zien als de plekken die een pijl bereikt wanneer hij met een boog wordt afgeschoten.";
"discovery.card.sunnah_bukhari_559.source" = "Sahih al-Bukhari 559";

"discovery.card.sunnah_bukhari_561.title" = "Sahih al-Boekhari 561";
"discovery.card.sunnah_bukhari_561.meaning" = "Overgeleverd door Salama: Wij plachten het Maghrib-gebed met de Profeet (ﷺ) te bidden wanneer de zon van de horizon verdween.";
"discovery.card.sunnah_bukhari_561.source" = "Sahih al-Bukhari 561";

"discovery.card.sunnah_bukhari_562.title" = "Sahih al-Boekhari 562";
"discovery.card.sunnah_bukhari_562.meaning" = "Overgeleverd door Ibn `Abbas: De Profeet (ﷺ) bad zeven rak`at samen en acht rak`at samen.";
"discovery.card.sunnah_bukhari_562.source" = "Sahih al-Bukhari 562";

"discovery.card.sunnah_bukhari_563.title" = "Sahih al-Boekhari 563";
"discovery.card.sunnah_bukhari_563.meaning" = "Overgeleverd door `Abdullah Al-Muzani: De Profeet (ﷺ) zei: \"Laat je niet beïnvloeden door bedoeïenen wat betreft de naam van jullie Maghrib-gebed, dat zij `Isha' noemen.\"";
"discovery.card.sunnah_bukhari_563.source" = "Sahih al-Bukhari 563";

"discovery.card.sunnah_bukhari_568.title" = "Sahih al-Boekhari 568";
"discovery.card.sunnah_bukhari_568.meaning" = "Overgeleverd door Abu Barza: De Boodschapper van Allah (ﷺ) hield er niet van om vóór het `Isha'-gebed te slapen en erna te praten.";
"discovery.card.sunnah_bukhari_568.source" = "Sahih al-Bukhari 568";

"discovery.card.sunnah_bukhari_574.title" = "Sahih al-Boekhari 574";
"discovery.card.sunnah_bukhari_574.meaning" = "Overgeleverd door Abu Bakr bin Abi Musa: Mijn vader zei: \"De Boodschapper van Allah (ﷺ) zei: 'Wie de twee koele gebeden (`Asr en Fajr) bidt, zal naar het Paradijs gaan.'\"";
"discovery.card.sunnah_bukhari_574.source" = "Sahih al-Bukhari 574";

"discovery.card.sunnah_bukhari_577.title" = "Sahih al-Boekhari 577";
"discovery.card.sunnah_bukhari_577.meaning" = "Overgeleverd door Sahl bin Sa`d: Ik placht de \"Suhur\"-maaltijd met mijn gezin te nemen en me te haasten om het Fajr-gebed (ochtendgebed) met de Boodschapper van Allah (ﷺ) te halen.";
"discovery.card.sunnah_bukhari_577.source" = "Sahih al-Bukhari 577";

"discovery.card.sunnah_bukhari_578.title" = "Sahih al-Boekhari 578";
"discovery.card.sunnah_bukhari_578.meaning" = "Overgeleverd door `Aisha: De gelovige vrouwen, bedekt met hun sluierdoeken, plachten het Fajr-gebed bij te wonen met de Boodschapper van Allah ﷺ, en na het gebed keerden zij naar huis terug en niemand kon hen herkennen vanwege de duisternis.";
"discovery.card.sunnah_bukhari_578.source" = "Sahih al-Bukhari 578";

"discovery.card.sunnah_bukhari_579.title" = "Sahih al-Boekhari 579";
"discovery.card.sunnah_bukhari_579.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) zei: \"Wie één rak`a (van het Fajr-gebed) vóór zonsopgang kan halen, heeft het (ochtend)gebed gehaald, en wie één rak`a van het `Asr-gebed vóór zonsondergang kan halen, heeft het (`Asr-)gebed gehaald.\"";
"discovery.card.sunnah_bukhari_579.source" = "Sahih al-Bukhari 579";

"discovery.card.sunnah_bukhari_580.title" = "Sahih al-Boekhari 580";
"discovery.card.sunnah_bukhari_580.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) zei: \"Wie één rak`a van een gebed kan halen (op zijn juiste tijd), heeft het gebed gehaald.\"";
"discovery.card.sunnah_bukhari_580.source" = "Sahih al-Bukhari 580";

"discovery.card.sunnah_bukhari_581.title" = "Sahih al-Boekhari 581";
"discovery.card.sunnah_bukhari_581.meaning" = "Overgeleverd door `Umar: \"De Profeet (ﷺ) verbood te bidden na het Fajr-gebed tot de zon opkomt en na het `Asr-gebed tot de zon ondergaat.\" Overgeleverd door Ibn `Abbas: Sommige mensen vertelden mij dezelfde overlevering (als hierboven).";
"discovery.card.sunnah_bukhari_581.source" = "Sahih al-Bukhari 581";

"discovery.card.sunnah_bukhari_585.title" = "Sahih al-Boekhari 585";
"discovery.card.sunnah_bukhari_585.meaning" = "Overgeleverd door Ibn `Umar: De Boodschapper van Allah (ﷺ) zei: \"Niemand van jullie moet proberen te bidden bij zonsopgang of zonsondergang.\"";
"discovery.card.sunnah_bukhari_585.source" = "Sahih al-Bukhari 585";

"discovery.card.sunnah_bukhari_586.title" = "Sahih al-Boekhari 586";
"discovery.card.sunnah_bukhari_586.meaning" = "Overgeleverd door Abu Sa`id Al-Khudri: Ik hoorde de Boodschapper van Allah (ﷺ) zeggen: \"Er is geen gebed na het ochtendgebed tot de zon opkomt, en er is geen gebed na het `Asr-gebed tot de zon ondergaat.\"";
"discovery.card.sunnah_bukhari_586.source" = "Sahih al-Bukhari 586";

"discovery.card.sunnah_bukhari_587.title" = "Sahih al-Boekhari 587";
"discovery.card.sunnah_bukhari_587.meaning" = "Overgeleverd door Muawiya: Jullie verrichten een gebed dat ik de Boodschapper van Allah (ﷺ) niet heb zien verrichten toen wij in zijn gezelschap waren, en hij had het zeker verboden (namelijk twee rak`at na het `Asr-gebed).";
"discovery.card.sunnah_bukhari_587.source" = "Sahih al-Bukhari 587";

"discovery.card.sunnah_bukhari_588.title" = "Sahih al-Boekhari 588";
"discovery.card.sunnah_bukhari_588.meaning" = "Overgeleverd door Abu Huraira: De Boodschapper van Allah (ﷺ) verbood het verrichten van twee gebeden: -1. na het ochtendgebed tot de zon opkomt. -2. na het `Asr-gebed tot de zon ondergaat.";
"discovery.card.sunnah_bukhari_588.source" = "Sahih al-Bukhari 588";

"discovery.card.sunnah_bukhari_589.title" = "Sahih al-Boekhari 589";
"discovery.card.sunnah_bukhari_589.meaning" = "Overgeleverd door Ibn `Umar: Ik bid zoals ik mijn metgezellen heb zien bidden. Ik verbied het bidden op geen enkel moment van de dag of de nacht, behalve bij zonsondergang en zonsopgang.";
"discovery.card.sunnah_bukhari_589.source" = "Sahih al-Bukhari 589";

"discovery.card.sunnah_bukhari_591.title" = "Sahih al-Boekhari 591";
"discovery.card.sunnah_bukhari_591.meaning" = "Overgeleverd door de vader van Hisham: `Aisha (zich tot mij richtend) zei: \"O zoon van mijn zuster! De Profeet (ﷺ) miste nooit twee sujud (dat wil zeggen rak`at) na het `Asr-gebed in mijn huis.\"";
"discovery.card.sunnah_bukhari_591.source" = "Sahih al-Bukhari 591";

"discovery.card.sunnah_bukhari_592.title" = "Sahih al-Boekhari 592";
"discovery.card.sunnah_bukhari_592.meaning" = "Overgeleverd door `Aisha: De Boodschapper van Allah (ﷺ) miste nooit twee rak`at vóór het Fajr-gebed en na het `Asr-gebed, openlijk en in het geheim.";
"discovery.card.sunnah_bukhari_592.source" = "Sahih al-Bukhari 592";

"discovery.card.sunnah_bukhari_593.title" = "Sahih al-Boekhari 593";
"discovery.card.sunnah_bukhari_593.meaning" = "Overgeleverd door `Aisha: Telkens wanneer de Profeet (ﷺ) na het `Asr-gebed bij mij kwam, bad hij altijd twee rak`at.";
"discovery.card.sunnah_bukhari_593.source" = "Sahih al-Bukhari 593";

"discovery.card.fact_prophet_adam.title" = "Profeet Adam";
"discovery.card.fact_prophet_adam.meaning" = "De Koran noemt de profeet Adam. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_adam.source" = "Qur’an 2:31";

"discovery.card.fact_prophet_idris.title" = "Profeet Idris";
"discovery.card.fact_prophet_idris.meaning" = "De Koran noemt de profeet Idris. Zijn verhaal hoort bij de leiding van het Boek, geen sage.";
"discovery.card.fact_prophet_idris.source" = "Qur’an 19:56";

