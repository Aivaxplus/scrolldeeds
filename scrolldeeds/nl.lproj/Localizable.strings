"discovery.explain.allah_name.title" = "%@, een naam van Allah";
"discovery.explain.allah_name.body" = "%@ is één van de namen van Allah. Deze titel van barmhartigheid behoort alleen aan Hem toe.";
"discovery.explain.muqattaat.body" = "%@ zijn letters waarmee Allah deze soera opent. De precieze betekenis is bij Allah.";

"discovery.card.smile.title" = "Een glimlach is sadaqah";
"discovery.card.smile.meaning" = "De Profeet ﷺ zei: “Jouw glimlach in het gezicht van je broeder is sadaqah.”";
"discovery.card.smile.source" = "Jami‘ at-Tirmidhi 1956 (hasan)";

"discovery.card.salam.title" = "Verspreid de salam";
"discovery.card.salam.meaning" = "Iemand vroeg welke islam het beste is. De Profeet ﷺ zei: mensen te eten geven, en de salam te geven aan wie je kent en wie je niet kent. Hij zei ook: verspreid de groet van vrede onder elkaar.";
"discovery.card.salam.source" = "Sahih al-Bukhari 28 · Sahih Muslim 54";

"discovery.card.right_hand.title" = "Eet met je rechterhand";
"discovery.card.right_hand.meaning" = "De Profeet ﷺ zei: “Als een van jullie eet, laat hem dan met zijn rechterhand eten, en als hij drinkt, laat hem dan met zijn rechterhand drinken, want de shaytan eet en drinkt met zijn linkerhand.”";
"discovery.card.right_hand.source" = "Sahih Muslim 2020";

"discovery.card.bismillah_eat.title" = "Begin met Bismillah";
"discovery.card.bismillah_eat.meaning" = "De Profeet ﷺ zei: als een van jullie eet, laat hem dan de naam van Allah noemen. Vergeet hij het aan het begin, laat hem zeggen: “In de naam van Allah, aan het begin ervan en aan het einde.”";
"discovery.card.bismillah_eat.source" = "Sunan Abi Dawud 3767 · Jami‘ at-Tirmidhi 1858";

"discovery.card.right_shoe.title" = "Begin met de rechter sandaal";
"discovery.card.right_shoe.meaning" = "De Profeet ﷺ zei: “Als een van jullie sandalen aantrekt, laat hem dan met rechts beginnen; en als hij ze uittrekt, laat hem dan met links beginnen.”";
"discovery.card.right_shoe.source" = "Sahih al-Bukhari 5855";

"discovery.card.siwak.title" = "De siwak";
"discovery.card.siwak.meaning" = "De Profeet ﷺ zei: “Als ik geen moeite vreesde voor mijn ummah, zou ik hun hebben bevolen de siwak te gebruiken bij elk gebed.”";
"discovery.card.siwak.source" = "Sahih al-Bukhari 887 · Sahih Muslim 252";

"discovery.card.anger.title" = "Kracht is zelfbeheersing";
"discovery.card.anger.meaning" = "De Profeet ﷺ zei: “De sterke is niet wie mensen met kracht overwint; de sterke is wie zichzelf beheerst als hij boos is.”";
"discovery.card.anger.source" = "Sahih al-Bukhari 6114 · Sahih Muslim 2609";

"discovery.card.visit_sick.title" = "Bezoek de zieke";
"discovery.card.visit_sick.meaning" = "De Profeet ﷺ zei: “De rechten van een moslim op een moslim zijn vijf: de groet beantwoorden, de zieke bezoeken, de begrafenis volgen, een uitnodiging aannemen, en ‘yarhamuk Allah’ zeggen tegen wie niest.”";
"discovery.card.visit_sick.source" = "Sahih al-Bukhari 1240 · Sahih Muslim 2162";

"discovery.card.two_words.title" = "Twee woorden, zwaar op de Weegschaal";
"discovery.card.two_words.meaning" = "De Profeet ﷺ zei: “Er zijn twee woorden die licht zijn op de tong, zwaar op de Weegschaal, en geliefd bij de Meest Barmhartige: Verheven is Allah en Hem komt de lof toe; verheven is Allah, de Geweldige.”";
"discovery.card.two_words.source" = "Sahih al-Bukhari 6406 · Sahih Muslim 2694";

"discovery.card.ease.title" = "Met de moeilijkheid komt verlichting";
"discovery.card.ease.meaning" = "Allah zegt: “Voorwaar, met de moeilijkheid komt verlichting.” De verlichting wordt beloofd mét de last — niet alleen erna.";
"discovery.card.ease.source" = "Koran 94:5–6";

"discovery.card.neighbor.title" = "Eer je buur";
"discovery.card.neighbor.meaning" = "De Profeet ﷺ zei: “Jibril bleef mij over de buur adviseren totdat ik dacht dat hij hem een aandeel in de erfenis zou geven.”";
"discovery.card.neighbor.source" = "Sahih al-Bukhari 6014 · Sahih Muslim 2624";

"discovery.card.knowledge.title" = "Mijn Heer, vermeerder mij in kennis";
"discovery.card.knowledge.meaning" = "Allah leerde Zijn Boodschapper ﷺ deze dua: “Mijn Heer, vermeerder mij in kennis.”";
"discovery.card.knowledge.source" = "Koran 20:114";

"discovery.card.intention.title" = "Daden zijn naar intentie";
"discovery.card.intention.meaning" = "De Profeet ﷺ zei: “Daden zijn slechts naar intenties, en ieder mens krijgt wat hij van plan was.”";
"discovery.card.intention.source" = "Sahih al-Bukhari 1 · Sahih Muslim 1907";

"discovery.card.half_date.title" = "Zelfs een halve dadel";
"discovery.card.half_date.meaning" = "De Profeet ﷺ zei: “Bescherm julliezelf tegen het Vuur, al is het met een halve dadel aan sadaqah.”";
"discovery.card.half_date.source" = "Sahih al-Bukhari 1417 · Sahih Muslim 1016";

"discovery.card.remove_harm.title" = "Haal iets schadelijks van de weg";
"discovery.card.remove_harm.meaning" = "De Profeet ﷺ zei: “Het geloof heeft meer dan zeventig takken. De hoogste is te zeggen dat er geen god is dan Allah, en de laagste is iets schadelijks van de weg te halen.”";
"discovery.card.remove_harm.source" = "Sahih Muslim 35";

"discovery.card.ikhlas.title" = "Soera al-Ikhlas";
"discovery.card.ikhlas.meaning" = "De Profeet ﷺ zei dat “Zeg: Hij is Allah, de Enige” gelijk is aan een derde van de Koran.";
"discovery.card.ikhlas.source" = "Koran 112 · Sahih al-Bukhari 5013";

"discovery.card.kursi.title" = "Ayat al-Kursi";
"discovery.card.kursi.meaning" = "“Allah — er is geen god dan Hij, de Levende, de Onderhouder.” In een sahih bericht werd tegen wie dit vers ’s nachts reciteerde gezegd dat hij tot de ochtend bewaakt zou worden; de Profeet ﷺ bevestigde dat.";
"discovery.card.kursi.source" = "Koran 2:255 · Sahih al-Bukhari 2311";

"discovery.card.mercy.title" = "Wees barmhartig";
"discovery.card.mercy.meaning" = "De Profeet ﷺ zei: “Allah toont geen barmhartigheid aan wie geen barmhartigheid toont aan de mensen.”";
"discovery.card.mercy.source" = "Sahih al-Bukhari 7376 · Sahih Muslim 2319";

"discovery.card.parents.title" = "Zeg niet eens ‘uff’";
"discovery.card.parents.meaning" = "Allah zegt: “Jullie Heer heeft bepaald dat jullie alleen Hem dienen, en dat jullie goed zijn voor de ouders. Als een van hen of beiden bij jou ouderdom bereiken, zeg dan niet ‘uff’ tegen hen, stoot hen niet af, maar spreek tot hen een edel woord.”";
"discovery.card.parents.source" = "Koran 17:23";

"discovery.card.backbite.title" = "Doe geen ghiba";
"discovery.card.backbite.meaning" = "Allah zegt: “Bespioneer elkaar niet en doe geen kwaadspreken over elkaar. Zou een van jullie het vlees van zijn dode broeder willen eten? Jullie zouden het verafschuwen.”";
"discovery.card.backbite.source" = "Koran 49:12";

"discovery.card.inshaallah.title" = "Zeg in sha Allah";
"discovery.card.inshaallah.meaning" = "Allah zegt: “En zeg nooit van iets: ‘Ik zal dat morgen doen,’ behalve [terwijl je toevoegt]: ‘Als Allah het wil.’”";
"discovery.card.inshaallah.source" = "Koran 18:23–24";

"discovery.card.purification.title" = "Reinheid is de helft van het geloof";
"discovery.card.purification.meaning" = "De Profeet ﷺ zei: “Reinheid is de helft van het geloof.”";
"discovery.card.purification.source" = "Sahih Muslim 223";

"discovery.card.conceal.title" = "Bedek een fout";
"discovery.card.conceal.meaning" = "De Profeet ﷺ zei: “Wie [de fout van] een moslim bedekt, Allah zal hem bedekken op de Dag der Opstanding.”";
"discovery.card.conceal.source" = "Sahih al-Bukhari 2442 · Sahih Muslim 2580";

"discovery.card.night_prayer.title" = "Het nachtgebed";
"discovery.card.night_prayer.meaning" = "De Profeet ﷺ zei: “Het beste gebed na de verplichte gebeden is het nachtgebed.”";
"discovery.card.night_prayer.source" = "Sahih Muslim 1163";

"discovery.card.return_salam.title" = "Beantwoord de groet";
"discovery.card.return_salam.meaning" = "Allah zegt: “Als jullie begroet worden met een groet, groet dan met iets beters, of beantwoord hem. Voorwaar, Allah neemt alles in rekening.”";
"discovery.card.return_salam.source" = "Koran 4:86";

"discovery.card.patience.title" = "Zoek hulp in geduld en gebed";
"discovery.card.patience.meaning" = "Allah zegt: “O jullie die geloven, zoek hulp door geduld en gebed. Voorwaar, Allah is met de geduldigen.”";
"discovery.card.patience.source" = "Koran 2:153";

"discovery.card.tawakkul.title" = "Allah is genoeg";
"discovery.card.tawakkul.meaning" = "Allah zegt: “En wie op Allah vertrouwt — Hij is hem genoeg. Voorwaar, Allah volbrengt Zijn zaak.”";
"discovery.card.tawakkul.source" = "Koran 65:3";

"discovery.card.istighfar.title" = "Vraag vaak om vergeving";
"discovery.card.istighfar.meaning" = "De Profeet ﷺ zei: “Bij Allah, ik vraag Allah om vergeving en keer tot Hem in tawba meer dan zeventig keer per dag.”";
"discovery.card.istighfar.source" = "Sahih al-Bukhari 6307";

"discovery.card.wudu_sleep.title" = "Slaap met wudu";
"discovery.card.wudu_sleep.meaning" = "De Profeet ﷺ zei: “Als je naar je bed gaat, verricht dan wudu zoals voor het gebed, en ga dan op je rechterzij liggen.”";
"discovery.card.wudu_sleep.source" = "Sahih al-Bukhari 247 · Sahih Muslim 2710";

"discovery.card.enter_home.title" = "Noem Allah als je binnenkomt";
"discovery.card.enter_home.meaning" = "De Profeet ﷺ zei: als een man zijn huis binnengaat en Allah noemt bij het binnengaan en bij het eten, zegt de shaytan: “Jullie hebben geen onderdak en geen avondmaal.”";
"discovery.card.enter_home.source" = "Sahih Muslim 2018";

"discovery.card.lower_gaze.title" = "Sla je blik neer";
"discovery.card.lower_gaze.meaning" = "Allah zegt: “Zeg tegen de gelovige mannen dat zij hun blik neerslaan en hun kuisheid bewaken. Dat is reiner voor hen. Voorwaar, Allah is Alwetend over wat zij doen.”";
"discovery.card.lower_gaze.source" = "Koran 24:30";

"discovery.card.upper_hand.title" = "De bovenste hand";
"discovery.card.upper_hand.meaning" = "De Profeet ﷺ zei: “De bovenste hand is beter dan de onderste. De bovenste is de gevende, de onderste is de vragende.”";
"discovery.card.upper_hand.source" = "Sahih al-Bukhari 1427 · Sahih Muslim 1033";

"discovery.card.fatiha.title" = "De Opening";
"discovery.card.fatiha.meaning" = "De Profeet ﷺ zei dat Allah zegt: Ik heb het gebed tussen Mij en Mijn dienaar in tweeën gedeeld. Als hij zegt: “Alle lof is voor Allah, Heer van de werelden,” zegt Allah: Mijn dienaar heeft Mij geprezen.";
"discovery.card.fatiha.source" = "Koran 1 · Sahih Muslim 395";

"discovery.card.honor_guest.title" = "Eer de gast";
"discovery.card.honor_guest.meaning" = "De Profeet ﷺ zei: “Wie in Allah en de Laatste Dag gelooft, laat hem zijn gast eren.”";
"discovery.card.honor_guest.source" = "Sahih al-Bukhari 6018 · Sahih Muslim 47";

"discovery.card.love_brother.title" = "Houd van voor je broeder";
"discovery.card.love_brother.meaning" = "De Profeet ﷺ zei: “Geen van jullie [waarlijk] gelooft totdat hij voor zijn broeder liefheeft wat hij voor zichzelf liefheeft.”";
"discovery.card.love_brother.source" = "Sahih al-Bukhari 13 · Sahih Muslim 45";

"discovery.card.remember_me.title" = "Gedenk Mij, Ik gedenk jullie";
"discovery.card.remember_me.meaning" = "Allah zegt: “Gedenk Mij dus; Ik zal jullie gedenken. En wees Mij dankbaar en verloochen Mij niet.”";
"discovery.card.remember_me.source" = "Koran 2:152";

"discovery.card.no_envy.title" = "Wees niet jaloers";
"discovery.card.no_envy.meaning" = "De Profeet ﷺ zei: “Wees niet jaloers op elkaar, haat elkaar niet, keer je niet van elkaar af, en wees, o dienaren van Allah, broeders.”";
"discovery.card.no_envy.source" = "Sahih al-Bukhari 6065 · Sahih Muslim 2563";

"discovery.card.truthfulness.title" = "Oprechtheid leidt naar het Paradijs";
"discovery.card.truthfulness.meaning" = "De Profeet ﷺ zei: “Oprechtheid leidt naar vroomheid, en vroomheid leidt naar het Paradijs. Een man blijft oprecht tot hij bij Allah als siddiq wordt opgeschreven.”";
"discovery.card.truthfulness.source" = "Sahih al-Bukhari 6094 · Sahih Muslim 2607";

"discovery.card.ghusl_friday.title" = "Ghusl op vrijdag";
"discovery.card.ghusl_friday.meaning" = "De Profeet ﷺ zei: “Ghusl op vrijdag is verplicht voor iedere volwassene.”";
"discovery.card.ghusl_friday.source" = "Sahih al-Bukhari 879 · Sahih Muslim 846";

"discovery.card.speak_good.title" = "Spreek goed of zwijg";
"discovery.card.speak_good.meaning" = "De Profeet ﷺ zei: “Wie in Allah en de Laatste Dag gelooft, laat hem goed spreken of zwijgen.”";
"discovery.card.speak_good.source" = "Sahih al-Bukhari 6018 · Sahih Muslim 47";

"discovery.card.fajr_sunnah.title" = "De twee rakaat van Fajr";
"discovery.card.fajr_sunnah.meaning" = "De Profeet ﷺ zei: “De twee rakaat van Fajr zijn beter dan deze wereld en alles wat erin is.”";
"discovery.card.fajr_sunnah.source" = "Sahih Muslim 725";

"discovery.card.haya.title" = "Haya hoort bij het geloof";
"discovery.card.haya.meaning" = "De Profeet ﷺ zei: “Haya is een tak van het geloof.”";
"discovery.card.haya.source" = "Sahih al-Bukhari 9 · Sahih Muslim 35";

"discovery.card.no_burden.title" = "Allah belast geen ziel";
"discovery.card.no_burden.meaning" = "Allah zegt: “Allah belast geen ziel boven haar vermogen.”";
"discovery.card.no_burden.source" = "Koran 2:286";

"discovery.card.mankind.title" = "De edelste is de meest godvruchtige";
"discovery.card.mankind.meaning" = "Allah zegt: “O mensen, Wij hebben jullie uit een man en een vrouw geschapen en jullie tot volken en stammen gemaakt, zodat jullie elkaar leren kennen. De edelste van jullie bij Allah is de meest godvruchtige.”";
"discovery.card.mankind.source" = "Koran 49:13";

