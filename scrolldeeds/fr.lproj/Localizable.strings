/* Discovery feed expansion */
"discovery.card.shukr.title" = "Si vous êtes reconnaissants, Je vous augmenterai";
"discovery.card.shukr.meaning" = "Allah dit : « Si vous êtes reconnaissants, Je vous augmenterai certes ; mais si vous niez, Mon châtiment est sévère. »";
"discovery.card.shukr.source" = "Coran 14:7";

"discovery.card.dua_near.title" = "Je suis proche";
"discovery.card.dua_near.meaning" = "Allah dit : « Quand Mes serviteurs t’interrogent sur Moi, Je suis proche. J’exauce l’appel de celui qui M’invoque quand il M’invoque. »";
"discovery.card.dua_near.source" = "Coran 2:186";

"discovery.card.no_despair.title" = "Ne désespérez pas de la miséricorde d’Allah";
"discovery.card.no_despair.meaning" = "Allah dit : « Dis : Ô Mes serviteurs qui avez commis des excès contre vous-mêmes, ne désespérez pas de la miséricorde d’Allah. Allah pardonne tous les péchés. »";
"discovery.card.no_despair.source" = "Coran 39:53";

"discovery.card.qadr.title" = "La Nuit du Décret";
"discovery.card.qadr.meaning" = "Allah dit : « La Nuit du Destin est meilleure que mille mois. »";
"discovery.card.qadr.source" = "Coran 97:3";

"discovery.card.duha_care.title" = "Ton Seigneur ne t’a pas abandonné";
"discovery.card.duha_care.meaning" = "Allah dit : « Ton Seigneur ne t’a pas abandonné et Il n’est pas mécontent. La fin est meilleure pour toi que le début. Ton Seigneur te donnera et tu seras satisfait. »";
"discovery.card.duha_care.source" = "Coran 93:3–5";

"discovery.card.asr.title" = "Par le Temps, l’homme est en perdition";
"discovery.card.asr.meaning" = "Allah dit : « Par le Temps ! L’homme est certes en perdition, sauf ceux qui croient, accomplissent les bonnes œuvres, et s’enjoignent mutuellement la vérité et la patience. »";
"discovery.card.asr.source" = "Coran 103:1–3";

"discovery.card.kawthar.title" = "Nous t’avons donné al-Kawthar";
"discovery.card.kawthar.meaning" = "Allah dit : « Nous t’avons certes donné l’Abondance. Accomplis donc la prière pour ton Seigneur et sacrifie. »";
"discovery.card.kawthar.source" = "Coran 108:1–2";

"discovery.card.no_compulsion.title" = "Nulle contrainte en religion";
"discovery.card.no_compulsion.meaning" = "Allah dit : « Nulle contrainte en religion ! La voie droite se distingue de l’égarement. »";
"discovery.card.no_compulsion.source" = "Coran 2:256";

"discovery.card.with_you.title" = "Il est avec vous où que vous soyez";
"discovery.card.with_you.meaning" = "Allah dit : « Il est avec vous où que vous soyez. Et Allah voit parfaitement ce que vous faites. »";
"discovery.card.with_you.source" = "Coran 57:4";

"discovery.card.closer.title" = "Plus proche que la veine jugulaire";
"discovery.card.closer.meaning" = "Allah dit : « Nous avons créé l’homme et Nous savons ce que son âme lui suggère, et Nous sommes plus près de lui que sa veine jugulaire. »";
"discovery.card.closer.source" = "Coran 50:16";

"discovery.card.spouses.title" = "Tendresse et miséricorde entre vous";
"discovery.card.spouses.meaning" = "Allah dit : « Il a créé pour vous, de vous, des épouses pour que vous trouviez tranquillité auprès d’elles, et Il a mis entre vous de l’affection et de la miséricorde. »";
"discovery.card.spouses.source" = "Coran 30:21";

"discovery.card.blessings_count.title" = "Vous ne pouvez dénombrer les bienfaits d’Allah";
"discovery.card.blessings_count.meaning" = "Allah dit : « Si vous comptiez les bienfaits d’Allah, vous ne pourriez les dénombrer. Allah est Pardonneur, Miséricordieux. »";
"discovery.card.blessings_count.source" = "Coran 16:18";

"discovery.card.fasting_prescribed.title" = "Le jeûne vous a été prescrit";
"discovery.card.fasting_prescribed.meaning" = "Allah dit : « Ô vous qui croyez ! Le jeûne vous a été prescrit comme il l’a été à ceux avant vous, afin que vous atteigniez la piété. »";
"discovery.card.fasting_prescribed.source" = "Coran 2:183";

"discovery.card.yunus_dua.title" = "Il n’y a de dieu que Toi";
"discovery.card.yunus_dua.meaning" = "Allah dit que Yunus invoqua dans les ténèbres : « Pas de dieu sauf Toi. Gloire à Toi ! J’ai été du nombre des injustes. »";
"discovery.card.yunus_dua.source" = "Coran 21:87";

"discovery.card.hasbuna.title" = "Allah nous suffit";
"discovery.card.hasbuna.meaning" = "Allah dit que ceux dont la foi s’accrut dirent : « Allah nous suffit, Il est le Meilleur Garant. »";
"discovery.card.hasbuna.source" = "Coran 3:173";

"discovery.card.rabbana_atina.title" = "Un bien ici-bas et dans l’au-delà";
"discovery.card.rabbana_atina.meaning" = "Allah dit : « Seigneur, donne-nous belle part ici-bas et belle part dans l’au-delà, et protège-nous du châtiment du Feu. »";
"discovery.card.rabbana_atina.source" = "Coran 2:201";

"discovery.card.be_and_it_is.title" = "Sois, et elle est";
"discovery.card.be_and_it_is.meaning" = "Allah dit : « Son commandement, quand Il veut une chose, consiste seulement à lui dire : “Sois”, et elle est. »";
"discovery.card.be_and_it_is.source" = "Coran 36:82";

"discovery.card.which_favors.title" = "Lequel des bienfaits de votre Seigneur ?";
"discovery.card.which_favors.meaning" = "Allah dit : « Lequel donc des bienfaits de votre Seigneur nierez-vous ? »";
"discovery.card.which_favors.source" = "Coran 55:13";

"discovery.card.calamity.title" = "Nul malheur sans la permission d’Allah";
"discovery.card.calamity.meaning" = "Allah dit : « Nul malheur n’atteint [quiconque] que par la permission d’Allah. Et quiconque croit en Allah, Il guide son cœur. »";
"discovery.card.calamity.source" = "Coran 64:11";

"discovery.card.death_life.title" = "Il a créé la mort et la vie";
"discovery.card.death_life.meaning" = "Allah dit : « Celui qui a créé la mort et la vie pour vous éprouver, qui de vous est le meilleur en œuvres — et Il est le Puissant, le Pardonneur. »";
"discovery.card.death_life.source" = "Coran 67:2";

"discovery.card.kafirun.title" = "À vous votre religion, à moi la mienne";
"discovery.card.kafirun.meaning" = "Allah dit : « À vous votre religion, et à moi ma religion. »";
"discovery.card.kafirun.source" = "Coran 109:6";

"discovery.card.nas.title" = "Je cherche protection auprès du Seigneur des hommes";
"discovery.card.nas.meaning" = "Allah dit : « Dis : Je cherche protection auprès du Seigneur des hommes, le Roi des hommes, le Dieu des hommes. »";
"discovery.card.nas.source" = "Coran 114:1–3";

"discovery.card.falaq.title" = "Je cherche protection auprès du Seigneur de l’aube";
"discovery.card.falaq.meaning" = "Allah dit : « Dis : Je cherche protection auprès du Seigneur de l’aube naissante, contre le mal de ce qu’Il a créé. »";
"discovery.card.falaq.source" = "Coran 113:1–2";

"discovery.card.orphans_duha.title" = "N’opprime pas l’orphelin";
"discovery.card.orphans_duha.meaning" = "Allah dit : « Quant à l’orphelin, ne le maltraite pas. Quant au demandeur, ne le repousse pas. Et quant au bienfait de ton Seigneur, proclame-le. »";
"discovery.card.orphans_duha.source" = "Coran 93:9–11";

"discovery.card.justice.title" = "Soyez stricts dans l’équité";
"discovery.card.justice.meaning" = "Allah dit : « Ô vous qui croyez ! Soyez stricts dans l’équité, témoins pour Allah, fût-ce contre vous-mêmes, ou vos parents et proches. »";
"discovery.card.justice.source" = "Coran 4:135";

"discovery.card.amanah.title" = "Rendez les dépôts à leurs ayants droit";
"discovery.card.amanah.meaning" = "Allah dit : « Allah vous commande de rendre les dépôts à leurs ayants droit, et quand vous jugez entre les gens, de juger avec justice. »";
"discovery.card.amanah.source" = "Coran 4:58";

"discovery.card.luqman_salah.title" = "Accomplis la prière, mon fils";
"discovery.card.luqman_salah.meaning" = "Luqman dit : « Ô mon fils, accomplis la prière, ordonne le convenable, interdis le blâmable, et endure ce qui t’arrive. »";
"discovery.card.luqman_salah.source" = "Coran 31:17";

"discovery.card.infaq_grain.title" = "La parabole de la dépense";
"discovery.card.infaq_grain.meaning" = "Allah dit : « Ceux qui dépensent leurs biens dans le sentier d’Allah sont comme un grain qui fait pousser sept épis, chaque épi contenant cent grains. Allah multiplie pour qui Il veut. »";
"discovery.card.infaq_grain.source" = "Coran 2:261";

"discovery.card.rabbana_forgive.title" = "Ne nous châtie pas si nous oublions";
"discovery.card.rabbana_forgive.meaning" = "Allah dit : « Seigneur, ne nous châtie pas s’il nous arrive d’oublier ou de commettre une erreur. Seigneur, ne nous charge pas d’un fardeau comme Tu en as chargé ceux avant nous. »";
"discovery.card.rabbana_forgive.source" = "Coran 2:286";

"discovery.card.establish_salah.title" = "Accomplissez la prière et acquittez la zakat";
"discovery.card.establish_salah.meaning" = "Allah dit : « Accomplissez la prière, acquittez la zakat, et inclinez-vous avec ceux qui s’inclinent. »";
"discovery.card.establish_salah.source" = "Coran 2:43";

"discovery.card.way_out.title" = "Quiconque a la taqwa, Allah lui ouvre une issue";
"discovery.card.way_out.meaning" = "Allah dit : « Quiconque craint Allah, Il lui donnera une issue favorable, et lui accordera Ses dons par [des moyens] sur lesquels il ne comptait pas. »";
"discovery.card.way_out.source" = "Coran 65:2–3";

"discovery.card.sincere_deen.title" = "N’adorer Allah qu’en Lui vouant un culte pur";
"discovery.card.sincere_deen.meaning" = "Allah dit : « Il ne leur a été commandé que d’adorer Allah, Lui vouant un culte exclusif, d’être Hanifs, d’accomplir la prière et d’acquitter la zakat. »";
"discovery.card.sincere_deen.source" = "Coran 98:5";

"discovery.card.allah_light.title" = "Allah est la Lumière des cieux et de la terre";
"discovery.card.allah_light.meaning" = "Allah dit : « Allah est la Lumière des cieux et de la terre. »";
"discovery.card.allah_light.source" = "Coran 24:35";

"discovery.card.expand_chest.title" = "N’avons-Nous pas ouvert ta poitrine ?";
"discovery.card.expand_chest.meaning" = "Allah dit : « N’avons-Nous pas ouvert pour toi ta poitrine, et déposé loin de toi ton fardeau qui pesait sur ton dos, et élevé ta renommée ? »";
"discovery.card.expand_chest.source" = "Coran 94:1–4";

"discovery.card.hikmah.title" = "Il donne la sagesse à qui Il veut";
"discovery.card.hikmah.meaning" = "Allah dit : « Il donne la sagesse à qui Il veut. Et celui à qui la sagesse est donnée, vraiment, un grand bien lui est donné. »";
"discovery.card.hikmah.source" = "Coran 2:269";

"discovery.card.five_pillars.title" = "L’islam est bâti sur cinq";
"discovery.card.five_pillars.meaning" = "Le Prophète ﷺ a dit : « L’islam est bâti sur cinq : le témoignage qu’il n’y a de dieu qu’Allah et que Muhammad est le Messager d’Allah, l’accomplissement de la prière, l’acquittement de la zakat, le Hajj et le jeûne de Ramadan. »";
"discovery.card.five_pillars.source" = "Sahih al-Bukhari 8 · Sahih Muslim 16";

"discovery.card.muslim_tongue.title" = "À l’abri de sa langue et de sa main";
"discovery.card.muslim_tongue.meaning" = "Le Prophète ﷺ a dit : « Le musulman est celui dont les musulmans sont à l’abri de sa langue et de sa main. »";
"discovery.card.muslim_tongue.source" = "Sahih al-Bukhari 10 · Sahih Muslim 41";

"discovery.card.deen_nasihah.title" = "La religion est le conseil sincère";
"discovery.card.deen_nasihah.meaning" = "Le Prophète ﷺ a dit : « La religion est le nasihah (conseil sincère). » Ils dirent : Envers qui ? Il dit : « Envers Allah, Son Livre, Son Messager, les dirigeants des musulmans et leur commun. »";
"discovery.card.deen_nasihah.source" = "Sahih Muslim 55";

"discovery.card.best_quran.title" = "Les meilleurs d’entre vous apprennent le Coran et l’enseignent";
"discovery.card.best_quran.meaning" = "Le Prophète ﷺ a dit : « Les meilleurs d’entre vous sont ceux qui apprennent le Coran et l’enseignent. »";
"discovery.card.best_quran.source" = "Sahih al-Bukhari 5027";

"discovery.card.mother_first.title" = "Ta mère, puis ta mère";
"discovery.card.mother_first.meaning" = "Un homme demanda : Qui est le plus en droit de ma bonne compagnie ? Le Prophète ﷺ dit : « Ta mère. » Il dit : Puis qui ? Il dit : « Ta mère. » Il dit : Puis qui ? Il dit : « Ta mère. » Il dit : Puis qui ? Il dit : « Ton père. »";
"discovery.card.mother_first.source" = "Sahih al-Bukhari 5971 · Sahih Muslim 2548";

"discovery.card.plant_tree.title" = "Un arbre planté est une aumône";
"discovery.card.plant_tree.meaning" = "Le Prophète ﷺ a dit : « Jamais un musulman ne plante un arbre ou ne sème une culture dont un oiseau, un humain ou un animal mange, sans que cela ne soit une aumône pour lui. »";
"discovery.card.plant_tree.source" = "Sahih Muslim 1553";

"discovery.card.seven_shade.title" = "Sept à l’ombre d’Allah";
"discovery.card.seven_shade.meaning" = "Le Prophète ﷺ a dit : « Sept seront ombragés par Allah le Jour où il n’y aura d’ombre que la Sienne : un imam juste ; un jeune qui a grandi dans l’adoration d’Allah ; un homme dont le cœur est attaché à la mosquée ; deux qui s’aiment pour Allah ; un homme qu’une femme de rang et de beauté invite et qui dit : “Je crains Allah” ; celui qui donne l’aumône si secrètement que sa gauche ignore ce que dépense sa droite ; et celui qui se souvient d’Allah en privé et dont les yeux débordent. »";
"discovery.card.seven_shade.source" = "Sahih al-Bukhari 1423 · Sahih Muslim 1031";

"discovery.card.tasbih_salah.title" = "Après la prière : 33, 33, 34";
"discovery.card.tasbih_salah.meaning" = "Le Prophète ﷺ enseigna après la salah : Subhan Allah trente-trois fois, al-hamdu lillah trente-trois fois, et Allahu akbar trente-quatre fois.";
"discovery.card.tasbih_salah.source" = "Sahih Muslim 596";

"discovery.card.hundred_tasbih.title" = "Cent fois par jour";
"discovery.card.hundred_tasbih.meaning" = "Le Prophète ﷺ a dit : « Quiconque dit “Gloire à Allah et à Lui la louange” cent fois par jour, ses péchés lui sont pardonnés même s’ils sont comme l’écume de la mer. »";
"discovery.card.hundred_tasbih.source" = "Sahih al-Bukhari 6405 · Sahih Muslim 2691";

"discovery.card.enter_masjid.title" = "Quand tu entres dans la mosquée";
"discovery.card.enter_masjid.meaning" = "Le Prophète ﷺ a dit : lorsque l’un de vous entre dans la mosquée, qu’il dise : « Ô Allah, ouvre-moi les portes de Ta miséricorde. »";
"discovery.card.enter_masjid.source" = "Sahih Muslim 713";

"discovery.card.do_not_anger.title" = "Ne te mets pas en colère";
"discovery.card.do_not_anger.meaning" = "Un homme dit au Prophète ﷺ : Conseille-moi. Il dit : « Ne te mets pas en colère. » L’homme répéta sa demande plusieurs fois, et il dit : « Ne te mets pas en colère. »";
"discovery.card.do_not_anger.source" = "Sahih al-Bukhari 6116";

"discovery.card.make_easy.title" = "Facilitez les choses";
"discovery.card.make_easy.meaning" = "Le Prophète ﷺ a dit : « Facilitez et ne rendez pas difficile. Annoncez la bonne nouvelle et ne faites pas fuir. »";
"discovery.card.make_easy.source" = "Sahih al-Bukhari 69";

"discovery.card.religion_ease.title" = "La religion est aisance";
"discovery.card.religion_ease.meaning" = "Le Prophète ﷺ a dit : « La religion est aisance. Nul n’y met de dureté contre lui-même sans qu’elle ne le vainque. Soyez donc modérés, faites de votre mieux, réjouissez-vous, et cherchez aide au matin, l’après-midi, et un peu la nuit. »";
"discovery.card.religion_ease.source" = "Sahih al-Bukhari 39";

"discovery.card.feed_hungry.title" = "Nourrissez l’affamé";
"discovery.card.feed_hungry.meaning" = "Le Prophète ﷺ a dit : « Nourrissez l’affamé, visitez le malade, et libérez le captif. »";
"discovery.card.feed_hungry.source" = "Sahih al-Bukhari 5373";

"discovery.card.good_word.title" = "Une bonne parole est une aumône";
"discovery.card.good_word.meaning" = "Le Prophète ﷺ a dit : « Une bonne parole est une aumône. »";
"discovery.card.good_word.source" = "Sahih al-Bukhari 2989 · Sahih Muslim 1009";

"discovery.card.no_cheating.title" = "Quiconque triche n’est pas des nôtres";
"discovery.card.no_cheating.meaning" = "Le Prophète ﷺ a dit : « Quiconque nous trompe n’est pas des nôtres. »";
"discovery.card.no_cheating.source" = "Sahih Muslim 102";

"discovery.card.sleep_muawwidhat.title" = "Récite les trois dernières sourates avant de dormir";
"discovery.card.sleep_muawwidhat.meaning" = "Aisha rapporta que lorsque le Prophète ﷺ se mettait au lit, il réunissait ses mains, soufflait dedans, récitait al-Ikhlas, al-Falaq et an-Nas, puis passait ses mains sur son corps.";
"discovery.card.sleep_muawwidhat.source" = "Sahih al-Bukhari 5017";

"discovery.card.treat_women.title" = "Craignez Allah au sujet des femmes";
"discovery.card.treat_women.meaning" = "Le Prophète ﷺ a dit dans le Sermon d’Adieu : « Craignez Allah au sujet des femmes, car vous les avez prises comme un dépôt d’Allah, et leur intimité vous a été rendue licite par la parole d’Allah. »";
"discovery.card.treat_women.source" = "Sahih Muslim 1218";

"discovery.card.wudu_sins.title" = "Le wudu emporte les péchés";
"discovery.card.wudu_sins.meaning" = "Le Prophète ﷺ a dit : lorsqu’un musulman — ou un croyant — fait le wudu et lave son visage, tout péché qu’il a regardé de ses yeux sort avec l’eau, ou avec la dernière goutte ; quand il lave ses mains, sortent les péchés de ses mains ; quand il lave ses pieds, sortent les péchés vers lesquels ont marché ses pieds — jusqu’à ce qu’il sorte purifié du péché.";
"discovery.card.wudu_sins.source" = "Sahih Muslim 244";

