"notification.spiritual.quran1.title" = "Souvenez-vous de Moi";
"notification.spiritual.quran1.body" = "« Souvenez-vous de Moi ; Je Me souviendrai de vous. » — Coran 2:152";
"notification.spiritual.sunnah1.title" = "Les œuvres les plus aimées";
"notification.spiritual.sunnah1.body" = "« Les œuvres les plus aimées d’Allah sont les plus constantes, même si elles sont peu. » — Sahih al-Bukhari 6465 ; Sahih Muslim 783";
"notification.spiritual.reminder1.title" = "Allah te voit";
"notification.spiritual.reminder1.body" = "Ce que tu fais maintenant revient le Jour du Jugement. Choisis ce que tu veux Lui montrer.";
"notification.spiritual.quran2.title" = "Avec la difficulté vient la facilité";
"notification.spiritual.quran2.body" = "« Certes, avec la difficulté vient une facilité. » — Coran 94:6";
"notification.spiritual.sunnah2.title" = "Dis du bien, ou tais-toi";
"notification.spiritual.sunnah2.body" = "« Quiconque croit en Allah et au Jour dernier, qu’il dise du bien ou qu’il se taise. » — Sahih al-Bukhari 6018 ; Sahih Muslim 47";
"notification.spiritual.reminder2.title" = "L’akhirah attend";
"notification.spiritual.reminder2.body" = "Cette minute compte. Un dhikr est plus léger à porter qu’une heure de scroll.";
"notification.spiritual.quran3.title" = "Rappelle, si cela est utile";
"notification.spiritual.quran3.body" = "« Rappelle donc, si le rappel doit être utile. » — Coran 87:9";
"notification.spiritual.sunnah3.title" = "Les actes sont selon les intentions";
"notification.spiritual.sunnah3.body" = "« Les actes ne valent que par les intentions, et chacun n’a que ce qu’il a eu l’intention de faire. » — Sahih al-Bukhari 1 ; Sahih Muslim 1907";
"notification.spiritual.reminder3.title" = "Où seras-tu ensuite ?";
"notification.spiritual.reminder3.body" = "Sois dans ce monde comme un voyageur. Le fil n’est pas ta maison.";
"notification.spiritual.quran4.title" = "Allah est avec les endurants";
"notification.spiritual.quran4.body" = "« Ô vous qui croyez, cherchez secours dans la patience et la prière. Allah est avec les endurants. » — Coran 2:153";
"notification.spiritual.sunnah4.title" = "Le fort";
"notification.spiritual.sunnah4.body" = "« Le fort n’est pas celui qui terrasse les gens, mais celui qui se maîtrise dans la colère. » — Sahih al-Bukhari 6114 ; Sahih Muslim 2609";
"notification.spiritual.reminder4.title" = "Un souffle est une chance";
"notification.spiritual.reminder4.body" = "Allah t’a donné un souffle de plus. Utilise-le pour l’istighfar, pas pour la vidéo suivante.";
"notification.spiritual.quran5.title" = "Les cœurs se rassurent";
"notification.spiritual.quran5.body" = "« N’est-ce point par l’évocation d’Allah que les cœurs se rassurent ? » — Coran 13:28";
"notification.spiritual.sunnah5.title" = "Facilitez et ne compliquez pas";
"notification.spiritual.sunnah5.body" = "« Facilitez et ne compliquez pas ; annoncez la bonne nouvelle et ne rebutez pas. » — Sahih al-Bukhari 69 ; Sahih Muslim 1734";
"notification.spiritual.reminder5.title" = "La tombe demandera";
"notification.spiritual.reminder5.body" = "Qu’emportes-tu : une suite de clips, ou une parole qu’Allah aime ?";
"notification.spiritual.quran6.title" = "Accomplissez la prière";
"notification.spiritual.quran6.body" = "« Et accomplissez la prière, acquittez la zakat et inclinez-vous avec ceux qui s’inclinent. » — Coran 2:43";
"notification.spiritual.sunnah6.title" = "Apprenez le Coran et enseignez-le";
"notification.spiritual.sunnah6.body" = "« Les meilleurs d’entre vous sont ceux qui apprennent le Coran et l’enseignent. » — Sahih al-Bukhari 5027";
"notification.spiritual.reminder6.title" = "Il est proche";
"notification.spiritual.reminder6.body" = "Si Mes serviteurs t’interrogent à Mon sujet, Je suis proche. Appelle-Le maintenant.";
"notification.spiritual.quran7.title" = "Ton Seigneur ne t’a pas abandonné";
"notification.spiritual.quran7.body" = "« Ton Seigneur ne t’a ni abandonné, ni détesté. » — Coran 93:3";
"notification.spiritual.sunnah7.title" = "La pureté est la moitié de la foi";
"notification.spiritual.sunnah7.body" = "« La pureté est la moitié de la foi. » — Sahih Muslim 223";
"notification.spiritual.reminder7.title" = "La balance";
"notification.spiritual.reminder7.body" = "Un Subhanallah peut peser plus que tout ce que tu as scrollé aujourd’hui.";
"notification.spiritual.quran8.title" = "Il t’a trouvé égaré et t’a guidé";
"notification.spiritual.quran8.body" = "« Et Il t’a trouvé égaré, puis Il t’a guidé. » — Coran 93:7";
"notification.spiritual.sunnah8.title" = "Sois en ce monde comme un voyageur";
"notification.spiritual.sunnah8.body" = "« Sois en ce monde comme si tu étais un étranger ou un voyageur. » — Sahih al-Bukhari 6416";
"notification.spiritual.reminder8.title" = "N’oublie pas le retour";
"notification.spiritual.reminder8.body" = "Toute âme goûtera la mort. Vis cette heure comme quelque chose dont tu devras répondre.";
"notification.spiritual.quran9.title" = "N’oublie pas ta part";
"notification.spiritual.quran9.body" = "« Et n’oublie pas ta part en ce monde. Et sois bienfaisant comme Allah a été bienfaisant envers toi. » — Coran 28:77";
"notification.spiritual.sunnah9.title" = "Aime pour ton frère";
"notification.spiritual.sunnah9.body" = "« Nul d’entre vous ne croit vraiment jusqu’à ce qu’il aime pour son frère ce qu’il aime pour lui-même. » — Sahih al-Bukhari 13 ; Sahih Muslim 45";
"notification.spiritual.reminder9.title" = "Allah suffit";
"notification.spiritual.reminder9.body" = "Ce que tu cherches dans le fil ne remplit pas ce que seul Allah remplit.";
"notification.spiritual.quran10.title" = "Invoquez-Le debout et assis";
"notification.spiritual.quran10.body" = "« Ceux qui invoquent Allah debout, assis ou couchés sur leurs côtés. » — Coran 3:191";
"notification.spiritual.sunnah10.title" = "À l’abri de la langue et de la main";
"notification.spiritual.sunnah10.body" = "« Le musulman est celui dont les musulmans sont à l’abri de sa langue et de sa main. » — Sahih al-Bukhari 10 ; Sahih Muslim 40";
"notification.spiritual.reminder10.title" = "Une parole pour Lui";
"notification.spiritual.reminder10.body" = "Dis Astaghfirullah. Cela efface. Le scroll n’ajoute que ce que tu ne veux pas porter.";
"notification.spiritual.quran11.title" = "La prière préserve de l’indécence";
"notification.spiritual.quran11.body" = "« Certes, la prière préserve de la turpitude et du blâmable, et le rappel d’Allah est plus grand. » — Coran 29:45";
"notification.spiritual.sunnah11.title" = "Deux mots, lourds dans la balance";
"notification.spiritual.sunnah11.body" = "« Deux paroles sont légères sur la langue, lourdes dans la balance, et chères au Tout Miséricordieux : Subhanallahi wa bihamdihi, Subhanallahil-Azeem. » — Sahih al-Bukhari 6406 ; Sahih Muslim 2694";
"notification.spiritual.reminder11.title" = "Le Jour arrive";
"notification.spiritual.reminder11.body" = "Nul ne sera lésé. Ce qui semble petit maintenant sera inscrit sur ta feuille.";
"notification.spiritual.quran12.title" = "Le moment n’est-il pas venu ?";
"notification.spiritual.quran12.body" = "« N’est-il pas temps pour ceux qui ont cru que leurs cœurs s’humilient à l’évocation d’Allah ? » — Coran 57:16";
"notification.spiritual.sunnah12.title" = "Ne te mets pas en colère";
"notification.spiritual.sunnah12.body" = "Quelqu’un dit : « Conseille-moi. » Il ﷺ dit : « Ne te mets pas en colère. » Il répéta, et il ﷺ continua : « Ne te mets pas en colère. » — Sahih al-Bukhari 6116";
"notification.spiritual.reminder12.title" = "Tourne ton cœur";
"notification.spiritual.reminder12.body" = "C’est dans le rappel d’Allah que les cœurs trouvent le repos.";
"notification.spiritual.quran13.title" = "Cherchez secours dans la patience";
"notification.spiritual.quran13.body" = "« Et cherchez secours dans la patience et la prière. Elle est certes lourde, sauf pour les humbles. » — Coran 2:45";
"notification.spiritual.sunnah13.title" = "Pas de miséricorde sans miséricorde";
"notification.spiritual.sunnah13.body" = "« Allah n’est pas miséricordieux envers qui n’est pas miséricordieux envers les gens. » — Sahih al-Bukhari 5997 ; Sahih Muslim 2319";
"notification.spiritual.reminder13.title" = "Pour ton Seigneur";
"notification.spiritual.reminder13.body" = "La salah, le dhikr, une ayah. Cela reste. Le fil disparaît.";
"notification.spiritual.quran14.title" = "Je suis proche";
"notification.spiritual.quran14.body" = "« Et quand Mes serviteurs t’interrogent à Mon sujet : Je suis proche. J’exauce l’appel de celui qui M’invoque lorsqu’il M’invoque. » — Coran 2:186";
"notification.spiritual.sunnah14.title" = "Toute bonne action est une aumône";
"notification.spiritual.sunnah14.body" = "« Toute bonne action est une aumône. » — Sahih al-Bukhari 6022 ; Sahih Muslim 1005";
"notification.spiritual.reminder14.title" = "Deux minutes avec Allah";
"notification.spiritual.reminder14.body" = "Pose le téléphone. Dis Subhanallah, Alhamdulillah, Allahu akbar.";
"notification.spiritual.quran15.title" = "Aucune âme n’est surchargée";
"notification.spiritual.quran15.body" = "« Allah n’impose à aucune âme une charge supérieure à sa capacité. » — Coran 2:286";
"notification.spiritual.sunnah15.title" = "Ôter un danger du chemin";
"notification.spiritual.sunnah15.body" = "« Ôter une chose nuisible du chemin est une aumône. » — Sahih al-Bukhari 2989 ; Sahih Muslim 1009";
"notification.spiritual.reminder15.title" = "Qui espères-tu rencontrer ?";
"notification.spiritual.reminder15.body" = "La rencontre avec Allah est réelle. Prépare aujourd’hui une bonne action.";
"notification.spiritual.quran16.title" = "Ne faiblissez pas et ne vous affligez pas";
"notification.spiritual.quran16.body" = "« Ne faiblissez donc pas et ne vous affligez pas : vous serez les supérieurs si vous êtes croyants. » — Coran 3:139";
"notification.spiritual.sunnah16.title" = "La haya fait partie de la foi";
"notification.spiritual.sunnah16.body" = "« La haya (pudeur) est une branche de la foi. » — Sahih al-Bukhari 24 ; Sahih Muslim 36";
"notification.spiritual.reminder16.title" = "Ce monde est court";
"notification.spiritual.reminder16.body" = "Ce que tu remets pour Allah paraîtra alors plus long que tout ce fil.";
"notification.spiritual.quran17.title" = "Soyez patients et tenez bon";
"notification.spiritual.quran17.body" = "« Ô vous qui croyez, soyez patients, rivalisez d’endurance, tenez ferme et craignez Allah, afin de réussir. » — Coran 3:200";
"notification.spiritual.sunnah17.title" = "La religion est le conseil sincère";
"notification.spiritual.sunnah17.body" = "« La religion est naseehah. » Nous dîmes : « Envers qui ? » Il dit : « Envers Allah, Son Livre, Son Messager, les dirigeants des musulmans et leur commun. » — Sahih Muslim 55";
"notification.spiritual.reminder17.title" = "Demande pardon";
"notification.spiritual.reminder17.body" = "Allah aime que tu reviennes. Un tawbah sincère pèse plus qu’un scroll parfait.";
"notification.spiritual.quran18.title" = "La prière à des temps fixés";
"notification.spiritual.quran18.body" = "« Certes, la prière a été prescrite aux croyants à des temps déterminés. » — Coran 4:103";
"notification.spiritual.sunnah18.title" = "Honore ton hôte";
"notification.spiritual.sunnah18.body" = "« Quiconque croit en Allah et au Jour dernier, qu’il honore son hôte. » — Sahih al-Bukhari 6018 ; Sahih Muslim 47";
"notification.spiritual.reminder18.title" = "Ton compte";
"notification.spiritual.reminder18.body" = "Les anges écrivent. Que ce moment soit une hasanah, pas de l’insouciance.";
"notification.spiritual.quran19.title" = "Invoque ton Seigneur en toi-même";
"notification.spiritual.quran19.body" = "« Et invoque ton Seigneur en toi-même, avec humilité et crainte, sans élever la voix, le matin et le soir. » — Coran 7:205";
"notification.spiritual.sunnah19.title" = "Les croyants se soutiennent";
