"notification.spiritual.quran22.title" = "Invoquez-Moi";
"notification.spiritual.quran22.body" = "« Et votre Seigneur dit : Invoquez-Moi ; Je vous exaucerai. » — Coran 40:60";
"notification.spiritual.sunnah22.title" = "La main d’en haut";
"notification.spiritual.sunnah22.body" = "« La main d’en haut est meilleure que celle d’en bas. Celle d’en haut donne, celle d’en bas prend. » — Sahih al-Bukhari 1429 ; Sahih Muslim 1033";
"notification.spiritual.reminder22.title" = "Reviens à Allah";
