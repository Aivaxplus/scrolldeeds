"notification.spiritual.quran23.title" = "Ne désespérez pas de Sa miséricorde";
"notification.spiritual.quran23.body" = "« Dis : Ô Mes serviteurs qui avez commis des excès contre vous-mêmes, ne désespérez pas de la miséricorde d’Allah. Allah pardonne tous les péchés. » — Coran 39:53";
"notification.spiritual.sunnah23.title" = "Satisfait d’Allah comme Seigneur";
