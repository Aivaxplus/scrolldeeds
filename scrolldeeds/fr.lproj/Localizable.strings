"conv_paywall.faq.header" = "Questions les plus fréquentes";
"conv_paywall.faq.q1" = "Est-ce que ça marche vraiment ?";
"conv_paywall.faq.a1" = "Oui. Le vrai verrouillage iOS force la pause. Une bonne action rapporte des pièces, et un cœur ouvre tes apps. Cette boucle change l’habitude, insha’Allah.";
"conv_paywall.faq.q2" = "Pourquoi Nafsi a-t-il été créé ?";
"conv_paywall.faq.a2" = "Parce que le doomscroll vole l’adoration, le focus et la paix. On a construit un système clair : verrouille les apps jusqu’à une bonne action.";
"conv_paywall.faq.q3" = "L’app va-t-elle continuer à s’améliorer ?";
"conv_paywall.faq.a3" = "Oui. On publie des mises à jour régulièrement et on reste obsédés d’aider les musulmans à construire des habitudes durables.";
"conv_paywall.faq.q4" = "Qui a créé Nafsi ?";
"conv_paywall.faq.a4" = "Assalamu alaikum — je suis Sabri, le fondateur. J’ai d’abord construit Nafsi pour moi, puis pour chaque musulman dans le même combat.";
"conv_paywall.faq.q5" = "En quoi Nafsi est différent ?";
"conv_paywall.faq.a5" = "On ne mesure pas seulement le temps d’écran. On convertit la distraction en actions — avec un vrai blocage iOS et des déblocages spirituels.";
"conv_paywall.sticky_cta" = "Bismillah, fais le pas";
"conv_paywall.team.header" = "Verrouille le téléphone. Lève-toi pour le Fajr. Maîtrise ta nafs.";
"conv_paywall.team.body" = "Nafsi verrouille tes apps jusqu’à une bonne action, et te réveille pour le Fajr jusqu’à ce que tu photographies l’objet que tu as choisi. C’est ainsi que tu prends le contrôle de ta nafs — pas plus tard, maintenant.\n\nVerrou. Action. Fajr. Des mises à jour qui gardent le système honnête.";
"conv_paywall.team.body_named" = "%@, Nafsi verrouille tes apps jusqu’à une bonne action, et te réveille pour le Fajr jusqu’à ce que tu photographies l’objet que tu as choisi. C’est ainsi que tu prends le contrôle de ta nafs — pas plus tard, maintenant.\n\nVerrou. Action. Fajr. Des mises à jour qui gardent le système honnête.";
