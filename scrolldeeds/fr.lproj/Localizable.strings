// MARK: - Traductions complètes des douâs
"dua.ayat_al_kursi.translation" = "Allah — il n'y a de divinité que Lui, le Vivant, le Subsistant. Ni la somnolence ni le sommeil ne L'affectent. À Lui appartient tout ce qui est dans les cieux et sur la terre. Qui peut intercéder auprès de Lui sans Sa permission ? Il sait ce qui est devant eux et ce qui est derrière eux, et ils n'embrassent de Sa science que ce qu'Il veut. Son Trône s'étend sur les cieux et la terre, et leur maintien ne Lui coûte aucun effort. Il est le Très Haut, l'Immense. (Coran 2:255)";
"dua.istighfar.translation" = "Ô Allah, Tu es mon Seigneur. Il n'y a de dieu que Toi. Tu m'as créé et je suis Ton serviteur. Je respecte mon pacte et ma promesse envers Toi du mieux que je peux. Je cherche refuge auprès de Toi contre le mal de ce que j'ai fait. Je reconnais Tes bienfaits envers moi et je confesse mes péchés. Pardonne-moi donc, car nul ne pardonne les péchés sauf Toi. (Sayyid al-Istighfar)";
"dua.dua_parents.translation" = "Seigneur, fais-leur miséricorde comme ils m'ont élevé quand j'étais petit. (Coran 17:24)";
"dua.dua_ummah.translation" = "Ô Allah, améliore l'état de la Oumma de Mohammed. Ô Allah, soulage la souffrance de la Oumma de Mohammed. Ô Allah, aie pitié de la Oumma de Mohammed.";
"dua.dua_loved_one.translation" = "Ô Allah, bénis-le/la dans ce que Tu lui as accordé. Pardonne-lui, aie pitié de lui/elle, accorde-lui la santé et pardonne-lui.";
"dua.verse_reflection.translation" = "Certes, dans la création des cieux et de la terre et dans l'alternance de la nuit et du jour, il y a des signes pour les personnes sensées. (Coran 3:190)";
"dua.dua_knowledge.translation" = "Seigneur, accrois-moi en connaissance. (Coran 20:114)";
"dua.dua_relief.translation" = "Ô Allah, je cherche refuge en Toi contre le souci et la tristesse.";
"dua.dua_morning.translation" = "Nous avons atteint le matin et la royauté appartient à Allah, et toute louange est à Allah.";
"dua.dua_evening.translation" = "Nous avons atteint le soir et la royauté appartient à Allah, et toute louange est à Allah.";
"dua.dua_dunya.translation" = "Seigneur, accorde-nous le bien ici-bas et le bien dans l'au-delà, et protège-nous du châtiment du Feu. (Coran 2:201)";
"dua.dua_heart.translation" = "Seigneur, ne fais pas dévier nos cœurs après nous avoir guidés, et accorde-nous une miséricorde venant de Toi. C'est Toi, certes, le Grand Donateur. (Coran 3:8)";
"dua.dua_hasbi.translation" = "Allah me suffit. Il n'y a de dieu que Lui. En Lui je place ma confiance, et Il est le Seigneur du Trône immense. (Coran 9:129)";
"dua.dua_jannah.translation" = "Ô Allah, je Te demande le Paradis et je cherche refuge auprès de Toi contre le Feu.";

// MARK: - Surah full translations (for recitation tasks)
"surah.ikhlas.translation" = "Au nom d'Allah, le Tout Miséricordieux, le Très Miséricordieux.\nDis : Il est Allah, Unique. Allah, le Seul à être imploré. Il n'a pas engendré et n'a pas été engendré. Et nul n'est égal à Lui.";
"surah.falaq.translation" = "Au nom d'Allah, le Tout Miséricordieux, le Très Miséricordieux.\nDis : Je cherche refuge auprès du Seigneur de l'aube naissante, contre le mal de ce qu'Il a créé, contre le mal des ténèbres quand elles s'étendent, contre le mal de celles qui soufflent sur les nœuds, et contre le mal de l'envieux quand il envie.";
"surah.nas.translation" = "Au nom d'Allah, le Tout Miséricordieux, le Très Miséricordieux.\nDis : Je cherche refuge auprès du Seigneur des hommes, le Roi des hommes, le Dieu des hommes, contre le mal du suggestionneur furtif qui souffle dans les poitrines des hommes, qu'il soit du nombre des djinns ou des hommes.";
"surah.fatiha.translation" = "Au nom d'Allah, le Tout Miséricordieux, le Très Miséricordieux. Louange à Allah, Seigneur des mondes, le Tout Miséricordieux, le Très Miséricordieux, Maître du Jour du Jugement. C'est Toi que nous adorons et c'est Toi dont nous implorons le secours. Guide-nous dans le droit chemin, le chemin de ceux que Tu as comblés de faveurs, non de ceux qui ont encouru Ta colère ni des égarés.";
"surah.kafirun.translation" = "Au nom d'Allah, le Tout Miséricordieux, le Très Miséricordieux. Dis : Ô vous les mécréants, je n'adore pas ce que vous adorez. Vous n'êtes pas adorateurs de ce que j'adore. Je ne suis pas adorateur de ce que vous adorez. Vous n'êtes pas adorateurs de ce que j'adore. À vous votre religion, à moi ma religion.";
"surah.kawthar.translation" = "Au nom d'Allah, le Tout Miséricordieux, le Très Miséricordieux.
Nous t'avons certes accordé Al-Kawthar. Accomplis donc la prière pour ton Seigneur et sacrifie. Celui qui te déteste est certes celui qui sera sans postérité.";
"surah.asr.translation" = "Au nom d'Allah, le Tout Miséricordieux, le Très Miséricordieux.
Par le Temps. L'homme est certes en perdition, sauf ceux qui croient, accomplissent les bonnes œuvres, s'enjoignent mutuellement la vérité et s'enjoignent mutuellement la patience.";

