"knowledge.card.smile_sadaqah.title" = "Un sourire est une sadaqa";
"knowledge.card.smile_sadaqah.arabic" = "تَبَسُّمُكَ فِي وَجْهِ أَخِيكَ صَدَقَةٌ";
"knowledge.card.smile_sadaqah.body" = "Le Prophète ﷺ a dit que ton sourire à ton frère est une sadaqa. Un petit visage, une vraie action.";
"knowledge.card.smile_sadaqah.source" = "Jami' at-Tirmidhi 1956";

"knowledge.card.bismillah_food.title" = "Commence par Bismillah";
"knowledge.card.bismillah_food.arabic" = "بِسْمِ اللَّهِ";
"knowledge.card.bismillah_food.body" = "Commence à manger et à boire avec le nom d’Allah. Si tu oublies au début, dis Bismillah au début et à la fin.";
"knowledge.card.bismillah_food.source" = "Sunan Abi Dawud 3767";

"knowledge.card.right_hand.title" = "Mange de la main droite";
"knowledge.card.right_hand.arabic" = "";
"knowledge.card.right_hand.body" = "Le Prophète ﷺ nous a appris à manger et à boire de la main droite. Une sunna discrète à chaque repas.";
"knowledge.card.right_hand.source" = "Sahih Muslim 2020";

"knowledge.card.remove_harm.title" = "Ôte un danger du chemin";
"knowledge.card.remove_harm.arabic" = "";
"knowledge.card.remove_harm.body" = "Retirer quelque chose de nuisible du chemin est une branche de la foi. L’iman a des actes que tu peux faire en marchant.";
"knowledge.card.remove_harm.source" = "Sahih Muslim 35";

"knowledge.card.greet_salam.title" = "Répands le salam";
"knowledge.card.greet_salam.arabic" = "السَّلَامُ عَلَيْكُمْ";
"knowledge.card.greet_salam.body" = "Salue ceux que tu connais et ceux que tu ne connais pas. Répandre le salam fait partie de l’islam.";
"knowledge.card.greet_salam.source" = "Sahih al-Bukhari 28 · Sahih Muslim 39";

"knowledge.card.miswak.title" = "Le siwak";
"knowledge.card.miswak.arabic" = "";
"knowledge.card.miswak.body" = "Le siwak purifie la bouche et plaît au Seigneur. Un petit bâton, une sunna aimée.";
"knowledge.card.miswak.source" = "Sahih al-Bukhari 1934";

"knowledge.card.anger_sit.title" = "Quand la colère monte, assieds-toi";
"knowledge.card.anger_sit.arabic" = "";
"knowledge.card.anger_sit.body" = "Si tu es debout, assieds-toi. Si tu es assis, allonge-toi. La colère vient de Shaytan — change de posture avant qu’il ne te change.";
"knowledge.card.anger_sit.source" = "Sunan Abi Dawud 4782";

"knowledge.card.even_date.title" = "Même une demi-datte";
"knowledge.card.even_date.arabic" = "";
"knowledge.card.even_date.body" = "Protège-toi du Feu même avec une demi-datte en aumône. Aucun don n’est trop petit s’il est sincère.";
"knowledge.card.even_date.source" = "Sahih al-Bukhari 1417";

"knowledge.card.ayatul_kursi.title" = "Ayat al-Kursi";
"knowledge.card.ayatul_kursi.arabic" = "اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ";
"knowledge.card.ayatul_kursi.body" = "Récite-la après chaque prière et avant de dormir. Un verset de protection, une nuit sous la garde d’Allah.";
"knowledge.card.ayatul_kursi.source" = "Coran 2:255 · Sahih al-Bukhari 2311";

"knowledge.card.ikhlas.title" = "Sourate al-Ikhlas";
"knowledge.card.ikhlas.arabic" = "قُلْ هُوَ اللَّهُ أَحَدٌ";
"knowledge.card.ikhlas.body" = "Égale à un tiers du Coran en récompense. Quelques lignes sur la langue, un grand poids auprès d’Allah.";
"knowledge.card.ikhlas.source" = "Sahih al-Bukhari 5013";

"knowledge.card.wudu_sleep.title" = "Dors en état de wudu";
"knowledge.card.wudu_sleep.arabic" = "";
"knowledge.card.wudu_sleep.body" = "Le Prophète ﷺ conseillait de se coucher en état de wudu. Termine la journée comme tu l’as commencée : pur pour Allah.";
"knowledge.card.wudu_sleep.source" = "Sahih al-Bukhari 247";

"knowledge.card.visit_sick.title" = "Rends visite au malade";
"knowledge.card.visit_sick.arabic" = "";
"knowledge.card.visit_sick.body" = "Visiter le malade est un droit du musulman sur le musulman. Être là est une action, pas seulement des mots.";
"knowledge.card.visit_sick.source" = "Sahih Muslim 2162";

