"discovery.explain.allah_name.title" = "%@, un nom d’Allah";
"discovery.explain.allah_name.body" = "%@ est l’un des noms d’Allah. Ce titre de miséricorde Lui appartient à Lui seul.";
"discovery.explain.muqattaat.body" = "%@ sont des lettres par lesquelles Allah a ouvert cette sourate. Leur sens exact est auprès d’Allah.";

"discovery.card.smile.title" = "Un sourire est une aumône";
"discovery.card.smile.meaning" = "Le Prophète ﷺ a dit : « Ton sourire au visage de ton frère est une aumône. »";
"discovery.card.smile.source" = "Jami‘ at-Tirmidhi 1956 (hasan)";

"discovery.card.salam.title" = "Répands le salam";
"discovery.card.salam.meaning" = "On demanda quel islam est le meilleur. Le Prophète ﷺ dit : nourrir les gens, et saluer de salam ceux que tu connais et ceux que tu ne connais pas. Il dit aussi : répandez le salut de paix entre vous.";
"discovery.card.salam.source" = "Sahih al-Bukhari 28 · Sahih Muslim 54";

"discovery.card.right_hand.title" = "Mange de la main droite";
"discovery.card.right_hand.meaning" = "Le Prophète ﷺ a dit : « Quand l’un de vous mange, qu’il mange de la main droite, et quand il boit, qu’il boive de la main droite, car le Shaytan mange et boit de la main gauche. »";
"discovery.card.right_hand.source" = "Sahih Muslim 2020";

"discovery.card.bismillah_eat.title" = "Commence par Bismillah";
"discovery.card.bismillah_eat.meaning" = "Le Prophète ﷺ a dit : quand l’un de vous mange, qu’il mentionne le nom d’Allah. S’il l’oublie au début, qu’il dise : « Au nom d’Allah, à son commencement et à sa fin. »";
"discovery.card.bismillah_eat.source" = "Sunan Abi Dawud 3767 · Jami‘ at-Tirmidhi 1858";

"discovery.card.right_shoe.title" = "Commence par la sandale droite";
"discovery.card.right_shoe.meaning" = "Le Prophète ﷺ a dit : « Si l’un de vous met ses sandales, qu’il commence par la droite ; et quand il les retire, qu’il commence par la gauche. »";
"discovery.card.right_shoe.source" = "Sahih al-Bukhari 5855";

"discovery.card.siwak.title" = "Le siwak";
"discovery.card.siwak.meaning" = "Le Prophète ﷺ a dit : « Si je ne craignais pas de rendre les choses difficiles à ma communauté, je leur aurais ordonné d’utiliser le siwak à chaque prière. »";
"discovery.card.siwak.source" = "Sahih al-Bukhari 887 · Sahih Muslim 252";

"discovery.card.anger.title" = "La force, c’est se maîtriser";
"discovery.card.anger.meaning" = "Le Prophète ﷺ a dit : « Le fort n’est pas celui qui terrasse les gens par sa force ; le fort est celui qui se maîtrise dans la colère. »";
"discovery.card.anger.source" = "Sahih al-Bukhari 6114 · Sahih Muslim 2609";

"discovery.card.visit_sick.title" = "Rends visite au malade";
"discovery.card.visit_sick.meaning" = "Le Prophète ﷺ a dit : « Les droits du musulman sur le musulman sont cinq : rendre le salut, visiter le malade, suivre le cortège funèbre, accepter une invitation, et dire “yarhamuk Allah” à celui qui éternue. »";
"discovery.card.visit_sick.source" = "Sahih al-Bukhari 1240 · Sahih Muslim 2162";

"discovery.card.two_words.title" = "Deux paroles, lourdes sur la Balance";
"discovery.card.two_words.meaning" = "Le Prophète ﷺ a dit : « Il y a deux paroles légères sur la langue, lourdes dans la Balance, et aimées du Tout Miséricordieux : Gloire à Allah et à Lui la louange ; gloire à Allah, l’Immense. »";
"discovery.card.two_words.source" = "Sahih al-Bukhari 6406 · Sahih Muslim 2694";

"discovery.card.ease.title" = "Avec la difficulté vient la facilité";
"discovery.card.ease.meaning" = "Allah dit : « Oui, avec la difficulté vient la facilité. » Le soulagement est promis avec l’épreuve — pas seulement après.";
"discovery.card.ease.source" = "Coran 94:5–6";

"discovery.card.neighbor.title" = "Honore ton voisin";
"discovery.card.neighbor.meaning" = "Le Prophète ﷺ a dit : « Jibril n’a cessé de me recommander le voisin jusqu’à ce que je pense qu’il lui donnerait une part d’héritage. »";
"discovery.card.neighbor.source" = "Sahih al-Bukhari 6014 · Sahih Muslim 2624";

"discovery.card.knowledge.title" = "Seigneur, augmente-moi en science";
"discovery.card.knowledge.meaning" = "Allah a enseigné à Son Messager ﷺ cette invocation : « Seigneur, augmente-moi en science. »";
"discovery.card.knowledge.source" = "Coran 20:114";

"discovery.card.intention.title" = "Les actes valent par les intentions";
"discovery.card.intention.meaning" = "Le Prophète ﷺ a dit : « Les actes ne valent que par les intentions, et chacun n’aura que ce qu’il a eu l’intention de faire. »";
"discovery.card.intention.source" = "Sahih al-Bukhari 1 · Sahih Muslim 1907";

"discovery.card.half_date.title" = "Même un demi-datte";
"discovery.card.half_date.meaning" = "Le Prophète ﷺ a dit : « Protégez-vous du Feu, ne serait-ce que par un demi-datte en aumône. »";
"discovery.card.half_date.source" = "Sahih al-Bukhari 1417 · Sahih Muslim 1016";

"discovery.card.remove_harm.title" = "Ôte un danger du chemin";
"discovery.card.remove_harm.meaning" = "Le Prophète ﷺ a dit : « La foi a plus de soixante-dix branches. La plus excellente est de dire qu’il n’y a de dieu qu’Allah, et la plus basse est d’ôter quelque chose de nuisible du chemin. »";
"discovery.card.remove_harm.source" = "Sahih Muslim 35";

"discovery.card.ikhlas.title" = "Sourate al-Ikhlas";
"discovery.card.ikhlas.meaning" = "Le Prophète ﷺ a dit que « Dis : Il est Allah, Unique » équivaut à un tiers du Coran.";
"discovery.card.ikhlas.source" = "Coran 112 · Sahih al-Bukhari 5013";

"discovery.card.kursi.title" = "Ayat al-Kursi";
"discovery.card.kursi.meaning" = "« Allah — il n’y a de dieu que Lui, le Vivant, Celui qui subsiste par Lui-même. » Dans un récit authentique, on dit à celui qui récita ce verset la nuit qu’il serait gardé jusqu’au matin ; le Prophète ﷺ le confirma.";
"discovery.card.kursi.source" = "Coran 2:255 · Sahih al-Bukhari 2311";

"discovery.card.mercy.title" = "Sois miséricordieux";
"discovery.card.mercy.meaning" = "Le Prophète ﷺ a dit : « Allah ne fera pas miséricorde à ceux qui ne font pas miséricorde aux gens. »";
"discovery.card.mercy.source" = "Sahih al-Bukhari 7376 · Sahih Muslim 2319";

"discovery.card.parents.title" = "Ne dis même pas « uff »";
"discovery.card.parents.meaning" = "Allah dit : « Ton Seigneur a décrété que vous n’adoriez que Lui, et que vous soyez bons envers les parents. Si l’un d’eux ou les deux atteignent la vieillesse auprès de toi, ne leur dis pas “uff”, ne les repousse pas, et parle-leur noblement. »";
"discovery.card.parents.source" = "Coran 17:23";

"discovery.card.backbite.title" = "Ne médisez pas";
"discovery.card.backbite.meaning" = "Allah dit : « Ne vous espionnez pas et ne médisez pas les uns des autres. L’un de vous aimerait-il manger la chair de son frère mort ? Vous en auriez horreur. »";
"discovery.card.backbite.source" = "Coran 49:12";

"discovery.card.inshaallah.title" = "Dis in cha Allah";
"discovery.card.inshaallah.meaning" = "Allah dit : « Et ne dis jamais d’une chose : “Je ferai cela demain,” sans ajouter : “Si Allah le veut.” »";
"discovery.card.inshaallah.source" = "Coran 18:23–24";

"discovery.card.purification.title" = "La purification est la moitié de la foi";
"discovery.card.purification.meaning" = "Le Prophète ﷺ a dit : « La purification est la moitié de la foi. »";
"discovery.card.purification.source" = "Sahih Muslim 223";

"discovery.card.conceal.title" = "Couvre une faute";
"discovery.card.conceal.meaning" = "Le Prophète ﷺ a dit : « Quiconque couvre [la faute d’]un musulman, Allah le couvrira le Jour de la Résurrection. »";
"discovery.card.conceal.source" = "Sahih al-Bukhari 2442 · Sahih Muslim 2580";

"discovery.card.night_prayer.title" = "La prière de la nuit";
"discovery.card.night_prayer.meaning" = "Le Prophète ﷺ a dit : « La meilleure prière après les prières obligatoires est la prière de la nuit. »";
"discovery.card.night_prayer.source" = "Sahih Muslim 1163";

"discovery.card.return_salam.title" = "Rends le salut";
"discovery.card.return_salam.meaning" = "Allah dit : « Lorsque vous êtes salués, rendez un salut meilleur, ou rendez-le. Allah tient compte de toute chose. »";
"discovery.card.return_salam.source" = "Coran 4:86";

"discovery.card.patience.title" = "Cherchez secours dans la patience et la prière";
"discovery.card.patience.meaning" = "Allah dit : « Ô vous qui croyez, cherchez secours dans la patience et la prière. Allah est avec les endurants. »";
"discovery.card.patience.source" = "Coran 2:153";

"discovery.card.tawakkul.title" = "Allah suffit";
"discovery.card.tawakkul.meaning" = "Allah dit : « Et quiconque s’en remet à Allah — Il lui suffit. Allah mènera à bien Son décret. »";
"discovery.card.tawakkul.source" = "Coran 65:3";

"discovery.card.istighfar.title" = "Demande souvent pardon";
"discovery.card.istighfar.meaning" = "Le Prophète ﷺ a dit : « Par Allah, je demande pardon à Allah et je reviens à Lui en tawba plus de soixante-dix fois par jour. »";
"discovery.card.istighfar.source" = "Sahih al-Bukhari 6307";

"discovery.card.wudu_sleep.title" = "Dors avec le wudu";
"discovery.card.wudu_sleep.meaning" = "Le Prophète ﷺ a dit : « Quand tu vas à ton lit, fais le wudu comme pour la prière, puis allonge-toi sur le côté droit. »";
"discovery.card.wudu_sleep.source" = "Sahih al-Bukhari 247 · Sahih Muslim 2710";

"discovery.card.enter_home.title" = "Mentionne Allah en entrant";
"discovery.card.enter_home.meaning" = "Le Prophète ﷺ a dit : lorsqu’un homme entre dans sa maison et mentionne Allah en y entrant et en mangeant, le Shaytan dit : « Vous n’avez ni gîte ni dîner. »";
"discovery.card.enter_home.source" = "Sahih Muslim 2018";

"discovery.card.lower_gaze.title" = "Baisse le regard";
"discovery.card.lower_gaze.meaning" = "Allah dit : « Dis aux croyants de baisser leurs regards et de préserver leur chasteté. C’est plus pur pour eux. Allah est parfaitement Informé de ce qu’ils font. »";
"discovery.card.lower_gaze.source" = "Coran 24:30";

"discovery.card.upper_hand.title" = "La main d’en haut";
"discovery.card.upper_hand.meaning" = "Le Prophète ﷺ a dit : « La main d’en haut est meilleure que la main d’en bas. La main d’en haut est celle qui donne, et celle d’en bas celle qui demande. »";
"discovery.card.upper_hand.source" = "Sahih al-Bukhari 1427 · Sahih Muslim 1033";

"discovery.card.fatiha.title" = "L’Ouverture";
"discovery.card.fatiha.meaning" = "Le Prophète ﷺ a dit qu’Allah dit : J’ai partagé la prière entre Moi et Mon serviteur en deux parts. Quand il dit : « Louange à Allah, Seigneur des mondes, » Allah dit : Mon serviteur M’a loué.";
"discovery.card.fatiha.source" = "Coran 1 · Sahih Muslim 395";

"discovery.card.honor_guest.title" = "Honore l’invité";
"discovery.card.honor_guest.meaning" = "Le Prophète ﷺ a dit : « Quiconque croit en Allah et au Jour dernier, qu’il honore son hôte. »";
"discovery.card.honor_guest.source" = "Sahih al-Bukhari 6018 · Sahih Muslim 47";

"discovery.card.love_brother.title" = "Aime pour ton frère";
"discovery.card.love_brother.meaning" = "Le Prophète ﷺ a dit : « Aucun de vous ne croit [vraiment] jusqu’à ce qu’il aime pour son frère ce qu’il aime pour lui-même. »";
"discovery.card.love_brother.source" = "Sahih al-Bukhari 13 · Sahih Muslim 45";

"discovery.card.remember_me.title" = "Souvenez-vous de Moi, Je Me souviendrai de vous";
"discovery.card.remember_me.meaning" = "Allah dit : « Souvenez-vous donc de Moi ; Je Me souviendrai de vous. Et soyez-Moi reconnaissants et ne Me niez pas. »";
"discovery.card.remember_me.source" = "Coran 2:152";

"discovery.card.no_envy.title" = "Ne vous enviez pas";
"discovery.card.no_envy.meaning" = "Le Prophète ﷺ a dit : « Ne vous enviez pas, ne vous haïssez pas, ne vous tournez pas le dos, et soyez, Ô serviteurs d’Allah, des frères. »";
"discovery.card.no_envy.source" = "Sahih al-Bukhari 6065 · Sahih Muslim 2563";

"discovery.card.truthfulness.title" = "La véracité mène au Paradis";
"discovery.card.truthfulness.meaning" = "Le Prophète ﷺ a dit : « La véracité mène à la piété, et la piété mène au Paradis. Un homme ne cesse d’être véridique jusqu’à ce qu’il soit inscrit auprès d’Allah comme siddiq. »";
"discovery.card.truthfulness.source" = "Sahih al-Bukhari 6094 · Sahih Muslim 2607";

"discovery.card.ghusl_friday.title" = "Le ghusl du vendredi";
"discovery.card.ghusl_friday.meaning" = "Le Prophète ﷺ a dit : « Le ghusl du vendredi est obligatoire pour tout adulte. »";
"discovery.card.ghusl_friday.source" = "Sahih al-Bukhari 879 · Sahih Muslim 846";

"discovery.card.speak_good.title" = "Dis du bien ou tais-toi";
"discovery.card.speak_good.meaning" = "Le Prophète ﷺ a dit : « Quiconque croit en Allah et au Jour dernier, qu’il dise du bien ou qu’il se taise. »";
"discovery.card.speak_good.source" = "Sahih al-Bukhari 6018 · Sahih Muslim 47";

"discovery.card.fajr_sunnah.title" = "Les deux rak‘a du Fajr";
"discovery.card.fajr_sunnah.meaning" = "Le Prophète ﷺ a dit : « Les deux rak‘a du Fajr valent mieux que ce bas monde et tout ce qu’il contient. »";
"discovery.card.fajr_sunnah.source" = "Sahih Muslim 725";

"discovery.card.haya.title" = "La pudeur est une branche de la foi";
"discovery.card.haya.meaning" = "Le Prophète ﷺ a dit : « La pudeur est une branche de la foi. »";
"discovery.card.haya.source" = "Sahih al-Bukhari 9 · Sahih Muslim 35";

"discovery.card.no_burden.title" = "Allah n’impose à aucune âme";
"discovery.card.no_burden.meaning" = "Allah dit : « Allah n’impose à aucune âme une charge au-delà de sa capacité. »";
"discovery.card.no_burden.source" = "Coran 2:286";

"discovery.card.mankind.title" = "Le plus noble est le plus pieux";
"discovery.card.mankind.meaning" = "Allah dit : « Ô hommes, Nous vous avons créés d’un mâle et d’une femelle, et Nous avons fait de vous des peuples et des tribus, pour que vous vous entre-connaissiez. Le plus noble d’entre vous auprès d’Allah est le plus pieux. »";
"discovery.card.mankind.source" = "Coran 49:13";

