"discovery.card.fact_prophet_dhulkifl.source" = "Qur’an 21:85";

"discovery.card.fact_prophet_dawud.title" = "Prophète Dawud";
"discovery.card.fact_prophet_dawud.meaning" = "Le Coran nomme le prophète Dawud. Son récit fait partie de la guidance du Livre.";
"discovery.card.fact_prophet_dawud.source" = "Qur’an 38:17";

"discovery.card.fact_prophet_sulayman.title" = "Prophète Sulayman";
"discovery.card.fact_prophet_sulayman.meaning" = "Le Coran nomme le prophète Sulayman. Son récit fait partie de la guidance du Livre.";
"discovery.card.fact_prophet_sulayman.source" = "Qur’an 27:16";

"discovery.card.fact_prophet_ilyas.title" = "Prophète Ilyas";
"discovery.card.fact_prophet_ilyas.meaning" = "Le Coran nomme le prophète Ilyas. Son récit fait partie de la guidance du Livre.";
"discovery.card.fact_prophet_ilyas.source" = "Qur’an 37:123";

"discovery.card.fact_prophet_alyasa.title" = "Prophète Al-Yasa";
"discovery.card.fact_prophet_alyasa.meaning" = "Le Coran nomme le prophète Al-Yasa. Son récit fait partie de la guidance du Livre.";
"discovery.card.fact_prophet_alyasa.source" = "Qur’an 6:86";

"discovery.card.fact_prophet_yunus.title" = "Prophète Yunus";
"discovery.card.fact_prophet_yunus.meaning" = "Le Coran nomme le prophète Yunus. Son récit fait partie de la guidance du Livre.";
"discovery.card.fact_prophet_yunus.source" = "Qur’an 37:139";

"discovery.card.fact_prophet_zakariyya.title" = "Prophète Zakariyya";
"discovery.card.fact_prophet_zakariyya.meaning" = "Le Coran nomme le prophète Zakariyya. Son récit fait partie de la guidance du Livre.";
"discovery.card.fact_prophet_zakariyya.source" = "Qur’an 19:2";

"discovery.card.fact_prophet_yahya.title" = "Prophète Yahya";
"discovery.card.fact_prophet_yahya.meaning" = "Le Coran nomme le prophète Yahya. Son récit fait partie de la guidance du Livre.";
"discovery.card.fact_prophet_yahya.source" = "Qur’an 19:7";

"discovery.card.fact_prophet_isa.title" = "Prophète Isa";
"discovery.card.fact_prophet_isa.meaning" = "Le Coran nomme le prophète Isa. Son récit fait partie de la guidance du Livre.";
"discovery.card.fact_prophet_isa.source" = "Qur’an 3:45";

"discovery.card.fact_prophet_muhammad.title" = "Prophète Muhammad ﷺ";
"discovery.card.fact_prophet_muhammad.meaning" = "Le Coran nomme le prophète Muhammad ﷺ. Son récit fait partie de la guidance du Livre.";
"discovery.card.fact_prophet_muhammad.source" = "Qur’an 33:40";

"discovery.card.fact_five_prayers.title" = "Cinq prières par jour";
"discovery.card.fact_five_prayers.meaning" = "L’islam est bâti sur cinq : le témoignage, la salat, la zakat, le hajj et le jeûne du ramadan. La salat est cinq fois par jour.";
"discovery.card.fact_five_prayers.source" = "Sahih al-Bukhari 8 · Sahih Muslim 16";

"discovery.card.fact_night_qadr.title" = "Meilleure que mille mois";
"discovery.card.fact_night_qadr.meaning" = "Laylat al-Qadr est meilleure que mille mois. Elle est en ramadan ; la nuit exacte n’est pas fixée dans le Coran.";
"discovery.card.fact_night_qadr.source" = "Qur’an 97:3";

"discovery.card.fact_hijrah.title" = "L’hégire";
"discovery.card.fact_hijrah.meaning" = "Le Prophète ﷺ émigra de La Mecque à Médine. Le Coran mentionne le secours d’Allah dans la grotte de ce voyage.";
"discovery.card.fact_hijrah.source" = "Qur’an 9:40 · seerah of the Hijrah";

"discovery.card.fact_seal_prophets.title" = "Le sceau des prophètes";
"discovery.card.fact_seal_prophets.meaning" = "Le Coran appelle Muhammad ﷺ le Messager d’Allah et le sceau des prophètes.";
"discovery.card.fact_seal_prophets.source" = "Qur’an 33:40";

"discovery.card.fact_two_testimonies.title" = "Pas de dieu sinon Allah";
"discovery.card.fact_two_testimonies.meaning" = "Le premier pilier est d’attester qu’il n’y a de dieu qu’Allah, et que Muhammad ﷺ est Son messager.";
"discovery.card.fact_two_testimonies.source" = "Qur’an 47:19 · Sahih al-Bukhari 8";

"discovery.card.fact_zakat_pillar.title" = "La zakat est un pilier";
"discovery.card.fact_zakat_pillar.meaning" = "Le Coran couple la salat et la zakat. L’aumône due est l’un des cinq piliers de l’islam.";
"discovery.card.fact_zakat_pillar.source" = "Qur’an 2:43 · Sahih al-Bukhari 8";

"discovery.card.fact_hajj_pillar.title" = "Hajj vers la Maison";
"discovery.card.fact_hajj_pillar.meaning" = "Le hajj vers la Kaaba est un devoir pour qui en trouve le moyen. C’est l’un des cinq piliers.";
"discovery.card.fact_hajj_pillar.source" = "Qur’an 3:97 · Sahih al-Bukhari 8";

"discovery.card.fact_fast_ramadan.title" = "Le jeûne vous a été prescrit";
"discovery.card.fact_fast_ramadan.meaning" = "Le jeûne vous a été prescrit comme à ceux avant vous, afin que vous atteigniez la taqwa.";
"discovery.card.fact_fast_ramadan.source" = "Qur’an 2:183 · Sahih al-Bukhari 8";

"discovery.card.fact_fatiha_every_salah.title" = "Pas de salat sans Al-Fatiha";
"discovery.card.fact_fatiha_every_salah.meaning" = "Le Prophète ﷺ a dit qu’il n’y a pas de salat pour qui ne récite pas l’Ouverture du Livre.";
"discovery.card.fact_fatiha_every_salah.source" = "Sahih al-Bukhari 756 · Sahih Muslim 394";

"discovery.card.fact_quran_preserved.title" = "Nous le préserverons";
"discovery.card.fact_quran_preserved.meaning" = "Allah a dit du Rappel : « C’est Nous qui avons fait descendre le Rappel, et c’est Nous qui le préservons. »";
"discovery.card.fact_quran_preserved.source" = "Qur’an 15:9";

"discovery.card.fact_ramadan_reveal.title" = "Descendu en ramadan";
"discovery.card.fact_ramadan_reveal.meaning" = "Le Coran a été descendu au mois de ramadan, comme guidance pour les gens et preuves claires du discernement.";
"discovery.card.fact_ramadan_reveal.source" = "Qur’an 2:185";

"discovery.card.fact_surah_count.title" = "114 sourates";
"discovery.card.fact_surah_count.meaning" = "Le Coran du mushaf othmanien compte 114 sourates, d’Al-Fatiha à An-Nas.";
"discovery.card.fact_surah_count.source" = "Uthmani mushaf";

"discovery.card.fact_juz_count.title" = "30 jouz";
"discovery.card.fact_juz_count.meaning" = "Pour la récitation, le Coran est divisé en 30 jouz — souvent un par nuit pour un khatm de ramadan.";
"discovery.card.fact_juz_count.source" = "Uthmani mushaf";

"discovery.card.fact_iqra_first.title" = "Le premier mot : Iqra";
"discovery.card.fact_iqra_first.meaning" = "La première révélation au Prophète ﷺ dans la grotte de Hira commença par : « Lis, au nom de ton Seigneur qui a créé. »";
"discovery.card.fact_iqra_first.source" = "Qur’an 96:1 · Sahih al-Bukhari 3";

"discovery.card.fact_longest_surah.title" = "La plus longue sourate";
"discovery.card.fact_longest_surah.meaning" = "Al-Baqara est la plus longue sourate du Coran, avec 286 versets. Elle fut descendue à Médine.";
"discovery.card.fact_longest_surah.source" = "Uthmani mushaf · Qur’an 2";

"discovery.card.fact_shortest_surah.title" = "La plus courte sourate";
"discovery.card.fact_shortest_surah.meaning" = "Al-Kawthar est la plus courte sourate, avec trois versets.";
"discovery.card.fact_shortest_surah.source" = "Uthmani mushaf · Qur’an 108";

"discovery.card.fact_first_house.title" = "La première Maison";
"discovery.card.fact_first_house.meaning" = "Le Coran dit que la première Maison établie pour les gens est celle de Bakka (La Mecque), bénie et guidance pour les mondes.";
"discovery.card.fact_first_house.source" = "Qur’an 3:96";

"discovery.card.fact_qiblah_change.title" = "La qibla fut tournée";
"discovery.card.fact_qiblah_change.meaning" = "Allah ordonna au Prophète ﷺ de tourner son visage vers la Mosquée sacrée. Cela devint la qibla des musulmans.";
"discovery.card.fact_qiblah_change.source" = "Qur’an 2:144";

"discovery.card.fact_arabic_quran.title" = "Un Coran arabe";
"discovery.card.fact_arabic_quran.meaning" = "Le Coran a été descendu comme une récitation arabe, pour que ses premiers auditeurs le comprennent.";
"discovery.card.fact_arabic_quran.source" = "Qur’an 12:2";

"discovery.card.fact_in_stages.title" = "Descendu par étapes";
"discovery.card.fact_in_stages.meaning" = "Le Coran n’est pas descendu d’un seul coup. Il fut récité par étapes durant la mission du Prophète ﷺ.";
"discovery.card.fact_in_stages.source" = "Qur’an 17:106";

"discovery.card.fact_isra.title" = "Le voyage nocturne";
"discovery.card.fact_isra.meaning" = "Gloire à Celui qui fit voyager Son serviteur de nuit de la Mosquée sacrée à la Mosquée la plus éloignée, dont Nous avons béni les alentours.";
"discovery.card.fact_isra.source" = "Qur’an 17:1";

"discovery.card.fact_mercy_to_worlds.title" = "Une miséricorde pour les mondes";
"discovery.card.fact_mercy_to_worlds.meaning" = "Le Coran dit que le Prophète ﷺ n’a été envoyé que comme une miséricorde pour les mondes.";
"discovery.card.fact_mercy_to_worlds.source" = "Qur’an 21:107";

"discovery.card.fact_uswa_hasana.title" = "Un bel exemple";
"discovery.card.fact_uswa_hasana.meaning" = "Vous avez dans le Messager d’Allah ﷺ un bel exemple pour qui espère en Allah et au Jour dernier.";
"discovery.card.fact_uswa_hasana.source" = "Qur’an 33:21";

"discovery.card.fact_great_character.title" = "Un caractère immense";
"discovery.card.fact_great_character.meaning" = "Allah a dit du Prophète ﷺ : « Et tu es certes d’un caractère immense. »";
"discovery.card.fact_great_character.source" = "Qur’an 68:4";

"discovery.card.fact_salawat.title" = "Allah prie sur lui";
"discovery.card.fact_salawat.meaning" = "Allah et Ses anges prient sur le Prophète ﷺ. Il est enjoint aux croyants de prier et de le saluer aussi.";
"discovery.card.fact_salawat.source" = "Qur’an 33:56";

"discovery.card.fact_jumuah.title" = "Quand on appelle le vendredi";
"discovery.card.fact_jumuah.meaning" = "Quand on appelle à la prière du vendredi, laissez le commerce et hâtez-vous vers le rappel d’Allah.";
"discovery.card.fact_jumuah.source" = "Qur’an 62:9";

"discovery.card.fact_wudu_ayah.title" = "Les ablutions dans le Coran";
"discovery.card.fact_wudu_ayah.meaning" = "Le Coran décrit les ablutions : lavez les visages et les bras jusqu’aux coudes, passez les mains sur les têtes, et lavez les pieds jusqu’aux chevilles.";
"discovery.card.fact_wudu_ayah.source" = "Qur’an 5:6";

"discovery.card.fact_no_compulsion.title" = "Nulle contrainte dans la religion";
"discovery.card.fact_no_compulsion.meaning" = "Nulle contrainte dans la religion. Le bon chemin s’est distingué de l’égarement.";
"discovery.card.fact_no_compulsion.source" = "Qur’an 2:256";

"discovery.card.fact_quran_easy_remember.title" = "Rendu facile à retenir";
"discovery.card.fact_quran_easy_remember.meaning" = "Allah a dit : « Nous avons certes rendu le Coran facile à rappeler. Y a-t-il quelqu’un qui se rappelle ? » Cette formule revient dans la sourate Al-Qamar.";
"discovery.card.fact_quran_easy_remember.source" = "Qur’an 54:17";

"discovery.card.fact_bismillah_tawbah.title" = "Pas de Bismillah avant At-Tawba";
"discovery.card.fact_bismillah_tawbah.meaning" = "Dans le mushaf othmanien, chaque sourate commence par la Basmala, sauf At-Tawba (sourate 9).";
"discovery.card.fact_bismillah_tawbah.source" = "Uthmani mushaf · Qur’an 9";

"discovery.card.fact_fatiha_seven.title" = "Les sept répétés";
"discovery.card.fact_fatiha_seven.meaning" = "Al-Fatiha compte sept versets. Beaucoup de savants voient en « les sept répétés » (15:87) cette sourate, récitée à chaque salat.";
"discovery.card.fact_fatiha_seven.source" = "Qur’an 15:87 · Qur’an 1";

"discovery.card.fact_ikhlas_third.title" = "Al-Ikhlas est un tiers du Coran";
"discovery.card.fact_ikhlas_third.meaning" = "Le Prophète ﷺ a dit que « Qul Huwa Allahu Ahad » (Al-Ikhlas) équivaut à un tiers du Coran.";
"discovery.card.fact_ikhlas_third.source" = "Sahih al-Bukhari 5015";

"discovery.card.fact_kursi_greatest.title" = "Le plus grand verset";
"discovery.card.fact_kursi_greatest.meaning" = "Le Prophète ﷺ demanda à Ubayy ibn Ka‘b quel verset du Livre d’Allah est le plus grand. Il cita le verset du Trône, et le Prophète ﷺ confirma.";
"discovery.card.fact_kursi_greatest.source" = "Sahih Muslim 810";

"discovery.card.fact_muawwidhatayn.title" = "Les deux sourates de protection";
"discovery.card.fact_muawwidhatayn.meaning" = "Al-Falaq et An-Nas sont les Mu‘awwidhatayn. Le Prophète ﷺ s’en servait comme protection et les enseigna.";
"discovery.card.fact_muawwidhatayn.source" = "Sahih al-Bukhari 5016";

"discovery.card.fact_iman_six.title" = "Six piliers de la foi";
"discovery.card.fact_iman_six.meaning" = "La foi est de croire en Allah, Ses anges, Ses livres, Ses messagers, le Jour dernier et le décret — le bon et l’épreuve.";
"discovery.card.fact_iman_six.source" = "Sahih Muslim 8 · Qur’an 4:136";

"discovery.card.fact_revealed_books.title" = "Livres nommés dans le Coran";
"discovery.card.fact_revealed_books.meaning" = "Outre le Coran, le Livre nomme la Torah, l’Évangile et les Psaumes — écritures données aux messagers d’avant.";
"discovery.card.fact_revealed_books.source" = "Qur’an 3:3 · Qur’an 4:163 · Qur’an 5:46";

"discovery.card.fact_twelve_months.title" = "Douze mois auprès d’Allah";
"discovery.card.fact_twelve_months.meaning" = "Le nombre de mois auprès d’Allah est de douze, dans le Livre d’Allah, le jour où Il créa les cieux et la terre — dont quatre sacrés.";
"discovery.card.fact_twelve_months.source" = "Qur’an 9:36";

"discovery.card.fact_maqam_ibrahim.title" = "La station d’Ibrahim";
"discovery.card.fact_maqam_ibrahim.meaning" = "Prenez la station d’Ibrahim comme lieu de prière. Le Coran la lie à la Maison qu’Ibrahim et Ismail devaient purifier.";
"discovery.card.fact_maqam_ibrahim.source" = "Qur’an 2:125";

"discovery.card.fact_named_prophets.title" = "25 prophètes nommés";
"discovery.card.fact_named_prophets.meaning" = "Le Coran nomme vingt-cinq prophètes, d’Adam à Muhammad ﷺ. D’autres messagers sont cités sans être nommés.";
"discovery.card.fact_named_prophets.source" = "Qur’an · 25 named prophets";

"discovery.card.fact_ninety_nine_names.title" = "Quatre-vingt-dix-neuf noms";
"discovery.card.fact_ninety_nine_names.meaning" = "Le Prophète ﷺ a dit qu’Allah a quatre-vingt-dix-neuf noms, cent moins un ; quiconque les énumère entre au Paradis.";
"discovery.card.fact_ninety_nine_names.source" = "Sahih al-Bukhari 2736 · Sahih Muslim 2677";

"discovery.card.fact_seven_mathani.title" = "Sept des souvent répétées";
"discovery.card.fact_seven_mathani.meaning" = "Allah dit qu’Il a donné au Prophète ﷺ sept des souvent répétées et le Grand Coran. Beaucoup de savants y voient Al-Fatiha.";
"discovery.card.fact_seven_mathani.source" = "Qur’an 15:87";

"discovery.card.fact_safa_marwa.title" = "Safa et Marwa";
"discovery.card.fact_safa_marwa.meaning" = "Safa et Marwa font partie des rites d’Allah. Quiconque fait le hajj ou la umra vers la Maison n’encourt aucun blâme à circuler entre elles.";
"discovery.card.fact_safa_marwa.source" = "Qur’an 2:158";

"discovery.card.fact_four_sacred_named.title" = "Quatre mois sacrés";
"discovery.card.fact_four_sacred_named.meaning" = "Sur les douze mois, quatre sont sacrés : Dhou al-Qaʿda, Dhou al-Hijja, Muharram et Rajab — celui qui se tient entre Jumada et Shaʿban.";
"discovery.card.fact_four_sacred_named.source" = "Qur’an 9:36 · Sahih al-Bukhari 3197";

"discovery.card.fact_three_mosques.title" = "Trois mosquées pour un voyage";
"discovery.card.fact_three_mosques.meaning" = "Le Prophète ﷺ a dit : ne partez en voyage vers une mosquée que vers trois : la Mosquée sacrée, cette mosquée qui est la mienne, et Al-Aqsa.";
"discovery.card.fact_three_mosques.source" = "Sahih al-Bukhari 1189 · Sahih Muslim 1397";

"discovery.card.fact_last_two_baqarah.title" = "Les deux derniers versets d’Al-Baqara";
"discovery.card.fact_last_two_baqarah.meaning" = "Le Prophète ﷺ a dit que quiconque récite les deux derniers versets d’Al-Baqara la nuit, ils lui suffisent.";
"discovery.card.fact_last_two_baqarah.source" = "Sahih al-Bukhari 5009 · Sahih Muslim 808";

"discovery.card.fact_best_days_dhulhijjah.title" = "Les meilleurs jours de l’année";
"discovery.card.fact_best_days_dhulhijjah.meaning" = "Le Prophète ﷺ a dit qu’il n’est pas de jours où les œuvres pies soient plus aimées d’Allah que ces dix — les dix premiers de Dhou al-Hijja.";
"discovery.card.fact_best_days_dhulhijjah.source" = "Sahih al-Bukhari 969";

"discovery.card.fact_ayah_total.title" = "6236 versets";
"discovery.card.fact_ayah_total.meaning" = "Le mushaf othmanien Hafs usuel compte 6236 versets répartis en 114 sourates.";
"discovery.card.fact_ayah_total.source" = "Uthmani Hafs mushaf count";

"discovery.card.fact_bismillah_openings.title" = "113 sourates s’ouvrent par Bismillah";
"discovery.card.fact_bismillah_openings.meaning" = "113 sourates commencent par Bismillah. At-Tawba non. Une Bismillah de plus est dans la lettre de Sulayman (27:30).";
"discovery.card.fact_bismillah_openings.source" = "Uthmani mushaf · Qur’an 27:30";

"discovery.card.fact_word_allah.title" = "Allah est écrit 2265 fois";
"discovery.card.fact_word_allah.meaning" = "Dans le texte othmanien Hafs, le nom Allah (الله) apparaît 2265 fois comme mot écrit — hors Allahumma.";
"discovery.card.fact_word_allah.source" = "Uthmani Hafs mushaf count";

"discovery.card.fact_word_rahman.title" = "Ar-Rahman 157 fois";
"discovery.card.fact_word_rahman.meaning" = "Dans le texte othmanien Hafs, le mot Ar-Rahman (الرحمن) apparaît 157 fois.";
"discovery.card.fact_word_rahman.source" = "Uthmani Hafs mushaf count";

"discovery.card.fact_word_rahim.title" = "Ar-Rahim 146 fois";
"discovery.card.fact_word_rahim.meaning" = "Dans le texte othmanien Hafs, le mot Ar-Rahim (الرحيم) apparaît 146 fois.";
"discovery.card.fact_word_rahim.source" = "Uthmani Hafs mushaf count";

"discovery.card.fact_word_muhammad.title" = "Muhammad est nommé 4 fois";
"discovery.card.fact_word_muhammad.meaning" = "Le nom Muhammad ﷺ est écrit 4 fois dans le Coran. En 61:6 il est aussi appelé Ahmad.";
"discovery.card.fact_word_muhammad.source" = "Uthmani Hafs mushaf count · Qur’an 3:144 · 33:40 · 47:2 · 48:29";

"discovery.card.fact_word_jannah.title" = "Al-janna 56 fois";
"discovery.card.fact_word_jannah.meaning" = "Dans le texte othmanien Hafs, le mot al-janna (الجنة, le Jardin) apparaît 56 fois.";
"discovery.card.fact_word_jannah.source" = "Uthmani Hafs mushaf count";

"discovery.card.fact_word_nar.title" = "An-nar 102 fois";
"discovery.card.fact_word_nar.meaning" = "Dans le texte othmanien Hafs, le mot an-nar (النار, le Feu) apparaît 102 fois.";
"discovery.card.fact_word_nar.source" = "Uthmani Hafs mushaf count";

"discovery.card.fact_rahman_refrain.title" = "Lequel des bienfaits — 31 fois";
"discovery.card.fact_rahman_refrain.meaning" = "Le verset « Lequel donc des bienfaits de votre Seigneur nierez-vous ? » est écrit 31 fois dans la sourate Ar-Rahman.";
"discovery.card.fact_rahman_refrain.source" = "Qur’an 55";

"discovery.card.fact_mursalat_refrain.title" = "Malheur ce jour-là — 10 fois";
"discovery.card.fact_mursalat_refrain.meaning" = "Le verset « Malheur ce jour-là aux négateurs » est écrit 10 fois dans la sourate Al-Mursalat.";
"discovery.card.fact_mursalat_refrain.source" = "Qur’an 77";

"discovery.card.fact_qamar_easy_repeat.title" = "Facile à retenir — 4 fois";
"discovery.card.fact_qamar_easy_repeat.meaning" = "La formule « Nous avons certes rendu le Coran facile à retenir ; y a-t-il quelqu’un qui se rappelle ? » apparaît 4 fois dans la sourate Al-Qamar.";
